    <head meta_screenName="LoginScreen" meta_author="LyLTN1" meta_subsystem="2" meta_screenId="LoginScreen">
        <w2:type>COMPONENT</w2:type>
        <w2:buildDate/>
        <w2:MSA/>
        <xf:model>
            <w2:dataCollection baseNode="map"/>
