<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head meta_vertical_guides="" meta_horizontal_guides="">
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
         <script type="text/javascript" lazy="false"><![CDATA[
        
	scwin.onpageload = function() {
		
	};
	
	scwin.onpageunload = function() {
		
	};
	
	scwin.fn_msg = function(){ 
    var invalidType = this.getType();  // invalid type
    if (invalidType == "mandatory")
    	{ message = "You forgot selecting a city!"; }
		return message;
    }
    
    
    
	scwin.trigger1_onclick = function(e) {
		radio1.validate();
	};
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload" ev:onpageunload="scwin.onpageunload">
    <xf:group id="" style="margin: 10px;">
    	<w2:textbox tagname="h1" style="color: blue;margin-bottom: 10px;" tabIndex="h1" id="textbox1" label="입력 검증 및 오류 메시지 표시"
    		escape="false">
    	</w2:textbox>
    	<w2:textbox tagname="h2" style="height: 23px;margin-bottom: 10px;color: blue;" id="textbox2" label="샘플 사용 방법"></w2:textbox>
    	<w2:textbox style="color: blue;margin-bottom: 30px;" id="textbox3"
    		label="1. 아무것도 입력하지 않고 validate() 버튼을 클릭. &lt;br/&gt;2. invalidMessageFunc 속성 값으로 지정한 함수가 반환한 오류 메시지가 표시되는 것을 확인." escape="false">
    	</w2:textbox>
    	<w2:textbox
    		style="padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightblue;border:none;margin-bottom: 10px;"
    		id="textbox4" label='속성 설정&lt;br/&gt;mandatory="true" &lt;br/&gt;displaymessage="true" &lt;br/&gt;invalidMessageFunc="scwin.fn_msg"'
    		escape="false">
    	</w2:textbox>
    	<w2:textbox style="padding:10px; padding-bottom:20px; text-align:left; font-size:15px; font-weight:bolder; border:brown 1px solid; background-color:ivory; margin-bottom:10px; margin-top:10px; color:brown;" id="textbox5" label='/// 샘플 코드&lt;br/&gt;&lt;br/&gt;scwin.fn_msg = function () {&lt;br/&gt; &amp;nbsp; &amp;nbsp;var invalidType = this.getType(); &amp;nbsp;// invalid type&lt;br/&gt; &amp;nbsp; &amp;nbsp;if (invalidType == "mandatory") { message = "You forgot selecting a city!"; }&lt;br/&gt; &amp;nbsp; &amp;nbsp;return message;&lt;br/&gt;}' escape="false">
    	</w2:textbox>
    	<xf:trigger ev:onclick="scwin.trigger1_onclick"
    		style="height:42px;line-height:32px;padding:5px;background-color:coral;font-size:15px;weight: bolder;font-weight:bolder;text-align: left;display: block;margin-bottom: 10px;"
    		id="trigger1" type="button">
    		<xf:label><![CDATA[radio1.validate();]]></xf:label>
    	</xf:trigger>
    	<xf:select1 ref="" appearance="full" invalidMessage="" style="" invalidMessageFunc="scwin.fn_msg" id="radio1" displaymessage="true"
    		rows="" cols="" mandatory="true" selectedIndex="-1">
    		<xf:choices>
    			<xf:item>
    				<xf:label><![CDATA[Seoul]]></xf:label>
    				<xf:value><![CDATA[001]]></xf:value>
    			</xf:item>
    			<xf:item>
    				<xf:label><![CDATA[Paris]]></xf:label>
    				<xf:value><![CDATA[002]]></xf:value>
    			</xf:item>
    			<xf:item>
    				<xf:label><![CDATA[London]]></xf:label>
    				<xf:value><![CDATA[003]]></xf:value>
    			</xf:item>
    			<xf:item>
    				<xf:label><![CDATA[New York]]></xf:label>
    				<xf:value><![CDATA[004]]></xf:value>
    			</xf:item>
    		</xf:choices>
    	</xf:select1>
    </xf:group></body>
</html>
