    	<script lazy="false" type="text/javascript"><![CDATA[
scwin.onpageload = function() {
	var i;
        for (i=0; i<10; i++) {
	        var num = JSON.stringify(i+1);  
	        var title = "windowTitle_" + num;
	        var windowId = num;
	        var windowName = "window_" + num;
	        windowContainer1.createWindow( title , "" , "" , windowName , windowId ,"newWindow");
	        windowContainer1.setArrangeWindows("cascade");
	        }   
};
]]></script>
    	<style type="text/css"><![CDATA[.w2window_selected {border: solid 3px blueviolet;} ]]></style>
    </head>
    <body ev:onpageload="scwin.onpageload">
    <xf:group id="" style="margin: 10px;"><w2:textbox tagname="h1" style="color: blue;margin-bottom: 10px;" tabIndex="h1" id="textbox1" label="네임 레이어의 스크롤 버튼을 통한 윈도우 선택" escape="false"></w2:textbox><w2:textbox tagname="h2" style="height: 23px;margin-bottom: 10px;color: blue;" id="textbox2" label="샘플 사용 방법"></w2:textbox><w2:textbox style="color: blue;margin-bottom: 30px;" id="textbox3" label='1. WindowContainer 하단의 네임 레이어를 확인. &lt;br/&gt;2. 네임 레이어 상의 스크롤을 위한 좌측 화살표나 우측 화살표 버튼을 클릭. &lt;br/&gt;3. 화살표를 클릭할 때 마다 네임 레이어 상에 새로 표시되는 윈도우 타이틀에 따라 해당 윈도우가 선택되는 것을 확인. ' escape="false">
    	</w2:textbox><w2:textbox style="padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightblue;border:none;margin-bottom: 10px;" id="textbox4" label='속성 설정&lt;br/&gt;changeActiveWindow="true"' escape="false">
