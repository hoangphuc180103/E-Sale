<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
         <script type="text/javascript" lazy="false"><![CDATA[


scwin.onpageload = function () {
	var i;
	for (i = 0; i < 3; i++) {
		var num = JSON.stringify(i);
		var title = "Title_" + num;
		var windowId = num;
		var windowName = "Name_" + num;
		windowContainer1.createWindow(title, "", "", windowName, windowId, "newWindow");
		windowContainer1.setArrangeWindows("cascade");
	}
};

scwin.onpageunload = function () {

};

scwin.windowContainer1_ondragstart = function (windowId) {
	alert("ondragstart : " + windowId);
};

scwin.windowContainer1_ondragend = function (windowId) {
	alert("ondragend : " + windowId);
};

]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload" ev:onpageunload="scwin.onpageunload">
    <xf:group id="" style="margin: 10px;">
    	<w2:textbox tagname="h1" style="color: blue;margin-bottom: 10px;" tabIndex="h1" id="textbox1"
    		label="이벤트 - ondragstart &amp; ondragend" escape="false">
    	</w2:textbox>
    	<w2:textbox tagname="h2" style="height: 23px;margin-bottom: 10px;color: blue;" id="textbox2" label="샘플 사용 방법"></w2:textbox>
    	<w2:textbox style="color: blue;margin-bottom: 30px;" id="textbox3"
    		label='1. 임의의 윈도우를 선택하여 드래깅. &lt;br/&gt;2. ondragstart 이벤트가 발생하는 것을 확인. &lt;br/&gt;3. 윈도우 드래깅을 멈춤. &lt;br/&gt;4. ondragend 이벤트가 발생하는 것을 확인.&lt;br/&gt;(각 이벤트 핸들러의 자세한 스크립트는 Script 탭에서 확인.)'
    		escape="false">
    	</w2:textbox>
    	<w2:textbox
    		style="padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightgreen;border:none;margin-bottom: 10px;"
    		id="textbox4" label='이벤트 설명&lt;br/&gt;ondragstart - 윈도우 드래깅이 시작될 때 발생.&lt;br/&gt;ondragend - 윈도우 드래깅이 끝날 때 발생.' escape="false">
    	</w2:textbox>
    	<w2:textbox tagname="" style="padding:10px; padding-bottom:20px; text-align:left; font-size:15px; font-weight:bolder; border:brown 1px solid; background-color:ivory; margin-bottom:10px; color:brown;" id="textbox5" label='/// 샘플 코드 &lt;br/&gt;&lt;br/&gt;scwin.windowContainer1_ondragstart = function(windowId) {&lt;br/&gt; &amp;nbsp; &amp;nbsp;alert("ondragstart : " + windowId);&lt;br/&gt;};&lt;br/&gt;&lt;br/&gt;scwin.windowContainer1_ondragend = function(windowId) {&lt;br/&gt; &amp;nbsp; &amp;nbsp;alert("ondragend : " + windowId);&lt;br/&gt;};' escape="false">
    	</w2:textbox>
    	<w2:windowContainer sequentialArrangeColNum="" sequentialArrangeRowNum="" fixArrangeFullScreen="false" useFixButton="false"
