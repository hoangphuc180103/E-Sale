<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
    	<w2:buildDate />
    	<xf:model>
    		<xf:instance>
    			<data xmlns="" />
    		</xf:instance>
    		<w2:dataCollection baseNode="map">
    			<w2:dataList baseNode="list" id="dataList1" repeatNode="map" saveRemovedData="true" style="">
    				<w2:columnInfo>
    					<w2:column dataType="text" id="col1" name="name1"></w2:column>
    					<w2:column dataType="text" id="col2" name="name2"></w2:column>
    					<w2:column dataType="text" id="col3" name="name3"></w2:column>
    					<w2:column id="col4" name="name4" dataType="text"></w2:column>
    				</w2:columnInfo>
    				<w2:data use="false"></w2:data>
    			</w2:dataList>
    		</w2:dataCollection>
    		<w2:workflowCollection></w2:workflowCollection>
    	</xf:model>
    	<script type="text/javascript" lazy="false"><![CDATA[
scwin.trigger1_onclick = function (e) {
    treeview1.setNodeClass(1, "thick");
};

scwin.trigger2_onclick = function (e) {
    treeview1.removeNodeClass(1);
};

scwin.onpageload = function () {
    var json = [{
        "col1": "Asia",
        "col2": "1",
        "col3": "con"
    }, {
        "col1": "Africa",
        "col2": "1",
        "col3": "con"
    }, {
        "col1": "Americas",
        "col2": "1",
        "col3": "con"

    }, {
        "col1": "Europe",
        "col2": "1",
        "col3": "con"
    }, {
        "col1": "Middle East",
        "col2": "1",
        "col3": "con"
    }];
    dataList1.setJSON(json);
};

scwin.onpageunload = function () {

};


]]></script>
    	<style type="text/css"><![CDATA[ .thick {
    font-weight: bold;
    color: red;
    font-size: 40px;
    } ]]></style>
    </head>
    <body ev:onpageload="scwin.onpageload" ev:onpageunload="scwin.onpageunload">
    	<xf:group id="" style="margin: 10px;">
    		<w2:textbox tagname="h1" style="color: blue;margin-bottom: 10px;" tabIndex="h1" id="textbox1" label="특정 노드에 스타일 적용"
    			escape="false">
    		</w2:textbox>
    		<w2:textbox tagname="h2" style="height: 23px;margin-bottom: 10px;color: blue;" id="textbox2" label="샘플 사용 방법"></w2:textbox>
    		<w2:textbox style="color: blue;margin-bottom: 30px;" id="textbox3"
    			label='1. 첫 번째 setNodeClass(1, "thick") 버튼을 클릭. &lt;br/&gt;2. index="1" 노드에 thick 클래스가 적용되는 것을 확인. &lt;br/&gt;3. 두 번째 removeNodeClass(1) 버튼을 클릭. &lt;br/&gt;4. index="1" 노드에 적용된 클래스가 제거되는 것을 확인.'
    			escape="false">
    		</w2:textbox>
    		<w2:textbox style="padding:10px; padding-bottom:20px; text-align:left; font-size:15px; font-weight:bolder; border:brown 1px solid; background-color:ivory; margin-bottom:10px; margin-top:10px; color:brown;" id="textbox4" label="/// CSS 스타일 클래스&lt;br/&gt;&lt;br/&gt; .thick {&lt;br/&gt; &amp;nbsp; &amp;nbsp;font-weight: bold;&lt;br/&gt; &amp;nbsp; &amp;nbsp;color: red;&lt;br/&gt; &amp;nbsp; &amp;nbsp;font-size: 40px;&lt;br/&gt; &amp;nbsp; &amp;nbsp;} " escape="false">
    		</w2:textbox>
    		<xf:trigger ev:onclick="scwin.trigger1_onclick"
    			style="height:42px;line-height:32px;padding:5px;background-color:coral;font-size:15px;weight: bolder;font-weight:bolder;text-align: left;display: block;margin-bottom: 10px;"
    			id="trigger1" type="button">
    			<xf:label><![CDATA[treeview1.setNodeClass(1, "thick");]]></xf:label>
    		</xf:trigger>
    		<xf:trigger ev:onclick="scwin.trigger2_onclick"
    			style="height:42px;line-height:32px;padding:5px;background-color:coral;font-size:15px;weight: bolder;font-weight:bolder;text-align: left;display: block;margin-bottom: 10px;"
    			id="trigger2" type="button">
    			<xf:label><![CDATA[treeview1.removeNodeClass(1);]]></xf:label>
    		</xf:trigger>
    		<w2:treeview showCheckbox="" showCheckboxLabel="" tooltipGroupClass="false" dataType="listed" hierarchy=""
    			style="width: 200px;margin-top: 10px;" id="treeview1">
    			<w2:itemset nodeset="data:dataList1">
    				<w2:label ref="col1"></w2:label>
    				<w2:value ref="col3"></w2:value>
    				<w2:depth ref="col2"></w2:depth>
    				<w2:folder ref=""></w2:folder>
    				<w2:checkbox ref="col4"></w2:checkbox>
    				<w2:checkboxDisabled ref=""></w2:checkboxDisabled>
    				<w2:image ref=""></w2:image>
    				<w2:iconImage ref=""></w2:iconImage>
    				<w2:selectedImage ref=""></w2:selectedImage>
    				<w2:expandedImage ref=""></w2:expandedImage>
    				<w2:leafImage ref=""></w2:leafImage>
    			</w2:itemset>
    		</w2:treeview>
    	</xf:group>
    </body>
</html>
