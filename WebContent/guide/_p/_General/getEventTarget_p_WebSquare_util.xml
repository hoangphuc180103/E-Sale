<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
         <script type="text/javascript" lazy="false"><![CDATA[
        
	scwin.onpageload = function() {
		
	};
	
	scwin.onpageunload = function() {
		
	};	
	
	scwin.trigger1_onclick = function(e) {
		autoComplete1.setValue("Seoul");
		
		var info = $p.getEventTarget(this);
		var pluginName = info.pluginName;
		var id = info.id;
		var realId = info.realId;		
		alert("The action has been performed by (Name : " + pluginName + " & ID : " + id + " & Real ID : " + realId + ".)");	
	};
	
	
	]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload" ev:onpageunload="scwin.onpageunload">
    <xf:group id="" style="margin: 10px;">
    	<w2:textbox tagname="h1" style="color: blue;margin-bottom: 10px;" id="textbox1" label="이벤트가 발생한 컴포넌트 정보 반환" escape="false"></w2:textbox>
    	<w2:textbox tagname="h2" style="height: 23px;margin-bottom: 10px;color: blue;" id="textbox2" label="샘플 사용 방법"></w2:textbox>
    	<w2:textbox style="color: blue;margin-bottom: 30px;" id="textbox3"
    		label='1. 하단의 Trigger버튼을 클릭. &lt;br/&gt;2. Trigger의 onclick 이벤트가 발생하고, 해당 Trigger의 정보가 표시되는 것을 확인.&lt;br/&gt;(상세한 스크립트는 Script 탭에서 확인.)&lt;br/&gt;'
    		escape="false">
    	</w2:textbox>
    	<xf:trigger ev:onclick="scwin.trigger1_onclick"
    		style="display: block;height:42px;line-height:32px;padding:5px;background-color:coral;font-size:15px;weight: bolder;font-weight:bolder;margin-bottom:10px;text-align: left;"
    		id="trigger1" type="button">
    		<xf:label><![CDATA[Select "Seoul".]]></xf:label>
    	</xf:trigger>
    	<w2:autoComplete chooseOptionLabel="Select a city." submenuSize="auto" caseSensitive="false" chooseOption="true"
    		useKeywordHighlight="false" allOption="" autoFocus="" mandatory="true" ref="" search="start" nextTabID="" editType="select"
    		style="width: 50%;" id="autoComplete1" placeholder="Select a city." class="">
    		<w2:choices>
    			<w2:item>
    				<w2:label><![CDATA[Seoul]]></w2:label>
    				<w2:value><![CDATA[Seoul]]></w2:value>
    			</w2:item>
    			<w2:item>
    				<w2:label><![CDATA[Busan]]></w2:label>
    				<w2:value><![CDATA[Busan]]></w2:value>
    			</w2:item>
    			<w2:item>
    				<w2:label><![CDATA[Daegu]]></w2:label>
    				<w2:value><![CDATA[Daegu]]></w2:value>
    			</w2:item>
    			<w2:item>
    				<w2:label><![CDATA[Jeju]]></w2:label>
    				<w2:value><![CDATA[Jeju]]></w2:value>
    			</w2:item>
    			<w2:item>
    				<w2:label><![CDATA[Jeonju]]></w2:label>
    				<w2:value><![CDATA[Jeonju]]></w2:value>
    			</w2:item>
    		</w2:choices>
    	</w2:autoComplete>
    	<w2:textbox escape="false" id="textbox4"
    		label='/// 샘플 코드&lt;br/&gt;&lt;br/&gt;autoComplete1.setValue("Seoul");&lt;br/&gt;&lt;br/&gt;var info = $p.getEventTarget(this);&lt;br/&gt;var pluginName = info.pluginName;&lt;br/&gt;var id = info.id;&lt;br/&gt;var realId = info.realId;&lt;br/&gt;alert("The action has been performed by (Name : " + pluginName + " &amp; ID : " + id + " &amp; Real ID : " + realId + ".)");'
    		style="padding:10px; padding-bottom:20px; text-align:left; font-size:15px; font-weight:bolder; border:brown 1px solid; background-color:ivory; margin-bottom:10px; margin-top:10px; color:brown;"
    		tagname="">
    	</w2:textbox>
    </xf:group></body>
</html>
