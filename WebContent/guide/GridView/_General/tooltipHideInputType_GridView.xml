    			<w2:caption style="" id="caption2" value="this is a grid caption."></w2:caption>
    			<w2:header style="" id="header2">
    				<w2:row style="" id="row3">
    					<w2:column width="70" inputType="text" style="height:20px" id="column7" value="col1 &lt;br/&gt;(text)"
    						displayMode="label">
    					</w2:column>
    					<w2:column width="70" inputType="text" style="height:20px" id="column6" value="col2&lt;br/&gt;(text)"
    						displayMode="label">
    					</w2:column>
    					<w2:column width="70" inputType="text" style="height:20px" id="column5" value="col3&lt;br/&gt;(text)"
