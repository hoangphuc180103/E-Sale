                        ,{col1:"a",col2:"ABCDEFGHIJKLMNOPQRSTUVWXYZ",col3:"false", col4:"overseas"}
                        ,{col1:"a",col2:"a4ABCDEFGHIJKLMNOPQRSTUVWXYZ",col3:"false", col4:"domestic"}
                        ,{col1:"a",col2:"a5ABCDEFGHIJKLMNOPQRSTUVWXYZ",col3:"true", col4:"domestic"}
                        ,{col1:"b",col2:"b1ABCDEFGHIJKLMNOPQRSTUVWXYZ",col3:"true", col4:"domestic"}
                        ,{col1:"b",col2:"b3ABCDEFGHIJKLMNOPQRSTUVWXYZ",col3:"true", col4:"domestic"}
                        ,{col1:"c",col2:"c1ABCDEFGHIJKLMNOPQRSTUVWXYZ",col3:"false", col4:"overseas"}
                        ,{col1:"c",col2:"c2ABCDEFGHIJKLMNOPQRSTUVWXYZ",col3:"true", col4:"domestic"}
                        ,{col1:"c",col2:"c3ABCDEFGHIJKLMNOPQRSTUVWXYZ",col3:"false", col4:"overseas"}
                        ,{col1:"d",col2:"d1ABCDEFGHIJKLMNOPQRSTUVWXYZ",col3:"true", col4:"overseas"}
                        ,{col1:"d",col2:"d2ABCDEFGHIJKLMNOPQRSTUVWXYZ",col3:"false", col4:"domestic"}
                        ,{col1:"d",col2:"d3ABCDEFGHIJKLMNOPQRSTUVWXYZ",col3:"false", col4:"domestic"}];
        dataList1.setJSON(jsonData);

    };
    
    ]]></script>
        <style type="text/css"><![CDATA[
            
         ]]></style>
    </head>
    <body ev:onpageload="scwin.onpageload">
    	<xf:group id="" class="" style="margin:10px;" tooltipDisplay="true">
    		<w2:textbox escape="false" id="textbox1" label="툴팁을 표시하지 않을 컬럼 지정" style="color: blue;margin-bottom: 10px;" tabIndex="h1"
    			tagname="h1">
    		</w2:textbox>
    		<w2:textbox id="textbox2" label="샘플 사용 방법" style="height: 23px;margin-bottom: 10px;color: blue;" tagname="h2"></w2:textbox>
    		<w2:textbox escape="false" id="textbox3"
    			label='1. GridView의 각 셀에 마우스 커서를 가져다 대기. &lt;br/&gt;2. inputType="select"인 col4를 제외한 나머지 컬럼에서 툴팁이 항상 표시되는 것을 확인. '
