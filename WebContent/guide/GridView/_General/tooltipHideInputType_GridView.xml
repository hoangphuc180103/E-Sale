    					</w2:column>
    					<w2:column width="70" inputType="text" style="height:20px" id="column4" value="col4&lt;br/&gt;(select)"
    						displayMode="label">
    					</w2:column>
    				</w2:row>
    			</w2:header>
    			<w2:gBody style="" id="gBody2">
    				<w2:row style="" id="row4">
    					<w2:column width="70" radioLabelColumn="col3" inputType="text" style="height:20px" readOnly="false" id="col1"
    						value="" displayMode="label">
    					</w2:column>
    					<w2:column width="70" inputType="text" style="height:20px" id="col2" value="" displayMode="label"></w2:column>
    					<w2:column width="70" inputType="" style="height:20px" id="col3" value="" displayMode="label"></w2:column>
    					<w2:column ref="" chooseOption="" width="70" inputType="select" style="height:20px" readOnly="false" id="col4"
    						allOption="" value="false" displayMode="label">
    						<w2:choices>
    							<w2:itemset nodeset="data:dataList2">
    								<w2:label ref="label"></w2:label>
    								<w2:value ref="value"></w2:value>
    							</w2:itemset>
    						</w2:choices>
    					</w2:column>
    				</w2:row>
    			</w2:gBody>
    		</w2:gridView>
    	</xf:group>
