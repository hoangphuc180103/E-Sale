<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
        	<xf:instance>
        		<data xmlns="" />
        	</xf:instance>
        	<w2:dataCollection baseNode="map">
        		<w2:dataList baseNode="list" id="dataList1" repeatNode="map" saveRemovedData="true" style="">
        			<w2:columnInfo>
        				<w2:column dataType="text" id="Status" name="Status"></w2:column>
        				<w2:column dataType="date" id="Date" name="Date"></w2:column>
        				<w2:column dataType="number" id="Expense" name="Expense"></w2:column>
        				<w2:column dataType="number" id="Income" name="Income"></w2:column>
        				<w2:column dataType="text" id="Hobby" name="Hobby"></w2:column>
        				<w2:column dataType="text" id="Region" name="Region"></w2:column>
        				<w2:column dataType="number" id="Frequency" name="Frequency"></w2:column>
        				<w2:column dataType="number" id="ID" name="ID"></w2:column>
        				<w2:column dataType="number" id="Age" name="Age"></w2:column>
        			</w2:columnInfo>
        		</w2:dataList>
        	</w2:dataCollection>
        	<w2:workflowCollection></w2:workflowCollection>
        	<xf:submission id="submission1" ref="" target="data:json,dataList1" action="data_number.json" method="post"
        		mediatype="application/json" encoding="UTF-8" instance="" replace="" errorHandler="" customHandler="" mode="asynchronous"
        		processMsg="" ev:submit="" ev:submitdone="" ev:submiterror="" abortTrigger="">
        	</xf:submission>
        </xf:model>
        <script type="text/javascript" lazy="false"><![CDATA[

scwin.onpageload = function () {
    var objSubmission = $p.getSubmission("submission1");
    objSubmission.action = scwin.getfolderPath() + '/data_number.json';
    $p.executeSubmission("submission1");
};

scwin.onpageunload = function () {

};


scwin.trigger1_onclick = function (e) {
    var options = {};
    options.fileName = "test1.xlsx";
    options.customToDataType = "true";
    gridView1.advancedExcelDownload(options);
};


scwin.trigger2_onclick = function (e) {
    var options = {};
    options.fileName = "test2.xlsx";
    options.customToDataType = "false";
    gridView1.advancedExcelDownload(options);

};

scwin.getfolderPath = function () {

    var currentPath = window.location.href;
    var folderPath;

    if (currentPath.includes("mainContainer")) {
        console.log("true  ===> " + $p.getFrameId());
        const cmtFrame = $p.getComponentById($p.getFrameId());
        currentPath = cmtFrame.getSrc();
        folderPath = currentPath.substring(0, currentPath.lastIndexOf('/'));
    } else {
        console.log("false  ===> ");
        folderPath = currentPath.split('w2xPath=')[1].substring(0, currentPath.split('w2xPath=')[1].lastIndexOf('/'));
    }
    return folderPath;
};

]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload" ev:onpageunload="scwin.onpageunload">
    <xf:group id="" style="margin: 10px;">
    	<w2:textbox tagname="h1" style="color: blue;margin-bottom: 10px;" tabIndex="h1" id="textbox1"
    		label='inputType="custom" 셀의 Excel 연산 지원' escape="false">
    	</w2:textbox>
    	<w2:textbox tagname="h2" style="height: 23px;margin-bottom: 10px;color: blue;" id="textbox2" label="샘플 사용 방법"></w2:textbox>
    	<w2:textbox style="color: blue;margin-bottom: 30px;" id="textbox3"
    		label='(options.customToDataType="true")&lt;br/&gt;1-1. 첫 번째 버튼을 클릭. &lt;br/&gt;1-2. 다운로드한 Excel 파일 열기. &lt;br/&gt;1-3. inputType이 "custom"인 Expense 컬럼의 데이터 대해 Excel 연산을 수행할 수 있는 것을 확인. (예시: SUM(C1:C5) 등)&lt;br/&gt;&lt;br/&gt;(options.customToDataType="true")&lt;br/&gt;2-1. 두 번째 버튼을 클릭. &lt;br/&gt;2-2. 다운로드한 Excel 파일 열기. &lt;br/&gt;2-3. inputType이 "custom"인 Expense 컬럼의 데이터 대해 Excel 연산을 수행할 수 없는 것을 확인.'
    		escape="false">
    	</w2:textbox>
    	<xf:trigger ev:onclick="scwin.trigger1_onclick"
    		style="height:42px;line-height:32px;padding:5px;background-color:coral;font-size:15px;weight: bolder;font-weight:bolder;text-align: left;display: block;margin-bottom: 10px;"
    		id="trigger1" type="button">
    		<xf:label><![CDATA[advancedExcelDownload() - options.customToDataType="true"]]></xf:label>
    	</xf:trigger>
    	<xf:trigger type="button" id="trigger2"
    		style="height:42px;line-height:32px;padding:5px;background-color:coral;font-size:15px;weight: bolder;font-weight:bolder;text-align: left;display: block;margin-bottom: 10px;"
    		ev:onclick="scwin.trigger2_onclick">
    		<xf:label><![CDATA[advancedExcelDownload() - options.customToDataType="false"]]></xf:label>
    	</xf:trigger>
    	<w2:gridView useFilterSearch="" scrollByColumnAdaptive="false" rowNumVisible="true" dataList="data:dataList1"
    		style="border: solid gray 1px;margin-bottom: 10px;" scrollByColumn="false" id="gridView1" autoFit="allColumn" visibleRowNum="10" useFilterList=""
    		defaultCellHeight="20" visibleRowNumFix="true" filterBoxvisibleRowNum="true">
    		<w2:caption style="" id="caption1" value="this is a grid caption."></w2:caption>
    		<w2:header style="" id="header1">
    			<w2:row style="" id="row1">
    				<w2:column width="70" inputType="text" style="" id="column9" value="Status" displayMode="label" useFilter=""></w2:column>
    				<w2:column width="70" inputType="text" style="" id="column8" value="Date" displayMode="label"></w2:column>
    				<w2:column rowSpan="" colSpan="" width="70" inputType="text" style="" id="column7" value="Expense"
    					displayMode="label">
    				</w2:column>
    				<w2:column hidden="false" width="70" inputType="text" style="" id="column10" value="Income" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="" id="column5" value="Hobby" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="" id="column4" value="Region" displayMode="label" useFilter=""></w2:column>
    				<w2:column width="70" inputType="text" style="" id="column3" value="Frequency" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="" id="column2" value="ID" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="" id="column1" value="Age" displayMode="label"></w2:column>
    			</w2:row>
    		</w2:header>
    		<w2:gBody style="" id="gBody1">
    			<w2:row style="" id="row2">
    				<w2:column width="70" inputType="text" style="height:20px" id="Status" value="" displayMode="label" useFilter=""></w2:column>
    				<w2:column width="70" inputType="text" style="height:20px" id="Date" value="" displayMode="label"></w2:column>
    				<w2:column dataType="number" width="70" displayFormat="#,###.00" inputType="custom" style="height:20px" id="Expense"
    					value="" displayMode="label">
    				</w2:column>
    				<w2:column excelFormatter="" dataType="number" width="70" inputType="text" style="height:20px" id="Income" value=""
    					displayMode="label">
    				</w2:column>
    				<w2:column excelFormatter="" width="70" inputType="text" style="height:20px" id="Hobby" value="" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="height:20px" id="Region" value="" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="height:20px" id="Frequency" value="" displayMode="label"></w2:column>
    				<w2:column excelFormatter="" width="70" excelCellType="" inputType="text" style="height:20px" id="ID" value=""
    					displayMode="label">
    				</w2:column>
    				<w2:column width="70" inputType="text" style="height:20px" id="Age" value="" displayMode="label"></w2:column>
    			</w2:row>
    		</w2:gBody>
    	</w2:gridView>
    	<w2:textbox escape="false" id="textbox4"
    		label='/// 샘플 코드 (1)&lt;br/&gt;&lt;br/&gt;var options = {};&lt;br/&gt;options.fileName = "test1.xlsx";&lt;br/&gt;options.customToDataType = "true";&lt;br/&gt;gridView1.advancedExcelDownload(options);&lt;br/&gt;&lt;br/&gt;/// 샘플 코드 (2)&lt;br/&gt;&lt;br/&gt;var options = {};&lt;br/&gt;options.fileName = "test2.xlsx";&lt;br/&gt;options.customToDataType = "false";&lt;br/&gt;gridView1.advancedExcelDownload(options);'
    		style="padding:10px; padding-bottom:20px; text-align:left; font-size:15px; font-weight:bolder; border:brown 1px solid; background-color:ivory; margin-bottom:10px; color:brown;"
    		tagname="">
    	</w2:textbox>
    </xf:group></body>
</html>
