    					<w2:column id="a_code" name="airport_code" dataType="text"></w2:column>
    					<w2:column id="traffic" name="traffic" dataType="text"></w2:column>
    				</w2:columnInfo>
    			</w2:dataList>
    		</w2:dataCollection>
    		<w2:workflowCollection></w2:workflowCollection>
    	</xf:model>
