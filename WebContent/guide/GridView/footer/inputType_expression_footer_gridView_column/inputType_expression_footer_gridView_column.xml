    				</w2:column>
    				<w2:column removeBorderStyle="false" width="70" inputType="text" style="height:20px" id="column41" value="" blockSelect="false" displayMode="label">
    				</w2:column>
    				<w2:column expression='SUM("Frequency")' removeBorderStyle="false" dataType="number" width="70" inputType="expression" style="height:20px" id="column39" value="" blockSelect="false" displayMode="label">
    				</w2:column>
    				<w2:column expression='AVG("Age")' removeBorderStyle="false" dataType="number" width="70" inputType="expression" style="height:20px" id="column37" value="" blockSelect="false" displayMode="label">
    				</w2:column>
    			</w2:row>
    		</w2:footer>
    	</w2:gridView></xf:group></body>
</html>
