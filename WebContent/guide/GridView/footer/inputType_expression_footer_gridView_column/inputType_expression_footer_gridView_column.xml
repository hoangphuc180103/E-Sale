    				</w2:column>
    				<w2:column removeBorderStyle="false" width="70" inputType="text" style="height:20px" id="column3" value="Frequency" blockSelect="false" displayMode="label">
    				</w2:column>
    				<w2:column removeBorderStyle="false" width="70" inputType="text" style="height:20px" id="column1" value="Age" blockSelect="false" displayMode="label">
    				</w2:column>
    			</w2:row>
    		</w2:header>
    		<w2:gBody style="" id="gBody1">
    			<w2:row style="" id="row2">
    				<w2:column displayFormatter="" displayFormatFunc="" removeBorderStyle="false" width="70" displayFormat="#,###,###" inputType="text" style="height:20px" id="Expense" value="" blockSelect="false" displayMode="label">
    				</w2:column>
    				<w2:column displayType="#,###" removeBorderStyle="false" width="70" displayFormat="#,###,###" inputType="text" style="height:20px" id="Income" value="" blockSelect="false" displayMode="label">
    				</w2:column>
    				<w2:column customFormatter="" removeBorderStyle="false" width="70" displayFormat="" inputType="text" style="height:20px" id="Hobby" value="" blockSelect="false" displayMode="label">
    				</w2:column>
    				<w2:column removeBorderStyle="false" width="70" inputType="text" style="height:20px" id="Frequency" value="" blockSelect="false" displayMode="label">
    				</w2:column>
    				<w2:column removeBorderStyle="false" width="70" inputType="text" style="height:20px" id="Age" value="" blockSelect="false" displayMode="label">
    				</w2:column>
    			</w2:row>
    		</w2:gBody>
    		<w2:footer style="" id="footer4">
    			<w2:row style="" id="row6">
    				<w2:column expression='MIN("Expense")' removeBorderStyle="false" dataType="number" width="70" displayFormat="#,###" inputType="expression" style="height:20px" id="column43" value="" blockSelect="false" displayMode="label">
    				</w2:column>
