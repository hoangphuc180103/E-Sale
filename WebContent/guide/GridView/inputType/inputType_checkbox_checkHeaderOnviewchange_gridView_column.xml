<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            	<w2:dataList baseNode="list" id="dataList1" repeatNode="map" saveRemovedData="true" style="">
            		<w2:columnInfo>
            			<w2:column dataType="text" id="col1" name="name1"></w2:column>
            			<w2:column dataType="text" id="col2" name="name2"></w2:column>
            			<w2:column dataType="text" id="col3" name="name3"></w2:column>
            			<w2:column dataType="text" id="col4" name="name4"></w2:column>
            			<w2:column dataType="text" id="col5" name="name5"></w2:column>
            		</w2:columnInfo>
            	</w2:dataList>
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
         <script type="text/javascript" lazy="false"><![CDATA[

scwin.onpageload = function () {
    for (var i = 0; i < 5; i++) {
        dataList1.insertRow();
    }
};

scwin.onpageunload = function () {

};

scwin.gridView1_onviewchange = function (info) {
    rowIndex = info.rowIndex + 1;
    alert("onviewchange - Row " + rowIndex + " status to be changed.");
};
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload" ev:onpageunload="scwin.onpageunload">
    <xf:group id="" style="margin: 10px;">
    	<w2:textbox tagname="h1" style="color: blue;margin-bottom: 10px;" tabIndex="h1" id="textbox1" label="이벤트 - onviewchange"
    		escape="false">
    	</w2:textbox>
    	<w2:textbox tagname="h2" style="height: 23px;margin-bottom: 10px;color: blue;" id="textbox2" label="샘플 사용 방법"></w2:textbox>
    	<w2:textbox style="color: blue;margin-bottom: 30px;" id="textbox3"
    		label='아래의 경우 onviewchange 이벤트가 발생하는 것을 확인. &lt;br/&gt;1. 임의의 GridView 셀 데이터를 변경&lt;br/&gt;2. 행의 체크 박스를 선택. &lt;br/&gt;3. 헤더의 체크 박스를 선택. &lt;br/&gt;(이벤트 핸들러의 자세한 스크립트는 Script 탭에서 확인.)'
    		escape="false">
    	</w2:textbox>
    	<w2:textbox
    		style="padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightgreen;border:none;margin-bottom: 10px;"
    		id="textbox4" label="이벤트 설명&lt;br/&gt;onviewchange - 셀 데이터가 변경될 경우 발생. 체크 박스를 선택할 경우 발생. 헤더의 체크 박스를 선택할 경우 행의 개수만큼 발생."
    		escape="false">
    	</w2:textbox>
    	<w2:textbox
    		style="padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightblue;border:none;margin-bottom: 10px;"
    		id="textbox5" label='속성 설정&lt;br/&gt;checkHeaderOnviewchange="true"' escape="false">
    	</w2:textbox>
    	<w2:gridView checkHeaderOnviewchange="true" scrollByColumnAdaptive="false" syncScroll="false" rowNumVisible="true"
    		showSortableImage="true" summaryAuto="false" useShiftKey="true" scrollByColumn="false" summaryOnlyAuto="false" defaultCellHeight="20"
    		applyAllColumnStyle="false" checkAllType="include" checkOnCellClick="true" dataList="data:dataList1" dataDragSelect="true"
    		ev:onviewchange="scwin.gridView1_onviewchange" ignoreCellClick="false" style="border: solid gray 1px;" id="gridView1"
    		visibleRowNum="5" useFilterList="true" ignoreToggleOnDisabled="false" visibleRowNumFix="true" autoFit="allColumn">
    		<w2:caption style="" id="caption1" value="this is a grid caption."></w2:caption>
    		<w2:header style="" id="header1">
    			<w2:row style="" id="row1">
    				<w2:column excelLabel="선택" width="70" inputType="checkbox" style="" id="column1" value="name1" blockSelect="false"
    					displayMode="label">
    				</w2:column>
    				<w2:column width="70" inputType="text" style="" id="column2" value="name2" blockSelect="false" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="" id="column3" value="name3" blockSelect="false" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="" id="column4" value="name4" blockSelect="false" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="" id="column5" value="name5" blockSelect="false" displayMode="label"></w2:column>
    			</w2:row>
    		</w2:header>
    		<w2:gBody style="" id="gBody1">
    			<w2:row style="" id="row2">
    				<w2:column partialCheckNextClick="check" trueValue="Y" checkboxLabel="" blockSelect="false" displayMode="label"
    					falseValue="N" checkHeaderOnviewchange="true" valueType="other" width="70" inputType="checkbox" style="" id="col1"
    					checkAlways="false" value="">
    				</w2:column>
    				<w2:column width="70" inputType="" style="" id="col2" value="" blockSelect="false" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="" id="col3" value="" blockSelect="false" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="" id="col4" value="" blockSelect="false" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="" id="col5" value="" blockSelect="false" displayMode="label"></w2:column>
    			</w2:row>
    		</w2:gBody>
    	</w2:gridView>
    	<w2:textbox escape="false" id="textbox6"
    		label='/// 샘플 코드&lt;br/&gt;&lt;br/&gt;scwin.gridView1_onviewchange = function (info) {&lt;br/&gt; &amp;nbsp; &amp;nbsp;rowIndex = info.rowIndex + 1;&lt;br/&gt; &amp;nbsp; &amp;nbsp;alert("onviewchange - Row " + rowIndex + " status to be changed.");&lt;br/&gt;};'
    		style="padding:10px; padding-bottom:20px; text-align:left; font-size:15px; font-weight:bolder; border:brown 1px solid; background-color:ivory; margin-bottom:10px; margin-top:10px; color:brown;">
    	</w2:textbox>
    </xf:group></body>
</html>
