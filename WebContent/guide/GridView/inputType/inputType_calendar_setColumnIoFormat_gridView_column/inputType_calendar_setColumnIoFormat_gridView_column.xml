<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet href="/Guide/GridView/color.css" type="text/css"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
        	<xf:instance>
        		<data xmlns="" />
        	</xf:instance>
        	<w2:dataCollection baseNode="map">
        		<w2:dataList baseNode="list" repeatNode="map" id="dataList1" saveRemovedData="true" ev:oncelldatachange="scwin.dataList1_oncelldatachange">
        			<w2:columnInfo>
        				<w2:column id="Status" name="Status" dataType="text"></w2:column>
        				<w2:column id="Date" name="Date" dataType="text"></w2:column>
        				<w2:column id="Expense" name="Expense" dataType="text"></w2:column>
        				<w2:column id="Income" name="Income" dataType="text"></w2:column>
        				<w2:column id="Hobby" name="Hobby" dataType="text"></w2:column>
        				<w2:column id="Region" name="Region" dataType="text"></w2:column>
        				<w2:column id="Frequency" name="Frequency" dataType="text"></w2:column>
        				<w2:column id="ID" name="ID" dataType="text"></w2:column>
        				<w2:column id="Age" name="Age" dataType="text"></w2:column>
        			</w2:columnInfo>
        		</w2:dataList>
        	</w2:dataCollection>
        	<w2:workflowCollection></w2:workflowCollection>
        	<xf:submission id="submission1" ref="" target="data:json,dataList1" action="data.json" method="post"
        		mediatype="application/json" encoding="UTF-8" instance="" replace="" errorHandler="" customHandler="" mode="asynchronous"
        		processMsg="" ev:submit="" ev:submitdone="" ev:submiterror="" abortTrigger="">
        	</xf:submission>
        </xf:model>
        <script type="text/javascript" lazy="false"><![CDATA[
        
	scwin.onpageload = function() {
    var objSubmission = $p.getSubmission("submission1");
    objSubmission.action = scwin.getfolderPath() + '/data.json';

		$p.executeSubmission("submission1");
	};
	
	scwin.onpageunload = function() {
		
	};
		
	scwin.trigger1_onclick = function(e) {
		gridView1.setColumnIoFormat(
			{
				colIndex: "Date" , 
				ioFormat:"ddMMyyyy", // Date input format 날짜 입력 형식
				dateMask:"dd : MM : yyyy", // Date display in Input 입력란의 날짜 표시 형식 
				calendarDisplayFormat:"dd-MM-yyyy" // Date display on Calendar 달력의 날짜 표시 형식
			}
		);
	};

	scwin.getfolderPath = function () {

    var currentPath = window.location.href;
    var folderPath;

    if (currentPath.includes("mainContainer")) {
        console.log("true  ===> " + $p.getFrameId());
        const cmtFrame = $p.getComponentById($p.getFrameId());
        currentPath = cmtFrame.getSrc();
        folderPath = currentPath.substring(0, currentPath.lastIndexOf('/'));
    } else {
        console.log("false  ===> ");
        folderPath = currentPath.split('w2xPath=')[1].substring(0, currentPath.split('w2xPath=')[1].lastIndexOf('/'));
    }
    return folderPath;
};
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload" ev:onpageunload="scwin.onpageunload">
    <xf:group id="" style="margin: 10px;">
    	<w2:textbox tagname="h1" style="color: blue;margin-bottom: 10px;" tabIndex="h1" id="textbox1" label="날짜 입력 순서 및 표시 형식 지정"
    		escape="false">
    	</w2:textbox>
    	<w2:textbox tagname="h2" style="height: 23px;margin-bottom: 10px;color: blue;" id="textbox2" label="샘플 사용 방법"></w2:textbox>
    	<w2:textbox style="color: blue;margin-bottom: 30px;" id="textbox3"
    		label='1. 하단의 버튼을 클릭. &lt;br/&gt;2. Date 컬럼의 날짜 입력 형식 및 표시 형식이 변경되는 것을 확인. &lt;br/&gt;(자세한 스크립트는 Script 탭에서 확인.)' escape="false">
    	</w2:textbox>
    	<xf:trigger ev:onclick="scwin.trigger1_onclick"
    		style="height:42px;line-height:32px;padding:5px;background-color:coral;font-size:15px;weight: bolder;font-weight:bolder;text-align: left;display: block;margin-bottom: 10px;"
    		id="trigger1" type="button" class="">
    		<xf:label><![CDATA[setColumnIoFormat();]]></xf:label>
    	</xf:trigger>
    	<w2:gridView scrollByColumnAdaptive="false" contextMenu="true" dataList="data:dataList1" style="border: solid gray 1px;"
    		scrollByColumn="false" id="gridView1" autoFit="allColumn" ev:oncelldblclick="scwin.gridView1_oncelldblclick" autoFitMinWidth="0"
    		rowNumVisible="true" visibleRowNum="8" visibleRowNumFix="true">
    		<w2:caption style="" id="caption1" value="this is a grid caption."></w2:caption>
    		<w2:header style="" id="header1">
    			<w2:row style="" id="row1">
    				<w2:column removeBorderStyle="false" width="70" inputType="text" style="height:20px" id="column9" value="Status"
    					blockSelect="false" displayMode="label">
    				</w2:column>
    				<w2:column removeBorderStyle="false" width="70" inputType="text" style="height:20px" id="column8" value="Date"
    					blockSelect="false" displayMode="label">
    				</w2:column>
    				<w2:column removeBorderStyle="false" width="70" inputType="text" style="height:20px" id="column3" value="Frequency"
    					blockSelect="false" displayMode="label">
    				</w2:column>
    				<w2:column removeBorderStyle="false" width="70" inputType="text" style="height:20px" id="column2" value="ID"
    					blockSelect="false" displayMode="label">
    				</w2:column>
    			</w2:row>
    		</w2:header>
    		<w2:gBody style="" id="gBody1">
    			<w2:row style="" id="row2">
    				<w2:column removeBorderStyle="false" width="70" inputType="text" style="" id="Status" value="" blockSelect="false"
    					displayMode="label">
    				</w2:column>
    				<w2:column removeBorderStyle="false" dataType="date" width="70" inputType="calendar" style="" id="Date" value=""
    					blockSelect="false" displayMode="label" calendarValueType="" viewType="icon" viewTypeIconImage="icon">
    				</w2:column>
    				<w2:column removeBorderStyle="false" width="70" inputType="text" style="" id="Frequency" value="" blockSelect="false"
    					displayMode="label">
    				</w2:column>
    				<w2:column removeBorderStyle="false" width="70" inputType="text" style="" id="ID" value="" blockSelect="false"
    					displayMode="label">
    				</w2:column>
    			</w2:row>
    		</w2:gBody>
    	</w2:gridView>
    	<w2:textbox escape="false" id="textbox4"
    		label='/// 샘플 코드&lt;br/&gt;&lt;br/&gt;gridView1.setColumnIoFormat({&lt;br/&gt; &amp;nbsp; &amp;nbsp;colIndex: "Date",&lt;br/&gt; &amp;nbsp; &amp;nbsp;ioFormat: "ddMMyyyy", // Date input format 날짜 입력 형식&lt;br/&gt; &amp;nbsp; &amp;nbsp;dateMask: "dd : MM : yyyy", // Date display in Input 입력란의 날짜 표시 형식 &lt;br/&gt; &amp;nbsp; &amp;nbsp;calendarDisplayFormat: "dd-MM-yyyy" // Date display on Calendar 달력의 날짜 표시 형식&lt;br/&gt;});'
    		style="padding:10px; padding-bottom:20px; text-align:left; font-size:15px; font-weight:bolder; border:brown 1px solid; background-color:ivory; margin-bottom:10px; margin-top:10px; color:brown;">
    	</w2:textbox>
    </xf:group></body>
</html>
