    	<w2:textbox tagname="h2" style="height: 23px;margin-bottom: 10px;color: blue;" id="textbox2" label="샘플 사용 방법"></w2:textbox>
    	<w2:textbox style="color: blue;margin-bottom: 30px;" id="textbox3"
    		label='1. "ProgressBar에 값 설정" 버튼을 클릭. &lt;br/&gt;&lt;br/&gt;2-1. (첫 번째 ProgressBar) 설정한 값이 포매팅 없이 표시되는 것을 확인. &lt;br/&gt;&lt;br/&gt;2-2. (두 번째 ProgressBar) 설정한 값이 displayFormat 속성 값으로 지정한 포맷에 따라 표시되는 것을 확인. &lt;br/&gt;&lt;br/&gt;2-3. (세 번째 ProgressBar) 설정한 값이 displayFormatter 속성으로 지정한 함수가 반환한 값으로 표시되는 것을 확인.'
    		escape="false">
    	</w2:textbox>
    	<xf:trigger type="button" id="trigger1"
    		style="height:42px; line-height:32px; padding:5px; background-color:coral; font-size:15px; weight:bolder; font-weight:bolder; text-align:left; display:block; margin-bottom:10px;"
    		ev:onclick="scwin.trigger1_onclick">
    		<xf:label><![CDATA[ProgressBar에 값 설정]]></xf:label>
    	</xf:trigger>
    	<w2:textbox
    		style="padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightblue;border:none;margin-bottom: 10px;"
    		id="textbox4" label='속성 설정 &lt;br/&gt;displayFormat=""' escape="false">
    	</w2:textbox>
    	<w2:progressbar max="100" progressClass="type1" duration="50000" min="0" valueType="number" step="10"
    		style="width:300px; height:48px; margin-bottom:10px;" id="progress1" displayFormat="">
    	</w2:progressbar>
    	<w2:textbox escape="false" id="textbox5" label='속성 설정 &lt;br/&gt;displayFormat="0.000"'
    		style="padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightblue;border:none;margin-bottom: 10px;">
    	</w2:textbox>
    	<w2:progressbar duration="50000" min="0" max="100" valueType="number" displayFormat="0.000" progressClass="type1" step="10"
    		style="width:300px; height:48px; margin-bottom:10px;" id="progress2">
    	</w2:progressbar>
    	<w2:textbox
    		style="padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightblue;border:none;margin-bottom: 10px;"
    		id="textbox6" label='속성 설정 &lt;br/&gt;displayFormat=""&lt;br/&gt;displayFormatter="scwin.progressbar_displayFormatter"'
    		escape="false">
    	</w2:textbox>
    	<w2:textbox tagname="" style="padding:10px; padding-bottom:20px; text-align:left; font-size:15px; font-weight:bolder; border:brown 1px solid; background-color:ivory; margin-bottom:10px; color:brown;" id="textbox8" label='/// displayFormatter로 지정한 함수 구현 예시 (소수점 2자리를 표시하고 % 기호 추가.)&lt;br/&gt;&lt;br/&gt;scwin.progressbar_displayFormatter = function(value) {&lt;br/&gt; &amp;nbsp; &amp;nbsp;var ret = Number(value).toFixed(2) + "%";&lt;br/&gt; &amp;nbsp; &amp;nbsp;return ret;&lt;br/&gt;};' escape="false">
    	</w2:textbox>
    	<w2:progressbar duration="1000" displayFormatter="scwin.progressbar_displayFormatter" min="0" max="100" valueType="number"
