<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare"
	xmlns:xf="http://www.w3.org/2002/xforms">
	<head meta_author="InswaveSystems" meta_type="메인" meta_screenName="[Checkcombobox] 특정 항목 선택 및 해지하기">
		<w2:historyInfo>
			<w2:history meta_no="01" meta_desc="최초작성" meta_date="20251208" meta_user="InswaveSystems" ></w2:history>
		</w2:historyInfo>
		<w2:type>COMPONENT</w2:type>
		<w2:buildDate />
		<w2:MSA />
		<xf:model>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" repeatNode="map" id="dlt_exam_code" saveRemovedData="true">
					<w2:columnInfo>
						<w2:column id="label" name="label" dataType="text"></w2:column>
						<w2:column id="code" name="code" dataType="text"></w2:column>
					</w2:columnInfo>
					<w2:data use="true">
						<w2:row>
							<code><![CDATA[01]]></code>
							<label><![CDATA[Orange]]></label>
						</w2:row>
						<w2:row>
							<code><![CDATA[02]]></code>
							<label><![CDATA[Lime]]></label>
						</w2:row>
						<w2:row>
							<code><![CDATA[03]]></code>
							<label><![CDATA[Cherry]]></label>
						</w2:row>
						<w2:row>
							<code><![CDATA[04]]></code>
							<label><![CDATA[Avocado]]></label>
						</w2:row>
						<w2:row>
							<code><![CDATA[05]]></code>
							<label><![CDATA[Melon]]></label>
						</w2:row>
					</w2:data>
				</w2:dataList>
			</w2:dataCollection>
			<w2:workflowCollection />
		</xf:model>
		<w2:layoutInfo />
		<w2:publicInfo method="" />
		<script lazy="false" type="text/javascript"><![CDATA[
scwin.onpageload = function () {
};

// 단건 선택하기 버튼 클릭
scwin.btn_ex1_onclick = function (e) {
    // All Option 체크한 상태 - 전체 선택이 index : 0
    ccb_exam1.setSelectedInfo([{index:0,checked:true}]);
};

// 단건 해지하기 버튼 클릭
scwin.btn_ex2_onclick = function (e) {
    // All Option 체크한 상태 - 전체 선택이 index : 0
    ccb_exam1.setSelectedInfo([{index:0,checked:false}]);
};

// 다건 선택하기 버튼 클릭
scwin.btn_ex3_onclick = function (e) {
    ccb_exam2.setSelectedInfo([{index:0,checked:true},{index:2,checked:true},{index:3,checked:true}]);
};

// 다건 해지하기 버튼 클릭
scwin.btn_ex4_onclick = function (e) {
    ccb_exam2.setSelectedInfo([{index:0,checked:false},{index:2,checked:false},{index:3,checked:false}]);
};]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:group class="sub_contents" id="" style="">
			<xf:group class="ws_example_grp_desc" id="" style="">
				<w2:textbox escape="false" id="" label="CheckCombobox의 단건, 다건 항목을 메소드로 선택 및 해지하는 예제입니다." style=""></w2:textbox>
			</xf:group>
			<xf:group class="example_div_tb_style_wrap" id="">
				<xf:group class="example_div_tr_style" id="" style="">
					<w2:textbox class="example_div_th_style" escape="false" id="" label="단건 선택 및 해지 - 스크립트" style=""></w2:textbox>
					<xf:group class="example_div_td_style" id="" style="">
						<xf:group id="" style="" class="mb10">
							<xf:trigger class="btn_exam_exec" ev:onclick="scwin.btn_ex1_onclick" id="btn_ex1" style="" type="button">
								<xf:label><![CDATA[단건 선택하기]]></xf:label>
							</xf:trigger>
							<xf:trigger class="btn_exam_exec" id="btn_ex2" style="" type="button" ev:onclick="scwin.btn_ex2_onclick">
								<xf:label><![CDATA[단건 해지하기]]></xf:label>
							</xf:trigger>
						</xf:group>
						<xf:checkcombobox allOption="true" appearance="minimal" chooseOption="" direction="auto" disabled="false"
							displayAllOptionLabel="false" displayMode="label" id="ccb_exam1" ref="" style="width: 150px;min-height:24px;" submenuSize="auto">
							<xf:choices>
								<xf:itemset nodeset="data:dlt_exam_code">
									<xf:label ref="label"></xf:label>
									<xf:value ref="code"></xf:value>
								</xf:itemset>
							</xf:choices>
						</xf:checkcombobox>
					</xf:group>
				</xf:group>

				<xf:group class="example_div_tr_style" id="" style="">
					<w2:textbox class="example_div_th_style" escape="false" id="" label="다건 선택 및 해지 - 스크립트" style=""></w2:textbox>
					<xf:group class="example_div_td_style" id="" style="">
						<xf:group class="mb10" id="" style="">
							<xf:trigger class="btn_exam_exec" id="btn_ex3" style="" type="button" ev:onclick="scwin.btn_ex3_onclick">
								<xf:label><![CDATA[다건 선택하기]]></xf:label>
							</xf:trigger>
							<xf:trigger class="btn_exam_exec" ev:onclick="scwin.btn_ex4_onclick" id="btn_ex4" style="" type="button">
								<xf:label><![CDATA[다건 해지하기]]></xf:label>
							</xf:trigger>
						</xf:group>
						<xf:checkcombobox allOption="" appearance="minimal" chooseOption="" direction="auto" disabled="false"
							displayAllOptionLabel="false" displayMode="label" id="ccb_exam2" ref="" style="width: 150px;min-height:24px;" submenuSize="auto"
							separator=",">
							<xf:choices>
								<xf:itemset nodeset="data:dlt_exam_code">
									<xf:label ref="label"></xf:label>
									<xf:value ref="code"></xf:value>
								</xf:itemset>
							</xf:choices>
						</xf:checkcombobox>
					</xf:group>
				</xf:group>
			</xf:group>
		</xf:group>
	</body>
</html>