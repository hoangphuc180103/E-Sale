		<script lazy="false" type="text/javascript"><![CDATA[
scwin.onpageload = function () {

};

/**
 * [InputBox에 userData 설정하기] 클릭 시
 */
scwin.btn_ex1_onclick = function (e) {
    //inputbox에 userData 설정하기
    ibx_input.setUserData("userData1", "userData1 - Websquare");

    //로그 출력
    $c.frame.printExampleLog("** scwin.btn_ex1_onclick 실행 **", txa_log, false);
    $c.frame.printExampleLog('ibx_input.setUserData("userData1", "userData1 - Websquare");', txa_log, false);
};

/**
 * [InputBox의 userData 반환받기] 클릭 시
 */
scwin.btn_ex2_onclick = function (e) {
    //inputbox의 userData의 "userData1" 값 반환받기.
    let strRet = ibx_input.getUserData("userData1");
    
    //로그 출력
    $c.frame.printExampleLog("** scwin.btn_ex2_onclick 실행 **", txa_log, false);
    $c.frame.printExampleLog('ibx_input.getUserData("userData1");', txa_log, false);
    $c.frame.printExampleLog('반환값 : ' + strRet, txa_log, false);

    //반환값 alert
    alert(strRet);
};


/**
 * textarea의 로그 삭제
 */
scwin.btn_clearLog_onclick = function (e) {
    txa_log.setValue("");
};
]]></script>
