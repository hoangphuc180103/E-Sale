<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare"
	xmlns:xf="http://www.w3.org/2002/xforms">
	<head meta_author="InswaveSystems" meta_type="메인" meta_screenName="Date 객체의 포맷을 지정해 문자열로 반환받기">
		<w2:historyInfo>
			<w2:history meta_no="01" meta_desc="최초작성" meta_date=" 20230803" meta_user="InswaveSystems"></w2:history>
			<w2:history meta_no="02" meta_desc="설명부 수정" meta_date="20240621" meta_user="InswaveSystems" ></w2:history>
		</w2:historyInfo>
		<w2:type>COMPONENT</w2:type>
		<w2:buildDate />
		<w2:MSA />
		<xf:model>
			<w2:dataCollection baseNode="map">
			</w2:dataCollection>
			<w2:workflowCollection />
		</xf:model>
		<w2:layoutInfo />
		<w2:publicInfo method="" />
		<script lazy="false" type="text/javascript"><![CDATA[
scwin.onpageload = function () {
    
};
/**
 * 버튼 "날짜 포맷 적용하기"의 onclick 이벤트
 */
scwin.btn_setFormat_onclick = function (e) {
    // 현재 날짜 객체 생성
    var _date = new Date();
    var _result = "";
    // 입력 컴포넌트에 입력한 날짜 포맷 저장
    var _format = ipt_format.getValue();

    // 매개변수로 Date객체와 포맷을 입력받아 포맷이 적용된 날짜를 반환합니다.
    _result = $p.getFormattedDate(_date, _format);

    // 로그 출력
    let strLog = _format + " : " + _result;
    $c.frame.printExampleLog(strLog, txa_log, false);
    console.log(strLog);
};


/**
 * textarea의 로그 삭제
 */
scwin.btn_clearLog_onclick = function (e) {
    let strTargetId = this.getUserData("userData1");
    let cmpTarget;
    if (strTargetId) {
        cmpTarget = $p.getComponentById(strTargetId) || txa_log;
    } else {
        cmpTarget = txa_log;
    }
    //textarea value를 빈문자열로 할당.
    cmpTarget.setValue("");
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:group class="sub_contents" id="" style="" nextTabID="">
			<xf:group class="ws_example_grp_desc" id="" style="">
				<w2:textbox escape="false" id="" label="$p의 'getFormattedDate' 메소드를 사용하여 Date객체에 날짜 포맷을 설정하여 문자열로 반환받는 예제입니다." style=""></w2:textbox>
			</xf:group>
			<xf:group class="example_div_tb_style_wrap mb_def" id="">

				<xf:group class="example_div_tr_style" id="" style="">

					<xf:group class="example_div_td_style" id="" style="">
						<xf:group id="" class="def_box">
							<w2:span id="" label="날짜 포맷: "
								style="vertical-align: middle; display: inline-block; margin-right: 6px;">
							</w2:span>
							<xf:input style="width: 220px; margin-right: 6px;" id="ipt_format" class="" initValue="yyyy-MM-dd HH:mm:ss.SSS"></xf:input>
							<xf:trigger class="btn_exam_exec" ev:onclick="scwin.btn_setFormat_onclick" id="btn_setFormat" style=""
								type="button">
								<xf:label><![CDATA[날짜 포맷 적용하기]]></xf:label>
							</xf:trigger>
						</xf:group>
					</xf:group>
				</xf:group>
			</xf:group>
			<xf:group class="example_div_tb_style_wrap" id="" style="">
				<xf:group class="example_div_tr_style" id="" style="">
					<xf:group class="example_div_th_style" id="">
						<w2:span class="mr_def txt_blue" id="" label="로그 확인" style=""></w2:span>
						<xf:trigger class="wre_btn_log_clear" ev:onclick="scwin.btn_clearLog_onclick" id="btn_clearLog" style="" title="로그 삭제"
							type="button">
							<xf:label><![CDATA[로그 삭제]]></xf:label>
						</xf:trigger>
					</xf:group>
					<xf:group class="example_div_td_style" id="" style="">
						<xf:textarea class="wre_txa_log" id="txa_log" spellcheck="false" style="width: 100%;height: 140px;"></xf:textarea>
					</xf:group>
				</xf:group>
			</xf:group>
		</xf:group>
	</body>
</html>
