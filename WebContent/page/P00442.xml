<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head meta_screenName="[FusionChart] 차트 타입 예제 - FwPyramidChart_simple">
        <w2:type>COMPONENT</w2:type>
        <w2:buildDate/>
        <w2:MSA/>
        <xf:model>
            <w2:dataCollection baseNode="map">
            	<w2:dataList baseNode="list" id="dlt_list" repeatNode="map" saveRemovedData="true" style="">
            		<w2:columnInfo>
            			<w2:column dataType="text" id="col1" name="name1"></w2:column>
            			<w2:column dataType="text" id="col2" name="name2"></w2:column>
            		</w2:columnInfo>
            		<w2:data use="true">
            			<w2:row>
            				<col1><![CDATA[A]]></col1>
            				<col2><![CDATA[1]]></col2>
            			</w2:row>
            			<w2:row>
            				<col1><![CDATA[A]]></col1>
            				<col2><![CDATA[2]]></col2>
            			</w2:row>
            			<w2:row>
            				<col1><![CDATA[A]]></col1>
            				<col2><![CDATA[3]]></col2>
            			</w2:row>
            			<w2:row>
            				<col1><![CDATA[B]]></col1>
            				<col2><![CDATA[4]]></col2>
            			</w2:row>
            			<w2:row>
            				<col1><![CDATA[B]]></col1>
            				<col2><![CDATA[5]]></col2>
            			</w2:row>
            			<w2:row>
            				<col1><![CDATA[B]]></col1>
            				<col2><![CDATA[6]]></col2>
            			</w2:row>
            		</w2:data>
            	</w2:dataList>
            	<w2:linkedDataList bind="dlt_list" id="linkedDataList1">
            		<w2:condition type="filter"><![CDATA[col1 == 'A']]></w2:condition>
            		<w2:condition type="sort"><![CDATA[DESC('col2')]]></w2:condition>
            	</w2:linkedDataList>
            </w2:dataCollection>
            <w2:workflowCollection/>
        </xf:model>
        <w2:layoutInfo/>
        <w2:publicInfo method=""/>
        <script lazy="false" type="text/javascript"><![CDATA[
scwin.onpageload = function() {
	
};

/**
 * 메소드로 DataList 데이터 정렬하기
 * 
 * sort(ColumnId, sortType)
 * sortType - 정렬 옵션 (0: 오름차순, 1: 내림차순, 2: 정렬 취소)
 */
scwin.btn_exam1_onclick = function (e) {
    dlt_list.sort('col2', 1);
};

scwin.btn_exam2_onclick = function (e) {
    dlt_list.sort('col2', 0);
};

scwin.btn_exam3_onclick = function (e) {
    dlt_list.sort('col2', 2);
};
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload">
    	<xf:group class="sub_contents" id="" style="">
    		<xf:group class="ws_example_grp_desc" id="" style="">
    			<w2:textbox escape="false" id="" label="LinkedDataList 객체와 DataList의 sort() 메소드를 사용한 예제입니다." style=""></w2:textbox>
    		</xf:group>
    		<xf:group class="example_div_tb_style_wrap mb_def" id="" style="">
    			<xf:group style="" id="" class="mb_def_box nobottom">
    				<xf:trigger style="" id="btn_exam1" type="button" class="btn_exam_exec btn_txt_of" escape="false"
    					ev:onclick="scwin.btn_exam1_onclick">
    					<xf:label><![CDATA[메소드로 'col2' 컬럼에 sort 내림차순 적용하기]]></xf:label>
    				</xf:trigger>
    				<xf:trigger class="btn_exam_exec btn_txt_of" escape="false" id="btn_exam2" style=""
    					type="button" ev:onclick="scwin.btn_exam2_onclick">
    					<xf:label><![CDATA[메소드로 'col2' 컬럼에 sort 오름차순 적용하기]]></xf:label>
    				</xf:trigger>
    				<xf:trigger class="btn_exam_exec btn_txt_of" escape="false" id="btn_exam3" style=""
    					type="button" ev:onclick="scwin.btn_exam3_onclick">
    					<xf:label><![CDATA[메소드로 'col2' 컬럼에 적용된 sort 취소하기]]></xf:label>
    				</xf:trigger>
    			</xf:group>
    			<xf:group class="example_div_tr_style" id="" style="">
    				<w2:textbox class="example_div_th_style" escape="false" id="" label='기존 DataList' style="margin-bottom: 7px;">
    				</w2:textbox>
    				<xf:group class="gvwbox" id="" style="max-width: 340px;">
    					<w2:gridView scrollByColumnAdaptive="false" rowNumVisible="false" scrollByColumn="false"
    						defaultCellHeight="26" checkReadOnlyOnPasteEnable="" focusMode="row" dataList="data:dlt_list" style="height: 150px;"
    						autoFit="allColumn" id="gridView1" visibleRowNum="10" class="gvw" touchScrollDelta="1">
    						<w2:caption style="" id="caption1" value="this is a grid caption."></w2:caption>
    						<w2:header style="" id="header1">
    							<w2:row style="" id="row1">
    								<w2:column width="70" inputType="text" style="" id="col1" value="col1" displayMode="label"></w2:column>
    								<w2:column width="70" inputType="text" style="" id="col2" value="col2" displayMode="label"></w2:column>
    							</w2:row>
    						</w2:header>
    						<w2:gBody style="" id="gBody1">
    							<w2:row style="" id="row2">
    								<w2:column width="70" inputType="text" style="" id="col1" value="" displayMode="label"></w2:column>
    								<w2:column width="70" inputType="text" style="" id="col2" value="" displayMode="label"></w2:column>
    							</w2:row>
    						</w2:gBody>
    					</w2:gridView>
    				</xf:group>
    			</xf:group>
    			<xf:group class="example_div_tr_style" id="" style="">
    				<w2:textbox class="example_div_th_style" escape="false" id=""
    					label="LinkedDataList [filter: col1 == 'A', sort: DESC('col2')]" style="margin-bottom: 7px;">
    				</w2:textbox>
    				<xf:group class="gvwbox" id="" style="max-width: 340px;">
    					<w2:gridView scrollByColumnAdaptive="false" rowNumVisible="false" scrollByColumn="false"
    						defaultCellHeight="26" checkReadOnlyOnPasteEnable="" focusMode="row" dataList="data:linkedDataList1" style="height: 108px;"
    						autoFit="allColumn" id="gridView2" class="gvw" touchScrollDelta="5">
    						<w2:caption style="" id="caption1" value="this is a grid caption."></w2:caption>
    						<w2:header style="" id="header1">
    							<w2:row style="" id="row1">
    								<w2:column width="70" inputType="text" style="" id="column2" value="col1" displayMode="label"></w2:column>
    								<w2:column width="70" inputType="text" style="" id="column1" value="col2" displayMode="label"></w2:column>
    							</w2:row>
    						</w2:header>
    						<w2:gBody style="" id="gBody1">
    							<w2:row style="" id="row2">
    								<w2:column width="70" inputType="text" style="" id="col1" value="" displayMode="label"></w2:column>
    								<w2:column width="70" inputType="text" style="" id="col2" value="" displayMode="label"></w2:column>
    							</w2:row>
    						</w2:gBody>
    					</w2:gridView>
    				</xf:group>
    			</xf:group>
    		</xf:group>
    	</xf:group>
    </body>
</html>
