		<script lazy="false" type="text/javascript"><![CDATA[
scwin.onpageload = function () {
	// 예제 테스트를 위한 초기화
    scwin.initializeExample();
};


// 예제 테스트를 위한 초기화
scwin.initializeExample = function () {
    // windowContainer 'wdc_exam1', 'wdc_exam2'의 윈도우 생성하기
    for (let i = 1; i <= 3; i++) {
        // 툴바의 네임레이어에 표시되는 타이틀
        let title = "window " + i;
        // 서브화면의 경로
        let srcPath = "/page/P00223S0" + i + ".xml";
        // window ID로 null 이나 ""입력 시 title이 id로 생성
        let windowId = "window_" + i;

        let options = {
            "title": title,
            "windowID": windowId,
            "frameMode": "pageFrame",
            "src": srcPath
        };

        wdc_exam1.createWindow(options);
        wdc_exam2.createWindow(options);
    }
};
]]></script>
