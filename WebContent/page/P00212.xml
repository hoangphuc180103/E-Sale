								<xf:label><![CDATA['B' 컬럼 숨기기]]></xf:label>
							</xf:trigger>
							<xf:trigger class="btn_exam_exec btn_txt_of" disabled="" escape="false" ev:onclick="scwin.btn_ex1_2_onclick"
								id="btn_ex1_2" style="" type="button">
								<xf:label><![CDATA['B' 컬럼 보이기]]></xf:label>
							</xf:trigger>
						</xf:group>
						<xf:group id="" class="gvwbox">
							<w2:gridView dataList="data:dlt_exam" style="height: 100px;" scrollByColumn="false" autoFit="allColumn" id="grd_exam1"
