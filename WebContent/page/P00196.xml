		<script type="text/javascript" lazy="false"><![CDATA[
// 페이지 로드 시 실행
scwin.onpageload = function () {
    
};

// 그리드뷰 footer 총 건수 표시 형식
scwin.footer_count = function (data) {
    return "총 " + data + " 건";
};

scwin.masking_formatter = function (data) {
    var len = data.length;
    var str = "";
    if (len <= 0) {
        return "";
    }
    for (var i = 0; i < len - 2; i++)
        str += '*';
    return str + "증권";
};


// 2줄 그리드 기능 처리
// 다운로드
scwin.btn_down_onclick = function (e) {
    // 옵션 변수
    var options = {};
    // xlsx, xls, csv 구분 ex) .csv

	var dataType = select_type.getValue();
 
    // 옵션 설정
    options.type = dataType;
	options.fileName = "EXAMPLE_P00196_"+dataType+".xlsx";

    // 컬럼 무브를 적용해 다운 받을지 여부
    options.columnMove = "true";
    // 스타일 사용 여부
    options.useStyle = "true";
    // footer 포함 여부
    options.useFooter = "true";
    options.showProcess = true;
    // 다운로드
    grd.advancedExcelDownload(options);
};

//업로드
scwin.btn_up_onclick = function (e) {
    var options = {};
    var type = select_type.getValue();
    options.type = type;
    // 업로드 창 modal 사용 여부
    options.useModalDisable = "true";
    // 헤더 존재 여부
    options.headerExist = "1";
    options.processMsg = "업로드중입니다.";

    // csv 타입인 경우
    if (type == ".csv") {
        options.delim = ";"
        grd1.readCSV(options);
        return;
    }
    // 업로드
    grd.advancedExcelUpload(options);
};

//초기화
scwin.btn_clean_onclick = function (e) {
    dl_gridview.setJSON([]);
};

//조회
scwin.btn_search_onclick = function (e) {
    $p.executeSubmission("sbm_gridview");
};

]]></script>
