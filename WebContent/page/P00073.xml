					<xf:group class="example_div_td_style" id="" style="">
						<xf:trigger class="btn_exam_exec btn_txt_of mt_def" ev:onclick="scwin.btn_exam1_onclick" id="btn_exam1" localeRef=""
							style="" type="" useDefaultLabel="true">
