<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head meta_screenName="[FusionChart] 차트 타입 예제 - FwPyramidChart_simple">
        <w2:type>COMPONENT</w2:type>
        <w2:buildDate/>
        <w2:MSA/>
        <xf:model>
            <w2:dataCollection baseNode="map">
            	<w2:dataList baseNode="list" id="dlt_list" repeatNode="map" saveRemovedData="true" style="">
            		<w2:columnInfo>
            			<w2:column dataType="text" id="id1" name="name1"></w2:column>
            			<w2:column dataType="text" id="id2" name="name2"></w2:column>
            			<w2:column dataType="text" id="id3" name="name3"></w2:column>
            		</w2:columnInfo>
            	</w2:dataList>
            </w2:dataCollection>
            <w2:workflowCollection/>
        </xf:model>
        <w2:layoutInfo/>
        <w2:publicInfo method=""/>
        <script lazy="false" type="text/javascript"><![CDATA[
scwin.onpageload = function() {
    var array = new Array();

    for(var i=0; i<30000; i++){
        var _data = "data_" + i;
        array.push(_data);
    }

    dlt_list.setData(array);
	
};
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload">
    	<xf:group class="sub_contents" id="" style="">
    		<xf:group class="ws_example_grp_desc" id="" style="">
    			<w2:textbox escape="false" id="" label="GridView의 'touchScrollDelta' 속성으로 스크롤 속도를 제어하는 예제입니다.&lt;br/&gt;(1이 가장 느린 속도이며, 5가 가장 빠른 속도 입니다.)" style=""></w2:textbox>
    		</xf:group>
    		<xf:group class="example_div_tb_style_wrap mb_def" id="" style="">
    			<xf:group class="example_div_tr_style" id="" style="">
    				<w2:textbox class="example_div_th_style" escape="false" id="" label='touchScrollDelta="1"'
    					style="margin-bottom: 7px;">
    				</w2:textbox>
    				<w2:gridView autoFit="allColumn" checkReadOnlyOnPasteEnable="" class="gvw" dataList="data:dlt_list"
    					defaultCellHeight="26" focusMode="row" id="gridView1" rowNumHeaderValue="순번" rowNumVisible="true" scrollByColumn="false"
    					scrollByColumnAdaptive="false" style="height: 150px;" touchScrollDelta="1" visibleRowNum="10">
    					<w2:caption id="caption2" style="" value="this is a grid caption."></w2:caption>
    					<w2:header id="header1" style="">
    						<w2:row id="row1" style="">
    							<w2:column displayMode="label" id="column3" inputType="text" style="" value="첫번째 컬럼" width="70"></w2:column>
    							<w2:column displayMode="label" id="column2" inputType="text" style="" value="두번째 컬럼" width="70"></w2:column>
    							<w2:column displayMode="label" id="column1" inputType="text" style="" value="세번째 컬럼" width="70"></w2:column>
    						</w2:row>
    					</w2:header>
    					<w2:gBody id="gBody1" style="">
    						<w2:row id="row2" style="">
    							<w2:column displayMode="label" id="id1" inputType="text" style="" value="" width="70"></w2:column>
    							<w2:column displayMode="label" id="id2" inputType="text" style="" value="" width="70"></w2:column>
    							<w2:column displayMode="label" id="id3" inputType="text" style="" value="" width="70"></w2:column>
    						</w2:row>
    					</w2:gBody>
    				</w2:gridView>
    			</xf:group>
    			<xf:group class="example_div_tr_style" id="" style="">
    				<w2:textbox class="example_div_th_style" escape="false" id="" label='touchScrollDelta="5"'
    					style="margin-bottom: 7px;">
    				</w2:textbox>
    				<w2:gridView autoFit="allColumn" checkReadOnlyOnPasteEnable="" class="gvw" dataList="data:dlt_list"
    					defaultCellHeight="26" focusMode="row" id="gridView2" rowNumHeaderValue="순번" rowNumVisible="true" scrollByColumn="false"
    					scrollByColumnAdaptive="false" style="height: 150px;" visibleRowNum="10" touchScrollDelta="5">
    					<w2:caption id="caption3" style="" value="this is a grid caption."></w2:caption>
    					<w2:header id="header1" style="">
    						<w2:row id="row1" style="">
    							<w2:column displayMode="label" id="column3" inputType="text" style="" value="첫번째 컬럼" width="70"></w2:column>
    							<w2:column displayMode="label" id="column2" inputType="text" style="" value="두번째 컬럼" width="70"></w2:column>
    							<w2:column displayMode="label" id="column1" inputType="text" style="" value="세번째 컬럼" width="70"></w2:column>
    						</w2:row>
    					</w2:header>
    					<w2:gBody id="gBody1" style="">
    						<w2:row id="row2" style="">
    							<w2:column displayMode="label" id="id1" inputType="text" style="" value="" width="70"></w2:column>
    							<w2:column displayMode="label" id="id2" inputType="text" style="" value="" width="70"></w2:column>
    							<w2:column displayMode="label" id="id3" inputType="text" style="" value="" width="70"></w2:column>
    						</w2:row>
    					</w2:gBody>
    				</w2:gridView>
    			</xf:group>
    		</xf:group>
    	</xf:group>
    </body>
</html>
