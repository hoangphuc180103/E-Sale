<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head meta_screenName="[FusionChart] 차트 타입 예제 - FwPyramidChart_simple">
        <w2:type>COMPONENT</w2:type>
        <w2:buildDate/>
        <w2:MSA/>
        <xf:model>
            <w2:dataCollection baseNode="map">
            	<w2:dataList baseNode="list" repeatNode="map" id="dataList1" saveRemovedData="true">
            		<w2:columnInfo>
            			<w2:column id="label" name="표시 값" dataType="text"></w2:column>
            			<w2:column id="value" name="코드 값" dataType="text"></w2:column>
            		</w2:columnInfo>
            		<w2:data use="true">
            			<w2:row>
            				<label><![CDATA[1]]></label>
            				<value><![CDATA[1]]></value>
            			</w2:row>
            			<w2:row>
            				<label><![CDATA[2]]></label>
            				<value><![CDATA[2]]></value>
            			</w2:row>
            			<w2:row>
            				<label><![CDATA[3]]></label>
            				<value><![CDATA[3]]></value>
            			</w2:row>
            			<w2:row>
            				<label><![CDATA[4]]></label>
            				<value><![CDATA[4]]></value>
            			</w2:row>
            			<w2:row>
            				<label><![CDATA[5]]></label>
            				<value><![CDATA[5]]></value>
            			</w2:row>
            			<w2:row>
            				<label><![CDATA[6]]></label>
            				<value><![CDATA[6]]></value>
            			</w2:row>
            			<w2:row>
            				<label><![CDATA[7]]></label>
            				<value><![CDATA[7]]></value>
            			</w2:row>
            			<w2:row>
            				<label><![CDATA[8]]></label>
            				<value><![CDATA[8]]></value>
            			</w2:row>
            			<w2:row>
            				<label><![CDATA[9]]></label>
            				<value><![CDATA[9]]></value>
            			</w2:row>
            			<w2:row>
            				<label><![CDATA[10]]></label>
            				<value><![CDATA[10]]></value>
            			</w2:row>
            		</w2:data>
            	</w2:dataList>
            </w2:dataCollection>
            <w2:workflowCollection/>
        </xf:model>
        <w2:layoutInfo/>
        <w2:publicInfo method=""/>
        <script lazy="false" type="text/javascript"><![CDATA[
scwin.onpageload = function() {
    // 'rangeSeparator' 설정 값 : 기본
    chkcom1.setSelectedInfo(
        [
            {index:0,checked:true},
            {index:1,checked:true},
            {index:3,checked:true},
            {index:4,checked:true},
            {index:5,checked:true},
            {index:7,checked:true},
            {index:8,checked:true},
            {index:9,checked:true}
        ]
    );

    // 'rangeSeparator' 설정 값 : '-'
    chkcom2.setSelectedInfo(
        [
            {index:0,checked:true},
            {index:1,checked:true},
            {index:3,checked:true},
            {index:4,checked:true},
            {index:5,checked:true},
            {index:7,checked:true},
            {index:8,checked:true},
            {index:9,checked:true}
        ]
    );
};]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload">
    	<xf:group class="sub_contents" id="" style="">
    		<xf:group class="ws_example_grp_desc" id="" style="">
    			<w2:textbox escape="false" id="" label="CheckCombobox의 'rangeSeparator' 속성을 사용하여, 연속된 선택 항목을 축약 표시한 예제입니다." style="">
    			</w2:textbox>
    		</xf:group>
    	<xf:group class="example_div_tb_style_wrap" style="">
    		<xf:group class="example_div_tr_style">
    			<w2:textbox class="example_div_th_style" escape="false" label="'rangeSeparator' 기본 설정 값"></w2:textbox>
    			<xf:group class="example_div_td_style">
    				<xf:checkcombobox id="chkcom1" chooseOption="" displayMode="label" style="width: 200px;height: 30px;" submenuSize="auto"
    					allOption="" disabled="false" direction="auto" ref="" separator=",">
    					<xf:choices>
    						<xf:itemset nodeset="data:dataList1">
    							<xf:label ref="label"></xf:label>
    							<xf:value ref="value"></xf:value>
    						</xf:itemset>
    					</xf:choices>
    				</xf:checkcombobox>
    			</xf:group>
    		</xf:group>
    		<xf:group class="example_div_tr_style">
    			<w2:textbox class="example_div_th_style" escape="false" label="'rangeSeparator' 설정 값 : '-'"></w2:textbox>
    			<xf:group class="example_div_td_style">
    				<xf:checkcombobox allOption="" chooseOption="" direction="auto" disabled="false" displayMode="label" id="chkcom2"
    					style="width: 200px;height: 30px;" submenuSize="auto" ref="" rangeSeparator="-" separator=",">
    					<xf:choices>
    						<xf:itemset nodeset="data:dataList1">
    							<xf:label ref="label"></xf:label>
    							<xf:value ref="value"></xf:value>
    						</xf:itemset>
    					</xf:choices>
    				</xf:checkcombobox>
    			</xf:group>
    		</xf:group>
    	</xf:group></xf:group>
    	
    </body>
</html>
