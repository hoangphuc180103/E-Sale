										<w2:column blockSelect="false" id="column7" inputType="text" style="" value="B" width="120"></w2:column>
									</w2:row>
								</w2:header>
								<w2:gBody id="gBody4" style="">
									<w2:row id="row5" style="">
										<w2:column blockSelect="false" class="" id="category" inputType="select" style="" textAlign="center"
											viewType="icon" width="120">
											<w2:choices>
