		<script lazy="false" type="text/javascript"><![CDATA[
scwin.onpageload = function () {

};

/**
 * 예제 테스트를 위한 공용 onclick 핸들러
 */
scwin.btn_example_test_onclick_user = function (e) {
    var strLog;

    //로그 출력
    strLog = "[공용] onclick 이벤트 핸들러 - 메소드 scwin.btn_example_test_onclick_user";
    $c.frame.printExampleLog(strLog, txa_log, false);
    console.log(strLog);

};

/**
 * 영역 [이벤트 추가하기]의
 * 버튼 [테스트 버튼에 onclick 이벤트 추가하기] 클릭 시
 * [컴포넌트 ID].bind( eventType , function );
 */
scwin.btn_ex1_onclick = function (e) {
    var strLog;

    //로그 출력
    strLog = "** 메소드 scwin.btn_ex1_onclick **";
    $c.frame.printExampleLog(strLog, txa_log, false);
    console.log(strLog);
    strLog = 'btn_exam_test1.bind("onclick", scwin.btn_example_test_onclick_user);';
    $c.frame.printExampleLog(strLog, txa_log, false);
    console.log(strLog);

    //버튼 [테스트 버튼]에 onclick 이벤트 핸들러(scwin.btn_example_test_onclick_user) 연결
    btn_exam_test1.bind("onclick", scwin.btn_example_test_onclick_user);
};

/**
 * textarea의 로그 삭제
 */
scwin.btn_clearLog_onclick = function (e) {
    txa_log.setValue("");
};




]]></script>
