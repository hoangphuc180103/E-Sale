					<xf:group id="" class="tbcbox"><w2:tabControl confirmTrueAction="exist" confirmFalseAction="new" useTabKeyOnly="true" tabScroll="" useMoveNextTabFocus="false" useConfirmMessage="false" alwaysDraw="false" style="position: relative;height: 160px;" id="tac_exam1" class="tbc">
						</w2:tabControl></xf:group></xf:group>
