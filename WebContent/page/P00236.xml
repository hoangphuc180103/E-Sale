		<script lazy="false" type="text/javascript"><![CDATA[
scwin.onpageload = function () {

};

/**
 * 버튼 [엑셀 다운로드 - 기본] 클릭 시
 */
scwin.btn_ex1_onclick = function (e) {
    var jsnOptions;

    jsnOptions = {
        fileName: "EXAMPLE_P00236_TYPE1.xlsx", //엑셀의 파일명
        useSubTotal: "true" //subTotal 표시
    };

    grd_exam1.advancedExcelDownload(jsnOptions);
};

/**
 * 버튼 [엑셀 다운로드 - 서브토탈의 스타일 설정] 클릭 시
 */
scwin.btn_ex2_onclick = function (e) {
    var jsnOptions;

    jsnOptions = {
        fileName: "EXAMPLE_P00236_TYPE2.xlsx", //엑셀의 파일명
        useSubTotal: "true", //필수 설정 - subTotal 표시
        useStyle: "false", //필수 설정
        subTotalColor: "green", //서브토탈의 배경색 (Green)
        subTotalFontName: "Arial", //서브토탈의 글자체
        subTotalFontSize: "14", //서브토탈의 글자 크기
        subTotalFontColor: "white", //서브토탈의 글자색 (White)
        subTotalFontBold: "true" //서브토탈의 글자 굵게 설정
    };

    //useSubTotal : <String:N> [default: false, true] 다운로드시 SubTotal을 출력 할지 여부.
    //useStyle <String:N> [default: false] 다운로드시 css를 제외한, style을 excel에도 설정할 지 여부 (배경색,폰트)
    //subTotalColor : <String:N> [default: #CCFFCC] Excel 파일에서 그리드의 subtotal분의 색
    //subTotalFontName : <String:N> [default: 없음] Excel 파일에서 그리드의 subtotal의 font name
    //subTotalFontSize : <String:N> Excel 파일에서 그리드의 subtotal의 font size
    //subTotalFontColor : <String:N> [default: 없음] Excel 파일에서 그리드의 subtotal의 font 색
    //subTotalFontBold : <String:N> [default: 없음] Excel 파일에서 그리드의 subTotal의 Bold 설정 유무

    //GridView "grd_exam1"의 엑셀 다운로드 실행
    grd_exam1.advancedExcelDownload(jsnOptions);
};]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:group class="sub_contents">
			<xf:group class="ws_example_grp_desc">
				<w2:textbox class="" escape="false" label="GridView의 'advancedExcelDownload' 메소드를 사용하여, 엑셀 다운로드 시 서브토탈 컬럼에 스타일을 설정한 예제입니다."
					style="">
				</w2:textbox>
			</xf:group>
			<xf:group class="example_div_tb_style_wrap">
				<xf:group class="mb_def_box nobottom">
					<xf:trigger class="btn_exam_exec btn_txt_of" ev:onclick="scwin.btn_ex1_onclick" id="btn_ex1" localeRef=""
						style="min-width: 30px; height: 26px;" type="" useDefaultLabel="true">
						<xf:label><![CDATA[엑셀 다운로드 - 기본]]></xf:label>
					</xf:trigger>
					<xf:trigger class="btn_exam_exec btn_txt_of" ev:onclick="scwin.btn_ex2_onclick" id="btn_ex2" localeRef=""
						style="min-width:30px;height:26px;" type="" useDefaultLabel="true">
						<xf:label><![CDATA[엑셀 다운로드 - 서브토탈의 스타일 설정]]></xf:label>
					</xf:trigger>
				</xf:group>
				<xf:group id="" class="gvwbox" style="max-width: 400px;">
					<w2:gridView baseNode="" focusMode="row" dataList="data:dlt_exam" readOnly="true" style="height:200px;" id="grd_exam1"
						visibleRowNum="all" autoFit="allColumn" class="gvw" defaultCellHeight="37" autoFitMinWidth="266">
						<w2:header style="" id="header5">
							<w2:row style="" id="row35">
								<w2:column hidden="false" width="100" inputType="text" id="h_col1" value="Category" blockSelect="false"
									displayMode="label">
								</w2:column>
								<w2:column width="110" inputType="text" id="h_col2" value="Product" blockSelect="false"
									displayMode="label">
								</w2:column>
								<w2:column width="100" inputType="text" id="h_col3" value="Stock"></w2:column>
							</w2:row>
						</w2:header>
						<w2:gBody style="" id="gBody5">
							<w2:row style="" id="row37">
								<w2:column hidden="false" colMerge="true" width="100" inputType="text" id="category" blockSelect="false"
									displayMode="label">
								</w2:column>
								<w2:column textAlign="left" width="110" inputType="text" id="product" blockSelect="false"
									displayMode="label">
								</w2:column>
								<w2:column textAlign="right" dataType="number" width="100" displayFormat="#,###" inputType="text"
									id="stock">
								</w2:column>
							</w2:row>
						</w2:gBody>
						<w2:subTotal targetColumnID="category" style="" id="subTotal1">
							<w2:row style="" id="row42">
								<w2:column width="100" inputType="text" style="height:30px;" id="column577" value="Subtotal"
									blockSelect="false" displayMode="label">
								</w2:column>
								<w2:column expression="targetColValue() + ':  ' +count('product')" textAlign="left" width="110"
									inputType="expression" style="height:30px;" id="column596" blockSelect="false" displayMode="label">
								</w2:column>
								<w2:column expression="sum('stock')" textAlign="right" dataType="number" width="100" displayFormat="#,###"
									inputType="expression" style="height:30px;" id="sub_col_1" blockSelect="false" displayMode="label">
								</w2:column>
							</w2:row>
						</w2:subTotal>
						<w2:footer style="" id="footer1">
							<w2:row style="" id="row41">
								<w2:column width="100" inputType="text" style="height:40px;" id="column580" value="Total"
									blockSelect="false" displayMode="label">
								</w2:column>
								<w2:column expression="'Products: '+ count('product')" textAlign="left" width="110" inputType="expression"
									style="height:40px;" id="column597">
								</w2:column>
								<w2:column expression="sum('stock')" textAlign="right" dataType="number" width="100" displayFormat="#,###"
									inputType="expression" style="height:40px;" id="column526">
								</w2:column>
							</w2:row>
						</w2:footer>
					</w2:gridView>
				</xf:group>
			</xf:group>
		</xf:group>
	</body>
</html>