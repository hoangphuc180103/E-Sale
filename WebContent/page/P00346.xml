								autoFit="allColumn" class="gvw" defaultCellHeight="37">
								<w2:caption style="" id="caption1" value="this is a grid caption."></w2:caption>
								<w2:header style="" id="header1">
									<w2:row style="" id="row1">
										<w2:column width="80" inputType="text" style="" id="column4" value="A" displayMode="label"></w2:column>
										<w2:column width="80" inputType="text" style="" id="column3" value="B" displayMode="label"></w2:column>
										<w2:column width="80" inputType="text" style="" id="column2" value="C" displayMode="label"></w2:column>
										<w2:column width="80" inputType="text" style="" id="column1" value="D" displayMode="label"></w2:column>
									</w2:row>
								</w2:header>
								<w2:gBody style="" id="gBody1">
									<w2:row style="" id="row2">
										<w2:column width="80" inputType="text" style="" id="col_a" value="" displayMode="label"></w2:column>
										<w2:column width="80" inputType="text" style="" id="col_b" value="" displayMode="label"></w2:column>
										<w2:column width="80" inputType="text" style="" id="col_c" value="" displayMode="label"></w2:column>
										<w2:column width="80" inputType="text" style="" id="col_d" value="" displayMode="label"></w2:column>
									</w2:row>
								</w2:gBody>
							</w2:gridView>
						</xf:group>
						<xf:group class="mb_def_box nobottom" style="">
							<w2:span class="mr_def txt_bold" label="로그 확인"></w2:span>
							<xf:trigger class="wre_btn_log_clear" ev:onclick="scwin.btn_clearLog_onclick" title="로그 삭제" type="button"
								userData1="txa_log_1">
								<xf:label><![CDATA[로그 삭제]]></xf:label>
							</xf:trigger>
						</xf:group>
						<xf:textarea class="wre_txa_log" id="txa_log_1" spellcheck="false" style="width: 100%;height: 110px;"></xf:textarea>
					</xf:group>
				</xf:group>
			</xf:group>
		</xf:group>
	</body>
