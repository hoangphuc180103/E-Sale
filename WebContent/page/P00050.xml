/**
 * grd_example의 NAME 컬럼의 customFormatter
 */
scwin.grd_example_NAME = function (data, formattedData, rowIndex, colIndex) {
    if (formattedData.indexOf("2") > 0) {
        grd_example.setCellColor(rowIndex, colIndex, "red");
    }
    return formattedData;
};

/**
 * grd_example의 GROUP_B 컬럼의 customFormatter
 */
scwin.grd_example_GROUP_B = function (data, formattedData, rowIndex, colIndex) {
    if (data === "GROUP B01") {
        grd_example.setCellBackgroundColor(rowIndex, colIndex, "blue");
        grd_example.setCellColor(rowIndex, colIndex, "#fff");
    }
    return formattedData;
};


/**
 * grd_example의 GROUP_D 컬럼의 customFormatter
 */
scwin.grd_example_GROUP_D = function (data, formattedData, rowIndex, colIndex) {
    if (data === "GROUP D01") {
        grd_example.setCellColor(rowIndex, colIndex, "orange");
    }
    return formattedData;
};

/**
 * grd_example의 EMAIL 컬럼의 customFormatter
 */
scwin.grd_example_EMAIL = function (data, formattedData, rowIndex, colIndex) {
    if (data.indexOf("inswave03.com") > 0) {
        grd_example.setCellColor(rowIndex, colIndex, "blue");
    }
    return formattedData;
};


/**
 * grd_example2의 NAME 컬럼의 customFormatter
 */
scwin.grd_example2_NAME = function (data, formattedData, rowIndex, colIndex) {
    if (formattedData.indexOf("2") > 0) {
        return "<span style='color:red'>" + formattedData + "</span>";
    }
    return data;
};

/**
 * grd_exampl2e의 GROUP_B 컬럼의 customFormatter
 */
scwin.grd_example2_GROUP_B = function (data, formattedData, rowIndex, colIndex) {
    if (data === "GROUP B01") {
        return "<div style='display:inline-block;background-color:blue;line-height:38px;color:#fff;width:100%;box-sizing:border-box;position:relative;left:-4px;'>" + formattedData + "</div>";
    }
    return formattedData;
};

/**
 * grd_example2의 GROUP_D 컬럼의 customFormatter
 */
scwin.grd_example2_GROUP_D = function (data, formattedData, rowIndex, colIndex) {
    if (data === "GROUP D01") {
        return "<span style='color:orange'>" + formattedData + "</span>";
    }
    return formattedData;
};

/**
 * grd_exampl2e의 EMAIL 컬럼의 customFormatter
 */
scwin.grd_example2_EMAIL = function (data, formattedData) {
    if (data.indexOf("inswave03.com") > 0) {
        return "<span style='color:blue'>" + formattedData + "</span>";
    }
    return formattedData;
};
