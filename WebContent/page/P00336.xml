	<body ev:onpageload="scwin.onpageload">
		<xf:group class="sub_contents" id="" style="" nextTabID="">
			<xf:group class="ws_example_grp_desc" id="" style="">
				<w2:textbox escape="false" id=""
					label="AutoComplete과 SelectBox의 'submenuSize' 속성을 사용하여 선택 항목의 너비를 자동으로 조절할지를 설정한 예제입니다."
					style="">
				</w2:textbox>
			</xf:group>
			<xf:group class="example_div_tb_style_wrap mb_def" id="">

				<xf:group class="example_div_tr_style" id="" style="">

					<xf:group class="example_div_th_style" id="" style="">
						<w2:span class="mr_def txt_blue" id="" label="AutoComplete 예제" style=""></w2:span>
					</xf:group>
					<xf:group class="example_div_td_style" id="" style="">
						<xf:group id="" style="" class="">
							<w2:autoComplete editType="select" id="" useKeywordHighlight="false" style="width: 170px;margin-right: 8px;"
								submenuSize="auto" search="start" useLocale="false" allOption="" chooseOption="true" chooseOptionLabel="submenuSize : Auto"
								ref="" class="tal">
								<w2:choices>
									<w2:item>
										<w2:label><![CDATA[auto]]></w2:label>
										<w2:value><![CDATA[1]]></w2:value>
									</w2:item>
									<w2:item>
										<w2:label><![CDATA[submenSize]]></w2:label>
										<w2:value><![CDATA[2]]>
										</w2:value>
									</w2:item>
									<w2:item>
										<w2:label><![CDATA[submenuSize: auto 옵션은 가장 긴 Label에 맞게 크기가 조절됩니다.]]></w2:label>
										<w2:value><![CDATA[3]]>
										</w2:value>
									</w2:item>
									<w2:item>
										<w2:label><![CDATA[AutoComplete에 submenSize 적용 옵션 비교 예제입니다.]]></w2:label>
										<w2:value><![CDATA[4]]>
										</w2:value>
									</w2:item>
								</w2:choices>
							</w2:autoComplete>
						</xf:group>
						<xf:group class="" id="" style="">
							<w2:autoComplete allOption="" chooseOption="true" chooseOptionLabel="submenuSize : Fixed" editType="select"
								id="" ref="" search="start" style="width: 170px;" submenuSize="fixed" useKeywordHighlight="false" useLocale="false" class="tal">
								<w2:choices>
									<w2:item>
										<w2:label><![CDATA[fixed 옵션은]]></w2:label>
										<w2:value><![CDATA[1]]></w2:value>
									</w2:item>
									<w2:item>
										<w2:label><![CDATA[label의 길이와 무관하게]]></w2:label>
										<w2:value><![CDATA[2]]></w2:value>
									</w2:item>
									<w2:item>
										<w2:label><![CDATA[컴포넌트 길이에 고정됩니다.]]></w2:label>
										<w2:value><![CDATA[3]]></w2:value>
									</w2:item>
									<w2:item>
										<w2:label><![CDATA[AutoComplete에 submenSize 적용 유무 비교 예제입니다.]]></w2:label>
										<w2:value><![CDATA[4]]></w2:value>
									</w2:item>
								</w2:choices>
							</w2:autoComplete>
						</xf:group>
					</xf:group>

				</xf:group>
				<xf:group class="example_div_tr_style" id="" style="">
					<xf:group class="example_div_th_style" id="" style="">
						<w2:span class="mr_def txt_blue" id="" label="SelectBox 예제" style=""></w2:span>
					</xf:group>
					<xf:group class="example_div_td_style" id="" style="">
						<xf:group id="" style="" class="">
							<xf:select1 id="" chooseOption="true" style="width: 170px;margin-right: 8px;" submenuSize="auto" allOption=""
								disabled="false" direction="auto" appearance="minimal" disabledClass="w2selectbox_disabled" chooseOptionLabel="submenuSize : Auto"
								ref="" textAlign="left" class="tal">
								<xf:choices>
									<xf:item>
										<xf:label><![CDATA[auto]]></xf:label>
										<w2:value><![CDATA[1]]></w2:value>
									</xf:item>
									<xf:item>
										<xf:label><![CDATA[submenSize]]></xf:label>
										<w2:value><![CDATA[2]]></w2:value>
									</xf:item>
									<xf:item>
										<xf:label><![CDATA[submenuSize: auto 옵션은 가장 긴 Label에 맞게 크기가 조절됩니다.]]></xf:label>
										<xf:value><![CDATA[3]]>
										</xf:value>
									</xf:item>
									<xf:item>
										<xf:label><![CDATA[SelectBox에 submenSize를 각각 auto, fixed로 적용해 비교 예제입니다.]]></xf:label>
										<xf:value><![CDATA[4]]>
										</xf:value>
									</xf:item>
								</xf:choices>
							</xf:select1>
						</xf:group>
						<xf:group class="" id="" style="">
							<xf:select1 allOption="" appearance="minimal" chooseOption="true" chooseOptionLabel="submenuSize : Fixed"
								direction="auto" disabled="false" disabledClass="w2selectbox_disabled" id="" ref="" style="width: 170px;" submenuSize="fixed"
								textAlign="left" class="tal">
								<xf:choices>
									<xf:item>
										<xf:label><![CDATA[fixed 옵션은]]></xf:label>
										<xf:value><![CDATA[1]]></xf:value>
									</xf:item>
									<xf:item>
										<xf:label><![CDATA[label의 길이와 무관하게]]></xf:label>
										<xf:value><![CDATA[2]]></xf:value>
									</xf:item>
									<xf:item>
										<xf:label><![CDATA[컴포넌트 길이에 고정됩니다.]]></xf:label>
										<xf:value><![CDATA[3]]></xf:value>
									</xf:item>
									<xf:item>
										<xf:label><![CDATA[SelectBox에 submenSize를 각각 auto, fixed로 적용해 비교 예제입니다.]]></xf:label>
										<xf:value><![CDATA[4]]></xf:value>
									</xf:item>
								</xf:choices>
							</xf:select1>
						</xf:group>
					</xf:group>
				</xf:group>
			</xf:group>
		</xf:group>


	</body>
