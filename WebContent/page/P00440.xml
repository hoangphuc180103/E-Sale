<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare"
	xmlns:xf="http://www.w3.org/2002/xforms">
	<head meta_vertical_guides="" meta_horizontal_guides="">
		<w2:type>COMPONENT</w2:type>
		<w2:buildDate />
		<w2:MSA />
		<xf:model>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" repeatNode="map" id="dlt_list" saveRemovedData="true">
					<w2:columnInfo>
						<w2:column id="id" name="아이디" dataType="text"></w2:column>
						<w2:column id="textarea1" name="textarea-readOnly" dataType="text"></w2:column>
						<w2:column id="textarea2" name="textarea-readOnly : showReadOnly 적용" dataType="text"></w2:column>
					</w2:columnInfo>
					<w2:data use="false">
					</w2:data>
				</w2:dataList>
			</w2:dataCollection>
			<w2:workflowCollection />
		</xf:model>
		<w2:layoutInfo />
		<w2:publicInfo method="" />
		<script lazy="false" type="text/javascript"><![CDATA[
scwin.onpageload = function() {
	var json = [{"id":"A001", "textarea1":"aaaa \n bbbb \n cccc","textarea2":"가가가 \n 나나나 \n 다다다"}
                  ,{"id":"A002", "textarea1":"ddd \n eeee \n ffff","textarea2":"111 \n 222\n 3333"} 
                  ];

    dlt_list.setJSON(json);        
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">


		<xf:group class="sub_contents" id="" style="">
			<xf:group class="ws_example_grp_desc" id="" style="">
				<w2:textbox escape="false" id="" label="GridView의 사용자 탭에서 사용할 수 있는 'showReadOnly' 속성에 대한 예제입니다.&lt;br/&gt; - showReadOnly: readOnly인 textarea 셀을 더블 클릭했을 때 별도의 textarea가 표시되지 않도록 설정하는 속성입니다." style="">
				</w2:textbox>
			</xf:group>
			<xf:group class="example_div_tb_style_wrap mb_def" id="" style="">
				<xf:group class="example_div_tr_style" id="" style="">
					<w2:textbox class="example_div_th_style" escape="false" id="" label="textarea-readOnly 컬럼 더블 클릭 시 편집창 표시 (기본 동작)"
						style="margin-bottom: 7px;">
					</w2:textbox>
					<w2:textbox class="" escape="false" id="" label="※ 기본 설정 상태에서는 readOnly 셀을 더블 클릭하면 별도의 textarea가 표시됩니다." style="">
					</w2:textbox>
					<xf:group class="gvwbox" id="" style="margin-top: 10px;">
						<w2:gridView autoFit="allColumn" autoFitMinWidth="365" class="gvw" dataList="data:dlt_list" defaultCellHeight="37"
							id="gridView1" rowNumVisible="true" rowNumWidth="34" style="height:100px;" visibleRowNum="3" visibleRowNumFix="true">
							<w2:caption id="caption4" style="" value="this is a grid caption."></w2:caption>
							<w2:header id="header1" style="">
								<w2:row id="row1" style="">
									<w2:column displayMode="label" id="column4" inputType="text" value="아이디" width="70"></w2:column>
									<w2:column displayMode="label" id="column3" inputType="text" value="textarea-readOnly" width="200"></w2:column>
								</w2:row>
							</w2:header>
							<w2:gBody id="gBody1" style="">
								<w2:row id="row2" style="">
									<w2:column displayMode="label" id="id" inputType="text" viewType="icon" width="70">
										<w2:choices>
											<w2:itemset nodeset="data:dlt_code">
												<w2:label ref="label"></w2:label>
												<w2:value ref="code"></w2:value>
											</w2:itemset>
										</w2:choices>
									</w2:column>
									<w2:column displayMode="label" id="textarea1" inputType="textarea" width="200" readOnly="true"></w2:column>
								</w2:row>
							</w2:gBody>
						</w2:gridView>
					</xf:group>
				</xf:group>


				<xf:group class="example_div_tr_style" id="" style="">
					<w2:textbox class="example_div_th_style" escape="false" id=""
						label='textarea-readOnly 컬럼 더블 클릭 시 편집창 표시 안 함 (showReadOnly="false" 설정 시)' style="margin-bottom: 7px;">
					</w2:textbox>
					<w2:textbox class="" escape="false" id=""
						label="※ showReadOnly를 false로 설정하면 readOnly 셀을 더블 클릭해도 별도의 textarea가 표시되지 않습니다." style="">
					</w2:textbox><xf:group class="gvwbox" id="" style="margin-top: 10px;">
					<w2:gridView autoFit="allColumn" class="gvw" dataList="data:dlt_list" defaultCellHeight="37" id="gridView2" rowNumVisible="true" rowNumWidth="34" style="height:100px;" visibleRowNum="3" visibleRowNumFix="true">
						<w2:caption id="caption5" style="" value="this is a grid caption."></w2:caption>
						<w2:header id="header1" style="">
							<w2:row id="row1" style="">
								<w2:column displayMode="label" id="column4" inputType="text" value="아이디" width="70"></w2:column>
								<w2:column displayMode="label" id="column3" inputType="text" value="textarea-readOnly : showReadOnly 적용" width="300"></w2:column>
							</w2:row>
						</w2:header>
						<w2:gBody id="gBody1" style="">
							<w2:row id="row2" style="">
								<w2:column displayMode="label" id="id" inputType="text" viewType="icon" width="70">
									<w2:choices>
										<w2:itemset nodeset="data:dlt_code">
											<w2:label ref="label"></w2:label>
											<w2:value ref="code"></w2:value>
										</w2:itemset>
									</w2:choices>
								</w2:column>
								<w2:column displayMode="label" id="textarea2" inputType="textarea" width="300" readOnly="true" showReadOnly="false"></w2:column>
							</w2:row>
						</w2:gBody>
					</w2:gridView>
				</xf:group>

				</xf:group>
				
			</xf:group>
		</xf:group>

	</body>
</html>
