		<xf:group class="sub_contents" id="" style="">
			<xf:group class="ws_example_grp_desc" id="" style="">
				<w2:textbox escape="false" id="" label="Pivot의 'noColumnMove' 속성을 사용하여 Y축의 헤더 이동 기능을 금지한 예제입니다." style=""></w2:textbox>
