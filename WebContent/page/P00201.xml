		<script lazy="false" type="text/javascript"><![CDATA[
scwin.onpageload = function () {
    // 현재 날짜를 yyyyMMdd 형태로 가져옵니다.
    let sysDate = $p.getCurrentServerDate("yyyyMMdd");

    //InputCalendar 'ica_exam_1'에 현재 날짜를 설정합니다.
    ica_exam_1.setValue(sysDate);

    //InputCalendar 'ica_exam_2'에 현재 날짜를 설정합니다.
    ica_exam_2.setValue(sysDate);
};
]]></script>
