<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare"
	xmlns:xf="http://www.w3.org/2002/xforms">
	<head meta_author="InswaveSystems" meta_type="메인" meta_screenName="[Input] 입력 필드에 'readOnly' 또는 'disabled'가 설정된 경우에도 힌트 문자열(placeholder) 표시하기">
		<w2:historyInfo>
			<w2:history meta_no="01" meta_desc="최초작성" meta_date="20230904" meta_user="InswaveSystems"></w2:history>
			<w2:history meta_no="02" meta_desc="설명부 수정" meta_date="20240621" meta_user="InswaveSystems" ></w2:history>
		</w2:historyInfo>
		<w2:type>COMPONENT</w2:type>
		<w2:buildDate />
		<w2:MSA />
		<xf:model>
			<w2:dataCollection baseNode="map">
			</w2:dataCollection>
			<w2:workflowCollection />
		</xf:model>
		<w2:layoutInfo />
		<w2:publicInfo method="" />
		<script lazy="false" type="text/javascript"><![CDATA[
scwin.onpageload = function () {

};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:group class="sub_contents" id="" style="">
			<xf:group class="ws_example_grp_desc" id="" style="">
				<w2:textbox escape="false" id=""
					label="Input의 'showPlaceHolderOnReadOnly' 속성을 사용하여 Input이 읽기 전용 상태이거나 비활성화 상태일 때도 힌트 문자열(placeholder)이 표시되도록 설정한 예제입니다."
					style="">
				</w2:textbox>
			</xf:group>
			<xf:group class="example_div_tb_style_wrap" id="">
				<xf:group class="example_div_tr_style" id="" style="">
					<w2:textbox class="example_div_th_style" escape="false" id="" label='showPlaceHolderOnReadOnly: true' style="">
					</w2:textbox>
					<xf:group class="example_div_td_style" id="" style="">
						<xf:group class="mb_def_box nobottom" id="" style="">
							<xf:group class="" id="" style="">
								<w2:span class="wre_txt_list" id="" label="readOnly 설정"
									style="display: inline-block;width:100px;margin-right: 6px;">
								</w2:span>
								<xf:input id="" placeholder="입력 힌트 예시입니다." readOnly="true" style="width:150px;"
									showPlaceHolderOnReadOnly="true">
								</xf:input>
							</xf:group>
							<xf:group class="" id="" style="">
								<w2:span class="wre_txt_list" id="" label="disabled 설정"
									style="display: inline-block;width:100px;margin-right: 6px;">
								</w2:span>
								<xf:input disabled="true" id="" placeholder="입력 힌트 예시입니다." style="width:150px;"
									showPlaceHolderOnReadOnly="true">
								</xf:input>
							</xf:group>
						</xf:group>
					</xf:group>
				</xf:group>
				<xf:group class="example_div_tr_style" id="" style="">
					<w2:textbox class="example_div_th_style" escape="false" id="" label="(기본 설정) showPlaceHolderOnReadOnly: false"
						style="">
					</w2:textbox>
					<xf:group class="example_div_td_style" id="" style="">
						<xf:group class="mb_def_box nobottom" id="" style="">
							<xf:group class="" id="" style="">
								<w2:span class="wre_txt_list" id="" label="readOnly 설정"
									style="display: inline-block;width:100px;margin-right: 6px;">
								</w2:span>
								<xf:input id="" placeholder="입력 힌트 예시입니다." readOnly="true" showPlaceHolderOnReadOnly="false"
									style="width:150px;">
								</xf:input>
							</xf:group>
							<xf:group class="" id="" style="">
								<w2:span class="wre_txt_list" id="" label="disabled 설정"
									style="display: inline-block;width:100px;margin-right: 6px;">
								</w2:span>
								<xf:input disabled="true" id="" placeholder="입력 힌트 예시입니다." showPlaceHolderOnReadOnly="false"
									style="width:150px;">
								</xf:input>
							</xf:group>
						</xf:group>
					</xf:group>
				</xf:group>
			</xf:group>
		</xf:group>
	</body>
</html>