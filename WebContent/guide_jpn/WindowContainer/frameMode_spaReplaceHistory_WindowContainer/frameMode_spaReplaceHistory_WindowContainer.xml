<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
         <script type="text/javascript" lazy="false"><![CDATA[
scwin.count = 0;
scwin.onpageload = function () {

};

scwin.onpageunload = function () {

};


scwin.trigger1_onclick = function (e) {
    var idx = radio1.getValue();
    var tmpSrc = scwin.getfolderPath() + "/" + idx + ".xml";

    scwin.count++;
    var obj = {
        "title": "test_" + scwin.count,
        "windowID": "window_" + scwin.count,
        "frameMode": "pageFrame",
        "src": tmpSrc
    };
    windowContainer1.createWindow(obj);
    windowContainer1.setArrangeWindows("cascade");
};

scwin.getfolderPath = function () {

    var currentPath = window.location.href;
    var folderPath;

    if (currentPath.includes("mainContainer")) {
        console.log("true  ===> " + $p.getFrameId());
        const cmtFrame = $p.getComponentById($p.getFrameId());
        currentPath = cmtFrame.getSrc();
        folderPath = currentPath.substring(0, currentPath.lastIndexOf('/'));
    } else {
        console.log("false  ===> ");
        folderPath = currentPath.split('w2xPath=')[1].substring(0, currentPath.split('w2xPath=')[1].lastIndexOf('/'));
    }
    return folderPath;
};
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload" ev:onpageunload="scwin.onpageunload">
    <xf:group id="" style="margin: 10px;">
    	<w2:textbox tagname="h1" style="color: blue;margin-bottom: 10px;" tabIndex="h1" id="textbox1" label="ブラウザの履歴機能を使用する" escape="false"></w2:textbox>
    	<w2:textbox tagname="h2" style="height: 23px;margin-bottom: 10px;color: blue;" id="textbox2" label="サンプルの使い方"></w2:textbox>
    	<w2:textbox style="color: blue;margin-bottom: 30px;" id="textbox3" label='（例を単独で実行する。）&lt;br/&gt;1. ブラウザで新しいタブを開き、任意のWebページに移動します。 &lt;br/&gt;2. サンプルファイルを単独で実行したアドレスを上記のステップ1ブラウザタブにコピーして貼り付けます。 &lt;br/&gt;3. 上記のステップ1のブラウザタブにコピーされたサンプルファイル画面で、createWindow()ボタン上部のファイル名を選択します。 &lt;br/&gt;4. createWindow() ボタンをクリックします。 &lt;br/&gt;5. 上記の方法で複数のウィンドウを作成します。 &lt;br/&gt;6. ブラウザの先頭に戻るボタンをクリックします。 &lt;br/&gt;7. 上記のステップ1の最初のWebページに移動することを確認してください。 &lt;br/&gt;8. ブラウザの先頭に戻るボタンをクリックします。&lt;br/&gt;9. 複数のウィンドウが作成された状態のサンプル画面に戻ることを確認します。' escape="false">
    	</w2:textbox>
    	<w2:textbox style="padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightblue;border:none;margin-bottom: 10px;" id="textbox4" label='プロパティの設定&lt;br/&gt;spaReplaceHistory="true"' escape="false">
    	</w2:textbox>
    	<xf:group id="" style="margin-bottom: 10px;">
    		<xf:select1 id="radio1" selectedIndex="-1" appearance="full" style="width: 150px;height: 21px;margin-bottom: 10px;" cols=""
    			rows="1" ref="">
    			<xf:choices>
    				<xf:item>
    					<xf:label><![CDATA[11.xml]]></xf:label>
    					<xf:value><![CDATA[11]]></xf:value>
    				</xf:item>
    				<xf:item>
    					<xf:label><![CDATA[22.xml]]></xf:label>
    					<xf:value><![CDATA[22]]></xf:value>
    				</xf:item>
    				<xf:item>
    					<xf:label><![CDATA[33.xml]]></xf:label>
    					<xf:value><![CDATA[33]]></xf:value>
    				</xf:item>
    			</xf:choices>
    		</xf:select1>
    		<xf:trigger ev:onclick="scwin.trigger1_onclick"
    			style="height:42px;line-height:32px;padding:5px;background-color:coral;font-size:15px;weight: bolder;font-weight:bolder;text-align: left;display: block"
    			id="trigger1" type="button">
    			<xf:label><![CDATA[createWindow()]]></xf:label>
    		</xf:trigger>
    	</xf:group>
    	<w2:windowContainer sequentialArrangeColNum="2" sequentialArrangeRowNum="2" spaReplaceHistory="true" fixArrangeFullScreen="false"
    		frameMode="iframe" useFixButton="false" windowAutoResize="false" verticalArrangeNum="2" windowMaxNum="10" useCloseButton="false"
    		controlIconPosition="left" windowMaximizeAll="false" stopMinimizeOnNameLayer="false" toolbarPosition="bottom" id="windowContainer1"
    		useStatusMsg="true" hideTitleOnMaximize="false" spaInitCount="10" stopToggleOnLast="false" useNameContainer="false"
    		horizontalArrangeNum="2" useCustomMsg="false" spaAuto="true" useControlIconTitle="false" tooltipDisplay="true"
    		tooltipGroupClass="false" windowTooltipDisplay="true" style="position: relative;height: 400px;border: gray solid 1px;">
    		<w2:windowToolbar>
    			<w2:controlIconLayer>
    				<w2:controlIcon></w2:controlIcon>
    				<w2:controlIcon></w2:controlIcon>
    				<w2:controlIcon></w2:controlIcon>
    				<w2:controlIcon></w2:controlIcon>
    				<w2:controlIcon></w2:controlIcon>
    			</w2:controlIconLayer>
    			<w2:nameLayer></w2:nameLayer>
    			<w2:selectedNameLayer></w2:selectedNameLayer>
    		</w2:windowToolbar>
    	</w2:windowContainer>
    </xf:group></body>
</html>
