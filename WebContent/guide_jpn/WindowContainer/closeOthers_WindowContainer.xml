<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
    	<w2:buildDate />
    	<xf:model>
    		<xf:instance>
    			<data xmlns="" />
    		</xf:instance>
    		<w2:dataCollection baseNode="map"></w2:dataCollection>
    		<w2:workflowCollection></w2:workflowCollection>
    	</xf:model>
    	<script type="text/javascript" lazy="false"><![CDATA[


scwin.onpageload = function () {
    var i;
    for (i = 0; i < 4; i++) {
        var num = JSON.stringify(i + 1);
        var title = "id=" + num;
        var windowId = num;
        var windowName = "id=" + num;
        windowContainer1.createWindow(title, "", "", windowName, windowId, "newWindow");
        windowContainer1.setArrangeWindows("sequential");
    }
};

scwin.onpageunload = function () {

};


scwin.trigger1_onclick = function (e) {
    var id = input1.getValue();
    windowContainer1.closeOthers(id);
};]]></script>
    	<style type="text/css"><![CDATA[.w2window_selected {border: solid 3px green;} ]]></style>
    </head>
    <body ev:onpageload="scwin.onpageload" ev:onpageunload="scwin.onpageunload">
    <xf:group id="" style="margin: 10px;">
    	<w2:textbox tagname="h1" style="color: blue;margin-bottom: 10px;" tabIndex="h1" id="textbox1" label="特定のウィンドウを除く残りのウィンドウを閉じる"
    		escape="false">
    	</w2:textbox>
    	<w2:textbox tagname="h2" style="height: 23px;margin-bottom: 10px;color: blue;" id="textbox2" label="サンプルの使い方"></w2:textbox>
    	<w2:textbox style="color: blue;margin-bottom: 30px;" id="textbox3"
    		label='1-1. InputBoxにウィンドウのIDを入力します。 （例：「1」〜「4」）&lt;br/&gt;1-2. closeOthers(id) ボタンをクリックします。 &lt;br/&gt;1-3. IDを入力したウィンドウを除く残りのウィンドウが閉じていることを確認。 &lt;br/&gt;&lt;br/&gt;（サンプルファイルを初期化）&lt;br/&gt;2-1. WindowContainerで任意のウィンドウを選択します。 &lt;br/&gt;2-2. closeOthers(id) ボタンをクリックします。 &lt;br/&gt;2-3.上記で選択したウィンドウを除く残りのウィンドウがすべて閉じられることを確認。'
    		escape="false">
    	</w2:textbox>
    	<xf:input adjustMaxLength="false"
    		style="width: 50%;text-align: center;height:50px;padding: 5px;font-size:30px;font-style: italic;color: red;margin-bottom: 10px;"
    		id="input1" placeholder="ID">
    	</xf:input>
    	<xf:trigger ev:onclick="scwin.trigger1_onclick"
    		style="height:42px;line-height:32px;padding:5px;background-color:coral;font-size:15px;weight: bolder;font-weight:bolder;text-align: left;display: block;margin-bottom: 10px;"
    		id="trigger1" type="button">
    		<xf:label><![CDATA[closeOthers(id)]]></xf:label>
    	</xf:trigger>
    	<w2:windowContainer sequentialArrangeColNum="" sequentialArrangeRowNum="" fixArrangeFullScreen="false" useFixButton="false"
    		windowAutoResize="false" useWindowScrollButton="" verticalArrangeNum="" windowMaxNum="20" useCloseButton="false"
    		controlIconPosition="allright" stopMinimizeOnNameLayer="false" toolbarPosition="top" windowMaximizeAll="true" id="windowContainer1"
    		useStatusMsg="true" hideTitleOnMaximize="false" spaInitCount="0" windowScrollVisibleRowNum="" stopToggleOnLast="false"
    		useNameContainer="true" horizontalArrangeNum="" useCustomMsg="false" autoArrange="true" useControlIconTitle="" tooltipDisplay="true"
    		tooltipGroupClass="false" windowTooltipDisplay="true" style="position: relative;height: 400px;border: gray solid 1px;margin-bottom: 10px;">
    		<w2:windowToolbar>
    			<w2:controlIconLayer>
    				<w2:controlIcon></w2:controlIcon>
    				<w2:controlIcon></w2:controlIcon>
    				<w2:controlIcon></w2:controlIcon>
    				<w2:controlIcon></w2:controlIcon>
    				<w2:controlIcon></w2:controlIcon>
    			</w2:controlIconLayer>
    			<w2:nameLayer></w2:nameLayer>
    			<w2:selectedNameLayer></w2:selectedNameLayer>
    		</w2:windowToolbar>
    	</w2:windowContainer>
    	<w2:textbox escape="false" id="textbox5"
    		label='/// サンプルコード&lt;br/&gt;&lt;br/&gt;var id = input1.getValue();&lt;br/&gt;windowContainer1.closeOthers(id);'
    		style="padding:10px; padding-bottom:20px; text-align:left; font-size:15px; font-weight:bolder; border:brown 1px solid; background-color:ivory; margin-bottom:10px; color:brown;"
    		tagname="">
    	</w2:textbox>
    </xf:group></body>
</html>
