<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head meta_screenName="preserveType_DataMap">
        <w2:type>COMPONENT</w2:type>
        <w2:buildDate/>
        <w2:MSA/>
        <xf:model>
            <w2:dataCollection baseNode="map">
            	<w2:dataMap baseNode="map" id="dataMap1" preserveType="true">
            		<w2:keyInfo>
            			<w2:key id="key1" name="name1" dataType="text"></w2:key>
            			<w2:key id="key2" name="name2" dataType="number"></w2:key>
            		</w2:keyInfo>
            	</w2:dataMap>
            </w2:dataCollection>
            <w2:workflowCollection/>
        </xf:model>
        <w2:layoutInfo/>
        <w2:publicInfo method=""/>
        <script lazy="false" type="text/javascript"><![CDATA[
scwin.onpageload = function () {
};

scwin.trigger1_onclick = function (e) {
    alert("Type of 333 : " + typeof (333) + " & " + "Type of 555 : " + typeof (555));
    dataMap1.set("key1", 333);
    dataMap1.set("key2", 555);
};

scwin.trigger2_onclick = function (e) {
    var first = dataMap1.get("key1");
    var second = dataMap1.get("key2");
    alert("After Setting - Type of 333 : " + typeof (first) + " & Type of 555 : " + typeof (second));

};
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload">
    <xf:group id="" style="margin: 10px;"><w2:textbox tagname="h1" style="color: blue;margin-bottom: 10px;" tabIndex="h1" id="textbox1" label="DataMapでnumber型データをstring型に設定する" escape="false"></w2:textbox><w2:textbox tagname="h2" style="height: 23px;margin-bottom: 10px;color: blue;" id="textbox2" label="サンプルの使い方"></w2:textbox><w2:textbox style="color: blue;margin-bottom: 30px;" id="textbox3" label='1. 最初のボタンをクリックして dataType が “number” のデータを DataMap に設定します。 &lt;br/&gt;2. 2番目のボタンをクリックしてkey1のdataTypeが "string"に変換され、key2が "number"であることを確認します。&lt;br/&gt;' escape="false">
    	</w2:textbox><w2:textbox style="padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightblue;border:none;margin-bottom: 10px;" id="textbox4" label='プロパティの設定&lt;br/&gt;preserveType="true" (DataMap)&lt;br/&gt;dataType="text" (dataMap.key - key1)&lt;br/&gt;dataType="number" (dataMap.key - key2)' escape="false">
    	</w2:textbox><xf:trigger ev:onclick="scwin.trigger1_onclick" style="height:42px;line-height:32px;padding:5px;background-color:coral;font-size:15px;weight: bolder;font-weight:bolder;text-align: left;display: block;margin-bottom: 10px;" id="trigger1" type="button">
    		<xf:label><![CDATA[dataMap1.set();]]></xf:label>
    	</xf:trigger><xf:trigger ev:onclick="scwin.trigger2_onclick" style="height:42px;line-height:32px;padding:5px;background-color:coral;font-size:15px;weight: bolder;font-weight:bolder;text-align: left;display: block;margin-bottom: 10px;" id="trigger2" type="button">
    		<xf:label><![CDATA[typeof() DataMap]]></xf:label>
    	</xf:trigger><xf:input ref="data:dataMap1.key1" style="width:140px;height:30px;padding:5px;text-align:left;font-size:20px;font-family:consolas;font-style:normal;font-weight:bolder;margin-left: 10px;margin-top: 20px;color: purple;" id="input3">
    		</xf:input><xf:input ref="data:dataMap1.key2" style="width:140px;height:30px;padding:5px;text-align:left;font-size:20px;font-family:consolas;font-style:normal;font-weight:bolder;margin-left: 10px;margin-top: 20px;color: purple;" id="input4">
    		</xf:input></xf:group></body>
</html>
