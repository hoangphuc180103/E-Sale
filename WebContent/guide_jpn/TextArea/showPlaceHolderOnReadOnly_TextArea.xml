<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
         <script type="text/javascript" lazy="false"><![CDATA[
        
	scwin.onpageload = function() {
		
	};
	
	scwin.onpageunload = function() {
		
	};
	
	]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload" ev:onpageunload="scwin.onpageunload">
    <xf:group id="" style="margin: 10px;">
    	<w2:textbox tagname="h1" style="color: blue;margin-bottom: 10px;" tabIndex="h1" id="textbox1"
    		label="読み取り専用または無効の状態でPlaceholderを表示" escape="false">
    	</w2:textbox>
    	<w2:textbox tagname="h2" style="height: 23px;margin-bottom: 10px;color: blue;" id="textbox2" label="サンプルの使い方"></w2:textbox>
    	<w2:textbox style="color: blue;margin-bottom: 30px;" id="textbox3"
    		label='(showPlaceHolderOnReadOnly="true")&lt;br/&gt;読み取り専用 (readOnly="true") または無効化された (disabled="true") 状態の TextArea に placeholder プロパティで設定したテキストが表示されることを確認。 &lt;br/&gt;&lt;br/&gt;(showPlaceHolderOnReadOnly="false")&lt;br/&gt;読み取り専用 (readOnly="true") または無効な (disabled="true") 状態の TextArea に placeholder プロパティに設定したテキストが表示されない&lt;br/&gt;'
    		escape="false">
    	</w2:textbox>
    	<w2:textbox
    		style="padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightblue;border:none;margin-bottom: 10px;"
    		id="textbox4"
    		label='プロパティの設定&lt;br/&gt;showPlaceHolderOnReadOnly="true"'
    		escape="false">
    	</w2:textbox>
    	<xf:textarea style="margin-bottom: 10px;display: block;" readOnly="true" id="textarea1" placeholder='Enter text. (readOnly="true")'
    		showPlaceHolderOnReadOnly="true">
    	</xf:textarea>
    	<xf:textarea style="margin-bottom: 10px;display: block" disabled="true" id="textarea2" placeholder='Enter text. (disabled="true")'
    		showPlaceHolderOnReadOnly="true">
    	</xf:textarea>
    	<w2:textbox id="textbox5"
    		label='プロパティの設定&lt;br/&gt;showPlaceHolderOnReadOnly="false"'
    		style="padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightblue;border:none;margin-bottom: 10px;"
    		escape="false">
    	</w2:textbox>

    	<xf:textarea id="textarea3" placeholder='Enter text. (readOnly="true")' readOnly="true" showPlaceHolderOnReadOnly="false"
    		style="margin-bottom: 10px;display: block;">
    	</xf:textarea>
    	<xf:textarea disabled="true" id="textarea4" placeholder='Enter text. (disabled="true")' showPlaceHolderOnReadOnly="false"
    		style="margin-bottom: 10px;display: block">
    	</xf:textarea>
    </xf:group></body>
</html>
