<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            	<w2:dataList baseNode="list" id="dataList1" repeatNode="map" saveRemovedData="true" style="">
            		<w2:columnInfo>
            			<w2:column dataType="text" id="col1" name="name1"></w2:column>
            			<w2:column dataType="text" id="col2" name="name2"></w2:column>
            		</w2:columnInfo>
            	</w2:dataList>
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
         <script type="text/javascript" lazy="false"><![CDATA[
    
	scwin.onpageload = function() {
		var data = [];
		for (var i = 0; i < 20 ; i ++) {
			data.push(i + "");
			data.push(i + "" + "_v");
		}
		dataList1.setData(data, true);
	};
	
	scwin.onpageunload = function() {
		
	};	
	
	
	]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload" ev:onpageunload="scwin.onpageunload">
    <xf:group id="" style="margin: 10px;">
    	<w2:textbox escape="false" id="textbox1" label="入力時の検証" style="color: blue;margin-bottom: 10px;" tabIndex="h1" tagname="h1"></w2:textbox>
    	<w2:textbox id="textbox2" label="サンプルの使い方" style="height: 23px;margin-bottom: 10px;color: blue;" tagname="h2"></w2:textbox>
    	<w2:textbox escape="false" id="textbox3"
    		label="1. CheckComboBoxをクリックします。 &lt;br/&gt;2.直接値を入力します。 &lt;br/&gt;3.選択項目リストに存在する値を入力した場合は、その値が選択され入力されていることを確認してください。 &lt;br/&gt;4.リストにない値は入力されないことを確認してください。"
    		style="color: blue;margin-bottom: 30px;">
    	</w2:textbox>
    	<w2:textbox escape="false" id="textbox4"
    		label='プロパティの設定&lt;br/&gt;useEdit="true" &lt;br/&gt;validateOnInput="true"'
    		style="padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightblue;border:none;margin-bottom: 20px;">
    	</w2:textbox>
    	<xf:checkcombobox visibleColumn="" displayAllOptionLabel="false" submenuSize="fixed" chooseOption="" validator="" allOption=""
    		separator="," displayMode="label" visibleColMax="" ref="" appearance="minimal" checkboxClickSync="true" useEdit="true"
    		validateOnInput="true" disabled="false" style="width: 50%;" allowChar="0-9,-"
    		id="checkcombobox1" visibleRowNum="" useDrag="true" rangeSeparator="-" direction="auto" visibleColNum="5">
    		<xf:choices>
    			<xf:itemset nodeset="data:dataList1">
    				<xf:label ref="col1"></xf:label>
    				<xf:value ref="col2"></xf:value>
    			</xf:itemset>
    		</xf:choices>
    	</xf:checkcombobox>
    </xf:group></body>
</html>
