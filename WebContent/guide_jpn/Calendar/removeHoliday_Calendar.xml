<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            	<w2:dataList baseNode="list" id="dataList1" repeatNode="map" saveRemovedData="true" style="">
            		<w2:columnInfo>
            			<w2:column dataType="text" id="col1" name="name1"></w2:column>
            		</w2:columnInfo>
            		<w2:data use="true">
            			<w2:row>
            				<col1><![CDATA[20220308]]></col1>
            			</w2:row>
            			<w2:row>
            				<col1><![CDATA[20220315]]></col1>
            			</w2:row>
            			<w2:row>
            				<col1><![CDATA[20220322]]></col1>
            			</w2:row>
            			<w2:row>
            				<col1><![CDATA[20220329]]></col1>
            			</w2:row>
            		</w2:data>
            	</w2:dataList>
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
         <script type="text/javascript" lazy="false"><![CDATA[

scwin.onpageload = function () {
    
};

scwin.onpageunload = function () {

};


scwin.trigger1_onclick = function (e) {
    var today = $p.getCurrentServerDate();
    calendar1.setHoliday(today);
};

scwin.trigger2_onclick = function (e) {
    calendar1.removeHoliday();
};
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload" ev:onpageunload="scwin.onpageunload">
    <xf:group id="" style="margin: 10px;">
    	<w2:textbox escape="false" id="textbox1" label="休日指定のキャンセル" style="color: blue;margin-bottom: 10px;" tabIndex="h1"
    		tagname="h1">
    	</w2:textbox>
    	<w2:textbox id="textbox2" label="サンプルの使い方" style="height: 23px;margin-bottom: 10px;color: blue;" tagname="h2"></w2:textbox>
    	<w2:textbox escape="false" id="textbox3"
    		label="1. setHoliday() ボタンをクリックします。 &lt;br/&gt;2.現在の日付が休日として指定され、赤で表示されていることを確認してください。&lt;br/&gt;3. removeHoliday() ボタンをクリックします。 &lt;br/&gt;4.休日の指定がキャンセルされ、現在の日に赤で表示されないことを確認してください。"
    		style="color: blue;margin-bottom: 30px;">
    	</w2:textbox>
    	<xf:trigger ev:onclick="scwin.trigger1_onclick"
    		style="display: block;height:42px;line-height:32px;display: block;padding:5px;background-color:lightgreen;font-size:15px;weight: bolder;font-weight:bolder;margin-bottom:10px;text-align: left;" id="trigger1"
    		type="button">
    		<xf:label><![CDATA[calendar1.setHoliday();]]></xf:label>
    	</xf:trigger>
    	<xf:trigger type="button" id="trigger2" style="display: block;height:42px;line-height:32px;display: block;padding:5px;background-color:coral;font-size:15px;weight: bolder;font-weight:bolder;margin-bottom:10px;text-align: left;" ev:onclick="scwin.trigger2_onclick">
    		<xf:label><![CDATA[calendar1.removeHoliday();]]></xf:label>
    	</xf:trigger>
    	<w2:calendar footerDiv="false" style="width: 100px;height: 100px;margin-top: 10px;" id="calendar1"
    		monthNames="Jan, Feb, Mar, Apr, May, Jun, Jul, Aug, Sep, Oct, Nov, Dec" yearSuffix="Y">
    	</w2:calendar>
    </xf:group></body>
</html>
