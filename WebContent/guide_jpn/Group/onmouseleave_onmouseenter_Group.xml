    <xf:group id="" style="margin: 10px;"><w2:textbox tagname="h1" style="color: blue;margin-bottom: 10px;" tabIndex="h1" id="textbox1" label="イベント - onmouseenter &amp; onmouseleave" escape="false"></w2:textbox><w2:textbox tagname="h2" style="height: 23px;margin-bottom: 10px;color: blue;" id="textbox2" label="サンプルの使い方"></w2:textbox><w2:textbox style="color: blue;margin-bottom: 30px;" id="textbox3" label='1. マウスカーソルをグループ内に移動します。 &lt;br/&gt;2. onmouseenter イベントが発生していることを確認してください。 &lt;br/&gt;3.マウスカーソルをグループ外に移動します。 &lt;br/&gt;4. onmouseleave イベントが発生することを確認してください。' escape="false">
