<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
        	<xf:instance>
        		<data xmlns="" />
        	</xf:instance>
        	<w2:dataCollection baseNode="map">
        		<w2:dataList baseNode="list" id="dataList1" repeatNode="map" saveRemovedData="true" style="">
        			<w2:columnInfo>
        				<w2:column dataType="text" id="Status" name="Status"></w2:column>
        				<w2:column dataType="text" id="date" name="date"></w2:column>
        				<w2:column dataType="text" id="Expense" name="Expense"></w2:column>
        				<w2:column dataType="text" id="Income" name="Income"></w2:column>
        				<w2:column dataType="text" id="Hobby" name="Hobby"></w2:column>
        				<w2:column dataType="text" id="Region" name="Region"></w2:column>
        				<w2:column dataType="text" id="Frequency" name="Frequency"></w2:column>
        				<w2:column dataType="text" id="ID" name="ID"></w2:column>
        				<w2:column dataType="text" id="Age" name="Age"></w2:column>
        			</w2:columnInfo>
        		</w2:dataList>
        	</w2:dataCollection>
        	<w2:workflowCollection></w2:workflowCollection>
        	<xf:submission id="submission1" ref="" target="data:json,dataList1" action="/WebContent/guide_sample/$p/Submission/executeSubmission_$p/data.json" method="post"
        		mediatype="application/json" encoding="UTF-8" instance="" replace="" errorHandler="" customHandler="" mode="asynchronous"
        		processMsg="Submission being processed..." ev:submit="scwin.submission1_submit" ev:submitdone="scwin.submission1_submitdone"
        		ev:submiterror="scwin.submission1_submiterror" abortTrigger="">
        	</xf:submission>
        	<xf:submission id="submission2" ref="" target="data:json,dataList1" action="datal.json" method="post"
        		mediatype="application/json" encoding="UTF-8" instance="" replace="" errorHandler="" customHandler="" mode="asynchronous"
        		processMsg="Submission being processed..." ev:submit="scwin.submission2_submit" ev:submitdone="scwin.submission2_submitdone"
        		ev:submiterror="scwin.submission2_submiterror" abortTrigger="">
        	</xf:submission>
        </xf:model>
        <script type="text/javascript" lazy="false"><![CDATA[

scwin.onpageload = function () {

};

scwin.onpageunload = function () {

};


scwin.submission1_submit = function (e) {
    alert("submit - Submission is about to start!");
};

scwin.submission1_submitdone = function (e) {
    alert("submitdone - Submission successful.");
};

scwin.submission1_submiterror = function (e) {
    alert("submiterror - Submission failed.");
};

scwin.trigger1_onclick = function (e) {
    var objSubmission = $p.getSubmission("submission1");
    objSubmission.action = scwin.getfolderPath() + '/data.json';
    $p.executeSubmission("submission1");
};

scwin.submission2_submit = function (e) {
    alert("submit - Submission is about to start!");
};

scwin.submission2_submitdone = function (e) {
    alert("submitdone - Submission successful.");
};

scwin.submission2_submiterror = function (e) {
    alert("submiterror - Submission failed.");
};

scwin.trigger2_onclick = function (e) {
    var objSubmission = $p.getSubmission("submission2");
    objSubmission.action = scwin.getfolderPath() + '/datal.json';

    $p.executeSubmission("submission2");
};

scwin.getfolderPath = function () {

    var currentPath = window.location.href;
    var folderPath;

    if (currentPath.includes("mainContainer")) {
        console.log("true  ===> " + $p.getFrameId());
        const cmtFrame = $p.getComponentById($p.getFrameId());
        currentPath = cmtFrame.getSrc();
        folderPath = currentPath.substring(0, currentPath.lastIndexOf('/'));
    } else {
        console.log("false  ===> ");
        folderPath = currentPath.split('w2xPath=')[1].substring(0, currentPath.split('w2xPath=')[1].lastIndexOf('/'));
    }
    return folderPath;
};]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload" ev:onpageunload="scwin.onpageunload">
    <xf:group id="" style="margin: 10px;"><w2:textbox tagname="h1" style="color: blue;margin-bottom: 10px;" id="textbox1" label="イベント - submit &amp; submitdone &amp; submiterror" escape="false"></w2:textbox><w2:textbox tagname="h2" style="height: 23px;margin-bottom: 10px;color: blue;" id="textbox2" label="サンプルの使い方"></w2:textbox><w2:textbox style="color: blue;margin-bottom: 30px;" id="textbox3" label='1-1. 最初のボタンをクリックします。 &lt;br/&gt;1-2. サブミッションが精巧に実行され、サブミットとサブミットドーンイベントが発生することを確認。 &lt;br/&gt;&lt;br/&gt;2-1. 2番目のボタンをクリックします。 &lt;br/&gt;2-2. エラーが発生し、submitとsubmiterrorイベントが発生することを確認してください。 （"submission2"のデータファイル名を誤って誤って設定します。）&lt;br/&gt;' escape="false">
    	</w2:textbox><w2:textbox style="padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightgreen;border:none;margin-bottom: 10px;" id="textbox4" label='イベント説明&lt;br/&gt;submit - Submission 開始前に発生。 &lt;br/&gt;submitdone - Submission 完了後に発生。 &amp;nbsp;&lt;br/&gt;submiterror - Submission エラー時に発生。' escape="false">
    	</w2:textbox><xf:trigger ev:onclick="scwin.trigger1_onclick" style="display: block;height:42px;line-height:32px;padding:5px;background-color:coral;font-size:15px;weight: bolder;font-weight:bolder;margin-bottom:10px;text-align: left;" id="trigger1" type="button">
    		<xf:label><![CDATA[$p.executeSubmission("submission1"); - submit & submitdone]]></xf:label>
    	</xf:trigger><xf:trigger ev:onclick="scwin.trigger2_onclick" style="display: block;height:42px;line-height:32px;padding:5px;background-color:coral;font-size:15px;weight: bolder;font-weight:bolder;margin-bottom:10px;text-align: left;" id="trigger2" type="button">
    		<xf:label><![CDATA[$p.executeSubmission("submission2"); - submit & submiterror]]></xf:label>
    	</xf:trigger><w2:gridView scrollByColumnAdaptive="false" dataList="data:dataList1" scrollByColumn="false" style="border: solid gray 1px;" autoFit="allColumn" id="gridView1" defaultCellHeight="20" visibleRowNum="10" visibleRowNumFix="true">
    		<w2:caption style="" id="caption1" value="this is a grid caption."></w2:caption>
    		<w2:header style="" id="header1">
    			<w2:row style="" id="row1">
    				<w2:column width="70" inputType="text" style="height:20px" id="column9" value="Status" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="height:20px" id="column8" value="date" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="height:20px" id="column7" value="Expense" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="height:20px" id="column6" value="Income" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="height:20px" id="column5" value="Hobby" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="height:20px" id="column4" value="Region" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="height:20px" id="column3" value="Frequency" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="height:20px" id="column2" value="ID" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="height:20px" id="column1" value="Age" displayMode="label"></w2:column>
    			</w2:row>
    		</w2:header>
    		<w2:gBody style="" id="gBody1">
    			<w2:row style="" id="row2">
    				<w2:column width="70" inputType="text" style="height:20px" id="Status" value="" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="height:20px" id="date" value="" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="height:20px" id="Expense" value="" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="height:20px" id="Income" value="" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="height:20px" id="Hobby" value="" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="height:20px" id="Region" value="" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="height:20px" id="Frequency" value="" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="height:20px" id="ID" value="" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="height:20px" id="Age" value="" displayMode="label"></w2:column>
    			</w2:row>
    		</w2:gBody>
    	</w2:gridView></xf:group></body>
</html>
