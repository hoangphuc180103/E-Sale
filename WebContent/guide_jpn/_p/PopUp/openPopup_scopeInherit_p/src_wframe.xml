<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head meta_screenName="src_wframe">
        <w2:type>COMPONENT</w2:type>
        <w2:buildDate/>
        <w2:MSA/>
        <xf:model>
            <w2:dataCollection baseNode="map"/>
            <w2:workflowCollection/>
        </xf:model>
        <w2:layoutInfo/>
        <w2:publicInfo method=""/>
        <script lazy="false" type="text/javascript"><![CDATA[
scwin.onpageload = function () {

};

scwin.trigger1_onclick = function (e) {
    var parent = textbox1.getValue();
    alert(parent);
};

scwin.trigger4_onclick = function (e) {
    var parent = $p.main().textbox1.getValue();
    alert(parent);
};

scwin.trigger5_onclick = function (e) {
    var parent = $p.top().textbox1.getValue();
    alert(parent);
};
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload">
    	<xf:trigger type="button" id="trigger1"
    		style="width: 90%;height:15%;margin:10px;background-color: lightpink;display: block;font-weight: bolder;text-align: left;padding: 10px;"
    		ev:onclick="scwin.trigger1_onclick" class="">
    		<xf:label><![CDATA[textbox1.getValue(); // (1) 両親に接触する。]]></xf:label>
    	</xf:trigger>
    	<xf:trigger type="button" id="trigger4"
    		style="width: 90%;height:15%;margin:10px;background-color: lightpink;display: block;font-weight: bolder;text-align: left;padding: 10px;"
    		ev:onclick="scwin.trigger4_onclick">
    		<xf:label><![CDATA[$p.main().textbox1.getValue(); // (2) 親要素または最上位要素にアクセスする。]]></xf:label>
    	</xf:trigger>
    	<xf:trigger ev:onclick="scwin.trigger5_onclick"
    		style="width: 90%;height:15%;margin:10px;background-color: lightpink;display: block;font-weight: bolder;text-align: left;padding: 10px;"
    		id="trigger5" type="button">
    		<xf:label><![CDATA[$p.top().textbox1.getValue(); // (3) 最上部に移動。]]></xf:label>
    	</xf:trigger>
    </body>
</html>
