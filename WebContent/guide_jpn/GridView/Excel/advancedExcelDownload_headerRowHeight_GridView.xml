<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            	<w2:dataList baseNode="list" repeatNode="map" id="dataList1" saveRemovedData="true">
            		<w2:columnInfo>
            			<w2:column id="col1" name="name1" dataType="text"></w2:column>
            			<w2:column id="col2" name="name2" dataType="text"></w2:column>
            			<w2:column id="col3" name="name3" dataType="text"></w2:column>
            		</w2:columnInfo>
            		<w2:data use="true">
            			<w2:row>
            				<col1><![CDATA[a1]]></col1>
            				<col2><![CDATA[b1]]></col2>
            				<col3><![CDATA[c1]]></col3>
            			</w2:row>
            			<w2:row>
            				<col1><![CDATA[a2]]></col1>
            				<col2><![CDATA[b2]]></col2>
            				<col3><![CDATA[c2]]></col3>
            			</w2:row>
            			<w2:row>
            				<col1><![CDATA[a3]]></col1>
            				<col2><![CDATA[b3]]></col2>
            				<col3><![CDATA[c3]]></col3>
            			</w2:row>
            			<w2:row>
            				<col1><![CDATA[a4]]></col1>
            				<col2><![CDATA[b4]]></col2>
            				<col3><![CDATA[c4]]></col3>
            			</w2:row>
            			<w2:row>
            				<col1><![CDATA[a5]]></col1>
            				<col2><![CDATA[b5]]></col2>
            				<col3><![CDATA[c5]]></col3>
            			</w2:row>
            		</w2:data>
            	</w2:dataList>
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
         <script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function () {

};

scwin.onpageunload = function () {

};

scwin.trigger1_onclick = function (e) {
    var options = {
        "rowNumVisible": "true",
        "fileName": "test",
        "headerColor": "red",
        "bodyColor": "green"
    };
    var rowHeightArr = [
        {
            "rowIndex": 0,
            "height": 100
        }
    ];
    options.headerRowHeight = rowHeightArr;
    gridView1.advancedExcelDownload(options);
};
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload" ev:onpageunload="scwin.onpageunload">
    <xf:group id="" style="margin: 10px;">
    	<w2:textbox tagname="h1" style="color: blue;margin-bottom: 10px;" tabIndex="h1" id="textbox1" label="Excelファイルのヘッダーの高さを設定する"
    		escape="false">
    	</w2:textbox>
    	<w2:textbox tagname="h2" style="height: 23px;margin-bottom: 10px;color: blue;" id="textbox2" label="サンプルの使い方"></w2:textbox>
    	<w2:textbox style="color: blue;margin-bottom: 30px;" id="textbox3"
    		label='1. 下部の最初のボタンをクリックします。 &lt;br/&gt;2.ダウンロードしたExcelファイルを開く。&lt;br/&gt;3. options.headerRowHeight設定に従ってExcelファイルのヘッダーが設定されていることを確認してください。'
    		escape="false">
    	</w2:textbox>
    	<xf:trigger ev:onclick="scwin.trigger1_onclick"
    		style="height:42px;line-height:32px;padding:5px;background-color:coral;font-size:15px;weight: bolder;font-weight:bolder;text-align: left;display: block;margin-bottom: 10px;"
    		id="trigger1" type="button">
    		<xf:label><![CDATA[advancedExcelDownload() - options.headerRowHeight]]></xf:label>
    	</xf:trigger>
    	<w2:gridView scrollByColumnAdaptive="false" rowNumVisible="true" checkAllType="false" dataList="data:dataList1"
    		scrollByColumn="false" style="border: solid gray 1px;margin-bottom: 10px;" id="gridView1" defaultCellHeight="20" autoFit="allColumn" visibleRowNum="5"
    		visibleRowNumFix="true">
    		<w2:caption style="" id="caption1" value="this is a grid caption."></w2:caption>
    		<w2:header style="" id="header1">
    			<w2:row style="" id="row1">
    				<w2:column width="70" inputType="text" style="height:20px" id="column3" value="header 1" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="height:20px" id="column2" value="header 2" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="height:20px" id="column1" value="header 3" displayMode="label"></w2:column>
    			</w2:row>
    		</w2:header>
    		<w2:gBody style="" id="gBody1">
    			<w2:row style="" id="row2">
    				<w2:column width="70" inputType="text" style="height:20px" id="col1" value="" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="height:20px" id="col2" value="" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="height:20px" id="col3" value="" displayMode="label"></w2:column>
    			</w2:row>
    		</w2:gBody>
    	</w2:gridView>
    	<w2:textbox escape="false" id="textbox4"
    		label='/// サンプルコード &lt;br/&gt;&lt;br/&gt;var options = {&lt;br/&gt; &amp;nbsp; &amp;nbsp;"rowNumVisible": "true",&lt;br/&gt; &amp;nbsp; &amp;nbsp;"fileName": "test",&lt;br/&gt; &amp;nbsp; &amp;nbsp;"headerColor": "red",&lt;br/&gt; &amp;nbsp; &amp;nbsp;"bodyColor": "green"&lt;br/&gt;};&lt;br/&gt;var rowHeightArr = [{&lt;br/&gt; &amp;nbsp; &amp;nbsp;"rowIndex": 0,&lt;br/&gt; &amp;nbsp; &amp;nbsp;"height": 100&lt;br/&gt;}];&lt;br/&gt;options.headerRowHeight = rowHeightArr;&lt;br/&gt;gridView1.advancedExcelDownload(options);'
    		style="padding:10px; padding-bottom:20px; text-align:left; font-size:15px; font-weight:bolder; border:brown 1px solid; background-color:ivory; margin-bottom:10px; color:brown;"
    		tagname="">
    	</w2:textbox>
    </xf:group></body>
</html>
