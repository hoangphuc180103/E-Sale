<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
        <w2:type>COMPONENT</w2:type>
        <w2:buildDate/>
        <w2:MSA/>
        <xf:model>
            <w2:dataCollection baseNode="map">
            	<w2:dataList baseNode="list" id="dataList1" repeatNode="map" saveRemovedData="true" style="">
            		<w2:columnInfo>
            			<w2:column dataType="text" id="col1" name="name1"></w2:column>
            			<w2:column dataType="text" id="col2" name="name2"></w2:column>
            			<w2:column dataType="text" id="col3" name="name3"></w2:column>
            			<w2:column dataType="text" id="col4" name="name4"></w2:column>
            			<w2:column dataType="text" id="col5" name="name5"></w2:column>
            		</w2:columnInfo>
            	</w2:dataList>
            	<w2:dataList baseNode="list" repeatNode="map" id="dataList2">
            		<w2:columnInfo>
            			<w2:column id="col1" name="name1" dataType="text"></w2:column>
            			<w2:column id="col2" name="name2" dataType="text"></w2:column>
            			<w2:column id="col3" name="name3" dataType="text"></w2:column>
            			<w2:column id="col4" name="name4" dataType="text"></w2:column>
            			<w2:column id="col5" name="name5" dataType="text"></w2:column>
            		</w2:columnInfo>
            	</w2:dataList>
            </w2:dataCollection>
            <w2:workflowCollection/>
        </xf:model>
        <w2:layoutInfo/>
        <w2:publicInfo method=""/>
        <script lazy="false" type="text/javascript"><![CDATA[
scwin.onpageload = function() {
	
};

scwin.trigger1_onclick = function (e) {        
        var data = [];
        for (var i = 0; i < 1000000; i++) {
            for (var j = 0; j < 5; j++){
                data.push(i);
            }
        }
        dataList1.setData(data);
        gridView1.setFocusedCell(0,0, 'true');

};

scwin.trigger2_onclick = function (e) {
        var data = [];
        for (var i = 0; i < 1000000; i++) {
            for (var j = 0; j < 5; j++){
                data.push(i);
            }
        }
        dataList2.setData(data);
        gridView2.setFocusedCell(0,0, 'true');


};
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload">
    <xf:group id="" style="margin: 10px;">
    	<w2:textbox tagname="h1" style="color: blue;margin-bottom: 10px;" tabIndex="h1" id="textbox1" label="レンダリングメソッドの選択" escape="false"></w2:textbox>
    	<w2:textbox tagname="h2" style="height: 23px;margin-bottom: 10px;color: blue;" id="textbox2" label="サンプルの使い方"></w2:textbox>
    	<w2:textbox style="color: blue;margin-bottom: 30px;" id="textbox3"
    		label='1. 下部の dataList1.setData() ボタンおよび dataList2.setData() ボタンをクリックします。 &lt;br/&gt;2.開発者ツールを使用して、各GridViewに100万件のデータが設定されたときに最初の行をフォーカスする速度を比較します。&lt;br/&gt;3. drawType="virtual" 設定を適用する場合、速度が速いことを確認します。 &lt;br/&gt;（詳細なスクリプトは「Script」タブで確認してください。）&lt;br/&gt;' escape="false">
    	</w2:textbox>
    	<w2:textbox
    		style="padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightblue;border:none;margin-bottom: 10px;"
    		id="textbox4" label='プロパティの設定&lt;br/&gt;drawType="virtual"' escape="false">
    	</w2:textbox>
    	<xf:trigger type="button" id="trigger1"
    		style="display: block;height:42px;line-height:32px;padding:5px;background-color:coral;font-size:15px;weight: bolder;font-weight:bolder;margin-bottom:10px;text-align: left;"
    		ev:onclick="scwin.trigger1_onclick">
    		<xf:label><![CDATA[dataList1.setData()]]></xf:label>
    	</xf:trigger>
    	<w2:gridView visibleRowNumFix="true" checkAllType="false" dataList="data:dataList1"
    		style="border: solid 1px gray;margin-bottom: 10px;" id="gridView1" visibleRowNum="5" autoFit="allColumn" drawType="virtual"
    		rowNumVisible="true">
    		<w2:caption style="" id="caption2" value="this is a grid caption."></w2:caption>
    		<w2:header style="" id="header2">
    			<w2:row style="" id="row3">
    				<w2:column width="70" inputType="text" style="" id="column6" value="name1" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="" id="column5" value="name2" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="" id="column4" value="name3" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="" id="column3" value="name4" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="" id="column7" value="name5" displayMode="label"></w2:column>
    			</w2:row>
    		</w2:header>
    		<w2:gBody style="" id="gBody2">
    			<w2:row style="" id="row4">
    				<w2:column width="70" inputType="text" style="" id="col1" value="" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="" id="col2" value="" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="" id="col3" value="" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="" id="col4" value="" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="" id="col5" value="" displayMode="label"></w2:column>
    			</w2:row>
    		</w2:gBody>
    	</w2:gridView>
    	<w2:textbox
    		style="padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightblue;border:none;margin-bottom: 10px;"
    		id="textbox5" label='プロパティの設定&lt;br/&gt;drawType="native"' escape="false">
    	</w2:textbox>
    	<xf:trigger type="button" id="trigger2" style="display: block;height:42px;line-height:32px;padding:5px;background-color:coral;font-size:15px;weight: bolder;font-weight:bolder;margin-bottom:10px;text-align: left;" ev:onclick="scwin.trigger2_onclick">
    		<xf:label><![CDATA[dataList2.setData()]]></xf:label>
    	</xf:trigger>
    	<w2:gridView autoFit="allColumn" checkAllType="false" dataList="data:dataList2" drawType="virtual" id="gridView2"
    		rowNumVisible="true" style="border: solid 1px gray;" visibleRowNum="5" visibleRowNumFix="true">
    		<w2:caption id="caption3" style="" value="this is a grid caption."></w2:caption>
    		<w2:header id="header2" style="">
    			<w2:row id="row3" style="">
    				<w2:column displayMode="label" id="column6" inputType="text" style="" value="name1" width="70"></w2:column>
    				<w2:column displayMode="label" id="column5" inputType="text" style="" value="name2" width="70"></w2:column>
    				<w2:column displayMode="label" id="column4" inputType="text" style="" value="name3" width="70"></w2:column>
    				<w2:column displayMode="label" id="column3" inputType="text" style="" value="name4" width="70"></w2:column>
    				<w2:column displayMode="label" id="column7" inputType="text" style="" value="name5" width="70"></w2:column>
    			</w2:row>
    		</w2:header>
    		<w2:gBody id="gBody2" style="">
    			<w2:row id="row4" style="">
    				<w2:column displayMode="label" id="col1" inputType="text" style="" value="" width="70"></w2:column>
    				<w2:column displayMode="label" id="col2" inputType="text" style="" value="" width="70"></w2:column>
    				<w2:column displayMode="label" id="col3" inputType="text" style="" value="" width="70"></w2:column>
    				<w2:column displayMode="label" id="col4" inputType="text" style="" value="" width="70"></w2:column>
    				<w2:column displayMode="label" id="col5" inputType="text" style="" value="" width="70"></w2:column>
    			</w2:row>
    		</w2:gBody>
    	</w2:gridView>
    </xf:group></body>
</html>
