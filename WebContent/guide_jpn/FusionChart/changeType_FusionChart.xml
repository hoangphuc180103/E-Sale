<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
        <w2:type>COMPONENT</w2:type>
        <w2:buildDate/>
        <w2:MSA/>
        <xf:model>
            <w2:dataCollection baseNode="map"/>
            <w2:workflowCollection/>
        </xf:model>
        <w2:layoutInfo/>
        <w2:publicInfo method=""/>
        <script lazy="false" type="text/javascript"><![CDATA[
scwin.onpageload = function() {
var jsonData = {
    "data": [{
            "value": "490000",
            "label": "China"
        },
        {
            "value": "340000",
            "label": "USA"
        },
        {
            "value": "160000",
            "label": "Brazil"
        },
        {
            "value": "220000",
            "label": "Spain"
        },
        {
            "value": "123000",
            "label": "India"
        }
    ]
};

chart1.setJSONData(jsonData);
};

scwin.trigger1_onclick = function(e) {
	chart1.changeType("line");
};

scwin.trigger2_onclick = function (e) {
	chart1.changeType("funnel");
};

scwin.trigger3_onclick = function (e) {
	chart1.changeType("pyramid");
};
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload">
    <xf:group id="" style="margin: 10px;">
    	<w2:textbox tagname="h1" style="color: blue;margin-bottom: 10px;" tabIndex="h1" id="textbox1" label="グラフの種類を動的に変更"
    		escape="false">
    	</w2:textbox>
    	<w2:textbox tagname="h2" style="height: 23px;margin-bottom: 10px;color: blue;" id="textbox2" label="サンプルの使い方"></w2:textbox>
    	<w2:textbox style="color: blue;margin-bottom: 30px;" id="textbox3"
    		label='1. 下部の changeType() ボタンをそれぞれクリックします。 &lt;br/&gt;2. 各ボタンをクリックするたびに、指定した種類のチャートで変更になることを確認してください。' escape="false">
    	</w2:textbox>
    	<xf:trigger ev:onclick="scwin.trigger1_onclick"
    		style="height:42px;line-height:32px;padding:5px;background-color:coral;font-size:15px;weight: bolder;font-weight:bolder;text-align: left;display: block;margin-bottom: 10px;"
    		id="trigger1" type="button">
    		<xf:label><![CDATA[chart1.changeType("line");]]></xf:label>
    	</xf:trigger>
    	<xf:trigger type="button" id="trigger2" style="height:42px;line-height:32px;padding:5px;background-color:coral;font-size:15px;weight: bolder;font-weight:bolder;text-align: left;display: block;margin-bottom: 10px;" ev:onclick="scwin.trigger2_onclick">
    		<xf:label><![CDATA[chart1.changeType("funnel");]]></xf:label>
    	</xf:trigger>
    	<xf:trigger type="button" id="trigger3" style="height:42px;line-height:32px;padding:5px;background-color:coral;font-size:15px;weight: bolder;font-weight:bolder;text-align: left;display: block;margin-bottom: 10px;" ev:onclick="scwin.trigger3_onclick">
    		<xf:label><![CDATA[chart1.changeType("pyramid");]]></xf:label>
    	</xf:trigger>
    	<w2:fusionchart seriesType="simple" drawType="javascript" runflashAt="IE6,IE7,IE8" chartType="Column2D"
    		style="width: 500px;height: 300px;" id="chart1">
    	</w2:fusionchart>
    </xf:group></body>
</html>
