<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
         <script type="text/javascript" lazy="false"><![CDATA[
        
	scwin.onpageload = function() {
		
	};
	
	scwin.onpageunload = function() {
		
	};
	
	
	scwin.trigger1_onclick = function(e) {
		upload1.openFileDialog();
	};
	]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload" ev:onpageunload="scwin.onpageunload">
    <xf:group id="" style="margin: 10px;">
    	<w2:textbox escape="false" id="textbox1" label="Open File Explorer Using a Method" style="color: blue;margin-bottom: 10px;" tabIndex="h1" tagname="h1"></w2:textbox>
    	<w2:textbox id="textbox2" label="How to Use" style="height: 23px;margin-bottom: 10px;color: blue;" tagname="h2"></w2:textbox>
    	<w2:textbox escape="false" id="textbox3"
    		label='1. Click the button below.&lt;br/&gt;2. Confirm that File Explorer opens.'
    		style="color: blue;margin-bottom: 30px;">
    	</w2:textbox>
    	<xf:trigger ev:onclick="scwin.trigger1_onclick" style="height:42px;line-height:32px;padding:5px;background-color:coral;font-size:15px;weight: bolder;font-weight:bolder;text-align: left;display: block;margin-bottom: 10px;" id="trigger1"
    		type="button">
    		<xf:label><![CDATA[upload1.openFileDialog();]]></xf:label>
    	</xf:trigger>
    	<w2:upload inputStyle="vertical-align:middle;word-wrap:break-word" style="margin-bottom: 10px;" id="upload1" imageStyle="position:absolute;vertical-align:middle;word-wrap:break-word">
    	</w2:upload>
    </xf:group></body>
</html>
