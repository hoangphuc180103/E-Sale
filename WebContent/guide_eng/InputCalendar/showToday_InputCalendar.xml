<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
         <script type="text/javascript" lazy="false"><![CDATA[
        
	scwin.onpageload = function() {
		
	};
	
	scwin.onpageunload = function() {
		
	};
	
	]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload" ev:onpageunload="scwin.onpageunload">
    <xf:group id="" style="margin: 10px;">
    	<w2:textbox tagname="h1" style="color: blue;margin-bottom: 10px;" tabIndex="h1" id="textbox1" label="Show/Hide 'Today' Button&lt;br/&gt;"
    		escape="false">
    	</w2:textbox>
    	<w2:textbox tagname="h2" style="height: 23px;margin-bottom: 10px;color: blue;" id="textbox2" label="How to Use"></w2:textbox>
    	<w2:textbox style="color: blue;margin-bottom: 30px;" id="textbox3"
    		label='1. Click the calendar icon on the first InputCalendar.&lt;br/&gt;2. Confirm that the “Today” button appears above the calendar. (showToday=“true”)&lt;br/&gt;3. Click the calendar icon on the second InputCalendar.&lt;br/&gt;4. Confirm that the “Today” button does not appear above the calendar. (showToday=“false”)'
    		escape="false">
    	</w2:textbox>
    	<w2:textbox
    		style="padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightblue;border:none;margin-bottom: 10px;"
    		id="textbox4" label='showToday="true"' escape="false">
    	</w2:textbox>
    	<w2:inputCalendar footerDiv="false" rightAlign="false" focusOnDateSelect="false" style="margin-bottom: 10px;" id="inputCalendar1" renderType="component"
    		renderDiv="true" calendarValueType="" showToday="true">
    	</w2:inputCalendar>
    	<w2:textbox escape="false" id="textbox6" label='showToday="false"'
    		style="padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightblue;border:none;margin-bottom: 10px;">
    	</w2:textbox>
    	<w2:inputCalendar calendarValueType="" focusOnDateSelect="false" footerDiv="false" id="inputCalendar3" renderDiv="true"
    		renderType="component" rightAlign="false" showToday="false" style="">
    	</w2:inputCalendar>
    </xf:group></body>
</html>
