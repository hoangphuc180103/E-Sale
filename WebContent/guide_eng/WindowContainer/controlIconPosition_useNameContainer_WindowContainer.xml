        windowContainer1.createWindow( title, null, null);
        windowContainer2.createWindow( title, null, null);
        windowContainer3.createWindow( title, null, null);
    }
        windowContainer1.setArrangeWindows("sequential");
        windowContainer2.setArrangeWindows("sequential");
        windowContainer3.setArrangeWindows("sequential");
	};
	
	scwin.onpageunload = function() {
		
	};
	
	]]></script>
