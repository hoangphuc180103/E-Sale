<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head meta_vertical_guides="" meta_horizontal_guides="">
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
         <script type="text/javascript" lazy="false"><![CDATA[
        
	scwin.onpageload = function() {
		
	};
	
	scwin.onpageunload = function() {
		
	};
	
	
	scwin.trigger1_onclick = function(e) {
		var date1 = input1.getValue();
		var result1 = WebSquare.date.toSolar(date1);
		input2.setValue(result1);
	};
	
	scwin.trigger2_onclick = function(e) {
		var date2 = input1.getValue();
		var result2 = WebSquare.date.toLunar(date2);
		input3.setValue(result2);
		
	};
	]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload" ev:onpageunload="scwin.onpageunload">
    <xf:group id="" style="margin: 10px;"><w2:textbox tagname="h1" style="color: blue;margin-bottom: 10px;" tabIndex="h1" id="textbox1" label="Convert Dates to Solar and Lunar Calendars&lt;br/&gt;" escape="false"></w2:textbox><w2:textbox tagname="h2" style="height: 23px;margin-bottom: 10px;color: blue;" id="textbox2" label="How to Use"></w2:textbox><w2:textbox style="color: blue;margin-bottom: 30px;" id="textbox3" label='1. Enter the date to convert. (Example: “20260101”)&lt;br/&gt;2. Click the WebSquare.date.toSolar() button.&lt;br/&gt;3. Verify the result converted to the solar calendar is displayed.&lt;br/&gt;4. Click the WebSquare.date.toLunar() button. &lt;br/&gt;5. Verify the result converted to the lunar date is displayed.&lt;br/&gt;(See the Script tab for detailed script.)' escape="false">
    	</w2:textbox><w2:textbox style="padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightpink;border:none;margin-bottom: 10px;" id="textbox4" label="Enter the date to convert." escape="false">
    	</w2:textbox><xf:input style="width: 100%;text-align: right;height:50px;padding: 5px;font-size:30px;font-style:normal;font-weight:bolder;" id="input1" placeholder="Date to Convert"></xf:input><xf:trigger ev:onclick="scwin.trigger1_onclick" style="height:42px;line-height:32px;padding:5px;background-color:coral;font-size:15px;weight: bolder;font-weight:bolder;margin-top:10px;text-align: left;display: block" id="trigger1" type="button">
    		<xf:label><![CDATA[WebSquare.date.toSolar()]]></xf:label>
    	</xf:trigger><xf:input nextTabID="trigger1" dataType="date" displayFormat="yyyy-MM-dd" adjustMaxLength="false" style="width: 100%;text-align: right;height:50px;padding: 5px;font-size:30px;font-style:normal;margin-bottom: 10px;font-weight:bolder;color: orange;margin-top: 10px;" id="input2" displaymessage="" placeholder="Convert to Solar Calendars">
    	</xf:input><xf:trigger ev:onclick="scwin.trigger2_onclick" style="height:42px;line-height:32px;padding:5px;background-color:lightgreen;font-size:15px;weight: bolder;font-weight:bolder;margin-top:10px;text-align: left;display: block;margin-bottom: 10px;" id="trigger2" type="button">
    		<xf:label><![CDATA[WebSquare.date.toLunar()]]></xf:label>
    	</xf:trigger><xf:input nextTabID="trigger2" dataType="date" displayFormat="yyyy-MM-dd" adjustMaxLength="false" style="width: 100%;text-align: right;height:50px;padding: 5px;font-size:30px;font-style:normal;font-weight:bolder;color: green;" id="input3" placeholder="Convert to Lunar Calendar">
    	</xf:input></xf:group></body>
</html>
