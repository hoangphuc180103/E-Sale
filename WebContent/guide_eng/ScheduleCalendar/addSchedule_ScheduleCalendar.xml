<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            	<w2:dataList baseNode="list" repeatNode="map" id="dataList1" saveRemovedData="true">
            		<w2:columnInfo>
            			<w2:column id="title" name="title" dataType="text"></w2:column>
            			<w2:column id="id" name="id" dataType="text"></w2:column>
            			<w2:column id="start" name="start" dataType="text"></w2:column>
            			<w2:column id="end" name="end" dataType="text"></w2:column>
            		</w2:columnInfo>
            		<w2:data use="false">
            			<w2:row>
            				<title><![CDATA[AAA]]></title>
            				<id><![CDATA[1]]></id>
            				<start><![CDATA[20201001]]></start>
            				<end><![CDATA[20201002]]></end>
            			</w2:row>
            			<w2:row>
            				<title><![CDATA[BBB]]></title>
            				<id><![CDATA[2]]></id>
            				<start><![CDATA[20201010]]></start>
            				<end><![CDATA[20201012]]></end>
            			</w2:row>
            			<w2:row>
            				<title><![CDATA[CCC]]></title>
            				<id><![CDATA[3]]></id>
            				<start><![CDATA[20201020]]></start>
            				<end><![CDATA[20201023]]></end>
            			</w2:row>
            			<w2:row>
            				<title><![CDATA[DDD]]></title>
            				<id><![CDATA[4]]></id>
            				<start><![CDATA[20201015]]></start>
            				<end><![CDATA[20201017]]></end>
            			</w2:row>
            		</w2:data>
            	</w2:dataList>
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
         <script type="text/javascript" lazy="false"><![CDATA[scwin.count = 0;

scwin.onpageload = function () {

};

scwin.onpageunload = function () {

};

scwin.trigger1_onclick = function (e) {
    var dateStr = WebSquare.date.getCurrentServerDate("yyyyMMdd");
    var addDate = WebSquare.date.dateAdd(dateStr, 3);

    scheduleCalendar1.addSchedule({
        "title": "My Schedule",
        "start": dateStr,
        "end": addDate,
        "id": scwin.count
    });
    scwin.count++;
};
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload" ev:onpageunload="scwin.onpageunload">
    <xf:group id="" style="margin:10px;">
    	<w2:textbox tagname="h1" style="color: blue;margin-bottom: 10px;" tabIndex="h1" id="textbox1" label="Add Dynamic Schedule&lt;br/&gt;" escape="false"></w2:textbox>
    	<w2:textbox tagname="h2" style="height: 23px;margin-bottom: 10px;color: blue;" id="textbox2" label="How to Use"></w2:textbox>
    	<w2:textbox style="color: blue;margin-bottom: 30px;" id="textbox3"
    		label='1. Click the addSchedule() button below.&lt;br/&gt;2. Confirm that the schedule is added.&lt;br/&gt;(See the Script tab for detailed script.)' escape="false">
    	</w2:textbox>
    	<w2:textbox style="padding:10px; padding-bottom:20px; text-align:left; font-size:15px; font-weight:bolder; border:brown 1px solid; background-color:ivory; margin-bottom:10px; margin-top:10px; color:brown;" id="textbox4" label='/// Sample Code&lt;br/&gt;&lt;br/&gt;scwin.count = 0;&lt;br/&gt;&lt;br/&gt;scwin.trigger1_onclick = function (e) {&lt;br/&gt; &amp;nbsp; &amp;nbsp;var dateStr = WebSquare.date.getCurrentServerDate("yyyyMMdd");&lt;br/&gt; &amp;nbsp; &amp;nbsp;var addDate = WebSquare.date.dateAdd(dateStr, 3);&lt;br/&gt;&lt;br/&gt; &amp;nbsp; &amp;nbsp;scheduleCalendar1.addSchedule({&lt;br/&gt; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;"title": "My Schedule",&lt;br/&gt; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;"start": dateStr,&lt;br/&gt; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;"end": addDate,&lt;br/&gt; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;"id": scwin.count&lt;br/&gt; &amp;nbsp; &amp;nbsp;});&lt;br/&gt; &amp;nbsp; &amp;nbsp;scwin.count++;&lt;br/&gt;};' escape="false">
    	</w2:textbox>
    	<xf:trigger ev:onclick="scwin.trigger1_onclick"
    		style="height:42px;line-height:32px;padding:5px;background-color:coral;font-size:15px;weight: bolder;font-weight:bolder;text-align: left;display: block;margin-bottom: 10px;"
    		id="trigger1" type="button">
    		<xf:label><![CDATA[addSchedule()]]></xf:label>
    	</xf:trigger>
    	<w2:scheduleCalendar dataList="dataList1" defaultDate="" editable="false" endColumn="end" eventLimit="false" headerLeftBtn="true"
    		headerRightBtn="false" headerTitle="true" id="scheduleCalendar1" lang="" selectable="true" startColumn="start"
    		style="width: 400px;height: 500px;margin-bottom: 10px;" titleColumn="title" useHeaderToolbar="false" version="6.1.11">
    	</w2:scheduleCalendar>
    </xf:group></body>
</html>
