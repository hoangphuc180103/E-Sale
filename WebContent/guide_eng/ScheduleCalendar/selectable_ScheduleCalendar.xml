<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            	<w2:dataList baseNode="list" repeatNode="map" id="dataList1">
            		<w2:columnInfo>
            			<w2:column id="title" name="title" dataType="text"></w2:column>
            			<w2:column id="id" name="id" dataType="text"></w2:column>
            			<w2:column id="start" name="start" dataType="text"></w2:column>
            			<w2:column id="end" name="end" dataType="text"></w2:column>
            		</w2:columnInfo>
            	</w2:dataList>
            	<w2:dataList baseNode="list" repeatNode="map" id="dataList2">
            		<w2:columnInfo>
            			<w2:column id="title" name="title" dataType="text"></w2:column>
            			<w2:column id="id" name="id" dataType="text"></w2:column>
            			<w2:column id="start" name="start" dataType="text"></w2:column>
            			<w2:column id="end" name="end" dataType="text"></w2:column>
            		</w2:columnInfo>
            	</w2:dataList>
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
         <script type="text/javascript" lazy="false"><![CDATA[

scwin.onpageload = function () {
    var dateStr = WebSquare.date.getCurrentServerDate("yyyyMMdd");
    var addDate = WebSquare.date.dateAdd(dateStr, 3);
    var tmpArr = [{ "title": "My Schedule", "id": "001", "start": dateStr, "end": addDate }];
    dataList1.setJSON(tmpArr);
    dataList2.setJSON(tmpArr);
};

scwin.onpageunload = function () {

};
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload" ev:onpageunload="scwin.onpageunload">
    <xf:group id="" style="margin:10px;">
    	<w2:textbox tagname="h1" style="color: blue;margin-bottom: 10px;" tabIndex="h1" id="textbox1" label="Register Schedule through Mouse Click or Dragging&lt;br/&gt;" escape="false"></w2:textbox>
    	<w2:textbox tagname="h2" style="height: 23px;margin-bottom: 10px;color: blue;" id="textbox2" label="How to Use"></w2:textbox>
    	<w2:textbox style="color: blue;margin-bottom: 30px;" id="textbox3"
    		label='(First ScheduleCalendar)&lt;br/&gt;1. Click any date on the calendar, or drag to select multiple dates.&lt;br/&gt;2. Confirm the default prompt window for schedule registration appears.&lt;br/&gt;3. Register the schedule. &lt;br/&gt;4. Press Ctrl + right-click, then select the “View dataCollection” menu to confirm the added schedule is set in the DataList.&lt;br/&gt;&lt;br/&gt;(Second ScheduleCalendar)&lt;br/&gt;1. Confirm that clicking a date on the calendar or dragging to select multiple dates does not display the schedule registration window.'
    		escape="false">
    	</w2:textbox>
    	<w2:textbox
    		style="padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightblue;border:none;margin-bottom: 10px;"
    		id="textbox4" label='selectable="true"' escape="false">
    	</w2:textbox>
    	<w2:scheduleCalendar dataList="data:dataList1" defaultDate="" editable="false" endColumn="end" eventLimit="false" headerLeftBtn="true"
    		headerRightBtn="false" headerTitle="true" id="scheduleCalendar1" lang="" selectable="true" startColumn="start"
    		style="width: 400px;height: 500px;margin-bottom: 10px;" titleColumn="title" useHeaderToolbar="false" version="6.1.11">
    	</w2:scheduleCalendar>
    	<w2:textbox escape="false" id="textbox5" label='selectable="false"'
    		style="padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightblue;border:none;margin-bottom: 10px;">
    	</w2:textbox>
    	<w2:scheduleCalendar dataList="data:dataList2" defaultDate="" editable="false" endColumn="end" eventLimit="false" headerLeftBtn="true"
    		headerRightBtn="false" headerTitle="true" id="scheduleCalendar3" lang="" selectable="false" startColumn="start"
    		style="width: 400px;height: 500px;margin-bottom: 10px;" titleColumn="title" useHeaderToolbar="false" version="6.1.11">
    	</w2:scheduleCalendar>
    </xf:group></body>
</html>
