<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            	<w2:dataList baseNode="list" repeatNode="map" id="dataList1" saveRemovedData="true">
            		<w2:columnInfo>
            			<w2:column id="title" name="title" dataType="text"></w2:column>
            			<w2:column id="start" name="start" dataType="text"></w2:column>
            			<w2:column id="end" name="end" dataType="text"></w2:column>
            		</w2:columnInfo>
            		<w2:data use="false">
            		</w2:data>
            	</w2:dataList>
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
         <script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function () {
};

scwin.onpageunload = function () {

};

scwin.titleFormatter = function (info) {
    var userName = input1.getValue();
    if (info.title) {
        return userName + "'s To-do : </br>" + info.title;
    }
};
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload" ev:onpageunload="scwin.onpageunload">
    <xf:group id="" style="margin:10px;">
    	<w2:textbox tagname="h1" style="color: blue;margin-bottom: 10px;" tabIndex="h1" id="textbox1" label="Format Schedule Title&lt;br/&gt;" escape="false"></w2:textbox>
    	<w2:textbox tagname="h2" style="height: 23px;margin-bottom: 10px;color: blue;" id="textbox2" label="How to Use"></w2:textbox>
    	<w2:textbox style="color: blue;margin-bottom: 30px;" id="textbox3"
    		label='1. Enter your name in the input box below.&lt;br/&gt;2. Click any date on the calendar.&lt;br/&gt;3. Enter the schedule.&lt;br/&gt;4. Confirm that the function entered as the titleFormatter property converts the above input and displays the converted value as the schedule title.&lt;br/&gt;5. Press Ctrl + right-click.&lt;br/&gt;6. Confirm that clicking a date in the actual DataList sets the entered value as the title.&lt;br/&gt;(See the Script tab for detailed script.)'
    		escape="false">
    	</w2:textbox>
    	<w2:textbox
    		style="padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightblue;border:none;margin-bottom: 10px;"
    		id="textbox4" label='titleFormatter="scwin.titleFormatter' escape="false">
    	</w2:textbox>
    	<w2:textbox style="padding:10px; padding-bottom:20px; text-align:left; font-size:15px; font-weight:bolder; border:brown 1px solid; background-color:ivory; margin-bottom:10px; margin-top:10px; color:brown;" id="textbox5" label="/// Sample Code&lt;br/&gt;&lt;br/&gt;scwin.titleFormatter = function (info) {&lt;br/&gt; &amp;nbsp; &amp;nbsp;var userName = input1.getValue();&lt;br/&gt; &amp;nbsp; &amp;nbsp;if (info.title) {&lt;br/&gt; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;return userName + &quot;'s To-do : &lt;/br&gt;&quot; + info.title;&lt;br/&gt; &amp;nbsp; &amp;nbsp;}&lt;br/&gt;};" escape="false">
    	</w2:textbox>
    	<xf:input adjustMaxLength="false" style="width: 600px;text-align: center;height:50px;padding: 5px;font-size:30px;font-style: italic;color: red;margin-bottom: 10px;" id="input1" placeholder="Enter your name.">
    	</xf:input>
    	<w2:scheduleCalendar defaultDate="" editable="false" selectable="true" headerRightBtn="true" ioFormat="yyyyMMdd"
    		titleFormatter="scwin.titleFormatter" titleColumn="title" startColumn="start" dataList="data:dataList1"
    		style="width: 600px;height: 500px;" id="scheduleCalendar2" headerLeftBtn="true" lang="en" viewIcon="month,basicWeek,basicDay"
    		ev:onaddschedule="scwin.scheduleCalendar1_onaddschedule" headerTitle="true" idColumn="" version="6.1.11" endColumn="end"
    		escape="false">
    	</w2:scheduleCalendar>
    </xf:group></body>
</html>
