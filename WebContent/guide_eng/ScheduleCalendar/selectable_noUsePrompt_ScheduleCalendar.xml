<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
        <w2:type>DEFAULT</w2:type>
        <w2:buildDate />
        <xf:model>
            <xf:instance>
                <data xmlns="" />
            </xf:instance>
            <w2:dataCollection baseNode="map">
            	<w2:dataList id="dataList1" baseNode="list" style="" saveRemovedData="true" repeatNode="map">
            		<w2:columnInfo>
            			<w2:column id="title" name="title" dataType="text"></w2:column>
            			<w2:column id="start" name="start" dataType="text"></w2:column>
            			<w2:column id="end" name="end" dataType="text"></w2:column>
            		</w2:columnInfo>
            		<w2:data use="true">
            		</w2:data>
            	</w2:dataList>
            	<w2:dataList baseNode="list" repeatNode="map" id="dataList2">
            		<w2:columnInfo>
            			<w2:column id="title" name="title" dataType="text"></w2:column>
            			<w2:column id="start" name="start" dataType="text"></w2:column>
            			<w2:column id="end" name="end" dataType="text"></w2:column>
            		</w2:columnInfo>
            	</w2:dataList>
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
        <script type="javascript" lazy="false"><![CDATA[
scwin.onpageload = function () {
    var dateStr = WebSquare.date.getCurrentServerDate("yyyyMMdd");
    var addDate = WebSquare.date.dateAdd(dateStr, 3);
    var tmpArr = [{ "title": "My Schedule", "start": dateStr, "end": addDate }];
    dataList1.setJSON(tmpArr);
    dataList2.setJSON(tmpArr);


};

scwin.scheduleCalendar1_onclick = function (dateInfo) {
    var options = {

        id: "pop1",
        type: "wframePopup",
        width: "330px",
        height: "340px",
        top: "130px",
        left: "200px",
        popupName: "Add Schedule Item",
        modal: true,
        frameModal: "parent",
        resizable: true
    };

    $p.openPopup("", options);
};]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload">
    <xf:group id="" style="margin:10px;">
    	<w2:textbox tagname="h1" style="color: blue;margin-bottom: 10px;" tabIndex="h1" id="textbox1"
    		label="Customize Schedule Registration Window&lt;br/&gt;" escape="false">
    	</w2:textbox>
    	<w2:textbox tagname="h2" style="height: 23px;margin-bottom: 10px;color: blue;" id="textbox2" label="How to Use"></w2:textbox>
    	<w2:textbox style="color: blue;margin-bottom: 30px;" id="textbox3"
    		label='(First ScheduleCalendar)&lt;br/&gt;1. Click any date.&lt;br/&gt;2. The default window for schedule registration does not appear; instead, a popup window implemented via an onclick event handler appears.&lt;br/&gt;&lt;br/&gt;(First ScheduleCalendar)&lt;br/&gt;1. Click any date.&lt;br/&gt;2. The default prompt window for schedule registration appears.'
    		escape="false">
    	</w2:textbox>
    	<w2:textbox
    		style="padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightblue;border:none;margin-bottom: 10px;"
    		id="textbox4" label='noUsePrompt="true"' escape="false">
    	</w2:textbox>
    	<w2:textbox style="padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightgreen;border:none;margin-bottom: 10px;" id="textbox7" label="Event Description&lt;br/&gt;&lt;br/&gt;onclick - Fired when the date is clicked." escape="false">
    	</w2:textbox>
    	<w2:textbox
    		style="padding:10px; padding-bottom:20px; text-align:left; font-size:15px; font-weight:bolder; border:brown 1px solid; background-color:ivory; margin-bottom:10px; margin-top:10px; color:brown;"
    		id="textbox6" label='/// Sample Code&lt;br/&gt;&lt;br/&gt;scwin.scheduleCalendar1_onclick = function(dateInfo) {&lt;br/&gt; &amp;nbsp; &amp;nbsp;var options = {&lt;br/&gt;&lt;br/&gt; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;id: "pop1",&lt;br/&gt; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;type: "wframePopup",&lt;br/&gt; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;width: "330px",&lt;br/&gt; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;height: "340px",&lt;br/&gt; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;top: "130px",&lt;br/&gt; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;left: "200px",&lt;br/&gt; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;popupName: "Add Schedule Item",&lt;br/&gt; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;modal: true,&lt;br/&gt; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;frameModal: "parent",&lt;br/&gt; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;resizable: true&lt;br/&gt; &amp;nbsp; &amp;nbsp;};&lt;br/&gt;&lt;br/&gt; &amp;nbsp; &amp;nbsp;$p.openPopup("", options);&lt;br/&gt;};' escape="false">
    	</w2:textbox>
    	<w2:scheduleCalendar defaultDate="" endColumn="end" editable="false" selectable="true" headerRightBtn="false"
    		useFooterToolbar="true" useHeaderToolbar="true" version="6.1.11" titleColumn="title" startColumn="start" dataList="data:dataList1"
    		ev:onclick="scwin.scheduleCalendar1_onclick" style="width: 400px;height: 500px;margin-bottom: 10px;" eventLimit="false"
    		id="scheduleCalendar1" headerLeftBtn="true" headerTitle="true" noUsePrompt="true">
    	</w2:scheduleCalendar>
    	<w2:textbox escape="false" id="textbox5" label='noUsePrompt="false"'
    		style="padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightblue;border:none;margin-bottom: 10px;">
    	</w2:textbox>
    	<w2:scheduleCalendar dataList="data:dataList2" defaultDate="" editable="false" endColumn="end" ev:onclick="scwin.schedule1_onclick"
    		eventLimit="false" headerLeftBtn="true" headerRightBtn="false" headerTitle="true" id="scheduleCalendar2" selectable="true"
    		startColumn="start" style="width: 400px;height: 500px;margin-bottom: 10px;" titleColumn="title" useFooterToolbar="true"
    		useHeaderToolbar="true" version="6.1.11">
    	</w2:scheduleCalendar>
    </xf:group></body>
</html>
