         <script type="text/javascript" lazy="false"><![CDATA[

scwin.onpageload = function () {

};

scwin.onpageunload = function () {

};


scwin.trigger1_onclick = function (e) {
    var options = {
        headerExist: 1,
        type: "1",
        convertIndex: "1"
    };
    gridView1.advancedExcelUpload(options);
};

scwin.trigger2_onclick = function (e) {
    gridView2.advancedExcelDownload({});
};
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload" ev:onpageunload="scwin.onpageunload">
    <xf:group id="" style="padding: 10px;">
    	<w2:textbox tagname="h1" style="color: blue;margin-bottom: 10px;" tabIndex="h1" id="textbox1" label="Set Data to Upload (for Each GridView Column)&lt;br/&gt;"
    		escape="false">
    	</w2:textbox>
    	<w2:textbox tagname="h2" style="height: 23px;margin-bottom: 10px;color: blue;" id="textbox2" label="How to Use"></w2:textbox>
    	<w2:textbox style="color: blue;margin-bottom: 30px;" id="textbox3"
    		label='1. Prepare an Excel file with data stored in the order label, value, label, as shown in the first GridView below.&lt;br/&gt;(Alternatively, click the Download GridView button below to download the example GridView as an Excel file.)&lt;br/&gt;&lt;br/&gt;2. Click the second button below to upload the Excel file you prepared (or downloaded) earlier. &lt;br/&gt;(advancedExcelUpload(options) &amp;nbsp;- options.type=“1”, options.convertIndex=“1”)&lt;br/&gt;&lt;br/&gt;3. Confirm that the Excel file has uploaded and data is displayed according to the displayMode property of each GridView column.&lt;br/&gt;(Confirm that the column with index="0" displays labels, the column with index="1" displays values, and the column with index="2" displays label values.)&lt;br/&gt;'
    		escape="false">
    	</w2:textbox>
    	<xf:trigger type="button" id="trigger2"
    		style="height:42px;line-height:32px;padding:5px;background-color:lightpink;font-size:15px;weight: bolder;font-weight:bolder;text-align: left;display: block;margin-bottom: 10px;"
    		ev:onclick="scwin.trigger2_onclick">
    		<xf:label><![CDATA[Download GridView]]></xf:label>
    	</xf:trigger>
    	<w2:gridView checkAllType="false" id="gridView2" style="border: solid gray 1px;margin-bottom: 10px;" dataList="data:dataList2"
    		visibleRowNum="5" visibleRowNumFix="true" autoFit="allColumn" autoFitCellMinWidth="allColumn">
    		<w2:caption style="" id="caption2" value="this is a grid caption."></w2:caption>
    		<w2:header style="" id="header2">
    			<w2:row style="" id="row3">
    				<w2:column width="70" inputType="text" style="" id="column5" value="select" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="" id="column4" value="autoComplete" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="" id="column3" value="checkcombobox" displayMode="label"></w2:column>
    			</w2:row>
    		</w2:header>
    		<w2:gBody style="" id="gBody2">
    			<w2:row style="" id="row4">
    				<w2:column width="70" inputType="text" style="" id="col1" value="" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="" id="col2" value="" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="" id="col3" value="" displayMode="label"></w2:column>
    			</w2:row>
    		</w2:gBody>
    	</w2:gridView>
    	<xf:trigger ev:onclick="scwin.trigger1_onclick"
    		style="height:42px;line-height:32px;padding:5px;background-color:coral;font-size:15px;weight: bolder;font-weight:bolder;text-align: left;display: block;margin-bottom: 10px;"
    		id="trigger1" type="button">
    		<xf:label><![CDATA[advancedExcelUpload(options)]]></xf:label>
    	</xf:trigger>
    	<w2:gridView scrollByColumnAdaptive="false" dataList="data:dataList1" style="border: solid gray 1px;margin-bottom: 10px;" scrollByColumn="false"
    		id="gridView1" defaultCellHeight="20" autoFit="allColumn" visibleRowNum="5" visibleRowNumFix="true">
    		<w2:caption style="" id="caption1" value="this is a grid caption."></w2:caption>
    		<w2:header style="" id="header1">
    			<w2:row style="" id="row1">
    				<w2:column width="70" inputType="text" style="" id="column2" value="select" displayMode="label"></w2:column>
    				<w2:column removeBorderStyle="false" width="70" inputType="text" style="height:20px;" id="column2" value="autoComplete"
    					blockSelect="false" displayMode="label">
    				</w2:column>
    				<w2:column removeBorderStyle="false" width="70" inputType="text" style="height:20px;" id="column1" value="checkcombobox"
    					blockSelect="false" displayMode="label">
    				</w2:column>
    			</w2:row>
    		</w2:header>
    		<w2:gBody style="" id="gBody1">
    			<w2:row style="" id="row2">
    				<w2:column width="70" inputType="select" style="" id="select" value="" displayMode="label delim value" allOption=""
    					chooseOption="" ref="">
    					<w2:choices>
    						<w2:itemset nodeset="data:select">
    							<w2:label ref="label"></w2:label>
    							<w2:value ref="value"></w2:value>
    						</w2:itemset>
    					</w2:choices>
    				</w2:column>
    				<w2:column ref="" removeBorderStyle="false" chooseOption="" width="70" inputType="autoComplete" style="height:20px"
    					id="autoComplete" allOption="" value="" blockSelect="false" displayMode="label delim value">
    					<w2:choices>
    						<w2:itemset nodeset="data:autoComplete">
    							<w2:label ref="label"></w2:label>
    							<w2:value ref="value"></w2:value>
    						</w2:itemset>
    					</w2:choices>
    				</w2:column>
    				<w2:column ref="" delimiter=" - " removeBorderStyle="false" chooseOption="" width="70" inputType="checkcombobox"
    					style="height:20px" id="checkcombobox" allOption="" value="" blockSelect="false" displayMode="label delim value">
    					<w2:choices>
    						<w2:itemset nodeset="data:checkcombobox">
    							<w2:label ref="label"></w2:label>
    							<w2:value ref="value"></w2:value>
    						</w2:itemset>
    					</w2:choices>
    				</w2:column>
    			</w2:row>
    		</w2:gBody>
    	</w2:gridView>
    	<w2:textbox escape="false" id="textbox4"
    		label='/// Sample Code&lt;br/&gt;&lt;br/&gt;var options = {&lt;br/&gt; &amp;nbsp; &amp;nbsp;headerExist: 1,&lt;br/&gt; &amp;nbsp; &amp;nbsp;type: "1",&lt;br/&gt; &amp;nbsp; &amp;nbsp;convertIndex: "1"&lt;br/&gt;};&lt;br/&gt;gridView1.advancedExcelUpload(options);'
    		style="padding:10px; padding-bottom:20px; text-align:left; font-size:15px; font-weight:bolder; border:brown 1px solid; background-color:ivory; margin-bottom:10px; color:brown;"
    		tagname="">
    	</w2:textbox>
