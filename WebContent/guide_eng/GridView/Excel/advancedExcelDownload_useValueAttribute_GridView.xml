<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet href="/Guide/GridView/color.css" type="text/css"?>
<?xml-stylesheet href="/Guide/GridView/style.css" type="text/css"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head meta_screenName="guide_sample">
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
        	<xf:instance>
        		<data xmlns="" />
        	</xf:instance>
        	<w2:dataCollection baseNode="map">
        		<w2:dataList baseNode="list" repeatNode="map" id="dataList1" saveRemovedData="true"
        			ev:oncelldatachange="scwin.dataList1_oncelldatachange">
        			<w2:columnInfo>
        				<w2:column id="col1" name="col1" dataType="text"></w2:column>
        				<w2:column id="col2" name="col2" dataType="text"></w2:column>
        				<w2:column id="col3" name="col3" dataType="text"></w2:column>
        				<w2:column id="col4" name="col4" dataType="text"></w2:column>
        				<w2:column id="col5" name="col5" dataType="text"></w2:column>
        			</w2:columnInfo>
        			<w2:data use="true">
        				<w2:row></w2:row>
        				<w2:row></w2:row>
        				<w2:row></w2:row>
        				<w2:row></w2:row>
        				<w2:row></w2:row>
        				<w2:row></w2:row>
        				<w2:row></w2:row>
        				<w2:row></w2:row>
        				<w2:row></w2:row>
        				<w2:row></w2:row>
        			</w2:data>
        		</w2:dataList>
        	</w2:dataCollection>
        	<w2:workflowCollection></w2:workflowCollection>
        </xf:model>
        <script type="text/javascript" lazy="false"><![CDATA[

scwin.onpageload = function () {

};

scwin.onpageunload = function () {

};

scwin.trigger1_onclick = function (e) {
    var options = {
        useValueAttribute: "true"
    };
    options.fileName = "useValueAttribute_true.xls";
    gridView1.advancedExcelDownload(options);
};

scwin.trigger2_onclick = function (e) {
    var options = {
        useValueAttribute: "false"
    };
    options.fileName = "useValueAttribute_false.xls";
    gridView1.advancedExcelDownload(options);

};
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload" ev:onpageunload="scwin.onpageunload">
    <xf:group id="" style="margin: 10px;">
    	<w2:textbox tagname="h1" style="color: blue;margin-bottom: 10px;" tabIndex="h1" id="textbox1" label="Download value Property Setting of the Column"
    		escape="false">
    	</w2:textbox>
    	<w2:textbox tagname="h2" style="height: 23px;margin-bottom: 10px;color: blue;" id="textbox2" label="How to Use"></w2:textbox>
    	<w2:textbox style="color: blue;margin-bottom: 30px;" id="textbox3"
    		label='1. Verify that the value attribute of the “co1” column in the bottom GridView is set to “a”, and the value attribute of the ‘col3’ column is set to “c”.&lt;br/&gt;&lt;br/&gt;2-1. Click the first button at the bottom.&lt;br/&gt;2-2. Open the downloaded Excel file. (useValueAttribute_true.xls)&lt;br/&gt;2-3. Verify that the value specified for the value attribute is downloaded to the Excel file.&lt;br/&gt;&lt;br/&gt;3-1. Click the second button at the bottom.&lt;br/&gt;3-2. Open the downloaded Excel file. (useValueAttribute_false.xls)&lt;br/&gt;3-3. Verify that the value specified for the value attribute is not downloaded to the Excel file.&lt;br/&gt;&lt;br/&gt;(Detailed script available in the Script tab.)'
    		escape="false">
    	</w2:textbox>
    	<w2:textbox style="padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightblue;border:none;margin-bottom: 10px;" id="textbox4" label='value="a" (dataList1.col1)&lt;br/&gt;value="c" (dataList1.col3' escape="false">
    	</w2:textbox>
    	<xf:trigger ev:onclick="scwin.trigger1_onclick"
    		style="height:42px;line-height:32px;padding:5px;background-color:coral;font-size:15px;weight: bolder;font-weight:bolder;text-align: left;display: block;margin-bottom: 10px;"
    		id="trigger1" type="button">
    		<xf:label><![CDATA[advancedExcelDownload() - useValueAttribute: "true"]]></xf:label>
    	</xf:trigger>
    	<xf:trigger type="button" id="trigger2"
    		style="height:42px; line-height:32px; padding:5px; background-color:coral; font-size:15px; weight:bolder; font-weight:bolder; text-align:left; display:block; margin-bottom:10px;"
    		ev:onclick="scwin.trigger2_onclick">
    		<xf:label><![CDATA[advancedExcelDownload() - useValueAttribute: "false"]]></xf:label>
    	</xf:trigger>
    	<w2:gridView scrollByColumnAdaptive="false" wheelRows="5" rowNumVisible="true" scrollByColumn="false" defaultCellHeight="20"
    		contextMenu="true" dataList="data:dataList1" style="border: solid gray 1px;" id="gridView1" visibleRowNum="10" autoFit="allColumn"
    		ev:oncelldblclick="scwin.gridView1_oncelldblclick" autoFitMinWidth="0" visibleRowNumFix="true" useShiftKey="" ctrlShiftKey="">
    		<w2:caption style="" id="caption1" value="this is a grid caption."></w2:caption>
    		<w2:header style="" id="header1">
    			<w2:row style="" id="row1">
    				<w2:column width="70" style="" inputType="text" id="column5" value="col1"></w2:column>
    				<w2:column width="70" style="" inputType="text" id="column4" value="col2"></w2:column>
    				<w2:column width="70" style="" inputType="text" id="column3" value="col3"></w2:column>
    				<w2:column width="70" style="" inputType="text" id="column2" value="col4"></w2:column>
    				<w2:column width="70" style="" inputType="text" id="column1" value="col5"></w2:column>
    			</w2:row>
    		</w2:header>
    		<w2:gBody style="" id="gBody1">
    			<w2:row style="" id="row2">
    				<w2:column width="70" style="" inputType="text" id="col1" value="a"></w2:column>
    				<w2:column width="70" style="" inputType="text" id="col2" value=""></w2:column>
    				<w2:column width="70" style="" inputType="text" id="col3" value="c"></w2:column>
    				<w2:column width="70" style="" inputType="text" id="col4" value=""></w2:column>
    				<w2:column width="70" style="" inputType="text" id="col5" value=""></w2:column>
    			</w2:row>
    		</w2:gBody>
    	</w2:gridView>
    </xf:group></body>
</html>
