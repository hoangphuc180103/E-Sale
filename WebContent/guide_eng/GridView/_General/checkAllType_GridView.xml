<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            	<w2:dataList baseNode="list" id="dataList1" repeatNode="map" saveRemovedData="true" style="">
            		<w2:columnInfo>
            			<w2:column dataType="text" id="col1" name="name1"></w2:column>
            			<w2:column dataType="text" id="col2" name="name2"></w2:column>
            			<w2:column dataType="text" id="col3" name="name3"></w2:column>
            			<w2:column dataType="text" id="col4" name="name4"></w2:column>
            			<w2:column dataType="text" id="col5" name="name5"></w2:column>
            		</w2:columnInfo>
            	</w2:dataList>
            	<w2:dataList baseNode="list" id="dataList2" repeatNode="map" saveRemovedData="true" style="">
            		<w2:columnInfo>
            			<w2:column dataType="text" id="col1" name="name1"></w2:column>
            			<w2:column dataType="text" id="col2" name="name2"></w2:column>
            			<w2:column dataType="text" id="col3" name="name3"></w2:column>
            			<w2:column dataType="text" id="col4" name="name4"></w2:column>
            			<w2:column dataType="text" id="col5" name="name5"></w2:column>
            		</w2:columnInfo>
            	</w2:dataList>
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
         <script type="text/javascript" lazy="false"><![CDATA[

scwin.onpageload = function () {
    for (var i = 0; i < 5; i++) {
        dataList1.insertRow();
        dataList2.insertRow();
    }
};

scwin.onpageunload = function () {

};

scwin.trigger2_onclick = function (e) {
    gridView1.setCellDisabled(1, 0, true);
    gridView1.setCellReadOnly(3, 0, true);
    gridView2.setCellDisabled(0, 0, true);
    gridView2.setCellReadOnly(1, 0, true);
};
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload" ev:onpageunload="scwin.onpageunload">
    <xf:group id="" style="margin: 10px;">
    	<w2:textbox tagname="h1" style="color: blue;margin-bottom: 10px;" tabIndex="h1" id="textbox1"
    		label="Set Handling Method for Disabled and ReadOnly Cells on Header Checkbox Selection&lt;br/&gt;" escape="false">
    	</w2:textbox>
    	<w2:textbox tagname="h2" style="height: 23px;margin-bottom: 10px;color: blue;" id="textbox2" label="How to Use"></w2:textbox>
    	<w2:textbox style="color: blue;margin-bottom: 30px;" id="textbox3"
    		label='1. Click the button below to disable or change some rows in the GridView to read-only.&lt;br/&gt;&lt;br/&gt;(First GridView)&lt;br/&gt;2-1. Click the checkbox in the header. (checkAllType=“include”)&lt;br/&gt;2-2. Confirm that the disabled or read-only rows are included in all cells, and the header checkbox appears to indicate only some cells are selected. &lt;br/&gt;&lt;br/&gt;(Second GridView)&lt;br/&gt;3-1. Click the header checkbox. (checkAllType=“exclude”)&lt;br/&gt;3-2. Confirm that the header checkbox indicates all cells are selected because disabled or read-only rows are not included in the entire cell.'
    		escape="false">
    	</w2:textbox>
    	<xf:trigger ev:onclick="scwin.trigger2_onclick"
    		style="height:42px;line-height:32px;padding:5px;background-color:coral;font-size:15px;weight: bolder;font-weight:bolder;text-align: left;display: block;margin-bottom: 10px;"
    		id="trigger2" type="button">
    		<xf:label><![CDATA[setCellDisabled() & setCellReadOnly()]]></xf:label>
    	</xf:trigger>
    	<w2:textbox id="textbox6" label="/// Sample Code&lt;br/&gt;&lt;br/&gt;gridView1.setCellDisabled(1, 0, true);&lt;br/&gt;gridView1.setCellReadOnly(3, 0, true);&lt;br/&gt;gridView2.setCellDisabled(0, 0, true);&lt;br/&gt;gridView2.setCellReadOnly(1, 0, true);" style="padding:10px; padding-bottom:20px; text-align:left; font-size:15px; font-weight:bolder; border:brown 1px solid; background-color:ivory; margin-bottom:10px; margin-top:10px; color:brown;" escape="false"></w2:textbox>
    	<w2:textbox
    		style="padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightblue;border:none;margin-bottom: 10px;"
    		id="textbox4" label='checkAllType="include"' escape="false">
    	</w2:textbox>
    	<w2:gridView scrollByColumnAdaptive="false" syncScroll="false" rowNumVisible="true" summaryAuto="false" useShiftKey="true"
    		scrollByColumn="false" summaryOnlyAuto="false" defaultCellHeight="20" applyAllColumnStyle="false" checkAllType="include"
    		checkOnCellClick="true" dataList="data:dataList1" dataDragSelect="true" ignoreCellClick="false"
    		style="border: solid 1px gray;margin-bottom: 10px;" id="gridView1" visibleRowNum="5" ignoreToggleOnDisabled="false"
    		visibleRowNumFix="true" autoFit="allColumn">
    		<w2:caption style="" id="caption1" value="this is a grid caption."></w2:caption>
    		<w2:header style="" id="header1">
    			<w2:row style="" id="row1">
    				<w2:column excelLabel="선택" width="70" inputType="checkbox" style="" id="column1" value="name1" blockSelect="false"
    					displayMode="label">
    				</w2:column>
    				<w2:column width="70" inputType="text" style="" id="column2" value="name2" blockSelect="false" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="" id="column3" value="name3" blockSelect="false" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="" id="column4" value="name4" blockSelect="false" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="" id="column5" value="name5" blockSelect="false" displayMode="label"></w2:column>
    			</w2:row>
    		</w2:header>
    		<w2:gBody style="" id="gBody1">
    			<w2:row style="" id="row2">
    				<w2:column falseValue="N" trueValue="Y" valueType="other" width="70" checkboxLabel="" inputType="checkbox" style=""
    					id="col1" checkAlways="false" value="" blockSelect="false" displayMode="label">
    				</w2:column>
    				<w2:column width="70" inputType="" style="" id="col2" value="" blockSelect="false" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="" id="col3" value="" blockSelect="false" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="" id="col4" value="" blockSelect="false" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="" id="col5" value="" blockSelect="false" displayMode="label"></w2:column>
    			</w2:row>
    		</w2:gBody>
    	</w2:gridView>
    	<w2:textbox escape="false" id="textbox5" label='checkAllType="exclude"'
    		style="padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightblue;border:none;margin-bottom: 10px;">
    	</w2:textbox>
    	<w2:gridView applyAllColumnStyle="false" autoFit="allColumn" checkAllType="exclude" checkOnCellClick="true" dataDragSelect="true"
    		dataList="data:dataList2" defaultCellHeight="20" id="gridView2" ignoreCellClick="false" ignoreToggleOnDisabled="false"
    		rowNumVisible="true" scrollByColumn="false" scrollByColumnAdaptive="false" style="border: solid 1px gray;visiblerow"
    		summaryAuto="false" summaryOnlyAuto="false" syncScroll="false" useShiftKey="true" visibleRowNum="5" visibleRowNumFix="true">
    		<w2:caption style="" id="caption1" value="this is a grid caption."></w2:caption>
    		<w2:header style="" id="header1">
    			<w2:row style="" id="row1">
    				<w2:column width="70" inputType="checkbox" style="" id="column20" value="name1" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="" id="column19" value="name2" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="" id="column18" value="name3" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="" id="column17" value="name4" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="" id="column16" value="name5" displayMode="label"></w2:column>
    			</w2:row>
    		</w2:header>
    		<w2:gBody style="" id="gBody1">
    			<w2:row style="" id="row2">
    				<w2:column width="70" inputType="checkbox" style="" id="col1" value="" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="" id="col2" value="" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="" id="col3" value="" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="" id="col4" value="" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="" id="col5" value="" displayMode="label"></w2:column>
    			</w2:row>
    		</w2:gBody>
    	</w2:gridView>
    </xf:group></body>
</html>
