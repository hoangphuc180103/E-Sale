    </head>
    <body ev:onpageload="scwin.onpageload" ev:onpageunload="scwin.onpageunload">
    <xf:group id="" style="margin: 10px;">
    	<w2:textbox tagname="h1" style="color: blue;margin-bottom: 10px;" tabIndex="h1" id="textbox1" label="Set Selection Item List Width&lt;br/&gt;"
    		escape="false">
    	</w2:textbox>
    	<w2:textbox tagname="h2" style="height: 23px;margin-bottom: 10px;color: blue;" id="textbox2" label="How to Use"></w2:textbox>
    	<w2:textbox style="color: blue;margin-bottom: 30px;" id="textbox3"
    		label="1. Expand the AutoComplete selection list.&lt;br/&gt;2. Confirm that the list width is determined by the number of columns displaying the selections." escape="false">
    	</w2:textbox>
    	<w2:textbox
    		style="padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightblue;border:none;margin-bottom: 20px;"
    		id="textbox4" label='submenuSize="auto"&lt;br/&gt;visibleColNum="3"' escape="false">
    	</w2:textbox>
    	<xf:checkcombobox displayAllOptionLabel="false" chooseOptionLabel="Choose airport(s)." submenuSize="auto" chooseOption="true"
    		allOption="true" displayMode="value delim label" ref="" appearance="minimal" delimiter=", "
    		style="width: 50%;display: block;margin-bottom: 10px;" disabled="auto" id="checkcombobox1" displaymessage="" visibleColNum="3">
    		<xf:choices>
    			<xf:itemset nodeset="data:dataList1">
    				<xf:label ref="Airport"></xf:label>
    				<xf:value ref="A_Code"></xf:value>
    			</xf:itemset>
    		</xf:choices>
    	</xf:checkcombobox>
    	<w2:textbox escape="false" id="textbox5" label='submenuSize="fixed"&lt;br/&gt;visibleColNum="3"'
    		style="padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightblue;border:none;margin-bottom: 20px;">
    	</w2:textbox>
    	<xf:checkcombobox allOption="true" appearance="minimal" chooseOption="true" chooseOptionLabel="Choose airport(s)." delimiter=", "
    		disabled="auto" displayAllOptionLabel="false" displayMode="value delim label" displaymessage="" id="checkcombobox2" ref=""
