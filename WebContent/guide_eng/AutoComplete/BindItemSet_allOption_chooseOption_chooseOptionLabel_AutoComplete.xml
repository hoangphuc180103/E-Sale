<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            	<w2:dataList baseNode="list" id="dataList1" repeatNode="map" saveRemovedData="true" style="">
            		<w2:columnInfo>
            			<w2:column dataType="text" id="City" name="name1"></w2:column>
            			<w2:column dataType="text" id="Code" name="name2"></w2:column>
            		</w2:columnInfo>
            		<w2:data use="true">
            			<w2:row>
            				<City><![CDATA[Seoul]]></City>
            				<Code><![CDATA[SE]]></Code>
            			</w2:row>
            			<w2:row>
            				<City><![CDATA[Paris]]></City>
            				<Code><![CDATA[PA]]></Code>
            			</w2:row>
            			<w2:row>
            				<City><![CDATA[London]]></City>
            				<Code><![CDATA[LN]]></Code>
            			</w2:row>
            			<w2:row>
            				<City><![CDATA[Beijing]]></City>
            				<Code><![CDATA[BJ]]></Code>
            			</w2:row>
            		</w2:data>
            	</w2:dataList>
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
         <script type="text/javascript" lazy="false"><![CDATA[
        
	scwin.onpageload = function() {
	};
	
	scwin.onpageunload = function() {
		
	};
	
	]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload" ev:onpageunload="scwin.onpageunload">
    <xf:group id="" style="margin: 10px;"><w2:textbox tagname="h1" style="color: blue;margin-bottom: 10px;" id="textbox1" label="Bind with DataList&lt;br/&gt;" escape="false"></w2:textbox><w2:textbox tagname="h2" style="height: 23px;margin-bottom: 10px;color: blue;" id="textbox2" label="How to Use"></w2:textbox><w2:textbox style="color: blue;margin-bottom: 30px;" id="textbox3" label='1. Hold down the Ctrl button and right-click the mouse.&lt;br/&gt;2. Select the “View dataCollection” menu.&lt;br/&gt;3. Verify the data in dataList1.&lt;br/&gt;4. Confirm that the AutoComplete selection matches the data in dataList1.' escape="false">
    	</w2:textbox>
    	<w2:autoComplete submenuSize="auto" search="contain" chooseOptionLabel="Choose one." ref="" chooseOption="true" editType="select"
    		useKeywordHighlight="true" style="width: 50%;display: block" id="autoComplete1" allOption="true" useLocale="false">
    		<w2:choices>
    			<w2:itemset nodeset="data:dataList1">
    				<w2:label ref="City"></w2:label>
    				<w2:value ref="Code"></w2:value>
    			</w2:itemset>
    		</w2:choices>
    	</w2:autoComplete></xf:group></body>
</html>
