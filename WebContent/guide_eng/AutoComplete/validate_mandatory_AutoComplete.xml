<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
         <script type="text/javascript" lazy="false"><![CDATA[
        
	scwin.onpageload = function() {
		
	};
	
	scwin.onpageunload = function() {
		
	};
	
	
	scwin.trigger1_onclick = function(e) {
		var result = autoComplete1.validate();
		alert(result);
	};
	]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload" ev:onpageunload="scwin.onpageunload">
    <xf:group id="" style="margin: 10px">
    	<w2:textbox tagname="h1" style="color: blue;margin-bottom: 10px;" id="textbox1" label="Validate Data Input&lt;br/&gt;" escape="false"></w2:textbox>
    	<w2:textbox tagname="h2" style="height: 23px;margin-bottom: 10px;color: blue;" id="textbox2" label="How to Use"></w2:textbox>
    	<w2:textbox style="color: blue;margin-bottom: 30px;" id="textbox3"
    		label='1. Click the validate() button without selecting anything from the AutoComplete dropdown list.&lt;br/&gt;2. Confirm that “false” is returned.&lt;br/&gt;3. Click any item in the AutoComplete dropdown list and then click the validate() button.&lt;br/&gt;4. Confirm that “true” is returned.'
    		escape="false">
    	</w2:textbox>
    	<w2:textbox style="padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightblue;border:none;margin-bottom: 10px;" id="textbox5" label='mandatory="true"' escape="false">
    	</w2:textbox>
    	<xf:trigger ev:onclick="scwin.trigger1_onclick"
    		style="display: block;height:42px;line-height:32px;padding:5px;background-color:coral;font-size:15px;weight: bolder;font-weight:bolder;margin-bottom:10px;text-align: left;"
    		id="trigger1" type="button">
    		<xf:label><![CDATA[autoComplete1.validate();]]></xf:label>
    	</xf:trigger>
    	<w2:autoComplete submenuSize="auto" search="start" chooseOptionLabel="Select a city" ref="" chooseOption="true" editType="select"
    		useKeywordHighlight="false" style="width: 50%;display: block;" id="autoComplete1" allOption="" mandatory="true">
    		<w2:choices>
    			<w2:item>
    				<w2:label><![CDATA[Hanoi]]></w2:label>
    				<w2:value><![CDATA[001]]></w2:value>
    			</w2:item>
    			<w2:item>
    				<w2:label><![CDATA[Danang]]></w2:label>
    				<w2:value><![CDATA[002]]></w2:value>
    			</w2:item>
    			<w2:item>
    				<w2:label><![CDATA[Taipei]]></w2:label>
    				<w2:value><![CDATA[003]]></w2:value>
    			</w2:item>
    			<w2:item>
    				<w2:label><![CDATA[Bangkok]]></w2:label>
    				<w2:value><![CDATA[004]]></w2:value>
    			</w2:item>
    		</w2:choices>
    	</w2:autoComplete>
    </xf:group></body>
</html>
