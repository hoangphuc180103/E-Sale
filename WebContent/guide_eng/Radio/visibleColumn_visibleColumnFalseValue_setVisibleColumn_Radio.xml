            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
         <script type="text/javascript" lazy="false"><![CDATA[
        
	scwin.onpageload = function() {
		
	};
	
	scwin.onpageunload = function() {
		
	};	

	scwin.trigger1_onclick = function(e) {
		radio1.setVisibleColumn("Type", "Domestic");
	};]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload" ev:onpageunload="scwin.onpageunload">
    <xf:group id="" style="margin: 10px;"><w2:textbox tagname="h1" style="color: blue;margin-bottom: 10px;" id="textbox1" label="Hide Some Selection Items&lt;br/&gt;" escape="false">
    		</w2:textbox><w2:textbox tagname="h2" style="height: 23px;margin-bottom: 10px;color: blue;" id="textbox2" label="How to Use"></w2:textbox><w2:textbox style="color: blue;margin-bottom: 30px;" id="textbox3" label="1. Hold down the Ctrl button and right-click the mouse.&lt;br/&gt;2. Confirm that dataList1 is bound to the Radio.&lt;br/&gt;3. Confirm that the data from dataList1 is displayed in the Radio's selection list.&lt;br/&gt;4. Click the setVisibleColumn() button next to the Radio.&lt;br/&gt;5. Confirm that the selection item where the Type column value is “Domestic” is not displayed in the selection list." escape="false">
    		</w2:textbox>
    	<xf:trigger ev:onclick="scwin.trigger1_onclick"
    		style="height:42px;line-height:32px;padding:5px;background-color:coral;font-size:15px;weight: bolder;font-weight:bolder;margin-top:30px;text-align: left;display: block;margin-bottom: 10px;"
    		id="trigger1" type="button">
    		<xf:label><![CDATA[radio1.setVisibleColumn("Type", "Domestic");]]></xf:label>
    	</xf:trigger>
    	<xf:select1 visibleColumn="" ref="" appearance="full" visibleColumnFalseValue="" style="padding: 10px;" id="radio1" rows="" cols="1"
    		selectedIndex="-1">
    		<xf:choices>
    			<xf:itemset nodeset="data:dataList1">
    				<xf:label ref="Name"></xf:label>
    				<xf:value ref="Value"></xf:value>
    			</xf:itemset>
    		</xf:choices>
    	</xf:select1></xf:group></body>
</html>
