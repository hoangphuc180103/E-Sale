<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
         <script type="text/javascript" lazy="false"><![CDATA[

scwin.onpageload = function () {

};

scwin.onpageunload = function () {

};

scwin.trigger1_onclick = function (e) {
	var count = input1.getValue();
	for (var i = 0; i < count; i++) {
		generator1.insertChild(i);
	}
};]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload" ev:onpageunload="scwin.onpageunload">
    	<xf:group id="" style="margin: 10px;">
    		<w2:textbox tagname="h1" style="color: blue;margin-bottom: 10px;" tabIndex="h1" id="textbox1" label="Dynamic Creation of Component Groups&lt;br/&gt;"
    			escape="false">
    		</w2:textbox>
    		<w2:textbox tagname="h2" style="height: 23px;margin-bottom: 10px;color: blue;" id="textbox2" label="How to Use"></w2:textbox>
    		<w2:textbox style="color: blue;margin-bottom: 30px;" id="textbox3"
    			label="1. Enter the number of component groups to create in the InputBox.&lt;br/&gt;2. Click the button at the bottom.&lt;br/&gt;3. Confirm that the specified number of component groups has been created.&lt;br/&gt;(See the Script tab for detailed script.)"
    			escape="false">
    		</w2:textbox>
    		<w2:textbox style="padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightblue;border:none;margin-bottom: 20px;" id="textbox5" label='“generator1” contains a component group.' escape="false">
    		</w2:textbox>
    		<xf:group style="" id="">
    			<xf:input adjustMaxLength="false" style="margin-bottom: 10px;color: red;font-size: 20px;width: 400px;" id="input1"
    				placeholder="Number of Component Groups to Create">
    			</xf:input>
    			<xf:trigger ev:onclick="scwin.trigger1_onclick"
    				style="height:42px;line-height:32px;padding:5px;background-color:coral;font-size:15px;font-weight:bolder;text-align: left;display: block;margin-bottom: 10px;width: 400px;"
    				id="trigger1" type="button">
    				<xf:label><![CDATA[generator1.insertChild()]]></xf:label>
    			</xf:trigger>
    			<w2:generator style="width: 300px;height: 100px;" id="generator1">
    				<xf:group style="padding-bottom: 10px;" id="">
    					<xf:input adjustMaxLength="false" style="width: 144px;height: 30px;" id="" placeholder="Enter your name."></xf:input>
    					<xf:trigger style="width: 80px;height: 30px;margin-left: 30px;background-color: lightpink;font-weight: block;" id=""
    						type="button">
    						<xf:label><![CDATA[Click]]></xf:label>
    					</xf:trigger>
    				</xf:group>
    			</w2:generator>
    		</xf:group>
    	</xf:group>
    </body>
</html>
