				</xf:group>
				<xf:group class="ck-footer-right" id="">
					<w2:textbox class="" id="txt_copyright" label="" tagname="span"/>
					<w2:textbox class="" id="" label="Phiên bản 1.0" tagname="span"/>
				</xf:group>
			</xf:group>
		</xf:group>
