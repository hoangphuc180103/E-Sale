define({declaration:{A:{version:'1.0',encoding:'UTF-8'}},E:[{T:1,N:'html',A:{xmlns:'http://www.w3.org/1999/xhtml','xmlns:ev':'http://www.w3.org/2001/xml-events','xmlns:w2':'http://www.inswave.com/websquare','xmlns:xf':'http://www.w3.org/2002/xforms'},E:[{T:1,N:'head',E:[{T:1,N:'w2:type',E:[{T:3,text:'COMPONENT'}]},{T:1,N:'w2:buildDate'},{T:1,N:'w2:MSA'},{T:1,N:'xf:model',E:[{T:1,N:'w2:dataCollection',A:{baseNode:'map'}},{T:1,N:'w2:workflowCollection'}]},{T:1,N:'w2:layoutInfo'},{T:1,N:'w2:publicInfo',A:{method:''}},{T:1,N:'script',A:{lazy:'false',type:'text/javascript'},E:[{T:4,cdata:function(scopeObj){with(scopeObj){scwin.onpageload = function () {
  const tmpSrc = scwin.getfolderPath() + "/source.xml";
  wframe1.setSrc(tmpSrc);
};
scwin.trigger1_onclick = function (e) {
  $p.reinitialize(true);
};
window.onbeforeunload = function () {
  console.log('Browser refreshed.');
};
scwin.trigger2_onclick = function (e) {
  $p.reinitialize();
};
scwin.getfolderPath = function () {
  var currentPath = window.location.href;
  var folderPath;
  if (currentPath.includes("mainContainer")) {
    console.log("true  ===> " + $p.getFrameId());
    const cmtFrame = $p.getComponentById($p.getFrameId());
    currentPath = cmtFrame.getSrc();
    folderPath = currentPath.substring(0, currentPath.lastIndexOf('/'));
  } else {
    console.log("false  ===> ");
    folderPath = currentPath.split('w2xPath=')[1].substring(0, currentPath.split('w2xPath=')[1].lastIndexOf('/'));
  }
  return folderPath;
};
}}}]}]},{T:1,N:'body',A:{'ev:onpageload':'scwin.onpageload'},E:[{T:1,N:'xf:group',A:{id:'',style:'margin: 10px;'},E:[{T:1,N:'w2:textbox',A:{tagname:'h1',style:'color: blue;margin-bottom: 10px;',id:'textbox1',label:'화면 재로딩 및 브라우저 새로 고침',escape:'false'}},{T:1,N:'w2:textbox',A:{tagname:'h2',style:'height: 23px;margin-bottom: 10px;color: blue;',id:'textbox2',label:'샘플 사용 방법'}},{T:1,N:'w2:textbox',A:{style:'color: blue;margin-bottom: 30px;',id:'textbox3',label:'1-1. 첫 번째와 두 번째 입력 상자에 모두 데이터를 입력.<br/>1-2. 첫 번째 $p.reinitialize(true); 버튼을 클릭. <br/>1-3. 브라우저가 새로 고침되어 두 입력 상자가 모두 초기화되는 것을 확인. <br/><br/>2-1. 첫 번째와 두 번째 입력 상자에 모두 데이터를 입력.<br/>2-2. 두 번째 $p.reinitialize(); 버튼을 클릭. <br/>2-3. 두 번째 버튼이 포함된 프레임만 재로딩되어, 해당 프레임 내부의 입력 상자만 초기화되는 것을 확인. ',escape:'false'}},{T:1,N:'xf:trigger',A:{'ev:onclick':'scwin.trigger1_onclick',style:'display: block;height:42px;line-height:32px;padding:5px;background-color:coral;font-size:15px;weight: bolder;font-weight:bolder;margin-bottom:10px;text-align: left;',id:'trigger1',type:'button'},E:[{T:1,N:'xf:label',E:[{T:4,cdata:'$p.reinitialize(true);'}]}]},{T:1,N:'xf:input',A:{adjustMaxLength:'false',style:'width:222px;height:42px;margin-top:20px;color: blue;font-size:20px;font-style:normal;font-weight:bolder;display:block;border: coral solid 2px;',id:'input1',placeholder:'(1) Enter data.'}},{T:1,N:'w2:wframe',A:{src:'source.xml',style:'width: 400px;height: 300px;border: orange solid 2px;margin-top: 20px;',id:'wframe1'}}]}]}]}]})