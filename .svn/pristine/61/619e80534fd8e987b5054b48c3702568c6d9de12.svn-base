  var objSubmission = $p.getSubmission("submission1");
  objSubmission.action = scwin.getfolderPath() + '/data.json';
  $p.executeSubmission("submission1");
};
scwin.onpageunload = function () {};
scwin.dataList1_onbeforecelldatachange = function (info) {
  if (info.colID == "Hobby") {
    if (info.newValue == "Work" || info.newValue == "work") {
      alert("onbeforecelldatachange - Enter another hobby.");
      return false;
    }
  } else {
    alert("Changed.");
    return true;
  }
};
scwin.getfolderPath = function () {
  var currentPath = window.location.href;
  var folderPath;
  if (currentPath.includes("mainContainer")) {
    console.log("true  ===> " + $p.getFrameId());
    const cmtFrame = $p.getComponentById($p.getFrameId());
    currentPath = cmtFrame.getSrc();
    folderPath = currentPath.substring(0, currentPath.lastIndexOf('/'));
  } else {
    console.log("false  ===> ");
    folderPath = currentPath.split('w2xPath=')[1].substring(0, currentPath.split('w2xPath=')[1].lastIndexOf('/'));
  }
  return folderPath;
};
}}}]}]},{T:1,N:'body',A:{'ev:onpageload':'scwin.onpageload','ev:onpageunload':'scwin.onpageunload'},E:[{T:1,N:'xf:group',A:{id:'',style:'margin: 10px;'},E:[{T:1,N:'w2:textbox',A:{tagname:'h1',style:'color: blue;margin-bottom: 10px;',tabIndex:'h1',id:'textbox2',label:'이벤트 - onbeforecelldatachange',escape:'false'}},{T:1,N:'w2:textbox',A:{tagname:'h2',style:'height: 23px;margin-bottom: 10px;color: blue;',id:'textbox3',label:'샘플 사용 방법'}},{T:1,N:'w2:textbox',A:{style:'color: blue;margin-bottom: 30px;',id:'textbox4',label:'1. 셀 값을 변경하고, Enter 키를 누르거나 다른 셀을 마우스로 클릭. <br/>2. 확인 메시지가 표시되고 셀 값이 변경도는 것을 확인. <br/>3. 단, Hobby 컬럼의 값을 "Work" 혹은 "work"로 변경할 수 없는 것을 확인. (onbeforecelldatachange 이벤트 핸들러 함수가 false를 반환하기 때문.)<br/>(이벤트 핸들러의 자세한 스크립트는 Script 탭에서 확인.)',escape:'false'}},{T:1,N:'w2:textbox',A:{style:'padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightgreen;border:none;margin-bottom: 10px;',id:'textbox5',label:'이벤트 설명<br/>onbeforecelldatachange - 셀 데이터 변경 직전에 발생.',escape:'false'}},{T:1,N:'w2:gridView',A:{scrollByColumnAdaptive:'false',rowNumVisible:'true',visibleRowNumFix:'true',checkAllType:'false',dataList:'data:dataList1',style:'border: solid 1px gray',scrollByColumn:'false',id:'gridView1',visibleRowNum:'10',autoFit:'allColumn',defaultCellHeight:'20'},E:[{T:1,N:'w2:header',A:{style:'',id:'header1'},E:[{T:1,N:'w2:row',A:{style:'',id:'row1'},E:[{T:1,N:'w2:column',A:{width:'70',inputType:'text',style:'height:20px',id:'column9',value:'ID',displayMode:'label'}},{T:1,N:'w2:column',A:{width:'70',inputType:'text',style:'height:20px',id:'column8',value:'Age',displayMode:'label'}},{T:1,N:'w2:column',A:{width:'70',inputType:'text',style:'height:20px',id:'column7',value:'Region',displayMode:'label'}},{T:1,N:'w2:column',A:{width:'70',inputType:'text',style:'height:20px',id:'column6',value:'Hobby',displayMode:'label'}},{T:1,N:'w2:column',A:{width:'70',inputType:'text',style:'height:20px',id:'column3',value:'Frequency',displayMode:'label'}},{T:1,N:'w2:c