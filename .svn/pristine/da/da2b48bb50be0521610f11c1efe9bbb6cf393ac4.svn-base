<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
        	<xf:instance>
        		<data xmlns="" />
        	</xf:instance>
        	<w2:dataCollection baseNode="map">
        		<w2:dataList baseNode="list" id="dataList1" repeatNode="map" saveRemovedData="true" style="">
        			<w2:columnInfo>
        				<w2:column dataType="text" id="col1" name="Continent"></w2:column>
        				<w2:column dataType="text" id="col2" name="Country"></w2:column>
        				<w2:column dataType="text" id="col3" name="Item"></w2:column>
        				<w2:column dataType="text" id="col4" name="Quantity"></w2:column>
        			</w2:columnInfo>
        		</w2:dataList>
        		<w2:dataList baseNode="list" repeatNode="map" id="dataList2" saveRemovedData="true">
        			<w2:columnInfo>
        				<w2:column id="col1" name="Continent" dataType="text"></w2:column>
        				<w2:column id="col2" name="Country" dataType="text"></w2:column>
        				<w2:column id="col3" name="Item" dataType="text"></w2:column>
        				<w2:column id="col4" name="Quantity" dataType="text"></w2:column>
        			</w2:columnInfo>
        		</w2:dataList>
        	</w2:dataCollection>
        	<w2:workflowCollection></w2:workflowCollection>
        </xf:model>
        <script type="text/javascript" lazy="false"><![CDATA[
        
	scwin.onpageload = function() {
		var json = [
			{"col1" : "Asia", "col2" : "Korea", "col3" : "TV", "col4" : "400"},
			{"col1" : "Asia", "col2" : "Korea", "col3" : "Freezer", "col4" : "300"},
			{"col1" : "Asia", "col2" : "Korea", "col3" : "Washer", "col4" : "100"},
			{"col1" : "Asia", "col2" : "Korea", "col3" : "Heater", "col4" : "250"},
			{"col1" : "Asia", "col2" : "China", "col3" : "TV", "col4" : "400"},
			{"col1" : "Asia", "col2" : "China", "col3" : "Freezer", "col4" : "300"},
			{"col1" : "Asia", "col2" : "China", "col3" : "Washer", "col4" : "100"},
			{"col1" : "Asia", "col2" : "Japan", "col3" : "TV", "col4" : "100"},
			{"col1" : "Asia", "col2" : "Japan", "col3" : "Freezer", "col4" : "300"},
			{"col1" : "Asia", "col2" : "Japan", "col3" : "Washer", "col4" : "200"},
			{"col1" : "Europe", "col2" : "Germany", "col3" : "TV", "col4" : "100"},
			{"col1" : "Europe", "col2" : "Germany", "col3" : "Freezer", "col4" : "300"},
			{"col1" : "Europe", "col2" : "Germany", "col3" : "Washer", "col4" : "200"},
			{"col1" : "Europe", "col2" : "France", "col3" : "TV", "col4" : "100"},
			{"col1" : "Europe", "col2" : "France", "col3" : "Freezer", "col4" : "300"},
			{"col1" : "Europe", "col2" : "France", "col3" : "Washer", "col4" : "200"},
			{"col1" : "Europe", "col2" : "Denmark", "col3" : "TV", "col4" : "100"},
			{"col1" : "Europe", "col2" : "Denmark", "col3" : "Freezer", "col4" : "300"},
			{"col1" : "Europe", "col2" : "Denmark", "col3" : "Washer", "col4" : "200"},
			{"col1" : "North and South Americas", "col2" : "Canada", "col3" : "TV", "col4" : "100"},
			{"col1" : "North and South Americas", "col2" : "Canada", "col3" : "Freezer", "col4" : "300"},
			{"col1" : "North and South Americas", "col2" : "Canada", "col3" : "Washer", "col4" : "200"},
			{"col1" : "North and South Americas", "col2" : "USA", "col3" : "TV", "col4" : "100"},
			{"col1" : "North and South Americas", "col2" : "USA", "col3" : "Freezer", "col4" : "300"},
			{"col1" : "North and South Americas", "col2" : "USA", "col3" : "Washer", "col4" : "200"},
			{"col1" : "North and South Americas", "col2" : "Mexico", "col3" : "TV", "col4" : "100"},
			{"col1" : "North and South Americas", "col2" : "Mexico", "col3" : "Freezer", "col4" : "300"},
			{"col1" : "North and South Americas", "col2" : "Mexico", "col3" : "Washer", "col4" : "200"}
			];
		dataList1.setJSON(json);
		
		dataList2.setJSON(json);
	};
	
	scwin.onpageunload = function() {
		
	};
	
	
scwin.trigger1_onclick = function(e) {
gridView1.setRowStatusVisible(false);
};

scwin.trigger2_onclick = function(e) {
gridView1.setRowStatusVisible(true);
};
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload" ev:onpageunload="scwin.onpageunload">
    	<xf:group id="" style="margin: 10px;">
    		<w2:textbox tagname="h1" style="color: blue;margin-bottom: 10px;" tabIndex="h1" id="textbox1" label="条件付き合計表示"
    			escape="false">
    		</w2:textbox>
    		<w2:textbox tagname="h2" style="height: 23px;margin-bottom: 10px;color: blue;" id="textbox2" label="サンプルの使い方"></w2:textbox>
    		<w2:textbox style="color: blue;margin-bottom: 30px;" id="textbox3"
    			label='1. 最初の GridView の場合、「col3」(Item) 列が Freezer である項目の合計を表示することを確認します。 &lt;br/&gt;2. 2番目のGridViewの場合、「col3」(Item)列がテレビで「col1」(Content)列がAsiaの項目の合計を表示することを確認してください。 &lt;br/&gt;（ヘッダー上部のフィルタを使用して簡単に確認できます。）'
    			escape="false">
    		</w2:textbox>
    		<w2:textbox
    			style="padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightblue;border:none;margin-bottom: 10px;"
    			id="textbox4" label="sumif('col4', 'Freezer', 'col3') &amp;nbsp;&lt;br/&gt;&quot;col3&quot;列の値が&quot;Freezer&quot;の場合の、&quot;col4&quot;値の合計を求めます。" escape="false">
    		</w2:textbox>
    		<w2:gridView rowNumVisible="true" scrollByColumn="false" defaultCellHeight="20" selectedCellColor="lightgreen" focusMode="none"
    			dataDragSelect="" id="gridView1" autoFit="allColumn" cellStatusVisible="true" scrollByColumnAdaptive="false" hammerEnabled="true"
    			dataDragDrop="true" selectedRowColor="pink" useShiftKey="true" useCtrlOnMultisort="" dataDragDropStatus="true" focusFlow="linear"
    			contextMenu="true" visibleRowNumFix="true" dataList="data:dataList1" style="border: solid gray 1px;margin-bottom: 10px;"
    			cellStatusIconPosition="left" visibleRowNum="5" useFilterList="true" useCtrlKey="">
    			<w2:caption style="" id="caption2" value="this is a grid caption."></w2:caption>
    			<w2:header style="" id="header2">
    				<w2:row style="" id="row3">
    					<w2:column width="70" inputType="text" style="" id="column11" value="Continent" displayMode="label"></w2:column>
    					<w2:column width="70" inputType="text" style="" id="column10" value="Country" displayMode="label"></w2:column>
    					<w2:column width="70" inputType="text" style="" id="column9" value="Item" displayMode="label" useFilter="true">
    					</w2:column>
    					<w2:column width="70" inputType="text" style="" id="column8" value="Quantity" displayMode="label"></w2:column>
    				</w2:row>
    			</w2:header>
    			<w2:gBody style="" id="gBody2">
    				<w2:row style="" id="row4">
    					<w2:column width="70" inputType="" style="" id="col1" value="" displayMode="label"></w2:column>
    					<w2:column width="70" inputType="text" style="" id="col2" value="" displayMode="label"></w2:column>
    					<w2:column width="70" inputType="text" style="" id="col3" value="" displayMode="label"></w2:column>
    					<w2:column width="70" inputType="text" style="" id="col4" value="" displayMode="label"></w2:column>
    				</w2:row>
    			</w2:gBody>
    			<w2:footer style="" id="footer1">
    				<w2:row style="" id="row5">
    					<w2:column rowSpan="" colSpan="3" width="210" inputType="text" style="" id="column15"
    						value="sumif('col4', 'Freezer', 'col3')" displayMode="label">
    					</w2:column>
    					<w2:column expression="sumif('col4', 'Freezer', 'col3')" width="70" inputType="expression" style="" id="column12"
    						value="" displayMode="label">
    					</w2:column>
    				</w2:row>
    			</w2:footer>
    		</w2:gridView>
    		<w2:textbox style="padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightblue;border:none;margin-bottom: 10px;" id="textbox6" label="sumifs('col4', 'TV', 'col3', 'Asia', 'col1') &lt;br/&gt;&quot;col3&quot;列の値が&quot;TV&quot;で、&quot;col1&quot;の値が&quot;Asia&quot;の場合の、&quot;col4&quot;値の合計を求めます。" escape="false">
    		</w2:textbox>
    		<w2:gridView rowNumVisible="true" scrollByColumn="false" defaultCellHeight="20" focusMode="none" selectedCellColor="lightgreen"
    			dataDragSelect="" autoFit="allColumn" id="gridView2" cellStatusVisible="true" scrollByColumnAdaptive="false" hammerEnabled="true"
    			dataDragDrop="true" selectedRowColor="pink" useCtrlOnMultisort="" useShiftKey="true" dataDragDropStatus="true" focusFlow="linear"
    			contextMenu="true" visibleRowNumFix="true" dataList="data:dataList2" cellStatusIconPosition="left" style="border: solid gray 1px;"
    			useFilterList="true" visibleRowNum="5" useCtrlKey="">
    			<w2:caption style="" id="caption2" value="this is a grid caption."></w2:caption>
    			<w2:header style="" id="header2">
    				<w2:row style="" id="row3">
    					<w2:column width="70" inputType="text" style="" id="column11" value="Continent" displayMode="label"
    						useFilter="true">
    					</w2:column>
    					<w2:column width="70" inputType="text" style="" id="column10" value="Country" displayMode="label"
    						useFilter="false">
    					</w2:column>
    					<w2:column width="70" inputType="text" style="" id="column9" value="Item" displayMode="label" useFilter="true">
    					</w2:column>
    					<w2:column width="70" inputType="text" style="" id="column8" value="Quantity" displayMode="label"></w2:column>
    				</w2:row>
    			</w2:header>
    			<w2:gBody style="" id="gBody2">
    				<w2:row style="" id="row4">
    					<w2:column width="70" inputType="" style="" id="col1" value="" displayMode="label"></w2:column>
    					<w2:column width="70" inputType="text" style="" id="col2" value="" displayMode="label"></w2:column>
    					<w2:column width="70" inputType="text" style="" id="col3" value="" displayMode="label"></w2:column>
    					<w2:column width="70" inputType="text" style="" id="col4" value="" displayMode="label"></w2:column>
    				</w2:row>
    			</w2:gBody>
    			<w2:footer style="" id="footer1">
    				<w2:row style="" id="row5">
    					<w2:column rowSpan="" colSpan="3" width="210" inputType="text" style="" id="column15"
    						value="sumifs('col4', 'TV', 'col3', 'Asia', 'col1')" displayMode="label">
    					</w2:column>
    					<w2:column expression="sumifs('col4', 'TV', 'col3', 'Asia', 'col1')" width="70" inputType="expression" style=""
    						id="column12" value="" displayMode="label">
    					</w2:column>
    				</w2:row>
    			</w2:footer>
    		</w2:gridView>
    	</xf:group>
    </body>
</html>
