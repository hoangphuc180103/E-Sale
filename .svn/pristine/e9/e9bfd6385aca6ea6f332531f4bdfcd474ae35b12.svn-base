  $p.executeSubmission("sbm_init");
};
scwin.sbm_init_submitdone = function (e) {
  scwin.init_refList("ref_site");
  scwin.init_refList("ref_site_web");
};
scwin.init_refList = function (argStrType) {
  var arrList, arrListLen, i, curObj, curRowData;
  var _cmpGen;
  var strID_dt, strID_dd, strID_li;
  var isError = false;
  switch (argStrType) {
    case "ref_site":
      _cmpGen = gen_ref_site;
      strID_dt = "btn_gen_ref_site_dt";
      strID_dd = "tbx_gen_ref_site_dd";
      strID_li = "grp_gen_ref_site_li";
      arrList = dlt_site.getAllJSON();
      break;
    case "ref_site_web":
      _cmpGen = gen_ref_site_web;
      strID_dt = "btn_gen_ref_site_web_dt";
      strID_dd = "tbx_gen_ref_site_web_dd";
      strID_li = "grp_gen_ref_site_web_li";
      arrList = dlt_site_webDev.getAllJSON();
      break;
    default:
      isError = true;
  }
  if (isError === true) {
    return;
  }
  arrListLen = arrList.length;
  for (i = 0; i < arrListLen; i++) {
    curRowData = arrList[i];
    _cmpGen.insertChild(i);
    curObj = _cmpGen.getChild(i, strID_li);
    if (curRowData.li_class) {
      curObj.addClass(curRowData.li_class);
    } else {
      curObj.addClass("type05");
    }
    curObj = _cmpGen.getChild(i, strID_dt);
    curObj.setValue(curRowData.disp);
    if (curRowData.url.indexOf("http") > -1) {
      curObj.setHref(curRowData.url);
    } else {
      curObj.setHref("?w2xPath=" + curRowData.url);
    }
    curObj = _cmpGen.getChild(i, strID_dd);
    curObj.setValue(curRowData.desc);
  }
};
}}}]}]},{T:1,N:'body',A:{'ev:onpageload':'scwin.onpageload'},E:[{T:1,N:'xf:group',A:{class:'sub_contents exam_subbox',id:'',style:''},E:[{T:1,N:'xf:group',A:{class:'ws_example_grp_desc',style:''},E:[{T:1,N:'w2:textbox',A:{escape:'false',label:'온라인으로 제공하는 웹스퀘어 개발을 위한 참고 사이트 목록입니다.',style:''}}]},{T:1,N:'xf:group',A:{class:'p_refsite',id:'',style:''},E:[{T:1,N:'xf:group',A:{class:'site_grp',id:'',style:''},E:[{T:1,N:'xf:group',A:{class:'sitebox',id:'',style:''},E:[{T:1,N:'w2:textbox',A:{class:'intro_ref_title',escape:'false',id:'',label:'웹스퀘어 참고 사이트',style:''}},{T:1,N:'w2:generator',A:{class:'',id:'gen_ref_site',style:'',tagname:'ul'},E:[{T:1,N:'xf:group',A:{class:'',id:'grp_gen_ref_site_li',style:'',tagname:'li'},E:[{T:1,N:'xf:group',A:{id:''},E:[{T:1,N:'w2:anchor',A:{class:'',id:'btn_gen_ref_site_dt',outerDiv:'false',style:'min-height:12px;',target:'_blank'},E:[{T:1,N:'xf:label'}]},{T:1,N:'w2:textbox',A:{class:'',escape:'false',id:'tbx_gen_ref_site_dd',style:'min-height:12px;'}}]}]}]}]},{T:1,N:'xf:group',A:{class:'sitebox',id:'',style:''},E:[{T:1,N:'w2:textbox',A:{class:'intro_ref_title',escape:'false',id:'',label:'웹 개발 참고 사이트',style:''}},{T:1,N:'w2:generator',A:{class:'',id:'gen_ref_site_web',style:'',tagname:'ul'},E:[{T:1,N:'xf:group',A:{class:'',id:'grp_gen_ref_site_web_li',style:'',tagname:'li'},E:[{T:1,N:'xf:group',A:{id:''},E:[{T:1,N:'w2:anchor',A:{class:'',id:'btn_gen_ref_site_web_dt',outerDiv:'false',style:'min-height:12px;',target:'_blank'},E:[{T:1,N:'xf:label'}]},{T:1,N:'w2:textbox',A:{class:'',escape:'false',id:'tbx_gen_ref_site_web_dd',style:'min-height: 12px;'}}]}]}]}]}]}]}]}]}]}]})