  // var jsnParamData = $p.getParameter("exam_param");
 
  return true ; //팝업 닫기 (반환 값이 true인 경우만 팝업이 닫힘)
};

scwin.btn_broPop_onclick = function (e) {
// 팝업 화면에 데이터를 전달 (dataObject를 통해 전달 가능)
 
