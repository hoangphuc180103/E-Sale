<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head meta_screenName="[심화 교육 예제] Popup 실습">
        <w2:type>COMPONENT</w2:type>
        <w2:buildDate/>
        <w2:MSA/>
        <xf:model>
            <w2:dataCollection baseNode="map">
            	<w2:dataList baseNode="list" ev:ondataload="scwin.dc_userInfoList_ondataload"
            		ev:oninsertrow="scwin.dc_userInfoList_oninsertrow" ev:onremoverow="scwin.dc_userInfoList_onremoverow" id="dc_userInfoList"
            		repeatNode="map" saveRemovedData="true" style="">
            		<w2:columnInfo>
            			<w2:column dataType="text" id="EMP_CD" name="사번"></w2:column>
            			<w2:column dataType="text" id="EMP_NM" name="이름"></w2:column>
            			<w2:column dataType="text" id="EMAIL" name="이메일"></w2:column>
            			<w2:column dataType="text" id="ADDRESS1" name="주소1"></w2:column>
            		</w2:columnInfo>
            		<w2:data use="true">
            			<w2:row>
            				<EMP_CD><![CDATA[10000001]]></EMP_CD>
            				<EMP_NM><![CDATA[김길동]]></EMP_NM>
            				<EMAIL><![CDATA[aaa@inswav.com]]></EMAIL>
            			</w2:row>
            			<w2:row>
            				<EMP_CD><![CDATA[10000002]]></EMP_CD>
            				<EMP_NM><![CDATA[이길동]]></EMP_NM>
            				<EMAIL><![CDATA[aaa@inswav.com]]></EMAIL>
            			</w2:row>
            			<w2:row>
            				<EMP_CD><![CDATA[10000003]]></EMP_CD>
            				<EMP_NM><![CDATA[박길동]]></EMP_NM>
            				<EMAIL><![CDATA[aaa@inswav.com]]></EMAIL>
            			</w2:row>
            			<w2:row>
            				<EMP_CD><![CDATA[10000004]]></EMP_CD>
            				<EMP_NM><![CDATA[강길동]]></EMP_NM>
            				<EMAIL><![CDATA[aaa@inswav.com]]></EMAIL>
            			</w2:row>
            			<w2:row>
            				<EMP_CD><![CDATA[10000005]]></EMP_CD>
            				<EMP_NM><![CDATA[홍길동]]></EMP_NM>
            				<EMAIL><![CDATA[aaa@inswav.com]]></EMAIL>
            			</w2:row>
            		</w2:data>
            	</w2:dataList>
            </w2:dataCollection>
            <w2:workflowCollection/>
        </xf:model>
        <w2:layoutInfo/>
        <w2:publicInfo method=""/>
        <script lazy="false" type="text/javascript"><![CDATA[
scwin.onpageload = function() {
	ui_float.hide();
};
 
//Layer popup 
