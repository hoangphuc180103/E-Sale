scwin.btn_ex1_onclick = function (e) {
  var jsonObj = {
    "no": "2",
    "name": "WebSquare"
  };
  var jsonStrWithTab = JSON.stringify(jsonObj, null, "\t");

  //웹스퀘어 API를 사용하여 로그 출력
  $p.log("===========$p.log===========");
  $p.log(jsonObj);
  $p.log(jsonObj.name);
  $p.log(jsonStrWithTab);
  $p.log("========================");

  //로그 출력
  $c.frame.printExampleLog($p, "** [실행1] scwin.btn_ex1_onclick 실행 **", txa_log, false);
  $c.frame.printExampleLog($p, "브라우저에서 [ctrl]키를 누른채 [마우스 오른쪽 버튼]을 클릭한 뒤 [로그보기]를 클릭합니다.", txa_log, false);
};

/**
