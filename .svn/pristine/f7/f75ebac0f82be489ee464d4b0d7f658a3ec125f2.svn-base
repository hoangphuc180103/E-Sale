<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
        <w2:type>DEFAULT</w2:type>
        <w2:buildDate />
        <xf:model>
            <xf:instance>
                <data xmlns="" />
            </xf:instance>
            <w2:dataCollection baseNode="map">
                <w2:dataList id="dataList1" baseNode="list" style=""
                    saveRemovedData="true" repeatNode="map">
                    <w2:columnInfo>
                        <w2:column id="title" name="title" dataType="text">
                        </w2:column>
                        <w2:column id="start" name="start" dataType="text">
                        </w2:column>
                        <w2:column id="end" name="end" dataType="text">
                        </w2:column>
                    </w2:columnInfo>
                    <w2:data use="false">
                    </w2:data>
                </w2:dataList>
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
        <script type="javascript" lazy="false"><![CDATA[
scwin.onpageload = function () {
    var dateStr = WebSquare.date.getCurrentServerDate("yyyyMMdd");
    var addDate = WebSquare.date.dateAdd(dateStr, 3);
    var tmpArr = [{ "title": "My Schedule", "start": dateStr, "end": addDate }];
    dataList1.setJSON(tmpArr);
};
scwin.trigger1_onclick = function (e) {
    schedule1.setHeaderBtn({ "headerRightBtn": false, "headerLeftBtn": false, "headerTitle": true });
};

scwin.trigger2_onclick = function (e) {
    schedule1.setHeaderBtn({ "headerRightBtn": false, "headerLeftBtn": true, "headerTitle": false });
};

scwin.trigger3_onclick = function (e) {
    schedule1.setHeaderBtn({ "headerRightBtn": true, "headerLeftBtn": false, "headerTitle": false });
};
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload">
    <xf:group id="" style="margin:10px;">
    	<w2:textbox tagname="h1" style="color: blue;margin-bottom: 10px;" tabIndex="h1" id="textbox1" label="Select Buttons to Display in Header Toolbar&lt;br/&gt;"
    		escape="false">
    	</w2:textbox>
    	<w2:textbox tagname="h2" style="height: 23px;margin-bottom: 10px;color: blue;" id="textbox2" label="How to Use"></w2:textbox>
    	<w2:textbox style="color: blue;margin-bottom: 30px;" id="textbox3"
    		label='1. Check the buttons currently displayed at the top of ScheduleCalendar. (All buttons are displayed by default.)&lt;br/&gt;2. Click each button at the bottom.&lt;br/&gt;3. Confirm that only the header title, left button, or right button is displayed based on the option settings.&lt;br/&gt;(Detailed script available in the Script tab.)'
    		escape="false">
    	</w2:textbox>
    	<w2:textbox style="padding:10px; padding-bottom:20px; text-align:left; font-size:15px; font-weight:bolder; border:brown 1px solid; background-color:ivory; margin-bottom:10px; margin-top:10px; color:brown;" id="textbox4" label='/// Sample Code&lt;br/&gt;&lt;br/&gt;scwin.trigger1_onclick = function(e) {&lt;br/&gt; &amp;nbsp; &amp;nbsp;schedule1.setHeaderBtn({&lt;br/&gt; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;"headerRightBtn": false,&lt;br/&gt; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;"headerLeftBtn": false,&lt;br/&gt; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;"headerTitle": true&lt;br/&gt; &amp;nbsp; &amp;nbsp;});&lt;br/&gt;};&lt;br/&gt;&lt;br/&gt;scwin.trigger2_onclick = function(e) {&lt;br/&gt; &amp;nbsp; &amp;nbsp;schedule1.setHeaderBtn({&lt;br/&gt; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;"headerRightBtn": false,&lt;br/&gt; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;"headerLeftBtn": true,&lt;br/&gt; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;"headerTitle": false&lt;br/&gt; &amp;nbsp; &amp;nbsp;});&lt;br/&gt;};&lt;br/&gt;&lt;br/&gt;scwin.trigger3_onclick = function(e) {&lt;br/&gt; &amp;nbsp; &amp;nbsp;schedule1.setHeaderBtn({&lt;br/&gt; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;"headerRightBtn": true,&lt;br/&gt; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;"headerLeftBtn": false,&lt;br/&gt; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;"headerTitle": false&lt;br/&gt; &amp;nbsp; &amp;nbsp;});&lt;br/&gt;};' escape="false">
    	</w2:textbox>
    	<xf:trigger ev:onclick="scwin.trigger1_onclick"
    		style="height:42px;line-height:32px;padding:5px;background-color:coral;font-size:15px;weight: bolder;font-weight:bolder;text-align: left;display: block;margin-bottom: 10px;"
    		id="trigger1" type="button">
    		<xf:label><![CDATA[setHeaderBtn() - "headerTitle": true]]></xf:label>
    	</xf:trigger>
    	<xf:trigger type="button" id="trigger2"
    		style="height:42px;line-height:32px;padding:5px;background-color:coral;font-size:15px;weight: bolder;font-weight:bolder;text-align: left;display: block;margin-bottom: 10px;"
    		ev:onclick="scwin.trigger2_onclick">
    		<xf:label><![CDATA[setHeaderBtn() - "headerLeftBtn": true]]></xf:label>
    	</xf:trigger>
    	<xf:trigger type="button" id="trigger3"
    		style="height:42px;line-height:32px;padding:5px;background-color:coral;font-size:15px;weight: bolder;font-weight:bolder;text-align: left;display: block;margin-bottom: 10px;"
    		ev:onclick="scwin.trigger3_onclick">
    		<xf:label><![CDATA[setHeaderBtn() - "headerRightBtn": true]]></xf:label>
    	</xf:trigger>
    	<w2:scheduleCalendar defaultDate="" endColumn="end" editable="false" selectable="true" headerRightBtn="false"
    		useHeaderToolbar="true" version="6.1.11" titleColumn="title" startColumn="start" dataList="dataList1"
    		style="width: 400px;height: 500px;" eventLimit="false" id="schedule1" headerLeftBtn="true" lang="" headerTitle="true">
    	</w2:scheduleCalendar>
    </xf:group></body>
</html>
