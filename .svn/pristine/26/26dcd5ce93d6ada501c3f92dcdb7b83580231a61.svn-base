<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            	<w2:dataList baseNode="list" id="dataList1" repeatNode="map" saveRemovedData="true" style="">
            		<w2:columnInfo>
            			<w2:column dataType="text" id="select" name="select"></w2:column>
            			<w2:column dataType="text" id="autoComplete" name="autoComplete"></w2:column>
            			<w2:column dataType="text" id="checkcombobox" name="checkcombobox"></w2:column>
            		</w2:columnInfo>
            		<w2:data use="false"></w2:data>
            	</w2:dataList>
            	<w2:dataList baseNode="list" id="select" repeatNode="map" saveRemovedData="true" style="">
            		<w2:columnInfo>
            			<w2:column dataType="text" id="label" name="name2"></w2:column>
            			<w2:column dataType="text" id="value" name="name2"></w2:column>
            		</w2:columnInfo>
            		<w2:data use="true">
            			<w2:row>
            				<label><![CDATA[Bangkok]]></label>
            				<value><![CDATA[100]]></value>
            			</w2:row>
            			<w2:row>
            				<label><![CDATA[Ottawa]]></label>
            				<value><![CDATA[200]]></value>
            			</w2:row>
            			<w2:row>
            				<label><![CDATA[Kenya]]></label>
            				<value><![CDATA[300]]></value>
            			</w2:row>
            			<w2:row>
            				<label><![CDATA[Dubai]]></label>
            				<value><![CDATA[400]]></value>
            			</w2:row>
            			<w2:row>
            				<label><![CDATA[Paris]]></label>
            				<value><![CDATA[500]]></value>
            			</w2:row>
            		</w2:data>
            	</w2:dataList>
            	<w2:dataList baseNode="list" id="autoComplete" repeatNode="map" saveRemovedData="true" style="">
            		<w2:columnInfo>
            			<w2:column dataType="text" id="label" name="name1"></w2:column>
            			<w2:column dataType="text" id="value" name="name2"></w2:column>
            		</w2:columnInfo>
            		<w2:data use="true">
            			<w2:row>
            				<value><![CDATA[100]]></value>
            				<label><![CDATA[TH]]></label>
            			</w2:row>
            			<w2:row>
            				<value><![CDATA[200]]></value>
            				<label><![CDATA[CA]]></label>
            			</w2:row>
            			<w2:row>
            				<value><![CDATA[300]]></value>
            				<label><![CDATA[KN]]></label>
            			</w2:row>
            			<w2:row>
            				<value><![CDATA[400]]></value>
            				<label><![CDATA[DB]]></label>
            			</w2:row>
            			<w2:row>
            				<value><![CDATA[500]]></value>
            				<label><![CDATA[FR]]></label>
            			</w2:row>
            		</w2:data>
            	</w2:dataList>
            	<w2:dataList baseNode="list" id="checkcombobox" repeatNode="map" saveRemovedData="true" style="">
            		<w2:columnInfo>
            			<w2:column dataType="text" id="label" name="name1"></w2:column>
            			<w2:column dataType="text" id="value" name="name2"></w2:column>
            		</w2:columnInfo>
            		<w2:data use="true">
            			<w2:row>
            				<value><![CDATA[100]]></value>
            				<label><![CDATA[Asia]]></label>
            			</w2:row>
            			<w2:row>
            				<value><![CDATA[200]]></value>
            				<label><![CDATA[Americas]]></label>
            			</w2:row>
            			<w2:row>
            				<value><![CDATA[300]]></value>
            				<label><![CDATA[Africa]]></label>
            			</w2:row>
            			<w2:row>
            				<value><![CDATA[400]]></value>
            				<label><![CDATA[MiddleEast]]></label>
            			</w2:row>
            			<w2:row>
            				<value><![CDATA[500]]></value>
            				<label><![CDATA[Europe]]></label>
            			</w2:row>
            		</w2:data>
            	</w2:dataList>
            	<w2:dataList baseNode="list" repeatNode="map" id="dataList2">
            		<w2:columnInfo>
            			<w2:column id="col1" name="select" dataType="text"></w2:column>
            			<w2:column id="col2" name="autoComplete" dataType="text"></w2:column>
            			<w2:column id="col3" name="checkcombobox" dataType="text"></w2:column>
            		</w2:columnInfo>
            		<w2:data use="true">
            			<w2:row>
            				<col1><![CDATA[Bangkok]]></col1>
            				<col2><![CDATA[TH]]></col2>
            				<col3><![CDATA[Asia]]></col3>
            			</w2:row>
            			<w2:row>
            				<col1><![CDATA[Paris]]></col1>
            				<col2><![CDATA[FR]]></col2>
            				<col3><![CDATA[Europe]]></col3>
            			</w2:row>
            			<w2:row>
            				<col1><![CDATA[Kenya]]></col1>
            				<col2><![CDATA[KN]]></col2>
            				<col3><![CDATA[Africa]]></col3>
            			</w2:row>
            			<w2:row>
            				<col1><![CDATA[Dubai]]></col1>
            				<col2><![CDATA[DB]]></col2>
            				<col3><![CDATA[MiddleEast]]></col3>
            			</w2:row>
            			<w2:row>
            				<col1><![CDATA[Ottawa]]></col1>
            				<col2><![CDATA[CA]]></col2>
            				<col3><![CDATA[Americas]]></col3>
            			</w2:row>
            		</w2:data>
            	</w2:dataList>
            	<w2:dataList baseNode="list" repeatNode="map" id="dataList3">
            		<w2:columnInfo>
            			<w2:column id="col1" name="select" dataType="text"></w2:column>
            			<w2:column id="col2" name="autoComplete" dataType="text"></w2:column>
            			<w2:column id="col3" name="checkcombobox" dataType="text"></w2:column>
            		</w2:columnInfo>
            		<w2:data use="true">
            			<w2:row>
            				<col1><![CDATA[100]]></col1>
            				<col2><![CDATA[100]]></col2>
            				<col3><![CDATA[100]]></col3>
            			</w2:row>
            			<w2:row>
            				<col1><![CDATA[500]]></col1>
            				<col2><![CDATA[500]]></col2>
            				<col3><![CDATA[500]]></col3>
            			</w2:row>
            			<w2:row>
            				<col1><![CDATA[300]]></col1>
            				<col2><![CDATA[300]]></col2>
            				<col3><![CDATA[300]]></col3>
            			</w2:row>
            			<w2:row>
            				<col1><![CDATA[400]]></col1>
            				<col2><![CDATA[400]]></col2>
            				<col3><![CDATA[400]]></col3>
            			</w2:row>
            			<w2:row>
            				<col1><![CDATA[200]]></col1>
            				<col2><![CDATA[200]]></col2>
            				<col3><![CDATA[200]]></col3>
            			</w2:row>
            		</w2:data>
            	</w2:dataList>
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
         <script type="text/javascript" lazy="false"><![CDATA[

scwin.onpageload = function () {

};

scwin.onpageunload = function () {

};


scwin.trigger1_onclick = function (e) {
    var options = {
        headerExist: 1,
        type: "1"
    };
    gridView1.advancedExcelUpload(options);
};

scwin.trigger2_onclick = function (e) {
    gridView2.advancedExcelDownload({});
};

scwin.trigger3_onclick = function (e) {
    gridView3.advancedExcelDownload({});
};

scwin.trigger4_onclick = function (e) {
    var options = {
        headerExist: 1,
        type: "0"
    };
    gridView1.advancedExcelUpload(options);

};
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload" ev:onpageunload="scwin.onpageunload">
    <xf:group id="" style="margin: 10px;">
    	<w2:textbox tagname="h1" style="color: blue;margin-bottom: 10px;" tabIndex="h1" id="textbox1" label="업로드할 데이터 설정 (GridView 전체)"
    		escape="false">
    	</w2:textbox>
    	<w2:textbox tagname="h2" style="height: 23px;margin-bottom: 10px;color: blue;" id="textbox2" label="샘플 사용 방법"></w2:textbox>
    	<w2:textbox style="color: blue;margin-bottom: 30px;" id="textbox3"
    		label='1-1. 하단의 첫 번째 GridView와 같이 label, label, label 순서로 데이터를 저장한 Excel 파일을 준비. &lt;br/&gt;1-2. 첫 번째 GridView 상단의 버튼을 클릭하여 예시 GridView를 Excel 파일로 다운로드.&lt;br/&gt;1-3. 하단의 options.type="1" 옵션 설정을 사용하는 버튼을 클릭하고 준비한 (혹은 다운로드한) Excel 파일을 업로드. &lt;br/&gt;1-4. Excel 파일이 업로드 되어 각 GridView 컬럼의 displayMode 속성에 따라 데이터가 표시되는 것을 확인.&lt;br/&gt;&lt;br/&gt;2-1. 하단의 두 번째 GridView와 같이 value, value, value 순서로 데이터를 저장한 Excel 파일을 준비. &lt;br/&gt;2-2. 두 번째 GridView 상단의 버튼을 클릭하여 예시 GridView를 Excel 파일로 다운로드.&lt;br/&gt;2-3. 하단의 options.type="0" 옵션 설정을 사용하는 버튼을 클릭하고 준비한 (혹은 다운로드한) Excel 파일을 업로드. &lt;br/&gt;2-4. Excel 파일이 업로드 되어 각 GridView 컬럼의 displayMode 속성에 따라 데이터가 표시되는 것을 확인.'
    		escape="false">
    	</w2:textbox>
    	<xf:trigger type="button" id="trigger2"
    		style="height:42px;line-height:32px;padding:5px;background-color:lightpink;font-size:15px;weight: bolder;font-weight:bolder;text-align: left;display: block;margin-bottom: 10px;"
    		ev:onclick="scwin.trigger2_onclick">
    		<xf:label><![CDATA[예시 GridView 다운로드 (1)]]></xf:label>
    	</xf:trigger>
    	<w2:gridView checkAllType="false" id="gridView2" style="border: sold gray 1px;margin-bottom: 10px;" dataList="data:dataList2"
    		visibleRowNum="5" visibleRowNumFix="true" autoFit="allColumn" autoFitCellMinWidth="allColumn">
    		<w2:caption style="" id="caption2" value="this is a grid caption."></w2:caption>
    		<w2:header style="" id="header2">
    			<w2:row style="" id="row3">
    				<w2:column width="70" inputType="text" style="" id="column5" value="select" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="" id="column4" value="autoComplete" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="" id="column3" value="checkcombobox" displayMode="label"></w2:column>
    			</w2:row>
    		</w2:header>
    		<w2:gBody style="" id="gBody2">
    			<w2:row style="" id="row4">
    				<w2:column width="70" inputType="text" style="" id="col1" value="" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="" id="col2" value="" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="" id="col3" value="" displayMode="label"></w2:column>
    			</w2:row>
    		</w2:gBody>
    	</w2:gridView>
    	<xf:trigger type="button" id="trigger3"
    		style="height:42px;line-height:32px;padding:5px;background-color:lightpink;font-size:15px;weight: bolder;font-weight:bolder;text-align: left;display: block;margin-bottom: 10px;"
    		ev:onclick="scwin.trigger3_onclick">
    		<xf:label><![CDATA[예시 GridView 다운로드 (2)]]></xf:label>
    	</xf:trigger>
    	<w2:gridView checkAllType="false" id="gridView3" style="border: sold gray 1px;margin-bottom: 10px;" dataList="data:dataList3"
    		visibleRowNumFix="true" visibleRowNum="5" autoFit="allColumn" autoFitCellMinWidth="allColumn">
    		<w2:caption style="" id="caption2" value="this is a grid caption."></w2:caption>
    		<w2:header style="" id="header2">
    			<w2:row style="" id="row3">
    				<w2:column width="70" inputType="text" style="" id="column5" value="select" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="" id="column4" value="autoComplete" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="" id="column3" value="checkcombobox" displayMode="label"></w2:column>
    			</w2:row>
    		</w2:header>
    		<w2:gBody style="" id="gBody2">
    			<w2:row style="" id="row4">
    				<w2:column width="70" inputType="text" style="" id="col1" value="" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="" id="col2" value="" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="" id="col3" value="" displayMode="label"></w2:column>
    			</w2:row>
    		</w2:gBody>
    	</w2:gridView>
    	<xf:trigger ev:onclick="scwin.trigger1_onclick"
    		style="height:42px;line-height:32px;padding:5px;background-color:coral;font-size:15px;weight: bolder;font-weight:bolder;text-align: left;display: block;margin-bottom: 10px;"
    		id="trigger1" type="button">
    		<xf:label><![CDATA[advancedExcelUpload(options) - options.type="1"]]></xf:label>
    	</xf:trigger>
    	<xf:trigger type="button" id="trigger4"
    		style="height:42px;line-height:32px;padding:5px;background-color:coral;font-size:15px;weight: bolder;font-weight:bolder;text-align: left;display: block;margin-bottom: 10px;"
    		ev:onclick="scwin.trigger4_onclick">
    		<xf:label><![CDATA[advancedExcelUpload(options) - options.type="0"]]></xf:label>
    	</xf:trigger>
    	<w2:gridView scrollByColumnAdaptive="false" dataList="data:dataList1" style="border: solid gray 1px;margin-bottom: 10px;" scrollByColumn="false"
    		id="gridView1" defaultCellHeight="20" autoFit="allColumn" visibleRowNum="5" visibleRowNumFix="true">
    		<w2:caption style="" id="caption1" value="this is a grid caption."></w2:caption>
    		<w2:header style="" id="header1">
    			<w2:row style="" id="row1">
    				<w2:column removeBorderStyle="false" width="70" inputType="text" style="height:20px;" id="column3" value="select"
    					blockSelect="false" displayMode="label">
    				</w2:column>
    				<w2:column removeBorderStyle="false" width="70" inputType="text" style="height:20px;" id="column2" value="autoComplete"
    					blockSelect="false" displayMode="label">
    				</w2:column>
    				<w2:column removeBorderStyle="false" width="70" inputType="text" style="height:20px;" id="column1" value="checkcombobox"
    					blockSelect="false" displayMode="label">
    				</w2:column>
    			</w2:row>
    		</w2:header>
    		<w2:gBody style="" id="gBody1">
    			<w2:row style="" id="row2">
    				<w2:column ref="" displayFormatter="" removeBorderStyle="false" chooseOption="" width="70" inputType="select"
    					style="height:20px" id="select" allOption="" value="" blockSelect="false" displayMode="label delim value">
    					<w2:choices>
    						<w2:itemset nodeset="data:select">
    							<w2:label ref="label"></w2:label>
    							<w2:value ref="value"></w2:value>
    						</w2:itemset>
    					</w2:choices>
    				</w2:column>
    				<w2:column ref="" removeBorderStyle="false" chooseOption="" width="70" inputType="autoComplete" style="height:20px"
    					id="autoComplete" allOption="" value="" blockSelect="false" displayMode="label delim value">
    					<w2:choices>
    						<w2:itemset nodeset="data:autoComplete">
    							<w2:label ref="label"></w2:label>
    							<w2:value ref="value"></w2:value>
    						</w2:itemset>
    					</w2:choices>
    				</w2:column>
    				<w2:column ref="" removeBorderStyle="false" chooseOption="" width="70" inputType="checkcombobox" style="height:20px"
    					id="checkcombobox" allOption="" value="" blockSelect="false" displayMode="label delim value">
    					<w2:choices>
    						<w2:itemset nodeset="data:checkcombobox">
    							<w2:label ref="label"></w2:label>
    							<w2:value ref="value"></w2:value>
    						</w2:itemset>
    					</w2:choices>
    				</w2:column>
    			</w2:row>
    		</w2:gBody>
    	</w2:gridView>
    	<w2:textbox escape="false" id="textbox4"
    		label='/// 샘플 코드 (1)&lt;br/&gt;&lt;br/&gt;var options = {&lt;br/&gt; &amp;nbsp; &amp;nbsp;headerExist: 1,&lt;br/&gt; &amp;nbsp; &amp;nbsp;type: "1"&lt;br/&gt;};&lt;br/&gt;gridView1.advancedExcelUpload(options);&lt;br/&gt;&lt;br/&gt;/// 샘플 코드 (2)&lt;br/&gt;&lt;br/&gt; var options = {&lt;br/&gt; &amp;nbsp; &amp;nbsp; headerExist: 1,&lt;br/&gt; &amp;nbsp; &amp;nbsp; type: "0"&lt;br/&gt; };&lt;br/&gt; gridView1.advancedExcelUpload(options);'
    		style="padding:10px; padding-bottom:20px; text-align:left; font-size:15px; font-weight:bolder; border:brown 1px solid; background-color:ivory; margin-bottom:10px; color:brown;"
    		tagname="">
    	</w2:textbox>
    </xf:group></body>
</html>
