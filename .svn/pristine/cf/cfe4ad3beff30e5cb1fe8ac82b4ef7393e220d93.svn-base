<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head meta_screenName="layerMoveType_FloatingLayer">
        <w2:type>COMPONENT</w2:type>
        <w2:buildDate/>
        <w2:MSA/>
        <xf:model>
            <w2:dataCollection baseNode="map"/>
            <w2:workflowCollection/>
        </xf:model>
        <w2:layoutInfo/>
        <w2:publicInfo method=""/>
        <script lazy="false" type="text/javascript"><![CDATA[scwin.onpageload = function () {
    var tmpSrc1 = scwin.getfolderPath() + "/floatingLayer_overflow.xml";
    pageFrame1.setSrc(tmpSrc1);

    
    var tmpSrc2 = scwin.getfolderPath() + "/floatingLayer_restrict.xml";
    pageFrame2.setSrc(tmpSrc2);
};

scwin.getfolderPath = function () {

    var currentPath = window.location.href;
    var folderPath;

    if (currentPath.includes("mainContainer")) {
        console.log("true  ===> " + $p.getFrameId());
        const cmtFrame = $p.getComponentById($p.getFrameId());
        currentPath = cmtFrame.getSrc();
        folderPath = currentPath.substring(0, currentPath.lastIndexOf('/'));
    } else {
        console.log("false  ===> ");
        folderPath = currentPath.split('w2xPath=')[1].substring(0, currentPath.split('w2xPath=')[1].lastIndexOf('/'));
    }
    return folderPath;
};

 ]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload">
    <xf:group id="" style="margin: 10px;">
    	<w2:textbox tagname="h1" style="color: blue;margin-bottom: 10px;" tabIndex="h1" id="textbox1" label="PageFrame 外部への移動制御" escape="false"></w2:textbox>
    	<w2:textbox tagname="h2" style="height: 23px;margin-bottom: 10px;color: blue;" id="textbox2" label="サンプルの使い方"></w2:textbox>
    	<w2:textbox style="color: blue;margin-bottom: 30px;" id="textbox3"
    		label='1.最初のFloatingLayerをドラッグしてPageFrameの外に移動できることを確認します。 (layerMoveType="overlow")&lt;br/&gt;2. 2番目のFloatingLayerはPageFrame内でのみ移動できないことを確認してください。 (layerMoveType="restrict")'
    		escape="false">
    	</w2:textbox>
    	<w2:textbox
    		style="padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightblue;border:none;margin-bottom: 10px;"
    		id="textbox4" label='プロパティの設定&lt;br/&gt;layerMoveType="overflow"' escape="false">
    	</w2:textbox>
    	<w2:pageFrame src="./floatingLayer_overflow.xml" style="border: lightgreen 3px solid;margin-bottom: 10px;height: 250px;" id="pageFrame1"></w2:pageFrame>
    	<w2:textbox escape="false" id="textbox5" label='プロパティの設定&lt;br/&gt;layerMoveType="restrict"'
    		style="padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightblue;border:none;margin-bottom: 10px;">
    	</w2:textbox>
    	<w2:pageFrame id="pageFrame2" src="./floatingLayer_restrict.xml" style="border: lightgreen 3px solid;height: 250px;"></w2:pageFrame>
    </xf:group></body>
</html>
