<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
         <script type="text/javascript" lazy="false"><![CDATA[

scwin.onpageload = function () {
    
};

scwin.onpageunload = function () {

};


scwin.trigger1_onclick = function (e) {
    const tmpSrc = scwin.getfolderPath() + "/src.xml";
    wframe1.setSrc(tmpSrc);
};

scwin.getfolderPath = function () {

    var currentPath = window.location.href;
    var folderPath;

    if (currentPath.includes("mainContainer")) {
        console.log("true  ===> " + $p.getFrameId());
        const cmtFrame = $p.getComponentById($p.getFrameId());
        currentPath = cmtFrame.getSrc();
        folderPath = currentPath.substring(0, currentPath.lastIndexOf('/'));
    } else {
        console.log("false  ===> ");
        folderPath = currentPath.split('w2xPath=')[1].substring(0, currentPath.split('w2xPath=')[1].lastIndexOf('/'));
    }
    return folderPath;
};
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload" ev:onpageunload="scwin.onpageunload">
    <xf:group id="" style="margin: 10px;">
    	<w2:textbox tagname="h1" style="color: blue;margin-bottom: 10px;" tabIndex="h1" id="textbox1"
    		label="フレームがネストされた場合のonpageloadの発生順序" escape="false">
    	</w2:textbox>
    	<w2:textbox tagname="h2" style="height: 23px;margin-bottom: 10px;color: blue;" id="textbox2" label="サンプルの使い方"></w2:textbox>
    	<w2:textbox style="color: blue;margin-bottom: 30px;" id="textbox3"
    		label="（例を単独で実行）&lt;br/&gt;1.下部の wframe1.setSrc() ボタンをクリックします。 &lt;br/&gt;2. 入れ子になったWFrameのscwin.onpageload実行順序を確認してください。" escape="false">
    	</w2:textbox>
    	<w2:textbox style="padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightgreen;border:none;margin-bottom: 10px;" id="textbox4" label="イベント説明&lt;br/&gt;onpageload - ページがロードされたときに発生します。" escape="false">
    	</w2:textbox>
    	<xf:trigger type="button" id="trigger1"
    		style="height:42px;line-height:32px;padding:5px;background-color:coral;font-size:15px;weight: bolder;font-weight:bolder;text-align: left;display: block;margin-bottom: 10px;"
    		ev:onclick="scwin.trigger1_onclick">
    		<xf:label><![CDATA[wframe1.setSrc()]]></xf:label>
    	</xf:trigger>
    	<w2:wframe style="height: 500px;border: solid 1px gray;" id="wframe1"></w2:wframe>
    </xf:group></body>
</html>
