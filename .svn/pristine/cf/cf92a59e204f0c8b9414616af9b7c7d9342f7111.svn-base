<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
        <w2:type>COMPONENT</w2:type>
        <w2:buildDate/>
        <w2:MSA/>
        <xf:model>
            <w2:dataCollection baseNode="map">
            	<w2:dataList baseNode="list" repeatNode="map" id="dataList1" saveRemovedData="true">
            		<w2:columnInfo>
            			<w2:column id="C_Code" name="name1" dataType="text"></w2:column>
            			<w2:column id="City" name="name2" dataType="text"></w2:column>
            			<w2:column id="Country" name="name3" dataType="text"></w2:column>
            			<w2:column id="Airport" name="name4" dataType="text"></w2:column>
            			<w2:column id="A_Code" name="name5" dataType="text"></w2:column>
            		</w2:columnInfo>
            	</w2:dataList>
            </w2:dataCollection>
            <w2:workflowCollection/>
        </xf:model>
        <w2:layoutInfo/>
        <w2:publicInfo method=""/>
        <script lazy="false" type="text/javascript"><![CDATA[
scwin.onpageload = function() {
	var json = [{
			"C_Code" : "PAR",
			"Airport" : "ORLY",
			"Country" : "FRANCE",
			"City" : "PARIS",
			"A_Code" : "ORY"
		}, {
			"C_Code" : "PDX",
			"Airport" : "PORTLAND INT’L",
			"Country" : "U.S.A.",
			"City" : "PORTLAND",
			"A_Code" : "PDX"
		}, {
			"C_Code" : "PEK",
			"Airport" : "CAPITAL",
			"Country" : "CHINA",
			"City" : "BEIJING",
			"A_Code" : "PEK"
		}, {
			"C_Code" : "PER",
			"Airport" : "PERTH",
			"Country" : "AUSTRALIA",
			"City" : "PERTH",
			"A_Code" : "PER"
		}, {
			"C_Code" : "PHL",
			"Airport" : "PHILADELPHIA INT’L",
			"Country" : "U.S.A.",
			"City" : "PHILADELPHIA",
			"A_Code" : "PHL"
		}, {
			"C_Code" : "PHX",
			"Airport" : "SKY HARBOR ",
			"Country" : "U.S.A.",
			"City" : "PHOENIX",
			"A_Code" : "PHX"
		}, {
			"C_Code" : "PIT",
			"Airport" : "PITTSBURGH INT’L",
			"Country" : "U.S.A.",
			"City" : "PITTSBURGH",
			"A_Code" : "PIT"
		}, {
			"C_Code" : "PNH",
			"Airport" : "POCHENTONG",
			"Country" : "CAMBODIA",
			"City" : "PHNOMPENH",
			"A_Code" : "PNH"
		}, {
			"C_Code" : "PUS",
			"Airport" : "KIMHAE",
			"Country" : "KOREA",
			"City" : "PUSAN",
			"A_Code" : "PUS"
		}];
		dataList1.setJSON(json);

};
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload">



    <xf:group id="" style="margin: 10px;">
    	<w2:textbox escape="false" id="textbox1" label="편집 모드에서 displayMode 표시" style="color: blue;margin-bottom: 10px;" tagname="h1"></w2:textbox>
    	<w2:textbox id="textbox2" label="샘플 사용 방법" style="height: 23px;margin-bottom: 10px;color: blue;" tagname="h2"></w2:textbox>
    	<w2:textbox escape="false" id="textbox3"
    		label='(첫 번째 AutoComplete)&lt;br/&gt;1. AutoComplete의 입력 상자를 클릭하여 편집 모드로 진입.&lt;br/&gt;2. displayMode 속성 설정에 따라 "Label 구분자 Value" 순서로 표시되는 것을 확인. (displayModeSync="true")&lt;br/&gt;&lt;br/&gt;(두 번째 AutoComplete)&lt;br/&gt;1. AutoComplete의 입력 상자를 클릭하여 편집 모드로 진입.&lt;br/&gt;2. 입력 상자에 Label 값만 표시되는 것을 확인.'
    		style="color: blue;margin-bottom: 30px;">
    	</w2:textbox>
    	<w2:textbox escape="false" id="textbox4" label='속성 설정&lt;br/&gt;displayModeSync="true"'
    		style="padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightblue;border:none;margin-bottom: 10px;">
    	</w2:textbox>
    	<w2:autoComplete submenuSize="auto" chooseOption="" useKeywordHighlight="true" allOption="" searchTarget="both"
    		displayMode="label delim value" search="contain" ref="" displayModeSync="true" delimiter=" --- " editType="select" style="margin-bottom: 10px;width: 50%;display: block"
    		id="autoComplete1" useLocale="false">
    		<w2:choices>
    			<w2:itemset nodeset="data:dataList1">
    				<w2:label ref="Country"></w2:label>
    				<w2:value ref="City"></w2:value>
    			</w2:itemset>
    		</w2:choices>
    	</w2:autoComplete>
    	<w2:textbox style="padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightblue;border:none;margin-bottom: 10px;" id="textbox5" label='속성 설정&lt;br/&gt;displayModeSync="false"' escape="false">
    	</w2:textbox>
    	<w2:autoComplete submenuSize="auto" chooseOption="" useKeywordHighlight="true" allOption="" searchTarget="both"
    		displayMode="label delim value" displayModeSync="false" ref="" search="contain" delimiter=" --- " editType="select"
    		style="width: 50%;display: block;" id="autoComplete2" useLocale="false">
    		<w2:choices>
    			<w2:itemset nodeset="data:dataList1">
    				<w2:label ref="Country"></w2:label>
    				<w2:value ref="City"></w2:value>
    			</w2:itemset>
    		</w2:choices>
    	</w2:autoComplete>
    </xf:group></body>
</html>
