  scwin.search();
};
scwin.chk1_onchange = function (info) {
  scwin.chk("1");
};
scwin.chk2_onchange = function (info) {
  scwin.chk("2");
};
scwin.chk = function (type) {
  var chkValue = "";
  var chkItem = [];
  if (type == "1") {
    chkItem = chk1.getItemArray();
    // [{"label":"1회","value":"02"},{"label":"2회","value":"03"},{"label":"3회","value":"04"}]
    chkValue = chk1.getValue(); // "02;03;04"
  } else if (type == "2") {
    chkItem = chk2.getItemArray();
    chkValue = chk2.getValue();
  }
  for (var i = 0; i < chkItem.length; i++) {
    var flag = false;
    if (chkValue.indexOf(chkItem[i].value) > -1) {
      flag = true;
    }
    grd_Exam.setColumnVisible("col" + chkItem[i].value, flag);
  }
};
scwin.chkA_onchange = function (info) {
  if (chk1.getDisabled()) {
    return;
  }
  if (info.newValue == "") {
    chk1.checkAll(false);
    chk2.checkAll(false);
  } else {
    chk1.checkAll(true);
    chk2.checkAll(true);
  }
  scwin.chk("1");
  scwin.chk("2");
};
scwin.search = function (e) {
  dataList1.removeColumnFilterAll();
  for (var i = 1; i <= 5; i++) {
    grd_Exam.setColumnVisible("col_" + i, false);
  }
  chk1.setDisabled(false);
  chk2.setDisabled(false);
  scwin.chk("1");
  scwin.chk("2");
  dataList1.setJSON(dataList2.getAllJSON());
};
