<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
    	<w2:buildDate />
    	<xf:model>
    		<xf:instance>
    			<data xmlns="" />
    		</xf:instance>
    		<w2:dataCollection baseNode="map"></w2:dataCollection>
    		<w2:workflowCollection></w2:workflowCollection>
    	</xf:model>
    	<script type="text/javascript" lazy="false"><![CDATA[

scwin.onpageload = function () {

};

scwin.onpageunload = function () {

};
scwin.trigger1_onclick = function (e) {
    windowContainer1.createWindow("aaa", "", "", "window aaa", 000, "newWindow", null, null, null, null, "wframe");
    windowContainer1.createWindow("bbb", "", "", "window bbb", 001, "newWindow", null, null, null, null, "wframe");
    windowContainer1.createWindow("ccc", "", "", "window ccc", 002, "newWindow", null, null, null, null, "wframe");
    windowContainer1.createWindow("ddd", "", "", "window ddd", 003, "newWindow", null, null, null, null, "wframe");
    windowContainer1.createWindow("eee", "", "", "window eee", 004, "newWindow", null, null, null, null, "wframe");
    windowContainer1.setArrangeWindows("sequential");
};
]]></script>
    	<style type="text/css"><![CDATA[.w2window_selected {border: solid 3px green;} ]]></style>
    </head>
    <body ev:onpageload="scwin.onpageload" ev:onpageunload="scwin.onpageunload">
    <xf:group id="" style="margin: 10px;">
    	<w2:textbox tagname="h1" style="color: blue;margin-bottom: 10px;" tabIndex="h1" id="textbox1" label="현재 선택된 윈도우에 적용할 스타일 설정" escape="false"></w2:textbox>
    	<w2:textbox tagname="h2" style="height: 23px;margin-bottom: 10px;color: blue;" id="textbox2" label="샘플 사용 방법"></w2:textbox>
    	<w2:textbox style="color: blue;margin-bottom: 30px;" id="textbox3"
    		label='1. 하단의 createWindow() 버튼을 클릭. &lt;br/&gt;2. 윈도우들이 생성되는 것을 확인. &lt;br/&gt;3. 제일 마지막 윈도우가 선택되고 내부 스타일시트에 정의한 .w2window_selected 클래스가 적용된 것을 확인. &lt;br/&gt;4. 다른 윈도우를 선택. &lt;br/&gt;5. 새로 선택한 윈도우에 .w2window_selected 클래스가 적용되는 것을 확인.'
    		escape="false">
    	</w2:textbox>
    	<w2:textbox
    		style="padding:10px; padding-bottom:20px; text-align:left; font-size:15px; font-weight:bolder; border:brown 1px solid; background-color:ivory; margin-bottom:10px; margin-top:10px; color:brown;"
    		id="textbox4" label='/// 내부 스타일시트에 정의된 클래스&lt;br/&gt;&lt;br/&gt;.w2window_selected {border: solid 3px green;}' escape="false">
    	</w2:textbox>
    	<xf:trigger type="button" id="trigger1" style="height:42px;line-height:32px;padding:5px;background-color:coral;font-size:15px;weight: bolder;font-weight:bolder;text-align: left;display: block;margin-bottom: 10px;" ev:onclick="scwin.trigger1_onclick">
    		<xf:label><![CDATA[createWindow()]]></xf:label>
    	</xf:trigger>
    	<w2:windowContainer sequentialArrangeColNum="2" sequentialArrangeRowNum="2" fixArrangeFullScreen="false" useFixButton="false"
    		windowAutoResize="false" useWindowScrollButton="true" verticalArrangeNum="2" windowMaxNum="20" useCloseButton="false"
    		controlIconPosition="allright" stopMinimizeOnNameLayer="false" toolbarPosition="top" windowMaximizeAll="true" id="windowContainer1"
    		useStatusMsg="true" hideTitleOnMaximize="false" spaInitCount="0" windowScrollVisibleRowNum="" stopToggleOnLast="false"
    		useNameContainer="true" horizontalArrangeNum="2" useCustomMsg="false" autoArrange="true" useControlIconTitle="true"
    		tooltipDisplay="true" tooltipGroupClass="false" windowTooltipDisplay="true"
    		style="position: relative;height: 400px;border: gray solid 1px;">
    		<w2:windowToolbar>
    			<w2:controlIconLayer>
    				<w2:controlIcon></w2:controlIcon>
    				<w2:controlIcon></w2:controlIcon>
    				<w2:controlIcon></w2:controlIcon>
    				<w2:controlIcon></w2:controlIcon>
    				<w2:controlIcon></w2:controlIcon>
    			</w2:controlIconLayer>
    			<w2:nameLayer></w2:nameLayer>
    			<w2:selectedNameLayer></w2:selectedNameLayer>
    		</w2:windowToolbar>
    	</w2:windowContainer>
    </xf:group></body>
</html>
