unction(e) {<br/> &nbsp; &nbsp;input1.setMandatory(true);<br/> &nbsp; &nbsp;input1.setValue("test");<br/> &nbsp; &nbsp;alert(\'Set mandatory property as "true"\');<br/>};<br/><br/>scwin.input1_onchange = function (e) {<br/> &nbsp; &nbsp;input1.validate();<br/>};',style:'padding:10px; padding-bottom:20px; text-align:left; font-size:15px; font-weight:bolder; border:brown 1px solid; background-color:ivory; margin-bottom:10px; margin-top:10px; color:brown;'}}]}]}]}]})