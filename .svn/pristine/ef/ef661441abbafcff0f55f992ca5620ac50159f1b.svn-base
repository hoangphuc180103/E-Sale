    <body ev:onpageload="scwin.onpageload" ev:onpageunload="scwin.onpageunload">
    	<xf:group id="" style="margin: 10px;">
    		<w2:textbox tagname="h1" style="color: blue;margin-bottom: 10px;" tabIndex="h1" id="textbox1" label="각 컬럼의 데이터 표시 형식 설정 (함수 이용)"
    			escape="false">
    		</w2:textbox>
    		<w2:textbox tagname="h2" style="height: 23px;margin-bottom: 10px;color: blue;" id="textbox2" label="샘플 사용 방법"></w2:textbox>
    		<w2:textbox style="color: blue;margin-bottom: 30px;" id="textbox3"
    			label='1. 첫 번째 GridView의 ID 컬럼의 displayFormatter 속성이 "scwin.IdFormatter"로 설정된 것을 확인. &lt;br/&gt;2. Script 탭에서 "scwin.IdFormatter" 함수 스크립트를 확인. &lt;br/&gt;3. 첫 번째 GridView의 ID 컬럼 데이터가 "scwin.IdFormatter" 함수가 반환한 값으로 표시되는 것을 확인. &lt;br/&gt;4. 두 번째 GridView의 ID 컬럼에는 displayFormatter 속성이 설정되지 않은 것을 확인. &lt;br/&gt;5. 두 번째 GridView의 ID 컬럼에는 변환되지 않은 데이터가 표시되는 것을 확인. '
    			escape="false">
    		</w2:textbox>
    		<w2:textbox
    			style="padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightblue;border:none;margin-bottom: 10px;"
    			id="textbox4" label='속성 설정&lt;br/&gt;displayFormatter="scwin.IdFormatter" (ID 컬럼)' escape="false">
    		</w2:textbox>
    		<w2:gridView scrollByColumnAdaptive="false" rowNumVisible="true" visibleRowNumFix="true" checkAllType="false"
    			dataList="data:dataList1" scrollByColumn="false" style="border: solid gray 1px;margin-bottom: 10px;" autoFit="allColumn"
    			id="gridView1" sortable="true" visibleRowNum="5" defaultCellHeight="20">
    			<w2:caption style="" id="caption1" value="this is a grid caption."></w2:caption>
    			<w2:header style="" id="header1">
    				<w2:row style="" id="row1">
    					<w2:column width="70" inputType="text" style="height:20px" id="column3" value="Frequency" displayMode="label"></w2:column>
    					<w2:column width="70" inputType="text" style="height:20px" id="column2" value="ID" displayMode="label"></w2:column>
    					<w2:column width="70" inputType="text" style="height:20px" id="column1" value="Age" displayMode="label"></w2:column>
    				</w2:row>
    			</w2:header>
    			<w2:gBody style="" id="gBody1">
    				<w2:row style="" id="row2">
    					<w2:column width="70" inputType="text" style="height:20px" id="Frequency" value="" displayMode="label"></w2:column>
    					<w2:column displayFormatFunc="" displayFormatter="scwin.IdFormatter" width="70" inputType="text" style="height:20px"
    						id="ID" value="" displayMode="label">
    					</w2:column>
    					<w2:column width="70" inputType="text" style="height:20px" id="Age" value="" displayMode="label"></w2:column>
    				</w2:row>
    			</w2:gBody>
    		</w2:gridView>
    		<w2:textbox tagname=""
    			style="padding:10px; padding-bottom:20px; text-align:left; font-size:15px; font-weight:bolder; border:brown 1px solid; background-color:ivory; margin-bottom:10px; color:brown;"
    			id="textbox6"
    			label='/// 샘플 코드&lt;br/&gt;&lt;br/&gt;scwin.IdFormatter = function (data) {&lt;br/&gt; &amp;nbsp; &amp;nbsp;return data.substring(0, 3) + "-" + data.substring(3, 5);&lt;br/&gt;};'
    			escape="false">
    		</w2:textbox>
    		<w2:textbox escape="false" id="textbox5" label='속성 설정&lt;br/&gt;displayFormatter="" (ID 컬럼)'
    			style="padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightblue;border:none;margin-bottom: 10px;">
    		</w2:textbox>
    		<w2:gridView autoFit="allColumn" checkAllType="false" dataList="data:dataList1" defaultCellHeight="20" id="gridView2"
    			rowNumVisible="true" scrollByColumn="false" scrollByColumnAdaptive="false" sortable="true" style="border: solid gray 1px;"
    			visibleRowNum="5" visibleRowNumFix="true">
    			<w2:caption id="caption2" style="" value="this is a grid caption."></w2:caption>
    			<w2:header id="header1" style="">
    				<w2:row id="row1" style="">
    					<w2:column displayMode="label" id="column3" inputType="text" style="height:20px" value="Frequency" width="70"></w2:column>
    					<w2:column displayMode="label" id="column2" inputType="text" style="height:20px" value="ID" width="70"></w2:column>
    					<w2:column displayMode="label" id="column1" inputType="text" style="height:20px" value="Age" width="70"></w2:column>
    				</w2:row>
    			</w2:header>
    			<w2:gBody id="gBody1" style="">
    				<w2:row id="row2" style="">
    					<w2:column displayMode="label" id="Frequency" inputType="text" style="height:20px" value="" width="70"></w2:column>
    					<w2:column displayFormatFunc="" displayMode="label" id="ID" inputType="text" style="height:20px" value=""
    						width="70">
    					</w2:column>
    					<w2:column displayMode="label" id="Age" inputType="text" style="height:20px" value="" width="70"></w2:column>
    				</w2:row>
    			</w2:gBody>
    		</w2:gridView>
    	</xf:group>
    </body>
</html>
