define({declaration:{A:{version:'1.0',encoding:'UTF-8'}},E:[{T:1,N:'html',A:{xmlns:'http://www.w3.org/1999/xhtml','xmlns:ev':'http://www.w3.org/2001/xml-events','xmlns:w2':'http://www.inswave.com/websquare','xmlns:xf':'http://www.w3.org/2002/xforms'},E:[{T:1,N:'head',E:[{T:1,N:'w2:type',E:[{T:3,text:'DEFAULT'}]},{T:1,N:'w2:buildDate'},{T:1,N:'xf:model',E:[{T:1,N:'w2:dataCollection',A:{baseNode:'map'}},{T:1,N:'w2:workflowCollection'}]},{T:1,N:'script',A:{type:'text/javascript',lazy:'false'},E:[{T:4,cdata:function(scopeObj){with(scopeObj){scwin.onpageload = function () {
  const tmpSrc = scwin.getfolderPath() + "/source.xml";
  wframe1.setSrc(tmpSrc);
  wframe2.setSrc(tmpSrc);
  const tmpSrc2 = scwin.getfolderPath() + "/processMsg_new.xml";
  pageFrame1.setSrc(tmpSrc2);
};
scwin.onpageunload = function () {};
scwin.getfolderPath = function () {
  var currentPath = window.location.href;
  var folderPath;
  if (currentPath.includes("mainContainer")) {
    console.log("true  ===> " + $p.getFrameId());
    const cmtFrame = $p.getComponentById($p.getFrameId());
    currentPath = cmtFrame.getSrc();
    folderPath = currentPath.substring(0, currentPath.lastIndexOf('/'));
  } else {
    console.log("false  ===> ");
    folderPath = currentPath.split('w2xPath=')[1].substring(0, currentPath.split('w2xPath=')[1].lastIndexOf('/'));
  }
  return folderPath;
};
}}}]}]},{T:1,N:'body',A:{'ev:onpageload':'scwin.onpageload','ev:onpageunload':'scwin.onpageunload'},E:[{T:1,N:'xf:group',A:{id:'',style:'margin: 10px;'},E:[{T:1,N:'w2:textbox',A:{tagname:'h1',style:'color: blue;margin-bottom: 10px;',tabIndex:'h1',id:'textbox1',label:'서브미션 상태창을 WFrame 내부에만 표시 (커스텀 상태창)',escape:'false'}},{T:1,N:'w2:textbox',A:{tagname:'h2',style:'height: 23px;margin-bottom: 10px;color: blue;',id:'textbox2',label:'샘플 사용 방법'}},{T:1,N:'w2:textbox',A:{style:'color: blue;margin-bottom: 30px;',id:'textbox3',label:'(첫 번째 WFrame)<br/>1-1. 내부의 Submit 버튼을 클릭. <br/>1-2. client.config.xml 설정 파일에서 processMsgFrameURL 항목으로 지정한 파일이 WFrame 내부에만 표시되는 것을 확인. (processMsgFrame="true")<br/><br/>(두 번째 WFrame)<br/>2-1. 내부의 Submit 버튼을 클릭. <br/>2-2. client.config.xml 설정 파일에서 processMsgFrameURL 항목으로 지정한 파일이 전체 화면에 표시되는 것을 확인. (processMsgFrame="false")',escape:'false'}},{T:1,N:'w2:textbox',A:{style:'padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightpink;border:none;margin-bottom: 10px;',id:'textbox4',label:'클라이언트 설정 (client.config.xml)<br/>processMsgFrameURL value="processMsg_new.xml"',escape:'false'}},{T:1,N:'w2:textbox',A:{style:'padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightblue;border:none;margin-bottom: 10px;',id:'textbox5',label:'속성 설정<br/>processMsgFrame="true"',escape:'false'}},{T:1,N:'w2:wframe',A:{scope:'true',style:'border: solid 1px gray;margin-bottom: 10px;',id:'wframe1',processMsgFrame:'true'}},{T:1,N:'w2:textbox',A:{style:'padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightblue;border:none;margin-bottom: 10px;',id:'textbox6',label:'속성 설정<br/>processMsgFrame="false"',escape:'false'}},{T:1,N:'w2:wframe',A:{id:'wframe2',processMsgFrame:'false',scope:'true',style:'border: solid 1px gray;margin-bottom: 10px;'}},{T:1,N:'w2:pageFrame',A:{style:'width: 500px;height: 300px;',id:'pageFrame1'}}]}]}]}]})