<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head meta_screenName="scopeInherit_WFrame">
        <w2:type>COMPONENT</w2:type>
        <w2:buildDate/>
        <w2:MSA/>
        <xf:model>
            <w2:dataCollection baseNode="map"/>
            <w2:workflowCollection/>
        </xf:model>
        <w2:layoutInfo/>
        <w2:publicInfo method=""/>
        <script lazy="false" type="text/javascript"><![CDATA[
scwin.onpageload = function () {
    const tmpSrc = scwin.getfolderPath() + "/main.xml";
    wframe1.setSrc(tmpSrc);
};

scwin.getfolderPath = function () {

    var currentPath = window.location.href;
    var folderPath;

    if (currentPath.includes("mainContainer")) {
        console.log("true  ===> " + $p.getFrameId());
        const cmtFrame = $p.getComponentById($p.getFrameId());
        currentPath = cmtFrame.getSrc();
        folderPath = currentPath.substring(0, currentPath.lastIndexOf('/'));
    } else {
        console.log("false  ===> ");
        folderPath = currentPath.split('w2xPath=')[1].substring(0, currentPath.split('w2xPath=')[1].lastIndexOf('/'));
    }
    return folderPath;
};
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload">
    <xf:group id="" style="margin: 10px;">
    	<w2:textbox tagname="h1" style="margin-bottom: 10px;color: blue;" id="textbox3" label="부모의 Scope 상속" escape="false"></w2:textbox>
    	<w2:textbox tagname="h2" style="height: 23px;margin-bottom: 10px;color: blue;" id="textbox4" label="샘플 사용 방법"></w2:textbox>
    	<w2:textbox style="color: blue;margin-bottom: 30px;" id="textbox5"
    		label='(예제를 단독으로 실행.)&lt;br/&gt;1. WFrame이 중첩 구성된 화면이 표시되는 것을 확인. &lt;br/&gt;2. 제일 하단의 WFrame에 포함된 각 버튼을 클릭. &lt;br/&gt;3. 각 버튼이 scopeInherit="all" 속성 설정에 따라 동작하는지 확인. &lt;br/&gt;&lt;br/&gt;scopeInherit 속성 값에 따른 동작은 다음과 같음.&lt;br/&gt; &amp;nbsp; &amp;nbsp; "none" : (1) X, (2) 최상단 접근, (3) O&lt;br/&gt; &amp;nbsp; &amp;nbsp; "api" : (1) &amp;nbsp;X, (2) 부모 접근, (3) O&lt;br/&gt; &amp;nbsp; &amp;nbsp; "all" : (1) O, (2) 부모 접근, (3) O&lt;br/&gt; &amp;nbsp; &amp;nbsp; "component" : (1) O, (2) 최상단 접근, (3) O'
    		escape="false">
    	</w2:textbox>
    	<w2:textbox
    		style="padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightblue;border:none;margin-bottom: 20px;"
    		id="textbox6" label='속성 설정&lt;br/&gt;scopeInherit="all"' escape="false">
    	</w2:textbox>
    	<w2:textbox
    		style="text-align: left;height:50px;padding: 5px;font-size:30px;font-style:normal;font-weight:bolder;color: blue;margin-bottom: 10px;"
    		id="textbox1" label='Top (id="textbox1")'>
    	</w2:textbox>
    	<w2:wframe scopeInherit="all" style="padding: 10px;border: gray solid 1px;background-color: lightgreen;" id="wframe1"></w2:wframe>
    </xf:group></body>
</html>
