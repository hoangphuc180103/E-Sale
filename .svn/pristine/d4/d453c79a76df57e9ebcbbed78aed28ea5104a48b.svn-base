// 예제 테스트를 위한 초기화
scwin.initializeExample = function () {
  var arrData = [{}, {}];
  dlt_exam_1.setJSON(arrData);
  dlt_exam_2.setJSON(arrData);
  dlt_exam_3.setJSON(arrData);
};

/**
 * 버튼 [Data 출력하기 - dlt_exam_1] 클릭 시
 * DataList dlt_exam_1 출력
 */
scwin.btn_ex1_onclick = function (e) {
  let jsnData = dlt_exam_1.getAllJSON();

  //로그 출력
  let strLog = "[(기본 설정) valueType : binary] dlt_exam_1 출력\n";
  strLog += JSON.stringify(jsnData, null, "\t");
  $c.frame.printExampleLog($p, strLog, txa_log_1, false);
  console.log(strLog);
};

/**
 * 버튼 [Data 출력하기 - dlt_exam_2] 클릭 시
 * DataList dlt_exam_2 출력
 */
scwin.btn_ex2_onclick = function (e) {
  let jsnData = dlt_exam_2.getAllJSON();

  //로그 출력
  let strLog = "[valueType : boolean] dlt_exam_2 출력\n";
  strLog += JSON.stringify(jsnData, null, "\t");
  $c.frame.printExampleLog($p, strLog, txa_log_2, false);
  console.log(strLog);
};

/**
 * 버튼 [Data 출력하기 - dlt_exam_3] 클릭 시
 * DataList dlt_exam_3 출력
 */
scwin.btn_ex3_onclick = function (e) {
  let jsnData = dlt_exam_3.getAllJSON();

  //로그 출력
  let strLog = "[valueType : other] dlt_exam_3 출력\n";
  strLog += JSON.stringify(jsnData, null, "\t");
  $c.frame.printExampleLog($p, strLog, txa_log_3, false);
  console.log(strLog);
};

/**
 * [공통] 로그 출력용 Textrea의 Value 삭제하기
 */
scwin.btn_clearLog_onclick = function (e) {
  let strTargetId = this.getUserData("userData1");
  let cmpTarget;
  if (strTargetId) {
    cmpTarget = $p.getComponentById(strTargetId) || txa_log;
  } else {
    cmpTarget = txa_log;
  }
  //textarea value를 빈문자열로 할당.
  cmpTarget.setValue("");
};
