<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
         <script type="text/javascript" lazy="false"><![CDATA[
scwin.count = 0;
scwin.onpageload = function () {
    text1.hide();
    text2.hide();
    trigger1.hide();

    var tmpSrc1 = scwin.getfolderPath() + "/11_wframe_01.xml";
    var tmpSrc2 = scwin.getfolderPath() + "/02_openPopUp_tab.xml";

    tabControl1.addTab(scwin.count,
        {
            label: "wframe",
            title: "wframe",
            openAction: "exist",
            closable: "true"
        },
        {
            "src": tmpSrc1,
            "frameMode": "wframe"
        }
    );

    scwin.count++;

    tabControl1.addTab(scwin.count + 1,
        {
            label: "wframePreload",
            title: "wframePreload",
            openAction: "exist",
            closable: "true"
        },
        {
            "src": tmpSrc2,
            "frameMode": "wframePreload"
        }
    );
    tabControl1.setSelectedTabIndex(scwin.count);

    scwin.count++;


};

scwin.onpageunload = function () {

};


scwin.getfolderPath = function () {

    var currentPath = window.location.href;
    var folderPath;

    if (currentPath.includes("mainContainer")) {
        console.log("true  ===> " + $p.getFrameId());
        const cmtFrame = $p.getComponentById($p.getFrameId());
        currentPath = cmtFrame.getSrc();
        folderPath = currentPath.substring(0, currentPath.lastIndexOf('/'));
    } else {
        console.log("false  ===> ");
        folderPath = currentPath.split('w2xPath=')[1].substring(0, currentPath.split('w2xPath=')[1].lastIndexOf('/'));
    }
    return folderPath;
};


]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload" ev:onpageunload="scwin.onpageunload">
    <xf:group id="" style="margin: 10px;"><w2:textbox tagname="h1" style="margin-bottom: 10px;color: blue;" id="textbox1" label="탭 내부에서 프레임 기반 모달 팝업 생성" escape="false"></w2:textbox><w2:textbox tagname="h2" style="height: 23px;margin-bottom: 10px;color: blue;" id="textbox2" label="샘플 사용 방법"></w2:textbox><w2:textbox style="color: blue;margin-bottom: 30px;" id="textbox3" label='(첫 번째 frameMode="wframe" 탭)&lt;br/&gt;1-1. openPopup() 메소드의 frameModal 옵션을 선택. ("frame", "parent", "top", TabControl ID)&lt;br/&gt;1-2. 탭 &amp;nbsp;내부의 $p.openPopup() 버튼을 클릭.&lt;br/&gt;1-3. 옵션 설정에 따른 팝업 동작 범위를 확인.&lt;br/&gt; &amp;nbsp; "frame" : 해당 프레임 내부에 모달 팝업으로 표시.&lt;br/&gt; &amp;nbsp; "parent" : 부모 프레임 내부에 모달 팝업으로 표시.&lt;br/&gt; &amp;nbsp; "top" : 전체 화면에 모달 팝업으로 표시.&lt;br/&gt; &amp;nbsp; TabControl ID : TabControl 내부에 모달 팝업으로 표시. (아럐 예제의 경우 $p.getFrame().getParentFrame().getParentFrame().id로 TabControl ID를 구함.)&lt;br/&gt;&lt;br/&gt;(두 번째 frameMode="wframePreload" 탭)&lt;br/&gt;2-1. 각 버튼을 클릭하여 PageFrame, WFrame, IFrame 타입 팝업을 생성. &lt;br/&gt;2-2. options.frameModal 옵션에 따라 최상단("top") 혹은 자신이 속한 프레임 내부("frame")에 팝업이 표시되는 것을 확인. &lt;br/&gt;(자세한 스크립트는 Script 탭에서 확인.)' escape="false">
    	</w2:textbox><w2:textbox style="padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightblue;border:none;margin-bottom: 20px;" id="textbox4" label='속성 설정&lt;br/&gt;frameMode="wframe" "wframePreload" (tabControl.content)&lt;br/&gt;$p.openPopup(options) - options.modal : "true" &amp; options.frameModal ; "frame" (팝업창)' escape="false">
    	</w2:textbox><w2:tabControl frameModal="true" confirmTrueAction="exist" confirmFalseAction="new" useTabKeyOnly="true" useMoveNextTabFocus="false" closable="true" useConfirmMessage="false" alwaysDraw="false" userData3="" style="border: gray solid 1px;height: 500px;margin-bottom: 10px;" id="tabControl1" processMsgFrame="true">
    	</w2:tabControl><w2:textbox style="width: 150px;height: 23px;" id="text1" label="Main A"></w2:textbox><w2:textbox style="width: 150px;height: 23px;" id="text2" label="Main B"></w2:textbox><xf:trigger style="width: 80px;height: 23px;" id="trigger1" type="button">
    		<xf:label><![CDATA[]]></xf:label>
    	</xf:trigger></xf:group></body>
</html>
