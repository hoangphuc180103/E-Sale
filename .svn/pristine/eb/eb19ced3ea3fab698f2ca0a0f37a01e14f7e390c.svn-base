<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head meta_screenName="adaptive">
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
         <script type="text/javascript" lazy="false"><![CDATA[

scwin.onpageload = function () {

};

scwin.onpageunload = function () {

};


scwin.trigger1_onclick = function (e) {
var tmpSrc = scwin.getfolderPath() + "/adaptive_adaptiveThreshold_TableLayout.xml";

    var winObj = {
        title: "window",
        src: tmpSrc,
        windowTitle: "Title",
        windowId: "001",
        frameMode: "wframe",
        defaultWidth: "400",
        defaultHeight: "300",
        adaptiveFrame: true
    }
    windowContainer1.createWindow(winObj);
    windowContainer1.setArrangeWindows("cascade", ["001"]);
};

scwin.getfolderPath = function () {

    var currentPath = window.location.href;
    var folderPath;

    if (currentPath.includes("mainContainer")) {
        console.log("true  ===> " + $p.getFrameId());
        const cmtFrame = $p.getComponentById($p.getFrameId());
        currentPath = cmtFrame.getSrc();
        folderPath = currentPath.substring(0, currentPath.lastIndexOf('/'));
    } else {
        console.log("false  ===> ");
        folderPath = currentPath.split('w2xPath=')[1].substring(0, currentPath.split('w2xPath=')[1].lastIndexOf('/'));
    }
    return folderPath;
};
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload" ev:onpageunload="scwin.onpageunload">
    <xf:group id="" style="margin: 10px;">
    	<w2:textbox tagname="h1" style="color: blue;margin-bottom: 10px;" tabIndex="h1" id="textbox1" label="Apply Adaptive Design Based on Window Size&lt;br/&gt;"
    		escape="false">
    	</w2:textbox>
    	<w2:textbox tagname="h2" style="height: 23px;margin-bottom: 10px;color: blue;" id="textbox2" label="How to Use"></w2:textbox>
    	<w2:textbox style="color: blue;margin-bottom: 30px;" id="textbox3"
    		label="1. Click the createWindow() button below.&lt;br/&gt;2. Confirm that the window is created.&lt;br/&gt;3. Adjust the window's width.&lt;br/&gt;4. Confirm that the responsive design adapts based on the window's width."
    		escape="false">
    	</w2:textbox>
    	<xf:trigger ev:onclick="scwin.trigger1_onclick"
    		style="height:42px;line-height:32px;padding:5px;background-color:coral;font-size:15px;weight: bolder;font-weight:bolder;text-align: left;display: block;margin-bottom: 10px;"
    		id="trigger1" type="button" class="btn_cm">
    		<xf:label><![CDATA[createWindow(winObj) - winObj.adaptiveFrame="true"]]></xf:label>
    	</xf:trigger>
    	<w2:windowContainer sequentialArrangeColNum="2" sequentialArrangeRowNum="2" fixArrangeFullScreen="false" useFixButton="false"
    		windowAutoResize="false" useWindowScrollButton="true" defaultWidth="" verticalArrangeNum="2" windowMaxNum="20" useCloseButton="false"
    		controlIconPosition="allright" stopMinimizeOnNameLayer="false" toolbarPosition="top" windowMaximizeAll="true" id="windowContainer1"
    		useStatusMsg="true" hideTitleOnMaximize="false" spaInitCount="0" windowScrollVisibleRowNum="" stopToggleOnLast="false"
    		defaultHeight="" useNameContainer="true" horizontalArrangeNum="2" useCustomMsg="false" autoArrange="true" useControlIconTitle="true"
    		tooltipDisplay="true" tooltipGroupClass="false" windowTooltipDisplay="true"
    		style="position: relative;height: 400px;border: gray solid 1px;margin-bottom: 10px;">
    		<w2:windowToolbar>
    			<w2:controlIconLayer>
    				<w2:controlIcon></w2:controlIcon>
    				<w2:controlIcon></w2:controlIcon>
    				<w2:controlIcon></w2:controlIcon>
    				<w2:controlIcon></w2:controlIcon>
    				<w2:controlIcon></w2:controlIcon>
    			</w2:controlIconLayer>
    			<w2:nameLayer></w2:nameLayer>
    			<w2:selectedNameLayer></w2:selectedNameLayer>
    		</w2:windowToolbar>
    	</w2:windowContainer>
    	<w2:textbox escape="false" id="textbox4"
    		label='/// Sample Code &lt;br/&gt;&lt;br/&gt;var winObj = {&lt;br/&gt; &amp;nbsp; &amp;nbsp;title: "window",&lt;br/&gt; &amp;nbsp; &amp;nbsp;src: tmpSrc,&lt;br/&gt; &amp;nbsp; &amp;nbsp;windowTitle: "Title",&lt;br/&gt; &amp;nbsp; &amp;nbsp;windowId: "001",&lt;br/&gt; &amp;nbsp; &amp;nbsp;frameMode: "wframe",&lt;br/&gt; &amp;nbsp; &amp;nbsp;defaultWidth: "400",&lt;br/&gt; &amp;nbsp; &amp;nbsp;defaultHeight: "300",&lt;br/&gt; &amp;nbsp; &amp;nbsp;adaptiveFrame: true&lt;br/&gt;}&lt;br/&gt;windowContainer1.createWindow(winObj);'
    		style="padding:10px; padding-bottom:20px; text-align:left; font-size:15px; font-weight:bolder; border:brown 1px solid; background-color:ivory; margin-bottom:10px; color:brown;"
    		tagname="">
    	</w2:textbox>
    </xf:group></body>
</html>
