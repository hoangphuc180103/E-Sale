    <body ev:onpageload="scwin.onpageload" ev:onpageunload="scwin.onpageunload">
    <xf:group id="" style="margin: 10px;">
    	<w2:textbox tagname="h1" style="color: blue;margin-bottom: 10px;" tabIndex="h1" id="textbox3" label="Open Context Menu while Maintaining Dragged Cell Selection&lt;br/&gt;" escape="false"></w2:textbox>
    	<w2:textbox tagname="h2" style="height: 23px;margin-bottom: 10px;color: blue;" id="textbox4" label="How to Use"></w2:textbox>
    	<w2:textbox style="color: blue;margin-bottom: 30px;" id="textbox5"
    		label='(First GridView)&lt;br/&gt;1-1. Select multiple cells by dragging.&lt;br/&gt;1-2. Right-click the mouse.&lt;br/&gt;1-3. Confirm that the context menu appears while cell selection is maintained. (keepDataDragSelection=“true”)&lt;br/&gt;&lt;br/&gt;(Second GridView)&lt;br/&gt;2-1. Select multiple cells by dragging.&lt;br/&gt;2-2. Right-click the mouse.&lt;br/&gt;2-3. Confirm that the cell selection is released and the context menu appears. (keepDataDragSelection=“false”)'
    		escape="false">
    	</w2:textbox>
    	<w2:textbox
    		style="padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightblue;border:none;margin-bottom: 10px;"
    		id="textbox6" label='keepDataDragSelection="true"' escape="false">
    	</w2:textbox>
    	<w2:gridView scrollByColumnAdaptive="false" rowNumVisible="" selectedRowColor="" useShiftKey="true" useCtrlOnMultisort=""
    		scrollByColumn="false" keepDefaultColumnWidth="" defaultCellHeight="20" focusMode="both" selectedCellColor="" rowStatusVisible=""
    		contextMenu="true" dataList="data:dataList1" dataDragSelect="true" style="border: solid gray 1px;margin-bottom: 10px;" id="gridView1" autoFit="allColumn"
    		visibleRowNum="5" useCtrlKey="" keepDataDragSelection="true" autoFitMinWidth="800" visibleRowNumFix="true">
    		<w2:caption style="" id="caption1" value="this is a grid caption."></w2:caption>
    		<w2:header style="" id="header1">
    			<w2:row style="" id="row1">
    				<w2:column width="70" inputType="text" style="" id="column11" value="Check" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="" id="column2" value="ID" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="" id="column9" value="Status" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="" id="column8" value="Date" displayMode="label"></w2:column>
    				<w2:column rowSpan="" colSpan="" width="70" inputType="text" style="" id="column7" value="Expense"
    					displayMode="label">
    				</w2:column>
    				<w2:column hidden="false" width="70" inputType="text" style="" id="column10" value="Income" displayMode="label">
    				</w2:column>
    				<w2:column width="70" inputType="text" style="" id="column5" value="Hobby" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="" id="column4" value="Region" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="" id="column3" value="Frequency" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="" id="column1" value="Age" displayMode="label"></w2:column>
    			</w2:row>
    		</w2:header>
    		<w2:gBody style="" id="gBody1">
    			<w2:row style="" id="row2">
    				<w2:column width="50" inputType="checkbox" style="height:20px" id="Check" value="" displayMode="label"></w2:column>
    				<w2:column width="20" inputType="text" style="height:20px" id="ID" value="" displayMode="label"></w2:column>
    				<w2:column width="50" inputType="text" style="height:20px" id="Status" value="" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="height:20px" id="Date" value="" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="height:20px" id="Expense" value="" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="height:20px" id="Income" value="" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="height:20px" id="Hobby" value="" displayMode="label"></w2:column>
    				<w2:column width="30" inputType="text" style="height:20px" id="Region" value="" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="height:20px" id="Frequency" value="" displayMode="label"></w2:column>
    				<w2:column width="30" inputType="text" style="height:20px" id="Age" value="" displayMode="label"></w2:column>
    			</w2:row>
    		</w2:gBody>
    	</w2:gridView>
    	<w2:textbox escape="false" id="textbox7" label='keepDataDragSelection="false"'
    		style="padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightblue;border:none;margin-bottom: 10px;">
    	</w2:textbox>
    	<w2:gridView autoFit="allColumn" autoFitMinWidth="800" contextMenu="true" dataDragSelect="true" dataList="data:dataList1"
    		defaultCellHeight="20" focusMode="both" id="gridView2" keepDataDragSelection="false" keepDefaultColumnWidth="" rowNumVisible=""
    		rowStatusVisible="" scrollByColumn="false" scrollByColumnAdaptive="false" selectedCellColor="" selectedRowColor=""
    		style="border: solid gray 1px;" useCtrlKey="" useCtrlOnMultisort="" useShiftKey="true" visibleRowNum="5" visibleRowNumFix="true">
    		<w2:caption id="caption2" style="" value="this is a grid caption."></w2:caption>
    		<w2:header id="header1" style="">
    			<w2:row id="row1" style="">
    				<w2:column displayMode="label" id="column11" inputType="text" style="" value="Check" width="70"></w2:column>
    				<w2:column displayMode="label" id="column2" inputType="text" style="" value="ID" width="70"></w2:column>
    				<w2:column displayMode="label" id="column9" inputType="text" style="" value="Status" width="70"></w2:column>
    				<w2:column displayMode="label" id="column8" inputType="text" style="" value="Date" width="70"></w2:column>
    				<w2:column colSpan="" displayMode="label" id="column7" inputType="text" rowSpan="" style="" value="Expense"
    					width="70">
    				</w2:column>
    				<w2:column displayMode="label" hidden="false" id="column10" inputType="text" style="" value="Income" width="70"></w2:column>
    				<w2:column displayMode="label" id="column5" inputType="text" style="" value="Hobby" width="70"></w2:column>
    				<w2:column displayMode="label" id="column4" inputType="text" style="" value="Region" width="70"></w2:column>
    				<w2:column displayMode="label" id="column3" inputType="text" style="" value="Frequency" width="70"></w2:column>
    				<w2:column displayMode="label" id="column1" inputType="text" style="" value="Age" width="70"></w2:column>
    			</w2:row>
    		</w2:header>
    		<w2:gBody id="gBody1" style="">
    			<w2:row id="row2" style="">
    				<w2:column displayMode="label" id="Check" inputType="checkbox" style="height:20px" value="" width="50"></w2:column>
    				<w2:column displayMode="label" id="ID" inputType="text" style="height:20px" value="" width="20"></w2:column>
    				<w2:column displayMode="label" id="Status" inputType="text" style="height:20px" value="" width="50"></w2:column>
    				<w2:column displayMode="label" id="Date" inputType="text" style="height:20px" value="" width="70"></w2:column>
    				<w2:column displayMode="label" id="Expense" inputType="text" style="height:20px" value="" width="70"></w2:column>
    				<w2:column displayMode="label" id="Income" inputType="text" style="height:20px" value="" width="70"></w2:column>
    				<w2:column displayMode="label" id="Hobby" inputType="text" style="height:20px" value="" width="70"></w2:column>
    				<w2:column displayMode="label" id="Region" inputType="text" style="height:20px" value="" width="30"></w2:column>
    				<w2:column displayMode="label" id="Frequency" inputType="text" style="height:20px" value="" width="70"></w2:column>
    				<w2:column displayMode="label" id="Age" inputType="text" style="height:20px" value="" width="30"></w2:column>
    			</w2:row>
    		</w2:gBody>
    	</w2:gridView>
    </xf:group></body>
</html>
