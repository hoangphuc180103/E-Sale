<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head meta_screenName="keepDataType_DataMap">
        <w2:type>COMPONENT</w2:type>
        <w2:buildDate/>
        <w2:MSA/>
        <xf:model>
            <w2:dataCollection baseNode="map">
            	<w2:dataMap baseNode="map" id="dataMap1" keepDataType="true">
            		<w2:keyInfo>
            			<w2:key id="key1" name="name1" dataType="number"></w2:key>
            			<w2:key id="key2" name="name2" dataType="number"></w2:key>
            		</w2:keyInfo>
            	</w2:dataMap>
            </w2:dataCollection>
            <w2:workflowCollection/>
        </xf:model>
        <w2:layoutInfo/>
        <w2:publicInfo method=""/>
        <script lazy="false" type="text/javascript"><![CDATA[
scwin.onpageload = function () {
    input1.setValue(111);
    input2.setValue(222);
};

scwin.trigger1_onclick = function (e) {
    var firstInput = input1.getValue();
    var secondInput = input2.getValue();
    alert(typeof (firstInput) + " & " + typeof (secondInput));

};

scwin.trigger2_onclick = function (e) {
    var firstInput = input1.getValue();
    var secondInput = input2.getValue();
    dataMap1.set("key1", firstInput);
    dataMap1.set("key2", secondInput);
};

scwin.trigger3_onclick = function (e) {
    var first = dataMap1.get("key1");
    var second = dataMap1.get("key2");
    alert(typeof (first) + " & " + typeof (second));

};
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload">
    	<xf:group id="" style="margin: 10px;">
    		<w2:textbox tagname="h1" style="color: blue;margin-bottom: 10px;" tabIndex="h1" id="textbox1"
    			label="Set String Type Data to Number Type in DataMap&lt;br/&gt;" escape="false">
    		</w2:textbox>
    		<w2:textbox tagname="h2" style="height: 23px;margin-bottom: 10px;color: blue;" id="textbox2" label="How to Use"></w2:textbox>
    		<w2:textbox style="color: blue;margin-bottom: 30px;" id="textbox3"
    			label="1. Click the first button to verify that the dataType of the data entered in the top InputBox is “string”.&lt;br/&gt;2. Click the second button to set the data above, now defined as string type, to the DataMap bound to the bottom InputBox. &lt;br/&gt;3. Click the third button to verify that the dataType of the data set above has been converted to “number”.&lt;br/&gt;(See the Script tab for detailed script.)"
    			escape="false">
    		</w2:textbox>
    		<w2:textbox escape="false" id="textbox4"
    			label='keepDataType="true" (DataMap)&lt;br/&gt;dataType="number" (dataList.key - key1 &amp; key2)'
    			style="padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightblue;border:none;margin-bottom: 10px;">
    		</w2:textbox>
    	</xf:group>
    	<xf:group id="" style="margin: 10px;">
    		<xf:group id="" style="margin-bottom: 10px;"><xf:input style="width:140px;height:30px;padding:5px;text-align:left;font-size:20px;font-family:consolas;font-style:normal;font-weight:bolder;color: blue;" id="input1">
    		</xf:input><xf:input style="width:140px;height:30px;padding:5px;text-align:left;font-size:20px;font-family:consolas;font-style:normal;font-weight:bolder;margin-left: 20px;color: purple;" id="input2">
    		</xf:input></xf:group><xf:trigger ev:onclick="scwin.trigger1_onclick"
    			style="height:42px;line-height:32px;padding:5px;background-color:coral;font-size:15px;weight: bolder;font-weight:bolder;text-align: left;margin-bottom: 10px;"
    			id="trigger1" type="button">
    			<xf:label><![CDATA[1. typeof() InputBox]]></xf:label>
    		</xf:trigger>
    		<xf:trigger ev:onclick="scwin.trigger2_onclick"
    			style="height:42px;line-height:32px;padding:5px;background-color:coral;font-size:15px;weight: bolder;font-weight:bolder;text-align: left;margin-bottom: 10px;"
    			id="trigger2" type="button">
    			<xf:label><![CDATA[2. dataMap1.set();]]></xf:label>
    		</xf:trigger>
    		<xf:trigger ev:onclick="scwin.trigger3_onclick"
    			style="height:42px;line-height:32px;padding:5px;background-color:coral;font-size:15px;weight: bolder;font-weight:bolder;text-align: left;margin-bottom: 10px;"
    			id="trigger3" type="button">
    			<xf:label><![CDATA[3. typeof() DataMap]]></xf:label>
    		</xf:trigger>
    	<xf:group id=""><xf:input ref="data:dataMap1.key1" style="width:140px;height:30px;padding:5px;text-align:left;font-size:20px;border: solid coral 2px;font-family:consolas;font-style:normal;font-weight:bolder;color: blue;" id="input3">
    		</xf:input><xf:input ref="data:dataMap1.key2" style="width:140px;height:30px;padding:5px;text-align:left;font-size:20px;border: solid coral 2px;font-style:normal;font-weight:bolder;margin-left: 20px;color: purple;" id="input4">
    		</xf:input></xf:group></xf:group>
    </body>
</html>
