    					<w2:column dataType="text" id="EMP_TITLE" name="Title"></w2:column>
    					<w2:column dataType="text" id="EMP_NAME" name="Name"></w2:column>
    					<w2:column dataType="text" id="EMP_DEPT" name="Department"></w2:column>
    					<w2:column dataType="text" id="NOTE" name="Note"></w2:column>
    					<w2:column dataType="text" id="EMP_TYPE" name="Type"></w2:column>
    					<w2:column dataType="text" id="EMP_POSITION" name="Position"></w2:column>
    					<w2:column dataType="text" id="EMP_EMAIL" name=" Email"></w2:column>
    					<w2:column dataType="text" id="EMP_PHONE" name="Phone"></w2:column>
    					<w2:column dataType="text" id="EMP_JOIN_DATE" name="Joining Date"></w2:column>
    				</w2:columnInfo>
    				<w2:data use="false"></w2:data>
    			</w2:dataList>
    			<w2:dataList baseNode="list" repeatNode="map" id="dlt_dept">
    				<w2:columnInfo>
    					<w2:column id="code" name="code" dataType="text"></w2:column>
    					<w2:column id="name" name="name" dataType="text"></w2:column>
    				</w2:columnInfo>
