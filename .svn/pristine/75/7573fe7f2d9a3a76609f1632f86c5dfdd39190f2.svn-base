define({declaration:{A:{version:'1.0',encoding:'UTF-8'}},E:[{T:1,N:'html',A:{xmlns:'http://www.w3.org/1999/xhtml','xmlns:ev':'http://www.w3.org/2001/xml-events','xmlns:w2':'http://www.inswave.com/websquare','xmlns:xf':'http://www.w3.org/2002/xforms'},E:[{T:1,N:'head',E:[{T:1,N:'w2:type',E:[{T:3,text:'DEFAULT'}]},{T:1,N:'w2:buildDate'},{T:1,N:'xf:model',E:[{T:1,N:'w2:dataCollection',A:{baseNode:'map'}},{T:1,N:'w2:workflowCollection'}]},{T:1,N:'script',A:{type:'text/javascript',lazy:'false'},E:[{T:4,cdata:function(scopeObj){with(scopeObj){scwin.onpageload = function () {
  const tmpSrc = scwin.getfolderPath() + "/wframe_01.xml";
  wframe1.setSrc(tmpSrc);
};
scwin.onpageunload = function () {};
scwin.getfolderPath = function () {
  var currentPath = window.location.href;
  var folderPath;
  if (currentPath.includes("mainContainer")) {
    console.log("true  ===> " + $p.getFrameId());
    const cmtFrame = $p.getComponentById($p.getFrameId());
    currentPath = cmtFrame.getSrc();
    folderPath = currentPath.substring(0, currentPath.lastIndexOf('/'));
  } else {
    console.log("false  ===> ");
    folderPath = currentPath.split('w2xPath=')[1].substring(0, currentPath.split('w2xPath=')[1].lastIndexOf('/'));
  }
  return folderPath;
};
}}}]}]},{T:1,N:'body',A:{'ev:onpageload':'scwin.onpageload','ev:onpageunload':'scwin.onpageunload'},E:[{T:1,N:'xf:group',A:{id:'',style:'margin: 10px;'},E:[{T:1,N:'w2:textbox',A:{tagname:'h1',style:'color: blue;margin-bottom: 10px;',id:'textbox1',label:'Create Frame-based Modal Popup<br/>',escape:'false'}},{T:1,N:'w2:textbox',A:{tagname:'h2',style:'height: 23px;margin-bottom: 10px;color: blue;',id:'textbox2',label:'How to Use'}},{T:1,N:'w2:textbox',A:{style:'color: blue;margin-bottom: 30px;',id:'textbox3',label:'1. Select the frameModal option for the openPopup() method in the innermost frame. (“frame”, ‘parent’, “top”, frame ID)<br/>2. Click the $p.openPopup() button inside the window.<br/>3. Verify the popup\'s display scope based on the selected option.<br/><br/>The behavior based on the frameModal option value is as follows:<br/> &nbsp; &nbsp;“frame” : Displays as a modal popup inside the specified frame. <br/> &nbsp; &nbsp;“parent”: Displays as a modal popup inside the parent frame.<br/> &nbsp; &nbsp;“top”: Displays as a modal popup covering the entire screen.<br/> &nbsp; &nbsp;Frame ID: Displays as a modal popup inside the specified frame. (In the example, the frame ID is obtained via $p.getFrame().getParentFrame().getParentFrame().id.)',escape:'false'}},{T:1,N:'w2:wframe',A:{style:'border: gray solid 1px;',id:'wframe1'}}]}]}]}]})