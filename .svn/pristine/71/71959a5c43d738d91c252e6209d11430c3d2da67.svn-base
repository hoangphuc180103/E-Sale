define({declaration:{A:{version:'1.0',encoding:'UTF-8'}},E:[{T:1,N:'html',A:{xmlns:'http://www.w3.org/1999/xhtml','xmlns:ev':'http://www.w3.org/2001/xml-events','xmlns:w2':'http://www.inswave.com/websquare','xmlns:xf':'http://www.w3.org/2002/xforms'},E:[{T:1,N:'head',A:{},E:[{T:1,N:'w2:type',E:[{T:3,text:'COMPONENT'}]},{T:1,N:'w2:buildDate'},{T:1,N:'w2:MSA'},{T:1,N:'xf:model',E:[{T:1,N:'w2:workflowCollection'}]},{T:1,N:'w2:layoutInfo'},{T:1,N:'w2:publicInfo',A:{method:''}},{T:1,N:'script',A:{lazy:'false',type:'text/javascript'},E:[{T:4,cdata:function(scopeObj){with(scopeObj){scwin.onpageload = function () {
  scwin.initPage();
};
scwin.initPage = function () {
  //프로젝트의 웹스퀘어 엔진 권장 버전
  tbx_recVersion.setValue($c.frame.getConst($p, "WRE_RECOMMENDED_ENGINE_VERSION") || "6.0_0.1028B.20240326.140004");

  //실행된 엔진 버전 셋팅
  tbx_engineVersion.setValue("현재 엔진 버전 : " + WebSquare.text.BASE64Decode(WebSquare.ver));
  let objIframe = document.getElementById(ifm_history.getID());
  objIframe.onload = scwin.ifm_history_onload_handler;
  ifm_history.setSrc("/doc/component/history.html");
};
scwin.openRefSite = function () {
  let strLink = this.getUserData("userData1");
  if (strLink) {
    if (strLink.indexOf("http") == -1 && strLink.lastIndexOf(".xml") > -1) {
      $p.main().scwin.openPage(strLink);
    } else {
      window.open(strLink, "_blank");
    }
  } else {
    alert("준비중 입니다.");
  }
};

/**
 * 문서이력 iframe onload 이벤트 핸들러
*/
scwin.ifm_history_onload = function (e) {
  window.setTimeout(scwin.ifm_history_onload_handler, 100);
};

/**
 * 문서이력 iframe onload 이벤트 핸들러
*/
scwin.ifm_history_onload_handler = function (e) {
  var objWin;
  var strSrc;
  var objLink;
  var eleContent;
  var i, i_max, item;
  var strIframeHref;
  strSrc = ifm_history.getSrc();
  objWin = ifm_history.getWindow();

  //css 추가
  objLink = document.createElement('link');
  objLink.rel = 'stylesheet';
  objLink.type = 'text/css';
  objLink.href = $c.frame.getSrc($p, '/frame/css/wre_doc.css') + "?" + $c.frame.getConst($p, "WRE_VER_WS5_EXAMPLE_DOC_CSS");
  objWin.document.getElementsByTagName('head')[0].appendChild(objLink);
  eleContent = objWin.document.body.firstChild;
  if (!eleContent || !eleContent.classList) {
    let arrAnchor = objWin.document.getElementsByTagName('a') || [];
    let regExp_class = new RegExp("link|reference");
    for (i = 0, i_max = arrAnchor.length; i < i_max; i++) {
      item = arrAnchor[i];
      item.id = arrAnchor[i];
      item.href = "#";
      arrAnchor[i].addEventListener('click', function (event) {
        scwin.ifm_history_onClick(this.id);
      });
    } //end for 	
  }
};
scwin.ifm_history_onClick = async function (history_url) {
  //xml 파일은 예제(샘플,WRE) 개별 파일  
  if (/\.xml$/i.test(history_url)) {
    if (history_url.includes("/guide/")) {
      $p.main().scwin.dispPage3("", "샘플", history_url, true);
    } else {
      $p.main().scwin.dispPage3("", "WRE", history_url, true);
    }
  } else {
    var parts = history_url.split("/");
    var _path = parts[parts.length - 1];
    _path = _path.split(".")[0];
    var jsnMenu;
    if (!_path) {
      return;
    }
    jsnMenu = $p.main().scwin.menu.getMenuByPage(_path);
    if ($p.main().scwin.gVar.WRE_MAIN_TYPE == "M") {
      //console.log("jsnMenu  history_url >> ", history_url);
      //$p.main().scwin.pageDoc("", "WRE", history_url, true); 
      await $p.main().scwin.pageDoc(jsnMenu.TITLE_KO, _path);
    } else {
      //xhtml 파일은 컴포넌트 목록 파일이라 page_doc을 제공  
      if (!history_url || typeof history_url !== "string") return null;
      await $p.main().tac_main.addTab("tabDoc_" + _path, {
        "label": jsnMenu.TITLE_KO,
        "closable": "true",
        "openAction": "select"
      }, {
        "src": "/frame/page/page_doc.xml",
        "scope": true,
        "frameMode": "pageFrame",
        "dataObject": {
          "type": "json",
          "name": "tabParam",
          "data": {
            "compName": jsnMenu.TITLE_KO,
            "path": _path
          }
        }
      });
      $p.main().tac_main.setSelectedTabIndex($p.main().tac_main.getTabIndex("tabDoc_" + _path));
    }
  }
};
}}}]}]},{T:1,N:'body',A:{'ev:onpageload':'scwin.onpageload'},E:[{T:1,N:'xf:group',A:{style:'',id:'',class:'intro'},E:[{T:1,N:'xf:group',A:{class:'int_top',id:'',style:''},E:[{T:1,N:'xf:group',A:{class:'bg_wrap',id:'',style:''},E:[{T:1,N:'w2:textbox',A:{class:'txt_big',escape:'false',id:'',label:'컴포넌트 예제 모음 (WRE)',style:''}},{T:1,N:'w2:textbox',A:{class:'txt_small wifi',escape:'false',id:'',label:'네트워크의 사용이 불가능한 환경에서도 지원',style:''}},{T:1,N:'w2:textbox',A:{class:'txt_small server',escape:'false',id:'',label:'서버의 구성 없이 스튜디오에서 실행 가능',style:''}},{T:1,N:'xf:group',A:{class:'ban_box',id:'',style:''},E:[{T:1,N:'xf:group',A:{class:'anc_banner ico1',id:'',style:'',tagname:'a'},E:[{T:1,N:'w2:attributes',E:[{T:1,N:'w2:href',E:[{T:3,text:'http://wtech.inswave.com'}]},{T:1,N:'w2:target',E:[{T:3,text:'_blank'}]}]},{T:1,N:'w2:textbox',A:{escape:'false',id:'',label:'W-Tech Center<br/>개발자 포털',style:'',tagname:'p'}},{T:1,N:'w2:textbox',A:{escape:'false',id:'',label:'바로가기',style:'',tagname:'span'}}]},{T:1,N:'xf:group',A:{class:'anc_banner ico2',id:'',style:'',tagname:'a'},E:[{T:1,N:'w2:attributes',E:[{T:1,N:'w2:href',E:[{T:3,text:'https://docs1.inswave.com/ai_user_guide'}]},{T:1,N:'w2:target',E:[{T:3,text:'_blank'}]}]},{T:1,N:'w2:textbox',A:{escape:'false',id:'',label:'WebSquare AI <br/>개발가이드',style:'',tagname:'p'}},{T:1,N:'w2:textbox',A:{escape:'false',id:'',label:'바로가기',style:'',tagname:'span'}}]},{T:1,N:'xf:group',A:{class:'anc_banner ico3',id:'',style:'',tagname:'a'},E:[{T:1,N:'w2:attributes',E:[{T:1,N:'w2:href',E:[{T:3,text:'https://docs.inswave.com/websquare/websquare.html?w2xPath=/support/api/ws5_sp5/api.xml'}]},{T:1,N:'w2:target',E:[{T:3,text:'_blank'}]}]},{T:1,N:'w2:textbox',A:{escape:'false',id:'',label:'WebSquare AI <br/>API',style:'',tagname:'p'}},{T:1,N:'w2:textbox',A:{escape:'false',id:'',label:'바로가기',style:'',tagname:'span',userData1:'https://docs.inswave.com/websquare/websquare.html?w2xPath=/support/api/ws5_sp5/api.xml'}}]},{T:1,N:'xf:group',A:{class:'anc_banner ico4',s