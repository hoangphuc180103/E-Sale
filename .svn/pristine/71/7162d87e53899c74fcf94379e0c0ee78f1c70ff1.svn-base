<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
         <script type="text/javascript" lazy="false"><![CDATA[
        
	scwin.onpageload = function() {
		
	};
	
	scwin.onpageunload = function() {
		
	};
	
	]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload" ev:onpageunload="scwin.onpageunload">
    <xf:group id="" style="margin: 10px;">
    	<w2:textbox tagname="h1" style="color: blue;margin-bottom: 10px;" tabIndex="h1" id="textbox1" label="カレンダー曜日をテキストまたは画像として表示"
    		escape="false">
    	</w2:textbox>
    	<w2:textbox tagname="h2" style="height: 23px;margin-bottom: 10px;color: blue;" id="textbox2" label="サンプルの使い方"></w2:textbox>
    	<w2:textbox style="color: blue;margin-bottom: 30px;" id="textbox3"
    		label='（最初の InputCalendar の場合）&lt;br/&gt;1.カレンダーのアイコンをクリックします。 &lt;br/&gt;2.マウスをドラッグして「日月火水木金土」曜日部分がテキストで選択されることを確認。 (dislayDayType="text")&lt;br/&gt;&lt;br/&gt;（2 番目の InputCalendar の場合）&lt;br/&gt;1.カレンダーのアイコンをクリックします。 &lt;br/&gt;2.マウスをドラッグして、曜日の部分が画像として表示され、テキストとして選択されていないことを確認します。 (dislayDayType="image")'
    		escape="false">
    	</w2:textbox>
    	<w2:textbox
    		style="padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightblue;border:none;margin-bottom: 10px;"
    		id="textbox4" label='プロパティの設定&lt;br/&gt;displayDayType="text"' escape="false">
    	</w2:textbox>
    	<w2:inputCalendar footerDiv="false" displayDayType="text" focusOnDateSelect="false" autoFocus="false"
    		calendarValueType="yearMonthDate" nextTabID="" rightAlign="false" ev:onkeyup="scwin.cal1_onkeyup"
    		ev:onviewchange="scwin.cal1_onviewchange" editType="select" style="margin-bottom: 10px;" id="inputCalendar1" renderType="component" renderDiv="true"
    		monthNames="Jan, Feb, Mar, Apr, May, Jun, Jul, Aug, Sep, Oct, Nov, Dec" yearSuffix="Y">
    	</w2:inputCalendar>
    	<w2:textbox escape="false" id="textbox5" label='プロパティの設定&lt;br/&gt;displayDayType="image"'
    		style="padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightblue;border:none;margin-bottom: 10px;">
    	</w2:textbox>
    	<w2:inputCalendar autoFocus="false" calendarValueType="yearMonthDate" displayDayType="image" ev:onkeyup="scwin.cal1_onkeyup" ev:onviewchange="scwin.cal1_onviewchange" focusOnDateSelect="false" footerDiv="false"
    		id="inputCalendar2" monthNames="Jan, Feb, Mar, Apr, May, Jun, Jul, Aug, Sep, Oct, Nov, Dec" nextTabID="" renderDiv="true"
    		renderType="component" rightAlign="false" style="" yearSuffix="Y" editType="select">
    	</w2:inputCalendar>
    </xf:group></body>
</html>
