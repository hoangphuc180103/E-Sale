define({declaration:{A:{version:'1.0',encoding:'UTF-8'}},E:[{T:1,N:'html',A:{xmlns:'http://www.w3.org/1999/xhtml','xmlns:ev':'http://www.w3.org/2001/xml-events','xmlns:w2':'http://www.inswave.com/websquare','xmlns:xf':'http://www.w3.org/2002/xforms'},E:[{T:1,N:'head',A:{},E:[{T:1,N:'w2:type',E:[{T:3,text:'COMPONENT'}]},{T:1,N:'w2:buildDate'},{T:1,N:'w2:MSA'},{T:1,N:'xf:model',E:[{T:1,N:'w2:dataCollection',A:{baseNode:'map'},E:[{T:1,N:'w2:dataList',A:{baseNode:'list',repeatNode:'map',id:'dlt_cssFileList',saveRemovedData:'true'},E:[{T:1,N:'w2:columnInfo',E:[{T:1,N:'w2:column',A:{id:'label',name:'name1',dataType:'text'}},{T:1,N:'w2:column',A:{id:'path',name:'name2',dataType:'text'}}]},{T:1,N:'w2:data',A:{use:'true'},E:[{T:1,N:'w2:row',E:[{T:1,N:'path',E:[{T:4,cdata:'style'}]},{T:1,N:'label',E:[{T:4,cdata:'내부 internalStyle'}]}]},{T:1,N:'w2:row',E:[{T:1,N:'path',E:[{T:4,cdata:'/css/example.css'}]},{T:1,N:'label',E:[{T:4,cdata:'[예제별 예시] /css/example.css'}]}]},{T:1,N:'w2:row',E:[{T:1,N:'path',E:[{T:4,cdata:'/cm/css/base.css'}]},{T:1,N:'label',E:[{T:4,cdata:'[공통]/cm/css/base.css'}]}]},{T:1,N:'w2:row',E:[{T:1,N:'path',E:[{T:4,cdata:'/cm/css/contents.css'}]},{T:1,N:'label',E:[{T:4,cdata:'[공통]/cm/css/contents.css'}]}]},{T:1,N:'w2:row',E:[{T:1,N:'path',E:[{T:4,cdata:'/frame/css/wre.css'}]},{T:1,N:'label',E:[{T:4,cdata:'[공통]/frame/css/wre.css'}]}]}]}]}]},{T:1,N:'w2:workflowCollection'}]},{T:1,N:'w2:layoutInfo'},{T:1,N:'w2:publicInfo',A:{method:''}},{T:1,N:'script',A:{lazy:'false',type:'text/javascript'},E:[{T:4,cdata:function(scopeObj){with(scopeObj){scwin.gVar = {
