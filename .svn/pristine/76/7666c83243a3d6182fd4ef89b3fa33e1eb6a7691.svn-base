define({declaration:{A:{version:'1.0',encoding:'UTF-8'}},E:[{T:1,N:'html',A:{xmlns:'http://www.w3.org/1999/xhtml','xmlns:ev':'http://www.w3.org/2001/xml-events','xmlns:w2':'http://www.inswave.com/websquare','xmlns:xf':'http://www.w3.org/2002/xforms'},E:[{T:1,N:'head',A:{},E:[{T:1,N:'w2:type',E:[{T:3,text:'COMPONENT'}]},{T:1,N:'w2:buildDate'},{T:1,N:'w2:MSA'},{T:1,N:'xf:model',E:[{T:1,N:'w2:dataCollection',A:{baseNode:'map'}},{T:1,N:'w2:workflowCollection'}]},{T:1,N:'w2:layoutInfo'},{T:1,N:'w2:publicInfo',A:{method:''}},{T:1,N:'script',A:{lazy:'false',type:'text/javascript'},E:[{T:4,cdata:function(scopeObj){with(scopeObj){scwin.onpageload = function () {};
}}}]}]},{T:1,N:'body',A:{'ev:onpageload':'scwin.onpageload'},E:[{T:1,N:'xf:group',A:{style:'',id:'',class:'ws_example_grp_desc'},E:[{T:1,N:'xf:group',A:{tagname:'details',style:'',id:'',class:''},E:[{T:1,N:'w2:textbox',A:{tagname:'summary',style:'',id:'',label:'실습 목표',escape:'false'}},{T:1,N:'w2:textbox',A:{style:'',id:'',label:'1. 개요<br/>본 화면은 PageFrame 컴포넌트를 활용하는 실습 화면입니다. <br/>1. pageFrame 사용하는 방법<br/>2. pageFrame 은 화면 loading이 완전히 끝난후 다음 함수가 수행되도록 async, await 문법을 사용해야 합니다.<br/>3. pageFrame 간의 데이터 참조하는 방법',class:'',escape:'false'}}]},{T:1,N:'xf:group',A:{tagname:'details',style:'',id:'',class:''},E:[{T:1,N:'w2:textbox',A:{tagname:'summary',style:'',id:'',label:'실습 방법',escape:'false'}},{T:1,N:'w2:textbox',A:{style:'',id:'',label:'1. 추가 되어 있는 PageFrame 에 다른 화면 페이지를 구성 할수 있습니다.<br/> &nbsp;1) <b>[속성 활용]</b>Component View 에서 속성 src 에 아래와 같은 속성을 넣습니다.<br/> &nbsp; &nbsp; &nbsp;ex) /edu/adv/pageFrame_child_1.xml<br/> &nbsp;2) pageFrame 영역에 넣고자하는 파일을 Project View 에서 찾아 drag&drop 한다. <br/> &nbsp;3) <b>[API 활용]</b> setSrc() API로 동적으로 화면 구성<br/> &nbsp; &nbsp; ex) pageFrame1.setSrc("/edu/adv/pageFrame_child_2.xml");<br/> &nbsp; &nbsp; <br/>2. async, await 사용(차이점 알기)<br/> &nbsp; 1) setSrc적용(async)<br/> &nbsp; 2) setSrc적용<br/><br/>3. pageFrame 간의 화면 참조 <br/> &nbsp; 1) 부모 &nbsp; -> 자식 : pageFrame1.getWindow(); pageFrame 화면 안의 객체를 접근하려면 이 함수를 호출함<br/> &nbsp; 2) 자식 &nbsp; -> 부모 : $p.parent();<br/> &nbsp; 3) 자식1 -> 자식2<br/>',class:'',escape:'false'}}]}]}]}]}]})