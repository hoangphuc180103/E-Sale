<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head meta_screenName="addWidgets_titleClass_WidgetContainer">
    	<w2:type>DEFAULT</w2:type>
    	<w2:buildDate />
    	<xf:model>
    		<xf:instance>
    			<data xmlns="" />
    		</xf:instance>
    		<w2:dataCollection baseNode="map">
    		</w2:dataCollection>
    		<w2:workflowCollection></w2:workflowCollection>
    	</xf:model>

         <script type="text/javascript" lazy="false"><![CDATA[
scwin.count = 0;
scwin.onpageload = function () {

};
scwin.onpageunload = function () {

};


scwin.trigger1_onclick = function (e) {
    scwin.count++;
    widgetContainer1.addWidgets({
        id: "widget" + scwin.count,
        title: "Widget_Red_" + scwin.count + "_",
        src: null,
        scope: true,
        x: 0,
        y: 0,
        unitWidth: 1,
        unitHeight: 1,
        titleClass: "w2widget_red"
    });
    scwin.count++;
    widgetContainer1.addWidgets({
        id: "widget" + scwin.count,
        title: "Widget_Blue_" + scwin.count + "_",
        src: null,
        scope: true,
        x: 0,
        y: 1,
        unitWidth: 1,
        unitHeight: 1,
        titleClass: "w2widget_orange"
    });
    scwin.count++;
    widgetContainer1.addWidgets({
        id: "widget" + scwin.count,
        title: "Widget_Green_" + scwin.count + "_",
        src: null,
        scope: true,
        x: 1,
        y: 0,
        unitWidth: 1,
        unitHeight: 2,
        titleClass: "w2widget_green"
    });
};
]]></script>
    	<style type="text/css"><![CDATA[
.w2widget_red{
        background-color: red;
        height: 50px;
        color: white;
    }
    
    .w2widget_orange{
        background-color: orange;
        color: greenyellow;
    }
    
    .w2widget_green{
        background-color: green;
        color: yellow;
    }]]></style>
    </head>
    <body ev:onpageload="scwin.onpageload" ev:onpageunload="scwin.onpageunload">
    <xf:group id="" style="margin: 10px;"><w2:textbox tagname="h1" style="color: blue;margin-bottom: 10px;" tabIndex="h1" id="textbox1" label="위젯 타이틀에 스타일 적용" escape="false"></w2:textbox><w2:textbox tagname="h2" style="height: 23px;margin-bottom: 10px;color: blue;" id="textbox2" label="샘플 사용 방법"></w2:textbox><w2:textbox style="color: blue;margin-bottom: 30px;" id="textbox3" label='1. Script 탭에서 addWidgets() 메소드의 titleClass 옵션 설정을 확인. &lt;br/&gt;2. 하단의 addWidgets() 버튼을 클릭. &lt;br/&gt;2. 세 개의 위젯이 추가되고, titleClass 옵션으로 설정한 CSS 클래스에 따라 위젯 타이틀에 아이콘이 표시되는 것을 확인.&lt;br/&gt;(상세한 스크립트는 Script 탭과 CSS 탭에서에서 확인.)' escape="false">
    	</w2:textbox><xf:trigger ev:onclick="scwin.trigger1_onclick" style="height:42px;line-height:32px;padding:5px;background-color:coral;font-size:15px;weight: bolder;font-weight:bolder;text-align: left;display: block;margin-bottom: 10px;" id="trigger1" type="button">
    		<xf:label><![CDATA[addWidgets( options.titleClass );]]></xf:label>
    	</xf:trigger><w2:widgetContainer unitHeightPixel="100" accessibility="true" minUnitWidth="1" verticalMargin="5" threshold="500" rows="3" unfixedTitleButtons="true" params="false" processMsgFrame="true" widgetResize="true" mode="switch" preventMaximizeByTitle="false" widgetMove="true" style="height: 400px;border:1px solid black;" id="widgetContainer1" horizontalMargin="14" cols="3">
    	</w2:widgetContainer></xf:group></body>
</html>