<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head meta_screenName="inputType_select_emptyItem_emptyValue_gridView_column">
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            	<w2:dataList baseNode="list" repeatNode="map" id="dataList1" saveRemovedData="true">
            		<w2:columnInfo>
            			<w2:column id="select1" name="select1" dataType="text"></w2:column>
            			<w2:column id="select2" name="select2" dataType="text"></w2:column>
            			<w2:column id="select3" name="select3" dataType="text"></w2:column>
            		</w2:columnInfo>
            		<w2:data use="true">
            			<w2:row>
            				<select1><![CDATA[001]]></select1>
            				<select2><![CDATA[001]]></select2>

            				
            				<select3><![CDATA[001]]></select3>
            			</w2:row>
            			<w2:row>
            				<select1><![CDATA[002]]></select1>
            				<select2><![CDATA[002]]></select2>

            				
            				<select3><![CDATA[002]]></select3>
            			</w2:row>
            			<w2:row>
            				<select1><![CDATA[003]]></select1>
            				<select2><![CDATA[003]]></select2>

            				
            				<select3><![CDATA[003]]></select3>
            			</w2:row>
            			<w2:row>
            				<select1><![CDATA[004]]></select1>
            				<select2><![CDATA[004]]></select2>

            				
            				<select3><![CDATA[004]]></select3>
            			</w2:row>
            			<w2:row>
            				<select1><![CDATA[005]]></select1>
            				<select2><![CDATA[005]]></select2>

            				
            				<select3><![CDATA[005]]></select3>
            			</w2:row>
            		</w2:data>
            	</w2:dataList>
            	<w2:dataList baseNode="list" repeatNode="map" id="select" saveRemovedData="true">
            		<w2:columnInfo>
            			<w2:column id="label" name="name2" dataType="text"></w2:column>
            			<w2:column id="value" name="name2" dataType="text"></w2:column>
            		</w2:columnInfo>
            		<w2:data use="true">
            			<w2:row>
            				<label><![CDATA[Bangkok]]></label>
            				<value><![CDATA[001]]></value>
            			</w2:row>
            			<w2:row>
            				<label><![CDATA[Danang]]></label>
            				<value><![CDATA[002]]></value>
            			</w2:row>
            			<w2:row>
            				<label><![CDATA[Hanoi]]></label>
            				<value><![CDATA[003]]></value>
            			</w2:row>
            			<w2:row>
            				<label><![CDATA[Seoul]]></label>
            				<value><![CDATA[004]]></value>
            			</w2:row>
            			<w2:row>
            				<label><![CDATA[Tokyo]]></label>
            				<value><![CDATA[005]]></value>
            			</w2:row>
            		</w2:data>
            	</w2:dataList>
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
         <script type="text/javascript" lazy="false"><![CDATA[

scwin.onpageload = function () {

};

scwin.onpageunload = function () {

};


scwin.trigger1_onclick = function (e) {
    dataList1.setData(["aaa", "bbb", "ccc"], true);
};

scwin.trigger2_onclick = function (e) {
    var blankShow = dataList1.getRowData(5);
    alert(blankShow);

};
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload" ev:onpageunload="scwin.onpageunload">
    	<xf:group id="" style="margin: 10px;">
    		<w2:textbox tagname="h1" style="color: blue;margin-bottom: 10px;" tabIndex="h1" id="textbox2" label="Dynamically Set Value Not in Selection List (inputType='select')&lt;br/&gt;" escape="false"></w2:textbox>
    		<w2:textbox tagname="h2" style="height: 23px;margin-bottom: 10px;color: blue;" id="textbox3" label="How to Use"></w2:textbox>
    		<w2:textbox style="color: blue;margin-bottom: 30px;" id="textbox4" label="1. Click the first button to set a value not present in the SelectBox's options.&lt;br/&gt;2. Click the arrow in each column and verify the following behavior:&lt;br/&gt; &amp;nbsp; (1) First column (emptyItem=“false”): The first value in the list is displayed and selected. &lt;br/&gt; &amp;nbsp; (2) Second column (emptyItem=“true”): A blank space is displayed.&lt;br/&gt; &amp;nbsp; (3) Third column (emptyItem=“true” emptyValue=&quot;xxx&quot;): A blank space is displayed. &lt;br/&gt;3. Click the second button or press Ctrl + right-click to select the “View dataCollection” menu.&lt;br/&gt;4. Confirm that [First value in the selection list, “”, “xxx”, ‘ddd’] is set in the “dataList1” bound to the GridView." escape="false">
    	</w2:textbox>
    		<w2:textbox style="padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightblue;border:none;margin-bottom: 10px;" id="textbox5" label='emptyItem="false" &amp;nbsp;(col1 Column)&lt;br/&gt;emptyItem="true" (col2 Column)&lt;br/&gt;emptyItem="true" emptyValue="xxx" (col3 Column)' escape="false">
    	</w2:textbox>
    		<xf:trigger type="button" id="trigger1"
    			style="height:42px;line-height:32px;padding:5px;background-color:coral;font-size:15px;weight: bolder;font-weight:bolder;text-align: left;display: block;margin-bottom: 10px;"
    			ev:onclick="scwin.trigger1_onclick">
    			<xf:label><![CDATA[dataList1.setData(["aaa", "bbb", "ccc"], true);]]></xf:label>
    		</xf:trigger>
    		<xf:trigger type="button" id="trigger2"
    			style="height:42px;line-height:32px;padding:5px;background-color:coral;font-size:15px;weight: bolder;font-weight:bolder;text-align: left;display: block;margin-bottom: 10px;"
    			ev:onclick="scwin.trigger2_onclick">
    			<xf:label><![CDATA[dataList1.getRowData(5);]]></xf:label>
    		</xf:trigger>
    		<w2:gridView scrollByColumnAdaptive="false" dataList="data:dataList1" style="border: solid gray 1px;" scrollByColumn="false"
    			id="gridView1" autoFit="allColumn" defaultCellHeight="20" copyOption="display" rowNumVisible="true" visibleRowNum="10"
    			visibleRowNumFix="true">
    			<w2:caption style="" id="caption2" value="this is a grid caption."></w2:caption>
    			<w2:header style="" id="header2">
    				<w2:row style="" id="row3">
    					<w2:column width="70" inputType="text" style="" id="column10" value="select1" displayMode="label"></w2:column>
    					<w2:column width="70" inputType="text" style="" id="column9" value="select2" displayMode="label"></w2:column>
    					<w2:column width="70" inputType="text" style="" id="column8" value="select3" displayMode="label"></w2:column>
    				</w2:row>
    			</w2:header>
    			<w2:gBody style="" id="gBody2">
    				<w2:row style="" id="row4">
    					<w2:column ref="" chooseOption="" width="70" emptyItem="false" viewType="icon" inputType="select" style=""
    						id="select1" allOption="" value="" displayMode="label">
    						<w2:choices>
    							<w2:itemset nodeset="data:select">
    								<w2:label ref="label"></w2:label>
    								<w2:value ref="value"></w2:value>
    							</w2:itemset>
    						</w2:choices>
    					</w2:column>
    					<w2:column ref="" chooseOption="" width="70" emptyItem="true" viewType="icon" inputType="select" style=""
    						id="select2" allOption="" value="" displayMode="value">
    						<w2:choices>
    							<w2:itemset nodeset="data:select">
    								<w2:label ref="label"></w2:label>
    								<w2:value ref="value"></w2:value>
    							</w2:itemset>
    						</w2:choices>
    					</w2:column>
    					<w2:column ref="" emptyValue="xxx" chooseOption="" width="70" emptyItem="true" viewType="icon" inputType="select"
    						style="" id="select3" allOption="" value="" displayMode="label delim value">
    						<w2:choices>
    							<w2:itemset nodeset="data:select">
    								<w2:label ref="label"></w2:label>
    								<w2:value ref="value"></w2:value>
    							</w2:itemset>
    						</w2:choices>
    					</w2:column>
    				</w2:row>
    			</w2:gBody>
    		</w2:gridView>
    	</xf:group>
    </body>
</html>
