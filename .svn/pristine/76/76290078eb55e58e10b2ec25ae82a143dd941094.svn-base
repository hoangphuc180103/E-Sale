<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet href="/2019-09/Components/gridview.css" type="text/css"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
        	<xf:instance>
        		<data xmlns="" />
        	</xf:instance>
        	<w2:dataCollection baseNode="map">
        		<w2:dataList baseNode="list" repeatNode="map" id="dataList1" saveRemovedData="true">
        			<w2:columnInfo>
        				<w2:column id="Check" name="Check" dataType="text"></w2:column>
        				<w2:column id="ID" name="ID" dataType="text"></w2:column>
        				<w2:column id="Age" name="Age" dataType="text"></w2:column>
        				<w2:column id="Status" name="Status" dataType="text"></w2:column>
        				<w2:column id="Income" name="Income" dataType="text"></w2:column>
        				<w2:column id="Expense" name="Expense" dataType="text"></w2:column>
        				<w2:column id="Hobby" name="Hobby" dataType="text"></w2:column>
        				<w2:column id="Region" name="Region" dataType="text"></w2:column>
        				<w2:column id="Frequency" name="Frequency" dataType="text"></w2:column>
        				<w2:column id="Date" name="Date" dataType="text"></w2:column>
        			</w2:columnInfo>
        		</w2:dataList>
        		<w2:dataList baseNode="list" repeatNode="map" id="dataList2" saveRemovedData="true">
        			<w2:columnInfo>
        				<w2:column id="label" name="label" dataType="text"></w2:column>
        				<w2:column id="value" name="value" dataType="text"></w2:column>
        				<w2:column id="type" name="type" dataType="text"></w2:column>
        			</w2:columnInfo>
        			<w2:data use="true">
        				<w2:row>
        					<label><![CDATA[Single]]></label>
        					<value><![CDATA[Single]]></value>
        					<type><![CDATA[true]]></type>
        				</w2:row>
        				<w2:row>
        					<label><![CDATA[Divorced]]></label>
        					<value><![CDATA[Divorced]]></value>
        					<type><![CDATA[true]]></type>
        				</w2:row>
        				<w2:row>
        					<label><![CDATA[Married]]></label>
        					<value><![CDATA[Married]]></value>
        					<type><![CDATA[true]]></type>
        				</w2:row>
        				<w2:row>
        					<label><![CDATA[None]]></label>
        					<value><![CDATA[None]]></value>
        					<type><![CDATA[false]]></type>
        				</w2:row>
        			</w2:data>
        		</w2:dataList>
        	</w2:dataCollection>
        	<w2:workflowCollection></w2:workflowCollection>
        	<xf:submission id="submission1" ref="" target='data:json,dataList1' action="data.json" method="post"
        		mediatype="application/json" encoding="UTF-8" instance="" replace="" errorHandler="" customHandler="" mode="asynchronous"
        		processMsg="" ev:submit="" ev:submitdone="" ev:submiterror="" abortTrigger="">
        	</xf:submission>
        	<xf:submission id="submission2" ref="" target="" action="" method="post" mediatype="application/json" encoding="UTF-8"
        		instance="" replace="" errorHandler="" customHandler="" mode="asynchronous" processMsg="" ev:submit="" ev:submitdone=""
        		ev:submiterror="" abortTrigger="">
        	</xf:submission>
        </xf:model>
        <script type="text/javascript" lazy="false"><![CDATA[

scwin.onpageload = function () {
    var objSubmission = $p.getSubmission("submission1");
    objSubmission.action = scwin.getfolderPath() + '/data.json';

    $p.executeSubmission("submission1");
};

scwin.onpageunload = function () {

};

scwin.trigger7_onclick = function (e) {
    var filtered = dataList1.getFilteredColData('Hobby');
    alert(filtered);
};

scwin.trigger8_onclick = function (e) {
    var full = dataList1.getColData('Hobby');
    alert(full);
};

scwin.trigger9_onclick = function (e) {
    gridView1.setColumnVisibleColumn("Status", "type", false);
};

scwin.getfolderPath = function () {

    var currentPath = window.location.href;
    var folderPath;

    if (currentPath.includes("mainContainer")) {
        console.log("true  ===> " + $p.getFrameId());
        const cmtFrame = $p.getComponentById($p.getFrameId());
        currentPath = cmtFrame.getSrc();
        folderPath = currentPath.substring(0, currentPath.lastIndexOf('/'));
    } else {
        console.log("false  ===> ");
        folderPath = currentPath.split('w2xPath=')[1].substring(0, currentPath.split('w2xPath=')[1].lastIndexOf('/'));
    }
    return folderPath;
};
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload" ev:onpageunload="scwin.onpageunload">
    <xf:group id="" style="margin: 10px;"><w2:textbox tagname="h1" style="color: blue;margin-bottom: 10px;" tabIndex="h1" id="textbox1" label="Hide Some Selection Items of a Column&lt;br/&gt;" escape="false"></w2:textbox><w2:textbox tagname="h2" style="height: 23px;margin-bottom: 10px;color: blue;" id="textbox2" label="How to Use"></w2:textbox><w2:textbox style="color: blue;margin-bottom: 30px;" id="textbox3" label='1. Click the arrow in the Status column cell.&lt;br/&gt;2. Confirm that the options Single, Divorced, Married, and None appear.&lt;br/&gt;3. Hold down the Ctrl key and right-click the mouse.&lt;br/&gt;4. Select the “View dataCollection” menu.&lt;br/&gt;5. Verify that dataList2 is bound to the Status column.&lt;br/&gt;6. Confirm that the option with a false value in the type column is None.&lt;br/&gt;7. Click the button at the bottom.&lt;br/&gt;8. Click the arrow in the Status column cell.&lt;br/&gt;9. Confirm that only Single, Divorced, and Married options are displayed, excluding None. &lt;br/&gt;' escape="false">
    	</w2:textbox><xf:trigger ev:onclick="scwin.trigger9_onclick" style="height:42px;line-height:32px;padding:5px;background-color:coral;font-size:15px;weight: bolder;font-weight:bolder;text-align: left;display: block;margin-bottom: 10px;" id="trigger9" type="button">
    		<xf:label><![CDATA[gridView1.setColumnVisibleColumn("Status", "type", false);]]></xf:label>
    	</xf:trigger><w2:gridView showSortableUseFilter="" scrollByColumnAdaptive="false" rowNumVisible="" showSortableImage="" scrollByColumn="false" sortable="" defaultCellHeight="20" filterShowAlways="" rowStatusVisible="" dataList="data:dataList1" style="border: solid gray 1px;" columnMove="" id="gridView1" autoFit="allColumn" useFilterList="true" class="" visibleRowNumFix="true" visibleRowNum="10">
    		<w2:caption style="" id="caption1" value="this is a grid caption."></w2:caption>
    		<w2:header style="" id="header1">
    			<w2:row style="height: 25px;" id="row1">
    				<w2:column removeBorderStyle="false" width="70" inputType="checkbox" style="height:20px;" id="column19" value="Check" blockSelect="false" displayMode="label">
    				</w2:column>
    				<w2:column removeBorderStyle="false" width="70" inputType="text" style="height:20px;" id="column17" value="ID" blockSelect="false" displayMode="label">
    				</w2:column>
    				<w2:column chooseOptionLabel="Status" ref="" removeBorderStyle="false" chooseOption="true" width="70" inputType="" style="height:20px;" id="column13" allOption="" value="Status" blockSelect="false" displayMode="label">
    					<w2:choices>
    						<w2:itemset nodeset="data:dataList2">
    							<w2:label ref="label"></w2:label>
    							<w2:value ref="value"></w2:value>
    						</w2:itemset>
    					</w2:choices>
    				</w2:column>
    				<w2:column removeBorderStyle="false" width="70" inputType="text" style="height:20px;" id="column11" value="Income" blockSelect="false" displayMode="label">
    				</w2:column>
    				<w2:column removeBorderStyle="false" width="70" inputType="text" style="height:20px;" id="column7" value="Hobby" blockSelect="false" displayMode="label" useFilter="false">
    				</w2:column>
    			</w2:row>
    		</w2:header>
    		<w2:gBody style="" id="gBody1">
    			<w2:row style="" id="row2">
    				<w2:column removeBorderStyle="false" width="70" inputType="checkbox" style="height:20px" id="Check" value="" blockSelect="false" displayMode="label">
    				</w2:column>
    				<w2:column removeBorderStyle="false" width="70" inputType="text" style="height:20px" id="ID" value="" blockSelect="false" displayMode="label">
    				</w2:column>
    				<w2:column ref="" removeBorderStyle="false" chooseOption="" width="70" inputType="select" style="height:20px;" id="Status" allOption="" value="" blockSelect="false" displayMode="label" viewType="icon">
    					<w2:choices>
    						<w2:itemset nodeset="data:dataList2">
    							<w2:label ref="label"></w2:label>
    							<w2:value ref="value"></w2:value>
    						</w2:itemset>
    					</w2:choices>
    				</w2:column>
    				<w2:column removeBorderStyle="false" width="70" inputType="text" style="height:20px" id="Income" value="" blockSelect="false" displayMode="label">
    				</w2:column>
    				<w2:column removeBorderStyle="false" width="70" inputType="text" style="height:20px" id="Hobby" value="" blockSelect="false" displayMode="label" useFilter="">
    				</w2:column>
    			</w2:row>
    		</w2:gBody>
    	</w2:gridView></xf:group></body>
</html>
