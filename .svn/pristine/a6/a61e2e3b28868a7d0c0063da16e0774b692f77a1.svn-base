scwin.onpageunload = function () {};
scwin.gridView1_ongroupby = function (options) {
  options.groupbyHeader = [{
    inputType: 'expression',
    expression: 'toggle() + depthStr() + "    [ " + count() + " Cases ]  "',
    align: 'left',
    colSpan: 4
  }];
  options.closeGroup = true, options.groupbyFooter = {
    depth_0: [{
      colSpan: 3,
      value: "Grand Total",
      align: "right"
    }, {
      inputType: 'expression',
      expression: 'SUM("col4")'
    }],
    depth_1: [{
      colSpan: 3,
      value: "Total",
      align: "right"
    }, {
      inputType: 'expression',
      expression: 'SUM("col4")'
    }],
    depth_2: [{
      colSpan: 3,
      value: "Sub Total",
      align: "right"
    }, {
      inputType: 'expression',
      expression: 'SUM("col4")'
    }]
  };
  gridView1.groupby(options);
};
scwin.trigger1_onclick = function (e) {
  var data = gridView1.getGroupbyData(false);
  alert(data);
};
