<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
         <script type="text/javascript" lazy="false"><![CDATA[
        
	scwin.onpageload = function() {
		
	};
	
	scwin.onpageunload = function() {
		
	};
	
	
	scwin.trigger1_onclick = function(e) {
		$p.dynamicCreate("group1", "group", {style: "border: solid green 2px; height: 400px; padding: 20px; margin: 10px"});
	
		$p.dynamicCreate("textbox10", "textbox", {style: "font-size: 20px; display: block; margin-bottom: 20px;"}, group1);
		
		var comObj = $p.getComponentById("textbox10");
		comObj.setValue("Select the date.");
		
		$p.dynamicCreate("calendar1", "calendar", {style: "width: 200px; float: left; "}, group1);
	};
	]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload" ev:onpageunload="scwin.onpageunload">
    <xf:group style="margin: 10px;" id="">
    	<w2:textbox tagname="h1" style="color: blue;margin-bottom: 10px;" id="textbox1" label="Dynamic Component Creation&lt;br/&gt;"
    		escape="false">
    	</w2:textbox>
    	<w2:textbox tagname="h2" style="height: 23px;margin-bottom: 10px;color: blue;" id="textbox2" label="How to Use"></w2:textbox>
    	<w2:textbox style="color: blue;margin-bottom: 30px;" id="textbox3"
    		label='1. Click the button below.&lt;br/&gt;2. Verify that a TextBox and Calendar component are dynamically created inside the Group component.&lt;br/&gt;(See the Script tab for detailed script.)'
    		escape="false">
    	</w2:textbox>
    	<xf:trigger ev:onclick="scwin.trigger1_onclick"
    		style="display: block;height:42px;line-height:32px;padding:5px;background-color:coral;font-size:15px;weight: bolder;font-weight:bolder;margin-bottom:10px;text-align: left;"
    		id="trigger1" type="button">
    		<xf:label><![CDATA[dynamicCreate()]]></xf:label>
    	</xf:trigger>
    	<w2:textbox escape="false" id="textbox4"
    		label='/// Sample Code&lt;br/&gt;&lt;br/&gt;$p.dynamicCreate("group1", "group", {&lt;br/&gt; &amp;nbsp; &amp;nbsp;style: "border: solid green 2px; height: 400px; padding: 20px; margin: 10px"&lt;br/&gt;});&lt;br/&gt;&lt;br/&gt;$p.dynamicCreate("textbox10", "textbox", {&lt;br/&gt; &amp;nbsp; &amp;nbsp;style: "font-size: 20px; display: block; margin-bottom: 20px;"&lt;br/&gt;}, group1);&lt;br/&gt;&lt;br/&gt;var comObj = $p.getComponentById("textbox10");&lt;br/&gt;comObj.setValue("Select the date.");&lt;br/&gt;&lt;br/&gt;$p.dynamicCreate("calendar1", "calendar", {&lt;br/&gt; &amp;nbsp; &amp;nbsp;style: "width: 200px; float: left; "&lt;br/&gt;}, group1);'
    		style="padding:10px; padding-bottom:20px; text-align:left; font-size:15px; font-weight:bolder; border:brown 1px solid; background-color:ivory; margin-bottom:10px; margin-top:10px; color:brown;"
    		tagname="">
    	</w2:textbox>
    </xf:group></body>
</html>
