<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
    	<w2:buildDate />
    	<xf:model>
    		<xf:instance>
    			<data xmlns="" />
    		</xf:instance>
    		<w2:dataCollection baseNode="map"></w2:dataCollection>
    		<w2:workflowCollection></w2:workflowCollection>
    	</xf:model>
    	<script type="text/javascript" lazy="false"><![CDATA[
        
	scwin.onpageload = function() {
		windowContainer1.createWindow( "aaa" , "" , "" , "window aaa" , "aaa" ,"newWindow", null,null,null,null,"wframe" );
		windowContainer1.createWindow( "bbb" , "" , "" , "window bbb" , "bbb" ,"newWindow", null,null,null,null,"wframe" );
		windowContainer1.createWindow( "ccc" , "" , "" , "window ccc" , "ccc" ,"newWindow", null,null,null,null,"wframe" );
		windowContainer1.createWindow( "ddd" , "" , "" , "window ddd" , "ddd" ,"newWindow", null,null,null,null,"wframe" );
		windowContainer1.createWindow( "eee" , "" , "" , "window eee" , "eee" ,"newWindow", null,null,null,null,"wframe" );
		windowContainer1.setArrangeWindows("vertical");	
	};
	
	scwin.onpageunload = function() {
		
	};
	scwin.trigger1_onclick = function(e) {
		windowContainer1.setFocus("bbb");
	};
	
	scwin.trigger2_onclick = function(e) {
		var windowId = windowContainer1.getSelectedWindowId();		
		var windowIndex = windowContainer1.getSelectedIndex();
		alert("windowId : " + windowId + "  &  " + "windowIndex : " + windowIndex );
	};
	]]></script>
    	<style type="text/css"><![CDATA[.w2window_selected {border: solid 2px red;} ]]></style>
    </head>
    <body ev:onpageload="scwin.onpageload" ev:onpageunload="scwin.onpageunload">
    <xf:group id="" style="margin: 10px;">
    	<w2:textbox tagname="h1" style="color: blue;margin-bottom: 10px;" tabIndex="h1" id="textbox1" label="지정한 윈도우에 포커스 주기"
    		escape="false">
    	</w2:textbox>
    	<w2:textbox tagname="h2" style="height: 23px;margin-bottom: 10px;color: blue;" id="textbox2" label="샘플 사용 방법"></w2:textbox>
    	<w2:textbox style="color: blue;margin-bottom: 30px;" id="textbox3"
    		label='1. 하단의 setFocus("bbb") 버튼을 클릭. &lt;br/&gt;2. 지정한 윈도우로 포커스가 이동하는 것을 확인. &lt;br/&gt;3. 하단의 getSelectedWindowId() &amp; getSelectedWindowIndex() 버튼을 클릭. &lt;br/&gt;4. 현재 포커스된 윈도우의 ID와 인덱스가 표시되는 것을 확인. &lt;br/&gt;(자세한 스크립트는 Script 탭에서 확인.)'
    		escape="false">
    	</w2:textbox>
    	<w2:textbox tagname="" style="padding:10px; padding-bottom:20px; text-align:left; font-size:15px; font-weight:bolder; border:brown 1px solid; background-color:ivory; margin-bottom:10px; color:brown;" id="textbox4" label='/// 샘플 코드 (1)&lt;br/&gt;&lt;br/&gt;windowContainer1.setFocus("bbb");&lt;br/&gt;&lt;br/&gt;/// 샘플 코드 (2)&lt;br/&gt;&lt;br/&gt;var windowId = windowContainer1.getSelectedWindowId();&lt;br/&gt;var windowIndex = windowContainer1.getSelectedIndex();&lt;br/&gt;alert("windowId : " + windowId + " &amp;nbsp;&amp; &amp;nbsp;" + "windowIndex : " + windowIndex);' escape="false">
    	</w2:textbox>
    	<xf:trigger ev:onclick="scwin.trigger1_onclick"
    		style="height:42px;line-height:32px;padding:5px;background-color:coral;font-size:15px;weight: bolder;font-weight:bolder;text-align: left;display: block;margin-bottom: 10px;"
    		id="trigger1" type="button">
    		<xf:label><![CDATA[setFocus("bbb")]]></xf:label>
    	</xf:trigger>
    	<xf:trigger ev:onclick="scwin.trigger2_onclick"
    		style="height:42px;line-height:32px;padding:5px;background-color:coral;font-size:15px;weight: bolder;font-weight:bolder;text-align: left;display: block;margin-bottom: 10px;"
    		id="trigger2" type="button">
    		<xf:label><![CDATA[getSelectedWindowId() & getSelectedWindowIndex()]]></xf:label>
    	</xf:trigger>
    	<w2:windowContainer sequentialArrangeColNum="2" sequentialArrangeRowNum="2" fixArrangeFullScreen="false" useFixButton="false"
    		windowAutoResize="false" useWindowScrollButton="true" verticalArrangeNum="2" windowMaxNum="20" useCloseButton="false"
    		controlIconPosition="allright" stopMinimizeOnNameLayer="false" toolbarPosition="top" windowMaximizeAll="true" id="windowContainer1"
    		useStatusMsg="true" hideTitleOnMaximize="false" spaInitCount="0" windowScrollVisibleRowNum="" stopToggleOnLast="false"
    		useNameContainer="true" horizontalArrangeNum="2" useCustomMsg="false" autoArrange="true" useControlIconTitle="true"
    		tooltipDisplay="true" tooltipGroupClass="false" windowTooltipDisplay="true"
    		style="position: relative;height: 400px;border: gray solid 1px;margin-bottom: 10px;">
    		<w2:windowToolbar>
    			<w2:controlIconLayer>
    				<w2:controlIcon></w2:controlIcon>
    				<w2:controlIcon></w2:controlIcon>
    				<w2:controlIcon></w2:controlIcon>
    				<w2:controlIcon></w2:controlIcon>
    				<w2:controlIcon></w2:controlIcon>
    			</w2:controlIconLayer>
    			<w2:nameLayer></w2:nameLayer>
    			<w2:selectedNameLayer></w2:selectedNameLayer>
    		</w2:windowToolbar>
    	</w2:windowContainer>
    </xf:group></body>
</html>
