define({declaration:{A:{version:'1.0',encoding:'UTF-8'}},E:[{T:1,N:'html',A:{xmlns:'http://www.w3.org/1999/xhtml','xmlns:ev':'http://www.w3.org/2001/xml-events','xmlns:w2':'http://www.inswave.com/websquare','xmlns:xf':'http://www.w3.org/2002/xforms'},E:[{T:1,N:'head',E:[{T:1,N:'w2:type',E:[{T:3,text:'COMPONENT'}]},{T:1,N:'w2:buildDate'},{T:1,N:'w2:MSA'},{T:1,N:'xf:model',E:[{T:1,N:'w2:dataCollection',A:{baseNode:'map'}},{T:1,N:'w2:workflowCollection'}]},{T:1,N:'w2:layoutInfo'},{T:1,N:'w2:publicInfo',A:{method:''}},{T:1,N:'script',A:{lazy:'false',type:'text/javascript'},E:[{T:4,cdata:function(scopeObj){with(scopeObj){scwin.onpageload = function () {
  const tmpSrc = scwin.getfolderPath() + "/source.xml";
  wframe1.setSrc(tmpSrc);
};
scwin.trigger1_onclick = function (e) {
  $p.reinitialize(true);
};
window.onbeforeunload = function () {
  console.log('Browser refreshed.');
};
scwin.trigger2_onclick = function (e) {
  $p.reinitialize();
};
scwin.getfolderPath = function () {
  var currentPath = window.location.href;
  var folderPath;
  if (currentPath.includes("mainContainer")) {
    console.log("true  ===> " + $p.getFrameId());
    const cmtFrame = $p.getComponentById($p.getFrameId());
    currentPath = cmtFrame.getSrc();
    folderPath = currentPath.substring(0, currentPath.lastIndexOf('/'));
  } else {
    console.log("false  ===> ");
    folderPath = currentPath.split('w2xPath=')[1].substring(0, currentPath.split('w2xPath=')[1].lastIndexOf('/'));
  }
  return folderPath;
};
}}}]}]},{T:1,N:'body',A:{'ev:onpageload':'scwin.onpageload'},E:[{T:1,N:'xf:group',A:{id:'',style:'margin: 10px;'},E:[{T:1,N:'w2:textbox',A:{tagname:'h1',style:'color: blue;margin-bottom: 10px;',id:'textbox1',label:'Reload Page and Refresh Browser<br/>',escape:'false'}},{T:1,N:'w2:textbox',A:{tagname:'h2',style:'height: 23px;margin-bottom: 10px;color: blue;',id:'textbox2',label:'How to Use'}},{T:1,N:'w2:textbox',A:{style:'color: blue;margin-bottom: 30px;',id:'textbox3',label:'1-1. Enter data into both the first and second input boxes.<br/>1-2. Click the first $p.reinitialize(true); button.<br/>1-3. Verify that the browser refreshes and both input boxes are initialized. <br/><br/>2-1. Enter data into both the first and second input boxes.<br/>2-2. Click the second $p.reinitialize(); button.<br/>2-3. Verify that only the frame containing the second button reloads, initializing only the input boxes within that frame.',escape:'false'}},{T:1,N:'xf:trigger',A:{'ev:onclick':'scwin.trigger1_onclick',style:'display: block;height:42px;line-height:32px;padding:5px;background-color:coral;font-size:15px;weight: bolder;font-weight:bolder;margin-bottom:10px;text-align: left;',id:'trigger1',type:'button'},E:[{T:1,N:'xf:label',E:[{T:4,cdata:'$p.reinitialize(true);'}]}]},{T:1,N:'xf:input',A:{adjustMaxLength:'false',style:'width:222px;height:42px;margin-top:20px;color: blue;font-size:20px;font-style:normal;font-weight:bolder;display:block;border: coral solid 2px;',id:'input1',placeholder:'(1) Enter data.'}},{T:1,N:'w2:wframe',A:{src:'source.xml',style:'width: 400px;height: 300px;border: orange solid 2px;margin-top: 20px;',id:'wframe1'}}]}]}]}]})