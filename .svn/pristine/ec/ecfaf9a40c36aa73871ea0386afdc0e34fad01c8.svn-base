<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
        <title>MapChart_marker.xml</title>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
        <style>
        </style>        
        <script type="javascript" lazy="false"><![CDATA[
scwin.onpageload = function () {

};

scwin.onpageunload = function () {

};

scwin.contextFormatter = function (name, code) {
    return "<br>Completed 0," + "<br>In-progress 0," + "<br>Scheduled 0";
}

]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload" ev:onpageunload="scwin.onpageunload">
    <xf:group id="" style="margin: 10px;">
    	<w2:textbox tagname="h1" style="color: blue;margin-bottom: 10px;" tabIndex="h1" id="textbox1"
    		label="Display Markers on Map&lt;br/&gt;" escape="false">
    	</w2:textbox>
    	<w2:textbox tagname="h2" style="height: 23px;margin-bottom: 10px;color: blue;" id="textbox2" label="How to Use"></w2:textbox>
    	<w2:textbox style="color: blue;margin-bottom: 30px;" id="textbox3"
    		label='1. Confirm that markers appear on the map. (useMarker=“true”)&lt;br/&gt;2. Click any marker.&lt;br/&gt;3. Confirm that the text returned by the function set as the contextFormatter property value is displayed.&lt;br/&gt;(See the Script tab for detailed script.)&lt;br/&gt;'
    		escape="false">
    	</w2:textbox>
    	<w2:textbox
    		style="padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightblue;border:none;margin-bottom: 10px;"
    		id="textbox4" label='useMarker="true" &lt;br/&gt;contextFormatter="scwin.contextFormatter"' escape="false">
    	</w2:textbox>
    	<w2:mapchart zoomMax="" event_tooltipon="none" useMarker="true" event_zoom="none"
    		style="width: 300px;height: 400px;margin-bottom: 10px;" id="mapchart1" dataMapRatio_level0="simp1" event_drag="none"
    		regionNameShort="true" zoomMin="" event_tooltipoff="none" contextFormatter="scwin.contextFormatter">
    	</w2:mapchart>
    	<w2:textbox style="padding:10px; padding-bottom:20px; text-align:left; font-size:15px; font-weight:bolder; border:brown 1px solid; background-color:ivory; margin-bottom:10px; margin-top:10px; color:brown;" id="textbox6" label='/// Sample Code &lt;br/&gt;&lt;br/&gt;scwin.contextFormatter = function(name, code) {&lt;br/&gt; &amp;nbsp; &amp;nbsp;return "&lt;br/&gt; &amp;nbsp; &amp;nbsp;Completed 0, " + "&lt;br/&gt; &amp;nbsp; &amp;nbsp;In - progress 0, " + "&lt;br/&gt; &amp;nbsp; &amp;nbsp;Scheduled 0 ";&lt;br/&gt;}' escape="false">
    	</w2:textbox>
    	<w2:textbox escape="false" id="textbox5" label='useMarker="false"'
    		style="padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightblue;border:none;margin-bottom: 10px;">
    	</w2:textbox>
    	<w2:mapchart dataMapRatio_level0="simp1" event_drag="none" event_tooltipoff="none" event_tooltipon="none" event_zoom="none"
    		id="mapchart2" regionNameShort="true" style="width: 300px;height: 400px;" useMarker="false" zoomMax="" zoomMin="">
    	</w2:mapchart>
    </xf:group></body>
</html>
