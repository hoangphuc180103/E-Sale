<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare"
	xmlns:xf="http://www.w3.org/2002/xforms">
	<head meta_author="InswaveSystems" meta_type="메인" meta_screenName="[Spinner] 데이터 타입이 날짜(Date)일 때 증감 단위 설정하기">
		<w2:historyInfo>
			<w2:history meta_no="01" meta_desc="최초작성" meta_date="20221028" meta_user="InswaveSystems" ></w2:history>
			<w2:history meta_no="02" meta_desc="설명부 수정" meta_date="20240621" meta_user="InswaveSystems" ></w2:history>
		</w2:historyInfo>
		<w2:type>COMPONENT</w2:type>
		<w2:buildDate />
		<w2:MSA />
		<xf:model>
			<w2:dataCollection baseNode="map">
			</w2:dataCollection>
			<w2:workflowCollection />
		</xf:model>
		<w2:layoutInfo />
		<w2:publicInfo method="" />
		<script lazy="false" type="text/javascript"><![CDATA[
scwin.onpageload = function () {
    //화면 초기화
    scwin.initPage();
};

/**
 * 화면 초기화
 */
scwin.initPage = function () {
    //컴포넌트에 초기값 할당
    spi_exam1.setValue("2024");         //dataType="date" dateIncrementType="year"
    spi_exam2.setValue("202412");       //dataType="date" dateIncrementType="month"
    spi_exam3.setValue("20241231");     //dataType="date" dateIncrementType="day"
    spi_exam4.setValue("2024123112");   //dataType="date" dateIncrementType="hour"
    spi_exam5.setValue("202412311259"); //dataType="date" dateIncrementType="minut
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:group class="sub_contents" id="" style="">
			<xf:group class="ws_example_grp_desc" id="" style="">
				<w2:textbox escape="false" id=""
					label="Spinner의 'dataType' 속성이 'date'로 설정되었을 때, 'dateIncrementType'을 사용하여 데이터의 증감 단위를 설정한 예제입니다." style="" class="">
				</w2:textbox>
			</xf:group>
			<xf:group class="example_div_tb_style_wrap" id="">
				<xf:group class="example_div_tr_style" id="" style="">
					<w2:textbox class="example_div_th_style" escape="false" id="" label='dateIncrementType="year"' style=""></w2:textbox>
					<xf:group class="example_div_td_style" id="" style="">
						<w2:textbox class="wre_txt_normal" escape="false" id="" label="연 단위로 증감됩니다." style="">
						</w2:textbox>
						<w2:spinner skin="type1" buttonSize="30" inputReadOnly="false" id="spi_exam1"
							style="position: relative;width:130px;min-height:24px;" dataType="date" dateIncrementType="year">
						</w2:spinner>
					</xf:group>
				</xf:group>
				<xf:group class="example_div_tr_style" id="" style="">
					<w2:textbox class="example_div_th_style" escape="false" id="" label='dateIncrementType="month"' style=""></w2:textbox>
					<xf:group class="example_div_td_style" id="" style="">
						<w2:textbox class="wre_txt_normal" escape="false" id="" label="월 단위로 증감됩니다." style=""></w2:textbox>
						<w2:spinner buttonSize="30" id="spi_exam2" skin="type1" style="position: relative;width:130px;min-height:24px;"
							dataType="date" dateIncrementType="month">
						</w2:spinner>
					</xf:group>
				</xf:group>
				<xf:group class="example_div_tr_style" id="" style="">
					<w2:textbox class="example_div_th_style" escape="false" id="" label='(기본) dateIncrementType="day"' style=""></w2:textbox>
					<xf:group class="example_div_td_style" id="" style="">
						<w2:textbox class="wre_txt_normal" escape="false" id="" label="일 단위로 증감됩니다." style=""></w2:textbox>
						<w2:spinner buttonSize="30" id="spi_exam3" skin="type1" style="position: relative;width:130px;min-height:24px;"
							dataType="date" dateIncrementType="day">
						</w2:spinner>
					</xf:group>
				</xf:group>
				<xf:group class="example_div_tr_style" id="" style="">
					<w2:textbox class="example_div_th_style" escape="false" id="" label='dateIncrementType="hour"' style=""></w2:textbox>
					<xf:group class="example_div_td_style" id="" style="">
						<w2:textbox class="wre_txt_normal" escape="false" id="" label="시 단위로 증감됩니다." style=""></w2:textbox>
						<w2:spinner buttonSize="30" dataType="date" dateIncrementType="hour" id="spi_exam4" skin="type1"
							style="position: relative;width:136px;min-height:24px;">
						</w2:spinner>
					</xf:group>
				</xf:group>
				<xf:group class="example_div_tr_style" id="" style="">
					<w2:textbox class="example_div_th_style" escape="false" id="" label='dateIncrementType="minute"' style=""></w2:textbox>
					<xf:group class="example_div_td_style" id="" style="">
						<w2:textbox class="wre_txt_normal" escape="false" id="" label="분 단위로 증감됩니다." style=""></w2:textbox>
						<w2:spinner buttonSize="30" dataType="date" dateIncrementType="minute" id="spi_exam5" skin="type1"
							style="position: relative;width:160px;min-height:24px;">
						</w2:spinner>
					</xf:group>
				</xf:group>

			</xf:group>
		</xf:group>
	</body>
</html>