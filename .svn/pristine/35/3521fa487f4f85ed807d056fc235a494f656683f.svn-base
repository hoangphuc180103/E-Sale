	<body ev:onpageload="scwin.onpageload">
		<xf:group class="sub_contents" id="" style="">
			<xf:group class="ws_example_grp_desc" id="" style="">
				<w2:textbox escape="false" id=""
					label="GridView 헤더에 정렬 기능과 필터 기능을 설정한 예제입니다. 헤더 컬럼을 더블 클릭하면 컬럼 데이터가 정렬됩니다. 헤더에서 Ctrl 키를 누르고 더블 클릭하면 다중 컬럼 정렬 기능을 사용할 수 있습니다."
					style="">
				</w2:textbox>
				<w2:textbox class="ws_example_txt_desc_info" escape="false" id="" label="이 예제는 시연용 예제로 예제 가이드 문서가 포함되어 있지 않습니다." style="">
				</w2:textbox>
			</xf:group>
			<xf:group id="" style="overflow:auto;" class="ofh box_flex_1x1">
				<xf:group id="" style="position: relative ;float:left;margin-right:2%;box-sizing:border-box;max-width: 560px;width: 49%;" class="">
					<xf:group class="titbox" id="" style="">
						<w2:textbox class="" id="" label="기본 필터 기능 - 팝업으로 조건을 지정" style="" tagname="h3"></w2:textbox>
					</xf:group>
					<xf:group class="gvwbox" id="" style="">
						<w2:gridView autoFit="allColumn" baseNode="" class="gvw" dataList="data:dlt_grid"
							defaultCellHeight="37" fixedColumn="" focusMode="row" id="grd_ex01" readOnly="true" readOnlyBackgroundColor="" repeatNode=""
							scrollByColumn="false" sortable="true" style="height:360px;" tooltipDisplay="true" visibleRowNum="all" noSelect="true">
							<w2:header id="header5" style="">
								<w2:row id="row35" style="">
									<w2:column blockSelect="false" hidden="false" id="column530" inputType="text" style="" useFilter="true" value="대분류"
										width="90">
									</w2:column>
									<w2:column blockSelect="false" hidden="false" id="column532" inputType="text" style="" useFilter="true" value="중분류"
										width="110">
									</w2:column>
									<w2:column blockSelect="false" id="column535" inputType="text" style="" value="제품명" width="100"></w2:column>
									<w2:column id="column468" inputType="text" style="" useFilter="true" value="수량" width="60"></w2:column>
								</w2:row>
							</w2:header>
							<w2:gBody id="gBody5" style="">
								<w2:row id="row37" style="">
									<w2:column blockSelect="false" hidden="false" id="category1" inputType="text" style="" width="90"></w2:column>
									<w2:column blockSelect="false" hidden="false" id="category2" inputType="text" style="" width="110"></w2:column>
									<w2:column blockSelect="false" id="product" inputType="text" style="" width="100"></w2:column>
									<w2:column dataType="number" displayFormat="#,###" id="quantity" inputType="text" style="" width="60" textAlign="right"></w2:column>
								</w2:row>
							</w2:gBody>
						</w2:gridView>
					</xf:group>
				</xf:group>
				<xf:group id="" style="position: relative ;float:left;box-sizing: border-box;max-width: 560px;width: 49%;">
					<xf:group class="titbox" id="" style="">
						<w2:textbox class="" id="" label="필터 리스트 기능(useFilterList) - 유일한 데이터를 목록으로 제공" style="" tagname="h3"></w2:textbox>
					</xf:group>
					<xf:group class="gvwbox" id="" style="max-width: 560px;">
						<w2:gridView autoFit="allColumn" class="gvw" columnMove="true" dataList="data:dlt_grid" defaultCellHeight="37"
							fixedColumn="" focusMode="row" id="grd_ex02" readOnly="true" scrollByColumn="false" sortable="true" style="height:360px;"
							tooltipDisplay="true" useFilterList="true" visibleRowNum="all" useFilterSearch="true" noSelect="true">
							<w2:header id="header5" style="">
								<w2:row id="row35" style="">
									<w2:column blockSelect="false" hidden="false" id="column530" inputType="text" style="" useFilter="true" value="대분류"
										width="90">
									</w2:column>
									<w2:column blockSelect="false" hidden="false" id="column532" inputType="text" style="" useFilter="true" value="중분류"
										width="110">
									</w2:column>
									<w2:column blockSelect="false" id="column535" inputType="text" style="" value="제품명" width="100"></w2:column>
									<w2:column id="column468" inputType="text" style="" useFilter="true" value="수량" width="60"></w2:column>
								</w2:row>
							</w2:header>
							<w2:gBody id="gBody5" style="">
								<w2:row id="row37" style="">
									<w2:column blockSelect="false" hidden="false" id="category1" inputType="text" style="" width="90"></w2:column>
									<w2:column blockSelect="false" hidden="false" id="category2" inputType="text" style="" width="110"></w2:column>
									<w2:column blockSelect="false" id="product" inputType="text" style="" width="100"></w2:column>
									<w2:column dataType="number" displayFormat="#,###" id="quantity" inputType="text" style="" width="60" textAlign="right"></w2:column>
								</w2:row>
							</w2:gBody>
						</w2:gridView>
					</xf:group>
				</xf:group>
			</xf:group>
		</xf:group>
