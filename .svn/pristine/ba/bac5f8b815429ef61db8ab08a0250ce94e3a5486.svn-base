scwin.onpageload = function () {};

// 그리드뷰 footer 총 건수 표시 형식
scwin.footer_count = function (data) {
  return "총 " + data + " 건";
};
scwin.masking_formatter = function (data) {
  var len = data.length;
  var str = "";
  if (len <= 0) {
    return "";
  }
  for (var i = 0; i < len - 2; i++) str += '*';
  return str + "증권";
};

// 2줄 그리드 기능 처리
// 다운로드
scwin.btn_down_onclick = function (e) {
  // 옵션 변수
  var options = {};
  // xlsx, xls, csv 구분 ex) .csv

  var dataType = select_type.getValue();

  // 옵션 설정
  options.type = dataType;
  options.fileName = "EXAMPLE_P00196_" + dataType + ".xlsx";

  // 컬럼 무브를 적용해 다운 받을지 여부
  options.columnMove = "true";
  // 스타일 사용 여부
  options.useStyle = "true";
  // footer 포함 여부
  options.useFooter = "true";
  options.showProcess = true;
  // 다운로드
  grd.advancedExcelDownload(options);
};

//업로드
scwin.btn_up_onclick = function (e) {
  var options = {};
  var type = select_type.getValue();
  options.type = type;
  // 업로드 창 modal 사용 여부
  options.useModalDisable = "true";
  // 헤더 존재 여부
  options.headerExist = "1";
  options.processMsg = "업로드중입니다.";

  // csv 타입인 경우
  if (type == ".csv") {
    options.delim = ";";
    grd1.readCSV(options);
    return;
  }
  // 업로드
  grd.advancedExcelUpload(options);
};

//초기화
scwin.btn_clean_onclick = function (e) {
  dl_gridview.setJSON([]);
};

//조회
scwin.btn_search_onclick = function (e) {
  $p.executeSubmission("sbm_gridview");
};
}}}]}]},{T:1,N:'body',A:{'ev:onpageload':'scwin.onpageload'},E:[{T:1,N:'xf:group',A:{class:'sub_contents',id:'',style:''},E:[{T:1,N:'xf:group',A:{id:'',class:'ws_example_grp_desc'},E:[{T:1,N:'w2:textbox',A:{style:'',id:'',label:'다중 행(2줄의 헤더와 바디)으로 구성된 Gridview의 &nbsp;Excel 다운로드, 업로드 기능 예제입니다.<br/>Selectbox를 통해 브라우저에 표시된 데이터와 실제 데이터 중 선택하여 다운로드 할 수 있습니다.<br/>',escape:'false'}},{T:1,N:'w2:textbox',A:{style:'',id:'',label:'이 예제는 시연용 예제로 예제 가이드 문서가 포함되어 있지 않습니다.',class:'ws_example_txt_desc_info',escape:'false'}},{T:1,N:'w2:textbox',A:{style:'',id:'',label:'이 예제는 PC에 최적화 된 화면입니다. 모바일에서는 기능 일부가 작동하지 않을 수 있습니다.',class:'ws_example_txt_desc_info',escape:'false'}}]},{T:1,N:'xf:group',A:{id:''},E:[{T:1,N:'xf:group',A:{style:'',id:'',class:'titbox'},E:[{T:1,N:'xf:group',A:{class:'lt',id:'',style:''},E:[{T:1,N:'xf:trigger',A:{class:'btn_cm btn_line','ev:onclick':'scwin.btn_clean_onclick',id:'btn_clean2',style:'width: 80px;',type:'button'},E:[{T:1,N:'xf:label',E:[{T:4,cdata:'초기화'}]}]}]},{T:1,N:'xf:group',A:{style:'',id:'',class:'rt'},E:[{T:1,N:'w2:span',A:{label:'데이터 유형: ',style:'',id:''}},{T:1,N:'xf:select1',A:{submenuSize:'auto',ref:'',appearance:'minimal',disabledClass:'w2selectbox_disabled',chooseOption:'',style:'width: 135px;margin-right: 5px;',disabled:'false',id:'select_type',allOption:'',direction:'auto'},E:[{T:1,N:'xf:choices',E:[{T:1,N:'xf:item',E:[{T:1,N:'xf:label',E:[{T:4,cdata:'보여지는데이터'}]},{T:1,N:'xf:value',E:[{T:4,cdata:'1'}]}]},{T:1,N:'xf:item',E:[{T:1,N:'xf:label',E:[{T:4,cdata:'실제데이터'}]},{T:1,N:'xf:value',E:[{T:4,cdata:'0'}]}]}]}]},{T:1,N:'xf:trigger',A:{'ev:onclick':'scwin.btn_down_onclick',style:'width: 100px;',id:'btn_down2',type:'button',class:'btn_cm btn_line'},E:[{T:1,N:'xf:label',E:[{T:4,cdata:'엑셀다운로드'}]}]},{T:1,N:'xf:trigger',A:{'ev:onclick':'scwin.btn_up_onclick',style:'width: 80px;',id:'btn_up2',type:'button',class:'btn_cm btn_line'},E:[{T:1,N:'xf:label',E:[{T:4,cdata:'엑셀업로드'}]}]},{T:1,N:'w2:span',A:{id:'',label:'|',style:'margin-left: 10px;margin-right