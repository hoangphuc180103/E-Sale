<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare"
	xmlns:xf="http://www.w3.org/2002/xforms">
	<head meta_author="InswaveSystems" meta_type="메인" meta_screenName="[PageList] 남은 페이지 표시 유형 설정하기">
		<w2:historyInfo>
			<w2:history meta_no="01" meta_desc="최초작성" meta_date="20231120" meta_user="InswaveSystems"></w2:history>
			<w2:history meta_no="02" meta_desc="설명부 수정" meta_date="20240621" meta_user="InswaveSystems" ></w2:history>
		</w2:historyInfo>
		<w2:type>COMPONENT</w2:type>
		<w2:buildDate />
		<w2:MSA />
		<xf:model>
			<w2:dataCollection baseNode="map"></w2:dataCollection>
			<w2:workflowCollection />
		</xf:model>
		<w2:layoutInfo />
		<w2:publicInfo method="" />
		<script lazy="false" type="text/javascript"><![CDATA[
scwin.onpageload = function () {
    // 예제 테스트를 위한 초기화
    scwin.initializeExample();
};

// 예제 테스트를 위한 초기화
scwin.initializeExample = function () {
    // PageList 'pgc_exam1', 'pgc_exam2'의 전체 페이지 수를 14로 설정합니다.
    pgl_exam1.setCount(14);
    pgl_exam2.setCount(14);

    // PageList 'pgc_exam1', 'pgc_exam2'의 선택된 페이지를 12로 설정합니다.
    pgl_exam1.setSelectedIndex(12);
    pgl_exam2.setSelectedIndex(12);
};
]]>
		</script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:group class="sub_contents" id="" style="">
			<xf:group class="ws_example_grp_desc" id="" style="">
				<w2:textbox escape="false" id=""
					label="PageList의 'pagingType' 속성을 사용하여 잔여 페이지를 화면에 표시하는 방식을 설정한 예제입니다." style="">
				</w2:textbox>
				<w2:textbox escape="false" id=""
					label="예제의 PageList는 다음의 조건이 동일하게 설정되었습니다.&lt;br/&gt;- 화면에 표시할 페이지 수('pageSize' 속성) : '10'&lt;br/&gt;- 전체 페이지 수 : '14'&lt;br/&gt;- 선택된 페이지 : '12'"
					style="">
				</w2:textbox>
			</xf:group>
			<xf:group class="example_div_tb_style_wrap" id="">
				<xf:group class="example_div_tr_style" id="" style="">
					<w2:textbox class="example_div_th_style" escape="false" id="" label='(기본 설정) pagingType: 1' style=""></w2:textbox>
					<xf:group class="example_div_td_style" id="" style="">
						<w2:pageList displayFormat="#" id="pgl_exam1" style="" pagingType="1" pageSize="10"></w2:pageList>
					</xf:group>
				</xf:group>
				<xf:group class="example_div_tr_style" id="" style="">
					<w2:textbox class="example_div_th_style" escape="false" id="" label='pagingType: 2' style=""></w2:textbox>
					<xf:group class="example_div_td_style" id="" style="">
						<w2:pageList displayFormat="#" id="pgl_exam2" style="" pagingType="2" pageSize="10"></w2:pageList>
					</xf:group>
				</xf:group>
			</xf:group>
		</xf:group>
	</body>
</html>