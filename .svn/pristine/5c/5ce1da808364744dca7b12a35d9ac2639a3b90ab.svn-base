define({declaration:{A:{version:'1.0',encoding:'UTF-8'}},E:[{T:1,N:'html',A:{xmlns:'http://www.w3.org/1999/xhtml','xmlns:ev':'http://www.w3.org/2001/xml-events','xmlns:w2':'http://www.inswave.com/websquare','xmlns:xf':'http://www.w3.org/2002/xforms'},E:[{T:1,N:'head',A:{},E:[{T:1,N:'w2:type',E:[{T:3,text:'DEFAULT'}]},{T:1,N:'w2:buildDate'},{T:1,N:'xf:model',E:[{T:1,N:'w2:dataCollection',A:{baseNode:'map'}},{T:1,N:'w2:workflowCollection'}]},{T:1,N:'script',A:{type:'text/javascript',lazy:'false'},E:[{T:4,cdata:function(scopeObj){with(scopeObj){scwin.count = 0;
scwin.onpageload = function () {};
scwin.onpageunload = function () {};
scwin.trigger1_onclick = function (e) {
  var tmpSrc = scwin.getfolderPath() + "/wframe.xml";
  var scopeInheritValue = radio1.getValue();
  scwin.count++;
  var winObj = {
    title: "window",
    src: tmpSrc,
    windowTitle: "Title" + " - " + scopeInheritValue,
    windowId: "001" + scwin.count,
    frameMode: "wframe",
    defaultWidth: "400",
    defaultHeight: "300",
    scopeInherit: scopeInheritValue
  };
  windowContainer1.createWindow(winObj);
};
scwin.getfolderPath = function () {
  var currentPath = window.location.href;
  var folderPath;
  if (currentPath.includes("mainContainer")) {
    console.log("true  ===> " + $p.getFrameId());
    const cmtFrame = $p.getComponentById($p.getFrameId());
    currentPath = cmtFrame.getSrc();
    folderPath = currentPath.substring(0, currentPath.lastIndexOf('/'));
  } else {
    console.log("false  ===> ");
    folderPath = currentPath.split('w2xPath=')[1].substring(0, currentPath.split('w2xPath=')[1].lastIndexOf('/'));
  }
  return folderPath;
};
}}}]}]},{T:1,N:'body',A:{'ev:onpageload':'scwin.onpageload','ev:onpageunload':'scwin.onpageunload'},E:[{T:1,N:'xf:group',A:{style:'margin: 10px;',id:''},E:[{T:1,N:'w2:textbox',A:{tagname:'h1',style:'color: blue;margin-bottom: 10px;',tabIndex:'h1',id:'textbox6',label:'Inherit Parent Scope<br/>',escape:'false'}},{T:1,N:'w2:textbox',A:{tagname:'h2',style:'height: 23px;margin-bottom: 10px;color: blue;',id:'textbox7',label:'How to Use'}},{T:1,N:'w2:textbox',A:{style:'color: blue;margin-bottom: 30px;',id:'textbox8',label:'(Run the example standalone.)<br/>1. Select the scopeInherit option value. (none, api, all, or component)<br/>2. Click the createWindow() button below.<br/>3. Confirm that a window is created with the specified scopeInherit option applied, and that the created window displays a screen with nested WFrame components.<br/>4. Click each button inside the WFrame.<br/>5. Confirm each button behaves according to its scopeInherit attribute value.<br/> &nbsp; &nbsp; “none” : (1) X, (2) Top-level access, (3) O<br/> &nbsp; &nbsp; “api” : (1) X, (2) Parent access, (3) O<br/> &nbsp; &nbsp; “api” : (1) X, (2) Parent access, (3) O<br/> &nbsp; &nbsp; “all” : (1) O, (2) Parent access, (3) O<br/> &nbsp; &nbsp; “component” : (1) O, (2) Top-level access, (3) O',escape:'false'}},{T:1,N:'w2:textbox',A:{style:'padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightpink;border:none;margin-bottom: 10px;',id:'textbox9',label:'Select the value of the scopeInherit property.',escape:'false'}},{T:1,N:'xf:group',A:{id:'',style:'margin-bottom: 10px;'},E:[{T:1,N:'xf:select1',A:{id:'radio1',selectedIndex:'-1',appearance:'full',style:'margin-bottom: 10px;margin-bottom: 20px;border: solid 2px lightpink;padding: 10px;',cols:'',rows:'1',ref:''},E:[{T:1,N:'xf:choices',E:[{T:1,N:'xf:item',E:[{T:1,N:'xf:label',E:[{T:4,cdata:'none'}]},{T:1,N:'xf:value',E:[{T:4,cdata:'none'}]}]},{T:1,N:'xf:item',E:[{T:1,N:'xf:label',E:[{T:4,cdata:'api'}]},{T:1,N:'xf:value',E:[{T:4,c