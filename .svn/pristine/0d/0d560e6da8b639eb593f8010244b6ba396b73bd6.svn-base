<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
         <script type="text/javascript" lazy="false"><![CDATA[

scwin.onpageload = function () {
    const tmpSrc = scwin.getfolderPath() + "/wframe_01.xml";
    wframe1.setSrc(tmpSrc);


};

scwin.onpageunload = function () {

};


scwin.getfolderPath = function () {

    var currentPath = window.location.href;
    var folderPath;

    if (currentPath.includes("mainContainer")) {
        console.log("true  ===> " + $p.getFrameId());
        const cmtFrame = $p.getComponentById($p.getFrameId());
        currentPath = cmtFrame.getSrc();
        folderPath = currentPath.substring(0, currentPath.lastIndexOf('/'));
    } else {
        console.log("false  ===> ");
        folderPath = currentPath.split('w2xPath=')[1].substring(0, currentPath.split('w2xPath=')[1].lastIndexOf('/'));
    }
    return folderPath;
};


]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload" ev:onpageunload="scwin.onpageunload">
    <xf:group id="" style="margin: 10px;"><w2:textbox tagname="h1" style="color: blue;margin-bottom: 10px;" id="textbox1" label="フレームベースのモーダルポップアップを作成" escape="false"></w2:textbox><w2:textbox tagname="h2" style="height: 23px;margin-bottom: 10px;color: blue;" id="textbox2" label="サンプルの使い方"></w2:textbox><w2:textbox style="color: blue;margin-bottom: 30px;" id="textbox3" label='1. 最も内部フレームから &amp;nbsp;openPopup() メソッドの frameModal オプション選択。 （"frame", "parent", "top", フレーム ID）&lt;br/&gt;2. Windows 内部 $p.openPopup() ボタンクリック。&lt;br/&gt;3. オプション設定にフォローポップアップアクション範囲確認。&lt;br/&gt;&lt;br/&gt;frameModal オプション値にフォローアクションは次同じ。&lt;br/&gt; &amp;nbsp; &amp;nbsp;"frame" : 該当フレーム内部にモーダルポップアップで表示。 &lt;br/&gt; &amp;nbsp; &amp;nbsp;"parent" : 親フレーム内部にモーダルポップアップで表示。 &lt;br/&gt; &amp;nbsp; &amp;nbsp;"top" : 全体画面上モーダルポップアップで表示。 &lt;br/&gt; &amp;nbsp; &amp;nbsp;フレーム ID : 指定したフレーム内部にモーダルポップアップで表示。 (ああ例のケース $p.getFrame().getParentFrame().getParentFrame().idローフレーム IDを求める。)' escape="false">
    	</w2:textbox><w2:wframe style="border: gray solid 1px;" id="wframe1"></w2:wframe></xf:group></body>
</html>
