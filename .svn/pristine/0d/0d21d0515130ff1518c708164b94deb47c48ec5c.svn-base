<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
         <script type="text/javascript" lazy="false"><![CDATA[
scwin.count = 0;

scwin.onpageload = function () {
    scwin.count++;
    var tmpSrc = scwin.getfolderPath() + "/window_src.xml";

    var winObj = {
        title: "Window",
        src: tmpSrc,
        windowTitle: "_windowTitle",
        windowId: scwin.count,
        frameMode: "wframe",
        defaultWidth: "200",
        defaultHeight: "200"
    }
    windowContainer1.createWindow(winObj);
    windowContainer1.setArrangeWindows("cascade");
    windowContainer2.createWindow(winObj);
    windowContainer2.setArrangeWindows("cascade");
};

scwin.onpageunload = function () {

};

scwin.getfolderPath = function () {

    var currentPath = window.location.href;
    var folderPath;

    if (currentPath.includes("mainContainer")) {
        console.log("true  ===> " + $p.getFrameId());
        const cmtFrame = $p.getComponentById($p.getFrameId());
        currentPath = cmtFrame.getSrc();
        folderPath = currentPath.substring(0, currentPath.lastIndexOf('/'));
    } else {
        console.log("false  ===> ");
        folderPath = currentPath.split('w2xPath=')[1].substring(0, currentPath.split('w2xPath=')[1].lastIndexOf('/'));
    }
    return folderPath;
};
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload" ev:onpageunload="scwin.onpageunload">
    <xf:group id="" style="margin: 10px;">
    	<w2:textbox tagname="h1" style="color: blue;margin-bottom: 10px;" tabIndex="h1" id="textbox1" label="윈도우 드래깅 시 위치 설정" escape="false"></w2:textbox>
    	<w2:textbox tagname="h2" style="height: 23px;margin-bottom: 10px;color: blue;" id="textbox2" label="샘플 사용 방법"></w2:textbox>
    	<w2:textbox style="color: blue;margin-bottom: 30px;" id="textbox3"
    		label='(첫 번째 WindowContainer)&lt;br/&gt;1-1. 윈도우를 WindowContainer 밖으로 드래깅. &lt;br/&gt;1-2. WindowContainer 내부에만 위치를 설정할 수 있는 것을 확인. (windowMoveType="restrict")&lt;br/&gt;&lt;br/&gt;(두 번째 WindowContainer)&lt;br/&gt;2-1. 윈도우를 WindowContainer 밖으로 드래깅. &lt;br/&gt;2-2. WindowContainer 밖으로 위치를 설정할 수 있는 것을 확인. (windowMoveType="overflow")'
    		escape="false">
    	</w2:textbox>
    	<w2:textbox
    		style="padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightblue;border:none;margin-bottom: 10px;"
    		id="textbox4" label='속성 설정&lt;br/&gt;windowMoveType="restrict"' escape="false">
    	</w2:textbox>
    	<w2:windowContainer sequentialArrangeColNum="2" sequentialArrangeRowNum="2" fixArrangeFullScreen="false" useFixButton="false"
    		windowAutoResize="false" useWindowScrollButton="true" defaultWidth="" verticalArrangeNum="2" windowMaxNum="20" useCloseButton="false"
    		controlIconPosition="allright" stopMinimizeOnNameLayer="false" toolbarPosition="top" windowMaximizeAll="true" id="windowContainer1"
    		useStatusMsg="true" hideTitleOnMaximize="false" spaInitCount="0" windowScrollVisibleRowNum="" stopToggleOnLast="false"
    		defaultHeight="" useNameContainer="true" horizontalArrangeNum="2" useCustomMsg="false" windowMoveType="restrict" autoArrange="true"
    		useControlIconTitle="true" tooltipDisplay="true" tooltipGroupClass="false" windowTooltipDisplay="true"
    		style="position: relative;height: 400px;border: gray solid 1px;margin-bottom: 10px;">
    		<w2:windowToolbar>
    			<w2:controlIconLayer>
    				<w2:controlIcon></w2:controlIcon>
    				<w2:controlIcon></w2:controlIcon>
    				<w2:controlIcon></w2:controlIcon>
    				<w2:controlIcon></w2:controlIcon>
    				<w2:controlIcon></w2:controlIcon>
    			</w2:controlIconLayer>
    			<w2:nameLayer></w2:nameLayer>
    			<w2:selectedNameLayer></w2:selectedNameLayer>
    		</w2:windowToolbar>
    	</w2:windowContainer>
    	<w2:textbox escape="false" id="textbox5" label='속성 설정&lt;br/&gt;windowMoveType="overflow"'
    		style="padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightblue;border:none;margin-bottom: 10px;">
    	</w2:textbox>
    	<w2:windowContainer autoArrange="true" controlIconPosition="allright" defaultHeight="" defaultWidth="" fixArrangeFullScreen="false"
    		hideTitleOnMaximize="false" horizontalArrangeNum="2" id="windowContainer2" sequentialArrangeColNum="2" sequentialArrangeRowNum="2"
    		spaInitCount="0" stopMinimizeOnNameLayer="false" stopToggleOnLast="false"
    		style="position: relative;height: 400px;border: gray solid 1px;" toolbarPosition="top" tooltipDisplay="true" tooltipGroupClass="false"
    		useCloseButton="false" useControlIconTitle="true" useCustomMsg="false" useFixButton="false" useNameContainer="true"
    		useStatusMsg="true" useWindowScrollButton="true" verticalArrangeNum="2" windowAutoResize="false" windowMaxNum="20"
    		windowMaximizeAll="true" windowMoveType="overflow" windowScrollVisibleRowNum="" windowTooltipDisplay="true">
    		<w2:windowToolbar>
    			<w2:controlIconLayer>
    				<w2:controlIcon></w2:controlIcon>
    				<w2:controlIcon></w2:controlIcon>
    				<w2:controlIcon></w2:controlIcon>
    				<w2:controlIcon></w2:controlIcon>
    				<w2:controlIcon></w2:controlIcon>
    			</w2:controlIconLayer>
    			<w2:nameLayer></w2:nameLayer>
    			<w2:selectedNameLayer></w2:selectedNameLayer>
    		</w2:windowToolbar>
    	</w2:windowContainer>
    </xf:group></body>
</html>
