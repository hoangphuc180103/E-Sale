<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
         <script type="text/javascript" lazy="false"><![CDATA[

scwin.onpageload = function () {
    requires("uiplugin.popup");
};

scwin.onpageunload = function () {

};


scwin.trigger1_onclick = function (e) {
    var tmpSrc = scwin.getfolderPath() + "/popup_src.xml";
    var opts = {
        "id": "popup2",
        "type": "pageFramePopup",
        "popupName": "PageFrame Popup",
        "width": "500px",
        "height": "500px",
        "top": 100,
        "left": 300,
        "modal": true
    }
    $p.openPopup(tmpSrc, opts);
};

scwin.getfolderPath = function () {

    var currentPath = window.location.href;
    var folderPath;

    if (currentPath.includes("mainContainer")) {
        console.log("true  ===> " + $p.getFrameId());
        const cmtFrame = $p.getComponentById($p.getFrameId());
        currentPath = cmtFrame.getSrc();
        folderPath = currentPath.substring(0, currentPath.lastIndexOf('/'));
    } else {
        console.log("false  ===> ");
        folderPath = currentPath.split('w2xPath=')[1].substring(0, currentPath.split('w2xPath=')[1].lastIndexOf('/'));
    }
    return folderPath;
};]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload" ev:onpageunload="scwin.onpageunload">
    <xf:group id="" style="margin: 10px;"><w2:textbox tagname="h1" style="color: blue;margin-bottom: 10px;" id="textbox1" label="ポップアップかどうかを確認" escape="false"></w2:textbox><w2:textbox tagname="h2" style="height: 23px;margin-bottom: 10px;color: blue;" id="textbox2" label="サンプルの使い方"></w2:textbox><w2:textbox style="color: blue;margin-bottom: 30px;" id="textbox3" label='1. 下のボタンクリック。 &lt;br/&gt;2. ポップアップ生成されるもの確認。 &lt;br/&gt;3. ポップアップソース(src) 画面 WFrameを含むもの確認。 &lt;br/&gt;4. ポップアップ WFrame 内部にある初めて目ボタンクリック。 &lt;br/&gt;5. 自分属する画面ポップアップいいえ WFrame勝つだから false秋返されるもの確認。 &amp;nbsp;&lt;br/&gt;6. ポップアップ WFrame 内部にある二つ目ボタンクリック。 &lt;br/&gt;7. 自分の両親ポップアップだから true秋返されるもの確認。 &lt;br/&gt;（詳細スクリプトは wframe_src.xml ファイル確認。）' escape="false">
    	</w2:textbox><xf:trigger ev:onclick="scwin.trigger1_onclick" style="display: block;height:42px;line-height:32px;padding:5px;background-color:coral;font-size:15px;weight: bolder;font-weight:bolder;margin-bottom:10px;text-align: left;" id="trigger1" type="button">
    		<xf:label><![CDATA[$p.openPopup()]]></xf:label>
    	</xf:trigger></xf:group></body>
</html>
