<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head meta_screenName="sample download">
        <w2:type>COMPONENT</w2:type>
        <w2:buildDate/>
        <w2:MSA/>
        <xf:model>
            <w2:dataCollection baseNode="map"/>
            <w2:workflowCollection/>
        </xf:model>
        <w2:mfeSubmission/>
        <w2:layoutInfo/>
        <w2:publicInfo method=""/>
        <script lazy="false" type="text/javascript"><![CDATA[
scwin.onpageload = function () {

};

scwin.trigger1_onclick = function (e) {
    window.open("https://drive.google.com/file/d/1i3tLNOqBl2qIw8iehAHyxINfcgGzx0q5/view?usp=drive_link", '_blank');
};
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload">
    <xf:group id="" style="margin:10px;"><w2:textbox tagname="h1" style="color: blue;margin-bottom: 10px;" tabIndex="h1" id="textbox1" label="サンプル集" escape="false">
    	</w2:textbox><w2:textbox tagname="h2" style="height: 23px;margin-bottom: 10px;color: blue;" id="textbox2" label="サンプルの使用方法"></w2:textbox><w2:textbox style="color: blue;margin-bottom: 30px;" id="textbox3" label='1. サンプル集をダウンロードします。 &amp;nbsp;&lt;br/&gt;2. ダウンロードしたサンプル集の圧縮を解凍します。 &lt;br/&gt;3. 解凍したファイルをStudioのWebSquareプロジェクトフォルダ内にコピーします。&lt;br/&gt;4. 各サンプルファイルを開き、ソースコードを確認します。 &lt;br/&gt;&lt;br/&gt;（サンプルの一覧は、解凍したファイル内の「__sample」フォルダ内にあります。）&lt;br/&gt;' escape="false">
    	</w2:textbox><xf:trigger ev:onclick="scwin.trigger1_onclick" style="height:42px; line-height:32px; padding:5px; background-color:lightpink; font-size:15px; weight:bolder; font-weight:bolder; text-align:left; margin-bottom:10px; display:block;" id="trigger1" type="button">
    		<xf:label><![CDATA[サンプル集のダウンロード]]></xf:label>
    	</xf:trigger></xf:group></body>
</html>
