define({declaration:{A:{version:'1.0',encoding:'UTF-8'}},E:[{T:1,N:'html',A:{xmlns:'http://www.w3.org/1999/xhtml','xmlns:ev':'http://www.w3.org/2001/xml-events','xmlns:w2':'http://www.inswave.com/websquare','xmlns:xf':'http://www.w3.org/2002/xforms'},E:[{T:1,N:'head',E:[{T:1,N:'w2:type',E:[{T:3,text:'DEFAULT'}]},{T:1,N:'w2:buildDate'},{T:1,N:'xf:model',E:[{T:1,N:'w2:dataCollection',A:{baseNode:'map'},E:[{T:1,N:'w2:dataList',A:{id:'dataList1',baseNode:'list',saveRemovedData:'true',repeatNode:'map'},E:[{T:1,N:'w2:columnInfo',E:[{T:1,N:'w2:column',A:{id:'col1',name:'name1',dataType:'text'}},{T:1,N:'w2:column',A:{id:'col2',name:'name2',dataType:'text'}},{T:1,N:'w2:column',A:{id:'col3',name:'name3',dataType:'text'}}]}]}]},{T:1,N:'w2:workflowCollection'}]},{T:1,N:'script',A:{type:'text/javascript'},E:[{T:4,cdata:function(scopeObj){with(scopeObj){var count = 0;
scwin.trigger1_onclick = function (e) {
  count++;
  var tmpSrc = scwin.getfolderPath() + "/widget_black.xml";
  widgetContainer1.addWidgets({
    id: tmpSrc + count,
    title: tmpSrc + count,
    src: tmpSrc,
    scope: true,
    x: 0,
    y: 0,
    unitWidth: 1,
    unitHeight: 1
  });
};
var count1 = 0;
scwin.trigger2_onclick = function (e) {
  count1++;
  var tmpSrc = scwin.getfolderPath() + "/widget_red.xml";
  widgetContainer1.addWidgets({
    id: tmpSrc + count1,
    title: tmpSrc + count1,
    src: tmpSrc,
    scope: true,
    x: 0,
    y: 1,
    unitWidth: 1,
    unitHeight: 1
  });
};
var count2 = 0;
scwin.trigger3_onclick = function (e) {
  count2++;
  var tmpSrc = scwin.getfolderPath() + "/widget_blue.xml";
  widgetContainer1.addWidgets({
    id: tmpSrc + count2,
    title: tmpSrc + count2,
    src: tmpSrc,
    scope: true,
    x: 1,
    y: 0,
    unitWidth: 1,
    unitHeight: 2
  });
};
scwin.getfolderPath = function () {
  var currentPath = window.location.href;
  var folderPath;
  if (currentPath.includes("mainContainer")) {
    console.log("true  ===> " + $p.getFrameId());
    const cmtFrame = $p.getComponentById($p.getFrameId());
    currentPath = cmtFrame.getSrc();
    folderPath = currentPath.substring(0, currentPath.lastIndexOf('/'));
  } else {
    console.log("false  ===> ");
    folderPath = currentPath.split('w2xPath=')[1].substring(0, currentPath.split('w2xPath=')[1].lastIndexOf('/'));
  }
  return folderPath;
};
}}}]}]},{T:1,N:'body',A:{style:'padding:20px;'},E:[{T:1,N:'xf:group',A:{id:'',style:''},E:[{T:1,N:'w2:textbox',A:{tagname:'h1',style:'color: blue;margin-bottom: 10px;',tabIndex:'h1',id:'textbox1',label:'Add Widget Dynamically<br/>',escape:'false'}},{T:1,N:'w2:textbox',A:{tagname:'h2',style:'height: 23px;margin-bottom: 10px;color: blue;',id:'textbox2',label:'How to Use'}},{T:1,N:'w2:textbox',A:{style:'color: blue;margin-bottom: 30px;',id:'textbox3',label:'1. Click the addWidgets() button below.<br/>2. Verify that widgets are added to the specified location using the designated source (src) file.<br/>3. Confirm that each widget can be moved and resized.<br/>(See the Script tab for detailed scripting.)<br/>',escape:'false'}},{T:1,N:'xf:trigger',A:{'ev:onclick':'scwin.trigger1_onclick',style:'height:42px;line-height:32px;padding:5px;background-color:coral;font-size:15px;weight: bolder;font-weight:bolder;text-align: left;display: block;margin-bottom: 10px;',id:'trigger1',type:'button'},E:[{T:1,N:'xf:label',E:[{T:4,cdata:'addWidgets() - widget_black.xml'}]}]},{T:1,N:'xf:trigger',A:{'ev:onclick':'scwin.trigger2_onclick',style:'height:42px;line-height:32px;padding:5px;background-color:coral;font-size:15px;weight: bolder;font-weight:bolder;text-align: left;display: block;margin-bottom: 10px;',id:'trigger2',type:'button'},E:[{T:1,N:'xf:label',E:[{T:4,cdata:'addWidgets() - widget_red.xml'}]}]},{T:1,N:'xf:trigger',A:{'ev:onclick':'scwin.trigger3_onclick',style:'height:42px;line-height:32px;padding:5px;background-color:coral;font-size:15px;weight: bolder;font-weight:bolder;text-align: left;display: block;margin-bottom: 10px;',id:'trigger3',type:'button'},E:[{T:1,N:'xf:label',E:[{T:4,cdata:'addWidgets() - widget_blue.xml'}]}]},{T:1,N:'w2:widgetContainer',A:{mode:'pushpull',unitHeightPixel:'200',preventMaximizeByTitle:'true',widgetMove:'true',style:'height: 400px;border:1px solid black;',id:'widgetContainer1',cols:'3','ev:onwidgetmove':'scwin.widgetContainer1_onwidgetmove'}}]}]}]}]})