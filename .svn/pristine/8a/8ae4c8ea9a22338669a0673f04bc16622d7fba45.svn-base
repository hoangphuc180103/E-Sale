<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare"
	xmlns:xf="http://www.w3.org/2002/xforms">
	<head meta_author="InswaveSystems" meta_type="메인" meta_screenName="[InputCalendar] 브라우저에 렌더링할 때, 달력의 하단 영역을 'div' 또는 'table' 태그로 구성하기">
		<w2:historyInfo>
			<w2:history meta_no="01" meta_desc="최초작성" meta_date="20230911" meta_user="InswaveSystems"></w2:history>
			<w2:history meta_no="02" meta_desc="설명부 수정" meta_date="20240621" meta_user="InswaveSystems" ></w2:history>
		</w2:historyInfo>
		<w2:type>COMPONENT</w2:type>
		<w2:buildDate />
		<w2:MSA />
		<xf:model>
			<w2:dataCollection baseNode="map">
			</w2:dataCollection>
			<w2:workflowCollection />
		</xf:model>
		<w2:layoutInfo />
		<w2:publicInfo method="" />
		<script lazy="false" type="text/javascript"><![CDATA[
scwin.onpageload = function () {
    
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:group class="sub_contents" id="" style="">
			<xf:group class="ws_example_grp_desc" id="" style="">
				<w2:textbox escape="false" id=""
					label="InputCalendar의 'footerDiv' 속성을 사용하여 브라우저에 렌더링될 때, 달력의 하단 영역을 'div' 또는 'table' 태그로 설정한 예제입니다" style="">
				</w2:textbox>
				<w2:textbox class="ws_example_txt_desc_info" escape="false" id="" label="달력 아이콘을 클릭하고, 화면에 표시되는 달력 하단(Today, 선택된 날짜 문자열)의 HTML 요소를 개발자도구(Elements)를 통해 확인합니다."
					style="">
				</w2:textbox>
			</xf:group>
			<xf:group class="example_div_tb_style_wrap" id="">
				<xf:group class="example_div_tr_style" id="" style="">
					<w2:textbox class="example_div_th_style" escape="false" id="" label="(기본 설정 값) 달력의 하단 영역을 태그 'table'로 구성하기" style=""></w2:textbox>
					<xf:group class="example_div_td_style" id="" style="">
						<xf:group class="mb_def_box nobottom" id="" style="">
							<w2:inputCalendar calendarValueType="yearMonthDate" id="" style="width:120px;height: 26px;" footerDiv="false"></w2:inputCalendar>
						</xf:group>
					</xf:group>
				</xf:group>
				<xf:group class="example_div_tr_style" id="" style="">
					<w2:textbox class="example_div_th_style" escape="false" id="" label="달력의 하단 영역을 태그 'div'로 구성하기" style=""></w2:textbox>
					<xf:group class="example_div_td_style" id="" style="">
						<xf:group class="mb_def_box nobottom" id="" style="">
							<w2:inputCalendar calendarValueType="yearMonthDate" id="" style="width:120px;height: 26px;" footerDiv="true"></w2:inputCalendar>
						</xf:group>
					</xf:group>
				</xf:group>
			</xf:group>
		</xf:group>
	</body>
</html>