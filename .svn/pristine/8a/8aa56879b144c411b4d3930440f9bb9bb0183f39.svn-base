<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare"
	xmlns:xf="http://www.w3.org/2002/xforms">
	<head meta_author="InswaveSystems" meta_type="메인" meta_screenName="[Input] displayFormatter 적용하기">
		<w2:historyInfo>
			<w2:history meta_no="01" meta_desc="최초작성" meta_date="20230228" meta_user="InswaveSystems" ></w2:history>
			<w2:history meta_no="02" meta_desc="설명부 수정" meta_date="20240621" meta_user="InswaveSystems" ></w2:history>
		</w2:historyInfo>
		<w2:type>COMPONENT</w2:type>
		<w2:buildDate />
		<w2:MSA />
		<xf:model>
			<w2:dataCollection baseNode="map">
			</w2:dataCollection>
			<w2:workflowCollection />
		</xf:model>
		<w2:layoutInfo />
		<w2:publicInfo method="" />
		<script lazy="false" type="text/javascript"><![CDATA[
scwin.onpageload = function () {

};

/**
 * 영역 ['displayFormatter' 속성에 Input 입력값을 소문자에서 대문자로 바꿔주는 메소드 지정]의
 * 입력 [ibx_exam2]의 displayFormatter 메소드
 */
scwin.toUpperCaseFormatter = function (value) {
    return value.toUpperCase();
};]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:group class="sub_contents" id="" style="">
			<xf:group class="ws_example_grp_desc" id="" style="">
				<w2:textbox escape="false" id=""
					label="Input의 'displayFormatter' 속성을 사용하여 입력 값을 대문자로 표시되도록 설정한 예제입니다."
					style="">
				</w2:textbox>
			</xf:group>
			<xf:group class="example_div_tb_style_wrap" id="">
				<xf:group class="example_div_tr_style" id="" style="">
					<xf:group class="example_div_td_style" id="" style="">
						<xf:input class="" id="ibx_exam2" maxByteLength="8" style="min-width:120px;" dataType="text"
							displayFormatter="scwin.toUpperCaseFormatter" placeholder="입력 예시) abcedf">
						</xf:input>
					</xf:group>
				</xf:group>
				<xf:group class="example_div_tr_style" id="" style="">
				</xf:group>
			</xf:group>
		</xf:group>
	</body>
</html>