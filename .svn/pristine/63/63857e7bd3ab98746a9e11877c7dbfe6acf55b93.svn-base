  $p.openPopup("", options);
};
scwin.trigger2_onclick = function (e) {
  scwin.count++;
  var options = {
    id: scwin.count,
    type: "pageFramePopup",
    height: "300px",
    width: "400px",
    popupName: "fixPosition: false",
    fixPosition: false
  };
  $p.openPopup("", options);
};
}}}]}]},{T:1,N:'body',A:{'ev:onpageload':'scwin.onpageload','ev:onpageunload':'scwin.onpageunload'},E:[{T:1,N:'xf:group',A:{id:'',style:'margin: 10px;'},E:[{T:1,N:'w2:textbox',A:{tagname:'h1',style:'color: blue;margin-bottom: 10px;',id:'textbox1',label:'Fix Popup Position<br/>',escape:'false'}},{T:1,N:'w2:textbox',A:{tagname:'h2',style:'height: 23px;margin-bottom: 10px;color: blue;',id:'textbox2',label:'How to Use'}},{T:1,N:'w2:textbox',A:{style:'color: blue;margin-bottom: 30px;',id:'textbox3',label:'1-1. Click the first button to create a popup.<br/>1-2. Verify that the created popup\'s position is fixed and cannot be moved. (fixPosition: true)<br/>(See the Script tab for detailed script.)<br/><br/>2-1. Click the second button to create a popup.<br/>2-2. Verify that the created popup\'s position can be moved. (fixPosition: false)<br/>(See the Script tab for detailed script.)',escape:'false'}},{T:1,N:'xf:trigger',A:{'ev:onclick':'scwin.trigger1_onclick',style:'display: block;height:42px;line-height:32px;padding:5px;background-color:coral;font-size:15px;weight: bolder;font-weight:bolder;margin-bottom:10px;text-align: left;',id:'trigger1',type:'button'},E:[{T:1,N:'xf:label',E:[{T:4,cdata:'openPopup() - fixPosition: true'}]}]},{T:1,N:'xf:trigger',A:{type:'button',id:'trigger2',style:'display: block;height:42px;line-height:32px;padding:5px;background-color:coral;font-size:15px;weight: bolder;font-weight:bolder;margin-bottom:10px;text-align: left;','ev:onclick':'scwin.trigger2_onclick'},E:[{T:1,N:'xf:label',E:[{T:4,cdata:'openPopup() - fixPosition: false'}]}]}]}]}]}]})