<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head meta_screenName="guide_sample">
    	<w2:type>DEFAULT</w2:type>
    	<w2:buildDate />
    	<xf:model>
    		<xf:instance>
    			<data xmlns="" />
    		</xf:instance>
    		<w2:dataCollection baseNode="map">
    			<w2:dataList baseNode="list" id="dataList1" repeatNode="map" saveRemovedData="true" style="">
    				<w2:columnInfo>
    					<w2:column dataType="text" id="col1" name="col1"></w2:column>
    					<w2:column dataType="text" id="col2" name="col2"></w2:column>
    					<w2:column dataType="text" id="col3" name="col3"></w2:column>
    					<w2:column dataType="text" id="col4" name="col4"></w2:column>
    				</w2:columnInfo>
    			</w2:dataList>
    			<w2:dataList baseNode="list" repeatNode="map" id="dataList2">
    				<w2:columnInfo>
    					<w2:column id="col1" name="col1" dataType="text"></w2:column>
    					<w2:column id="col2" name="col2" dataType="text"></w2:column>
    					<w2:column id="col3" name="col3" dataType="text"></w2:column>
    					<w2:column id="col4" name="col4" dataType="text"></w2:column>
    				</w2:columnInfo>
    			</w2:dataList>
    		</w2:dataCollection>
    		<w2:workflowCollection></w2:workflowCollection>
    	</xf:model>
    	<script type="text/javascript" lazy="false"><![CDATA[

scwin.onpageload = function () {
    var json = [

        { "col1": "Asia", "col2": "China", "col3": "TV", "col4": "400" },
        { "col1": "Asia", "col2": "China", "col3": "Freezer", "col4": "300" },
        { "col1": "Asia", "col2": "China", "col3": "Washer", "col4": "100" },
        { "col1": "Asia", "col2": "Japan", "col3": "TV", "col4": "100" },
        { "col1": "Asia", "col2": "Japan", "col3": "Freezer", "col4": "300" },
        { "col1": "Asia", "col2": "Japan", "col3": "Washer", "col4": "200" },
        { "col1": "Europe", "col2": "Germany", "col3": "TV", "col4": "100" },
        { "col1": "Europe", "col2": "Germany", "col3": "Freezer", "col4": "300" },
        { "col1": "Europe", "col2": "Germany", "col3": "Washer", "col4": "200" },
        { "col1": "Europe", "col2": "France", "col3": "TV", "col4": "100" },
        { "col1": "Europe", "col2": "France", "col3": "Freezer", "col4": "300" },
        { "col1": "Europe", "col2": "France", "col3": "Washer", "col4": "200" },
        { "col1": "Europe", "col2": "Denmark", "col3": "TV", "col4": "100" },
        { "col1": "Europe", "col2": "Denmark", "col3": "Freezer", "col4": "300" },
        { "col1": "Europe", "col2": "Denmark", "col3": "Washer", "col4": "200" },
        { "col1": "Americas", "col2": "Canada", "col3": "TV", "col4": "100" },
        { "col1": "Americas", "col2": "Canada", "col3": "Freezer", "col4": "300" },
        { "col1": "Americas", "col2": "Canada", "col3": "Washer", "col4": "200" },
        { "col1": "Americas", "col2": "USA", "col3": "TV", "col4": "100" },
        { "col1": "Americas", "col2": "USA", "col3": "Freezer", "col4": "300" },
        { "col1": "Americas", "col2": "USA", "col3": "Washer", "col4": "200" },
        { "col1": "Americas", "col2": "Mexico", "col3": "TV", "col4": "100" },
        { "col1": "Americas", "col2": "Mexico", "col3": "Freezer", "col4": "300" },
        { "col1": "Americas", "col2": "Mexico", "col3": "Washer", "col4": "200" }
    ];
    dataList1.setJSON(json);
    dataList2.setJSON(json);
    gridView1.setColumnBackgroundColor("col4", "pink");
    gridView2.setColumnBackgroundColor("col4", "pink");
};

scwin.onpageunload = function () {

};

scwin.trigger1_onclick = function (e) {
    var increment = gridView1.getColumnIncrement("col4");
    alert("Increment : " + increment);
};

scwin.trigger2_onclick = function (e) {
    gridView2.setColumnIncrement("col4", 100);
};

scwin.trigger3_onclick = function (e) {
    var increment = gridView2.getColumnIncrement("col4");
    alert("Increment : " + increment);

};
]]></script>
    	<style type="text/css"><![CDATA[ ]]></style>
    </head>
    <body ev:onpageload="scwin.onpageload" ev:onpageunload="scwin.onpageunload">
    <xf:group id="" style="margin: 10px;">
    	<w2:textbox tagname="h1" style="color: blue;margin-bottom: 10px;" tabIndex="h1" id="textbox1"
    		label="Set and Check Increment/Decrement Unit for inputType='spinner' Column" escape="false">
    	</w2:textbox>
    	<w2:textbox tagname="h2" style="height: 23px;margin-bottom: 10px;color: blue;" id="textbox2" label="How to Use"></w2:textbox>
    	<w2:textbox style="color: blue;margin-bottom: 30px;" id="textbox3"
    		label='(First GridView)&lt;br/&gt;1. Click the arrow button in the col4 column to change the value.&lt;br/&gt;2. Verify the value increases or decreases in increments of “50”.&lt;br/&gt;3. Click the getColumnIncrement(“col4”) button above the GridView. &lt;br/&gt;4. Verify that the increment unit “50” is displayed.&lt;br/&gt;&lt;br/&gt;(Second GridView)&lt;br/&gt;1. Click the arrow button in the col4 column to change the value.&lt;br/&gt;2. Verify that the value increases or decreases in increments of “1”.&lt;br/&gt;3. Click the setColumnIncrement(“col4”, 100) button above the GridView. &lt;br/&gt;4. Click the arrow button in the col4 column again to change the value.&lt;br/&gt;5. Verify the value increases or decreases in increments of “100”.&lt;br/&gt;6. Click the getColumnIncrement(“col4”) button above the GridView.&lt;br/&gt;7. Verify the increment value “100” is displayed.'
    		escape="false">
    	</w2:textbox>
    	<w2:textbox
    		style="padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightblue;border:none;margin-bottom: 10px;"
    		id="textbox4" label='increment="50" (id="col4" gridView.column)' escape="false">
    	</w2:textbox>
    	<xf:trigger type="button" id="trigger1"
    		style="height:42px; line-height:32px; padding:5px; background-color:pink; font-size:15px; weight:bolder; font-weight:bolder; text-align:left; display:block; margin-bottom:10px;"
    		ev:onclick="scwin.trigger1_onclick">
    		<xf:label><![CDATA[getColumnIncrement("col4")]]></xf:label>
    	</xf:trigger>
    	<w2:gridView rowNumVisible="" showSortableImage="true" scrollByColumn="false" defaultCellHeight="30" focusMode="both"
    		selectedCellColor="" dataDragSelect="" id="gridView1" autoFit="allColumn" cellStatusVisible="true" checkEditOnPaste="true"
    		scrollByColumnAdaptive="false" hammerEnabled="true" dataDragDrop="true" selectedRowColor="" useShiftKey="true" useCtrlOnMultisort=""
    		dataDragDropStatus="true" rowStatusVisible="" dataList="data:dataList1" style="border:solid gray 1px; margin-bottom:10px;"
    		cellStatusIconPosition="left" useCtrlKey="" autoFitMinWidth="100" visibleRowNum="5" visibleRowNumFix="true">
    		<w2:caption style="" id="caption1" value="this is a grid caption."></w2:caption>
    		<w2:header style="" id="header1">
    			<w2:row style="" id="row1">
    				<w2:column width="70" inputType="text" style="" id="column2" value="col1" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="height:20px" id="column3" value="col2" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="height:20px" id="column2" value="col3" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="height:20px" id="column1" value="col4" displayMode="label"></w2:column>
    			</w2:row>
    		</w2:header>
    		<w2:gBody style="" id="gBody1">
    			<w2:row style="" id="row2">
    				<w2:column width="70" inputType="text" style="" id="col1" value="" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="height:20px" id="col2" value="" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="height:20px" id="col3" value="" displayMode="label"></w2:column>
    				<w2:column max="" increment="50" displayMode="label" blockSelect="true" min="" width="70" viewType="icon"
    					validateOnInput="" inputType="spinner" style="height:30px;" id="col4" value="" class=".blue">
    				</w2:column>
    			</w2:row>
    		</w2:gBody>
    	</w2:gridView>
    	<w2:textbox tagname=""
    		style="padding:10px; padding-bottom:20px; text-align:left; font-size:15px; font-weight:bolder; border:brown 1px solid; background-color:ivory; margin-bottom:10px; color:brown;"
    		id="textbox7"
    		label='/// Sample Code&lt;br/&gt;&lt;br/&gt;var increment = gridView1.getColumnIncrement("col4");&lt;br/&gt;alert("Increment : " + increment);'
    		escape="false">
    	</w2:textbox>
    	<w2:textbox
    		style="padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightblue;border:none;margin-bottom: 10px;"
    		id="textbox6" label='Dynamic Setting' escape="false">
    	</w2:textbox>
    	<xf:trigger type="button" id="trigger2"
    		style="height:42px; line-height:32px; padding:5px; background-color:coral; font-size:15px; weight:bolder; font-weight:bolder; text-align:left; display:block; margin-bottom:10px;"
    		ev:onclick="scwin.trigger2_onclick">
    		<xf:label><![CDATA[setColumnIncrement("col4", 100)]]></xf:label>
    	</xf:trigger>
    	<xf:trigger type="button" id="trigger3"
    		style="height:42px; line-height:32px; padding:5px; background-color:pink; font-size:15px; weight:bolder; font-weight:bolder; text-align:left; display:block; margin-bottom:10px;"
    		ev:onclick="scwin.trigger3_onclick">
    		<xf:label><![CDATA[getColumnIncrement("col4")]]></xf:label>
    	</xf:trigger>
    	<w2:gridView checkAllType="false" id="gridView2" style="border:solid gray 1px; margin-bottom:10px;" dataList="data:dataList2"
    		visibleRowNum="5" visibleRowNumFix="true" autoFit="allColumn">
    		<w2:caption style="" id="caption2" value="this is a grid caption."></w2:caption>
    		<w2:header style="" id="header2">
    			<w2:row style="" id="row3">
    				<w2:column width="70" style="" inputType="text" id="column6" value="col1"></w2:column>
    				<w2:column width="70" style="" inputType="text" id="column5" value="col2"></w2:column>
    				<w2:column width="70" style="" inputType="text" id="column4" value="col3"></w2:column>
    				<w2:column width="70" style="" inputType="text" id="column3" value="col4"></w2:column>
    			</w2:row>
    		</w2:header>
    		<w2:gBody style="" id="gBody2">
    			<w2:row style="" id="row4">
    				<w2:column width="70" style="" inputType="text" id="col1" value=""></w2:column>
    				<w2:column width="70" style="" inputType="text" id="col2" value=""></w2:column>
    				<w2:column width="70" style="" inputType="text" id="col3" value=""></w2:column>
    				<w2:column width="70" style="" inputType="spinner" id="col4" value="" viewType="icon"></w2:column>
    			</w2:row>
    		</w2:gBody>
    	</w2:gridView>
    	<w2:textbox escape="false" id="textbox8"
    		label='/// Sample Code&lt;br/&gt;&lt;br/&gt;gridView2.setColumnIncrement("col4", 100);&lt;br/&gt;&lt;br/&gt;var increment = gridView2.getColumnIncrement("col4");&lt;br/&gt;alert("Increment : " + increment);'
    		style="padding:10px; padding-bottom:20px; text-align:left; font-size:15px; font-weight:bolder; border:brown 1px solid; background-color:ivory; margin-bottom:10px; color:brown;"
    		tagname="">
    	</w2:textbox>
    </xf:group></body>
</html>
