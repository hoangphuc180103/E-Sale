<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
        	<xf:instance>
        		<data xmlns="" />
        	</xf:instance>
        	<w2:dataCollection baseNode="map">
        		<w2:dataList baseNode="list" repeatNode="map" id="dataList1" saveRemovedData="true">
        			<w2:columnInfo>
        				<w2:column id="col1" name="name1" dataType="text"></w2:column>
        				<w2:column id="col2" name="name2" dataType="text"></w2:column>
        				<w2:column id="col3" name="name3" dataType="text"></w2:column>
        			</w2:columnInfo>
        		</w2:dataList>
        		<w2:dataList baseNode="list" repeatNode="map" id="dataList4" saveRemovedData="true">
        			<w2:columnInfo>
        				<w2:column id="col5" name="name5" dataType="text"></w2:column>
        				<w2:column id="col6" name="name6" dataType="text"></w2:column>
        			</w2:columnInfo>
        		</w2:dataList>
        	</w2:dataCollection>
        	<w2:workflowCollection></w2:workflowCollection>
        	<xf:submission id="submission1" ref="" target="data:json,dataList1" action="testdata.json" method="post"
        		mediatype="application/json" encoding="UTF-8" instance="" replace="" errorHandler="" customHandler="" mode="asynchronous"
        		processMsg="" ev:submit="" ev:submitdone="" ev:submiterror="" abortTrigger="">
        	</xf:submission>
        	<xf:submission id="submission4" ref="" target="data:json,dataList4" action="testdata4.json" method="post"
        		mediatype="application/json" encoding="UTF-8" instance="" replace="" errorHandler="" customHandler="" mode="asynchronous"
        		processMsg="" ev:submit="" ev:submitdone="" ev:submiterror="" abortTrigger="">
        	</xf:submission>
        </xf:model>
        <script type="text/javascript" lazy="false"><![CDATA[

scwin.onpageload = function () {
    const tmpSrc1 = scwin.getfolderPath() + "/source2.xml";
    wframe1.setSrc(tmpSrc1);

    const tmpSrc2 = scwin.getfolderPath() + "/source3.xml";
    wframe2.setSrc(tmpSrc2);

    var objSubmission1 = $p.getSubmission("submission1");
    objSubmission1.action = scwin.getfolderPath() + '/testdata.json';
    $p.executeSubmission("submission1");

    var objSubmission4 = $p.getSubmission("submission4");
    objSubmission4.action = scwin.getfolderPath() + '/testdata4.json';
    $p.executeSubmission("submission4");
};

scwin.onpageunload = function () {

};


scwin.trigger1_onclick = function (e) {
    var list = $p.getSubmissionList({ "returnType": "json", "all": true });
    alert(JSON.stringify(list));
};

scwin.getfolderPath = function () {

    var currentPath = window.location.href;
    var folderPath;

    if (currentPath.includes("mainContainer")) {
        console.log("true  ===> " + $p.getFrameId());
        const cmtFrame = $p.getComponentById($p.getFrameId());
        currentPath = cmtFrame.getSrc();
        folderPath = currentPath.substring(0, currentPath.lastIndexOf('/'));
    } else {
        console.log("false  ===> ");
        folderPath = currentPath.split('w2xPath=')[1].substring(0, currentPath.split('w2xPath=')[1].lastIndexOf('/'));
    }
    return folderPath;
};]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload" ev:onpageunload="scwin.onpageunload">
    	<xf:group id="" style="margin: 10px;">
    		<w2:textbox tagname="h1" style="color: blue;margin-bottom: 10px;" id="textbox1" label="전체 Submission 객체 반환" escape="false">
    		</w2:textbox>
    		<w2:textbox tagname="h2" style="height: 23px;margin-bottom: 10px;color: blue;" id="textbox2" label="샘플 사용 방법"></w2:textbox>
    		<w2:textbox style="color: blue;margin-bottom: 30px;" id="textbox3" label='(메인 화면 - "submission1" &amp; "submission4", 첫 번째 프레임 - "submission2", 두 번째 프레임 - "submission3")&lt;br/&gt;&lt;br/&gt;1-1. 첫 번째 버튼을 클릭. &lt;br/&gt;1-2. 전체 화면에 포함된 Submission들의 정보가 표시되는 것을 확인. &lt;br/&gt;&lt;br/&gt;2-1. 화면의 첫 번째 프레임에 포함된 버튼을 클릭. &lt;br/&gt;2-2. 해당 프레임 내부의 Submisison의 정보만 표시되는 것을 확인. &lt;br/&gt;&lt;br/&gt;3-1. 화면의 두 번째 프레임에 포함된 버튼을 클릭. &lt;br/&gt;3-3. 해당 프레임을 포함한 부모 화면 전체에 포함된 Submisison들의 정보가 표시되는 것을 확인.&lt;br/&gt;&lt;br/&gt;(자세한 스크립트는 Script 탭에서 확인.)' escape="false">
    		</w2:textbox>
    		<xf:trigger ev:onclick="scwin.trigger1_onclick"
    			style="display: block;height:42px;line-height:32px;padding:5px;background-color:coral;font-size:15px;weight: bolder;font-weight:bolder;margin-bottom:10px;text-align: left;"
    			id="trigger1" type="button">
    			<xf:label><![CDATA[getSubmissionList({ "returnType": "json", "all": true })]]></xf:label>
    		</xf:trigger>
    		<w2:gridView rowNumVisible="true" visibleRowNumFix="true" checkAllType="false" dataList="data:dataList1"
    			style="border: solid 1px gray;margin-bottom: 10px;" id="gridView1" visibleRowNum="5" autoFit="allColumn" defaultCellHeight="20">
    			<w2:caption style="" id="caption1" value="this is a grid caption."></w2:caption>
    			<w2:header style="" id="header1">
    				<w2:row style="" id="row1">
    					<w2:column width="70" inputType="text" style="" id="column3" value="name1" displayMode="label"></w2:column>
    					<w2:column width="70" inputType="text" style="" id="column2" value="name2" displayMode="label"></w2:column>
    					<w2:column width="70" inputType="text" style="" id="column1" value="name3" displayMode="label"></w2:column>
    				</w2:row>
    			</w2:header>
    			<w2:gBody style="" id="gBody1">
    				<w2:row style="" id="row2">
    					<w2:column width="70" inputType="text" style="" id="col1" value="" displayMode="label"></w2:column>
    					<w2:column width="70" inputType="text" style="" id="col2" value="" displayMode="label"></w2:column>
    					<w2:column width="70" inputType="text" style="" id="col3" value="" displayMode="label"></w2:column>
    				</w2:row>
    			</w2:gBody>
    		</w2:gridView>
    		<w2:gridView rowNumVisible="true" visibleRowNumFix="true" checkAllType="false" dataList="data:dataList4"
    			style="border: solid 1px gray;margin-bottom: 20px;" id="gridView2" visibleRowNum="5" autoFit="allColumn" defaultCellHeight="20">
    			<w2:caption style="" id="caption2" value="this is a grid caption."></w2:caption>
    			<w2:header style="" id="header2">
    				<w2:row style="" id="row3">
    					<w2:column width="70" inputType="text" style="" id="column11" value="name5" displayMode="label"></w2:column>
    					<w2:column width="70" inputType="text" style="" id="column10" value="name6" displayMode="label"></w2:column>
    				</w2:row>
    			</w2:header>
    			<w2:gBody style="" id="gBody2">
    				<w2:row style="" id="row4">
    					<w2:column width="70" inputType="text" style="" id="col5" value="" displayMode="label"></w2:column>
    					<w2:column width="70" inputType="text" style="" id="col6" value="" displayMode="label"></w2:column>
    				</w2:row>
    			</w2:gBody>
    		</w2:gridView>
    		<w2:wframe scope="true" style="border:solid 2px magenta;margin-bottom: 20px;" id="wframe1" processMsgFrame="true"></w2:wframe>
    		<w2:wframe style="border:solid 2px blue" id="wframe2">
    	</w2:wframe>
    	</xf:group>
    </body>
</html>
