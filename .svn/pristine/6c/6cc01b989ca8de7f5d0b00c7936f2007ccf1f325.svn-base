        type: "wframePopup", // [필수 고정 값] 팝업 콘텐츠를 wframe으로 구성
        fixPosition: "true", // [필수 고정 값] 팝업의 위치를 고정
        width: "300px",
        height: "180px",
        popupName: "[이동 불가] wframePopup"
