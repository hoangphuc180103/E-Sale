define({declaration:{A:{version:'1.0',encoding:'UTF-8'}},E:[{T:1,N:'html',A:{xmlns:'http://www.w3.org/1999/xhtml','xmlns:ev':'http://www.w3.org/2001/xml-events','xmlns:w2':'http://www.inswave.com/websquare','xmlns:xf':'http://www.w3.org/2002/xforms'},E:[{T:1,N:'head',E:[{T:1,N:'w2:type',E:[{T:3,text:'DEFAULT'}]},{T:1,N:'w2:buildDate'},{T:1,N:'xf:model',E:[{T:1,N:'w2:dataCollection',A:{baseNode:'map'}},{T:1,N:'w2:workflowCollection'}]},{T:1,N:'script',A:{type:'text/javascript',lazy:'false'},E:[{T:4,cdata:function(scopeObj){with(scopeObj){scwin.count = 0;
scwin.onpageload = function () {};
scwin.onpageunload = function () {};
scwin.trigger1_onclick = function (e) {
  scwin.count++;
  var tmpSrc1 = scwin.getfolderPath() + "/sub_red.xml";
  var tmpSrc2 = scwin.getfolderPath() + "/sub_green.xml";
  var tmpSrc3 = scwin.getfolderPath() + "/sub_blue.xml";
  windowContainer1.createWindow({
    "title": "Red " + scwin.count,
    "src": tmpSrc1,
    "windowId": scwin.count,
    "frameMode": "wframe"
  });
  windowContainer1.createWindow({
    "title": "Green " + scwin.count,
    "src": tmpSrc2,
    "windowId": scwin.count + 1,
    "frameMode": "wframe"
  });
  windowContainer1.createWindow({
    "title": "Blue " + scwin.count,
    "src": tmpSrc3,
    "windowId": scwin.count + 2,
    "frameMode": "wframe"
  });
  windowContainer1.setArrangeWindows("sequential");
};
scwin.getfolderPath = function () {
  var currentPath = window.location.href;
  var folderPath;
  if (currentPath.includes("mainContainer")) {
    console.log("true  ===> " + $p.getFrameId());
    const cmtFrame = $p.getComponentById($p.getFrameId());
    currentPath = cmtFrame.getSrc();
    folderPath = currentPath.substring(0, currentPath.lastIndexOf('/'));
  } else {
    console.log("false  ===> ");
    folderPath = currentPath.split('w2xPath=')[1].substring(0, currentPath.split('w2xPath=')[1].lastIndexOf('/'));
  }
  return folderPath;
};
}}}]}]},{T:1,N:'body',A:{'ev:onpageload':'scwin.onpageload','ev:onpageunload':'scwin.onpageunload'},E:[{T:1,N:'xf:group',A:{id:'',style:'margin: 10px;'},E:[{T:1,N:'w2:textbox',A:{tagname:'h1',style:'color: blue;margin-bottom: 10px;',tabIndex:'h1',id:'textbox1',label:'ウィンドウの作成',escape:'false'}},{T:1,N:'w2:textbox',A:{tagname:'h2',style:'height: 23px;margin-bottom: 10px;color: blue;',id:'textbox2',label:'サンプルの使い方'}},{T:1,N:'w2:textbox',A:{style:'color: blue;margin-bottom: 30px;',id:'textbox3',label:'1. 下部の createWindow() ボタンをクリックします。 <br/>2. ウィンドウが生成されることを確認してください。 <br/>（詳細なスクリプトは Script タブで確認。）',escape:'false'}},{T:1,N:'w2:textbox',A:{style:'padding:10px; padding-bottom:20px; text-align:left; font-size:15px; font-weight:bolder; border:brown 1px solid; background-color:ivory; margin-bottom:10px; margin-top:10px; color:brown;',id:'textbox4',label:'/// サンプルファイル<br/><br/>scwin.count++;<br/><br/>windowContainer1.createWindow({<br/> &nbsp; &nbsp;"title": "Red " + scwin.count,<br/> &nbsp; &nbsp;"src": "sub_red.xml",<br/> &nbsp; &nbsp;"windowId": scwin.count,<br/> &nbsp; &nbsp;"frameMode": "wframe"<br/>});<br/>windowContainer1.createWindow({<br/> &nbsp; &nbsp;"title": "Green " + scwin.count,<br/> &nbsp; &nbsp;"src": "sub_green.xml",<br/> &nbsp; &nbsp;"windowId": scwin.count + 1,<br/> &nbsp; &nbsp;"frameMode": "wframe"<br/>});<br/>windowContainer1.createWindow({<br/> &nbsp; &nbsp;"title": "Blue " + scwin.count,<br/> &nbsp; &nbsp;"src": "sub_blue.xml",<br/> &nbsp; &nbsp;"windowId": scwin.count + 2,<br/> &nbsp; &nbsp;"frameMode": "wframe"<br/>});',escape:'false'}},{T:1,N:'xf:trigger',A:{type:'button',id:'trigger1',style:'height:42px;line-height:32px;padding:5px;background-color:coral;font-size:15px;weight: bolder;font-weight:bolder;text-align: left;display: block;margin-bottom: 10px;','ev:onclick':'scwin.trigger1_onclick'},E:[{T:1,N:'xf:label',E:[{T:4,cdata:'createWindow()'}]}]},{T:1,N:'w2:windowContainer',A:{sequentialArrangeColNum:'2',sequentialArrangeRowNum:'2',fixArrangeFul