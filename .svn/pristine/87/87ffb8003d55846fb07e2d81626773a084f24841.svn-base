//오름차순으로 정렬 버튼  
scwin.btn_getParent_onclick = function (e) {
  //1."EMP_NM" 으로 정렬 [0,1,2] 정렬 옵션 (0: 오름차순, 1: 내림차순, 2: 정렬 취소)
