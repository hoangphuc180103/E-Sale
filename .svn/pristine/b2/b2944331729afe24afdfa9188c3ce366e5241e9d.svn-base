<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare"
	xmlns:xf="http://www.w3.org/2002/xforms">
	<head meta_author="InswaveSystems" meta_type="메인" meta_screenName="[GridView] CSV 다운로드 시 다운로드할 데이터 출처 설정하기">
		<w2:historyInfo>
			<w2:history meta_no="01" meta_desc="최초작성" meta_date="20230310" meta_user="InswaveSystems"></w2:history>
			<w2:history meta_no="02" meta_desc="설명부 수정" meta_date="20240621" meta_user="InswaveSystems"></w2:history>
			<w2:history meta_no="03" meta_desc="예제에서 사용하는 DataList가 변경되고, 이에 따른 GridVeiw의 설정이 수정되었습니다." meta_date="20240712" meta_user="InswaveSystems"></w2:history>
		</w2:historyInfo>
		<w2:type>COMPONENT</w2:type>
		<w2:buildDate />
		<w2:MSA />
		<xf:model>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" id="dlt_exam" repeatNode="map" style="" valueAttribute="">
					<w2:columnInfo>
						<w2:column dataType="text" id="product" name="Product"></w2:column>
						<w2:column dataType="text" id="stock" name="Stock"></w2:column>
						<w2:column id="category_code" name="Category" dataType="text"></w2:column>
					</w2:columnInfo>
					<w2:data use="true">
						<w2:row>
							<product><![CDATA[SecureGate]]></product>
							<stock><![CDATA[98291]]></stock>
							<category_code><![CDATA[0001]]></category_code>
						</w2:row>
						<w2:row>
							<product><![CDATA[FastServe]]></product>
							<stock><![CDATA[528]]></stock>
							<category_code><![CDATA[0002]]></category_code>
						</w2:row>
						<w2:row>
							<product><![CDATA[CloudFlex]]></product>
							<stock><![CDATA[73928]]></stock>
							<category_code><![CDATA[0003]]></category_code>
						</w2:row>
						<w2:row>
							<product><![CDATA[CodeStream]]></product>
							<stock><![CDATA[6894]]></stock>
							<category_code><![CDATA[0001]]></category_code>
						</w2:row>
					</w2:data>
				</w2:dataList>
				<w2:dataList id="dlt_code" baseNode="list" saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="label" name="화면에 출력될 값" dataType="text"></w2:column>
						<w2:column id="code" name="코드값" dataType="text"></w2:column>
					</w2:columnInfo>
					<w2:data use="true">
						<w2:row>
							<label><![CDATA[Software]]></label>
							<code><![CDATA[0001]]></code>
						</w2:row>
						<w2:row>
							<label><![CDATA[Hardware]]></label>
							<code><![CDATA[0002]]></code>
						</w2:row>
						<w2:row>
							<label><![CDATA[Services]]></label>
							<code><![CDATA[0003]]></code>
						</w2:row>
					</w2:data>
				</w2:dataList>
			</w2:dataCollection>
			<w2:workflowCollection />
		</xf:model>
		<w2:layoutInfo />
		<w2:publicInfo method="" />
		<script lazy="false" type="text/javascript"><![CDATA[
scwin.onpageload = function () {

};

/**
 * 버튼 [(기본 설정) 화면의 표시 값으로 CSV 다운로드] 클릭 시
 */
scwin.btn_ex1_onclick = function (e) {
    var jsnOptions;

    jsnOptions = {
        fileName: "EXAMPLE_P00244_TYPE1.csv", //파일명
        type: "1" //다운로드할 데이터 - 화면의 표시 값
    };

    //GridView 'grd_exam1'의 데이터를 CSV 형식으로 다운로드합니다.
    grd_exam1.saveCSV(jsnOptions);
};

/**
 * 버튼 [value로 CSV 다운로드] 클릭 시
 */
scwin.btn_ex2_onclick = function (e) {
    var jsnOptions;

    jsnOptions = {
        fileName: "EXAMPLE_P00244_TYPE2.csv", //파일명
        type: "0" //다운로드할 데이터 - value

    };

    //GridView 'grd_exam1'의 데이터를 CSV 형식으로 다운로드합니다.
    grd_exam1.saveCSV(jsnOptions);
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:group class="sub_contents" id="" style="">
			<xf:group class="ws_example_grp_desc" id="" style="">
				<w2:textbox class="" escape="false" id="" label="GridView의 'saveCSV' 메소드를 사용하여, CSV 형식으로 다운로드할 데이터를 설정한 예제입니다." style="">
				</w2:textbox>
			</xf:group>
			<xf:group class="example_div_tb_style_wrap" id="">
				<xf:group class="mb_def_box nobottom" id="" style="">
					<xf:trigger class="btn_exam_exec btn_txt_of" ev:onclick="scwin.btn_ex1_onclick" id="btn_ex1" localeRef=""
						style="min-width: 30px; height: 26px;" type="" useDefaultLabel="true">
						<xf:label><![CDATA[(기본 설정) 화면의 표시 값으로 CSV 다운로드]]></xf:label>
					</xf:trigger>
					<xf:trigger class="btn_exam_exec btn_txt_of" ev:onclick="scwin.btn_ex2_onclick" id="btn_ex2" localeRef=""
						style="min-width:30px;height:26px;" type="" useDefaultLabel="true">
						<xf:label><![CDATA[value로 CSV 다운로드]]></xf:label>
					</xf:trigger>
				</xf:group>
				<xf:group id="" class="gvwbox">
					<w2:gridView autoFit="allColumn" autoFitMinWidth="365" class="gvw" dataList="data:dlt_exam" defaultCellHeight="37"
						id="grd_exam1" rowNumVisible="true" rowNumWidth="34" style="height:100px;" visibleRowNum="4" visibleRowNumFix="true">
						<w2:caption id="caption1" style="" value="this is a grid caption."></w2:caption>
						<w2:header id="header1" style="">
							<w2:row id="row1" style="">
								<w2:column displayMode="label" id="column4" inputType="text" value="Category" width="90"></w2:column>
								<w2:column displayMode="label" id="column3" inputType="text" value="Product" width="140"></w2:column>
								<w2:column displayMode="label" id="column2" inputType="text" value="Stock" width="70"></w2:column>
							</w2:row>
						</w2:header>
						<w2:gBody id="gBody1" style="">
							<w2:row id="row2" style="">
								<w2:column displayMode="label" id="category_code" inputType="select" viewType="icon" width="90">
									<w2:choices>
										<w2:itemset nodeset="data:dlt_code">
											<w2:label ref="label"></w2:label>
											<w2:value ref="code"></w2:value>
										</w2:itemset>
									</w2:choices>
								</w2:column>
								<w2:column displayMode="label" id="product" inputType="text" textAlign="left" width="140"></w2:column>
								<w2:column dataType="number" displayFormat="#,###" displayMode="label" id="stock" inputType="text" textAlign="right"
									width="70">
								</w2:column>
							</w2:row>
						</w2:gBody>
					</w2:gridView>
				</xf:group>
			</xf:group>
		</xf:group>
	</body>
</html>