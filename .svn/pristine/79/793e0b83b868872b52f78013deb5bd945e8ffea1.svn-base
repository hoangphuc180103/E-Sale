define({declaration:{A:{version:'1.0',encoding:'UTF-8'}},E:[{T:1,N:'html',A:{xmlns:'http://www.w3.org/1999/xhtml','xmlns:ev':'http://www.w3.org/2001/xml-events','xmlns:w2':'http://www.inswave.com/websquare','xmlns:xf':'http://www.w3.org/2002/xforms'},E:[{T:1,N:'head',E:[{T:1,N:'w2:type',E:[{T:3,text:'DEFAULT'}]},{T:1,N:'w2:buildDate'},{T:1,N:'xf:model',E:[{T:1,N:'w2:dataCollection',A:{baseNode:'map'}},{T:1,N:'w2:workflowCollection'}]},{T:1,N:'script',A:{type:'text/javascript',lazy:'false'},E:[{T:4,cdata:function(scopeObj){with(scopeObj){scwin.onpageload = function () {};
scwin.onpageunload = function () {};
scwin.trigger1_onclick = function (e) {
  var option = {
    "id": "dataList1",
    "type": "dataList",
    "option": {
      "baseNode": "list",
      "repeatNode": "map"
    },
    "columnInfo": [{
      "id": "JSON_Code",
      "name": "JSON_Code",
      "dataType": "text"
    }, {
      "id": "JSON_CodeName",
      "name": "JSON_CodeName",
      "dataType": "text"
    }]
  };
  $p.data.create(option);
};
scwin.trigger2_onclick = function (e) {
  var arr1 = [];
  for (var i = 0; i < 5; i++) {
    for (var j = 0; j < 4; j++) {
      arr1[i * 4 + j] = "JSON_" + i + j;
    }
  }
  dataList1.setData(arr1);
};
scwin.trigger3_onclick = function (e) {
  var dcStr = '<w2:dataList id="dataList2" baseNode="list" repeatNode="map" valueNode=""> ' + '<w2:columnInfo>' + '<w2:column id="XML_OrderID" name="XML_Client ID" dataType="text"></w2:column>' + '<w2:column id="XML_CustomerID" name="XML_Client Name" dataType="text"></w2:column>' + '<w2:column id="XML_EmployeeID" name="XML_Employee" dataType="text"></w2:column>' + '<w2:column id="XML_OrderDate" name="XML_Date" dataType="text"></w2:column>' + '</w2:columnInfo>' + '</w2:dataList>';
  $p.data.create(dcStr);
};
scwin.trigger4_onclick = function (e) {
  var arr3 = [];
  for (var i = 0; i < 10; i++) {
    for (var j = 0; j < 4; j++) {
      arr3[i * 4 + j] = "XML_" + i + j;
    }
  }
  dataList2.setData(arr3);
};
scwin.trigger5_onclick = function (e) {
  var scId = "";
  var options = {
    common: {
      fileName: "dataList.xlsx",
      multipleSheet: "true",
      showProcess: false
    },
    excelInfo: [{
      dataListId: "dataList1",
      sheetName: "JSON",
      removeColumns: "",
      wframeId: scId
    }, {
      dataListId: "dataList2",
      sheetName: "XML",
      removeColumns: "",
      wframeId: scId
    }]
  };
  WebSquare.util.multipleDataListDownload(options);
};
}}}]}]},{T:1,N:'body',A:{'ev:onpageload':'scwin.onpageload','ev:onpageunload':'scwin.onpageunload'},E:[{T:1,N:'xf:group',A:{id:'',style:'margin: 10px;'},E:[{T:1,N:'w2:textbox',A:{tagname:'h1',style:'color: blue;margin-bottom: 10px;',id:'textbox1',label:'Dynamic DataList Creation and Download to Excel<br/>',escape:'false'}},{T:1,N:'w2:textbox',A:{tagname:'h2',style:'height: 23px;margin-bottom: 10px;color: blue;',id:'textbox2',label:'How to Use'}},{T:1,N:'w2:textbox',A:{style:'color: blue;margin-bottom: 30px;',id:'textbox3',label:'(Press Ctrl + right-click to display the debug menu, then select the dataCollection view menu to confirm there is no DataList defined on the current screen.)<br/>1. Click button (1) to create dataList1. (After creation, verify DataList creation via the debug menu.)<br/>2. Click button (2) to set data for dataList1. (After setting, verify data configuration via the debugging menu.)<br/>3. Click button (3) to create dataList2. (After creation, verify dataList2 creation via the debugging menu.)<br/>4. Click button (4) to set data for dataList2. &nbsp;(After setting, verify the data configuration via the debugging menu.)<br/>5. Click button (5) to download dataList1 and dataList2 as an Excel file.<br/>6. Open the downloaded Excel file.<br/>7. Verify that the data from dataList1 and dataList2 has been downloaded to the Excel file.<br/>(See the Script tab for the detailed script.)<br/>',escape:'false'}},{T:1,N:'xf:trigger',A:{'ev:onclick':'scwin.trigger1_onclick',style:'display: block;height:42px;line-height:32px;padding:5px;background-color:coral;font-size:15px;weight: bolder;font-weight:bolder;margin-bottom:10px;text-align: left;',id:'trigger1',type:'button'},E:[{T:1,N:'xf:label',E:[{T:4,cdata:'(1) $p.data.create(); / "dataList"'}]}]},{T:1,N:'xf:trigger',A:{'ev:onclick':'scwin.trigger2_onclick',style:'display: block;height:42px;line-height:32px;padding:5px;background-color:coral;font-size:15px;weight: bolder;font-weight:bolder;margin-bottom:10px;text-align: left;',id:'trigger2',type:'button'},E:[{T:1,N:'xf:label',E:[{T:4,cdata:'(2) dataList1.setData();'}]}]},{T:1,N:'xf:trigger',A:{'ev:onclick':'scwin.trigger3_onclick',style:'display: block;height:42px;line-height:32px;padding:5px;background-color:coral;font-size:15px;weight: bolder;font-weight:bolder;margin-bottom:10px;text-align: left;',id:'trigger3',type:'button'},E:[{T:1,N:'xf:label',E:[{T:4,cdata:'(3) $p.data.create(); / "dataList2"'}]}]},{T:1,N:'xf:trigger',A:{'ev:onclick':'scwin.trigger4_onclick',style:'display: block;height:42px;line-height:32px;padding:5px;background-color:coral;font-size:15px;weight: bolder;font-weight:bolder;margin-bottom:10px;text-align: left;',id:'trigger4',type:'button'},E:[{T:1,N:'xf:label',E:[{T:4,cdata:'(4) dataList2.setData();'}]}]},{T:1,N:'xf:trigger',A:{'ev:onfocus':'','ev:onclick':'scwin.trigger5_onclick',style:'display: block;height:42px;line-height:32px;padding:5px;background-color:coral;font-size:15px;weight: bolder;font-weight:bolder;margin-bottom:10px;text-align: left;',id:'trigger5',type:'button'},E:[{T:1,N:'xf:label',E:[{T:4,cdata:'(5) multipleDataListDownload();'}]}]}]}]}]}]})