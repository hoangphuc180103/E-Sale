/**
 * 화면 초기화
 */
scwin.initPage = function () {
  var strDefaultWidth;

  //예제 테스트를 위해 default width 변경
  if (window.innerWidth < 450) {
    strDefaultWidth = "230px";
  } else {
    strDefaultWidth = "300px";
  }

  //윈도우 생성
  wdc_exam1.createWindow("P00113S01", null, "/page/P00113S01.xml", null, "w_P00113S01", "selectWindow", null, null, null, {
    "defaultWidth": strDefaultWidth
  }, "wframe");
  wdc_exam1.createWindow("P00113S02", null, "/page/P00113S02.xml", null, "w_P00113S02", "selectWindow", null, null, null, {
    "defaultWidth": strDefaultWidth
  }, "wframe");

  //시작 - 예제 테스트를 위한 설정
  wdc_exam1.setArrangeWindows("vertical", ["w_P00113S01", "w_P00113S02"]); //윈도우 분할
  wdc_exam1.setFocus(0); //윈도우 focus
  //종료 - 예제 테스트를 위한 설정
};

/**
 * 버튼 [선택된 윈도우의 인덱스 반환 받기] 클릭 시
 */
scwin.btn_ex1_onclick = function (e) {
  var numIndex;

  //선택된 윈도우의 인덱스 반환 받기
  numIndex = wdc_exam1.getSelectedIndex();
  alert(numIndex);
};
