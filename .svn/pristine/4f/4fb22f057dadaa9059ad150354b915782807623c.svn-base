}}}]}]},{T:1,N:'body',A:{'ev:onpageload':'scwin.onpageload'},E:[{T:1,N:'xf:group',A:{style:'',id:'',class:'ws_example_grp_desc'},E:[{T:1,N:'xf:group',A:{tagname:'details',style:'',id:'',class:''},E:[{T:1,N:'w2:textbox',A:{tagname:'summary',style:'',id:'',label:'실습 목표',escape:'false'}},{T:1,N:'w2:textbox',A:{style:'',id:'',label:'1. 개요<br/>본 화면은 generator 컴포넌트를 활용하여 Table 형태의 반복 기능의 화면을 구성한 예제 입니다.<br/>generator 컴포넌트 : generator 컴포넌트는 특정 컴포넌트를 반복적으로 추가/삭제가 가능한 컴포넌트 입니다. <br/> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;generator 컴포넌트의 하위에 정의된 영역이 반복되며 script를 통해 제어 가능합니다. <br/> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;generator로 생성된 컴포넌트를 제어할 수 있는 함수도 지원하고 있습니다. <br/>',class:'',escape:'false'}}]},{T:1,N:'xf:group',A:{tagname:'details',style:'',id:'',class:''},E:[{T:1,N:'w2:textbox',A:{tagname:'summary',style:'',id:'',label:'실습 방법',escape:'false'}},{T:1,N:'w2:textbox',A:{style:'',id:'',label:'1. Design Kit 를 활용하여 generator 컴포넌트를 추가합니다. <br/>2. generator ID : gen_add 로 생성합니다. <br/>3. 반복하고 싶은 컴포넌트를 구성합니다. <br/>4. \'동적 생성\' 버튼에 onclick 이벤트를 추가하고 스크립트를 작성합니다. &nbsp;<br/> &nbsp; ex) gen_add.insertChild();<br/>5. \'마지막 자식 삭제\' 버튼에 onclick 이벤트를 추가하고 스크립트를 작성합니다. &nbsp;<br/> &nbsp; ex) gen_add.removeChild(numLastIndex-1);<br/>6. \'전체 삭제\' 버튼에 onclick 이벤트를 추가하고 스크립트를 작성합니다. &nbsp;<br/> &nbsp; ex) gen_add.removeAll();',class:'',escape:'false'}}]},{T:1,N:'xf:group',A:{style:'',id:'',class:'example_div_tb_style_wrap mb_def'},E:[{T:1,N:'xf:group',A:{style:'',id:'',class:'example_div_tr_style'}}]}]}]}]}]})