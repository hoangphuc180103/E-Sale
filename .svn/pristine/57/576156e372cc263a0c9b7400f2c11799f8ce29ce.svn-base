// 예제 테스트를 위한 초기화
scwin.initializeExample = function () {
  dlt_exam.setJSON([{
    "chk_1": "0"
  }, {
    "chk_1": "1"
  }, {
    "chk_1": "0"
  }]);
};

/**
 * 버튼 [체크된 행의 인덱스 출력하기] 클릭 시
 * 체크된 행의 인덱스 배열 출력하기
 */
scwin.btn_ex1_onclick = function (e) {
  //GridView grd_exam1의 컬럼 chk_1의 체크된 행의 인덱스를 배열로 반환 받기
  //파라미터는 컬럼의 id와 indexd를 사용할 수 있습니다. 일반적으로 id를 사용합니다.(index는 컬럼이 추가/삭제되면 변경되기 때문입니다.)
  let arrIndex = grd_exam1.getCheckedIndex("chk_1");

  //로그 출력
  let strLog = "체크된 행의 인덱스: ";
  strLog += JSON.stringify(arrIndex);
  $c.frame.printExampleLog($p, strLog, txa_log, false);
  console.log(strLog);
};

/**
 * textarea의 로그 삭제
 */
scwin.btn_clearLog_onclick = function (e) {
  txa_log.setValue("");
};
