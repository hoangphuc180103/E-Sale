  var objSubmission = $p.getSubmission("submission1");
  objSubmission.action = scwin.getfolderPath() + '/data.json';
  $p.executeSubmission("submission1");
};
scwin.onpageunload = function () {};
scwin.dataList1_onbeforecelldatachange = function (info) {
  if (info.colID == "Hobby") {
    if (info.newValue == "Work" || info.newValue == "work") {
      alert("onbeforecelldatachange - Enter another hobby.");
      return false;
    }
  } else {
    alert("Changed.");
    return true;
  }
};
scwin.getfolderPath = function () {
  var currentPath = window.location.href;
  var folderPath;
  if (currentPath.includes("mainContainer")) {
    console.log("true  ===> " + $p.getFrameId());
    const cmtFrame = $p.getComponentById($p.getFrameId());
    currentPath = cmtFrame.getSrc();
    folderPath = currentPath.substring(0, currentPath.lastIndexOf('/'));
  } else {
    console.log("false  ===> ");
    folderPath = currentPath.split('w2xPath=')[1].substring(0, currentPath.split('w2xPath=')[1].lastIndexOf('/'));
  }
  return folderPath;
};
}}}]}]},{T:1,N:'body',A:{'ev:onpageload':'scwin.onpageload','ev:onpageunload':'scwin.onpageunload'},E:[{T:1,N:'xf:group',A:{id:'',style:'margin: 10px;'},E:[{T:1,N:'w2:textbox',A:{tagname:'h1',style:'color: blue;margin-bottom: 10px;',tabIndex:'h1',id:'textbox2',label:'イベント - onbeforecelldatachange',escape:'false'}},{T:1,N:'w2:textbox',A:{tagname:'h2',style:'height: 23px;margin-bottom: 10px;color: blue;',id:'textbox3',label:'サンプルの使い方'}},{T:1,N:'w2:textbox',A:{style:'color: blue;margin-bottom: 30px;',id:'textbox4',label:'1. セル値を変更し、Enterキーを押すか、別のセルをマウスでクリックします。 <br/>2. 確認メッセージが表示され、セル値が変更であることを確認します。 <br/>3. ただし、Hobbyカラムの値を"Work"もしくは"work"で変更できないことを確認。 （onbeforecelldatachange イベントハンドラ関数が false を返すためです。）<br/>',escape:'false'}},{T:1,N:'w2:textbox',A:{style:'padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightgreen;border:none;margin-bottom: 10px;',id:'textbox5',label:'イベント説明<br/>onbeforecelldatachange - セルデータ変更の直前に発生します。',escape:'false'}},{T:1,N:'w2:gridView',A:{scrollByColumnAdaptive:'false',rowNumVisible:'true',visibleRowNumFix:'true',checkAllType:'false',dataList:'data:dataList1',style:'border: solid 1px gray',scrollByColumn:'false',id:'gridView1',visibleRowNum:'10',autoFit:'allColumn',defaultCellHeight:'20'},E:[{T:1,N:'w2:header',A:{style:'',id:'header1'},E:[{T:1,N:'w2:row',A:{style:'',id:'row1'},E:[{T:1,N:'w2:column',A:{width:'70',inputType:'text',style:'height:20px',id:'column9',value:'ID',displayMode:'label'}},{T:1,N:'w2:column',A:{width:'70',inputType:'text',style:'height:20px',id:'column8',value:'Age',displayMode:'label'}},{T:1,N:'w2:column',A:{width:'70',inputType:'text',style:'height:20px',id:'column7',value:'Region',displayMode:'label'}},{T:1,N:'w2:column',A:{width:'70',inputType:'text',style:'height:20px',id:'column6',value:'Hobby',displayMode:'label'}},{T:1,N:'w2:column',A:{width:'70',inputType:'text',style:'height:20px',id:'column3',value:'Frequency',displayMode:'label'}},{T:1,N:'w2:column',A:{width:'70',inputType:'text',s