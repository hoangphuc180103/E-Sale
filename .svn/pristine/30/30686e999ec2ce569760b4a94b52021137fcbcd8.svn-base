scwin.ui_textbox1_onclick = function (e) {
  var _url = "";
  var _path = "";
  _path = this.getUserData("userData1");
  _url = $c.frame.getBasePageURL($p, true) + "#w2xPath=" + _path;
  window.open(_url, "_blank");
};
//Tab 추가 
scwin.btn_tab_onclick = async function (e) {
  var indTab = tab1.getTabCount();
  var addTabTt = "tab_" + indTab;
  var newTabId = await tab1.addTab(addTabTt, {
    "label": addTabTt,
    "title": "dataObject",
    "openAction": "exist",
    "closable": "true"
  }, {
    "src": "/edu/adv/tabindex_1.xml",
    "frameMode": "wframePreload",
    "scope": true,
    "alwaysDraw": "true"
  });
  await tab1.setSelectedTabIndex(addTabTt);
  tab1.getWindow(indTab).ui_inp1.setValue(addTabTt + "_Value1");
};

//Tab 삭제
//
scwin.btn_tabdelete_onclick = function (e) {
  tab1.deleteTab(tab1.getSelectedTabIndex());
};
scwin.btn_setData_onclick = function (e) {
  ui_ipt1.setValue("parent_Value1");
  ui_ipt2.setValue("parent_Value2");
};

//값 보내기 
scwin.btn_setTab_onclick = function (e) {
  tab1.getWindow(tab1.getSelectedTabIndex()).ui_ipt1.setValue(ui_ipt1.getValue());
  tab1.getWindow(tab1.getSelectedTabIndex()).ui_ipt2.setValue(ui_ipt2.getValue());
};

//값 가져오기 

scwin.btn_tabget_onclick = function (e) {
  ui_ipt1.setValue(tab1.getWindow(tab1.getSelectedTabIndex()).ui_ipt1.getValue());
  ui_ipt2.setValue(tab1.getWindow(tab1.getSelectedTabIndex()).ui_ipt2.getValue());
};

//Tab2의 값 가져오기
//alwaysDraw : false (기본 값)
scwin.btn_gettab2Va_onclick = function (e) {
  var tabValue = ui_tab2_ipt1.getValue();
  alert(tabValue);
};

//Tab3의 값 가져오기 
//alwaysDraw : true
scwin.btn_gettab3Va_onclick = function (e) {
  var tabValue = ui_tab3_ipt1.getValue();
  alert(tabValue);
};
