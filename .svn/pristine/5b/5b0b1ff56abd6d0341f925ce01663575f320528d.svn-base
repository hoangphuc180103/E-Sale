define({declaration:{A:{version:'1.0',encoding:'UTF-8'}},E:[{T:1,N:'html',A:{xmlns:'http://www.w3.org/1999/xhtml','xmlns:ev':'http://www.w3.org/2001/xml-events','xmlns:w2':'http://www.inswave.com/websquare','xmlns:xf':'http://www.w3.org/2002/xforms'},E:[{T:1,N:'head',A:{},E:[{T:1,N:'w2:historyInfo',E:[{T:1,N:'w2:history',A:{}},{T:1,N:'w2:history',A:{}}]},{T:1,N:'w2:type',E:[{T:3,text:'COMPONENT'}]},{T:1,N:'w2:buildDate'},{T:1,N:'w2:MSA'},{T:1,N:'xf:model',E:[{T:1,N:'w2:dataCollection',A:{baseNode:'map'}},{T:1,N:'w2:workflowCollection'}]},{T:1,N:'w2:layoutInfo'},{T:1,N:'w2:publicInfo'},{T:1,N:'script',A:{lazy:'false',type:'text/javascript'},E:[{T:4,cdata:function(scopeObj){with(scopeObj){scwin.onpageload = function () {
  // WidgetContainer 'wgc_exam1'에 위젯 1개를 추가합니다.
  wgc_exam1.addWidgets({
    id: "wg_exam1",
    src: "/page/P00320S01.xml",
    scope: true,
    unitWidth: 1,
    unitHeight: 5,
    title: "className 미지정",
    x: 0,
    y: 0
  });
};

/**
 * 버튼 [위젯 추가하기 - 옵션 'className'을 'P00320_wg2'로 지정] 클릭 시
 */
scwin.btn_exam1_1_onclick = function (e) {
  // 위젯 'wg_exam2' 생성 옵션 정보
  let widgetOptions = {};

  // [필수] 위젯의 CSS class를 'P00320_wg2'로 지정 - 정의한 class는 '[프로젝트]/css/example.css'에서 확인할 수 있습니다.
  widgetOptions.className = "P00320_wg2";

  // [필수] 위젯 ID. 동일한 ID를 가진 위젯이 있으면 추가되지 않습니다.
  widgetOptions.id = "wg_exam2";

  // [필수] 위젯 파일 경로 
  widgetOptions.src = "/page/P00320S02.xml";

  // [필수] scope 적용 여부로 true 고정
  widgetOptions.scope = true;

  // [필수] 위젯 너비 : (설정 값 / WidgetContainer의 'col' 속성의 설정 값 * 100)으로 '%'단위로 그려집니다.
  widgetOptions.unitWidth = 1;

  // [필수] 위젯 높이 : (설정 값 * WidgetContainer의 'unitHeightPixel' 속성의 설정 값)으로 'px'단위로 그려집니다.
  widgetOptions.unitHeight = 5;

  // [권장] 위젯 타이틀
  widgetOptions.title = "className 지정";

  // 위젯의 x 위치
  widgetOptions.x = 0;

  // 위젯의 y 위치
  widgetOptions.y = 6;

  // WidgetContainer 'wgc_exam1'에 위젯 1개를 추가합니다.
  wgc_exam1.addWidgets(widgetOptions);
};
}}}]}]},{T:1,N:'body',A:{'ev:onpageload':'scwin.onpageload'},E:[{T:1,N:'xf:group',A:{class:'sub_contents'},E:[{T:1,N:'xf:group',A:{class:'ws_example_grp_desc'},E:[{T:1,N:'w2:textbox',A:{escape:'false',label:'WidgetContainer의 \'addWidgets\' 메소드를 사용하여 위젯을 추가할 때, 위젯에 CSS 클래스를 설정하는 예제입니다.',style:''}}]},{T:1,N:'xf:group',A:{class:'example_div_tb_style_wrap'},E:[{T:1,N:'xf:group',A:{class:'example_div_tr_style'},E:[{T:1,N:'xf:group',A:{class:'example_div_td_style'},E:[{T:1,N:'xf:group',A:{class:'mb_def_box nobottom'},E:[{T:1,N:'xf:trigger',A:{class:'btn_exam_exec btn_txt_of','ev:onclick':'scwin.btn_exam1_1_onclick',id:'btn_exam1_1',type:'button'},E:[{T:1,N:'xf:label',E:[{T:4,cdata:'위젯 추가하기 - 옵션 \'className\'을 \'P00320_wg2\'로 설정'}]}]}]},{T:1,N:'xf:group',A:{class:'mb_def_box nobottom',style:''},E:[{T:1,N:'w2:widgetContainer',A:{verticalMargin:'0',threshold:'null',params:'false',mode:'pushpull',style:'height: 200px;',id:'wgc_exam1',cols:'1',unitHeightPixel:'20',class:'wre_comm',horizontalMargin:'8'}}]}]}]}]}]}]}]}]})