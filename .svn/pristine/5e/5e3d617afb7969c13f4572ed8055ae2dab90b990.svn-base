<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            	<w2:dataList baseNode="list" id="dataList1" repeatNode="map" saveRemovedData="true" style="">
            		<w2:columnInfo>
            			<w2:column dataType="text" id="col1" name="name1"></w2:column>
            			<w2:column dataType="text" id="col2" name="name2"></w2:column>
            			<w2:column dataType="text" id="col3" name="name3"></w2:column>
            			<w2:column dataType="text" id="col4" name="name4"></w2:column>
            			<w2:column dataType="text" id="col5" name="name5"></w2:column>
            		</w2:columnInfo>
            	</w2:dataList>
            	<w2:dataList baseNode="list" id="dataList2" repeatNode="map" saveRemovedData="true" style="">
            		<w2:columnInfo>
            			<w2:column dataType="text" id="col1" name="name1"></w2:column>
            			<w2:column dataType="text" id="col2" name="name2"></w2:column>
            			<w2:column dataType="text" id="col3" name="name3"></w2:column>
            			<w2:column dataType="text" id="col4" name="name4"></w2:column>
            			<w2:column dataType="text" id="col5" name="name5"></w2:column>
            		</w2:columnInfo>
            	</w2:dataList>
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
         <script type="text/javascript" lazy="false"><![CDATA[

scwin.onpageload = function () {
    for (var i = 0; i < 5; i++) {
        dataList1.insertRow();
        dataList2.insertRow();
    }
};

scwin.onpageunload = function () {

};	]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload" ev:onpageunload="scwin.onpageunload">
    <xf:group id="" style="margin: 10px;">
    	<w2:textbox tagname="h1" style="color: blue;margin-bottom: 10px;" tabIndex="h1" id="textbox1" label="Shiftキーで複数のチェックボックスを選択" escape="false"></w2:textbox>
    	<w2:textbox tagname="h2" style="height: 23px;margin-bottom: 10px;color: blue;" id="textbox2" label="サンプルの使い方"></w2:textbox>
    	<w2:textbox style="color: blue;margin-bottom: 30px;" id="textbox3"
    		label='（初めて目 GridViewのケース, useShiftKeyCheck="true"）&lt;br/&gt;ハン行のチェックボックス選択後 Shift キー押すままその他行のチェックボックス選択すると間にあるすべて行チェックボックス選択済み。 &lt;br/&gt;&lt;br/&gt;（二つ目 GridViewのケース, useShiftKeyCheck="false"）&lt;br/&gt;ハン行のチェックボックス選択後 Shift キー押すままその他行のチェックボックス選択すると, 二つ犬チェックボックスのみ選択済み。'
    		escape="false">
    	</w2:textbox>
    	<w2:textbox
    		style="padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightblue;border:none;margin-bottom: 10px;"
    		id="textbox4" label='プロパティの設定&lt;br/&gt;useShiftKey="true"&lt;br/&gt;useShiftKeyCheck="true"' escape="false">
    	</w2:textbox>
    	<w2:gridView scrollByColumnAdaptive="false" syncScroll="false" rowNumVisible="true" showSortableImage="true" summaryAuto="false"
    		useShiftKey="true" scrollByColumn="false" summaryOnlyAuto="false" defaultCellHeight="20" applyAllColumnStyle="false"
    		checkAllType="include" checkOnCellClick="true" dataList="data:dataList1" dataDragSelect="true" useShiftKeyCheck="true"
    		ignoreCellClick="false" style="border: solid gray 1px;margin-bottom: 10px;" id="gridView1" visibleRowNum="5" useFilterList="true"
    		ignoreToggleOnDisabled="false" visibleRowNumFix="true" autoFit="allColumn">
    		<w2:caption style="" id="caption1" value="this is a grid caption."></w2:caption>
    		<w2:header style="" id="header1">
    			<w2:row style="" id="row1">
    				<w2:column excelLabel="선택" width="70" inputType="checkbox" style="" id="column1" value="name1" blockSelect="false"
    					displayMode="label">
    				</w2:column>
    				<w2:column width="70" inputType="text" style="" id="column2" value="A" blockSelect="false" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="" id="column3" value="B" blockSelect="false" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="" id="column4" value="C" blockSelect="false" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="" id="column5" value="D" blockSelect="false" displayMode="label"></w2:column>
    			</w2:row>
    		</w2:header>
    		<w2:gBody style="" id="gBody1">
    			<w2:row style="" id="row2">
    				<w2:column partialCheckNextClick="check" trueValue="Y" checkboxLabel="" blockSelect="false" displayMode="label"
    					falseValue="N" valueType="other" width="70" inputType="checkbox" style="" id="col1" checkAlways="false" value="">
    				</w2:column>
    				<w2:column width="70" inputType="" style="" id="col2" value="" blockSelect="false" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="" id="col3" value="" blockSelect="false" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="" id="col4" value="" blockSelect="false" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="" id="col5" value="" blockSelect="false" displayMode="label"></w2:column>
    			</w2:row>
    		</w2:gBody>
    	</w2:gridView>
    	<w2:textbox escape="false" id="textbox5" label='プロパティの設定&lt;br/&gt;useShiftKey="true"&lt;br/&gt;useShiftKeyCheck="false"'
    		style="padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightblue;border:none;margin-bottom: 10px;">
    	</w2:textbox>
    	<w2:gridView applyAllColumnStyle="false" checkAllType="include" checkOnCellClick="true" dataDragSelect="true"
    		dataList="data:dataList2" defaultCellHeight="20" id="gridView2" ignoreCellClick="false" ignoreToggleOnDisabled="false"
    		rowNumVisible="true" scrollByColumn="false" scrollByColumnAdaptive="false" showSortableImage="true" style="border: solid gray 1px;"
    		summaryAuto="false" summaryOnlyAuto="false" syncScroll="false" useFilterList="true" useShiftKey="true" useShiftKeyCheck="false"
    		visibleRowNum="5" visibleRowNumFix="true" autoFit="allColumn">
    		<w2:caption style="" id="caption1" value="this is a grid caption."></w2:caption>
    		<w2:header style="" id="header1">
    			<w2:row style="" id="row1">
    				<w2:column width="70" inputType="checkbox" style="" id="column5" value="name1" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="" id="column4" value="name2" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="" id="column3" value="name3" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="" id="column2" value="name4" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="" id="column1" value="name5" displayMode="label"></w2:column>
    			</w2:row>
    		</w2:header>
    		<w2:gBody style="" id="gBody1">
    			<w2:row style="" id="row2">
    				<w2:column width="70" inputType="checkbox" style="" id="col1" value="" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="" id="col2" value="" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="" id="col3" value="" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="" id="col4" value="" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="" id="col5" value="" displayMode="label"></w2:column>
    			</w2:row>
    		</w2:gBody>
    	</w2:gridView>
    </xf:group></body>
</html>
