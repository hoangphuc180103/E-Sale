:'data:json,dataList2',action:'data.json',method:'post',mediatype:'application/json',encoding:'UTF-8',instance:'',replace:'',errorHandler:'',customHandler:'',mode:'asynchronous',processMsg:'','ev:submit':'','ev:submitdone':'','ev:submiterror':'',abortTrigger:''}}]},{T:1,N:'script',A:{type:'text/javascript',lazy:'false'},E:[{T:4,cdata:function(scopeObj){with(scopeObj){scwin.onpageload = function () {};
scwin.onpageunload = function () {};
scwin.trigger1_onclick = function (e) {
  var subObj = $p.getSubmission("submission1");
  var header = subObj.requestHeader;
  var real = JSON.stringify(header);
  alert("requestHeader : " + real);
};
scwin.trigger2_onclick = function (e) {
  var subObj = $p.getSubmission("submission1");
  subObj.setRequestHeader({
    "userKey": "1_userValue"
  });
};
scwin.trigger3_onclick = function (e) {
  var objSubmission1 = $p.getSubmission("submission1");
  objSubmission1.action = scwin.getfolderPath() + '/citycode.json';
  $p.executeSubmission("submission1");
};
scwin.trigger4_onclick = function (e) {
  var subObj = $p.getSubmission("submission2");
  var header = subObj.requestHeader;
  var real = JSON.stringify(header);
  alert("requestHeader : " + real);
};
scwin.trigger5_onclick = function (e) {
  var subObj = $p.getSubmission("submission2");
  subObj.setRequestHeader({
    "userKey": "2_userValue"
  });
};
scwin.trigger6_onclick = function (e) {
  var objSubmission = $p.getSubmission("submission2");
  objSubmission.action = scwin.getfolderPath() + '/data.json';
  $p.executeSubmission("submission2");
};
scwin.getfolderPath = function () {
  var currentPath = window.location.href;
  var folderPath;
  if (currentPath.includes("mainContainer")) {
    console.log("true  ===> " + $p.getFrameId());
    const cmtFrame = $p.getComponentById($p.getFrameId());
    currentPath = cmtFrame.getSrc();
    folderPath = currentPath.substring(0, currentPath.lastIndexOf('/'));
  } else {
    console.log("false  ===> ");
    folderPath = currentPath.split('w2xPath=')[1].substring(0, currentPath.split('w2xPath=')[1].lastIndexOf('/'));
  }
  return folderPath;
};
}}}]}]},{T:1,N:'body',A:{'ev:onpageload':'scwin.onpageload','ev:onpageunload':'scwin.onpageunload'},E:[{T:1,N:'xf:group',A:{id:'',style:'margin: 10px;'},E:[{T:1,N:'w2:textbox',A:{tagname:'h1',style:'color: blue;margin-bottom: 10px;',id:'textbox1',label:'Submission ヘッダーの設定',escape:'false'}},{T:1,N:'w2:textbox',A:{tagname:'h2',style:'height: 23px;margin-bottom: 10px;color: blue;',id:'textbox2',label:'サンプルの使い方'}},{T:1,N:'w2:textbox',A:{style:'color: blue;margin-bottom: 30px;',id:'textbox3',label:'（最初の GridView） <br/>1.最初のボタンをクリックして、&nbsp;現在のSubmissionのヘッダー値が空であることを確認します。 <br/>2. 2番目のボタンをクリックしてSubmissionのヘッダーを設定します。 &nbsp;<br/>3. 3番目のボタンをクリックしてSubmissionを実行し、GridViewにデータが表示されることを確認します。<br/>4.最初のボタンをもう一度クリックします。 <br/>5. SubmissionにrequestHeaderが設定されていることを確認してください。 <br/><br/>（2番目のGridView）<br/>上記と同じ方法でSubmissionヘッダー設定を確認します。<br/><br/>',escape:'false'}},{T:1,N:'xf:trigger',A:{'ev:onclick':'scwin.trigger1_onclick',style:'height:42px;line-height:32px;padding:5px;background-color:coral;font-size:15px;weight: bolder;font-weight:bolder;margin-bottom:10px;text-align: left;',id:'trigger1',type:'button'},E:[{T:1,N:'xf:label',E:[{T:4,cdata:'subObj.requestHeader'}]}]},{T:1,N:'xf:trigger',A:{type:'button',id:'trigger2',style:'height:42px;line-height:32px;padding:5px;background-color:coral;font-size:15px;weight: bolder;font-weight:bolder;margin-bottom:10px;text-align: left;margin-left: 30px;','ev:onclick':'scwin.trigger2_onclick'},E:[{T:1,N:'xf:label',E:[{T:4,cdata:'subObj.setRequestHeader({"userKey": "1_userValue"});'}]}]},{T:1,N:'xf:trigger',A:{type:'button',id:'trigger3',style:'height:42px;line-height:32px;padding:5px;background-color:coral;font-size:15px;weight: bolder;font-weight:bolder;margin-bottom:10px;text-align: left;margin-left: 30px;','ev:onclick':'scwin.trigger3_onclick'},E:[{T:1,N:'xf:label',E:[{T:4,cdata:' $p.executeSubmission("submission1");'}]}]},{T:1,N:'w2:gridView',A:{scrollByColumnAdaptive:'false',checkAllType:'false',dataList:'data:dataList1',style:'border: solid 