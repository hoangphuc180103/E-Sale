    <body ev:onpageload="scwin.onpageload" ev:onpageunload="scwin.onpageunload">
    <xf:group id="" style="margin: 10px;">
    	<w2:textbox tagname="h1" style="color: blue;margin-bottom: 10px;" tabIndex="h1" id="textbox1" label="カレンダーでの年と月の選択方法の設定" escape="false"></w2:textbox>
    	<w2:textbox tagname="h2" style="height: 23px;margin-bottom: 10px;color: blue;" id="textbox2" label="サンプルの使い方"></w2:textbox>
    	<w2:textbox style="color: blue;margin-bottom: 30px;" id="textbox3"
    		label='（初めて目 GridViw）&lt;br/&gt;1-1. Date 列からカレンダーアイコンクリック。 &lt;br/&gt;1-2. カレンダー上の年と月部分クリック。 &lt;br/&gt;1-3. 上部に年表示され、 下部に月表示されるもの確認。 &lt;br/&gt;1-4. 上の年部分クリック。 &lt;br/&gt;1-5. 下部に表示月消える年表示されるもの確認。 (fixPickerStatus="default")&lt;br/&gt;&lt;br/&gt;（二つ目 GridViw）&lt;br/&gt;2-1. Date 列からカレンダーアイコンクリック。 &lt;br/&gt;2-2. カレンダー上の年と月部分クリック。 &lt;br/&gt;2-3. 上部に年表示され、 下部に月表示されるもの確認。 &lt;br/&gt;2-4. 上の年部分クリック。 &lt;br/&gt;2-5. 何も変更なし続く月表示まま維持されるもの確認。 (fixPickerStatus="month")&lt;br/&gt;'
    		escape="false">
    	</w2:textbox>
    	<w2:textbox
    		style="padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightblue;border:none;margin-bottom: 10px;"
    		id="textbox4" label='プロパティ設定（Date列）&lt;br/&gt; inputType="calendar" &lt;br/&gt;pickerType="dynamic"&lt;br/&gt;fixPickerStatus="default"'
    		escape="false">
    	</w2:textbox>
    	<w2:gridView scrollByColumnAdaptive="false" contextMenu="true" rowNumVisible="true" dataList="data:dataList1"
    		style="border: solid gray 1px;margin-bottom: 10px;" scrollByColumn="false" id="gridView1" autoFit="allColumn"
    		ev:oncelldblclick="scwin.gridView1_oncelldblclick" defaultCellHeight="30" autoFitMinWidth="0" visibleRowNum="5"
    		visibleRowNumFix="true">
    		<w2:caption style="" id="caption1" value="this is a grid caption."></w2:caption>
    		<w2:header style="" id="header1">
    			<w2:row style="" id="row1">
    				<w2:column removeBorderStyle="false" width="70" inputType="text" style="height:20px" id="column8" value="Date"
    					blockSelect="false" displayMode="label">
    				</w2:column>
    				<w2:column removeBorderStyle="false" width="70" inputType="text" style="height:20px" id="column2" value="ID"
    					blockSelect="false" displayMode="label">
    				</w2:column>
    				<w2:column removeBorderStyle="false" width="70" inputType="text" style="height:20px" id="column1" value="Age"
    					blockSelect="false" displayMode="label">
    				</w2:column>
    			</w2:row>
    		</w2:header>
    		<w2:gBody style="" id="gBody1">
    			<w2:row style="" id="row2">
    				<w2:column pickerType="dynamic" removeBorderStyle="false" dataType="date" blockSelect="false" displayMode="label"
    					width="70" viewType="icon" inputType="calendar"
    					style="height:20px;color:;font-weight:;font-size:20px;border-color:#FF0000;border:solid;background-color:;outline-color:;"
    					id="Date" value="" monthNames="Jan , Feb , Mar , Apr , May , Jun , Jul , Aug , Sep , Oct , Nov , Dec " yearSuffix="Y"
    					fixPickerStatus="default">
    				</w2:column>
    				<w2:column removeBorderStyle="false" width="70" inputType="text" style="height:20px" id="ID" value=""
    					blockSelect="false" displayMode="label">
    				</w2:column>
    				<w2:column removeBorderStyle="false" width="70" inputType="text" style="height:20px" id="Age" value=""
    					blockSelect="false" displayMode="label">
    				</w2:column>
    			</w2:row>
    		</w2:gBody>
    	</w2:gridView>
    	<w2:textbox escape="false" id="textbox5"
    		label='プロパティ設定（Date列）&lt;br/&gt; inputType="calendar" &lt;br/&gt;pickerType="dynamic"&lt;br/&gt;fixPickerStatus="month"'
    		style="padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightblue;border:none;margin-bottom: 10px;">
    	</w2:textbox>
    	<w2:gridView autoFit="allColumn" autoFitMinWidth="0" contextMenu="true" dataList="data:dataList1" defaultCellHeight="30"
    		ev:oncelldblclick="scwin.gridView1_oncelldblclick" id="gridView2" rowNumVisible="true" scrollByColumn="false"
    		scrollByColumnAdaptive="false" style="border: solid gray 1px;" visibleRowNum="5" visibleRowNumFix="true">
    		<w2:caption id="caption2" style="" value="this is a grid caption."></w2:caption>
    		<w2:header id="header1" style="">
    			<w2:row id="row1" style="">
    				<w2:column blockSelect="false" displayMode="label" id="column8" inputType="text" removeBorderStyle="false"
    					style="height:20px" value="Date" width="70">
    				</w2:column>
    				<w2:column blockSelect="false" displayMode="label" id="column2" inputType="text" removeBorderStyle="false"
    					style="height:20px" value="ID" width="70">
    				</w2:column>
    				<w2:column blockSelect="false" displayMode="label" id="column1" inputType="text" removeBorderStyle="false"
    					style="height:20px" value="Age" width="70">
    				</w2:column>
    			</w2:row>
    		</w2:header>
    		<w2:gBody id="gBody1" style="">
    			<w2:row id="row2" style="">
    				<w2:column blockSelect="false" dataType="date" displayMode="label" fixPickerStatus="month" id="Date"
    					inputType="calendar" monthNames="Jan , Feb , Mar , Apr , May , Jun , Jul , Aug , Sep , Oct , Nov , Dec " pickerType="dynamic"
    					removeBorderStyle="false"
    					style="height:20px;color:;font-weight:;font-size:20px;border-color:#FF0000;border:solid;background-color:;outline-color:;" value=""
    					viewType="icon" width="70" yearSuffix="Y">
    				</w2:column>
    				<w2:column blockSelect="false" displayMode="label" id="ID" inputType="text" removeBorderStyle="false"
    					style="height:20px" value="" width="70">
    				</w2:column>
    				<w2:column blockSelect="false" displayMode="label" id="Age" inputType="text" removeBorderStyle="false"
    					style="height:20px" value="" width="70">
    				</w2:column>
    			</w2:row>
    		</w2:gBody>
    	</w2:gridView>
    </xf:group></body>
