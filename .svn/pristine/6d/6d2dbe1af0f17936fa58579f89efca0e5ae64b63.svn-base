    // "iframePopup", "browserPopup"
    width: "400px",
    height: "200px",
    top: "100px",
    left: "200px",
    popupName: "parent",
    modal: "true",
    frameModal: "parent" // "frame" "parent" "top"  framdId
  };
  $p.openPopup("", options);
};
