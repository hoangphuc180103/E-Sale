scwin.onpageload = function () {
  requires("uiplugin.popup");
  var parentFrameId = $p.getFrame().getParentFrame().getParentFrame().id;
  radio1.addItem(parentFrameId, parentFrameId, 3);
};
scwin.onpageunload = function () {};
scwin.trigger1_onclick = function (e) {
  var frameId = radio1.getValue();
  var options = {
    id: "top",
    type: "wframePopup",
    // "iframePopup", "browserPopup"
    width: "400px",
    height: "200px",
    top: "100px",
    left: "200px",
    popupName: frameId,
    modal: "true",
    frameModal: frameId
  };
  $p.openPopup("", options);
};
scwin.trigger2_onclick = function (e) {
  var options = {
    id: "parent",
