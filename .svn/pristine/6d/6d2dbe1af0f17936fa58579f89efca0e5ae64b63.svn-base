};
scwin.getfolderPath = function () {
  var currentPath = window.location.href;
  var folderPath;
  if (currentPath.includes("mainContainer")) {
    console.log("true  ===> " + $p.getFrameId());
    const cmtFrame = $p.getComponentById($p.getFrameId());
    currentPath = cmtFrame.getSrc();
    folderPath = currentPath.substring(0, currentPath.lastIndexOf('/'));
  } else {
    console.log("false  ===> ");
    folderPath = currentPath.split('w2xPath=')[1].substring(0, currentPath.split('w2xPath=')[1].lastIndexOf('/'));
  }
  return folderPath;
};
}}}]}]},{T:1,N:'body',A:{'ev:onpageload':'scwin.onpageload','ev:onpageunload':'scwin.onpageunload'},E:[{T:1,N:'w2:textbox',A:{style:'margin-bottom:10px;font-size:20px;font-weight:bolder;font-style:italic;text-align:left;margin: 10px;',id:'textbox1',label:'13_popUp_02A.xml'}},{T:1,N:'xf:group',A:{id:'',style:'margin-left: 20px;padding: 10px;'},E:[{T:1,N:'xf:select1',A:{ref:'',appearance:'full',style:'margin-bottom: 10px;',id:'radio1',rows:'',cols:'1',selectedIndex:'-1'},E:[{T:1,N:'xf:choices',E:[{T:1,N:'xf:item',E:[{T:1,N:'xf:label',E:[{T:4,cdata:'frame'}]},{T:1,N:'xf:value',E:[{T:4,cdata:'frame'}]}]},{T:1,N:'xf:item',E:[{T:1,N:'xf:label',E:[{T:4,cdata:'parent'}]},{T:1,N:'xf:value',E:[{T:4,cdata:'parent'}]}]},{T:1,N:'xf:item',E:[{T:1,N:'xf:label',E:[{T:4,cdata:'top'}]},{T:1,N:'xf:value',E:[{T:4,cdata:'top'}]}]}]}]},{T:1,N:'xf:trigger',A:{'ev:onclick':'scwin.trigger1_onclick',style:'height:42px;line-height:32px;padding:5px;background-color:coral;font-size:15px;weight: bolder;font-weight:bolder;text-align: left;display: block;margin-top: 0px;',id:'trigger1',type:'button'},E:[{T:1,N:'xf:label',E:[{T:4,cdata:'$p.openPopup(options) - options.frameModal'}]}]}]}]}]}]})