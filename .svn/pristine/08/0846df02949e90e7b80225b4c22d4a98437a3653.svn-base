<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            	<w2:dataMap baseNode="map" id="dataMap1">
            		<w2:keyInfo>
            			<w2:key id="key1" name="name1" dataType="text"></w2:key>
            			<w2:key id="key2" name="name2" dataType="text"></w2:key>
            			<w2:key id="key3" name="name3" dataType="text"></w2:key>
            			<w2:key id="key4" name="name3" dataType="text"></w2:key>
            			<w2:key id="key5" name="name3" dataType="text"></w2:key>
            		</w2:keyInfo>
            	</w2:dataMap>
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
         <script type="text/javascript" lazy="false"><![CDATA[
        
	scwin.onpageload = function() {
		dataMap1.setArray(["202011301130", "2020113011", "20201130", "202010", "2020"]);        
	};
	
	scwin.onpageunload = function() {
		
	};
	
	]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload" ev:onpageunload="scwin.onpageunload">
    <xf:group id="" style="margin: 10px;">
    	<w2:textbox tagname="h1" style="color: blue;margin-bottom: 10px;" tabIndex="h1" id="textbox1" label="日付増加単位の設定" escape="false"></w2:textbox>
    	<w2:textbox tagname="h2" style="height: 23px;margin-bottom: 10px;color: blue;" id="textbox2" label="サンプルの使い方"></w2:textbox>
    	<w2:textbox style="color: blue;margin-bottom: 30px;" id="textbox3"
    		label='1.各Spinnerの矢印ボタンをクリックして値を増減します。&lt;br/&gt;2.各SpinnerのdateIncrementTypeプロパティ設定に従って値が増減することを確認。' escape="false">
    	</w2:textbox>
    	<w2:textbox
    		style="padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightblue;border:none;margin-bottom: 10px;"
    		id="textbox4" label='プロパティの設定&lt;br/&gt;dataType="date"' escape="false">
    	</w2:textbox>
    	<w2:textbox
    		style="padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightpink;border:none;margin-bottom: 10px;"
    		id="textbox5" label='dateIncrementType="minute"' escape="false">
    	</w2:textbox>
    	<w2:spinner ref="data:dataMap1.key1" dateIncrementType="minute" nextTabID="" dataType="date" skin="type1" inputReadOnly="false"
    		style="display: block;width: 250px;margin-bottom: 10px;" autoFocus="" id="key1" buttonSize="30">
    	</w2:spinner>
    	<w2:textbox style="padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightpink;border:none;margin-bottom: 10px;" id="textbox6" label='dateIncrementType="hour"' escape="false">
    	</w2:textbox>
    	<w2:spinner ref="data:dataMap1.key2" dateIncrementType="hour" nextTabID="" dataType="date" skin="type1" inputReadOnly="false"
    		style="display: block;width: 250px;margin-bottom: 10px;" autoFocus="" id="key2" buttonSize="30">
    	</w2:spinner>
    	<w2:textbox style="padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightpink;border:none;margin-bottom: 10px;" id="textbox7" label='dateIncrementType="day"' escape="false">
    	</w2:textbox>
    	<w2:spinner ref="data:dataMap1.key3" dateIncrementType="day" nextTabID="" dataType="date" skin="type1" inputReadOnly="false"
    		style="display: block;width: 250px;margin-bottom: 10px;" autoFocus="" id="key3" buttonSize="30">
    	</w2:spinner>
    	<w2:textbox style="padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightpink;border:none;margin-bottom: 10px;" id="textbox8" label='dateIncrementType="month"' escape="false">
    	</w2:textbox>
    	<w2:spinner ref="data:dataMap1.key4" dateIncrementType="month" nextTabID="" dataType="date" skin="type1" inputReadOnly="false"
    		style="display: block;width: 250px;margin-bottom: 10px;" autoFocus="" id="key4" buttonSize="30">
    	</w2:spinner>
    	<w2:textbox style="padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightpink;border:none;margin-bottom: 10px;" id="textbox9" label='dateIncrementType="yeaer"' escape="false">
    	</w2:textbox>
    	<w2:spinner ref="data:dataMap1.key5" dateIncrementType="year" nextTabID="" dataType="date" skin="type1" inputReadOnly="false"
    		style="display: block;width: 250px;margin-bottom: 10px;" autoFocus="" id="key5" buttonSize="30">
    	</w2:spinner>
    </xf:group></body>
</html>
