  _url = $c.frame.getBasePageURL($p, true) + "#w2xPath=" + _path;
  window.open(_url, "_blank");
};
scwin.textbox_link_onclick = function (e) {
  var strPage;
  var jsnMenu;
  var _main;
  strPage = this.getUserData("userData1");
  _main = $p.main();
  switch (typeof _main.scwin.menu) {
    case "object":
      jsnMenu = _main.scwin.menu.getMenuByPage(strPage);
      if (jsnMenu && jsnMenu.ID) {
        _main.scwin.dispPage(jsnMenu, true);
      }
      break;
    default:
      var _url = "";
      _url = $c.frame.getBasePageURL($p, true) + "#w2xPath=" + strPage;
      window.open(_url, "_blank");
      break;
  }
};
scwin.btn_modal_onclick = function (e) {
  var _path = "";
  var _title = "";
  _path = this.getUserData("userData1");
  _title = this.getUserData("userData2");
  //type : wframePopup , iframePopup, browserPopup 
  // 별도의 브라우저로 생성되는 팝업 예시 
  var jsnOptions = {
    id: "popup1",
    type: "wframePopup",
    //필수 고정
    width: "500px",
    height: "580px",
    popupName: _title,
    modal: "true" //필수 고정
  };
  $p.openPopup(_path, jsnOptions);
};
scwin.btn_qna_onclick = function () {
  btn_qna.toggleClass('active');
  list_qna.toggleClass('active');
};
