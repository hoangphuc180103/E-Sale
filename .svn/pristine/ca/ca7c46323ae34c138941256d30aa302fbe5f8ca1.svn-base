<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head meta_vertical_guides="" meta_horizontal_guides="">
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
         <script type="text/javascript" lazy="false"><![CDATA[
        
	scwin.onpageload = function() {
        
	var i;
	for (i = 0; i < 5; i++) {
		var num = JSON.stringify(i);
		var title = "Title_" + num;
		var windowId = num;
		var windowName = "Name_" + num;
		windowContainer1.createWindow(title, "", "", windowName, windowId, "newWindow");
		windowContainer1.setArrangeWindows("cascade");
		windowContainer2.createWindow(title, "", "", windowName, windowId, "newWindow");
		windowContainer2.setArrangeWindows("cascade");
	}
	};
	
	scwin.onpageunload = function() {
		
	};

   ]]></script>
    <style type="text/css"><![CDATA[
        /*
        .w2windowContainer_nameLayer {
            width: auto;
        }
        .w2window_maximized .w2window_restore {
            pointer-events: none;
            display: none;
            visibility: hidden;
        }

        .w2window_maximized .w2window_minimize {
            left: 19px;
        }
        */
    ]]></style>
    </head>
    <body ev:onpageload="scwin.onpageload" ev:onpageunload="scwin.onpageunload">
    <xf:group id="" style="margin: 10px;">
    	<w2:textbox tagname="h1" style="color: blue;margin-bottom: 10px;" tabIndex="h1" id="textbox1" label="最小化されたウィンドウを含むソート"
    		escape="false">
    	</w2:textbox>
    	<w2:textbox tagname="h2" style="height: 23px;margin-bottom: 10px;color: blue;" id="textbox2" label="サンプルの使い方"></w2:textbox>
    	<w2:textbox style="color: blue;margin-bottom: 30px;" id="textbox3"
    		label='（初めて目 WindowContainer）&lt;br/&gt;1-1. ハン犬以上ランダムウィンドウ最小化。 &lt;br/&gt;1-2. WindowContainer 右上の Windows ソートボタンクリック。 &lt;br/&gt;1-3. 上から最小化ウィンドウ含むすべて Windows 並べ替え表示されるもの確認。&lt;br/&gt;&lt;br/&gt;（二つ目 WindowContainer）&lt;br/&gt;2-1. ハン犬以上ランダムウィンドウ最小化。 &lt;br/&gt;2-2. WindowContainer 右上の Windows ソートボタンクリック。 &lt;br/&gt;2-3. 上から最小化ウィンドウ除くウィドウマン並べ替え表示されるもの確認。 '
    		escape="false">
    	</w2:textbox>
    	<w2:textbox
    		style="padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightblue;border:none;margin-bottom: 10px;"
    		id="textbox4" label='プロパティの設定&lt;br/&gt;includeMinimizeWindow="true"' escape="false">
    	</w2:textbox>
    	<w2:windowContainer sequentialArrangeColNum="2" dragResizableHeader="true" sequentialArrangeRowNum="2" ev:onwindowload=""
    		fixArrangeFullScreen="false" frameMode="wframe" useFixButton="false" windowAutoResize="false" useWindowScrollButton="true"
    		processMsgFrame="true" verticalArrangeNum="2" windowMaxNum="10" ev:onclosewindow="scwin.wcMain_onclosewindow" useCloseButton="true"
    		controlIconPosition="allright" nameLayerMove="true" toolbarPosition="top" windowMaximizeAll="true" stopMinimizeOnNameLayer="true"
    		id="windowContainer1" useStatusMsg="false" class="" hideTitleOnMaximize="false" windowDragMove="true" ev:onrestorebtnclick=""
    		windowScrollVisibleRowNum="3" spaInitCount="0" stopToggleOnLast="true" useNameContainer="true"
    		ev:onbeforecloseall="scwin.wcMain_onbeforecloseall" closeType="noneFixedWindow" horizontalArrangeNum="2" useCustomMsg="false"
    		ev:onwindowchange="" autoArrange="true" useControlIconTitle="false" tooltipDisplay="true" tooltipGroupClass="false"
    		windowTooltipDisplay="false" style="position: relative;height: 400px;border: gray solid 1px;margin-bottom: 10px;" keepSelectedWindow=""
    		includeMinimizeWindow="true">
    		<w2:windowToolbar>
    			<w2:controlIconLayer>
    				<w2:controlIcon></w2:controlIcon>
    				<w2:controlIcon></w2:controlIcon>
    				<w2:controlIcon></w2:controlIcon>
    				<w2:controlIcon></w2:controlIcon>
    				<w2:controlIcon></w2:controlIcon>
    			</w2:controlIconLayer>
    			<w2:nameLayer></w2:nameLayer>
    			<w2:selectedNameLayer></w2:selectedNameLayer>
    		</w2:windowToolbar>
    	</w2:windowContainer>
    	<w2:textbox escape="false" id="textbox5" label='プロパティの設定&lt;br/&gt;includeMinimizeWindow="false"'
    		style="padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightblue;border:none;margin-bottom: 10px;">
    	</w2:textbox>
    	<w2:windowContainer autoArrange="true" class="" closeType="noneFixedWindow" controlIconPosition="allright"
    		dragResizableHeader="true" ev:onbeforecloseall="scwin.wcMain_onbeforecloseall" ev:onclosewindow="scwin.wcMain_onclosewindow"
    		ev:onrestorebtnclick="" ev:onwindowchange="" ev:onwindowload="" fixArrangeFullScreen="false" frameMode="wframe"
    		hideTitleOnMaximize="false" horizontalArrangeNum="2" id="windowContainer2" keepSelectedWindow=""
    		nameLayerMove="true" processMsgFrame="true" sequentialArrangeColNum="2" sequentialArrangeRowNum="2" spaInitCount="0"
    		stopMinimizeOnNameLayer="true" stopToggleOnLast="true" style="position: relative;height: 400px;border: gray solid 1px;"
    		toolbarPosition="top" tooltipDisplay="true" tooltipGroupClass="false" useCloseButton="true" useControlIconTitle="false"
    		useCustomMsg="false" useFixButton="false" useNameContainer="true" useStatusMsg="false" useWindowScrollButton="true"
    		verticalArrangeNum="2" windowAutoResize="false" windowDragMove="true" windowMaxNum="10" windowMaximizeAll="true"
    		windowScrollVisibleRowNum="3" windowTooltipDisplay="false">
    		<w2:windowToolbar>
    			<w2:controlIconLayer>
    				<w2:controlIcon></w2:controlIcon>
    				<w2:controlIcon></w2:controlIcon>
    				<w2:controlIcon></w2:controlIcon>
    				<w2:controlIcon></w2:controlIcon>
    				<w2:controlIcon></w2:controlIcon>
    			</w2:controlIconLayer>
    			<w2:nameLayer></w2:nameLayer>
    			<w2:selectedNameLayer></w2:selectedNameLayer>
    		</w2:windowToolbar>
    	</w2:windowContainer>
    </xf:group></body>
</html>
