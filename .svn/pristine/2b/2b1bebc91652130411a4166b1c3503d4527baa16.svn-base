<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet href="/2019-09/Components/gridview.css" type="text/css"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head meta_screenName="guide_sample">
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
        	<xf:instance>
        		<data xmlns="" />
        	</xf:instance>
        	<w2:dataCollection baseNode="map">
        		<w2:dataList baseNode="list" repeatNode="map" id="dataList1" saveRemovedData="true">
        			<w2:columnInfo>
        				<w2:column id="Check" name="Check" dataType="text"></w2:column>
        				<w2:column id="ID" name="ID" dataType="text"></w2:column>
        				<w2:column id="Age" name="Age" dataType="text"></w2:column>
        				<w2:column id="date" name="date" dataType="text"></w2:column>
        				<w2:column id="Status" name="Status" dataType="text"></w2:column>
        				<w2:column id="Income" name="Income" dataType="text"></w2:column>
        				<w2:column id="Expense" name="Expense" dataType="text"></w2:column>
        				<w2:column id="Hobby" name="Hobby" dataType="text"></w2:column>
        				<w2:column id="Region" name="Region" dataType="text"></w2:column>
        				<w2:column id="Frequency" name="Frequency" dataType="text"></w2:column>
        			</w2:columnInfo>
        		</w2:dataList>
        		<w2:dataList baseNode="list" repeatNode="map" id="dataList2" saveRemovedData="true">
        			<w2:columnInfo>
        				<w2:column id="label" name="label" dataType="text"></w2:column>
        				<w2:column id="value" name="value" dataType="text"></w2:column>
        				<w2:column id="col3" name="name3" dataType="text"></w2:column>
        			</w2:columnInfo>
        			<w2:data use="true">
        				<w2:row>
        					<label><![CDATA[Single]]></label>
        					<value><![CDATA[Single]]></value>
        					<col3><![CDATA[true]]></col3>
        				</w2:row>
        				<w2:row>
        					<label><![CDATA[Divorced]]></label>
        					<value><![CDATA[Divorced]]></value>
        					<col3><![CDATA[true]]></col3>
        				</w2:row>
        				<w2:row>
        					<label><![CDATA[Married]]></label>
        					<value><![CDATA[Married]]></value>
        					<col3><![CDATA[true]]></col3>
        				</w2:row>
        				<w2:row>
        					<label><![CDATA[None]]></label>
        					<value><![CDATA[None]]></value>
        					<col3><![CDATA[false]]></col3>
        				</w2:row>
        			</w2:data>
        		</w2:dataList>
        	</w2:dataCollection>
        	<w2:workflowCollection></w2:workflowCollection>
        	<xf:submission id="submission1" ref="" target='data:json,dataList1' action="data.json" method="post"
        		mediatype="application/json" encoding="UTF-8" instance="" replace="" errorHandler="" customHandler="" mode="asynchronous"
        		processMsg="" ev:submit="" ev:submitdone="" ev:submiterror="" abortTrigger="">
        	</xf:submission>
        </xf:model>
        <script type="text/javascript" lazy="false"><![CDATA[
        
	scwin.onpageload = function() { var objSubmission = $p.getSubmission("submission1");
    objSubmission.action = scwin.getfolderPath() + '/data.json';
		$p.executeSubmission("submission1");
	};
	
	scwin.onpageunload = function() {
		
	};
	
	scwin.tempFilter = [];
	
	
	scwin.trigger1_onclick = function(e) {
		scwin.tempFilter = dataList1.getFilterList();
		alert("Filter saved.");
	};
	
	
	scwin.trigger4_onclick = function(e) {
		dataList1.clearFilter();
	};
	
	
	scwin.trigger5_onclick = function(e) {		
		for(var i = 0; i < scwin.tempFilter.length; i++) {
			dataList1.setColumnFilter(scwin.tempFilter[i]);
		alert("Filter loaded.");
		}		
	};
	
scwin.getfolderPath = function () {

    var currentPath = window.location.href;
    var folderPath;

    if (currentPath.includes("mainContainer")) {
        console.log("true  ===> " + $p.getFrameId());
        const cmtFrame = $p.getComponentById($p.getFrameId());
        currentPath = cmtFrame.getSrc();
        folderPath = currentPath.substring(0, currentPath.lastIndexOf('/'));
    } else {
        console.log("false  ===> ");
        folderPath = currentPath.split('w2xPath=')[1].substring(0, currentPath.split('w2xPath=')[1].lastIndexOf('/'));
    }
    return folderPath;
};
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload" ev:onpageunload="scwin.onpageunload">
    <xf:group id="" style="margin: 10px;">
    	<w2:textbox tagname="h1" style="color: blue;margin-bottom: 10px;" tabIndex="h1" id="textbox2" label="カスタムフィルタの保存後に再読み込み"
    		escape="false">
    	</w2:textbox>
    	<w2:textbox tagname="h2" style="height: 23px;margin-bottom: 10px;color: blue;" id="textbox3" label="サンプルの使い方"></w2:textbox>
    	<w2:textbox style="color: blue;margin-bottom: 30px;" id="textbox4"
    		label="1. Age, Status, &amp;nbsp;または Hobby 列からフィルター設定。 &lt;br/&gt;2. getFilterList() クリック。 （ユーザー定義フィルター保存。）&lt;br/&gt;3. clearFilterList() クリック。 （フィルター解放。）&lt;br/&gt;4. setColumnFilter() クリック。 （ユーザー定義フィルター再びロード。）&lt;br/&gt;（詳細スクリプトは Script タブから確認。）"
    		escape="false">
    	</w2:textbox>
    	<xf:trigger ev:onclick="scwin.trigger1_onclick"
    		style="height:42px;line-height:32px;padding:5px;background-color:coral;font-size:15px;weight: bolder;font-weight:bolder;text-align: left;display: block;margin-bottom: 10px;"
    		id="trigger3" type="button">
    		<xf:label><![CDATA[dataList1.getFilterList();]]></xf:label>
    	</xf:trigger>
    	<xf:trigger ev:onclick="scwin.trigger4_onclick"
    		style="height:42px;line-height:32px;padding:5px;background-color:coral;font-size:15px;weight: bolder;font-weight:bolder;text-align: left;display: block;margin-bottom: 10px;"
    		id="trigger4" type="button">
    		<xf:label><![CDATA[dataList1.clearFilter();]]></xf:label>
    	</xf:trigger>
    	<xf:trigger ev:onclick="scwin.trigger5_onclick"
    		style="height:42px;line-height:32px;padding:5px;background-color:coral;font-size:15px;weight: bolder;font-weight:bolder;text-align: left;display: block;margin-bottom: 10px;"
    		id="trigger5" type="button">
    		<xf:label><![CDATA[setColumnFilter()]]></xf:label>
    	</xf:trigger>
    	<w2:gridView tooltipPositionY="-20" tooltipShowAlways="" sortEvent="onclick" sortOrderReverse="true" tooltipPositionX="10"
    		preventMultisort="" tooltipHeaderShowAlways="" moveKeyEditMode="" rowNumVisible="true" showSortableImage="" rowStatusWidth=""
    		filterBoxvisibleRowNum="0" scrollByColumn="false" rowNumHeaderValue="No." tooltipHeader="true" defaultCellHeight="25"
    		rowNumBackgroundColor="" focusMode="both" selectedCellColor="#408080" rowNumWidth="30" keyMoveEditMode="" sortedIconPosition="left"
    		moveKeyEditModeAll="" id="gridview1" autoFit="allColumn" tooltipDisplayColumn="" class="" showSortableUseFilter=""
    		scrollByColumnAdaptive="false" editModeEvent="" selectedRowColor="#C0C0C0" useCtrlOnMultisort="" focusFlow="linear" sortable="true"
    		selectedCellOverColor="" editModeEventIcon="" selectedRowOverColor="" tooltipDisplay="" visibleRowNumFix="true"
    		dataList="data:dataList1" style="border: solid 1px gray;margin-bottom: 10px;" columnMove="true" visibleRowNum="10" useFilterList="true">
    		<w2:caption style="" id="caption1" value="this is a grid caption."></w2:caption>
    		<w2:header style="" id="header1">
    			<w2:row style="height: 25px;" id="row1">
    				<w2:column removeBorderStyle="false" width="70" inputType="text" style="height:20px;" id="column19" value="Check"
    					blockSelect="false" displayMode="label">
    				</w2:column>
    				<w2:column removeBorderStyle="false" width="70" inputType="text" style="height:20px;" id="column17" sortable="false"
    					value="ID" blockSelect="false" displayMode="label">
    				</w2:column>
    				<w2:column removeBorderStyle="false" width="70" inputType="text" style="height:20px;" id="column15" sortable=""
    					value="Age" blockSelect="false" displayMode="label" useFilter="true">
    				</w2:column>
    				<w2:column removeBorderStyle="false" width="70" viewType="" inputType="text" style="height:20px;" id="column13"
    					sortable="" value="Status" blockSelect="false" displayMode="label" useFilter="true">
    				</w2:column>
    				<w2:column width="70" inputType="text" style="" id="column16" value="Hobby" displayMode="label" useFilter="true"></w2:column>
    				<w2:column width="70" inputType="text" style="" id="column18" value="Region" displayMode="label"></w2:column>
    			</w2:row>
    		</w2:header>
    		<w2:gBody style="" id="gBody1">
    			<w2:row style="" id="row2">
    				<w2:column removeBorderStyle="false" width="70" viewType="" inputType="checkbox" style="" id="Check" value=""
    					blockSelect="false" displayMode="label">
    				</w2:column>
    				<w2:column removeBorderStyle="false" width="70" inputType="text" style="" id="ID" value="" blockSelect="false"
    					displayMode="label">
    				</w2:column>
    				<w2:column removeBorderStyle="false" width="70" viewType="icon" inputType="spinner" style="height:20px" id="Age"
    					value="" blockSelect="false" displayMode="label" useFilter="">
    				</w2:column>
    				<w2:column sortLabel="" removeBorderStyle="false" chooseOption="" allOption="" blockSelect="false" displayMode="label"
    					ref="" width="70" viewType="" inputType="" style="" id="Status" value="">
    					<w2:choices></w2:choices>
    				</w2:column>
    				<w2:column width="70" inputType="text" style="" id="Hobby" value="" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="" id="Region" value="" displayMode="label"></w2:column>
    			</w2:row>
    		</w2:gBody>
    	</w2:gridView>
    	<w2:textbox escape="false" id="textbox5"
    		label='/// setColumnFilter() サンプルコード&lt;br/&gt;&lt;br/&gt;scwin.tempFilter = [];&lt;br/&gt;&lt;br/&gt;scwin.trigger5_onclick = function(e) {&lt;br/&gt; &amp;nbsp; &amp;nbsp;for (var i = 0; i &lt; scwin.tempFilter.length; i++) {&lt;br/&gt; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;daList1.setColumnFilter(scwin.tempFilter[i]);&lt;br/&gt; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;alert("Filter loaded.");&lt;br/&gt; &amp;nbsp; &amp;nbsp;}&lt;br/&gt;};'
    		style="padding:10px; padding-bottom:20px; text-align:left; font-size:15px; font-weight:bolder; border:brown 1px solid; background-color:ivory; margin-bottom:10px; color:brown;"
    		tagname="">
    	</w2:textbox>
    </xf:group></body>
</html>
