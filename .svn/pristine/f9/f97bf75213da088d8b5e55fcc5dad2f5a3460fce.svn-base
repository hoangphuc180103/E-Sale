// 초기화 
scwin.btnInit_onclick = function (e) {
  scwin._nameStr = "";
  gen1.removeAll();
};

//  기존 내용 지우고 재 생성 
scwin.btnAdd1_onclick = function (e) {
  gen1.removeAll();
  var _nameStr = chk1.getValue();
  if (_nameStr == "") {
    alert("조건을 선택 하세요");
  } else {
    var _nameArr = _nameStr.split(",");
    var _nameLen = _nameArr.length;
    for (var i = 0; i < _nameLen; i++) {
      gen1.insertChild(i);
      gen1.getChild(i, "spn_name").setValue(_nameArr[i]);
      var obj = dataList1.getMatchedJSON("name", _nameArr[i], true);
      for (var j = 0; j < 5; j++) {
        // 정기 점검
        var obj_periodicInspection = gen1.getChild(i, "spn_periodicInspection" + j);
        obj_periodicInspection.setValue(obj[j].periodicInspection);

        // 개별 문의
        var obj_individualInquiry = gen1.getChild(i, "spn_individualInquiry" + j);
        obj_individualInquiry.setValue(obj[j].individualInquiry);

        // 서비스데스크
        var obj_serviceDesk = gen1.getChild(i, "spn_serviceDesk" + j);
        obj_serviceDesk.setValue(obj[j].serviceDesk);

        // 설치 지원 
        var obj_installationSupport = gen1.getChild(i, "spn_installationSupport" + j);
        obj_installationSupport.setValue(obj[j].installationSupport);

        // 패치 지원원
        var obj_fixedLengthVo = gen1.getChild(i, "spn_fixedLengthVo" + j);
        obj_fixedLengthVo.setValue(obj[j].fixedLengthVo);

        // 장애 대응
        var obj_errorResponse = gen1.getChild(i, "spn_errorResponse" + j);
        obj_errorResponse.setValue(obj[j].errorResponse);

        // 라이선스
        var obj_license = gen1.getChild(i, "spn_license" + j);
        obj_license.setValue(obj[j].license);
      }
    }
  }
};
}}}]}]},{T:1,N:'body',A:{'ev:onpageload':'scwin.onpageload'},E:[{T:1,N:'xf:group',A:{class:'sub_contents',id:'',style:''},E:[{T:1,N:'xf:group',A:{class:'pgtbox',id:'',style:''},E:[{T:1,N:'xf:trigger',A:{class:'btn_fav',id:'',style:'',type:'button'},E:[{T:1,N:'xf:label'}]},{T:1,N:'w2:textbox',A:{class:'pgt_tit',id:'',label:'Generator를 활용한 Table 형태의 구성화면',style:'',tagname:''}}]},{T:1,N:'xf:group',A:{class:'ws_example_grp_desc',id:'',style:''},E:[{T:1,N:'xf:group',A:{class:'titbox',id:'',style:''},E:[{T:1,N:'w2:textbox',A:{class:'ws_example_txt_desc_info',id:'',label:'해당화면은 코딩이 완료된 화면',style:'',tagname:'h3'}}]},{T:1,N:'xf:group',A:{class:'',id:'',style:'',tagname:'details'},E:[{T:1,N:'w2:textbox',A:{escape:'false',id:'',label:'실습 목표',style:'',tagname:'summary'}},{T:1,N:'w2:textbox',A:{class:'',escape:'false',id:'',label:'1. 개요<br/>본 화면은 generator 컴포넌트를 활용하여 Table 형태의 반복 기능의 화면을 구성한 예제 입니다.<br/>generator 컴포넌트 : generator 컴포넌트는 특정 컴포넌트를 반복적으로 추가/삭제가 가능한 컴포넌트 입니다. <br/> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;generator 컴포넌트의 하위에 정의된 영역이 반복되며 script를 통해 제어 가능합니다. <br/> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;generator로 생성된 컴포넌트를 제어할 수 있는 함수도 지원하고 있습니다. <br/>',style:''}}]},{T:1,N:'xf:group',A:{class:'',id:'',style:'',tagname:'details'},E:[{T:1,N:'w2:textbox',A:{escape:'false',id:'',label:'실습 방법',style:'',tagname:'summary'}},{T:1,N:'w2:textbox',A:{class:'',escape:'false',id:'',label:'1. 구성된 화면을 웹 브라우저를 통해 실행합니다. <br/>2. 실행된 화면에서 조건 선택을 통해 다수의 사용자를 지정 후 추가 버튼을 클릭합니다. <br/>3. 선택된 사용자에 맞게 테이블 형태가 반복 되며, 초기화 버튼을 클릭하면, 반복된 영역이 사라집니다.',style:''}}]}]},{T:1,N:'xf:group',A:{class:'schbox',id:'',style:''},E:[{T:1,N:'xf:group',A:{class:'schbox_inner',id:'',style:''},E:[{T:1,N:'xf:group',A:{adaptive:'layout',adaptiveThreshold:'768',class:'w2tb tbl ',id:'',style:'',tagname:'table'},E:[{T:1,N:'w2:attributes',E:[{T:1,N:'w2:summary'}]},{