<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare"
	xmlns:xf="http://www.w3.org/2002/xforms">
	<head meta_author="InswaveSystems" meta_type="메인" meta_screenName="[GridView] 엑셀 다운로드 시 스타일 설정하기 - 공통">
		<w2:historyInfo>
			<w2:history meta_no="01" meta_desc="최초작성" meta_date="20230315" meta_user="InswaveSystems"></w2:history>
			<w2:history meta_no="02" meta_desc="설명부 수정" meta_date="20240621" meta_user="InswaveSystems"></w2:history>
			<w2:history meta_no="03" meta_desc="예제에서 사용하는 DataList가 변경되고, 이에 따른 GridView의 설정과 스크립트가 수정되었습니다." meta_date="20240712"
				meta_user="InswaveSystems"></w2:history>	
		</w2:historyInfo>
		<w2:type>COMPONENT</w2:type>
		<w2:buildDate />
		<w2:MSA />
		<xf:model>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" id="dlt_exam" repeatNode="map" style="" valueAttribute="">
					<w2:columnInfo>
						<w2:column dataType="text" id="category" name="Category"></w2:column>
						<w2:column dataType="text" id="product" name="Product"></w2:column>
						<w2:column dataType="text" id="stock" name="Stock"></w2:column>
					</w2:columnInfo>
					<w2:data use="true" xmlns="">
						<w2:row>
							<category><![CDATA[Hardware]]></category>
							<stock><![CDATA[98291]]></stock>
							<product><![CDATA[UltraNet]]></product>
						</w2:row>
						<w2:row>
							<category><![CDATA[Hardware]]></category>
							<stock><![CDATA[528]]></stock>
							<product><![CDATA[UltraServer]]></product>
						</w2:row>
						<w2:row>
							<category><![CDATA[Hardware]]></category>
							<stock><![CDATA[73928]]></stock>
							<product><![CDATA[StoreSafe]]></product>
						</w2:row>
						<w2:row>
							<category><![CDATA[Software]]></category>
							<stock><![CDATA[6894]]></stock>
							<product><![CDATA[IntelliAI]]></product>
						</w2:row>
						<w2:row>
							<category><![CDATA[Software]]></category>
							<product><![CDATA[DeepThink]]></product>
							<stock><![CDATA[4536219]]></stock>
						</w2:row>
					</w2:data>
				</w2:dataList>
			</w2:dataCollection>
			<w2:workflowCollection />
		</xf:model>
		<w2:layoutInfo />
		<w2:publicInfo method="" />
		<script lazy="false" type="text/javascript"><![CDATA[scwin.onpageload = function () {

};

/**
 * 버튼 [엑셀 다운로드 - 기본] 클릭 시
 */
scwin.btn_ex1_onclick = function (e) {
    var jsnOptions;

    jsnOptions = {
        fileName: "EXAMPLE_P00243_TYPE1.xlsx", //엑셀의 파일명
        useSubTotal: "true" //subTotal 표시
    };

    grd_exam1.advancedExcelDownload(jsnOptions);
};

/**
 * 버튼 [엑셀 다운로드 - 공통 스타일 적용] 클릭 시
 */
scwin.btn_ex2_onclick = function (e) {
    var jsnOptions;

    jsnOptions = {
        fileName: "EXAMPLE_P00243_TYPE2.xlsx", //엑셀의 파일명
        useSubTotal: "true", //필수 설정 - subTotal 표시
        rowHeight: "30", //Excel 파일로 다운로드 할 때 엑셀의 셀 높이. (단위: pixel)
        displayGridlines: "false" //Excel 파일 전체 셀의 눈금선 제거 유무
    };

    //GridView "grd_exam1"의 엑셀 다운로드 실행
    grd_exam1.advancedExcelDownload(jsnOptions);
};]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:group class="sub_contents">
			<xf:group class="ws_example_grp_desc">
				<w2:textbox class="" escape="false"
					label="GridView의 'advancedExcelDownload' 메소드를 사용하여, 엑셀 다운로드 시 행 높이와 눈금선을 표시하지 않도록 설정한 예제입니다." style="">
				</w2:textbox>
			</xf:group>
			<xf:group class="example_div_tb_style_wrap">
				<xf:group class="mb_def_box nobottom">
					<xf:trigger class="btn_exam_exec btn_txt_of" ev:onclick="scwin.btn_ex1_onclick" id="btn_ex1" localeRef=""
						style="min-width: 30px; height: 26px;" type="" useDefaultLabel="true">
						<xf:label><![CDATA[엑셀 다운로드 - 기본]]></xf:label>
					</xf:trigger>
					<xf:trigger class="btn_exam_exec btn_txt_of" ev:onclick="scwin.btn_ex2_onclick" id="btn_ex2" localeRef=""
						style="min-width:30px;height:26px;" type="" useDefaultLabel="true">
						<xf:label><![CDATA[엑셀 다운로드 - 공통 스타일 적용]]></xf:label>
					</xf:trigger>
				</xf:group>
				<xf:group id="" class="gvwbox" style="max-width: 400px;">
					<w2:gridView baseNode="" focusMode="row" dataList="data:dlt_exam" readOnly="true" style="height:200px;" id="grd_exam1"
						visibleRowNum="all" autoFit="allColumn" class="gvw" defaultCellHeight="37" autoFitMinWidth="266">
						<w2:header style="" id="header5">
							<w2:row style="" id="row35">
								<w2:column hidden="false" width="100" inputType="text" id="h_col1" value="Category" blockSelect="false"
									displayMode="label">
								</w2:column>
								<w2:column width="110" inputType="text" id="h_col2" value="Product" blockSelect="false" displayMode="label">
								</w2:column>
								<w2:column width="100" inputType="text" id="h_col3" value="Stock"></w2:column>
							</w2:row>
						</w2:header>
						<w2:gBody style="" id="gBody5">
							<w2:row style="" id="row37">
								<w2:column hidden="false" colMerge="true" width="100" inputType="text" id="category" blockSelect="false"
									displayMode="label">
								</w2:column>
								<w2:column textAlign="left" width="110" inputType="text" id="product" blockSelect="false" displayMode="label">
								</w2:column>
								<w2:column textAlign="right" dataType="number" width="100" displayFormat="#,###" inputType="text" id="stock">
								</w2:column>
							</w2:row>
						</w2:gBody>
						<w2:subTotal targetColumnID="category" style="" id="subTotal1">
							<w2:row style="" id="row42">
								<w2:column width="100" inputType="text" style="height:30px;" id="column577" value="Subtotal" blockSelect="false"
									displayMode="label">
								</w2:column>
								<w2:column expression="targetColValue() + ':  ' +count('product')" textAlign="left" width="110" inputType="expression"
									style="height:30px;" id="column596" blockSelect="false" displayMode="label">
								</w2:column>
								<w2:column expression="sum('stock')" textAlign="right" dataType="number" width="100" displayFormat="#,###"
									inputType="expression" style="height:30px;" id="sub_col_1" blockSelect="false" displayMode="label">
								</w2:column>
							</w2:row>
						</w2:subTotal>
						<w2:footer style="" id="footer1">
							<w2:row style="" id="row41">
								<w2:column width="100" inputType="text" style="height:40px;" id="column580" value="Total" blockSelect="false"
									displayMode="label">
								</w2:column>
								<w2:column expression="'Products: '+ count('product')" textAlign="left" width="110" inputType="expression"
									style="height:40px;" id="column597">
								</w2:column>
								<w2:column expression="sum('stock')" textAlign="right" dataType="number" width="100" displayFormat="#,###"
									inputType="expression" style="height:40px;" id="column526">
								</w2:column>
							</w2:row>
						</w2:footer>
					</w2:gridView>
				</xf:group>
			</xf:group>
		</xf:group>
	</body>
</html>