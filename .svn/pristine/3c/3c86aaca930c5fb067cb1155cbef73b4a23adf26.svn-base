<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head meta_screenName="guide_sample">
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
        	<xf:instance>
        		<data xmlns="" />
        	</xf:instance>
        	<w2:dataCollection baseNode="map">
        		<w2:dataList baseNode="list" id="dataList1" repeatNode="map" saveRemovedData="true" style="">
        			<w2:columnInfo>
        				<w2:column dataType="text" id="Continent" name="Continent"></w2:column>
        				<w2:column dataType="text" id="Country" name="Country"></w2:column>
        				<w2:column dataType="text" id="Item" name="Item"></w2:column>
        				<w2:column dataType="text" id="Quantity" name="Quantity"></w2:column>
        			</w2:columnInfo>
        		</w2:dataList>
        	</w2:dataCollection>
        	<w2:workflowCollection></w2:workflowCollection>
        </xf:model>
        <script type="text/javascript" lazy="false"><![CDATA[

scwin.onpageload = function () {
    var json = [
        { "Continent": "Asia", "Country": "Korea", "Item": "TV", "Quantity": "400" },
        { "Continent": "Asia", "Country": "Korea", "Item": "Freezer", "Quantity": "300" },
        { "Continent": "Asia", "Country": "Korea", "Item": "Washer", "Quantity": "100" },
        { "Continent": "Asia", "Country": "Korea", "Item": "Heater", "Quantity": "250" },
        { "Continent": "Asia", "Country": "China", "Item": "TV", "Quantity": "400" },
        { "Continent": "Asia", "Country": "China", "Item": "Freezer", "Quantity": "300" },
        { "Continent": "Asia", "Country": "China", "Item": "Washer", "Quantity": "100" },
        { "Continent": "Asia", "Country": "Japan", "Item": "TV", "Quantity": "100" },
        { "Continent": "Asia", "Country": "Japan", "Item": "Freezer", "Quantity": "300" },
        { "Continent": "Asia", "Country": "Japan", "Item": "Washer", "Quantity": "200" },
        { "Continent": "Europe", "Country": "Germany", "Item": "TV", "Quantity": "100" },
        { "Continent": "Europe", "Country": "Germany", "Item": "Freezer", "Quantity": "300" },
        { "Continent": "Europe", "Country": "Germany", "Item": "Washer", "Quantity": "200" },
        { "Continent": "Europe", "Country": "France", "Item": "TV", "Quantity": "100" },
        { "Continent": "Europe", "Country": "France", "Item": "Freezer", "Quantity": "300" },
        { "Continent": "Europe", "Country": "France", "Item": "Washer", "Quantity": "200" },
        { "Continent": "Europe", "Country": "Denmark", "Item": "TV", "Quantity": "100" },
        { "Continent": "Europe", "Country": "Denmark", "Item": "Freezer", "Quantity": "300" },
        { "Continent": "Europe", "Country": "Denmark", "Item": "Washer", "Quantity": "200" },
        { "Continent": "Americas", "Country": "Canada", "Item": "TV", "Quantity": "100" },
        { "Continent": "Americas", "Country": "Canada", "Item": "Freezer", "Quantity": "300" },
        { "Continent": "Americas", "Country": "Canada", "Item": "Washer", "Quantity": "200" },
        { "Continent": "Americas", "Country": "USA", "Item": "TV", "Quantity": "100" },
        { "Continent": "Americas", "Country": "USA", "Item": "Freezer", "Quantity": "300" },
        { "Continent": "Americas", "Country": "USA", "Item": "Washer", "Quantity": "200" },
        { "Continent": "Americas", "Country": "Mexico", "Item": "TV", "Quantity": "100" },
        { "Continent": "Americas", "Country": "Mexico", "Item": "Freezer", "Quantity": "300" },
        { "Continent": "Americas", "Country": "Mexico", "Item": "Washer", "Quantity": "200" }
    ];
    dataList1.setJSON(json);
};

scwin.onpageunload = function () {

};



scwin.trigger1_onclick = function (e) {
    var json1 = [
        { "Continent": "Africa", "Country": "Kenya", "Item": "TV", "Quantity": "600" },
        { "Continent": "Africa", "Country": "Kenya", "Item": "Freezer", "Quantity": "400" },
        { "Continent": "Africa", "Country": "Kenya", "Item": "Washer", "Quantity": "900" },
        { "Continent": "Africa", "Country": "Kenya", "Item": "Heater", "Quantity": "150" }
        ];
        dataList1.insertJSON(0, json1, {"fixScroll": true});
};

scwin.trigger2_onclick = function (e) {
    var json2 = [
        { "Continent": "Middle East", "Country": "Iran", "Item": "TV", "Quantity": "700" },
        { "Continent": "Middle East", "Country": "Iran", "Item": "Freezer", "Quantity": "100" },
        { "Continent": "Middle East", "Country": "Iran", "Item": "Washer", "Quantity": "200" },
        { "Continent": "Middle East", "Country": "Iran", "Item": "Heater", "Quantity": "500" }
        ];
        dataList1.insertJSON(0, json2);
};
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload" ev:onpageunload="scwin.onpageunload">
    <xf:group id="" style="margin: 10px;">
    	<w2:textbox tagname="h1" style="color: blue;margin-bottom: 10px;" tabIndex="h1" id="textbox1" label="Add Data while Fixing Scroll"
    		escape="false">
    	</w2:textbox>
    	<w2:textbox tagname="h2" style="height: 23px;margin-bottom: 10px;color: blue;" id="textbox2" label="How to Use"></w2:textbox>
    	<w2:textbox style="color: blue;margin-bottom: 30px;" id="textbox3"
    		label='1. Move the vertical scrollbar of the GridView to the middle position.&lt;br/&gt;&lt;br/&gt;2-1. Click the first button. (Applies the {“fixScroll”: true} option.)&lt;br/&gt;2-2. Verify that data is added and the vertical scrollbar does not move.&lt;br/&gt;&lt;br/&gt;3-1. Click the second button.&lt;br/&gt;3-2. Verify that data is added and the vertical scrollbar moves to the top of the GridView.&lt;br/&gt;&lt;br/&gt;(See the Scripts tab for detailed code.)'
    		escape="false">
    	</w2:textbox>
    	<xf:trigger ev:onclick="scwin.trigger1_onclick"
    		style="height:42px; line-height:32px; padding:5px; background-color:coral; font-size:15px; weight:bolder; font-weight:bolder; text-align:left; display:block; margin-bottom:10px;"
    		id="trigger1" type="button">
    		<xf:label><![CDATA[dataList1.insertJSON(0, json1, {"fixScroll": true});]]></xf:label>
    	</xf:trigger>
    	<xf:trigger type="button" id="trigger2"
    		style="height:42px; line-height:32px; padding:5px; background-color:coral; font-size:15px; weight:bolder; font-weight:bolder; text-align:left; display:block; margin-bottom:10px;"
    		ev:onclick="scwin.trigger2_onclick">
    		<xf:label><![CDATA[dataList1.insertJSON(0, json2);]]></xf:label>
    	</xf:trigger>
    	<w2:gridView scrollByColumnAdaptive="false" hammerEnabled="true" dataDragDrop="true" selectedRowColor="pink" useShiftKey="true"
    		useCtrlOnMultisort="" scrollByColumn="false" dataDragDropStatus="true" focusFlow="linear" defaultCellHeight="20"
    		selectedCellColor="lightgreen" focusMode="none" contextMenu="true" visibleRowNumFix="" dataList="data:dataList1" dataDragSelect=""
    		style="border:solid gray 1px;height:176px;" cellStatusIconPosition="left" id="gridView1" autoFit="allColumn" visibleRowNum=""
    		useFilterList="true" useCtrlKey="" cellStatusVisible="true" rowNumVisible="true" sortable="true">
    		<w2:caption style="" id="caption2" value="this is a grid caption."></w2:caption>
    		<w2:header style="" id="header2">
    			<w2:row style="" id="row3">
    				<w2:column width="70" inputType="text" style="" id="column1" value="Continent" displayMode="label" useFilter="true"></w2:column>
    				<w2:column width="70" inputType="text" style="" id="column2" value="Country" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="" id="column3" value="Item" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="" id="column4" value="Quantity" displayMode="label"></w2:column>
    			</w2:row>
    		</w2:header>
    		<w2:gBody style="" id="gBody2">
    			<w2:row style="" id="row4">
    				<w2:column width="70" inputType="text" style="" id="Continent" value="" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="" id="Country" value="" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="" id="Item" value="" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="" id="Quantity" value="" displayMode="label"></w2:column>
    			</w2:row>
    		</w2:gBody>
    	</w2:gridView>
    </xf:group></body>
</html>
