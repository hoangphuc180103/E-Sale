<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
        <w2:type>COMPONENT</w2:type>
        <w2:buildDate/>
        <w2:MSA/>
        <xf:model>
            <w2:dataCollection baseNode="map"/>
            <w2:workflowCollection/>
        </xf:model>
        <w2:layoutInfo/>
        <w2:publicInfo method=""/>
        <script lazy="false" type="text/javascript"><![CDATA[
scwin.onpageload = function() {
	
};
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload">
    <xf:group id="" style="margin: 10px;"><w2:textbox tagname="h1" style="color: blue;margin-bottom: 10px;" tabIndex="h1" id="textbox1" label="HTMLの &amp;lt;title&amp;gt; &amp;nbsp;タグサポート" escape="false"></w2:textbox><w2:textbox tagname="h2" style="height: 23px;margin-bottom: 10px;color: blue;" id="textbox2" label="サンプルの使い方"></w2:textbox><w2:textbox style="color: blue;margin-bottom: 30px;" id="textbox3" label='1. F12 ボタン押す開発者ツール開く。 &lt;br/&gt;2. 画面上 Spinnerを選択。 &lt;br/&gt;3. 開発者ツールの Elements タブ選択として移動。&lt;br/&gt;4. Spinnerの &amp;lt;title&amp;gt; タグ値 "Spinner_Test"ロー設定もの確認。' escape="false">
    	</w2:textbox><w2:textbox style="padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightblue;border:none;margin-bottom: 10px;" id="textbox4" label='プロパティの設定&lt;br/&gt;title="Spinner_Test"' escape="false">
    	</w2:textbox><w2:spinner skin="type1" inputReadOnly="false" style="width: 50%;margin-bottom: 10px;" id="spinner1" title="Spinner_Test" buttonSize="30">
    	</w2:spinner></xf:group></body>
</html>
