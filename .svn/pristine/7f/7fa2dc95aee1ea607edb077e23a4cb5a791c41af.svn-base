/**
 * DataList 'dlt_exam'에 데이터 할당하기
 */
scwin.initData = function () {
  // DataList 'dlt_exam'에 데이터 할당하기
  let data = [{
    "category": "Networking",
    "product": "SpeedLink",
    "stock": "15800"
  }, {
    "category": "Cloud Services",
    "product": "CloudFlex",
    "stock": "17800"
  }, {
    "category": "Support Services",
    "product": "TechAssist",
    "stock": "15800"
  }, {
    "category": "Servers",
    "product": "EcoServe",
    "stock": "17200"
  }, {
    "category": "Cloud Services",
    "product": "CloudPro",
    "stock": "18000"
  }, {
    "category": "Networking",
    "product": "NetMax",
    "stock": "16000"
  }, {
    "category": "Support Services",
    "product": "TechTeam",
    "stock": "17800"
  }, {
    "category": "Security",
    "product": "SecureGate",
    "stock": "28900"
  }, {
    "category": "Networking",
    "product": "LinkSecure",
    "stock": "12500"
  }];
  dlt_exam.setJSON(data);

  // DataList 'dlt_exam'의 모든 필터 해제하기
  dlt_exam.clearFilter();
};

/**
 * 버튼 [DataList의 데이터 초기화] 클릭 시
 */
scwin.btn_initData_onclick = function (e) {
  scwin.initData();
};

/**
 * 버튼 [DataList의 필터 전체 해제] 클릭 시
 */
scwin.btn_clearFilter_onclick = function (e) {
  // DataList 'dlt_exam'의 모든 필터 해제하기
  dlt_exam.clearFilter();
};

/**
 * 버튼 ['Category' 컬럼에 필터 적용 - 데이터가 'Networking'과 일치] 클릭 시
 */
scwin.btn_exam1_1_onclick = function (e) {
  // DataList 'dlt_exam'에 필터를 해제합니다.
  dlt_exam.clearFilter();

  // 필터 조건이 담긴 JSON
  let jsnFilterOptions = {};
  jsnFilterOptions.type = "regExp"; // 검색 방식. 'key' 속성에 정의된 정규표현식으로 검색.
  jsnFilterOptions.colIndex = "category"; // DataList의 컬럼 ID 또는 컬럼 Index. 검색 대상.
  jsnFilterOptions.key = new RegExp("^Networking$"); // 정규 표현식
  jsnFilterOptions.condition = "and"; // 기 적용된 필터 데이터와의 병합 조건. 최초 필터를 적용하는 경우 "and"로 할당. 

  // 검색 대상 데이터 : ID가 "category"인 컬럼
  // 검색 방법 : 정규 표현식 - new RegExp("^Networking$")
  // 기 적용된 필터 데이터와의 병합 조건 : 교집합

  // DataList 'dlt_exam'에 필터를 적용합니다.
  dlt_exam.setColumnFilter(jsnFilterOptions);

  // 로그 출력
  let strLog = "# 'Category' 컬럼에 필터 적용 - 데이터가 'Networking' | 필터 조건 ";
  let logOptions = '{' + "\n" + '	"type": "regExp",' + "\n" + '	"colIndex": "category",' + "\n" + '	"key": new RegExp("^Networking$"),' + "\n" + '	"condition": "and"' + "\n" + '}';
  $c.frame.printExampleLog($p, strLog, txa_log, false);
  $c.frame.printExampleLog($p, logOptions, txa_log, false);
  console.log(strLog);
  console.log(jsnFilterOptions);
};

