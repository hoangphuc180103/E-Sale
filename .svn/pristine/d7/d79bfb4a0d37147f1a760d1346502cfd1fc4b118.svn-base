<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            	<w2:dataList baseNode="list" repeatNode="map" id="dataList1" saveRemovedData="true">
            		<w2:columnInfo>
            			<w2:column id="CNT" name="Country" dataType="text"></w2:column>
            			<w2:column id="CAP" name="Capital" dataType="text"></w2:column>
            			<w2:column id="CONT" name="Continent" dataType="text"></w2:column>
            		</w2:columnInfo>
            		<w2:data use="true">
            			<w2:row>
            				<CNT><![CDATA[Korea]]></CNT>
            				<CAP><![CDATA[Seoul]]></CAP>
            				<CONT><![CDATA[Asia]]></CONT>
            			</w2:row>
            			<w2:row>
            				<CNT><![CDATA[Japan]]></CNT>
            				<CAP><![CDATA[Tokyo]]></CAP>
            				<CONT><![CDATA[Asia]]></CONT>
            			</w2:row>
            			<w2:row>
            				<CNT><![CDATA[China]]></CNT>
            				<CAP><![CDATA[Beijing]]></CAP>
            				<CONT><![CDATA[Asia]]></CONT>
            			</w2:row>
            			<w2:row>
            				<CNT><![CDATA[France]]></CNT>
            				<CAP><![CDATA[Bangkok]]></CAP>
            				<CONT><![CDATA[Europe]]></CONT>
            			</w2:row>
            			<w2:row>
            				<CNT><![CDATA[Norway]]></CNT>
            				<CAP><![CDATA[Oslo]]></CAP>
            				<CONT><![CDATA[Europe]]></CONT>
            			</w2:row>
            			<w2:row>
            				<CNT><![CDATA[Spain]]></CNT>
            				<CAP><![CDATA[Madrid]]></CAP>
            				<CONT><![CDATA[Europe]]></CONT>
            			</w2:row>
            			<w2:row>
            				<CNT><![CDATA[Canada]]></CNT>
            				<CAP><![CDATA[Ottawa]]></CAP>
            				<CONT><![CDATA[America]]></CONT>
            			</w2:row>
            			<w2:row>
            				<CNT><![CDATA[Egypt]]></CNT>
            				<CAP><![CDATA[Cairo]]></CAP>
            				<CONT><![CDATA[Africa]]></CONT>
            			</w2:row>
            			<w2:row>
            				<CNT><![CDATA[Kenya]]></CNT>
            				<CAP><![CDATA[Nairobi]]></CAP>
            				<CONT><![CDATA[Africa]]></CONT>
            			</w2:row>
            			<w2:row>
            				<CNT><![CDATA[Thailand]]></CNT>
            				<CAP><![CDATA[Bangkok]]></CAP>
            				<CONT><![CDATA[Asia]]></CONT>
            			</w2:row>
            		</w2:data>
            	</w2:dataList>
            	<w2:dataMap baseNode="map" id="dataMap1">
            		<w2:keyInfo>
            			<w2:key id="CNT" name="Country" dataType="text"></w2:key>
            			<w2:key id="CAP" name="Capital" dataType="text"></w2:key>
            			<w2:key id="CONT" name="Continent" dataType="text"></w2:key>
            		</w2:keyInfo>
            		<w2:data use="true">
            			<Canada><![CDATA[ ]]></Canada>
            			<Canada><![CDATA[ ]]></Canada>
            			<CNT><![CDATA[Canada]]></CNT>
            			<CAP><![CDATA[Ottawa]]></CAP>
            			<CONT><![CDATA[America]]></CONT>
            		</w2:data>
            	</w2:dataMap>
            	<w2:linkedDataList bind="dataList1" id="linkedDataList1">
            		<w2:condition type="filter"><![CDATA[CONT=="Asia"]]></w2:condition>
            		<w2:condition type="sort"><![CDATA[]]></w2:condition>
            	</w2:linkedDataList>
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
         <script type="text/javascript" lazy="false"><![CDATA[
        
	scwin.onpageload = function() {
		
	};
	
	scwin.onpageunload = function() {
		
	};
	
	]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload" ev:onpageunload="scwin.onpageunload">
    <xf:group id="" style="margin: 10px;"><w2:textbox tagname="h1" style="color: blue;margin-bottom: 10px;" tabIndex="h1" id="textbox1" label="화면의 DataCollection 객체 확인" escape="false"></w2:textbox><w2:textbox tagname="h2" style="height: 23px;margin-bottom: 10px;color: blue;" id="textbox2" label="샘플 사용 방법"></w2:textbox><w2:textbox style="color: blue;margin-bottom: 30px;" id="textbox3" label='1. 화면에서 Ctrl 버튼을 누르고 마우스 우클릭.&lt;br/&gt;2. "dataCollection 보기" 메뉴 선택.&lt;br/&gt;3. (화면에는 표시되지 않지만) DataMap, DataList, LinkedDataList가 화면에 정의된 것을 확인.&lt;br/&gt;4. 각 DataCollection 객체를 선택하고 데이트를 확인.' escape="false">
    	</w2:textbox></xf:group></body>
</html>
