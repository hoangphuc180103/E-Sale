<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
         <script type="text/javascript" lazy="false"><![CDATA[

scwin.onpageload = function () {
    requires("uiplugin.popup");
};

scwin.onpageunload = function () {

};


scwin.trigger1_onclick = function (e) {
    var tmpSrc = scwin.getfolderPath() + "/popup_src.xml";
    var opts = {
        "id": "popup2",
        "type": "wframePopup",
        "popupName": "WFrame Popup",
        "width": "500px",
        "height": "500px",
        "top": 100,
        "left": 300,
        "modal": true
    }
    $p.openPopup(tmpSrc, opts);
};

scwin.getfolderPath = function () {

    var currentPath = window.location.href;
    var folderPath;

    if (currentPath.includes("mainContainer")) {
        console.log("true  ===> " + $p.getFrameId());
        const cmtFrame = $p.getComponentById($p.getFrameId());
        currentPath = cmtFrame.getSrc();
        folderPath = currentPath.substring(0, currentPath.lastIndexOf('/'));
    } else {
        console.log("false  ===> ");
        folderPath = currentPath.split('w2xPath=')[1].substring(0, currentPath.split('w2xPath=')[1].lastIndexOf('/'));
    }
    return folderPath;
};]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload" ev:onpageunload="scwin.onpageunload">
    <xf:group id="" style="margin: 10px;"><w2:textbox tagname="h1" style="color: blue;margin-bottom: 10px;" id="textbox1" label="WFrame 팝업 여부 확인" escape="false"></w2:textbox><w2:textbox tagname="h2" style="height: 23px;margin-bottom: 10px;color: blue;" id="textbox2" label="샘플 사용 방법"></w2:textbox><w2:textbox style="color: blue;margin-bottom: 30px;" id="textbox3" label='1. 하단의 버튼을 클릭. &lt;br/&gt;2. WFrame 팝업이 생성되는 것을 확인. &lt;br/&gt;3. WFrame 팝업의 소스(src) 화면이 WFrame을 포함하는 것을 확인. &lt;br/&gt;4. 팝업의 WFrame 내부에 있는 첫 번째 버튼을 클릭. &lt;br/&gt;5. 자신이 속한 화면이 WFrame이기 때문에 false가 반환되는 것을 확인. &amp;nbsp;&lt;br/&gt;6. 팝업의 WFrame 내부에 있는 두 번째 버튼을 클릭. &lt;br/&gt;7. 자신의 부모가 WFrame 팝업이기 때문에 true가 반환되는 것을 확인. &lt;br/&gt;(자세한 스크립트는 wframe_src.xml 파일을 확인.)' escape="false">
    	</w2:textbox><xf:trigger ev:onclick="scwin.trigger1_onclick" style="display: block;height:42px;line-height:32px;padding:5px;background-color:coral;font-size:15px;weight: bolder;font-weight:bolder;margin-bottom:10px;text-align: left;" id="trigger1" type="button">
    		<xf:label><![CDATA[$p.openPopup()]]></xf:label>
    	</xf:trigger></xf:group></body>
</html>
