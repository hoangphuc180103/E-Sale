<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
         <script type="text/javascript" lazy="false"><![CDATA[
        
	scwin.onpageload = function() {
		
	};
	
	scwin.onpageunload = function() {
		
	};
	
	]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload" ev:onpageunload="scwin.onpageunload">
    <xf:group id="" style="margin: 10px;">
    	<w2:textbox style="color: blue;margin-bottom: 10px;" id="textbox1" label='Input Various Currency Units' escape="false" tagname="h1"></w2:textbox>
    	<w2:textbox tagname="h2" style="height: 23px;margin-bottom: 10px;color: blue;" id="textbox4" label="How to Use"></w2:textbox>
    	<w2:textbox style="color: blue;margin-bottom: 30px;" id="textbox2" label="Enter a number, and confirm that it is displayed according to the specified currency format." escape="false">
    	</w2:textbox>
    	<xf:group tagname="table" style="" id="" class="w2tb">
    		<w2:attributes>
    			<w2:summary></w2:summary>
    		</w2:attributes>
    		<xf:group tagname="caption"></xf:group>
    		<xf:group tagname="colgroup">
    			<xf:group tagname="col" style="width:55.73%;"></xf:group>
    			<xf:group tagname="col" style="width:50.00%"></xf:group>
    		</xf:group>
    		<xf:group tagname="tr" style="">
    			<xf:group tagname="th" style="font-size: 15px;font-weight:bolder;" class="w2tb_th">
    				dataType=&quot;euro&quot;&amp;nbsp;
    				<br></br>
    				euroMask=&quot;#.###,##&quot;
    				<w2:attributes>
    					<w2:scope>row</w2:scope>
    				</w2:attributes>
    			</xf:group>
    			<xf:group tagname="td" style="padding: 10px;" class="w2tb_td">
    				<xf:input euroMask="#.###,##" dataType="euro" adjustMaxLength="false"
    					style="width:100%;height:40px;padding: 10px;font-size:20px;font-style:normal;font-weight:bolder;color: red" applyFormat="all"
    					id="input1">
    				</xf:input>
    			</xf:group>
    		</xf:group>
    		<xf:group tagname="tr" style="">
    			<xf:group tagname="th" style="font-size: 15px;font-weight:bolder;" class="w2tb_th">
    				dataType=&quot;rupee&quot;&amp;nbsp;
    				<br></br>
    				rupeeMask=&quot;##,##,###.##&quot;
    				<w2:attributes>
    					<w2:scope>row</w2:scope>
    				</w2:attributes>
    			</xf:group>
    			<xf:group tagname="td" style="padding: 10px;" class="w2tb_td">
    				<xf:input rupeeMask="##,##,###.##" dataType="rupee" adjustMaxLength="false"
    					style="width:100%;height:40px;padding: 10px;font-size:20px;font-style:normal;font-weight:bolder;color: red;" applyFormat="all"
    					id="input3">
    				</xf:input>
    			</xf:group>
    		</xf:group>
    		<xf:group tagname="tr" style="">
    			<xf:group tagname="th" style="font-size: 15px;font-weight:bolder;" class="w2tb_th">
    				dataType=&quot;tenge&quot;&amp;nbsp;
    				<br></br>
    				tengeMask=&quot;#&amp;nbsp;###.00&quot;
    				<w2:attributes>
    					<w2:scope>row</w2:scope>
    				</w2:attributes>
    			</xf:group>
    			<xf:group tagname="td" style="padding: 10px;" class="w2tb_td">
    				<xf:input dataType="tenge" adjustMaxLength="false" disabled=""
    					style="width:100%;height:40px;padding: 10px;font-size:20px;font-style:normal;font-weight:bolder;color: red;" tengeMask="# ###.00"
    					applyFormat="all" id="input5">
    				</xf:input>
    			</xf:group>
    		</xf:group>
    	</xf:group>
    </xf:group></body>
</html>
