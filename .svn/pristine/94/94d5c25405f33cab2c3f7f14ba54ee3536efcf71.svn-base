<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare"
	xmlns:xf="http://www.w3.org/2002/xforms">
	<head meta_author="InswaveSystems" meta_type="메인" meta_screenName="[DataList] 전체 데이터 반환받기">
		<w2:historyInfo>
			<w2:history meta_no="01" meta_desc="최초작성" meta_date="20230621" meta_user="InswaveSystems"></w2:history>
			<w2:history meta_no="02" meta_desc="설명부 수정" meta_date="20240621" meta_user="InswaveSystems"></w2:history>
			<w2:history meta_no="03" meta_desc="예제에서 사용하는 DataList가 변경되고, 이에 따른 GridView의 설정과 스크립트가 수정되었습니다." meta_date="20240712" meta_user="InswaveSystems"></w2:history>
		</w2:historyInfo>
		<w2:type>COMPONENT</w2:type>
		<w2:buildDate />
		<w2:MSA />
		<xf:model>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" repeatNode="map" id="dlt_exam" saveRemovedData="true">
					<w2:columnInfo>
						<w2:column dataType="text" name="A" id="col_a"></w2:column>
						<w2:column dataType="text" name="B" id="col_b"></w2:column>
					</w2:columnInfo>
					<w2:data use="true">
						<w2:row>
							<col_a><![CDATA[A1]]></col_a>
							<col_b><![CDATA[B1]]></col_b>
						</w2:row>
						<w2:row>
							<col_a><![CDATA[A2]]></col_a>
							<col_b><![CDATA[B2]]></col_b>
						</w2:row>
					</w2:data>
				</w2:dataList>
			</w2:dataCollection>
			<w2:workflowCollection />
		</xf:model>
		<w2:layoutInfo />
		<w2:publicInfo method="" />
		<script lazy="false" type="text/javascript"><![CDATA[
scwin.onpageload = function () {
    
};

/**
 * 버튼 [전체 데이터 받기 - JSON 형식] 클릭 시
 */
scwin.btn_exam1_1_onclick = function (e) {
    // DataList 'dlt_exam'의 전체 데이터를 JSON 형식으로 반환받습니다.
    let result = dlt_exam.getAllJSON();
    // return 예시) [{"label":"공정하다는 착각","price":"18000","rowStatus":"R"},{"label":"무엇이 옳은가","price":"17800","rowStatus":"R"}]

    // 로그 출력
    let strLog = '# 전체 데이터 받기 - JSON 형식 | 메소드 getAllJSON 호출 값';
    $c.frame.printExampleLog(strLog, txa_log, false);
    $c.frame.printExampleLog(JSON.stringify(result), txa_log, false);
    console.log(strLog);
    console.log(result)
};

/**
 * 버튼 [전체 데이터 받기 - JSON 형식 - rowStatus 제외] 클릭 시
 */
scwin.btn_exam1_5_onclick = function (e) {
    // DataList 'dlt_exam'의 전체 데이터를 'rowStatus'를 제외하고 JSON 형식으로 반환받습니다.
    let result = dlt_exam.getAllJSON({ rowStatusData: false });
    // return 예시) [{"label":"공정하다는 착각","price":"18000"},{"label":"무엇이 옳은가","price":"17800"}]

    // 로그 출력
    let strLog = '# 전체 데이터 받기 - JSON 형식 - rowStatus 제외 | 메소드 getAllJSON({ rowStatusData: false }) 호출 값';
    $c.frame.printExampleLog(strLog, txa_log, false);
    $c.frame.printExampleLog(JSON.stringify(result), txa_log, false);
    console.log(strLog);
    console.log(result)
};

/**
 * 버튼 [전체 데이터 받기 - 1차원 Array 형식 + 컬럼 정보] 클릭 시
 */
scwin.btn_exam1_2_onclick = function (e) {
    // DataList 'dlt_exam'의 전체 데이터를 '1차원 Array 형식 + 컬럼 정보'으로 반환받습니다.
    let result = dlt_exam.getAllArray();
    // return 예시) {"columnInfo":["label","price"],"data":["공정하다는 착각","18000","무엇이 옳은가","17800"]}

    // 로그 출력
    let strLog = '# 전체 데이터 받기 - 1차원 Array 형식 + 컬럼 정보 | 메소드 getAllArray 호출 값';
    $c.frame.printExampleLog(strLog, txa_log, false);
    $c.frame.printExampleLog(JSON.stringify(result), txa_log, false);
    console.log(strLog);
    console.log(result)
};

/**
 * 버튼 [전체 데이터 받기 - 1차원 Array 형식] 클릭 시
 */
scwin.btn_exam1_3_onclick = function (e) {
    // DataList 'dlt_exam'의 전체 데이터를 '1차원 Array 형식'으로 반환받습니다.
    let result = dlt_exam.getAllData();
    // return 예시) ["공정하다는 착각","18000","무엇이 옳은가","17800"]

    // 로그 출력
    let strLog = '# 전체 데이터 받기 - 1차원 Array 형식 | 메소드 getAllData 호출 값';
    $c.frame.printExampleLog(strLog, txa_log, false);
    $c.frame.printExampleLog(JSON.stringify(result), txa_log, false);
    console.log(strLog);
    console.log(result)
};

/**
 * 버튼 [전체 데이터 받기 - XML 형식] 클릭 시
 */
scwin.btn_exam1_4_onclick = function (e) {
    // DataList 'dlt_exam'의 전체 데이터를 XML 형식으로 반환받습니다.
    let result = dlt_exam.getAllXML();
    // return 예시) <list id="dlt_exam"><map index="0"><label>공정하다는 착각</label><price>18000</price><rowStatus statusValue="0">R</rowStatus></map><map index="1"><label>무엇이 옳은가</label><price>17800</price><rowStatus statusValue="0">R</rowStatus></map></list>

    // 로그 출력
    let strLog = '# 전체 데이터 받기 - XML 형식 | 메소드 getAllXML 호출 값';
    $c.frame.printExampleLog(strLog, txa_log, false);
    $c.frame.printExampleLog(WebSquare.xml.serialize(result), txa_log, false);
    console.log(strLog);
    console.log(result)

};

/**
 * textarea의 로그 삭제
 */
scwin.btn_clearLog_onclick = function (e) {
    //textarea value를 빈문자열로 할당.
    txa_log.setValue("");
};

]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:group class="sub_contents" id="" style="">
			<xf:group class="ws_example_grp_desc" id="" style="">
				<w2:textbox escape="false" id="" label="DataList의 메소드를 사용하여 데이터의 타입별로 전체 데이터를 반환받는 예제입니다." style="">
				</w2:textbox>
			</xf:group>
			<xf:group class="example_div_tb_style_wrap mb_def" id="">
				<xf:group class="example_div_tr_style" id="" style="">
					<xf:group class="example_div_td_style no_padding" id="" style="">
						<xf:group class="mb_def_box nobottom" id="" style="">
							<xf:trigger class="btn_exam_exec btn_txt_of" escape="false" ev:onclick="scwin.btn_exam1_1_onclick" id="btn_exam1_1"
								style="" type="button">
								<xf:label><![CDATA[전체 데이터 받기 - JSON 형식]]></xf:label>
							</xf:trigger>
							<xf:trigger class="btn_exam_exec btn_txt_of" escape="false" id="btn_exam1_5" style="" type="button"
								ev:onclick="scwin.btn_exam1_5_onclick">
								<xf:label><![CDATA[전체 데이터 받기 - JSON 형식 - rowStatus 제외]]></xf:label>
							</xf:trigger>
							<xf:trigger class="btn_exam_exec btn_txt_of" escape="false" ev:onclick="scwin.btn_exam1_2_onclick" id="btn_exam1_2"
								style="" type="button">
								<xf:label><![CDATA[전체 데이터 받기 - 1차원 Array 형식 + 컬럼 정보]]></xf:label>
							</xf:trigger>
							<xf:trigger class="btn_exam_exec btn_txt_of" escape="false" ev:onclick="scwin.btn_exam1_3_onclick" id="btn_exam1_3"
								style="" type="button">
								<xf:label><![CDATA[전체 데이터 받기 - 1차원 Array 형식]]></xf:label>
							</xf:trigger>
							<xf:trigger class="btn_exam_exec btn_txt_of" escape="false" ev:onclick="scwin.btn_exam1_4_onclick" id="btn_exam1_4"
								style="" type="button">
								<xf:label><![CDATA[전체 데이터 받기 - XML 형식]]></xf:label>
							</xf:trigger>
						</xf:group>
						<w2:textbox class="wre_txt_normal" escape="false" id="" label="아래의 GridView는 DataList의 데이터 구조를 확인하기 위해 구성되었습니다." style="">
						</w2:textbox>
						<xf:group id="" class="gvwbox" style="max-width: 260px;">
							<w2:gridView dataList="data:dlt_exam" style="height:60px;" autoFit="allColumn" id="" visibleRowNum="all" class="gvw"
								defaultCellHeight="37">
								<w2:caption style="" id="caption1" value="this is a grid caption."></w2:caption>
								<w2:header style="" id="header1">
									<w2:row style="" id="row1">
										<w2:column width="70" inputType="text" style="" id="column2" value="A" displayMode="label"></w2:column>
										<w2:column width="70" inputType="text" style="" id="column1" value="B" displayMode="label"></w2:column>
									</w2:row>
								</w2:header>
								<w2:gBody style="" id="gBody1">
									<w2:row style="" id="row2">
										<w2:column width="70" inputType="text" style="" id="col_a" value="" displayMode="label"></w2:column>
										<w2:column width="70" inputType="text" style="" id="col_b" value="" displayMode="label"></w2:column>
									</w2:row>
								</w2:gBody>
							</w2:gridView>
						</xf:group>
					</xf:group>
				</xf:group>
			</xf:group>
			<xf:group class="example_div_tb_style_wrap" id="">
				<xf:group class="example_div_tr_style" id="" style="">
					<xf:group id="" class="example_div_th_style">
						<w2:span label="로그 확인" style="" id="" class="mr_def txt_blue"></w2:span>
						<xf:trigger class="wre_btn_log_clear" ev:onclick="scwin.btn_clearLog_onclick" id="btn_clearLog" style="" title="로그 삭제"
							type="button">
							<xf:label><![CDATA[로그 삭제]]></xf:label>
						</xf:trigger>
					</xf:group>
					<xf:group class="example_div_td_style" id="" style="">
						<xf:textarea class="wre_txa_log" id="txa_log" spellcheck="false" style="width: 100%;height: 140px;"></xf:textarea>
					</xf:group>
				</xf:group>
			</xf:group>
		</xf:group>
	</body>
</html>