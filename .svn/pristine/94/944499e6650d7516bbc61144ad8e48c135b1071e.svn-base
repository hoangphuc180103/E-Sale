<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare"
	xmlns:xf="http://www.w3.org/2002/xforms">
	<head meta_author="InswaveSystems" meta_type="메인" meta_screenName="[GridView] 보여질 행의 개수(visibleRowNum)를 기반으로 GridView 높이 설정하기">
		<w2:historyInfo>
			<w2:history meta_no="01" meta_desc="최초작성" meta_date="20230203" meta_user="InswaveSystems"></w2:history>
			<w2:history meta_no="02" meta_desc="설명부 수정" meta_date="20240621" meta_user="InswaveSystems" ></w2:history>
			<w2:history meta_no="03" meta_desc="예제에서 사용하는 DataList가 변경되고, 이에 따른 GridVeiw의 설정이 수정되었습니다." meta_date="20240705" meta_user="InswaveSystems"></w2:history>
		</w2:historyInfo>
		<w2:type>COMPONENT</w2:type>
		<w2:buildDate />
		<w2:MSA />
		<xf:model>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" repeatNode="map" id="dlt_exam_1" saveRemovedData="true">
					<w2:columnInfo>
						<w2:column dataType="text" name="A" id="col_a"></w2:column>
						<w2:column dataType="text" name="B" id="col_b"></w2:column>
						<w2:column dataType="text" name="C" id="col_c"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
				<w2:dataList baseNode="list" repeatNode="map" id="dlt_exam_2" saveRemovedData="true">
					<w2:columnInfo>
						<w2:column dataType="text" name="A" id="col_a"></w2:column>
						<w2:column dataType="text" name="B" id="col_b"></w2:column>
						<w2:column dataType="text" name="C" id="col_c"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
			<w2:workflowCollection />
		</xf:model>
		<w2:layoutInfo />
		<w2:publicInfo method="" />
		<script lazy="false" type="text/javascript"><![CDATA[
scwin.onpageload = function () {

};

/**
 * 데이터 반환
 */
scwin.getData = function () {
    return [
        { "col_a": "A1", "col_b": "B1", "col_c": "C1" },
        { "col_a": "A2", "col_b": "B2", "col_c": "C2" },
        { "col_a": "A3", "col_b": "B3", "col_c": "C3" },
        { "col_a": "A4", "col_b": "B4", "col_c": "C4" },
        { "col_a": "A5", "col_b": "B5", "col_c": "C5" }
    ];
};

/**
 * 버튼 [GridView에 Data 할당하기] 클릭 시
 */
scwin.btn_ex1_onclick = function (e) {
    dlt_exam_1.setJSON(scwin.getData());
};

/**
 * 버튼 [GridView에 Data 할당하기] 클릭 시
 */
scwin.btn_ex2_onclick = function (e) {
    dlt_exam_2.setJSON(scwin.getData());
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:group class="sub_contents" id="" style="">
			<xf:group class="ws_example_grp_desc" id="" style="">
				<w2:textbox escape="false" id=""
					label="GridView의 'visibleRowNumFix' 속성을 사용하여, 초기 높이를 'visibleRowNum' 속성에 설정된 행의 개수를 바탕으로 설정한 예제입니다." style="">
				</w2:textbox>
				<w2:textbox escape="false" id="" label="각 GridView에 설정된 높이는 70px입니다. 높이를 확인하기 위해 배경색이 설정되어 있습니다." style="">
				</w2:textbox>
			</xf:group>
			<xf:group class="example_div_tb_style_wrap" id="">
				<xf:group class="example_div_tr_style" id="" style="">
					<w2:textbox class="example_div_th_style" escape="false" id="" label="visibleRowNum 속성에 설정한 행의 수 만큼 초기 높이 설정하기" style=""></w2:textbox>
					<xf:group class="example_div_td_style" id="" style="">
						<xf:group class="mb_def_box nobottom" id="" style="">
							<xf:trigger class="btn_exam_exec btn_txt_of" disabled="" escape="false" ev:onclick="scwin.btn_ex1_onclick" id="btn_ex1"
								style="" type="button">
								<xf:label><![CDATA[GridView에 Data 할당하기1]]></xf:label>
							</xf:trigger>
						</xf:group>
						<xf:group id="" class="gvwbox">
							<w2:gridView rowNumWidth="40" keepDefaultColumnWidth="true" rowNumVisible="true" visibleRowNumFix="true" dataList="data:dlt_exam_1"
								readOnly="true" style="height:70px;background-color: #eee;" autoFit="allColumn" id="" visibleRowNum="3" class="gvw"
								defaultCellHeight="37" autoFitMinWidth="240">
								<w2:caption style="" id="caption1" value="this is a grid caption."></w2:caption>
								<w2:header style="" id="header1">
									<w2:row style="" id="row1">
										<w2:column width="70" inputType="text" style="" id="column3" value="A" displayMode="label"></w2:column>
										<w2:column width="70" inputType="text" style="" id="column2" value="B" displayMode="label"></w2:column>
										<w2:column width="70" inputType="text" style="" id="column1" value="C" displayMode="label"></w2:column>
									</w2:row>
								</w2:header>
								<w2:gBody style="" id="gBody1">
									<w2:row style="" id="row2">
										<w2:column width="70" inputType="text" style="" id="col_a" value="" displayMode="label"></w2:column>
										<w2:column width="70" inputType="text" style="" id="col_b" value="" displayMode="label"></w2:column>
										<w2:column width="70" inputType="text" style="" id="col_c" value="" displayMode="label"></w2:column>
									</w2:row>
								</w2:gBody>
							</w2:gridView>
						</xf:group>
					</xf:group>
				</xf:group>
				<xf:group class="example_div_tr_style" id="" style="">
					<w2:textbox class="example_div_th_style" escape="false" id="" label="(기본 설정) visibleRowNumFix 속성 사용 안함" style=""></w2:textbox>
					<xf:group class="example_div_td_style" id="" style="">
						<xf:group class="mb_def_box nobottom" id="" style="">
							<xf:trigger class="btn_exam_exec btn_txt_of" disabled="" escape="false" ev:onclick="scwin.btn_ex2_onclick" id="btn_ex2"
								style="" type="button">
								<xf:label><![CDATA[GridView에 Data 할당하기2]]></xf:label>
							</xf:trigger>
						</xf:group>
						<xf:group id="" class="gvwbox">
							<w2:gridView rowNumWidth="40" keepDefaultColumnWidth="true" rowNumVisible="true" visibleRowNumFix="false" dataList="data:dlt_exam_2"
								style="height:70px;background-color: #eee;" readOnly="true" autoFit="allColumn" id="" visibleRowNum="3" class="gvw"
								defaultCellHeight="37" autoFitMinWidth="240">
								<w2:caption style="" id="caption1" value="this is a grid caption."></w2:caption>
								<w2:header style="" id="header1">
									<w2:row style="" id="row1">
										<w2:column width="70" inputType="text" style="" id="column3" value="A" displayMode="label"></w2:column>
										<w2:column width="70" inputType="text" style="" id="column2" value="B" displayMode="label"></w2:column>
										<w2:column width="70" inputType="text" style="" id="column1" value="C" displayMode="label"></w2:column>
									</w2:row>
								</w2:header>
								<w2:gBody style="" id="gBody1">
									<w2:row style="" id="row2">
										<w2:column width="70" inputType="text" style="" id="col_a" value="" displayMode="label"></w2:column>
										<w2:column width="70" inputType="text" style="" id="col_b" value="" displayMode="label"></w2:column>
										<w2:column width="70" inputType="text" style="" id="col_c" value="" displayMode="label"></w2:column>
									</w2:row>
								</w2:gBody>
							</w2:gridView>
						</xf:group>
					</xf:group>
				</xf:group>
			</xf:group>
		</xf:group>
	</body>
</html>