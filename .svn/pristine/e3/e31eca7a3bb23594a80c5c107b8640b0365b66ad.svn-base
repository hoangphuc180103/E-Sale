<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
         <script type="text/javascript" lazy="false"><![CDATA[scwin.count = 0;

scwin.onpageload = function () {
    requires("uiplugin.popup");
};

scwin.onpageunload = function () {

};


scwin.trigger1_onclick = function (e) {
    scwin.count++;
    var tmpSrc = scwin.getfolderPath() + "/src.xml";

    var options = {
        id: scwin.count,
        type: "wframePopup",
        width: "350px",
        height: "200px",
        top: "100px",
        left: "300px",
        popupName: "WFrame Popup",
        modal: true,
        resizable: true
    };

    $p.openPopup(tmpSrc, options);
};

scwin.getfolderPath = function () {

    var currentPath = window.location.href;
    var folderPath;

    if (currentPath.includes("mainContainer")) {
        console.log("true  ===> " + $p.getFrameId());
        const cmtFrame = $p.getComponentById($p.getFrameId());
        currentPath = cmtFrame.getSrc();
        folderPath = currentPath.substring(0, currentPath.lastIndexOf('/'));
    } else {
        console.log("false  ===> ");
        folderPath = currentPath.split('w2xPath=')[1].substring(0, currentPath.split('w2xPath=')[1].lastIndexOf('/'));
    }
    return folderPath;
};
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload" ev:onpageunload="scwin.onpageunload">
    <xf:group id="" style="margin: 10px;">
    	<w2:textbox tagname="h1" style="color: blue;margin-bottom: 10px;" tabIndex="h1" id="textbox1" label="イベント - onpageload &amp; onbeforepageunload"
    		escape="false">
    	</w2:textbox>
    	<w2:textbox tagname="h2" style="height: 23px;margin-bottom: 10px;color: blue;" id="textbox2" label="サンプルの使い方"></w2:textbox>
    	<w2:textbox style="color: blue;margin-bottom: 30px;" id="textbox3"
    		label="1. 下部のボタンをクリックします。 &lt;br/&gt;2. ポップアップが生成され、ポップアップ画面がロードされると onpageload イベントが発生することを確認。 &lt;br/&gt;3. ポップアップの閉じるボタンをクリックします。 &lt;br/&gt;4. ポップアップが閉じる前にonbeforepageunload イベントが発生することを確認してください。 &lt;br/&gt;（各イベントハンドラの詳細スクリプトは src.xml ファイルにあります。）" escape="false">
    	</w2:textbox>
    	<w2:textbox style="padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightgreen;border:none;margin-bottom: 10px;" id="textbox5" label="イベント説明&lt;br/&gt;onpageload - 画面が読み込まれると発生します。&lt;br/&gt;onbeforepageunload - ページが閉じる前に発生します。" escape="false">
    	</w2:textbox>
    	<xf:trigger ev:onclick="scwin.trigger1_onclick"
    		style="height:42px;line-height:32px;padding:5px;background-color:coral;font-size:15px;weight: bolder;font-weight:bolder;text-align: left;display: block;margin-bottom: 10px;"
    		id="trigger1" type="button">
    		<xf:label><![CDATA[openPopup()]]></xf:label>
    	</xf:trigger>
    </xf:group></body>
</html>
