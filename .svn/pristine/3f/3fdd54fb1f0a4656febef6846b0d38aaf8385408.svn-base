	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:group class="sub_contents">
			<xf:group class="ws_example_grp_desc">
				<w2:textbox escape="false"
					label="TabControl의 'addTab' 메소드를 사용하여 탭을 추가할 때, 두 번째 인자 JSON 객체의 'openAction' 속성 설정 값에 따른 동작을 비교한 예제입니다."
					style="">
				</w2:textbox>
			</xf:group>
			<xf:group class="example_div_tb_style_wrap">
				<xf:group class="example_div_tr_style">
					<w2:textbox class="example_div_th_style" escape="false" label="'openAction' 설정 값 : select"></w2:textbox>
					<xf:group class="example_div_td_style">
						<xf:group class="mb_def_box nobottom">
							<xf:trigger class="btn_exam_exec btn_txt_of" ev:onclick="scwin.btn_exam1_1_onclick" id="btn_exam1_1" type="button">
								<xf:label><![CDATA[탭 'TAB1'과 동일한 ID로 탭을 추가하는 경우 1-1]]></xf:label>
							</xf:trigger>
							<xf:trigger class="btn_exam_exec btn_txt_of" ev:onclick="scwin.btn_exam1_2_onclick" id="btn_exam1_2" type="button">
								<xf:label><![CDATA[동일한 ID의 탭이 없는 경우 1-2]]></xf:label>
							</xf:trigger>
						</xf:group>
						<xf:group class="mb_def_box nobottom">
						<xf:group id="" class="tbcbox"><w2:tabControl confirmTrueAction="exist" confirmFalseAction="new" useTabKeyOnly="true" useMoveNextTabFocus="false" useConfirmMessage="false" alwaysDraw="false" style="position: relative;height: 120px;min-width: 340px;" id="tac_exam1" class="tbc">
								<w2:tabs disabled="false" style="width:70px;" id="tac_exam1_1" label="TAB1"></w2:tabs>
								<w2:tabs disabled="false" style="width:70px;" id="tac_exam1_2" label="TAB2"></w2:tabs>
								<w2:content src="/page/P00313S01.xml" scope="true" alwaysDraw="false" style="min-height:30px" frameMode="wframe" id="content1_1">
								</w2:content>
								<w2:content src="/page/P00313S02.xml" scope="true" alwaysDraw="false" style="min-height:30px" frameMode="wframePreload" id="content1_2">
								</w2:content>
							</w2:tabControl></xf:group></xf:group>
						<xf:group class="mb_def_box nobottom">
							<w2:span class="mr_def txt_bold" label="로그 확인"></w2:span>
							<xf:trigger class="wre_btn_log_clear" ev:onclick="scwin.btn_clearLog_onclick" title="로그 삭제" type="button"
								userData1="txa_log_1">
								<xf:label><![CDATA[로그 삭제]]></xf:label>
							</xf:trigger>
						</xf:group>
						<xf:textarea class="wre_txa_log" id="txa_log_1" spellcheck="false" style="width: 100%;height: 60px;"></xf:textarea>
					</xf:group>
				</xf:group>
				<xf:group class="example_div_tr_style">
					<w2:textbox class="example_div_th_style" escape="false" label="'openAction' 설정 값 : exist"></w2:textbox>
					<xf:group class="example_div_td_style">
						<xf:group class="mb_def_box nobottom">
							<xf:trigger class="btn_exam_exec btn_txt_of" ev:onclick="scwin.btn_exam2_1_onclick" id="btn_exam2_1" type="button">
								<xf:label><![CDATA[탭 'TAB1'과 동일한 ID로 탭을 추가하는 경우 2-1]]></xf:label>
							</xf:trigger>
							<xf:trigger class="btn_exam_exec btn_txt_of" ev:onclick="scwin.btn_exam2_2_onclick" id="btn_exam2_2" type="button">
								<xf:label><![CDATA[동일한 ID의 탭이 없는 경우 2-2]]></xf:label>
							</xf:trigger>
						</xf:group>
						<xf:group class="mb_def_box nobottom">
						<xf:group id="" class="tbcbox"><w2:tabControl confirmTrueAction="exist" confirmFalseAction="new" useTabKeyOnly="true" useMoveNextTabFocus="false" useConfirmMessage="false" alwaysDraw="false" style="position: relative;height: 120px;min-width: 340px;" id="tac_exam2" class="tbc">
								<w2:tabs disabled="false" style="width:70px;" id="tac_exam2_1" label="TAB1"></w2:tabs>
								<w2:tabs disabled="false" style="width:70px;" id="tac_exam2_2" label="TAB2"></w2:tabs>
								<w2:content src="/page/P00313S01.xml" scope="true" alwaysDraw="false" style="min-height:30px" frameMode="wframe" id="content2_1">
								</w2:content>
								<w2:content src="/page/P00313S02.xml" scope="true" alwaysDraw="false" style="min-height:30px" frameMode="wframe" id="content2_2">
								</w2:content>
							</w2:tabControl></xf:group></xf:group>
						<xf:group class="mb_def_box nobottom">
							<w2:span class="mr_def txt_bold" label="로그 확인"></w2:span>
							<xf:trigger class="wre_btn_log_clear" ev:onclick="scwin.btn_clearLog_onclick" title="로그 삭제" type="button"
								userData1="txa_log_2">
