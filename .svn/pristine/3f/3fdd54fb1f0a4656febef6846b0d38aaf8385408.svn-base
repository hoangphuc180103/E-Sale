	<head meta_author="InswaveSystems" meta_type="메인" meta_screenName="[TabControl] 탭 추가하기 - 탭 옵션 'openAction' 설정 비교하기" >
		<w2:historyInfo>
			<w2:history meta_no="01" meta_desc="최초작성" meta_date="20230801" meta_user="InswaveSystems"></w2:history>
			<w2:history meta_no="02" meta_desc="설명부 수정" meta_date="20240621" meta_user="InswaveSystems" ></w2:history>
