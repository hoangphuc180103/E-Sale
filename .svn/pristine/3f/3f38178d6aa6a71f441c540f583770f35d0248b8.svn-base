// 나이 계산
scwin.koreanAgeFormatter = function (rowJson, rowIndex, colIndex) {
  var birthDate = String(rowJson.birthDate);
  if (!birthDate || birthDate.length < 8) {
    return "";
  }
  var year = parseInt(birthDate.substring(0, 4));
  var currentDate = $p.getCurrentServerDate();
  var currentYear = parseInt(currentDate.substring(0, 4));

  // 나이 = 현재 연도 - 출생 연도 + 1
  var koreanAge = currentYear - year + 1;
  return koreanAge;
};

// 만나이 계산
scwin.ageFormatter = function (rowJson, rowIndex, colIndex) {
  var birthDate = rowJson.birthDate;
  var year = parseInt(birthDate.substring(0, 4));
  var month = birthDate.substring(4, 6);
  var day = birthDate.substring(6, 8);
  var fullYear = year;
  var birthMonthDay = month + day;
  var currentDate = $p.getCurrentServerDate();
  var currentYear = parseInt(currentDate.substring(0, 4));
  var currentMonthDay = currentDate.substring(4, 8);
  var age;

  // 올해 생일이 지났는지 확인  
  if (currentMonthDay >= birthMonthDay) {
    age = currentYear - fullYear;
  } else {
    age = currentYear - fullYear - 1;
  }
  return age;
};
}}}]}]},{T:1,N:'body',A:{'ev:onpageload':'scwin.onpageload'},E:[{T:1,N:'xf:group',A:{class:'sub_contents',id:'',style:''},E:[{T:1,N:'xf:group',A:{class:'ws_example_grp_desc',id:'',style:''},E:[{T:1,N:'w2:textbox',A:{escape:'false',id:'',label:'DataList의 컬럼 속성 \'importFormatter\'를 사용한 예제입니다.<br/>\'importFormatter\' 함수를 지정하여 \'나이\'와 \'만나이\'를 구하였습니다.',style:''}}]},{T:1,N:'xf:group',A:{class:'example_div_tb_style_wrap mb_def',id:'',style:''},E:[{T:1,N:'xf:group',A:{class:'example_div_tr_style',id:'',style:''},E:[{T:1,N:'xf:group',A:{class:'gvwbox',id:'',style:''},E:[{T:1,N:'w2:gridView',A:{scrollByColumnAdaptive:'false',rowNumVisible:'false',scrollByColumn:'false',defaultCellHeight:'26',checkReadOnlyOnPasteEnable:'',focusMode:'row',dataList:'data:dlt_userInfo',style:'height: 150px;',autoFit:'allColumn',id:'gridView1',visibleRowNum:'10',class:'',touchScrollDelta:'1',readOnly:'true'},E:[{T:1,N:'w2:caption',A:{style:'',id:'caption1',value:'this is a grid caption.'}},{T:1,N:'w2:header',A:{style:'',id:'header1'},E:[{T:1,N:'w2:row',A:{style:'',id:'row1'},E:[{T:1,N:'w2:column',A:{width:'70',inputType:'text',style:'',id:'column5',value:'이름',displayMode:'label'}},{T:1,N:'w2:column',A:{width:'70',inputType:'text',style:'',id:'column4',value:'성별',displayMode:'label'}},{T:1,N:'w2:column',A:{width:'95',inputType:'text',style:'',id:'column3',value:'생년월일',displayMode:'label'}},{T:1,N:'w2:column',A:{width:'70',inputType:'text',style:'',id:'column2',value:'나이',displayMode:'label'}},{T:1,N:'w2:column',A:{width:'70',inputType:'text',style:'',id:'column1',value:'만나이',displayMode:'label'}}]}]},{T:1,N:'w2:gBody',A:{style:'',id:'gBody1'},E:[{T:1,N:'w2:row',A:{style:'',id:'row2'},E:[{T:1,N:'w2:column',A:{width:'70',inputType:'text',style:'',id:'name',value:'',displayMode:'label'}},{T:1,N:'w2:column',A:{width:'70',inputType:'text',style:'',id:'gender',value:'',displayMode:'label'}},{T:1,N:'w2:column',A:{width:'95',inputType:'calendar',style:'',id:'birthDate',value:'',displayMode:'label'}},{T:1,