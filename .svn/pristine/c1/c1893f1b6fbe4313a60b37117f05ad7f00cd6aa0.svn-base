/**
 * 버튼 [팝업 열기] 클릭시
 */
scwin.btn_ex1_onclick = function (e) {
    var jsnOptions;
    var strPopID = "popup_P00157P02";

    //중복 팝업 제어
    if ($p.getPopupWindow(strPopID)) {
        return;
    }

    jsnOptions = {
        id: strPopID,
        type: "wframePopup",
        modal: "modal",
        frameModal: "",
        width: "220px",
        height: "180px",
        popupName: "popup1-1",
        left: "60px",
        top: "60px"
    };

    //팝업 열기
    $p.openPopup("/page/P00157P02.xml", jsnOptions);
};]]></script>
