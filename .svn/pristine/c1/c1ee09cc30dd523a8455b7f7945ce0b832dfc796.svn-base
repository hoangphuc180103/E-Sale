<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
         <script type="text/javascript" lazy="false"><![CDATA[
        
	scwin.onpageload = function() {
		
	};
	
	scwin.onpageunload = function() {
		
	};
	
	]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload" ev:onpageunload="scwin.onpageunload">
    <xf:group id="" style="margin:10px;">
    	<w2:textbox style="color: blue;margin-bottom: 10px;" id="textbox1" label="숫자 및 알파벳 마스킹" escape="false" tagname="h1" tabIndex="h1">
    	</w2:textbox>
    	<w2:textbox tagname="h2" style="height: 23px;margin-bottom: 10px;color: blue;" id="textbox4" label="샘플 사용 방법"></w2:textbox>
    	<w2:textbox style="color: blue;margin-bottom: 30px;" id="textbox3" label="숫자 혹은 알파벳을 입력하고 마스킹이 적용되는 것을 확인." escape="false">
    	</w2:textbox>
    	<w2:textbox
    		style="padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightblue;border:none;margin-bottom: 20px;"
    		id="textbox2" label='속성 설정&lt;br/&gt;displayFormat="#-##-###" &lt;br/&gt;allowChar="0-9, aA-zZ"&lt;br/&gt;maskFormat="default"' escape="false">
    	</w2:textbox>
    	<xf:input dataType="" maskFormat="default" adjustMaxLength="" applyFormat="all"
    		style="width: 300px;text-align: right;height:50px;padding: 5px;font-size:30px;font-style:normal;font-weight:bolder;color: red;"
    		allowChar="0-9, aA-zZ" id="input1" displayFormat="#-##-###">
    	</xf:input>
    </xf:group></body>
</html>
