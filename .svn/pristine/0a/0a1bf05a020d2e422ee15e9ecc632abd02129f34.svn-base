<span class="digits_10 code_line"></span>                                &lt;w2:column <span class="r_h_attribute_name_span">width</span>=<span class="r_h_attribute_value_span">"70"</span> <span class="r_h_attribute_name_span">style</span>=<span class="r_h_attribute_value_span">"height:20px"</span> <span class="r_h_attribute_name_span">inputType</span>=<span class="r_h_attribute_value_span">"text"</span> <span class="r_h_attribute_name_span">id</span>=<span class="r_h_attribute_value_span">"column9"</span> <span class="r_h_attribute_name_span">value</span>=<span class="r_h_attribute_value_span">"tasks"</span> <span class="r_h_attribute_name_span">blockSelect</span>=<span class="r_h_attribute_value_span">"false"</span>&gt;&lt;/w2:column&gt;
<span class="digits_10 code_line"></span>                                &lt;w2:column <span class="r_h_attribute_name_span">width</span>=<span class="r_h_attribute_value_span">"70"</span> <span class="r_h_attribute_name_span">style</span>=<span class="r_h_attribute_value_span">"height:20px"</span> <span class="r_h_attribute_name_span">inputType</span>=<span class="r_h_attribute_value_span">"text"</span> <span class="r_h_attribute_name_span">id</span>=<span class="r_h_attribute_value_span">"column7"</span> <span class="r_h_attribute_name_span">value</span>=<span class="r_h_attribute_value_span">"startDate"</span><span class="r_h_attribute_name_span">
