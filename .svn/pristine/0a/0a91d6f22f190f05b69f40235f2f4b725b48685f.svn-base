<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare"
	xmlns:xf="http://www.w3.org/2002/xforms">
	<head meta_author="InswaveSystems" meta_type="메인" meta_screenName="[GridView] 엑셀 다운로드 시 병합된 셀 유지하기">
		<w2:historyInfo>
			<w2:history meta_no="01" meta_desc="최초작성" meta_date="20230303" meta_user="InswaveSystems" ></w2:history>
			<w2:history meta_no="02" meta_desc="설명부 수정" meta_date="20240621" meta_user="InswaveSystems" ></w2:history>
			<w2:history meta_no="03" meta_desc="예제에서 사용하는 DataList가 변경되고, 이에 따른 GridVeiw의 설정이 수정되었습니다." meta_date="20240705" meta_user="InswaveSystems"></w2:history>
		</w2:historyInfo>
		<w2:type>COMPONENT</w2:type>
		<w2:buildDate />
		<w2:MSA />
		<xf:model>
			<w2:dataCollection baseNode="map">
				<w2:dataList id="dlt_exam" saveRemovedData="true" ev:ondataload="scwin.dlt_exam_ondataload">
					<w2:columnInfo>
						<w2:column id="user_pk" name="USER PK" dataType="text"></w2:column>
						<w2:column id="user_name" name="NAME" dataType="text"></w2:column>
						<w2:column id="group_a" name="GROUP A" dataType="text"></w2:column>
						<w2:column id="group_b" name="GROUP B" dataType="text"></w2:column>
					</w2:columnInfo>
					<w2:data use="true">
						<w2:row>
							<user_name><![CDATA[USER 1]]></user_name>
							<user_pk><![CDATA[10000001]]></user_pk>
							<group_a><![CDATA[GROUP A01]]></group_a>
							<group_b><![CDATA[GROUP B01]]></group_b>
						</w2:row>
						<w2:row>
							<user_name><![CDATA[USER 2]]></user_name>
							<user_pk><![CDATA[10000002]]></user_pk>
							<group_a><![CDATA[GROUP A01]]></group_a>
							<group_b><![CDATA[GROUP B01]]></group_b>
						</w2:row>
						<w2:row>
							<user_name><![CDATA[USER 3]]></user_name>
							<user_pk><![CDATA[10000003]]></user_pk>
							<group_a><![CDATA[GROUP A01]]></group_a>
							<group_b><![CDATA[GROUP B01]]></group_b>
						</w2:row>
						<w2:row>
							<user_name><![CDATA[USER 4]]></user_name>
							<user_pk><![CDATA[10000004]]></user_pk>
							<group_a><![CDATA[GROUP A01]]></group_a>
							<group_b><![CDATA[GROUP B02]]></group_b>
						</w2:row>
						<w2:row>
							<user_name><![CDATA[USER 5]]></user_name>
							<user_pk><![CDATA[10000005]]></user_pk>
							<group_a><![CDATA[GROUP A02]]></group_a>
							<group_b><![CDATA[GROUP B01]]></group_b>
						</w2:row>
						<w2:row>
							<user_name><![CDATA[USER 6]]></user_name>
							<user_pk><![CDATA[10000006]]></user_pk>
							<group_a><![CDATA[GROUP A02]]></group_a>
							<group_b><![CDATA[GROUP B02]]></group_b>
						</w2:row>
						<w2:row>
							<user_name><![CDATA[USER 7]]></user_name>
							<user_pk><![CDATA[10000007]]></user_pk>
							<group_a><![CDATA[GROUP A02]]></group_a>
							<group_b><![CDATA[GROUP B02]]></group_b>
						</w2:row>
					</w2:data>
				</w2:dataList>
			</w2:dataCollection>
			<w2:workflowCollection />
		</xf:model>
		<w2:layoutInfo />
		<w2:publicInfo method="" />
		<script lazy="false" type="text/javascript"><![CDATA[
scwin.onpageload = function () {

};

/**
 * 버튼 [엑셀 다운로드 - 기본] 클릭 시
 */
scwin.btn_ex1_onclick = function (e) {
    var jsnOptions;

    jsnOptions = {
        fileName: "EXAMPLE_P00231_TYPE1.xlsx"
    };

    grd_exam1.advancedExcelDownload(jsnOptions);
};

/**
 * 버튼 [엑셀 다운로드 - 병합된 상태 적용] 클릭 시
 */
scwin.btn_ex2_onclick = function (e) {
    var jsnOptions;

    jsnOptions = {
        fileName: "EXAMPLE_P00231_TYPE2.xlsx", //엑셀의 파일명
        colMerge: "true",   //colMerge된 컬럼을 병합 출력
        colMergeValue: "true" //Excel에서 병합을 취소할 경우 셀에 데이터를 채움
    };
    //colMerge : [default: false, true] colMerge된 컬럼을 Merge해서 출력할 지 여부
    //colMergeValue : [default: false, true] colMerge된 컬럼을 Excel에서 병합을 취소할 경우 모든 셀에 데이터를 채우는 기능. (true : 병합 해제된 모든 셀에 데이터를 채움, false :  첫 행이나 첫 열에만 데이터가 표시)

    //GridView "grd_exam1"의 엑셀 다운로드 실행
    grd_exam1.advancedExcelDownload(jsnOptions);
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:group class="sub_contents" id="" style="">
			<xf:group class="ws_example_grp_desc" id="" style="">
				<w2:textbox escape="false" id=""
					label="GridView의 'advancedExcelDownload' 메소드의 첫 번째 인자인 JSON 객체의 'colMerge'와 'colMergeValue'를 사용하여 셀이 병합된 상태로 엑셀 파일이 다운로드되도록 설정한 예제입니다."
					style="">
				</w2:textbox>
			</xf:group>
			<xf:group id="" style="" class="example_div_tb_style_wrap">
				<xf:group class="mb_def_box nobottom" id="" style="">
					<xf:trigger class="btn_exam_exec btn_txt_of" ev:onclick="scwin.btn_ex1_onclick" id="btn_ex1" localeRef=""
						style="min-width: 30px; height: 26px;" type="" useDefaultLabel="true">
						<xf:label><![CDATA[엑셀 다운로드 - 기본]]></xf:label>
					</xf:trigger>
					<xf:trigger class="btn_exam_exec btn_txt_of" ev:onclick="scwin.btn_ex2_onclick" id="btn_ex2" localeRef=""
						style="min-width: 30px; height: 26px;" type="" useDefaultLabel="true">
						<xf:label><![CDATA[엑셀 다운로드 - 병합된 상태 적용]]></xf:label>
					</xf:trigger>
				</xf:group>
			<xf:group id="" class="gvwbox">
				<w2:gridView oddEvenColorDisplay="false" dataList="data:dlt_exam" style="height: 100px;" autoFit="allColumn" id="grd_exam1"
					visibleRowNum="all" class="gvw" defaultCellHeight="37" autoFitMinWidth="280">
					<w2:caption style="" id="caption1" value="this is a grid caption."></w2:caption>
					<w2:header style="" id="header1">
						<w2:row style="" id="row1">
							<w2:column width="80" inputType="text" style="" id="column4" value="USER PK" displayMode="label"></w2:column>
							<w2:column width="70" inputType="text" style="" id="column3" value="NAME" displayMode="label"></w2:column>
							<w2:column width="90" inputType="text" style="" id="column2" value="GROUP A" displayMode="label"></w2:column>
							<w2:column width="90" inputType="text" style="" id="column1" value="GROUP B" displayMode="label"></w2:column>
						</w2:row>
					</w2:header>
					<w2:gBody style="" id="gBody1">
						<w2:row style="" id="row2">
							<w2:column width="80" inputType="text" style="" id="user_pk" value="" displayMode="label"></w2:column>
							<w2:column width="70" inputType="text" style="" id="user_name" value="" displayMode="label"></w2:column>
							<w2:column width="90" inputType="text" style="" id="group_a" value="" displayMode="label" colMerge="true"></w2:column>
							<w2:column width="90" inputType="text" style="" id="group_b" value="" displayMode="label" colMerge="true"></w2:column>
						</w2:row>
					</w2:gBody>
				</w2:gridView></xf:group></xf:group>
		</xf:group>
	</body>
</html>