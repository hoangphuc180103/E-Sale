<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
         <script type="text/javascript" lazy="false"><![CDATA[
scwin.count = 0;
scwin.onpageload = function () {

};

scwin.onpageunload = function () {

};


scwin.trigger1_onclick = function (e) {
    var idx = radio1.getValue();
    var tmpSrc = scwin.getfolderPath() + "/" + idx + ".xml";

    scwin.count++;
    var obj = {
        "title": "test_" + scwin.count,
        "windowID": "window_" + scwin.count,
        "frameMode": "pageFrame",
        "src": tmpSrc
    };
    windowContainer1.createWindow(obj);
    windowContainer1.setArrangeWindows("cascade");
};

scwin.getfolderPath = function () {

    var currentPath = window.location.href;
    var folderPath;

    if (currentPath.includes("mainContainer")) {
        console.log("true  ===> " + $p.getFrameId());
        const cmtFrame = $p.getComponentById($p.getFrameId());
        currentPath = cmtFrame.getSrc();
        folderPath = currentPath.substring(0, currentPath.lastIndexOf('/'));
    } else {
        console.log("false  ===> ");
        folderPath = currentPath.split('w2xPath=')[1].substring(0, currentPath.split('w2xPath=')[1].lastIndexOf('/'));
    }
    return folderPath;
};
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload" ev:onpageunload="scwin.onpageunload">
    <xf:group id="" style="margin: 10px;">
    	<w2:textbox tagname="h1" style="color: blue;margin-bottom: 10px;" tabIndex="h1" id="textbox1" label="브라우저의 History 기능 사용" escape="false"></w2:textbox>
    	<w2:textbox tagname="h2" style="height: 23px;margin-bottom: 10px;color: blue;" id="textbox2" label="샘플 사용 방법"></w2:textbox>
    	<w2:textbox style="color: blue;margin-bottom: 30px;" id="textbox3" label='(예제를 단독으로 실행.)&lt;br/&gt;1. 브라우저에서 새로운 탭을 열고 임의의 웹페이지로 이동. &lt;br/&gt;2. 샘플 파일을 단독으로 실행한 주소를 위의 1 단계 브라우저 탭으로 복사해서 붙여넣기. &lt;br/&gt;3. 위 1 단계의 브라우저 탭으로 복사된 샘플 파일 화면에서 createWindow() 버튼 상단의 파일명을 선택. &lt;br/&gt;4. createWindow() 버튼을 클릭. &lt;br/&gt;5. 위의 방법으로 윈도우 여러 개를 생성. &lt;br/&gt;6. 브라우저의 뒤로 가기 버튼을 클릭. &lt;br/&gt;7. 위 1 단계의 최초 웹 페이지로 이동하는 것을 확인. &lt;br/&gt;8. 브라우저의 앞으로 가기 버튼을 클릭.&lt;br/&gt;9. 여러 개의 윈도우가 생성된 상태의 샘플 화면으로 돌아오는 것을 확인.&lt;br/&gt;(spaReplaceHistory="false" 설정을 적용할 경우, 윈도우가 생성되는 각 단계 별로 화면이 이동.)' escape="false">
    	</w2:textbox>
    	<w2:textbox style="padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightblue;border:none;margin-bottom: 10px;" id="textbox4" label='속성 설정&lt;br/&gt;spaReplaceHistory="true"' escape="false">
    	</w2:textbox>
    	<xf:group id="" style="margin-bottom: 10px;">
    		<xf:select1 id="radio1" selectedIndex="-1" appearance="full" style="width: 150px;height: 21px;margin-bottom: 10px;" cols=""
    			rows="1" ref="">
    			<xf:choices>
    				<xf:item>
    					<xf:label><![CDATA[11.xml]]></xf:label>
    					<xf:value><![CDATA[11]]></xf:value>
    				</xf:item>
    				<xf:item>
    					<xf:label><![CDATA[22.xml]]></xf:label>
    					<xf:value><![CDATA[22]]></xf:value>
    				</xf:item>
    				<xf:item>
    					<xf:label><![CDATA[33.xml]]></xf:label>
    					<xf:value><![CDATA[33]]></xf:value>
    				</xf:item>
    			</xf:choices>
    		</xf:select1>
    		<xf:trigger ev:onclick="scwin.trigger1_onclick"
    			style="height:42px;line-height:32px;padding:5px;background-color:coral;font-size:15px;weight: bolder;font-weight:bolder;text-align: left;display: block"
    			id="trigger1" type="button">
    			<xf:label><![CDATA[createWindow()]]></xf:label>
    		</xf:trigger>
    	</xf:group>
    	<w2:windowContainer sequentialArrangeColNum="2" sequentialArrangeRowNum="2" spaReplaceHistory="true" fixArrangeFullScreen="false"
    		frameMode="iframe" useFixButton="false" windowAutoResize="false" verticalArrangeNum="2" windowMaxNum="10" useCloseButton="false"
    		controlIconPosition="left" windowMaximizeAll="false" stopMinimizeOnNameLayer="false" toolbarPosition="bottom" id="windowContainer1"
    		useStatusMsg="true" hideTitleOnMaximize="false" spaInitCount="10" stopToggleOnLast="false" useNameContainer="false"
    		horizontalArrangeNum="2" useCustomMsg="false" spaAuto="true" useControlIconTitle="false" tooltipDisplay="true"
    		tooltipGroupClass="false" windowTooltipDisplay="true" style="position: relative;height: 400px;border: gray solid 1px;">
    		<w2:windowToolbar>
    			<w2:controlIconLayer>
    				<w2:controlIcon></w2:controlIcon>
    				<w2:controlIcon></w2:controlIcon>
    				<w2:controlIcon></w2:controlIcon>
    				<w2:controlIcon></w2:controlIcon>
    				<w2:controlIcon></w2:controlIcon>
    			</w2:controlIconLayer>
    			<w2:nameLayer></w2:nameLayer>
    			<w2:selectedNameLayer></w2:selectedNameLayer>
    		</w2:windowToolbar>
    	</w2:windowContainer>
    </xf:group></body>
</html>
