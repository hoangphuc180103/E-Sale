// 예제 테스트를 위한 초기화
scwin.initializeExample = function () {
  // DataList 'dlt_exam'에 필터를 적용합니다.
  dlt_exam.setColumnFilter({
    type: 'row',
    colIndex: 'category',
    key: "Servers",
    condition: 'and'
  });
};

/**
 * 버튼 [DataList의 전체 로우 수 반환받기] 클릭 시
 */
scwin.btn_exam1_1_onclick = function (e) {
  // DataList 'dlt_exam'의 전체 로우 수를 반환받습니다.
  let result = dlt_exam.getTotalRow();
  alert("getTotalRow(): " + result);

  // 로그 출력
  console.log('# 메소드 getTotalRow():');
  console.log(result);
};

/**
 * 버튼 [필터가 적용된 DataList의 로우 수 반환받기] 클릭 시 
 */
scwin.btn_exam2_1_onclick = function (e) {
  // DataList 'dlt_exam'에 필터가 적용된 로우 수 반환받기
  let result = dlt_exam.getRowCount();
  alert("getRowCount(): " + result);

  // 로그 출력
  console.log('# 메소드 getRowCount():');
  console.log(result);
};
