define({declaration:{A:{version:'1.0',encoding:'UTF-8'}},E:[{T:1,N:'html',A:{xmlns:'http://www.w3.org/1999/xhtml','xmlns:ev':'http://www.w3.org/2001/xml-events','xmlns:w2':'http://www.inswave.com/websquare','xmlns:xf':'http://www.w3.org/2002/xforms'},E:[{T:1,N:'head',E:[{T:1,N:'w2:type',E:[{T:3,text:'DEFAULT'}]},{T:1,N:'w2:buildDate'},{T:1,N:'xf:model',E:[{T:1,N:'w2:dataCollection',A:{baseNode:'map'},E:[{T:1,N:'w2:dataList',A:{id:'dataList1',baseNode:'list',saveRemovedData:'true',repeatNode:'map'},E:[{T:1,N:'w2:columnInfo',E:[{T:1,N:'w2:column',A:{id:'col1',name:'name1',dataType:'text'}},{T:1,N:'w2:column',A:{id:'col2',name:'name2',dataType:'text'}},{T:1,N:'w2:column',A:{id:'col3',name:'name3',dataType:'text'}}]}]}]},{T:1,N:'w2:workflowCollection'}]},{T:1,N:'script',A:{type:'text/javascript'},E:[{T:4,cdata:function(scopeObj){with(scopeObj){scwin.onpageload = function () {};
scwin.onpageunload = function () {};
var count = 0;
scwin.trigger1_onclick = function (e) {
  count++;
  var tmpSrc = scwin.getfolderPath() + "/source.xml";
  widgetContainer1.addWidgets({
    id: tmpSrc + count,
    title: tmpSrc + count,
    src: tmpSrc,
    scope: true,
    x: 0,
    y: 0,
    unitWidth: 2,
    unitHeight: 2
  });
  widgetContainer2.addWidgets({
    id: tmpSrc + count,
    title: tmpSrc + count,
    src: tmpSrc,
    scope: true,
    x: 0,
    y: 0,
    unitWidth: 2,
    unitHeight: 2
  });
};
scwin.getfolderPath = function () {
  var currentPath = window.location.href;
  var folderPath;
  if (currentPath.includes("mainContainer")) {
    console.log("true  ===> " + $p.getFrameId());
    const cmtFrame = $p.getComponentById($p.getFrameId());
    currentPath = cmtFrame.getSrc();
    folderPath = currentPath.substring(0, currentPath.lastIndexOf('/'));
  } else {
    console.log("false  ===> ");
    folderPath = currentPath.split('w2xPath=')[1].substring(0, currentPath.split('w2xPath=')[1].lastIndexOf('/'));
  }
  return folderPath;
};
}}}]}]},{T:1,N:'body',A:{style:'padding:20px;'},E:[{T:1,N:'xf:group',A:{id:'',style:''},E:[{T:1,N:'w2:textbox',A:{tagname:'h1',style:'color: blue;margin-bottom: 10px;',tabIndex:'h1',id:'textbox1',label:'ウィジェット作成後のサブミッションステータスウィンドウの表示',escape:'false'}},{T:1,N:'w2:textbox',A:{tagname:'h2',style:'height: 23px;margin-bottom: 10px;color: blue;',id:'textbox2',label:'サンプルの使い方'}},{T:1,N:'w2:textbox',A:{style:'color: blue;margin-bottom: 30px;',id:'textbox3',label:'1. 下部の addWidgets() ボタンをクリックします。 <br/>2. ウィジェットが作成されることを確認してください。 <br/><br/>（最初のウィジェットコンテナ）<br/>3-1. ウィジェットソース(src)画面の[Submit ボタン]をクリックします。 <br/>3-2. サブミッションが実行され、ステータスウィンドウがウィジェット内にのみ表示されることを確認してください。 (processMsgFrame="true")<br/><br/>（2番目のウィジェットコンテナ）<br/>4-1. ウィジェットソース(src)画面の[Submit ボタン]をクリックします。 <br/>4-2. サブミッションが実行され、ステータスウィンドウが画面全体に表示されることを確認します。 (processMsgFrame="false")',escape:'false'}},{T:1,N:'xf:trigger',A:{'ev:onclick':'scwin.trigger1_onclick',style:'height:42px;line-height:32px;padding:5px;background-color:coral;font-size:15px;weight: bolder;font-weight:bolder;text-align: left;display: block;margin-bottom: 10px;',id:'trigger1',type:'button'},E:[{T:1,N:'xf:label',E:[{T:4,cdata:'addWidgets()'}]}]},{T:1,N:'w2:textbox',A:{style:'padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightblue;border:none;margin-bottom: 10px;',id:'textbox4',label:'プロパティの設定<br/>processMsgFrame="true"',escape:'false'}},{T:1,N:'w2:widgetContainer',A:{mode:'pushpull',unitHeightPixel:'200',preventMaximizeByTitle:'false',widgetMove:'true',style:'height: 300px;border:1px solid black;margin-bottom: 10px;',id:'widgetContainer1',cols:'3',processMsgFrame:'true','ev:onwidgetmove':'scwin.widgetContainer1_onwidgetmove'}},{T:1,N:'w2:textbox',A:{escape:'false',id:'textbox5',label:'プロパティの設定<br/>processMsgFrame="false"',style:'padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightblue;border:none;margin-bottom: 10px;'}},{T:1,N:'w2:widgetContainer',A:{cols:'3','ev:onwidgetmove':'scwin.widgetContainer1_onwidgetmove',id:'widgetContainer2',mode:'pushpull',preventMaximizeByTitle:'false',style:'height: 300px;border:1px solid black;',unitHeightPixel:'200'}}]}]}]}]})