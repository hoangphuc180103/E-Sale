define({declaration:{A:{version:'1.0',encoding:'UTF-8'}},E:[{T:1,N:'html',A:{xmlns:'http://www.w3.org/1999/xhtml','xmlns:ev':'http://www.w3.org/2001/xml-events','xmlns:w2':'http://www.inswave.com/websquare','xmlns:xf':'http://www.w3.org/2002/xforms'},E:[{T:1,N:'head',E:[{T:1,N:'w2:type',E:[{T:3,text:'DEFAULT'}]},{T:1,N:'w2:buildDate'},{T:1,N:'xf:model',E:[{T:1,N:'w2:dataCollection',A:{baseNode:'map'}},{T:1,N:'w2:workflowCollection'}]},{T:1,N:'script',A:{type:'text/javascript',lazy:'false'},E:[{T:4,cdata:function(scopeObj){with(scopeObj){scwin.count = 0;
scwin.onpageload = function () {
  scwin.count++;
  const tmpSrc = scwin.getfolderPath() + "/source.xml";
  tabControl1.addTab(scwin.count, {
    label: 'processMsgeFrame="true"',
    title: 'processMsgeFrame="true"',
    openAction: "exist",
    closable: "true"
  }, {
    "src": tmpSrc,
    "frameMode": "wframe"
  });
  tabControl1.setSelectedTabIndex(scwin.count);
  tabControl2.addTab(scwin.count, {
    label: 'processMsgeFrame="false"',
    title: 'processMsgeFrame="false"',
    openAction: "exist",
    closable: "true"
  }, {
    "src": tmpSrc,
    "frameMode": "wframe"
  });
  tabControl2.setSelectedTabIndex(scwin.count);
  const tmpSrc2 = scwin.getfolderPath() + "/processMsg_new.xml";
  pageFrame1.setSrc(tmpSrc2);
};
scwin.onpageunload = function () {};
scwin.getfolderPath = function () {
  var currentPath = window.location.href;
  var folderPath;
  if (currentPath.includes("mainContainer")) {
    console.log("true  ===> " + $p.getFrameId());
    const cmtFrame = $p.getComponentById($p.getFrameId());
    currentPath = cmtFrame.getSrc();
    folderPath = currentPath.substring(0, currentPath.lastIndexOf('/'));
  } else {
    console.log("false  ===> ");
    folderPath = currentPath.split('w2xPath=')[1].substring(0, currentPath.split('w2xPath=')[1].lastIndexOf('/'));
  }
  return folderPath;
};
}}}]}]},{T:1,N:'body',A:{'ev:onpageload':'scwin.onpageload','ev:onpageunload':'scwin.onpageunload'},E:[{T:1,N:'xf:group',A:{id:'',style:'margin: 10px;'},E:[{T:1,N:'w2:textbox',A:{tagname:'h1',style:'margin-bottom: 10px;color: blue;',id:'textbox1',label:'Show Submission Status Window within the Tab (Custom)<br/>',escape:'false'}},{T:1,N:'w2:textbox',A:{tagname:'h2',style:'height: 23px;margin-bottom: 10px;color: blue;',id:'textbox2',label:'How to Use'}},{T:1,N:'w2:textbox',A:{style:'color: blue;margin-bottom: 30px;',id:'textbox3',label:'(First TabControl)<br/>1-1. Click the internal Submit button.<br/>1-2. Confirm that the file specified as the processMsgFrameURL in the client.config.xml settings file is displayed only within the WFrame tab. (processMsgFrame=“true”)<br/><br/>(Second TabControl)<br/>2-1. Click the Submit button inside.<br/>2-2. Confirm that the file specified by the processMsgFrameURL entry in the client.config.xml configuration file is displayed on the entire screen. (processMsgFrame=“false”)',escape:'false'}},{T:1,N:'w2:textbox',A:{style:'padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightpink;border:none;margin-bottom: 10px;',id:'textbox6',label:'Client Configuration (client.config.xml)<br/>processMsgFrameURL value="processMsg_new.xml"',escape:'false'}},{T:1,N:'w2:textbox',A:{style:'padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightblue;border:none;margin-bottom: 10px;',id:'textbox4',label:'processMsgFrame="true"',escape:'false'}},{T:1,N:'w2:tabControl',A:{confirmTrueAction:'exist',useTabKeyOnly:'true',confirmFalseAction:'new',useMoveNextTabFocus:'false',useConfirmMessage:'false',alwaysDraw:'false',style:'border: gray solid 1px;margin-bottom: 10px;height: 300px;',id:'tabControl1',processMsgFrame:'true'}},{T:1,N:'w2:textbox',A:{escape:'false',id:'textbox5',label:'processMsgFrame="false"',style:'padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightblue;border:none;margin-bottom: 10px;'}},{T:1,N:'w2:tabControl',A:{alwaysDraw:'false',confirmFalseAction:'new',confirmTrueAction:'exist',id:'tabControl2',style:'border: gray solid 1px;margin-bottom: 10px;height: 300px;',useConfirmMessage:'false',useMoveNextTabFocus:'false',useTabKeyOnly:'true'}},{T:1,N:'w2:pageFrame',A:{id:'pageFrame1',style:'width: 500px;height: 300px;'}}]}]}]}]})