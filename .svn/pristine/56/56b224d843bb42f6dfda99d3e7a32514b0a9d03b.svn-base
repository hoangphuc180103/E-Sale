define({declaration:{A:{version:'1.0',encoding:'UTF-8'}},E:[{T:1,N:'html',A:{xmlns:'http://www.w3.org/1999/xhtml','xmlns:ev':'http://www.w3.org/2001/xml-events','xmlns:w2':'http://www.inswave.com/websquare','xmlns:xf':'http://www.w3.org/2002/xforms'},E:[{T:1,N:'head',A:{},E:[{T:1,N:'w2:historyInfo',E:[{T:1,N:'w2:history',A:{}},{T:1,N:'w2:history',A:{}}]},{T:1,N:'w2:type',E:[{T:3,text:'COMPONENT'}]},{T:1,N:'w2:buildDate'},{T:1,N:'w2:MSA'},{T:1,N:'xf:model',E:[{T:1,N:'w2:dataCollection',A:{baseNode:'map'}},{T:1,N:'w2:workflowCollection'}]},{T:1,N:'w2:layoutInfo'},{T:1,N:'w2:publicInfo',A:{method:''}},{T:1,N:'script',A:{lazy:'false',type:'text/javascript'},E:[{T:4,cdata:function(scopeObj){with(scopeObj){scwin.onpageload = function () {};

/**
 * [DataMap 생성하기] 클릭 시
 * DataMap 생성하기
 */
scwin.btn_ex1_onclick = function (e) {
  var jsnOption;

  //로그 출력
  $c.frame.printExampleLog($p, "** [실행1] - DataMap 생성하기 scwin.btn_ex1_onclick 실행 시작 **", txa_log, false);

  //DataMap 속성 정의
  jsnOption = {
    "id": "dma_dynamic1",
    //생성할 DatMap의 ID입니다.
    "type": "dataMap",
    //생성할 데이터객체의 타입입니다. dataMap 고정.
    "option": {
      "baseNode": "map"
    },
    "keyInfo": [{
      "id": "name",
      "name": "NAME",
      "dataType": "text"
    }, {
      "id": "user_id",
      "name": "USER ID",
      "dataType": "text"
    }]
  };

  //1. DataCollection 생성하기
  $p.data.create(jsnOption);

  //로그 출력
  $c.frame.printExampleLog($p, "> 1단계 DataMap 생성 완료", txa_log, false);

  //2. 생성된 객체에 Data 할당하기
  //옵션에 적용한 id로 직접 접근이 가능합니다.
  dma_dynamic1.setJSON({
    "name": "USER 1",
    "user_id": "USER-10000001"
  });

  /*
      //또는 아래와 같이 $p.getComponentById API로 객체를 반환 받아 제어할 수 있습니다.
      let cmpDataMap = $p.getComponentById("dma_dynamic1");
      cmpDataMap.setJSON({
          "name" : "USER 1",
          "address" : "USER-10000001"
      });
  */

  //로그 출력
  $c.frame.printExampleLog($p, "> 2단계 DataMap setJSON 호출 완료", txa_log, false);
  let strData = JSON.stringify(dma_dynamic1.getJSON());

  //로그 출력
  $c.frame.printExampleLog($p, strData, txa_log, false);
  $c.frame.printExampleLog($p, "> 3단계 DataMap getJSON 호출 완료", txa_log, false);

  //로그 출력
  $c.frame.printExampleLog($p, "** [실행1] - DataMap 생성하기 scwin.btn_ex1_onclick 실행 종료 **", txa_log, false);
};

/**
 * [DataList 생성하기] 클릭 시
 * DataList 생성하기
 */
scwin.btn_ex2_onclick = function (e) {
  var jsnOption;

  //로그 출력
  $c.frame.printExampleLog($p, "** [실행2] - DataList 생성하기 scwin.btn_ex2_onclick 실행 시작 **", txa_log, false);

  //DataList 속성 정의
  jsnOption = {
    "id": "dlt_dynamic1",
    //생성할 DatList의 ID입니다.
    "type": "dataList",
    //생성할 데이터객체의 타입입니다. dataList 고정.
    "option": {
      "baseNode": "list",
      "repeatNode": "map"
    },
    "columnInfo": [{
      "id": "code",
      "name": "CODE",
      "dataType": "text"
    }, {
      "id": "label",
      "name": "CODE NAME",
      "dataType": "text"
    }]
  };

  //1. DataCollection 생성하기
  $p.data.create(jsnOption);

  //로그 출력
  $c.frame.printExampleLog($p, "> 1단계 DataList 생성 완료", txa_log, false);

  //2. 생성된 객체에 Data 할당하기
  //옵션에 적용한 id로 직접 접근이 가능합니다.
  dlt_dynamic1.setJSON([{
    "label": "Software",
    "code": "1"
  }, {
    "label": "Hardware",
    "code": "2"
  }, {
    "label": "Services",
    "code": "3"
  }]);

  /*
      //또는 아래와 같이 $p.getComponentById API로 객체를 반환 받아 제어할 수 있습니다.
      let cmpDataList = $p.getComponentById("dlt_dynamic1");
      cmpDataList.setJSON([
          {"label" : "Software", "code" : "1"},
          {"label" : "Hardware", "code" : "2"},
          {"label" : "Services", "code" : "3"}
      ]);
  */

  //로그 출력
  $c.frame.printExampleLog($p, "> 2단계 DataList setJSON 호출 완료", txa_log, false);
  let strData = JSON.stringify(dlt_dynamic1.getAllJSON());

  //로그 출력
  $c.frame.printExampleLog($p, strData, txa_log, false);
  $c.frame.printExampleLog($p, "> 3단계 DataList getAllJSON 호출 완료", txa_log, false);
  $c.frame.printExampleLog($p, "** [실행2] - DataList 생성하기 scwin.btn_ex2_onclick 실행 종료 **", txa_log, false);
};

/**
 * textarea의 로그 삭제
 */
scwin.btn_clearLog_onclick = function (e) {
  txa_log.setValue("");
};
}}}]}]},{T:1,N:'body',A:{'ev:onpageload':'scwin.onpageload'},E:[{T:1,N:'xf:group',A:{class:'sub_contents',id:'',style:''},E:[{T:1,N:'xf:group',A:{class:'ws_example_grp_desc',id:'',style:''},E:[{T:1,N:'w2:textbox',A:{escape:'false',id:'',label:'\'$p.data.create\' 메소드를 사용하여 DataMap과 DataList를 생성하는 예제입니다.',style:''}}]},{T:1,N:'xf:group',A:{id:'',style:'',class:'mb_def_box'},E:[{T:1,N:'xf:trigger',A:{class:'btn_exam_exec',disabled:'',escape:'false','ev:onclick':'scwin.btn_ex1_onclick',id:'btn_ex1',style:'',type:'button'},E:[{T:1,N:'xf:label',E:[{T:4,cdata:'DataMap 생성하기'}]}]},{T:1,N:'xf:trigger',A:{class:'btn_exam_exec',disabled:'',escape:'false','ev:onclick':'scwin.btn_ex2_onclick',id:'btn_ex2',style:'',type:'button'},E:[{T:1,N:'xf:label',E:[{T:4,cdata:'DataList 생성하기'}]}]}]},{T:1,N:'xf:group',A:{class:'example_div_tb_style_wrap',id:'',style:''},E:[{T:1,N:'xf:group',A:{class:'example_div_tr_style',id:'',style:''},E:[{T:1,N:'xf:group',A:{class:'example_div_th_style',id:''},E:[{T:1,N:'w2:span',A:{class:'mr_def txt_blue',id:'',label:'로그 확인',style:''}},{T:1,N:'xf:trigger',A:{class:'wre_btn_log_clear','ev:onclick':'scwin.btn_clearLog_onclick',id:'btn_clearLog',style:'',title:'로그 삭제',type:'button'},E:[{T:1,N:'xf:label',E:[{T:4,cdata:'로그 삭제'}]}]}]},{T:1,N:'xf:group',A:{class:'example_div_td_style',id:'',style:''},E:[{T:1,N:'xf:textarea',A:{class:'wre_txa_log',id:'txa_log',spellcheck:'false',style:'width: 100%;height: 140px;'}}]}]}]}]}]}]}]})