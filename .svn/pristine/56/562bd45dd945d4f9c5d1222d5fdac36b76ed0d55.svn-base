<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
         <script type="text/javascript" lazy="false"><![CDATA[
        
	scwin.onpageload = function() {
		
	};
	
	scwin.onpageunload = function() {
		
	};
	
	]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload" ev:onpageunload="scwin.onpageunload">
    <xf:group id="" style="margin: 10px;">
    	<w2:textbox tagname="h1" style="color: blue;margin-bottom: 10px;" id="textbox1" label="マスキング方向の設定" escape="false"></w2:textbox>
    	<w2:textbox tagname="h2" style="height: 23px;margin-bottom: 10px;color: blue;" id="textbox3" label="サンプルの使い方"></w2:textbox>
    	<w2:textbox style="color: blue;margin-bottom: 30px;" id="textbox2" label="各 InputBox に数値を入力し、マスキングが指定した方向に適用されることを確認します。"
    		escape="false">
    	</w2:textbox>
    	<w2:textbox
    		style="padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightblue;border:none;margin-bottom: 20px;"
    		id="textbox4" label='プロパティの設定&lt;br/&gt;maskFormat="default" （前から適用）&lt;br/&gt;displayFormat="#-##-###"' escape="false">
    	</w2:textbox>
    	<xf:input dataType="" displayFormat="#-##-###" maskFormat="default" adjustMaxLength="false" applyFormat="all"
    		style="width:300px;height:40px;padding: 10px;font-size:20px;font-style:normal;font-weight:bolder;color: red;margin-bottom: 10px;"
    		allowChar="0-9, aA-zZ" id="input1">
    	</xf:input>
    	<w2:textbox
    		style="padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightblue;border:none;margin-bottom: 20px;"
    		id="textbox5" label='プロパティの設定&lt;br/&gt;maskFormat="reverse" （後方から適用）&lt;br/&gt;displayFormat="#-##-###"' escape="false">
    	</w2:textbox>
    	<xf:input dataType="" displayFormat="#-##-###" maskFormat="reverse" adjustMaxLength="false" applyFormat="all"
    		style="width:300px;height:40px;padding: 10px;font-size:20px;font-style:normal;font-weight:bolder;color: red;margin-bottom: 10px;" allowChar="0-9, aA-zZ"
    		id="input2">
    	</xf:input>
    	<w2:textbox escape="false" id="textbox6" label='プロパティの設定&lt;br/&gt;maskFormat="none" （入力中は適用されません）&lt;br/&gt;displayFormat="#-##-###"'
    		style="padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightblue;border:none;margin-bottom: 20px;">
    	</w2:textbox>
    	<xf:input adjustMaxLength="false" allowChar="0-9, aA-zZ" applyFormat="all" dataType="" displayFormat="#-##-###" id="input3"
    		maskFormat="none" style="width:300px;height:40px;padding: 10px;font-size:20px;font-style:normal;font-weight:bolder;color: red;">
    	</xf:input>
    </xf:group></body>
</html>
