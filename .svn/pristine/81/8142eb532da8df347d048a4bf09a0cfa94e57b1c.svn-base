scwin.fn_msg = function () {
  let invalidType = this.getType(); // invalid type
  switch (invalidType) {
    case "mandatory":
      msg = "항목을 선택하세요.";
      break;
    default:
      msg = "기본 메시지입니다.";
      break;
  }
  alert(msg);
};
