scwin.trigger1_onclick = function (e) {
  dataList1.setJSON([{
    "col1": "apricot",
    "col2": 1,
    "col3": 2
  }], true);
};
scwin.trigger2_onclick = function (e) {
  dataList1.setData(["banana", 3, 4, "", ""], true);
};
scwin.trigger3_onclick = function (e) {
  dataList1.setArray({
    "columnInfo": ["col1", "col2", "col3"],
    "data": ["cherry", 5, 6]
  }, true);
};
scwin.trigger4_onclick = function (e) {
  var tmpXMLStr = "";
  tmpXMLStr += "<list id=\"dataList1\">";
  tmpXMLStr += "<map index=\"0\">";
  tmpXMLStr += "<col1>grape</col1>";
  tmpXMLStr += "<col2>5</col2>";
  tmpXMLStr += "<col3>6</col3>";
  tmpXMLStr += "</map>";
  tmpXMLStr += "<map index=\"1\">";
  tmpXMLStr += "<col1>melon</col1>";
  tmpXMLStr += "<col2>7</col2>";
  tmpXMLStr += "<col3>8</col3>";
  tmpXMLStr += "</map>";
  tmpXMLStr += "</list>";
  var tmpXML = WebSquare.xml.parse(tmpXMLStr);
  dataList1.setXML(tmpXML, true);
};
scwin.trigger5_onclick = function (e) {
  var tmpXMLStr = "";
  tmpXMLStr += "<map>";
  tmpXMLStr += "<col1>papaya</col1>";
  tmpXMLStr += "<col2>9</col2>";
  tmpXMLStr += "<col3>10</col3>";
  tmpXMLStr += "</map>";
  var xmlDoc = WebSquare.xml.parse(tmpXMLStr);
  dataList1.setRowXML(0, xmlDoc);
};
scwin.trigger6_onclick = function (e) {
  dataList1.setRowJSON(0, {
    "col1": "strawberry",
    "col2": 11,
    "col3": 12,
    "col4": "",
    "col5": ""
  });
};
