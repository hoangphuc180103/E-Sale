',E:[{T:4,cdata:'dataList1.setData(["banana", 3, 4, "", ""]);'}]}]},{T:1,N:'xf:trigger',A:{type:'button',id:'trigger3',style:'height:42px; line-height:32px; padding:5px; background-color:coral; font-size:15px; weight:bolder; font-weight:bolder; text-align:left; display:block; margin-bottom:10px;','ev:onclick':'scwin.trigger3_onclick'},E:[{T:1,N:'xf:label',E:[{T:4,cdata:'dataList1.setArray({"columnInfo": ["col1", "col2", "col3"], "data" : ["cherry", 5, 6] });'}]}]},{T:1,N:'xf:trigger',A:{type:'button',id:'trigger4',style:'height:42px; line-height:32px; padding:5px; background-color:coral; font-size:15px; weight:bolder; font-weight:bolder; text-align:left; display:block; margin-bottom:10px;','ev:onclick':'scwin.trigger4_onclick'},E:[{T:1,N:'xf:label',E:[{T:4,cdata:'dataList1.setXML();'}]}]},{T:1,N:'xf:trigger',A:{type:'button',id:'trigger5',style:'height:42px; line-height:32px; padding:5px; background-color:coral; font-size:15px; weight:bolder; font-weight:bolder; text-align:left; display:block; margin-bottom:10px;','ev:onclick':'scwin.trigger5_onclick'},E:[{T:1,N:'xf:label',E:[{T:4,cdata:'dataList1.setRowXML();'}]}]},{T:1,N:'xf:trigger',A:{type:'button',id:'trigger6',style:'height:42px; line-height:32px; padding:5px; background-color:coral; font-size:15px; weight:bolder; font-weight:bolder; text-align:left; display:block; margin-bottom:10px;','ev:onclick':'scwin.trigger6_onclick'},E:[{T:1,N:'xf:label',E:[{T:4,cdata:'dataList1.setRowJSON(0, { "col1": "strawberry", "col2": 11, "col3": 12});'}]}]},{T:1,N:'w2:gridView',A:{visibleRowNumFix:'true',rowNumVisible:'true',checkAllType:'false',dataList:'data:dataList1',style:'border:solid gray 1px;',id:'gridView1',autoFit:'allColumn',visibleRowNum:'8'},E:[{T:1,N:'w2:caption',A:{style:'',id:'caption1',value:'this is a grid caption.'}},{T:1,N:'w2:header',A:{style:'',id:'header1'},E:[{T:1,N:'w2:row',A:{style:'',id:'row1'},E:[{T:1,N:'w2:column',A:{width:'70',style:'',inputType:'text',id:'column5',value:'col1'}},{T:1,N:'w2:column',A