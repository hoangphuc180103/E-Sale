	<body ev:onpageload="scwin.onpageload">
		<xf:group class="sub_contents" style="">
			<xf:group class="ws_example_grp_desc" style="">
				<w2:textbox escape="false" label="GridView에서 마우스를 사용하여 셀을 수정 모드로 변경할 때, 적용할 이벤트(클릭 또는 더블 클릭)를 설정한 예제입니다." style="" class="">
				</w2:textbox>
			</xf:group>
			<xf:group class="example_div_tb_style_wrap" id="">
				<xf:group class="example_div_tr_style" style="">
					<w2:textbox class="example_div_th_style" escape="false" label="editModeEvent - ondblclick (기본 설정)" style=""></w2:textbox>
					<xf:group class="example_div_td_style" style="">
						<xf:group class="gvwbox">
							<w2:gridView editModeEvent="ondblclick" rowNumWidth="20" visibleRowNumFix="true" rowNumVisible="true"
								dataList="data:dlt_exam_1" style="height:100px;" visibleRowNum="3" autoFit="allColumn" class="gvw" defaultCellHeight="37"
								autoFitMinWidth="210">
								<w2:caption style="" id="caption1" value="this is a grid caption."></w2:caption>
								<w2:header id="header1">
									<w2:row id="row1">
										<w2:column width="70" inputType="text" id="column1" value="A" displayMode="label"></w2:column>
										<w2:column width="70" inputType="text" id="column2" value="B" displayMode="label"></w2:column>
										<w2:column width="70" inputType="text" id="column3" value="C" displayMode="label"></w2:column>
									</w2:row>
								</w2:header>
								<w2:gBody id="gBody1">
									<w2:row id="row2">
										<w2:column width="70" inputType="text" id="col_a" displayMode="label"></w2:column>
										<w2:column width="70" inputType="text" id="col_b" displayMode="label"></w2:column>
										<w2:column width="70" inputType="text" id="col_c" displayMode="label"></w2:column>
									</w2:row>
								</w2:gBody>
							</w2:gridView>
						</xf:group>
					</xf:group>
				</xf:group>
				<xf:group class="example_div_tr_style" style="">
					<w2:textbox class="example_div_th_style" escape="false" label="editModeEvent - onclick" style=""></w2:textbox>
					<xf:group class="example_div_td_style" style="">
						<xf:group class="gvwbox">
							<w2:gridView editModeEvent="onclick" rowNumWidth="20" rowNumVisible="true" visibleRowNumFix="true"
								dataList="data:dlt_exam_1" style="height:100px;" autoFit="allColumn" visibleRowNum="3" class="gvw" defaultCellHeight="37"
								autoFitMinWidth="210">
								<w2:caption style="" id="caption1" value="this is a grid caption."></w2:caption>
								<w2:header id="header1">
									<w2:row id="row1">
										<w2:column width="70" inputType="text" id="column1" value="A" displayMode="label"></w2:column>
										<w2:column width="70" inputType="text" id="column2" value="B" displayMode="label"></w2:column>
										<w2:column width="70" inputType="text" id="column3" value="C" displayMode="label"></w2:column>
									</w2:row>
								</w2:header>
								<w2:gBody id="gBody1">
									<w2:row id="row2">
										<w2:column width="70" inputType="text" id="col_a" displayMode="label"></w2:column>
										<w2:column width="70" inputType="text" id="col_b" displayMode="label"></w2:column>
										<w2:column width="70" inputType="text" id="col_c" displayMode="label"></w2:column>
									</w2:row>
								</w2:gBody>
							</w2:gridView>
						</xf:group>
					</xf:group>
				</xf:group>
				<xf:group class="example_div_tr_style" style="">
					<w2:textbox class="example_div_th_style" escape="false" label="editModeEvent - onsecondclick" style=""></w2:textbox>
					<xf:group class="example_div_td_style" style="">
						<xf:group class="gvwbox">
							<w2:gridView editModeEvent="onsecondclick" rowNumWidth="20" rowNumVisible="true" visibleRowNumFix="true"
								dataList="data:dlt_exam_1" style="height:100px;" autoFit="allColumn" visibleRowNum="3" class="gvw" defaultCellHeight="37"
								autoFitMinWidth="210">
								<w2:caption style="" id="caption1" value="this is a grid caption."></w2:caption>
								<w2:header id="header1">
									<w2:row id="row1">
										<w2:column width="70" inputType="text" id="column1" value="A" displayMode="label"></w2:column>
										<w2:column width="70" inputType="text" id="column2" value="B" displayMode="label"></w2:column>
										<w2:column width="70" inputType="text" id="column3" value="C" displayMode="label"></w2:column>
									</w2:row>
								</w2:header>
								<w2:gBody id="gBody1">
									<w2:row id="row2">
										<w2:column width="70" inputType="text" id="col_a" displayMode="label"></w2:column>
										<w2:column width="70" inputType="text" id="col_b" displayMode="label"></w2:column>
										<w2:column width="70" inputType="text" id="col_c" displayMode="label"></w2:column>
									</w2:row>
								</w2:gBody>
							</w2:gridView>
						</xf:group>
					</xf:group>
				</xf:group>
				<xf:group class="example_div_tr_style" style="">
					<w2:textbox class="example_div_th_style" escape="false" label="editModeEvent 설정 값이 GridView와 컬럼이 다른 예시" style="">
					</w2:textbox>
					<xf:group class="example_div_td_style" style="">
						<w2:textbox class="wre_txt_normal" escape="false" id=""
							label="GridView의 전체 설정은 셀을 더블 클릭하면 수정 모드로 변경됩니다.&lt;br/&gt;단, 'B' 컬럼은 셀을 클릭하면 수정 모드로 변경됩니다." style="">
						</w2:textbox>
						<xf:group class="gvwbox">
							<w2:gridView editModeEvent="ondblclick" rowNumWidth="20" rowNumVisible="true" visibleRowNumFix="true"
								dataList="data:dlt_exam_1" style="height:100px;" autoFit="allColumn" visibleRowNum="3" class="gvw" defaultCellHeight="37"
								autoFitMinWidth="210">
								<w2:caption style="" id="caption1" value="this is a grid caption."></w2:caption>
								<w2:header id="header1">
									<w2:row id="row1">
										<w2:column width="70" inputType="text" id="column1" value="A" displayMode="label"></w2:column>
										<w2:column width="70" inputType="text" id="column2" value="B" displayMode="label" class="wre_txt_blue"></w2:column>
										<w2:column width="70" inputType="text" id="column3" value="C" displayMode="label"></w2:column>
									</w2:row>
								</w2:header>
								<w2:gBody id="gBody1">
									<w2:row id="row2">
										<w2:column width="70" inputType="text" id="col_a" displayMode="label"></w2:column>
										<w2:column width="70" inputType="text" id="col_b" displayMode="label" editModeEvent="onclick"></w2:column>
										<w2:column width="70" inputType="text" id="col_c" displayMode="label"></w2:column>
									</w2:row>
								</w2:gBody>
							</w2:gridView>
						</xf:group>
					</xf:group>
				</xf:group>
				<xf:group class="example_div_tr_style" style="">
					<w2:textbox class="example_div_th_style" escape="false" label="editModeEventIcon - onclick (기본 설정)" style=""></w2:textbox>
					<xf:group class="example_div_td_style" style="">
						<w2:textbox class="wre_txt_normal" escape="false" id=""
							label="'Category' 컬럼과 'Date' 컬럼은 셀을 클릭하면 수정 모드로 변경됩니다.&lt;br/&gt;'Product' 컬럼은 셀을 더블 클릭하면 수정 모드로 변경됩니다." style=""></w2:textbox>
						<xf:group class="gvwbox">
							<w2:gridView editModeEvent="ondblclick" rowNumVisible="true" defaultCellHeight="37" editModeEventIcon="onclick"
								rowNumWidth="20" visibleRowNumFix="true" dataList="data:dlt_exam_2" style="height:100px;" autoFit="lastColumn" id=""
								visibleRowNum="3" class="gvw" autoFitMinWidth="268">
								<w2:caption style="" id="caption1" value="this is a grid caption."></w2:caption>
								<w2:header style="" id="header1">
									<w2:row style="" id="row1">
										<w2:column width="110" inputType="text" style="" id="column4" value="Category" class="wre_txt_blue" displayMode="label">
										</w2:column>
										<w2:column width="110" inputType="text" id="column1" value="Date" class="wre_txt_blue" displayMode="label">
										</w2:column>
										<w2:column width="100" inputType="text" id="column3" value="Product" displayMode="label"></w2:column>
									</w2:row>
								</w2:header>
								<w2:gBody style="" id="gBody1">
									<w2:row style="" id="row2">
										<w2:column viewType="icon" width="110" inputType="select" style="" allOption="" id="category" value=""
											displayMode="label">
											<w2:choices>
												<w2:item>
													<w2:label><![CDATA[Hardware]]></w2:label>
													<w2:value><![CDATA[Hardware]]></w2:value>
												</w2:item>
												<w2:item>
													<w2:label><![CDATA[Software]]></w2:label>
													<w2:value><![CDATA[Software]]></w2:value>
												</w2:item>
											</w2:choices>
										</w2:column>
										<w2:column dataType="date" viewType="icon" width="110" displayFormat="yyyy-MM-dd" inputType="calendar" id="created_date"
											value="" displayMode="label">
										</w2:column>
										<w2:column textAlign="left" width="100" inputType="text" id="product" value="" displayMode="label">
										</w2:column>
									</w2:row>
								</w2:gBody>
							</w2:gridView>
						</xf:group>
					</xf:group>
				</xf:group>
