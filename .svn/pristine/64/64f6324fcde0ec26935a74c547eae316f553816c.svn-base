								visibleRowNum="3" class="gvw" autoFitMinWidth="268">
								<w2:caption style="" id="caption1" value="this is a grid caption."></w2:caption>
								<w2:header style="" id="header1">
									<w2:row style="" id="row1">
										<w2:column width="110" inputType="text" style="" id="column4" value="Category" class="wre_txt_blue" displayMode="label">
										</w2:column>
										<w2:column width="110" inputType="text" id="column1" value="Date" class="wre_txt_blue" displayMode="label">
										</w2:column>
										<w2:column width="100" inputType="text" id="column3" value="Product" displayMode="label"></w2:column>
									</w2:row>
								</w2:header>
								<w2:gBody style="" id="gBody1">
									<w2:row style="" id="row2">
										<w2:column viewType="icon" width="110" inputType="select" id="category" value="" displayMode="label">
											<w2:choices>
												<w2:item>
													<w2:label><![CDATA[Hardware]]></w2:label>
													<w2:value><![CDATA[Hardware]]></w2:value>
												</w2:item>
												<w2:item>
													<w2:label><![CDATA[Software]]></w2:label>
													<w2:value><![CDATA[Software]]></w2:value>
												</w2:item>
											</w2:choices>
										</w2:column>
										<w2:column dataType="date" viewType="icon" width="110" displayFormat="yyyy-MM-dd" inputType="calendar" id="created_date"
											value="" displayMode="label">
										</w2:column>
										<w2:column textAlign="left" width="100" inputType="text" id="product" value="" displayMode="label">
										</w2:column>
									</w2:row>
								</w2:gBody>
							</w2:gridView>
						</xf:group>
