	<head meta_author="InswaveSystems" meta_type="메인" meta_screenName="[GridView] 마우스를 사용하여 셀의 수정(편집) 모드 진입 시 적용할 이벤트 지정하기">
		<w2:historyInfo>
			<w2:history meta_no="01" meta_desc="최초작성" meta_date="20221223" meta_user="InswaveSystems"></w2:history>
			<w2:history meta_no="02" meta_desc="설명부 수정" meta_date="20240621" meta_user="InswaveSystems"></w2:history>
			<w2:history meta_no="03" meta_desc="예제에서 사용하는 DataList가 변경되고, 이에 따른 GridVeiw의 설정이 수정되었습니다." meta_date="20240705"
				meta_user="InswaveSystems"></w2:history>
		</w2:historyInfo>
		<w2:type>COMPONENT</w2:type>
		<w2:buildDate />
		<w2:MSA />
		<xf:model>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" repeatNode="map" id="dlt_exam_1" saveRemovedData="true">
					<w2:columnInfo>
						<w2:column dataType="text" name="A" id="col_a"></w2:column>
						<w2:column dataType="text" name="B" id="col_b"></w2:column>
						<w2:column dataType="text" name="C" id="col_c"></w2:column>
					</w2:columnInfo>
					<w2:data use="true">
						<w2:row>
							<col_a><![CDATA[A1]]></col_a>
							<col_b><![CDATA[B1]]></col_b>
							<col_c><![CDATA[C1]]></col_c>
						</w2:row>
						<w2:row>
							<col_a><![CDATA[A2]]></col_a>
							<col_b><![CDATA[B2]]></col_b>
							<col_c><![CDATA[C2]]></col_c>
						</w2:row>
						<w2:row>
							<col_a><![CDATA[A3]]></col_a>
							<col_b><![CDATA[B3]]></col_b>
							<col_c><![CDATA[C3]]></col_c>
						</w2:row>
					</w2:data>
				</w2:dataList>
				<w2:dataList baseNode="list" repeatNode="map" id="dlt_exam_2" saveRemovedData="true">
					<w2:columnInfo>
						<w2:column dataType="text" name="Category" id="category"></w2:column>
						<w2:column dataType="text" name="Date" id="created_date"></w2:column>
						<w2:column dataType="text" name="Product" id="product"></w2:column>
					</w2:columnInfo>
					<w2:data use="true">
						<w2:row>
							<category><![CDATA[Software]]></category>
							<created_date><![CDATA[19991225]]></created_date>
							<product><![CDATA[SecureGate]]></product>
						</w2:row>
						<w2:row>
							<category><![CDATA[Hardware]]></category>
							<created_date><![CDATA[20140321]]></created_date>
							<product><![CDATA[FastServe]]></product>
						</w2:row>
						<w2:row>
							<category><![CDATA[Software]]></category>
							<created_date><![CDATA[20080612]]></created_date>
							<product><![CDATA[CodeStream]]></product>
						</w2:row>
					</w2:data>
				</w2:dataList>
			</w2:dataCollection>
			<w2:workflowCollection />
		</xf:model>
