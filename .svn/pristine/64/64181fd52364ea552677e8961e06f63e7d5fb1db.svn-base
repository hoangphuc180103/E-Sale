<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            	<w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
            		<w2:data>
            			<w2:row></w2:row>
            			<w2:row></w2:row>
            			<w2:row></w2:row>
            		</w2:data>
            		<w2:columnInfo>
            			<w2:column id="col1" name="name1" dataType="text"></w2:column>
            			<w2:column id="col2" name="name2" dataType="text"></w2:column>
            			<w2:column id="col3" name="name3" dataType="text"></w2:column>
            			<w2:column id="col4" name="name4" dataType="text"></w2:column>
            			<w2:column id="col5" name="name5" dataType="text"></w2:column>
            			<w2:column id="col6" name="name6" dataType="text"></w2:column>
            		</w2:columnInfo>
            	</w2:dataList>
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
         <script type="text/javascript" lazy="false"><![CDATA[

scwin.group = 5;
scwin.toggleRow = {};
scwin.onpageload = function () {
    var data = [];
    for (var i = 0; i < 100; i++) {
        for (var j = 0; j < 6; j++) {
            if (j === 2) {
                data.push(i + "_" + j);
            } else {
                data.push(Math.floor(j / 2) * 100 + Math.floor(i / (j + scwin.group)));
            }
            //data.push(j * 100 + (i % 5));
        }
    }
    dataList1.setData(data);
};

scwin.onpageunload = function () {

};

scwin.trigger1_onclick = function () {
    gridView1.setSubtotalVisible(false);
}

scwin.trigger2_onclick = function () {
    gridView1.setSubtotalVisible(true);
}
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload" ev:onpageunload="scwin.onpageunload">
    <xf:group id="" style="margin: 10px;"><w2:textbox tagname="h1" style="color: blue;margin-bottom: 10px;" tabIndex="h1" id="textbox1" label="subTotal 표시 및 숨김 처리" escape="false"></w2:textbox><w2:textbox tagname="h2" style="height: 23px;margin-bottom: 10px;color: blue;" id="textbox2" label="샘플 사용 방법"></w2:textbox><w2:textbox style="color: blue;margin-bottom: 30px;" id="textbox3" label='1. 첫 번째 버튼을 클릭하면 subTotal이 사라지는 것을 확인. &lt;br/&gt;2. 두 번째 버튼을 클릭하면 subTotal이 표시되는 것을 확인. ' escape="false">
    	</w2:textbox><xf:trigger ev:onclick="scwin.trigger1_onclick" style="height:42px;line-height:32px;padding:5px;background-color:coral;font-size:15px;weight: bolder;font-weight:bolder;text-align: left;display: block;margin-bottom: 10px;" id="trigger1" type="button">
    		<xf:label><![CDATA[gridView1.setSubtotalVisible(false);]]></xf:label>
    	</xf:trigger><xf:trigger ev:onclick="scwin.trigger2_onclick" style="height:42px;line-height:32px;padding:5px;background-color:coral;font-size:15px;weight: bolder;font-weight:bolder;text-align: left;display: block;margin-bottom: 10px;" id="trigger2" type="button">
    		<xf:label><![CDATA[gridView1.setSubtotalVisible(true);]]></xf:label>
    	</xf:trigger><w2:gridView scrollByColumnAdaptive="false" rowNumVisible="true" dataList="data:dataList1" scrollByColumn="false" style="border: solid 1px gray;" id="gridView1" visibleRowNum="10" defaultCellHeight="20" visibleRowNumFix="true">
    		<w2:caption style="" id="caption2" value="this is a grid caption."></w2:caption>
    		<w2:header style="" id="header2">
    			<w2:row style="" id="row3">
    				<w2:column removeBorderStyle="false" width="130" style="" inputType="text" id="column13" value="Type" blockSelect="false" displayMode="label">
    				</w2:column>
    				<w2:column removeBorderStyle="false" width="70" style="" inputType="text" id="column11" value="" blockSelect="false" displayMode="label">
    				</w2:column>
    				<w2:column removeBorderStyle="false" width="70" style="" inputType="text" id="column9" value="Category" blockSelect="false" displayMode="label">
    				</w2:column>
    				<w2:column removeBorderStyle="false" width="70" style="" inputType="text" id="column7" value="AAA" blockSelect="false" displayMode="label">
    				</w2:column>
    				<w2:column removeBorderStyle="false" width="70" style="" inputType="text" id="column5" value="BBB" blockSelect="false" displayMode="label">
    				</w2:column>
    				<w2:column removeBorderStyle="false" width="70" style="" inputType="text" id="column3" value="CCC" blockSelect="false" displayMode="label">
    				</w2:column>
    			</w2:row>
    		</w2:header>
    		<w2:gBody style="" id="gBody2">
    			<w2:row style="" id="row4">
    				<w2:column removeBorderStyle="false" width="130" colMerge="" style="" inputType="text" id="col1" value="" blockSelect="false" displayMode="label">
    				</w2:column>
    				<w2:column removeBorderStyle="false" width="70" colMerge="" style="" inputType="text" id="col2" value="" blockSelect="false" displayMode="label">
    				</w2:column>
    				<w2:column removeBorderStyle="false" width="70" colMerge="" style="" inputType="text" id="col3" value="" blockSelect="false" displayMode="label">
    				</w2:column>
    				<w2:column removeBorderStyle="false" width="70" colMerge="" style="" inputType="text" id="col4" value="" blockSelect="false" displayMode="label">
    				</w2:column>
    				<w2:column removeBorderStyle="false" width="70" colMerge="" style="" inputType="text" id="col5" value="" blockSelect="false" displayMode="label">
    				</w2:column>
    				<w2:column removeBorderStyle="false" width="70" colMerge="" style="" inputType="text" id="col6" value="" blockSelect="false" displayMode="label">
    				</w2:column>
    			</w2:row>
    		</w2:gBody>
    		<w2:subTotal targetColumnID="col1" style="" id="subTotal1">
    			<w2:row style="" id="row5">
    				<w2:column expression="SUM('col1')" removeBorderStyle="false" width="130" style="" inputType="expression" id="column20" value="" blockSelect="false" displayMode="label">
    				</w2:column>
    				<w2:column expression="SUM('col2')" removeBorderStyle="false" width="70" style="" inputType="expression" id="column19" value="" blockSelect="false" displayMode="label">
    				</w2:column>
    				<w2:column removeBorderStyle="false" width="70" style="" inputType="expression" id="column18" value="" blockSelect="false" displayMode="label">
    				</w2:column>
    				<w2:column expression="SUM('col4')" removeBorderStyle="false" width="70" style="" inputType="expression" id="column17" value="" blockSelect="false" displayMode="label">
    				</w2:column>
    				<w2:column expression="SUM('col5')" removeBorderStyle="false" width="70" style="" inputType="expression" id="column16" value="" blockSelect="false" displayMode="label">
    				</w2:column>
    				<w2:column expression="SUM('col6')" removeBorderStyle="false" width="70" style="" inputType="expression" id="column15" value="" blockSelect="false" displayMode="label">
    				</w2:column>
    			</w2:row>
    		</w2:subTotal>
    	</w2:gridView></xf:group></body>
</html>
