            "A_Code": "PNH"
        },
        {
            "C_Code": "PUS",
            "Airport": "KIMHAE",
            "Country": "KOREA",
            "City": "PUSAN",
            "A_Code": "PUS"
        },
        {
            "C_Code": "ICH",
            "Airport": "Incheon International Airport",
            "Country": "KOREA",
            "City": "Incheon",
            "A_Code": "ICN"
        },
        {
            "C_Code": "JJU",
