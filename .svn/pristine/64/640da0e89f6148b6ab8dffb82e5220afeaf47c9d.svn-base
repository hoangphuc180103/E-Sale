        }
    ];
    dataList1.setJSON(jsonData1);
};
	
	scwin.onpageunload = function() {
		
	};
	
	]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload" ev:onpageunload="scwin.onpageunload">
    <xf:group id="" style="margin: 10px;">
    	<w2:textbox tagname="h1" style="color: blue;margin-bottom: 10px;" tabIndex="h1" id="textbox1" label="LinkedDataList 생성" escape="false"></w2:textbox>
    	<w2:textbox tagname="h2" style="height: 23px;margin-bottom: 10px;color: blue;" id="textbox2" label="샘플 사용 방법"></w2:textbox>
    	<w2:textbox style="color: blue;margin-bottom: 30px;" id="textbox3"
    		label='1. 하단의 첫 번째 Radio는 "dataList1"과 바인딩 된 것을 확인. &lt;br/&gt;2. 하단의 두 번째 Radio는 "linkedDataList1"과 바인딩 된 것을 확인. &lt;br/&gt;3. "linkedDataList1"은 "dataList1"의 데이터 중 Contry가 "Korea"인 데이터만 사용하는 것을 확인. ' escape="false">
    	</w2:textbox>
    	<w2:textbox
    		style="padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightblue;border:none;margin-bottom: 10px;"
    		id="textbox4" label='DataList&lt;br/&gt; &amp;nbsp; &amp;nbsp;id="dataList1"' escape="false">
    	</w2:textbox>
    	<xf:select1 ref="" appearance="full" style="margin-bottom: 10px;" id="radio1" rows="" cols="3" selectedIndex="-1">
    		<xf:choices>
    			<xf:itemset nodeset="data:dataList1">
    				<xf:label ref="City"></xf:label>
    				<xf:value ref="C_Code"></xf:value>
    			</xf:itemset>
    		</xf:choices>
    	</xf:select1>
    	<w2:textbox escape="false" id="textbox5" label='LinkedDataList (Country=="KOREA")&lt;br/&gt; &amp;nbsp; &amp;nbsp;id="linkedDataList1"&lt;br/&gt; &amp;nbsp; &amp;nbsp;bind="dataList1"'
    		style="padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightblue;border:none;margin-bottom: 10px;">
    	</w2:textbox>
    	<xf:select1 appearance="full" cols="3" id="radio2" ref="" rows="" selectedIndex="-1" style="">
    		<xf:choices>
    			<xf:itemset nodeset="data:linkedDataList1">
    				<xf:label ref="City"></xf:label>
    				<xf:value ref="C_Code"></xf:value>
    			</xf:itemset>
    		</xf:choices>
    	</xf:select1>
    </xf:group></body>
</html>
