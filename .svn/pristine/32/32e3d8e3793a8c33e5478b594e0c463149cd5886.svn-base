scwin.gridView1_ongroupby = function (options) {
  options.groupbyHeader = [{
    inputType: 'expression',
    expression: 'toggle() + depthStr() + "    [ " + count() + " Cases ]  "',
    align: 'left',
    colSpan: 4
  }];
  options.closeGroup = true, options.groupbyFooter = {
    depth_0: [{
      colSpan: 3,
      value: "(1) Maximum Value",
      align: "right"
    }, {
      inputType: 'expression',
      expression: 'MAX("col4")'
    }],
    depth_1: [{
      colSpan: 3,
      value: "(2) Maximum Value",
      align: "right"
    }, {
      inputType: 'expression',
      expression: 'MAX("col4")'
    }],
    depth_2: [{
      colSpan: 3,
      value: "(3) Maximum Value",
      align: "right"
    }, {
      inputType: 'expression',
      expression: 'MAX("col4")'
    }]
  };
  gridView1.groupby(options);
};
