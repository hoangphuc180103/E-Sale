<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head meta_screenName="pickerType_dynamicHeaderOrder_InputCalendar">
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
         <script type="text/javascript" lazy="false"><![CDATA[
        
	scwin.onpageload = function() {
		
	};
	
	scwin.onpageunload = function() {
		
	};
	
	]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload" ev:onpageunload="scwin.onpageunload">
    <xf:group id="" style="margin: 10px;">
    	<w2:textbox tagname="h1" style="color: blue;margin-bottom: 10px;" tabIndex="h1" id="textbox1" label="달력의 연도 및 월 표시 순서 설정" escape="false"></w2:textbox>
    	<w2:textbox tagname="h2" style="height: 23px;margin-bottom: 10px;color: blue;" id="textbox2" label="샘플 사용 방법"></w2:textbox>
    	<w2:textbox style="color: blue;margin-bottom: 30px;" id="textbox3"
    		label='1. 첫 번째 InputCalendar의 달력 아이콘을 클릭. &lt;br/&gt;2. 달력 상단에 "월 - 연도" 순서로 표시되는 것을 확인. (dynamicHeaderOrder="month")&lt;br/&gt;3. 두 번째 InputCalendar의 달력 아이콘을 클릭. &lt;br/&gt;4. 달력 상단에 "연도 - 월" 순서로 표시되는 것을 확인. (dynamicHeaderOrder="year")'
    		escape="false">
    	</w2:textbox>
    	<w2:textbox
    		style="padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightblue;border:none;margin-bottom: 10px;"
    		id="textbox4" label='속성 설정&lt;br/&gt;dynamicHeaderOrder="month"&lt;br/&gt;pickerType="dynamic" ' escape="false">
    	</w2:textbox>
    	<w2:inputCalendar pickerType="dynamic" footerDiv="false" focusOnDateSelect="false" calendarValueType="yearMonthDate"
    		dynamicHeaderOrder="month" rightAlign="false"
    		monthNamesForYearMonthType=" Jan &amp;nbsp;,  Feb &amp;nbsp; ,  Mar &amp;nbsp; ,  Apr &amp;nbsp; ,  May &amp;nbsp; ,  Jun &amp;nbsp; ,  Jul &amp;nbsp; ,  Aug &amp;nbsp; ,  Sep &amp;nbsp; ,  Oct &amp;nbsp; ,  Nov &amp;nbsp; ,  Dec &amp;nbsp; "
    		style="margin-bottom: 10px;" id="inputCalendar1" renderType="component" renderDiv="true"
    		monthNames=" Jan &amp;nbsp;,  Feb &amp;nbsp; ,  Mar &amp;nbsp; ,  Apr &amp;nbsp; ,  May &amp;nbsp; ,  Jun &amp;nbsp; ,  Jul &amp;nbsp; ,  Aug &amp;nbsp; ,  Sep &amp;nbsp; ,  Oct &amp;nbsp; ,  Nov &amp;nbsp; ,  Dec &amp;nbsp; "
    		visibleWeekNum="" yearSuffix="Y &amp;nbsp; ">
    	</w2:inputCalendar>
    	<w2:textbox escape="false" id="textbox6" label='속성 설정&lt;br/&gt;dynamicHeaderOrder="year"&lt;br/&gt;pickerType="dynamic" '
    		style="padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightblue;border:none;margin-bottom: 10px;">
    	</w2:textbox>
    	<w2:inputCalendar calendarValueType="yearMonthDate" dynamicHeaderOrder="year" focusOnDateSelect="false" footerDiv="false"
    		id="inputCalendar3"
    		monthNames=" Jan &amp;nbsp;,  Feb &amp;nbsp; ,  Mar &amp;nbsp; ,  Apr &amp;nbsp; ,  May &amp;nbsp; ,  Jun &amp;nbsp; ,  Jul &amp;nbsp; ,  Aug &amp;nbsp; ,  Sep &amp;nbsp; ,  Oct &amp;nbsp; ,  Nov &amp;nbsp; ,  Dec &amp;nbsp; "
    		monthNamesForYearMonthType=" Jan &amp;nbsp;,  Feb &amp;nbsp; ,  Mar &amp;nbsp; ,  Apr &amp;nbsp; ,  May &amp;nbsp; ,  Jun &amp;nbsp; ,  Jul &amp;nbsp; ,  Aug &amp;nbsp; ,  Sep &amp;nbsp; ,  Oct &amp;nbsp; ,  Nov &amp;nbsp; ,  Dec &amp;nbsp; "
    		pickerType="dynamic" renderDiv="true" renderType="component" rightAlign="false" style="" visibleWeekNum=""
    		yearSuffix="Y &amp;nbsp; ">
    	</w2:inputCalendar>
    </xf:group></body>
</html>
