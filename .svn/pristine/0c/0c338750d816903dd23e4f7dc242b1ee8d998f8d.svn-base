<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
         <script type="text/javascript" lazy="false"><![CDATA[
scwin.count = 0;
scwin.onpageload = function () {
    requires("uiplugin.popup");

};

scwin.onpageunload = function () {

};


scwin.trigger1_onclick = function (e) {
    scwin.count++;
    var tmpSrc = scwin.getfolderPath() + "/src.xml";
    var parameter1 = input1.getValue();
    var parameter2 = input2.getValue();

    var rowJSON = {
        //   "Product Info": { "Origin": "Korea", "Manufacturer": "Inswave", "Type": "Software" },
        //   "Region": "Seoul",
        //   "Carrier": true

        "Parameter 1": parameter1,
        "Parameter 2": parameter2,
    };

    var dataObject = {
        "type": "json",
        "name": "param",
        "data": rowJSON
    };


    var options = {
        id: "popup1",
        type: "wframePopup",
        height: "300px",
        width: "300px",
        dataObject: dataObject
    };

    $p.openPopup(tmpSrc, options);
};

scwin.getfolderPath = function () {

    var currentPath = window.location.href;
    var folderPath;

    if (currentPath.includes("mainContainer")) {
        console.log("true  ===> " + $p.getFrameId());
        const cmtFrame = $p.getComponentById($p.getFrameId());
        currentPath = cmtFrame.getSrc();
        folderPath = currentPath.substring(0, currentPath.lastIndexOf('/'));
    } else {
        console.log("false  ===> ");
        folderPath = currentPath.split('w2xPath=')[1].substring(0, currentPath.split('w2xPath=')[1].lastIndexOf('/'));
    }
    return folderPath;
};
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload" ev:onpageunload="scwin.onpageunload">
    <xf:group id="" style="margin: 10px;">
    	<w2:textbox tagname="h1" style="color: blue;margin-bottom: 10px;" id="textbox1" label="ポップアップ生成時にパラメータ転送" escape="false"></w2:textbox>
    	<w2:textbox tagname="h2" style="height: 23px;margin-bottom: 10px;color: blue;" id="textbox2" label="サンプルの使い方"></w2:textbox>
    	<w2:textbox style="color: blue;margin-bottom: 30px;" id="textbox3"
    		label='1. 下部の InputBox にポップアップ作成時に渡すパラメータを入力します。 &lt;br/&gt;2. openPopup() ボタンをクリックします。 &lt;br/&gt;3. ポップアップが生成されることを確認してください。 （上記で入力したパラメータも渡されます。）&lt;br/&gt;4.生成されたタブ画面の $p.getParameter() ボタンをクリックします。 &lt;br/&gt;5.上記で入力した（ポップアップ作成時に渡した）パラメータが表示されることを確認してください。&lt;br/&gt;'
    		escape="false">
    	</w2:textbox>
    	<xf:input
    		style="text-align: right;height:50px;padding: 5px;font-size:20px;font-style:normal;font-weight:bolder;color: red;margin-bottom: 10px;display: block;"
    		id="input1" placeholder="パラメータ 1 入力">
    	</xf:input>
    	<xf:input
    		style="text-align: right;height:50px;padding: 5px;font-size:20px;font-style:normal;font-weight:bolder;color: red;margin-bottom: 10px;display: block;"
    		id="input2" placeholder="パラメータ 2 入力">
    	</xf:input>
    	<xf:trigger ev:onclick="scwin.trigger1_onclick"
    		style="display: block;height:42px;line-height:32px;padding:5px;background-color:coral;font-size:15px;weight: bolder;font-weight:bolder;margin-bottom:10px;text-align: left;"
    		id="trigger1" type="button">
    		<xf:label><![CDATA[openPopup()]]></xf:label>
    	</xf:trigger>
    	<w2:textbox escape="false" id="textbox4"
    		label='/// サンプルコード &lt;br/&gt;&lt;br/&gt;var parameter1 = input1.getValue();&lt;br/&gt;var parameter2 = input2.getValue();&lt;br/&gt;&lt;br/&gt;var rowJSON = {&lt;br/&gt; &amp;nbsp; &amp;nbsp;"Parameter 1": parameter1,&lt;br/&gt; &amp;nbsp; &amp;nbsp;"Parameter 2": parameter2,&lt;br/&gt;};&lt;br/&gt;&lt;br/&gt;var dataObject = {&lt;br/&gt; &amp;nbsp; &amp;nbsp;"type": "json",&lt;br/&gt; &amp;nbsp; &amp;nbsp;"name": "param",&lt;br/&gt; &amp;nbsp; &amp;nbsp;"data": rowJSON&lt;br/&gt;};&lt;br/&gt;&lt;br/&gt;&lt;br/&gt;var options = {&lt;br/&gt; &amp;nbsp; &amp;nbsp;id: "popup1",&lt;br/&gt; &amp;nbsp; &amp;nbsp;type: "wframePopup",&lt;br/&gt; &amp;nbsp; &amp;nbsp;height: "300px",&lt;br/&gt; &amp;nbsp; &amp;nbsp;width: "300px",&lt;br/&gt; &amp;nbsp; &amp;nbsp;dataObject: dataObject&lt;br/&gt;};&lt;br/&gt;&lt;br/&gt;$p.openPopup("src.xml", options);'
    		style="padding:10px; padding-bottom:20px; text-align:left; font-size:15px; font-weight:bolder; border:brown 1px solid; background-color:ivory; margin-bottom:10px; color:brown;"
    		tagname="">
    	</w2:textbox>
    </xf:group></body>
</html>
