  scwin.initializeExample();
};

// 예제 테스트를 위한 초기화
scwin.initializeExample = function () {
  var arrData = [{
    "col_a": "A1",
    "col_b": "B1",
    "chk_1": "0"
  }, {
    "col_a": "A2",
    "col_b": "B2",
    "chk_1": "1"
  }, {
    "col_a": "A3",
    "col_b": "B3",
    "chk_1": "0"
  }];
  dlt_exam.setJSON(arrData);
};

/**
 * 버튼 [getCheckedJSON] 클릭 시
 * getCheckedJSON 메소드를 사용하여 반환 받기
 */
scwin.btn_ex1_onclick = function (e) {
  // GridView grd_exam1의 컬럼 chk_1의 체크된 행의 데이터를 JSON으로 반환 받기
  // 인덱스는 컬럼이 추가/삭제되면 변경되기 때문에 컬럼의 아이디를 사용합니다.
  let objData = grd_exam1.getCheckedJSON("chk_1");

  //로그 출력
  let strLog = "getCheckedJSON 반환 값 : \n";
  strLog += JSON.stringify(objData, null, "\t");
  $c.frame.printExampleLog($p, strLog, txa_log, false);
  console.log(strLog);
};

/**
 * 버튼 [getCheckedXML] 클릭 시
 * getCheckedXML 메소드를 사용하여 반환 받기
 */
scwin.btn_ex2_onclick = function (e) {
  // GridView grd_exam1의 컬럼 chk_1의 체크된 행의 데이터를 XML로 반환 받기
  // 인덱스는 컬럼이 추가/삭제되면 변경되기 때문에 컬럼의 아이디를 사용합니다.
  let objData = grd_exam1.getCheckedXML("chk_1");

  //로그 출력
  let strLog = "getCheckedXML 반환 값 : \n";
  strLog += WebSquare.xml.indent(objData);
  $c.frame.printExampleLog($p, strLog, txa_log, false);
  console.log(strLog);
};

/**
 * 버튼 [getCheckedData] 클릭 시
 * getCheckedData 메소드를 사용하여 반환 받기
 */
scwin.btn_ex3_onclick = function (e) {
  // GridView grd_exam1의 컬럼 chk_1의 체크된 행의 데이터를 2차원 배열로 반환 받기
  // 인덱스는 컬럼이 추가/삭제되면 변경되기 때문에 컬럼의 아이디를 사용합니다.
  let objData = grd_exam1.getCheckedData("chk_1");

  //로그 출력
  let strLog = "getCheckedData 반환 값 : \n";
  strLog += JSON.stringify(objData, null, "\t");
  $c.frame.printExampleLog($p, strLog, txa_log, false);
  console.log(strLog);
};

/**
 * textarea의 로그 삭제
 */
scwin.btn_clearLog_onclick = function (e) {
  txa_log.setValue("");
};
