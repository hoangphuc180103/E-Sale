<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
    	<w2:buildDate />
    	<xf:model>
    		<xf:instance>
    			<data xmlns="" />
    		</xf:instance>
    		<w2:dataCollection baseNode="map">
    			<w2:dataList baseNode="list" id="dataList1" repeatNode="map" saveRemovedData="true" style="">
    				<w2:columnInfo>
    					<w2:column dataType="text" id="col1" name="city"></w2:column>
    					<w2:column dataType="text" id="col2" name="year"></w2:column>
    					<w2:column dataType="text" id="col3" name="month"></w2:column>
    					<w2:column dataType="number" id="col4" name="sales"></w2:column>
    				</w2:columnInfo>
    				<w2:data use="true">
    					<w2:row>
    						<col1><![CDATA[Seoul]]></col1>
    						<col2><![CDATA[2020]]></col2>
    						<col3><![CDATA[Jan]]></col3>
    						<col4><![CDATA[50]]></col4>
    					</w2:row>
    					<w2:row>
    						<col1><![CDATA[Seoul]]></col1>
    						<col2><![CDATA[2020]]></col2>
    						<col3><![CDATA[Feb]]></col3>
    						<col4><![CDATA[50]]></col4>
    					</w2:row>
    					<w2:row>
    						<col1><![CDATA[Seoul]]></col1>
    						<col2><![CDATA[2020]]></col2>
    						<col3><![CDATA[Mar]]></col3>
    						<col4><![CDATA[30]]></col4>
    					</w2:row>
    					<w2:row>
    						<col1><![CDATA[Seoul]]></col1>
    						<col2><![CDATA[2020]]></col2>
    						<col3><![CDATA[Apr]]></col3>
    						<col4><![CDATA[30]]></col4>
    					</w2:row>
    					<w2:row>
    						<col1><![CDATA[Seoul]]></col1>
    						<col2><![CDATA[2020]]></col2>
    						<col3><![CDATA[May]]></col3>
    						<col4><![CDATA[30]]></col4>
    					</w2:row>
    					<w2:row>
    						<col1><![CDATA[Seoul]]></col1>
    						<col2><![CDATA[2020]]></col2>
    						<col3><![CDATA[Jun]]></col3>
    						<col4><![CDATA[30]]></col4>
    					</w2:row>
    					<w2:row>
    						<col1><![CDATA[Busan]]></col1>
    						<col2><![CDATA[2020]]></col2>
    						<col3><![CDATA[Jul]]></col3>
    						<col4><![CDATA[90]]></col4>
    					</w2:row>
    					<w2:row>
    						<col1><![CDATA[Busan]]></col1>
    						<col2><![CDATA[2020]]></col2>
    						<col3><![CDATA[Jan]]></col3>
    						<col4><![CDATA[90]]></col4>
    					</w2:row>
    					<w2:row>
    						<col1><![CDATA[Busan]]></col1>
    						<col2><![CDATA[2020]]></col2>
    						<col3><![CDATA[Feb]]></col3>
    						<col4><![CDATA[90]]></col4>
    					</w2:row>
    					<w2:row>
    						<col1><![CDATA[Busan]]></col1>
    						<col2><![CDATA[2020]]></col2>
    						<col3><![CDATA[Mar]]></col3>
    						<col4><![CDATA[90]]></col4>
    					</w2:row>
    					<w2:row>
    						<col1><![CDATA[Busan]]></col1>
    						<col2><![CDATA[2020]]></col2>
    						<col3><![CDATA[Apr]]></col3>
    						<col4><![CDATA[90]]></col4>
    					</w2:row>
    					<w2:row>
    						<col1><![CDATA[Busan]]></col1>
    						<col2><![CDATA[2020]]></col2>
    						<col3><![CDATA[May]]></col3>
    						<col4><![CDATA[90]]></col4>
    					</w2:row>
    					<w2:row>
    						<col1><![CDATA[Jeju]]></col1>
    						<col2><![CDATA[2020]]></col2>
    						<col3><![CDATA[Jan]]></col3>
    						<col4><![CDATA[110]]></col4>
    					</w2:row>
    					<w2:row>
    						<col1><![CDATA[Jeju]]></col1>
    						<col2><![CDATA[2020]]></col2>
    						<col3><![CDATA[Feb]]></col3>
    						<col4><![CDATA[110]]></col4>
    					</w2:row>
    					<w2:row>
    						<col1><![CDATA[Jeju]]></col1>
    						<col2><![CDATA[2020]]></col2>
    						<col3><![CDATA[Mar]]></col3>
    						<col4><![CDATA[110]]></col4>
    					</w2:row>
    					<w2:row>
    						<col1><![CDATA[Jeju]]></col1>
    						<col2><![CDATA[2020]]></col2>
    						<col3><![CDATA[Apr]]></col3>
    						<col4><![CDATA[110]]></col4>
    					</w2:row>
    					<w2:row>
    						<col1><![CDATA[Jeju]]></col1>
    						<col2><![CDATA[2020]]></col2>
    						<col3><![CDATA[May]]></col3>
    						<col4><![CDATA[110]]></col4>
    					</w2:row>
    					<w2:row>
    						<col1><![CDATA[Jeju]]></col1>
    						<col2><![CDATA[2020]]></col2>
    						<col3><![CDATA[Jun]]></col3>
    						<col4><![CDATA[50]]></col4>
    					</w2:row>
    				</w2:data>
    			</w2:dataList>
    		</w2:dataCollection>
    		<w2:workflowCollection></w2:workflowCollection>
    	</xf:model>
    	<script type="text/javascript" lazy="false"><![CDATA[scwin.styleFormatter = function (value, formattedValue) {
    if (value > 500) {
        return "w2subtotalbig";
    } else {
        return "w2subtotalsmall";
    }
};

scwin.onpageload = function () {

};

scwin.onpageunload = function () {

};
]]></script>
    	<style type="text/css"><![CDATA[.w2subtotalbig {
                color : red;
            }
            .w2subtotalsmall {
                color : blue;
            } ]]></style>
    </head>
    <body ev:onpageload="scwin.onpageload" ev:onpageunload="scwin.onpageunload">
    <xf:group id="" style='margin: 10px;'>
    	<w2:textbox tagname="h1" style="color: blue;margin-bottom: 10px;" tabIndex="h1" id="textbox1" label="subTotal 値基準スタイルの適用"
    		escape="false">
    	</w2:textbox>
    	<w2:textbox tagname="h2" style="height: 23px;margin-bottom: 10px;color: blue;" id="textbox2" label="サンプルの使い方"></w2:textbox>
    	<w2:textbox style="color: blue;margin-bottom: 30px;" id="textbox3"
    		label='1. GridViewの subtotalStyleFormatter プロパティ値 "scwin.styleFormatter"ロー設定もの確認。 &lt;br/&gt;2. Script タブから scwin.styleFormatter 関数は subTotal 値基準としてお互いその他 CSS スタイル返すもの確認。 （詳細スクリプトは Script タブから確認。）&lt;br/&gt;3. SubTotal 値にフォロー指定した scwin.styleFormatter 関数返された CSS クラス適用されるもの確認。'
    		escape="false">
    	</w2:textbox>
    	<w2:textbox
    		style="padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightblue;border:none;margin-bottom: 10px;"
    		id="textbox4" label='プロパティの設定&lt;br/&gt;subtotalStyleFormatter="scwin.styleFormatter"' escape="false">
    	</w2:textbox>
    	<w2:gridView autoFit="allColumn" checkAllType="false" dataList="data:dataList1" defaultCellHeight="20" id="gridView2" mergeCells=""
    		scrollByColumn="false" scrollByColumnAdaptive="false" style="border: solid 1px gray;" visibleRowNum="10" visibleRowNumFix="true"
    		subtotalStyleFormatter="scwin.styleFormatter">
    		<w2:caption id="caption3" style="" value="this is a grid caption."></w2:caption>
    		<w2:header id="header2" style="">
    			<w2:row id="row4" style="">
    				<w2:column width="70" inputType="text" style="height:20px" id="column16" value="city" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="height:20px" id="column15" value="year" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="height:20px" id="column14" value="month" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="height:20px" id="column13" value="sales" displayMode="label"></w2:column>
    			</w2:row>
    		</w2:header>
    		<w2:gBody id="gBody2" style="">
    			<w2:row id="row5" style="">
    				<w2:column colMerge="true" width="70" inputType="text" style="height:20px" id="col1" value="" displayMode="label"></w2:column>
    				<w2:column colMerge="" width="70" inputType="text" style="height:20px" id="col2" value="" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="height:20px" id="col3" value="" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="height:20px" id="col4" value="" displayMode="label"></w2:column>
    			</w2:row>
    		</w2:gBody>
    		<w2:subTotal id="subTotal2" style="" targetColumnID="col1">
    			<w2:row id="row7" style="">
    				<w2:column width="70" inputType="text" style="height:20px" id="column24" value="" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="height:20px" id="column23" value="" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="height:20px" id="column22" value="" displayMode="label"></w2:column>
    				<w2:column expression='sum("col4")' width="70" inputType="expression" style="height:20px" id="column21" value=""
    					displayMode="label">
    				</w2:column>
    			</w2:row>
    		</w2:subTotal>
    	</w2:gridView>
    	<w2:textbox escape="false" id="textbox5"
    		label='/// サンプルコード&lt;br/&gt;&lt;br/&gt;scwin.styleFormatter = function(value, formattedValue) {&lt;br/&gt; &amp;nbsp; &amp;nbsp;if (value &gt; 500) {&lt;br/&gt; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;return "w2subtotalbig";&lt;br/&gt; &amp;nbsp; &amp;nbsp;} else {&lt;br/&gt; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;return "w2subtotalsmall";&lt;br/&gt; &amp;nbsp; &amp;nbsp;}&lt;br/&gt;};'
    		style="padding:10px; padding-bottom:20px; text-align:left; font-size:15px; font-weight:bolder; border:brown 1px solid; background-color:ivory; margin-bottom:10px; margin-top:10px; color:brown;">
    	</w2:textbox>
    </xf:group></body>
</html>
