<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
         <script type="text/javascript" lazy="false"><![CDATA[
        
	scwin.onpageload = function() {
        var i;
        for (i=0; i<5; i++) {
	    var num = JSON.stringify(i+1);   
	    var title = "_win_" + num + "_"; 
        windowContainer1.createWindow( title, null, null);
        windowContainer2.createWindow( title, null, null);
    }
        windowContainer1.setArrangeWindows("sequential");
        windowContainer2.setArrangeWindows("sequential");
		
	};
	
	scwin.onpageunload = function() {
		
	};
	]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload" ev:onpageunload="scwin.onpageunload">
    <xf:group id="" style="margin: 10px;">
    	<w2:textbox tagname="h1" style="color: blue;margin-bottom: 10px;" tabIndex="h1" id="textbox1" label="윈도우 목록 보기 버튼 표시"
    		escape="false">
    	</w2:textbox>
    	<w2:textbox tagname="h2" style="height: 23px;margin-bottom: 10px;color: blue;" id="textbox2" label="샘플 사용 방법"></w2:textbox>
    	<w2:textbox style="color: blue;margin-bottom: 30px;" id="textbox3"
    		label='(첫 번째 WindowContainer의 경우)&lt;br/&gt;1-1. 우측 상단에 윈도우 목록 보기 버튼이 표시된 것을 확인. (useWindowScrollButton="true")&lt;br/&gt;1-2. 윈도우 목록 보기 버튼을 클릭하면 현재 생성된 윈도우의 목록이 표시되는 것을 확인.&lt;br/&gt;&lt;br/&gt;(두 번째 WindowContainer의 경우)&lt;br/&gt;1. 우측 상단에 윈도우 목록 보기 버튼이 표시되지 않은 것을 확인. (useWindowScrollButton="false")'
    		escape="false">
    	</w2:textbox>
    	<w2:textbox
    		style="padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightblue;border:none;margin-bottom: 10px;"
    		id="textbox4" label='속성 설정&lt;br/&gt;useWindowScrollButton="true"' escape="false">
    	</w2:textbox>
    	<w2:windowContainer sequentialArrangeColNum="2" sequentialArrangeRowNum="2" fixArrangeFullScreen="false" useFixButton="false"
    		windowAutoResize="false" useWindowScrollButton="true" verticalArrangeNum="2" windowMaxNum="20" useCloseButton="false"
    		controlIconPosition="allright" stopMinimizeOnNameLayer="false" toolbarPosition="top" windowMaximizeAll="true" id="windowContainer1"
    		useStatusMsg="true" hideTitleOnMaximize="false" spaInitCount="0" windowScrollVisibleRowNum="" stopToggleOnLast="false"
    		useNameContainer="true" horizontalArrangeNum="2" useCustomMsg="false" autoArrange="true" useControlIconTitle="true"
    		tooltipDisplay="true" tooltipGroupClass="false" windowTooltipDisplay="true"
    		style="position: relative;height: 400px;border: gray solid 1px;margin-bottom: 10px;">
    		<w2:windowToolbar>
    			<w2:controlIconLayer>
    				<w2:controlIcon></w2:controlIcon>
    				<w2:controlIcon></w2:controlIcon>
    				<w2:controlIcon></w2:controlIcon>
    				<w2:controlIcon></w2:controlIcon>
    				<w2:controlIcon></w2:controlIcon>
    			</w2:controlIconLayer>
    			<w2:nameLayer></w2:nameLayer>
    			<w2:selectedNameLayer></w2:selectedNameLayer>
    		</w2:windowToolbar>
    	</w2:windowContainer>
    	<w2:textbox escape="false" id="textbox5" label='속성 설정&lt;br/&gt;useWindowScrollButton="false"'
    		style="padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightblue;border:none;margin-bottom: 10px;">
    	</w2:textbox>
    	<w2:windowContainer autoArrange="true" controlIconPosition="allright" fixArrangeFullScreen="false" hideTitleOnMaximize="false"
    		horizontalArrangeNum="2" id="windowContainer2" sequentialArrangeColNum="2" sequentialArrangeRowNum="2" spaInitCount="0"
    		stopMinimizeOnNameLayer="false" stopToggleOnLast="false" style="position: relative;height: 400px;border: gray solid 1px;"
    		toolbarPosition="top" tooltipDisplay="true" tooltipGroupClass="false" useCloseButton="false" useControlIconTitle="true"
    		useCustomMsg="false" useFixButton="false" useNameContainer="true" useStatusMsg="true" useWindowScrollButton="false"
    		verticalArrangeNum="2" windowAutoResize="false" windowMaxNum="20" windowMaximizeAll="true" windowScrollVisibleRowNum=""
    		windowTooltipDisplay="true">
    		<w2:windowToolbar>
    			<w2:controlIconLayer>
    				<w2:controlIcon></w2:controlIcon>
    				<w2:controlIcon></w2:controlIcon>
    				<w2:controlIcon></w2:controlIcon>
    				<w2:controlIcon></w2:controlIcon>
    				<w2:controlIcon></w2:controlIcon>
    			</w2:controlIconLayer>
    			<w2:nameLayer></w2:nameLayer>
    			<w2:selectedNameLayer></w2:selectedNameLayer>
    		</w2:windowToolbar>
    	</w2:windowContainer>
    </xf:group></body>
</html>
