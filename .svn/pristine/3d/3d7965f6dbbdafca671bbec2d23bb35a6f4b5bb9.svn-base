<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
        <w2:type>COMPONENT</w2:type>
        <w2:buildDate/>
        <w2:MSA/>
        <xf:model>
            <w2:dataCollection baseNode="map"/>
            <w2:workflowCollection/>
        </xf:model>
        <w2:layoutInfo/>
        <w2:publicInfo method=""/>
        <script lazy="false" type="text/javascript"><![CDATA[
scwin.onpageload = function () {
    const tmpSrc = scwin.getfolderPath() + "/source.xml";
    wframe1.setSrc(tmpSrc);
};

scwin.trigger1_onclick = function (e) {
    $p.reinitialize(true);
};

window.onbeforeunload = function () {
    console.log('Browser refreshed.');
}

scwin.trigger2_onclick = function (e) {
    $p.reinitialize();
};
scwin.getfolderPath = function () {

    var currentPath = window.location.href;
    var folderPath;

    if (currentPath.includes("mainContainer")) {
        console.log("true  ===> " + $p.getFrameId());
        const cmtFrame = $p.getComponentById($p.getFrameId());
        currentPath = cmtFrame.getSrc();
        folderPath = currentPath.substring(0, currentPath.lastIndexOf('/'));
    } else {
        console.log("false  ===> ");
        folderPath = currentPath.split('w2xPath=')[1].substring(0, currentPath.split('w2xPath=')[1].lastIndexOf('/'));
    }
    return folderPath;
};]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload">
    <xf:group id="" style="margin: 10px;"><w2:textbox tagname="h1" style="color: blue;margin-bottom: 10px;" id="textbox1" label="화면 재로딩 및 브라우저 새로 고침" escape="false"></w2:textbox><w2:textbox tagname="h2" style="height: 23px;margin-bottom: 10px;color: blue;" id="textbox2" label="샘플 사용 방법"></w2:textbox><w2:textbox style="color: blue;margin-bottom: 30px;" id="textbox3" label='1-1. 첫 번째와 두 번째 입력 상자에 모두 데이터를 입력.&lt;br/&gt;1-2. 첫 번째 $p.reinitialize(true); 버튼을 클릭. &lt;br/&gt;1-3. 브라우저가 새로 고침되어 두 입력 상자가 모두 초기화되는 것을 확인. &lt;br/&gt;&lt;br/&gt;2-1. 첫 번째와 두 번째 입력 상자에 모두 데이터를 입력.&lt;br/&gt;2-2. 두 번째 $p.reinitialize(); 버튼을 클릭. &lt;br/&gt;2-3. 두 번째 버튼이 포함된 프레임만 재로딩되어, 해당 프레임 내부의 입력 상자만 초기화되는 것을 확인. ' escape="false">
    	</w2:textbox><xf:trigger ev:onclick="scwin.trigger1_onclick" style="display: block;height:42px;line-height:32px;padding:5px;background-color:coral;font-size:15px;weight: bolder;font-weight:bolder;margin-bottom:10px;text-align: left;" id="trigger1" type="button">
    		<xf:label><![CDATA[$p.reinitialize(true);]]></xf:label>
    	</xf:trigger><xf:input adjustMaxLength="false" style="width:222px;height:42px;margin-top:20px;color: blue;font-size:20px;font-style:normal;font-weight:bolder;display:block;border: coral solid 2px;" id="input1" placeholder="(1) Enter data.">
    			</xf:input><w2:wframe src="source.xml" style="width: 400px;height: 300px;border: orange solid 2px;margin-top: 20px;" id="wframe1"></w2:wframe></xf:group></body>
</html>
