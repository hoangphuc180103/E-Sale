define({declaration:{A:{version:'1.0',encoding:'UTF-8'}},E:[{T:1,N:'html',A:{xmlns:'http://www.w3.org/1999/xhtml','xmlns:ev':'http://www.w3.org/2001/xml-events','xmlns:w2':'http://www.inswave.com/websquare','xmlns:xf':'http://www.w3.org/2002/xforms'},E:[{T:1,N:'head',A:{},E:[{T:1,N:'w2:type',E:[{T:3,text:'COMPONENT'}]},{T:1,N:'w2:buildDate'},{T:1,N:'w2:MSA'},{T:1,N:'xf:model',E:[{T:1,N:'w2:dataCollection',A:{baseNode:'map'}},{T:1,N:'w2:workflowCollection'}]},{T:1,N:'w2:layoutInfo'},{T:1,N:'w2:publicInfo',A:{method:''}},{T:1,N:'script',A:{lazy:'false',type:'text/javascript'},E:[{T:4,cdata:function(scopeObj){with(scopeObj){scwin.onpageload = function () {};
}}}]}]},{T:1,N:'body',A:{'ev:onpageload':'scwin.onpageload'},E:[{T:1,N:'xf:group',A:{class:'pop_contents',id:'',style:''},E:[{T:1,N:'xf:group',A:{class:'ws_example_grp_desc',id:'',style:''},E:[{T:1,N:'xf:group',A:{class:'titbox',id:'',style:''},E:[{T:1,N:'w2:textbox',A:{class:'ws_example_txt_desc_info',id:'',label:'학습목표',style:'',tagname:'h3'}}]},{T:1,N:'xf:group',A:{id:'',class:'detailsbox'},E:[{T:1,N:'xf:group',A:{tagname:'details',style:'',id:'',class:''},E:[{T:1,N:'w2:textbox',A:{tagname:'summary',style:'',id:'',label:'IFrame VS PageFrame 의 차이',escape:'false'}},{T:1,N:'w2:textbox',A:{style:'',id:'',label:'IFrame : 다른 웹페이지를 현재 페이지에 삽입할 수 있는 컴포넌트<br/> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; 웹페이지의 일부분을 독립적으로 로드하고 표시하기 때문에 웹페이지의 일부분을 독립적으로 제어<br/> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; 메모리를 많이 차지하고 속도가 느리다는 &nbsp;단점<br/>PageFrame : 다른 웹페이지를 현재 페이지에 삽입할수 있는 컴포넌트<br/> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;JSP의 include처럼 웹스퀘어 페이지 화면 파일을 현재 화면에 포함하여 출력하는 컴포넌트입니다. &nbsp;<br/>메모리를 적게 차지하고 속도가 빠릅니다 <br/>웹스퀘어에서 다른 페이지를 참조해서 사용할때는 pageframe 을 권장합니다. <br/><br/>',class:'',escape:'false'}}]},{T:1,N:'xf:group',A:{tagname:'details',style:'',id:'',class:''},E:[{T:1,N:'w2:textbox',A:{tagname:'summary',style:'',id:'',label:'ID 중복 사용 가능',escape:'false'}},{T:1,N:'w2:textbox',A:{style:'',id:'',label:'웹스퀘어는 화면내에 ID를 중복으로 사용할수 없습니다.<br/> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; 하지만 PageFrame 의 경우 화면에 포함된 컴포넌트의 ID가 변경되어 각 화면에 포함된 동일한 ID는 내부적으로는 서로 다른 ID로 변환됩니다. <br/> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; 그 결과 개발자는 ID 중복 걱정 없이 &nbsp;PageFrame을 이용하여 화면을 구성할 수 있습니다.',class:'',escape:'false'}}]},{T:1,N:'xf:group',A:{tagname:'details',style:'',id:'',class:''},E:[{T:1,N:'w2:textbox',A:{tagname:'summary',style:'',id:'',label:'async, await 문법 사용하기',escape:'false'}},{T:1,N:'w2:textbox',A:{style:'',id:'',label:'pageFrame 에서 다른 화면을 호출 할때 사용하는 <br/>setSrc는 비동기 함수이므로 이 함수의 호출을 포함하는 함수 또한 async function이 되어야 한다.<br/><br/>setSrc 는 Promise 객체를 return하므로 await 키워드를 붙여야 <br/>setSrc호출 이후의 동작이 정상적인 순서로 동작하게 된다.<br/> ',class:'',escape:'false'}}]},{T:1,N:'xf:group',A:{tagname:'details',style:'',id:'',class:''},E:[{T:1,N:'w2:textbox',A:{tagname:'summary',style:'',id:'',label:'pageFrame 간의 화면 참조',escape:'false'}},{T:1,N:'w2:textbox',A:{style:'',id:'',label:' &nbsp; 1) 부모 &nbsp; -> 자식 : pageFrame1.getWindow();<br/> &nbsp; 2) 자식 &nbsp; -> 부모 : $p.parent();<br/> &nbsp; 3) 자식1 -> 자식2',class:'',escape:'false'}}]},{T:1,N:'xf:group',A:{class:'',id:'',style:'',tagname:'details'},E:[{T:1,N:'w2:textbox',A:{escape:'false',id:'',label:'TabControl 활용',style:'',tagname:'summary'}},{T:1,N:'w2:textbox',A:{class:'',escape:'false',id:'',label:'1) async, await 문법 사용하기<br/>2) 데이터 참조하는 방법<br/>3) alwaysDraw 속성 알기',style:''}}]}]}]}]}]}]}]})