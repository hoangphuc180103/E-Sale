    //행 번호 바디 영역 글자색
    rowNumFooterColor: "green",
    //행 번호 푸터 영역 배경색
    rowNumFooterFontName: "Arial",
    //행 번호 푸터 영역 글자체
    rowNumFooterFontSize: "14",
    //행 번호 푸터 영역 글자 크기
    rowNumFooterFontColor: "white",
    //행 번호 푸터 영역 글자색
    rowNumSubTotalColor: "green",
    //행 번호 서브토탈 영역 배경색
    rowNumSubTotalFontName: "Arial",
    //행 번호 서브토탈 영역 글자체
    rowNumSubTotalFontSize: "14",
    //행 번호 서브토탈 영역 글자 크기
    rowNumSubTotalFontColor: "white" //행 번호 서브토탈 영역 글자색
  };

