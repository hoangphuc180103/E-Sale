/**
 * 버튼 [엑셀 다운로드 - 기본] 클릭 시
 */
scwin.btn_ex1_onclick = function (e) {
  var jsnOptions;
  jsnOptions = {
    fileName: "EXAMPLE_P00238_TYPE1.xlsx",
    //엑셀의 파일명
    useSubTotal: "true",
    //subTotal 표시
    useStyle: "false",
    //필수 설정
    rowNumVisible: "true" //행 번호(rowNum) 출력
  };
  grd_exam1.advancedExcelDownload(jsnOptions);
};

/**
 * 버튼 [엑셀 다운로드 - 행 번호의 스타일 설정] 클릭 시
 */
scwin.btn_ex2_onclick = function (e) {
  var jsnOptions;
  jsnOptions = {
    fileName: "EXAMPLE_P00238_TYPE2.xlsx",
    //엑셀의 파일명
    useSubTotal: "true",
