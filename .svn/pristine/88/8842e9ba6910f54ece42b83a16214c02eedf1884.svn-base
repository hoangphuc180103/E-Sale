<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare"
	xmlns:xf="http://www.w3.org/2002/xforms">
	<head meta_author="InswaveSystems" meta_type="메인" meta_screenName="[AutoComplete] 선택된 항목의 정보 반환받기">
		<w2:historyInfo>
			<w2:history meta_no="01" meta_desc="최초작성" meta_date="20230620" meta_user="InswaveSystems" ></w2:history>
			<w2:history meta_no="02" meta_desc="설명부 수정" meta_date="20240621" meta_user="InswaveSystems" ></w2:history>
			<w2:history meta_no="03" meta_desc="예제에서 사용하는 DataList가 변경되고, 이에 따른 AutoComplete의 설정이 수정되었습니다." meta_date="20240712" meta_user="InswaveSystems"></w2:history>
		</w2:historyInfo>
		<w2:type>COMPONENT</w2:type>
		<w2:buildDate />
		<w2:MSA />
		<xf:model>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" repeatNode="map" id="dlt_exam1" saveRemovedData="true">
					<w2:columnInfo>
						<w2:column id="code" name="Code" dataType="text"></w2:column>
						<w2:column id="col_a" name="A" dataType="text"></w2:column>
						<w2:column id="col_b" name="B" dataType="text"></w2:column>
					</w2:columnInfo>
					<w2:data use="true">
						<w2:row>
							<code><![CDATA[0001]]></code>
							<col_a><![CDATA[A1]]></col_a>
							<col_b><![CDATA[B1]]></col_b>
						</w2:row>
						<w2:row>
							<code><![CDATA[0002]]></code>
							<col_a><![CDATA[A2]]></col_a>
							<col_b><![CDATA[B2]]></col_b>
						</w2:row>
						<w2:row>
							<code><![CDATA[0003]]></code>
							<col_a><![CDATA[A3]]></col_a>
							<col_b><![CDATA[B3]]></col_b>
						</w2:row>
						<w2:row>
							<code><![CDATA[0003]]></code>
							<col_a><![CDATA[A4]]></col_a>
							<col_b><![CDATA[B4]]></col_b>
						</w2:row>
					</w2:data>
				</w2:dataList>
			</w2:dataCollection>
			<w2:workflowCollection />
		</xf:model>
		<w2:layoutInfo />
		<w2:publicInfo method="" />
		<script lazy="false" type="text/javascript"><![CDATA[scwin.onpageload = function () {
    // 예제 테스트를 위한 초기화
    scwin.initializeExample();
};

// 예제 테스트를 위한 초기화
scwin.initializeExample = function () {
    // 화면에 구성된 AutoComplete의 초기 선택 값을 "0002"로 설정
    acb_exam1.setValue("0002");
    acb_exam2.setValue("0002");
};

/**
 * 버튼 [선택 항목의 정보 받기 - 기본형] 클릭 시
 */
scwin.btn_exam1_1_onclick = function (e) {
    // AutoComplete "acb_exam1"의 선택된 항목의 정보를 반환받습니다.
    let jsnResult = acb_exam1.getSelectedRow();

    // 로그 출력
    let strLog = '# AutoComplete - 기본형 | 메소드 getSelectedRow 호출 값';
    $c.frame.printExampleLog(strLog, txa_log, false);
    $c.frame.printExampleLog(JSON.stringify(jsnResult), txa_log, false);
    console.log(strLog);
    console.log(jsnResult)
};

/**
 * 버튼 [선택 항목의 정보 받기 - gridViewItemset] 클릭 시
 */
scwin.btn_exam2_1_onclick = function (e) {
    // AutoComplete "acb_exam2"의 선택된 항목의 정보를 반환받습니다.
    let jsnResult = acb_exam2.getSelectedRow();

    // 로그 출력
    let strLog = '# AutoComplete - gridViewItemset | 메소드 getSelectedRow 호출 값';
    $c.frame.printExampleLog(strLog, txa_log, false);
    $c.frame.printExampleLog(JSON.stringify(jsnResult), txa_log, false);
    console.log(strLog);
    console.log(jsnResult)
};

/**
 * textarea의 로그 삭제
 */
scwin.btn_clearLog_onclick = function (e) {
    //textarea value를 빈문자열로 할당.
    txa_log.setValue("");
};


]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:group class="sub_contents" id="" style="">
			<xf:group class="ws_example_grp_desc" id="" style="">
				<w2:textbox escape="false" id=""
					label="AutoComplete의 'getSelectedRow' 메소드를 사용하여 선택된 항목의 정보를 JSON 형식으로 반환받는 예제입니다." style="">
				</w2:textbox>
			</xf:group>
			<xf:group class="example_div_tb_style_wrap mb_def" id="">
				<xf:group class="example_div_tr_style" id="" style="">
					<w2:textbox class="example_div_th_style" escape="false" id="" label='목록 유형: 기본형' style=""></w2:textbox>
					<xf:group class="example_div_td_style" id="" style="">
						<xf:group class="mb_def_box nobottom" id="" style="">
							<xf:trigger class="btn_exam_exec btn_txt_of" disabled="" escape="false" ev:onclick="scwin.btn_exam1_1_onclick"
								id="btn_exam1_1" style="" type="button">
								<xf:label><![CDATA[선택 항목의 정보 받기 - 기본형]]></xf:label>
							</xf:trigger>
						</xf:group>
						<w2:autoComplete style="width: 150px;min-height:24px;" submenuSize="auto" id="acb_exam1"
							allOption="" chooseOption="" ref="" emptyItem="true" emptyIndex="-1" search="contain" searchTarget="both" caseSensitive="false">
							<w2:choices>
								<w2:itemset nodeset="data:dlt_exam1">
									<w2:label ref="col_a"></w2:label>
									<w2:value ref="code"></w2:value>
								</w2:itemset>
							</w2:choices>
						</w2:autoComplete>
					</xf:group>
				</xf:group>
				<xf:group class="example_div_tr_style" id="" style="">
					<w2:textbox class="example_div_th_style" escape="false" id="" label="목록 유형: GridView" style=""></w2:textbox>
					<xf:group class="example_div_td_style" id="" style="">
						<xf:group class="mb_def_box nobottom" id="" style="">
							<xf:trigger class="btn_exam_exec btn_txt_of" disabled="" escape="false" id="btn_exam2_1" style="" type="button" ev:onclick="scwin.btn_exam2_1_onclick">
								<xf:label><![CDATA[선택 항목의 정보 받기 - gridViewItemset]]></xf:label>
							</xf:trigger>
						</xf:group>
						<w2:autoComplete allOption="" chooseOption="" emptyIndex="-1" emptyItem="true" id="acb_exam2" ref=""
							style="width: 150px;min-height:24px;" submenuSize="auto" search="contain" searchTarget="both" caseSensitive="false">
							<w2:choices>
								<w2:gridViewItemset hideHeader="" rowMouseOver="" nodeset="data:dlt_exam1" width="260" selectedRowColor=""
									label="col_a" visibleRowNum="" autoFit="lastColumn" value="code" rowMouseOverColor="" height="">
									<w2:item ref="code" hidden="" header="Code" headerStyle=""></w2:item>
									<w2:item ref="col_a" hidden="" header="A" headerStyle=""></w2:item>
									<w2:item ref="col_b" hidden="" header="B" headerStyle=""></w2:item>
								</w2:gridViewItemset>
							</w2:choices>
						</w2:autoComplete>
					</xf:group>
				</xf:group>
			</xf:group>
			<xf:group class="example_div_tb_style_wrap" id="">
				<xf:group class="example_div_tr_style" id="" style="">
					<xf:group id="" class="example_div_th_style">
						<w2:span label="로그 확인" style="" id="" class="mr_def txt_blue"></w2:span>
						<xf:trigger class="wre_btn_log_clear" ev:onclick="scwin.btn_clearLog_onclick" id="btn_clearLog" style=""
							title="로그 삭제" type="button">
							<xf:label><![CDATA[로그 삭제]]></xf:label>
						</xf:trigger>
					</xf:group>
					<xf:group class="example_div_td_style" id="" style="">
						<xf:textarea class="wre_txa_log" id="txa_log" spellcheck="false" style="width: 100%;height: 140px;"></xf:textarea>
					</xf:group>
				</xf:group>
			</xf:group>
		</xf:group>
	</body>
</html>