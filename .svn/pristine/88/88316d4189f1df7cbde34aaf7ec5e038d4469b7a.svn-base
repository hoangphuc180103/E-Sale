<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head meta_vertical_guides="" meta_horizontal_guides="" meta_screenName="grandTotalValsNameFormatter_Pivot">
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            	<w2:dataList baseNode="list" repeatNode="map" id="dataList1" saveRemovedData="true">
            		<w2:columnInfo>
            			<w2:column id="col1" name="Year" dataType="text"></w2:column>
            			<w2:column id="col2" name="City" dataType="text"></w2:column>
            			<w2:column id="col3" name="Continent" dataType="text"></w2:column>
            			<w2:column id="col4" name="Expense" dataType="number"></w2:column>
            			<w2:column id="col5" name="Saving" dataType="text"></w2:column>
            		</w2:columnInfo>
            	</w2:dataList>
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
         <script type="text/javascript" lazy="false"><![CDATA[
        
	scwin.onpageload = function() {				
				var jsonData = [
				{"col1":"2017","col2":"Seoul","col3":"Asia","col4":"250","col5": "100","rowStatus":"R"}
				,{"col1":"2017","col2":"Paris","col3":"Europe","col4":"223","col5": "100","rowStatus":"R"}
				,{"col1":"2017","col2":"Beijing","col3":"Asia","col4":"250","col5": "100","rowStatus":"R"}
				,{"col1":"2017","col2":"Bangkok","col3":"Asia","col4":"245","col5": "100","rowStatus":"R"}
				,{"col1":"2017","col2":"London","col3":"Europe","col4":"245","col5": "100","rowStatus":"R"}
				,{"col1":"2018","col2":"Seoul","col3":"Asia","col4":"209","col5": "100","rowStatus":"R"}
				,{"col1":"2018","col2":"Paris","col3":"Europe","col4":"223","col5": "100","rowStatus":"R"}
				,{"col1":"2018","col2":"Beijing","col3":"Asia","col4":"245","col5": "100","rowStatus":"R"}
				,{"col1":"2018","col2":"Bangkok","col3":"Asia","col4":"245","col5": "100","rowStatus":"R"}
				,{"col1":"2018","col2":"London","col3":"Europe","col4":"245","col5": "100","rowStatus":"R"}
				,{"col1":"2019","col2":"Seoul","col3":"Asia","col4":"250","col5": "100","rowStatus":"R"}
				,{"col1":"2019","col2":"Paris","col3":"Europe","col4":"213","col5": "100","rowStatus":"R"}
				,{"col1":"2019","col2":"Beijing","col3":"Asia","col4":"245","col5": "100","rowStatus":"R"}
				,{"col1":"2019","col2":"Bangkok","col3":"Asia","col4":"245","col5": "100","rowStatus":"R"}
				,{"col1":"2019","col2":"London","col3":"Europe","col4":"245","col5": "100","rowStatus":"R"}]; 
				dataList1.setJSON(jsonData);
		
	}; 
	
	scwin.onpageunload = function() {
		
	};
	scwin.pivot1_grandTotalValsNameFormatter = function(colId) {
		if (colId === "col1") {
            return "Year_Field_Totall";
        } else if (colId === "City_Field_Total") {
            return "col1";
        } else if (colId === "col3") {
            return "Continent_Field_Total";
        } else if (colId === "col4") {
			return "Expense_Field_Total";
		} else if (colId === "col5") {
			return "Saving_Field_Total";
		} else {
			return "Other_Field_Total";
		}
	};
	]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload" ev:onpageunload="scwin.onpageunload">
    <xf:group id="" style="margin: 10px;">
    	<w2:textbox tagname="h1" style="color: blue;margin-bottom: 10px;" tabIndex="h1" id="textbox3" label="필드 합계를 표시할 라벨 값을 커스터마이징" escape="false"></w2:textbox>
    	<w2:textbox tagname="h2" style="height: 23px;margin-bottom: 10px;color: blue;" id="textbox4" label="샘플 사용 방법"></w2:textbox>
    	<w2:textbox style="color: blue;margin-bottom: 30px;" id="textbox5" label='좌측 하단의 필드 필드 합계 라벨이 grandTotalValsNameFormatter 속성 값으로 설정한 scwin.pivot1_grandTotalValsNameFormatter 함수가 반환한 값으로 설정된 것을 확인. &lt;br/&gt;(아래 예제의 경우 필드 합계가 "Expense_Field_Total" 및 "Saving_Field_Total"로 표시됨.)&lt;br/&gt;(자세한 스크립트는 Script 탭에서 확인.)' escape="false">
    	</w2:textbox>
    	<w2:textbox style="padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightblue;border:none;margin-bottom: 10px;" id="textbox6" label='속성 설정&lt;br/&gt;grandTotalValsNameFormatter="scwin.pivot1_grandTotalValsNameFormatter"' escape="false">
    	</w2:textbox>
    	<w2:pivot grandTotalDisplayType="both" grandTotalName="Expense &amp; Saving Total" allTotalName="City Total" vals="col4,col5"
    		noColumnMove="true" rows="col1" valuesAxis="row" showGrandTotal="true" headerListOrder="col,row,val,hidden" dataList="data:dataList1"
    		style="height:500px;" columnNameFormatter="" autoFit="" id="pivot1" cols="col2" autoFitMinWidth="100"
    		grandTotalValsNameFormatter="scwin.pivot1_grandTotalValsNameFormatter">
    		<w2:fieldInfo style="padding: 10px;">
    			<w2:field name="Year" id="col1"></w2:field>
    			<w2:field name="City" id="col2"></w2:field>
    			<w2:field name="Continent" id="col3"></w2:field>
    			<w2:field name="Expense" id="col4"></w2:field>
    			<w2:field name="Saving" id="col5"></w2:field>
    		</w2:fieldInfo>
    	</w2:pivot>
    </xf:group></body>
</html>
