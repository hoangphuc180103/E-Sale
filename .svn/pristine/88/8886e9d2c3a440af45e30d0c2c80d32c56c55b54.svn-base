;

/**
 * selectbox에 chart type 할당하기
 */
scwin.setSelectBox = function (chartType) {
  var selectData = [];
  if (chartType == 1) {
    selectData = ["column2d", "column3d", "bar2d", "bar3d", "area2d", "line", "pareto2d", "pareto3d"];
  } else if (chartType == 2) {
    selectData = ["pie2d", "pie3d", "doughnut2d", "doughnut3d"];
  } else if (chartType == 3) {
    selectData = ["MSColumn2D", "MSColumn3D", "MSLine", "ZoomLine", "MSArea", "MSBar2D", "MSBar3D", "Marimekko", "StackedColumn2D", "StackedColumn3D", "StackedArea2D", "StackedBar2D", "StackedBar3D"];
  } else {}
  scwin.setItemList("sbx_chartType", selectData);
};

/**
 * selectbox 에 data 할당. 공통 스크립트
 */
scwin.setItemList = function (objName, arrData) {
  var tmpVal;
  var curComp = $p.getComponentById(objName);
  curComp.removeAll("true");
  for (var i = 0; i < arrData.length; i++) {
    tmpVal = arrData[i];
    curComp.addItem(tmpVal, tmpVal);
  }
  curComp.setSelectedIndex(0);
};
//API를 활용해 차트 각종 옵션 적용
scwin.ui_chartBt1_onclick = function (e) {
  udc_ca.udc_api();
  console.log("1.x   ==>" + x); // undefined
  var x = 10;
  var z = 10;

  //console.log("2.y   ==>" + y); // ReferenceError: y is not defined
  let y = 10;
  var x = 100;
  var z;
  console.log("5.y   ==>" + y);
  console.log("3.x   ==>" + x);
  console.log("4.z   ==>" + z);
  var trnOptions = {};
  trnOptions.startValue = 20000; // [필수] 시작 값.
  trnOptions.endValue = 25000; // 종료 값.
  trnOptions.displayValue = "기준선"; // 트렌드라인에 좌측 또는 우측에 표시할 레이블.
  trnOptions.color = "#FF0030"; // 색.

  //FusionChart의 TrendLine를 추가합니다. 
  ui_chart.addTrendLine(trnOptions);

  // 속성 'displayValue'의 추가 속성
  let attOptions = {};
  attOptions.caption = "월별 차트 제목 변경";
  attOptions.subCaption = "월별 차트 소제목 추가";
  attOptions.trendValueAlpha = 200; // [0-100] 속성 'displayValue'의 투명도.
  attOptions.trendValueFontSize = 15; // 속성 'displayValue'의 글자 크기.    // [0-100] 속성 'displayValue'의 투명도.
  attOptions.yAxisPosition = "right"; //Y 축 오른쪽으로 변경
  attOptions.yAxisName = "가격 {br}(원)"; //Y 축 설명 추가
  attOptions.xAxisName = "월"; //X 축 설명 추가

  ui_chart.setChartAttribute(attOptions);

  //FusionChart를 화면에 출력합니다
  ui_chart.draw();
};
scwin.ui_chType_onchange = function (info) {
  scwin.setSelectBox(info.newValue);
};
scwin.sbx_chartType_onchange = function (info) {
  let ref = 'data:dlt_chartData';
  let labelNode = 'Month';
  let seriesColumns = '';
  if (ui_chType.getValue() == 3) {
    seriesColumns = "[['quarter1','quarter2','quarter3','quarter4' ]]";
  } else {
    seriesColumns = "[['quarter2']]";
  }
  ui_chart.changeType(info.newValue);
  ui_chart.setChartColumnRef(ref, labelNode, seriesColumns);

  //FusionChart를 화면에 출력합니다
  ui_chart.draw();
};
