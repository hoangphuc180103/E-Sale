    <body ev:onpageload="scwin.onpageload" ev:onpageunload="scwin.onpageunload">
    	<xf:group id="" style="margin: 10px;">
    		<w2:textbox tagname="h1" style="color: blue;margin-bottom: 10px;" tabIndex="h1" id="textbox1" label="컬럼 아이콘 표시"
    			escape="false">
    		</w2:textbox>
    		<w2:textbox tagname="h2" style="height: 23px;margin-bottom: 10px;color: blue;" id="textbox2" label="샘플 사용 방법"></w2:textbox>
    		<w2:textbox style="color: blue;margin-bottom: 30px;" id="textbox3"
    			label='(첫 번째 GridView의 경우)&lt;br/&gt;inputType에 따라 각 컬럼에 아이콘이 표시되는 것을 확인. (viewType="icon")&lt;br/&gt;&lt;br/&gt;(두 번째 GridView의 경우)&lt;br/&gt;컬럼에 아이콘 없이 데이터만 표시되는 것을 확인. (viewType="default")'
    			escape="false">
    		</w2:textbox>
    		<w2:textbox
    			style="padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightblue;border:none;margin-bottom: 10px;"
    			id="textbox4" label='속성 설정 (Status 및 Date 컬럼)&lt;br/&gt;viewType="icon"' escape="false">
    		</w2:textbox>
    		<w2:gridView autoFit="allColumn" checkAllType="false" dataList="data:dataList1" defaultCellHeight="20" id="gridView1"
    			rowNumVisible="" scrollByColumn="false" scrollByColumnAdaptive="false" style="border: solid gray 1px;margin-bottom: 10px;" visibleRowNum="5"
    			visibleRowNumFix="true">
    			<w2:caption style="" id="caption2" value="this is a grid caption."></w2:caption>
    			<w2:header style="" id="header2">
    				<w2:row style="" id="row3">
    					<w2:column width="70" inputType="text" style="height:20px" id="column18" value="Status" displayMode="label"></w2:column>
    					<w2:column width="70" inputType="text" style="height:20px" id="column12" value="Date" displayMode="label"></w2:column>
    				</w2:row>
    			</w2:header>
    			<w2:gBody style="" id="gBody2">
    				<w2:row style="" id="row4">
    					<w2:column width="70" inputType="select" style="height:20px" id="Status" value="" displayMode="label" allOption=""
    						chooseOption="" ref="" viewType="icon">
    						<w2:choices>
    							<w2:itemset nodeset="data:dataList2">
    								<w2:label ref="label"></w2:label>
    								<w2:value ref="value"></w2:value>
    							</w2:itemset>
    						</w2:choices>
    					</w2:column>
    					<w2:column width="70" inputType="calendar" style="height:20px" id="Date" value="" displayMode="label"
    						viewType="icon">
    					</w2:column>
    				</w2:row>
    			</w2:gBody>
    		</w2:gridView>
    		<w2:textbox escape="false" id="textbox5" label='속성 설정 (Status 및 Date 컬럼)&lt;br/&gt;viewType="default"'
    			style="padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightblue;border:none;margin-bottom: 10px;">
    		</w2:textbox>
    		<w2:gridView autoFit="allColumn" checkAllType="false" dataList="data:dataList1" defaultCellHeight="20" id="gridView2"
    			rowNumVisible="" scrollByColumn="false" scrollByColumnAdaptive="false" style="border: solid gray 1px" visibleRowNum="5"
    			visibleRowNumFix="true">
    			<w2:caption id="caption3" style="" value="this is a grid caption."></w2:caption>
    			<w2:header id="header2" style="">
    				<w2:row id="row3" style="">
    					<w2:column displayMode="label" id="column18" inputType="text" style="height:20px" value="Status" width="70"></w2:column>
    					<w2:column displayMode="label" id="column12" inputType="text" style="height:20px" value="Date" width="70"></w2:column>
    				</w2:row>
    			</w2:header>
    			<w2:gBody id="gBody2" style="">
    				<w2:row id="row4" style="">
    					<w2:column allOption="" chooseOption="" displayMode="label" id="Status" inputType="select" ref=""
    						style="height:20px" value="" width="70" viewType="default">
    						<w2:choices>
    							<w2:itemset nodeset="data:dataList2">
    								<w2:label ref="label"></w2:label>
    								<w2:value ref="value"></w2:value>
    							</w2:itemset>
    						</w2:choices>
    					</w2:column>
    					<w2:column displayMode="label" id="Date" inputType="calendar" style="height:20px" value="" width="70" viewType="default">
    					</w2:column>
    				</w2:row>
    			</w2:gBody>
    		</w2:gridView>
    	</xf:group>
    </body>
</html>
