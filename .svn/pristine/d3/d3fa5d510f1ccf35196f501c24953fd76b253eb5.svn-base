define({declaration:{A:{version:'1.0',encoding:'UTF-8'}},E:[{T:1,N:'html',A:{xmlns:'http://www.w3.org/1999/xhtml','xmlns:ev':'http://www.w3.org/2001/xml-events','xmlns:w2':'http://www.inswave.com/websquare','xmlns:xf':'http://www.w3.org/2002/xforms'},E:[{T:1,N:'head',E:[{T:1,N:'w2:type',E:[{T:3,text:'DEFAULT'}]},{T:1,N:'w2:buildDate'},{T:1,N:'xf:model',E:[{T:1,N:'w2:dataCollection',A:{baseNode:'map'}},{T:1,N:'w2:workflowCollection'}]},{T:1,N:'script',A:{type:'text/javascript',lazy:'false'},E:[{T:4,cdata:function(scopeObj){with(scopeObj){scwin.count = 0;
scwin.onpageload = function () {
  requires("uiplugin.popup");
};
scwin.onpageunload = function () {};
scwin.trigger1_onclick = function (e) {
  scwin.count++;
  var tmpSrc = scwin.getfolderPath() + "/pop1.xml";
  var options = {
    id: scwin.count,
    type: "wframePopup",
    popupName: "wframePopup ID : " + scwin.count,
    width: "300px",
    height: "200px",
    top: "50px",
    left: "300px"
  };
  $p.openPopup(tmpSrc, options);
};
scwin.trigger2_onclick = function (e) {
  scwin.count++;
  var tmpSrc = scwin.getfolderPath() + "/pop2.xml";
  var options = {
    id: scwin.count,
    type: "iframePopup",
    popupName: "iframePopup ID : " + scwin.count,
    width: "300px",
    height: "200px",
    top: "250px",
    left: "300px"
  };
  $p.openPopup(tmpSrc, options);
};
scwin.trigger3_onclick = function (e) {
  scwin.count++;
  var tmpSrc = scwin.getfolderPath() + "/pop3.xml";
  var options = {
    id: scwin.count,
    type: "browserPopup",
    popupName: "browserPopup ID : " + scwin.count,
    width: "300px",
    height: "200px",
    top: "110px",
    left: "300px"
  };
  $p.openPopup(tmpSrc, options);
};
scwin.trigger4_onclick = function (e) {
  var popUps = $p.getAllPopupWindowList(true);
  var eachValue;
  var allValues = "";
  var i;
  for (i = 0; i < popUps.length; i++) {
    eachValue = popUps[i].text1.getValue();
    allValues += eachValue + " ";
  }
  alert(allValues);
};
scwin.getfolderPath = function () {
  var currentPath = window.location.href;
  var folderPath;
  if (currentPath.includes("mainContainer")) {
    console.log("true  ===> " + $p.getFrameId());
    const cmtFrame = $p.getComponentById($p.getFrameId());
    currentPath = cmtFrame.getSrc();
    folderPath = currentPath.substring(0, currentPath.lastIndexOf('/'));
  } else {
    console.log("false  ===> ");
    folderPath = currentPath.split('w2xPath=')[1].substring(0, currentPath.split('w2xPath=')[1].lastIndexOf('/'));
  }
  return folderPath;
};
}}}]}]},{T:1,N:'body',A:{'ev:onpageload':'scwin.onpageload','ev:onpageunload':'scwin.onpageunload'},E:[{T:1,N:'xf:group',A:{id:'',style:'margin: 10px;'},E:[{T:1,N:'w2:textbox',A:{tagname:'h1',style:'color: blue;margin-bottom: 10px;',id:'textbox1',label:'Return and Access All Popup Windows (Including Browser Popups)<br/>',escape:'false'}},{T:1,N:'w2:textbox',A:{tagname:'h2',style:'height: 23px;margin-bottom: 10px;color: blue;',id:'textbox2',label:'How to Use'}},{T:1,N:'w2:textbox',A:{style:'color: blue;margin-bottom: 30px;',id:'textbox3',label:'1. Click the PopUp1, PopUp2, and PopUp3 buttons on the example screen to create popups.<br/>2. Click the $p.getAllPopupWindowList() button on the example screen.<br/>3. Access all currently open popup windows and verify that the values from the TextBoxes within those popup windows are displayed.<br/>(See the Script tab for detailed script.)',escape:'false'}},{T:1,N:'xf:trigger',A:{'ev:onclick':'scwin.trigger1_onclick',style:'height:32px;font-weight:bolder;color:white;background-color:blue;font-family:sans-serif;border-style:none;',id:'trigger1',type:'button'},E:[{T:1,N:'xf:label',E:[{T:4,cdata:'PopUp1 - "wframePopup"'}]}]},{T:1,N:'xf:trigger',A:{'ev:onclick':'scwin.trigger2_onclick',style:'height:32px;margin-left:40px;font-weight:bolder;color:white;background-color:green;font-family:sans-serif;border-style:none;',id:'trigger2',type:'button',class:''},E:[{T:1,N:'xf:label',E:[{T:4,cdata:'PopUp2 - &nbsp;"iframePopup"'}]}]},{T:1,N:'xf:trigger',A:{'ev:onclick':'scwin.trigger3_onclick',style:'height:32px;margin-left:40px;font-weight:bolder;color:white;background-color:orange;font-family:sans-serif;font-style:normal;border-style:none;',id:'trigger3',type:'button'},E:[{T:1,N:'xf:label',E:[{T:4,cdata:'PopUp3 - "browserPopup"'}]}]},{T:1,N:'xf:trigger',A:{nextTabID:'','ev:onclick':'scwin.trigger4_onclick',style:'display: block;height:42px;line-height:32px;padding:5px;background-color:coral;font-size:15px;weight: bolder;font-weight:bolder;margin-bottom:10px;margin-top:10px;text-align: left;',id:'trigger4',type:'button'},E:[{T:1,N:'xf:label',E:[{T:4,cdata:'getAllPopupWindowList()'}]}]},{T:1,N:'w2:textbox',A:{escape:'false',id:'textbox4',label:'/// Sample Code<br/><br/>var popUps = $p.getAllPopupWindowList(true);<br/>var eachValue;<br/>var allValues = "";<br/>var i;<br/>for (i = 0; i < popUps.length; i++) {<br/> &nbsp; &nbsp;eachValue = popUps[i].text1.getValue();<br/> &nbsp; &nbsp;allValues += eachValue + " ";<br/>}<br/>alert(allValues);',style:'padding:10px; padding-bottom:20px; text-align:left; font-size:15px; font-weight:bolder; border:brown 1px solid; background-color:ivory; margin-bottom:10px; margin-top:10px; color:brown;',tagname:''}}]}]}]}]})