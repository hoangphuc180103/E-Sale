  requires("uiplugin.popup");
};
scwin.onpageunload = function () {};
scwin.trigger1_onclick = function () {
  const tmpSrc = scwin.getfolderPath() + "/wframe.xml";
  var scopeInheritValue = radio1.getValue();
  var options = {
    id: "popup",
    type: "wframePopup",
    popupName: "scopeInherit = " + scopeInheritValue,
    width: "600px",
    height: "400px",
    modal: true,
    scopeInherit: scopeInheritValue
  };
  $p.openPopup(tmpSrc, options);
};
scwin.trigger2_onclick = function (e) {};
scwin.getfolderPath = function () {
  var currentPath = window.location.href;
  var folderPath;
  if (currentPath.includes("mainContainer")) {
    console.log("true  ===> " + $p.getFrameId());
    const cmtFrame = $p.getComponentById($p.getFrameId());
    currentPath = cmtFrame.getSrc();
    folderPath = currentPath.substring(0, currentPath.lastIndexOf('/'));
  } else {
    console.log("false  ===> ");
    folderPath = currentPath.split('w2xPath=')[1].substring(0, currentPath.split('w2xPath=')[1].lastIndexOf('/'));
  }
  return folderPath;
};
}}}]}]},{T:1,N:'body',A:{'ev:onpageload':'scwin.onpageload','ev:onpageunload':'scwin.onpageunload'},E:[{T:1,N:'xf:group',A:{id:'',style:'margin: 10px;'},E:[{T:1,N:'w2:textbox',A:{tagname:'h1',style:'color: blue;margin-bottom: 10px;',id:'textbox2',label:'親のScope継承',escape:'false'}},{T:1,N:'w2:textbox',A:{tagname:'h2',style:'height: 23px;margin-bottom: 10px;color: blue;',id:'textbox3',label:'サンプルの使い方'}},{T:1,N:'w2:textbox',A:{style:'color: blue;margin-bottom: 30px;',id:'textbox4',label:'（例単独で実行。）<br/>1. scopeInherit オプション値選択。 （none, api, all または component）<br/>2. 下の openPopup() ボタンクリック。 <br/>3. ポップアップ作成され、, 生成されたポップアップは WFrameこの入れ子設定画面表示するもの確認。 <br/>4. WFrame 内部各ボタンクリック。<br/>5. 各ボタン scopeInherit プロパティ値にフォロー動作するか確認。 <br/> &nbsp; &nbsp; "none" : (1) X, (2) 最上段アクセス, (3) O<br/> &nbsp; &nbsp; "api" : (1) &nbsp;X, (2) 親アクセス, (3) O<br/> &nbsp; &nbsp; "all" : (1) O, (2) 親アクセス, (3) O<br/> &nbsp; &nbsp; "component" : (1) O, (2) 最上段アクセス, (3) O',escape:'false'}},{T:1,N:'w2:textbox',A:{style:'padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightpink;border:none;margin-bottom: 10px;',id:'textbox5',label:'scopeInherit プロパティ値の選択',escape:'false'}},{T:1,N:'xf:select1',A:{ref:'',appearance:'full',style:'margin-bottom: 10px;margin-bottom: 20px;border: solid 2px lightpink;padding: 10px;',id:'radio1',rows:'1',cols:'',selectedIndex:'-1'},E:[{T:1,N:'xf:choices',E:[{T:1,N:'xf:item',E:[{T:1,N:'xf:label',E:[{T:4,cdata:'none'}]},{T:1,N:'xf:value',E:[{T:4,cdata:'none'}]}]},{T:1,N:'xf:item',E:[{T:1,N:'xf:label',E:[{T:4,cdata:'api'}]},{T:1,N:'xf:value',E:[{T:4,cdata:'api'}]}]},{T:1,N:'xf:item',E:[{T:1,N:'xf:label',E:[{T:4,cdata:'all'}]},{T:1,N:'xf:value',E:[{T:4,cdata:'all'}]}]},{T:1,N:'xf:item',E:[{T:1,N:'xf:label',E:[{T:4,cdata:'component'}]},{T:1,N:'xf:value',E:[{T:4,cdata:'component'}]}]}]}]},{T:1,N:'w2:textbox',A:{style:'padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightblue;border:none;margin-bottom: 10px;',id:'textbox6',lab