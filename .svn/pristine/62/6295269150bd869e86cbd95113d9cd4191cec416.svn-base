<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
         <script type="text/javascript" lazy="false"><![CDATA[

scwin.onpageload = function () {
    var tmpSrc = scwin.getfolderPath() + "/tabs_added.xml";
    var tabOptions = {};
    for (var i = 0; i < 12; i++) {
        var addCount = i + 1;
        var tabOptions = {
            label: "Tab " + addCount,
            openAction: "new",
            closable: "true"
        }
        var contentsOptions = {
            frameMode: "wframe",
            alwaysDraw: false,
            src: tmpSrc
        }
        tabControl1.addTab(i, tabOptions, contentsOptions);
        tabControl2.addTab(i, tabOptions, contentsOptions);
    }
};

scwin.onpageunload = function () {

};

scwin.getfolderPath = function () {

    var currentPath = window.location.href;
    var folderPath;

    if (currentPath.includes("mainContainer")) {
        console.log("true  ===> " + $p.getFrameId());
        const cmtFrame = $p.getComponentById($p.getFrameId());
        currentPath = cmtFrame.getSrc();
        folderPath = currentPath.substring(0, currentPath.lastIndexOf('/'));
    } else {
        console.log("false  ===> ");
        folderPath = currentPath.split('w2xPath=')[1].substring(0, currentPath.split('w2xPath=')[1].lastIndexOf('/'));
    }
    return folderPath;
};

]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload" ev:onpageunload="scwin.onpageunload">
    <xf:group id="" style="margin: 10px;">
    	<w2:textbox tagname="h1" style="margin-bottom: 10px;color: blue;" id="textbox1" label="タブを閉じたときにスクロールに見えるタブの数を保持" escape="false"></w2:textbox>
    	<w2:textbox tagname="h2" style="height: 23px;margin-bottom: 10px;color: blue;" id="textbox2" label="サンプルの使い方"></w2:textbox>
    	<w2:textbox style="color: blue;margin-bottom: 30px;" id="textbox3" label='1-1.最初のTabControlで最後のタブを選択します。 &lt;br/&gt;1-2.選択した最後のタブを閉じます。 &lt;br/&gt;1-3.スクロールに表示されるタブの数が保持されていることを確認してください。 (tabScrollAuto="true")&lt;br/&gt;&lt;br/&gt;2-1. 2番目のTabControlで最後のタブを選択します。 &lt;br/&gt;2-2.選択した最後のタブを閉じます。 &lt;br/&gt;2-3.スクロールに表示されるタブの数が保持されずに減少することを確認してください。 (tabScrollAuto="false")'
    		escape="false">
    	</w2:textbox>
    	<w2:textbox
    		style="padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightblue;border:none;margin-bottom: 10px;"
    		id="textbox4" label='プロパティの設定&lt;br/&gt;tabScrollAuto="true"' escape="false">
    	</w2:textbox>
    	<w2:tabControl confirmTrueAction="exist" useTabKeyOnly="true" confirmFalseAction="new" useMoveNextTabFocus="false" tabScroll="true"
    		tabScrollAuto="true" useConfirmMessage="false" alwaysDraw="false" style='border: gray solid 1px;height: 200px;margin-bottom: 10px;' id="tabControl1"
    		changeActiveTab="true">
    	</w2:tabControl>
    	<w2:textbox escape="false" id="textbox5" label='プロパティの設定&lt;br/&gt;tabScrollAuto="false"'
    		style="padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightblue;border:none;margin-bottom: 10px;">
    	</w2:textbox>
    	<w2:tabControl alwaysDraw="false" changeActiveTab="true" confirmFalseAction="new" confirmTrueAction="exist" id="tabControl2"
    		style="border: gray solid 1px;height: 200px;" tabScroll="true" useConfirmMessage="false"
    		useMoveNextTabFocus="false" useTabKeyOnly="true">
    	</w2:tabControl>
    </xf:group></body>
</html>
