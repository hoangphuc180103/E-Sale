<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head meta_screenName="nullYNType_DataList">
    	<w2:type>DEFAULT</w2:type>
    	<w2:buildDate />
    	<xf:model>
    		<xf:instance>
    			<data xmlns="" />
    		</xf:instance>
    		<w2:dataCollection baseNode="map">
    			<w2:dataList baseNode="list" repeatNode="map" id="dataList1" saveRemovedData="true" userData1="Default userData1" userData2="12345" userData3="67890" nullYNType="null">
    				<w2:columnInfo>
    					<w2:column id="col1" name="name1" dataType="text"></w2:column>
    					<w2:column id="col2" name="name2" dataType="text" nullYN="true"></w2:column>
    					<w2:column id="col3" name="name3" dataType="text" nullYN="true"></w2:column>
    					<w2:column id="col4" name="name4" dataType="text" nullYN="true"></w2:column>
    				</w2:columnInfo>
    			</w2:dataList>
    		</w2:dataCollection>
    		<w2:workflowCollection></w2:workflowCollection>
    	</xf:model>
    	<script type="text/javascript" lazy="false"><![CDATA[
        
	scwin.onpageload = function() {
		var json1 = [
	            {"col1": "", "col2": "", "col3": "", "col4": "a"},
	            {"col1": "", "col2": "", "col3": "", "col4": "b"},
	            {"col1": "", "col2": "", "col3": "", "col4": ""},
	            {"col1": "", "col2": "", "col3": "", "col4": "d"},
	            {"col1": "", "col2": "", "col3": "", "col4": ""},
	            {"col1": "", "col2": "", "col3": "", "col4": "f"}
	            ];
	  //   dataList1.setJSON( json1 );
	   };
	
	
	scwin.onpageunload = function() {
		
	};
	
scwin.trigger1_onclick = function (e) {
    dataList1.setJSON([{"col1": "", "col2": "", "col3": "", "col4": "a"}, {"col1": "", "col2": "", "col3": "b", "col4": ""}]);
};

scwin.trigger2_onclick = function (e) {		
		var allJSON = dataList1.getAllJSON({  } );		
		var pre = WebSquare.json.JSON2XML(allJSON);		
		var result = WebSquare.json.XML2JSONString(pre);		
		alert(result);		
};
]]></script>
    	<style type="text/css"><![CDATA[
    	
    	.gridBodyDefault button {
           width: 50px !important;
        }
    	 ]]></style>
    </head>
    <body ev:onpageload="scwin.onpageload" ev:onpageunload="scwin.onpageunload">
    <xf:group id="" style="margin: 10px;">
    	<w2:textbox tagname="h1" style="color: blue;margin-bottom: 10px;" tabIndex="h1" id="textbox3" label="空白データ処理方法の設定"
    		escape="false">
    	</w2:textbox>
    	<w2:textbox tagname="h2" style="height: 23px;margin-bottom: 10px;color: blue;" id="textbox4" label="サンプルの使い方"></w2:textbox>
    	<w2:textbox style="color: blue;margin-bottom: 30px;" id="textbox5"
    		label="1. setJSON() ボタンをクリックして、スペースを含むデータを設定します。 &lt;br/&gt;2. getAllJSON() ボタンをクリックして設定したデータを確認します。 &lt;br/&gt;3. col1は空白で表示され、col2, col3, col4では“null”で表示されることを確認。"
    		escape="false">
    	</w2:textbox>
    	<w2:textbox
    		style="padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightblue;border:none;margin-bottom: 10px;"
    		id="textbox6"
    		label='プロパティの設定&lt;br/&gt;nullYNType="null" (DataList)&lt;br/&gt;nullYN="false" (dataList.column - col1)&lt;br/&gt;nullYN="true" (dataList.column - col2 &amp; col3 &amp; co4)'
    		escape="false">
    	</w2:textbox>
    	<xf:trigger ev:onclick="scwin.trigger1_onclick"
    		style="height:42px;line-height:32px;padding:5px;background-color:coral;font-size:15px;weight: bolder;font-weight:bolder;text-align: left;display: block;margin-bottom: 10px;"
    		id="trigger1" type="button" class="">
    		<xf:label><![CDATA[dataList1.setJSON([{"col1": "", "col2": "", "col3": "", "col4": "a"}, {"col1": "", "col2": "", "col3": "b", "col4": ""}]);]]></xf:label>
    	</xf:trigger>
    	<xf:trigger ev:onclick="scwin.trigger2_onclick"
    		style="height:42px;line-height:32px;padding:5px;background-color:coral;font-size:15px;weight: bolder;font-weight:bolder;text-align: left;display: block;margin-bottom: 10px;"
    		id="trigger2" type="button">
    		<xf:label><![CDATA[getAllJSON()]]></xf:label>
    	</xf:trigger>
    	<w2:gridView ev:oncellclick="scwin.gridView1_oncellclick" scrollByColumnAdaptive="false" editModeEvent="onclick"
    		rowNumVisible="true" scrollByColumn="false" sortable="true" ignoreNonEditableCellTabEnter="" userData1="gridView userData1 : 1111"
    		defaultCellHeight="30" editModeEventIcon="" setCellInputTypeCustom="" rowStatusVisible="" contextMenu="true" visibleRowNumFix="true"
    		dataList="data:dataList1" keyMoveEditMode="true" style="border: solid 1px gray" moveKeyEditModeAll="" enterKeyMove="down"
    		id="gridView1" autoFit="allColumn" visibleRowNum="5" ignoreNonEditableCell="">
    		<w2:caption style="" id="caption1" value="this is a grid caption."></w2:caption>
    		<w2:header style="" id="header1">
    			<w2:row style="" id="row1">
    				<w2:column removeBorderStyle="false" width="70" inputType="text" style="height:20px;" id="column9" value="col1"
    					blockSelect="false" displayMode="label">
    				</w2:column>
    				<w2:column removeBorderStyle="false" width="70" inputType="text" style="height:20px;" id="column7" value="col2"
    					blockSelect="false" displayMode="label">
    				</w2:column>
    				<w2:column removeBorderStyle="false" width="70" inputType="text" style="height:20px;" id="column5" value="col3"
    					blockSelect="false" displayMode="label">
    				</w2:column>
    				<w2:column removeBorderStyle="false" width="70" inputType="text" style="height:20px;" id="column3" value="col4"
    					blockSelect="false" displayMode="label">
    				</w2:column>
    			</w2:row>
    		</w2:header>
    		<w2:gBody style="" id="gBody1">
    			<w2:row style="" id="row2">
    				<w2:column removeBorderStyle="false" dataType="" width="70" inputType="" style="height:20px" id="col1" value=""
    					blockSelect="false" displayMode="label">
    				</w2:column>
    				<w2:column removeBorderStyle="false" width="70" inputType="" style="height:20px" imageSrc="" userData2="" id="col2"
    					userData1="" value="" blockSelect="false" displayMode="label">
    				</w2:column>
    				<w2:column removeBorderStyle="false" width="70" inputType="" style="height:20px" imageSrc="" id="col3" value=""
    					blockSelect="false" displayMode="label">
    				</w2:column>
    				<w2:column removeBorderStyle="false" width="70" inputType="" style="height:20px" imageSrc="" id="col4" value=""
    					blockSelect="false" displayMode="label">
    				</w2:column>
    			</w2:row>
    		</w2:gBody>
    	</w2:gridView>
    	<w2:textbox escape="false" id="textbox7"
    		label="/// getAllJSON() サンプルコード&lt;br/&gt;&lt;br/&gt;var allJSON = dataList1.getAllJSON({});&lt;br/&gt;var pre = WebSquare.json.JSON2XML(allJSON);&lt;br/&gt; WebSquare.json.XML2JSONString(pre);&lt;br/&gt;alert(result);"
    		style="padding:10px; padding-bottom:20px; text-align:left; font-size:15px; font-weight:bolder; border:brown 1px solid; background-color:ivory; margin-bottom:10px; margin-top:10px; color:brown;"
    		tagname="">
    	</w2:textbox>
    </xf:group></body>
</html>
