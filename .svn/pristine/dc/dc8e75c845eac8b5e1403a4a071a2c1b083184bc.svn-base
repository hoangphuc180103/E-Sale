		<script lazy="false" type="text/javascript"><![CDATA[
scwin.onpageload = function () {

};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:group class="sub_contents" id="" style="">
			<xf:group class="ws_example_grp_desc" id="" style="">
				<w2:textbox escape="false" id=""
					label="Pivot의 'headerYMerge' 속성을 사용하여 Y축 헤더 컬럼을 병합한 예제입니다." style="">
				</w2:textbox>
			</xf:group>
			<xf:group class="example_div_tb_style_wrap mw600" id="" style="margin-bottom: 20px;">
				<xf:group class="example_div_tr_style" id="" style="">
					<w2:textbox class="example_div_th_style" escape="false" id="" label='(기본설정) Y축 헤더 컬럼 병합 미사용' style=""></w2:textbox>
					<xf:group class="example_div_td_style" id="" style="overflow: auto;">
						<w2:pivot cols="year" dataList="data:dlt_data" excludeHiddenList="code" grandTotalName="TYPE" hiddenHeaderList="" id="piv_ex01"
							rows="name,type,kind" sortFunction="" style="position: relative;height: 500px;" vals="value" valuesAxis="row" bodyTextAlign="right" totalTextAlign="right">
							<w2:fieldInfo>
								<w2:field id="year" name="YEAR"></w2:field>
								<w2:field id="code" name="CODE"></w2:field>
								<w2:field id="name" name="CITY"></w2:field>
								<w2:field id="type" name="TYPE"></w2:field>
								<w2:field id="kind" name="ITEM"></w2:field>
								<w2:field id="value" name="STOCK"></w2:field>
							</w2:fieldInfo>
						</w2:pivot>
					</xf:group>
				</xf:group>
			</xf:group>
			<xf:group class="example_div_tb_style_wrap mw600" id="" style="">
				<xf:group class="example_div_tr_style" id="" style="">
					<w2:textbox class="example_div_th_style" escape="false" id="" label="Y축 헤더 컬럼 병합 사용" style=""></w2:textbox>
					<xf:group class="example_div_td_style" id="" style="overflow: auto;">
						<w2:textbox class="wre_txt_normal" escape="false" id="" label='Y축의 [TYPE], [ITEM]에 출력된 "TOTAL" 값이 병합되었습니다.' style="">
						</w2:textbox>
						<w2:pivot cols="year" dataList="data:dlt_data" excludeHiddenList="code" grandTotalName="TYPE" headerYMerge="true"
							hiddenHeaderList="" id="piv_ex02" rows="name,type,kind" sortFunction="" style="position: relative;height: 500px;"
							vals="value" valuesAxis="row" bodyTextAlign="right" totalTextAlign="right">
							<w2:fieldInfo>
								<w2:field id="year" name="YEAR"></w2:field>
								<w2:field id="code" name="CODE"></w2:field>
								<w2:field id="name" name="CITY"></w2:field>
								<w2:field id="type" name="TYPE"></w2:field>
								<w2:field id="kind" name="ITEM"></w2:field>
								<w2:field id="value" name="STOCK"></w2:field>
							</w2:fieldInfo>
						</w2:pivot>
					</xf:group>
				</xf:group>
			</xf:group>
		</xf:group>
	</body>
</html>