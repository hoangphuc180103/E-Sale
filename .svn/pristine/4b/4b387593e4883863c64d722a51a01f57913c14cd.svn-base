<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare"
	xmlns:xf="http://www.w3.org/2002/xforms">
	<head meta_author="InswaveSystems" meta_type="메인" meta_screenName="[GridView] 셀의 기본 높이 지정하기">
		<w2:historyInfo>
			<w2:history meta_no="01" meta_desc="최초작성" meta_date="20230821" meta_user="InswaveSystems"></w2:history>
			<w2:history meta_no="02" meta_desc="설명부 수정" meta_date="20240621" meta_user="InswaveSystems"></w2:history>
			<w2:history meta_no="03" meta_desc="예제에서 사용하는 DataList가 변경되고, 이에 따른 GridView의 설정이 수정되었습니다." meta_date="20240712"
				meta_user="InswaveSystems"></w2:history>
		</w2:historyInfo>
		<w2:type>COMPONENT</w2:type>
		<w2:buildDate />
		<w2:MSA />
		<xf:model>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" repeatNode="map" id="dlt_exam" saveRemovedData="true">
					<w2:columnInfo>
						<w2:column dataType="text" name="A" id="col_a"></w2:column>
						<w2:column dataType="text" name="B" id="col_b"></w2:column>
					</w2:columnInfo>
					<w2:data use="true">
						<w2:row>
							<col_a><![CDATA[A1]]></col_a>
							<col_b><![CDATA[B1]]></col_b>
						</w2:row>
						<w2:row>
							<col_a><![CDATA[A2]]></col_a>
							<col_b><![CDATA[B2]]></col_b>
						</w2:row>
					</w2:data>
				</w2:dataList>
			</w2:dataCollection>
			<w2:workflowCollection />
		</xf:model>
		<w2:layoutInfo />
		<w2:publicInfo />
		<script lazy="false" type="text/javascript"><![CDATA[scwin.onpageload = function () {

};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:group class="sub_contents">
			<xf:group class="ws_example_grp_desc">
				<w2:textbox escape="false" label="GridView의 'defaultCellHeight' 속성을 사용하여 셀의 기본 높이를 설정한 예제입니다." style="" class=""></w2:textbox>
			</xf:group>
			<xf:group class="example_div_tb_style_wrap">
				<xf:group class="example_div_tr_style">
					<w2:textbox class="example_div_th_style" escape="false" id="" label='셀의 기본 높이 : "24px"' style=""></w2:textbox>
					<xf:group class="example_div_td_style">
						<xf:group id="" class="gvwbox" style="max-width:240px;">
							<w2:gridView initFixedHeightByRowNum="2" tooltipDisplay="true" dataList="data:dlt_exam" readOnly="true"
								style="height:60px;" autoFit="allColumn" visibleRowNum="2" class="gvw" defaultCellHeight="24" autoFitMinWidth="170">
								<w2:caption style="" id="caption1" value="this is a grid caption."></w2:caption>
								<w2:header style="" id="header1">
									<w2:row style="" id="row1">
										<w2:column width="70" inputType="text" style="" id="column2" value="A" displayMode="label"></w2:column>
										<w2:column width="70" inputType="text" style="" id="column1" value="B" displayMode="label"></w2:column>
									</w2:row>
								</w2:header>
								<w2:gBody style="" id="gBody1">
									<w2:row style="" id="row2">
										<w2:column width="70" inputType="text" style="" id="col_a" value="" displayMode="label"></w2:column>
										<w2:column width="70" inputType="text" style="" id="col_b" value="" displayMode="label"></w2:column>
									</w2:row>
								</w2:gBody>
							</w2:gridView>
						</xf:group>
					</xf:group>
				</xf:group>
				<xf:group class="example_div_tr_style" style="">
					<w2:textbox class="example_div_th_style" escape="false" id="" label='셀의 기본 높이 : "40px"' style=""></w2:textbox>
					<xf:group class="example_div_td_style">
						<xf:group id="" class="gvwbox" style="max-width:240px;">
							<w2:gridView initFixedHeightByRowNum="2" tooltipDisplay="true" dataList="data:dlt_exam" readOnly="true"
								style="height:90px;" autoFit="allColumn" visibleRowNum="2" class="gvw" defaultCellHeight="40" autoFitMinWidth="170">
								<w2:caption style="" id="caption1" value="this is a grid caption."></w2:caption>
								<w2:header style="" id="header1">
									<w2:row style="" id="row1">
										<w2:column width="70" inputType="text" style="" id="column2" value="A" displayMode="label"></w2:column>
										<w2:column width="70" inputType="text" style="" id="column1" value="B" displayMode="label"></w2:column>
									</w2:row>
								</w2:header>
								<w2:gBody style="" id="gBody1">
									<w2:row style="" id="row2">
										<w2:column width="70" inputType="text" style="" id="col_a" value="" displayMode="label"></w2:column>
										<w2:column width="70" inputType="text" style="" id="col_b" value="" displayMode="label"></w2:column>
									</w2:row>
								</w2:gBody>
							</w2:gridView>
						</xf:group>
					</xf:group>
				</xf:group>
			</xf:group>
		</xf:group>
	</body>
</html>