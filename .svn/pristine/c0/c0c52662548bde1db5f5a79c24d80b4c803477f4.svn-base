<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            	<w2:dataList baseNode="list" repeatNode="map" id="dataList1" saveRemovedData="true">
            		<w2:columnInfo>
            			<w2:column id="col1" name="name1" dataType="text"></w2:column>
            			<w2:column id="col2" name="name2" dataType="text"></w2:column>
            			<w2:column id="col3" name="name3" dataType="text"></w2:column>
            		</w2:columnInfo>
            	</w2:dataList>
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
         <script type="text/javascript" lazy="false"><![CDATA[

scwin.onpageload = function () {

};

scwin.onpageunload = function () {

};


scwin.trigger1_onclick = function (e) {
    var options = {
        headerExist: 1,
        trim: 1
    };
    gridView1.advancedExcelUpload(options);
};

scwin.trigger2_onclick = function (e) {
    var options = {
        headerExist: 1,
        trim: 0
    };
    gridView1.advancedExcelUpload(options);

};

scwin.trigger3_onclick = function (e) {
    var tmpSrc = scwin.getfolderPath() + "/advancedExcelUpload_trim_GridView.xls";
    var name = "advancedExcelUpload_trim_GridView.xls"
    scwin.downloadFile(tmpSrc, name);
};


scwin.getfolderPath = function () {

    var currentPath = window.location.href;
    var folderPath;

    if (currentPath.includes("mainContainer")) {
        console.log("true  ===> " + $p.getFrameId());
        const cmtFrame = $p.getComponentById($p.getFrameId());
        currentPath = cmtFrame.getSrc();
        folderPath = currentPath.substring(0, currentPath.lastIndexOf('/'));
    } else {
        console.log("false  ===> ");
        folderPath = currentPath.split('w2xPath=')[1].substring(0, currentPath.split('w2xPath=')[1].lastIndexOf('/'));
    }
    return folderPath;
};

scwin.downloadFile = function (tmpSrc, name) {
    const link = document.createElement('a');
    link.href = tmpSrc;
    link.download = name;
    link.click();
}

]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload" ev:onpageunload="scwin.onpageunload">
    <xf:group id="" style="margin: 10px;">
    	<w2:textbox tagname="h1" style="color: blue;margin-bottom: 10px;" tabIndex="h1" id="textbox5" label="좌우 공백 제거 후 GridView로 업로드"
    		escape="false">
    	</w2:textbox>
    	<w2:textbox tagname="h2" style="height: 23px;margin-bottom: 10px;color: blue;" id="textbox6" label="샘플 사용 방법"></w2:textbox>
    	<w2:textbox style="color: blue;margin-bottom: 30px;" id="textbox7"
    		label='1. 셀 데이터의 앞뒤에 공백을 포함하고 있는 Excel 파일을 준비. (하단의 링크를 통해 다운로드)&lt;br/&gt;&lt;br/&gt;(options.trim="1")&lt;br/&gt;2-1. 첫 번째 버튼을 클릭하고 위의 Excel 파일을 GridView로 업로드. &lt;br/&gt;2-2. 첫 행의 각 셀을 더블 클릭. &lt;br/&gt;2-3. 셀 데이터의 앞뒤 공백이 제거된 후 GridView로 업로드된 것을 확인. &lt;br/&gt;&lt;br/&gt;(options.trim="0")&lt;br/&gt;3-1. 두 번째 버튼을 클릭하고 위의 Excel 파일을 GridView로 업로드. &lt;br/&gt;3-2. 첫 행의 각 셀을 더블 클릭. &lt;br/&gt;3-3. 셀 데이터의 앞뒤 공백이 유지된 채로 GridView로 업로드된 것을 확인.'
    		escape="false">
    	</w2:textbox>
    	<xf:trigger ev:onclick="scwin.trigger1_onclick"
    		style="height:42px;line-height:32px;padding:5px;background-color:coral;font-size:15px;weight: bolder;font-weight:bolder;text-align: left;display: block;margin-bottom: 10px;"
    		id="trigger1" type="button">
    		<xf:label><![CDATA[advancedExcelUpload(options) - options.trim="1"]]></xf:label>
    	</xf:trigger>
    	<xf:trigger type="button" id="trigger2"
    		style="height:42px;line-height:32px;padding:5px;background-color:coral;font-size:15px;weight: bolder;font-weight:bolder;text-align: left;display: block;margin-bottom: 10px;"
    		ev:onclick="scwin.trigger2_onclick">
    		<xf:label><![CDATA[advancedExcelUpload(options) - options.trim="0"]]></xf:label>
    	</xf:trigger>
    	<xf:trigger type="button" id="trigger3"
    		style="height:42px;line-height:32px;padding:5px;background-color:lightpink;font-size:15px;weight: bolder;font-weight:bolder;text-align: left;margin-bottom: 10px;display: block"
    		ev:onclick="scwin.trigger3_onclick">
    		<xf:label><![CDATA[업로드용 샘플 Excel 파일 다운로드]]></xf:label>
    	</xf:trigger>
    	<w2:gridView scrollByColumnAdaptive="false" dataList="data:dataList1" style="border: solid gray 1px;margin-bottom: 10px;" scrollByColumn="false"
    		id="gridView1" defaultCellHeight="20" autoFit="allColumn" visibleRowNum="5" visibleRowNumFix="true">
    		<w2:caption style="" id="caption2" value="this is a grid caption."></w2:caption>
    		<w2:header style="" id="header2">
    			<w2:row style="" id="row3">
    				<w2:column width="70" inputType="text" style="" id="column9" value="name1" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="" id="column8" value="name2" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="" id="column7" value="name3" displayMode="label"></w2:column>
    			</w2:row>
    		</w2:header>
    		<w2:gBody style="" id="gBody2">
    			<w2:row style="" id="row4">
    				<w2:column width="70" inputType="text" style="" id="col1" value="" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="" id="col2" value="" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="" id="col3" value="" displayMode="label"></w2:column>
    			</w2:row>
    		</w2:gBody>
    	</w2:gridView>
    	<w2:textbox escape="false" id="textbox8"
    		label='/// 샘플 코드 (1)&lt;br/&gt;&lt;br/&gt;var options = {&lt;br/&gt; &amp;nbsp; &amp;nbsp;headerExist: 1,&lt;br/&gt; &amp;nbsp; &amp;nbsp;trim: 1&lt;br/&gt;};&lt;br/&gt;gridView1.advancedExcelUpload(options);&lt;br/&gt;&lt;br/&gt;/// 샘플 코드 (2)&lt;br/&gt;&lt;br/&gt;var options = {&lt;br/&gt; &amp;nbsp; &amp;nbsp;headerExist: 1,&lt;br/&gt; &amp;nbsp; &amp;nbsp;trim: 0&lt;br/&gt;};&lt;br/&gt;gridView1.advancedExcelUpload(options);'
    		style="padding:10px; padding-bottom:20px; text-align:left; font-size:15px; font-weight:bolder; border:brown 1px solid; background-color:ivory; margin-bottom:10px; color:brown;"
    		tagname="">
    	</w2:textbox>
    </xf:group></body>
</html>
