<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
         <script type="text/javascript" lazy="false"><![CDATA[
        
	scwin.onpageload = function() {
		
	};
	
	scwin.onpageunload = function() {
		
	};
	
	scwin.autoComplete1_onitemclick = function(index) {
		alert("onitemclick - Item of index "+index+" clicked!");
	};	
	
	scwin.autoComplete1_onselected = function() {
		alert("onselected - onselected event occurred!");
	};
	
	]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload" ev:onpageunload="scwin.onpageunload">
    <xf:group id="" style="margin: 10px;">
    	<w2:textbox tagname="h1" style="color: blue;margin-bottom: 10px;" id="textbox1" label="이벤트 - onitemclick &amp; onselected" escape="false"></w2:textbox>
    	<w2:textbox tagname="h2" style="height: 23px;margin-bottom: 10px;color: blue;" id="textbox2" label="샘플 사용 방법"></w2:textbox>
    	<w2:textbox style="color: blue;margin-bottom: 30px;" id="textbox3"
    		label='1. 목록에서 임의의 항목을 선택. &lt;br/&gt;2. onitemclick 이벤트가 먼저 발생하는 것을 확인. &lt;br/&gt;3. onselected 이벤트가 발생하는 것을 확인.' escape="false">
    	</w2:textbox>
    	<w2:textbox style="padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightgreen;border:none;margin-bottom: 10px;" id="textbox4" label="이벤트 설명&lt;br/&gt;onitemclick - 항목 선택 후 발생.&lt;br/&gt;onselected - onitemclick 이벤트 이후 발생." escape="false">
    	</w2:textbox>
    	<w2:autoComplete submenuSize="auto" caseSensitive="true" chooseOption="" useKeywordHighlight="true"
    		ev:onselected="scwin.autoComplete1_onselected" allOption="" search="contain" ref="" editType="select" style="width: 50%;"
    		id="autoComplete1" useLocale="false" ev:onitemclick="scwin.autoComplete1_onitemclick">
    		<w2:choices>
    			<w2:item>
    				<w2:label><![CDATA[Seoul]]></w2:label>
    				<w2:value><![CDATA[01]]></w2:value>
    			</w2:item>
    			<w2:item>
    				<w2:label><![CDATA[Busan]]></w2:label>
    				<w2:value><![CDATA[02]]></w2:value>
    			</w2:item>
    			<w2:item>
    				<w2:label><![CDATA[Daejeon]]></w2:label>
    				<w2:value><![CDATA[03]]></w2:value>
    			</w2:item>
    			<w2:item>
    				<w2:label><![CDATA[Gwanju]]></w2:label>
    				<w2:value><![CDATA[04]]></w2:value>
    			</w2:item>
    			<w2:item>
    				<w2:label><![CDATA[Incheon]]></w2:label>
    				<w2:value><![CDATA[05]]></w2:value>
    			</w2:item>
    			<w2:item>
    				<w2:label><![CDATA[Jeju]]></w2:label>
    				<w2:value><![CDATA[06]]></w2:value>
    			</w2:item>
    		</w2:choices>
    	</w2:autoComplete>
    </xf:group></body>
</html>
