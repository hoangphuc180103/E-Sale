<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head meta_author="InswaveSystems" meta_type="메인" meta_screenName="[AutoComplete] 선택 목록의 값과 일치하는 값이 입력될 경우, nextTabID 컴포넌트로 포커스를 이동하기">
    	<w2:historyInfo>
			<w2:history meta_no="01" meta_desc="최초작성" meta_date="20230315" meta_user="InswaveSystems" ></w2:history>
			<w2:history meta_no="02" meta_desc="예제 설명 문구 수정" meta_date="20240312" meta_user="InswaveSystems"></w2:history>
			<w2:history meta_no="03" meta_desc="설명부 수정" meta_date="20240621" meta_user="InswaveSystems" ></w2:history>
		</w2:historyInfo>
    	<w2:type>COMPONENT</w2:type>
    	<w2:buildDate />
    	<w2:MSA />
    	<xf:model>
    		<w2:dataCollection baseNode="map">
    		</w2:dataCollection>
    		<w2:workflowCollection />
    	</xf:model>
    	<w2:layoutInfo />
    	<w2:publicInfo method="" />
    	<script lazy="false" type="text/javascript"><![CDATA[
scwin.onpageload = function() {
};]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload">
    	<xf:group class="sub_contents" id="" style="">
    		<xf:group class="ws_example_grp_desc" id="" style="">
    			<w2:textbox escape="false" id=""
    				label="AutoComplete의 검색어 입력 필드에 목록의 항목과 일치하는 값이 입력되면, 'nextTabID' 속성에 설정된 컴포넌트로 포커스가 이동하도록 설정된 예제입니다."
    				style="margin-bottom: 10px;">
    			</w2:textbox>
    		</xf:group>
    		<xf:group class="example_div_tb_style_wrap mb_def" id="" style="">
    			<xf:group class="example_div_tr_style" id="" style="">
    				<xf:group class="example_div_td_style" id="" style="">
    					<w2:textbox class="wre_txt_normal" escape="false" id=""
    						label='검색어 입력 값 예시: red, green, blue'
    						style="">
    					</w2:textbox>
    					<xf:group id="" style="margin-bottom: 15px;">
    						<w2:autoComplete submenuSize="auto" search="start" editType="select" useKeywordHighlight="false"
    							style="width: 210px;" id="acb_1" useLocale="false" class="" allOption="" chooseOption="true" ref="" nextTabID="ibx_2"
    							autoFocus="true" chooseOptionLabel="- 선택 -">
    							<w2:choices>
    								<w2:item>
    									<w2:label><![CDATA[red]]></w2:label>
    									<w2:value><![CDATA[1]]></w2:value>
    								</w2:item>
    								<w2:item>
    									<w2:label><![CDATA[green]]></w2:label>
    									<w2:value><![CDATA[2]]></w2:value>
    								</w2:item>
    								<w2:item>
    									<w2:label><![CDATA[blue]]></w2:label>
    									<w2:value><![CDATA[3]]></w2:value>
    								</w2:item>
    								<w2:item>
    									<w2:label><![CDATA[yellow]]></w2:label>
    									<w2:value><![CDATA[4]]></w2:value>
    								</w2:item>
    								<w2:item>
    									<w2:label><![CDATA[white]]></w2:label>
    									<w2:value><![CDATA[5]]></w2:value>
    								</w2:item>
    								<w2:item>
    									<w2:label><![CDATA[black]]></w2:label>
    									<w2:value><![CDATA[6]]></w2:value>
    								</w2:item>
    							</w2:choices>
    						</w2:autoComplete>
    					</xf:group>
    					<xf:group id="" style="margin-bottom: 15px;">
    						<xf:input adjustMaxLength="false" style="width:210px;" id="ibx_1"></xf:input>
    					</xf:group>
    					<xf:group id="">
    						<xf:input adjustMaxLength="false" style="width:210px;" id="ibx_2" placeholder="이 곳으로 포커스가 이동됩니다."></xf:input>
    					</xf:group>
    				</xf:group>

    			</xf:group>
    		</xf:group>
    	</xf:group>
    </body>
</html>