<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head meta_screenName="openPopup_popupAutoCloseSkip_$p">
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
         <script type="text/javascript" lazy="false"><![CDATA[

scwin.onpageload = function () {
    requires("uiplugin.popup");

};

scwin.onpageunload = function () {

};


scwin.trigger1_onclick = function (e) {
    const tmpSrc = scwin.getfolderPath() + "/source.xml";
    var options = {
        id: "popup1",
        type: "wframePopup",
        height: "400px",
        width: "400px",
        left: "200px",
		popupName : "Parent Popup",	
        popupAutoCloseSkip: true
    };
    $p.openPopup(tmpSrc, options);
};

scwin.getfolderPath = function () {

    var currentPath = window.location.href;
    var folderPath;

    if (currentPath.includes("mainContainer")) {
        console.log("true  ===> " + $p.getFrameId());
        const cmtFrame = $p.getComponentById($p.getFrameId());
        currentPath = cmtFrame.getSrc();
        folderPath = currentPath.substring(0, currentPath.lastIndexOf('/'));
    } else {
        console.log("false  ===> ");
        folderPath = currentPath.split('w2xPath=')[1].substring(0, currentPath.split('w2xPath=')[1].lastIndexOf('/'));
    }
    return folderPath;
};

]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload" ev:onpageunload="scwin.onpageunload">
    <xf:group id="" style="margin: 10px;"><w2:textbox tagname="h1" style="color: blue;margin-bottom: 10px;" id="textbox1" label="Close Parent Popup Only&lt;br/&gt;" escape="false"></w2:textbox><w2:textbox tagname="h2" style="height: 23px;margin-bottom: 10px;color: blue;" id="textbox2" label="How to Use"></w2:textbox><w2:textbox style="color: blue;margin-bottom: 30px;" id="textbox3" label="1. Click the button below.&lt;br/&gt;2. Verify that a popup is generated.&lt;br/&gt;3. Click the button inside the generated popup to create a child popup.&lt;br/&gt;4. Close the parent popup that was created first.&lt;br/&gt;5. Verify that only the parent popup closes and the child popup remains open. (popupAutoCloseSkip: true)" escape="false">
    	</w2:textbox><xf:trigger ev:onclick="scwin.trigger1_onclick" style="display: block;height:42px;line-height:32px;padding:5px;background-color:coral;font-size:15px;weight: bolder;font-weight:bolder;margin-bottom:10px;text-align: left;" id="trigger1" type="button" class="btn_cm">
    		<xf:label><![CDATA[$p.openPopup() - popupAutoCloseSkip: true]]></xf:label>
    	</xf:trigger></xf:group></body>
</html>
