<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head meta_screenName="useNull_DataList">
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            	<w2:dataList baseNode="list" repeatNode="map" id="dataList1" saveRemovedData="true" useNull="true">
            		<w2:columnInfo>
            			<w2:column id="city" name="name1" dataType="text"></w2:column>
            			<w2:column id="code" name="name2" dataType="text"></w2:column>
            		</w2:columnInfo>
            		<w2:data use="true">
            			<w2:row>
            				<city><![CDATA[Seoul]]></city>
            				<code><![CDATA[1]]></code>
            			</w2:row>
            			<w2:row>
            				<city><![CDATA[Busan]]></city>
            				<code><![CDATA[2]]></code>
            			</w2:row>
            			<w2:row>
            				<city><![CDATA[Incheon]]></city>
            				<code><![CDATA[3]]></code>
            			</w2:row>
            			<w2:row>
            				<city><![CDATA[Jeju]]></city>
            				<code><![CDATA[4]]></code>
            			</w2:row>
            		</w2:data>
            	</w2:dataList>
            	<w2:dataList baseNode="list" repeatNode="map" id="dataList2">
            		<w2:columnInfo>
            			<w2:column id="city" name="name1" dataType="text"></w2:column>
            			<w2:column id="code" name="name2" dataType="text"></w2:column>
            		</w2:columnInfo>
            		<w2:data use="true">
            			<w2:row>
            				<city><![CDATA[Paris]]></city>
            				<code><![CDATA[10]]></code>
            			</w2:row>
            			<w2:row>
            				<city><![CDATA[London]]></city>
            				<code><![CDATA[20]]></code>
            			</w2:row>
            			<w2:row>
            				<city><![CDATA[Munchen]]></city>
            				<code><![CDATA[30]]></code>
            			</w2:row>
            			<w2:row>
            				<city><![CDATA[Milan]]></city>
            				<code><![CDATA[40]]></code>
            			</w2:row>
            		</w2:data>
            	</w2:dataList>
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
         <script type="text/javascript" lazy="false"><![CDATA[

scwin.onpageload = function () {

};

scwin.onpageunload = function () {

};


scwin.trigger1_onclick = function (e) {
    dataList1.setData(["Beihing", "", "Taipei", null]);
};

scwin.trigger2_onclick = function (e) {
    dataList2.setData(["Beihing", "", "Taipei", null]);
};]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload" ev:onpageunload="scwin.onpageunload">
    	<xf:group id="" style="margin: 10px;">
    		<w2:textbox tagname="h1" style="color: blue;margin-bottom: 10px;" tabIndex="h1" id="textbox1" label="null 값과 공백 구분"
    			escape="false">
    		</w2:textbox>
    		<w2:textbox tagname="h2" style="height: 23px;margin-bottom: 10px;color: blue;" id="textbox2" label="샘플 사용 방법"></w2:textbox>
    		<w2:textbox style="color: blue;margin-bottom: 30px;" id="textbox3"
    			label='1-1. 하단의 첫 번째 버튼을 클릭하여 공백과 null을 동시에 설정. &lt;br/&gt;1-2. Ctrl + 마우스 우클릭 후, "dataCollection 보기" 메뉴를 선택. &lt;br/&gt;1-3. dataList1에 공백과 null이 구분되어 설정된 것을 확인.&lt;br/&gt;&lt;br/&gt;2-1. 하단의 두 번째 버튼을 클릭하여 공백과 null을 동시에 설정. &lt;br/&gt;2-2. Ctrl + 마우스 우클릭 후, "dataCollection 보기" 메뉴를 선택. &lt;br/&gt;2-3. dataList2에 모두 공백으로 설정된 것을 확인.'
    			escape="false">
    		</w2:textbox>
    		<w2:textbox
    			style="padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightblue;border:none;margin-bottom: 10px;"
    			id="textbox4" label='속성 설정&lt;br/&gt;useNull="true"' escape="false">
    		</w2:textbox>
    		<xf:trigger
    			style="height:42px;line-height:32px;padding:5px;background-color:coral;font-size:15px;weight: bolder;font-weight:bolder;text-align: left;display: block;margin-bottom: 10px;"
    			id="trigger1" type="button" ev:onclick="scwin.trigger1_onclick">
    			<xf:label><![CDATA[dataList1.setData(["Beijing", "", "Taipei", null]);]]></xf:label>
    		</xf:trigger>

    		<w2:gridView checkAllType="false" defaultCellHeight="20" id="gridView1" style="border: solid 1px gray;margin-bottom: 10px;" dataList="data:dataList1"
    			autoFit="allColumn" visibleRowNum="4" visibleRowNumFix="true">
    			<w2:caption style="" id="caption2" value="this is a grid caption."></w2:caption>
    			<w2:header style="" id="header2">
    				<w2:row style="" id="row3">
    					<w2:column width="70" inputType="text" style="" id="column6" value="City" displayMode="label"></w2:column>
    					<w2:column width="70" inputType="text" style="" id="column5" value="Code" displayMode="label"></w2:column>
    				</w2:row>
    			</w2:header>
    			<w2:gBody style="" id="gBody2">
    				<w2:row style="" id="row4">
    					<w2:column width="70" inputType="text" style="" id="city" value="" displayMode="label"></w2:column>
    					<w2:column width="70" inputType="text" style="" id="code" value="" displayMode="label"></w2:column>
    				</w2:row>
    			</w2:gBody>
    		</w2:gridView>
    		<w2:textbox escape="false" id="textbox5" label='속성 설정&lt;br/&gt;useNull="false"'
    			style="padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightblue;border:none;margin-bottom: 10px;">
    		</w2:textbox>
    		<xf:trigger ev:onclick="scwin.trigger2_onclick" id="trigger2"
    			style="height:42px;line-height:32px;padding:5px;background-color:coral;font-size:15px;weight: bolder;font-weight:bolder;text-align: left;display: block;margin-bottom: 10px;"
    			type="button">
    			<xf:label><![CDATA[dataList2.setData(["Beijing", "", "Taipei", null]);]]></xf:label>
    		</xf:trigger>
    		<w2:gridView autoFit="allColumn" checkAllType="false" dataList="data:dataList2" defaultCellHeight="20" id="gridView2"
    			style="border: solid 1px gray" visibleRowNum="4" visibleRowNumFix="true">
    			<w2:caption style="" id="caption1" value="this is a grid caption."></w2:caption>
    			<w2:header style="" id="header1">
    				<w2:row style="" id="row1">
    					<w2:column width="70" inputType="text" style="" id="column2" value="name1" displayMode="label"></w2:column>
    					<w2:column width="70" inputType="text" style="" id="column1" value="name2" displayMode="label"></w2:column>
    				</w2:row>
    			</w2:header>
    			<w2:gBody style="" id="gBody1">
    				<w2:row style="" id="row2">
    					<w2:column width="70" inputType="text" style="" id="city" value="" displayMode="label"></w2:column>
    					<w2:column width="70" inputType="text" style="" id="code" value="" displayMode="label"></w2:column>
    				</w2:row>
    			</w2:gBody>
    		</w2:gridView>
    	</xf:group>
    </body>
</html>
