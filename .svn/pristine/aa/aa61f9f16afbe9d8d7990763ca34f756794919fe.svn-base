      sheetName: "dataList1",
      removeColumns: "",
      wframeId: scId
    }, {
      dataListId: "dataList2",
      sheetName: "dataList2",
      removeColumns: "",
      wframeId: scId
    }]
  };
  WebSquare.util.multipleDataListDownload(options);
};
