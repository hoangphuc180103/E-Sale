<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head meta_screenName="onbeforeselect_SelectBox">
        <w2:type>COMPONENT</w2:type>
        <w2:buildDate/>
        <w2:MSA/>
        <xf:model>
            <w2:dataCollection baseNode="map"/>
            <w2:workflowCollection/>
        </xf:model>
        <w2:layoutInfo/>
        <w2:publicInfo method=""/>
        <script lazy="false" type="text/javascript"><![CDATA[
scwin.onpageload = function () {

};

scwin.select1_onbeforeselect = function (selectedIndex, index) {
    if (selectedIndex < index) {
        return true;
    } else {
        return false;
    }
};
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload">
    <xf:group id="" style="margin: 10px;">
    	<w2:textbox tagname="h1" style="color: blue;margin-bottom: 10px;" tabIndex="h1" id="textbox1" label="イベント - onbeforeselect"
    		escape="false">
    	</w2:textbox>
    	<w2:textbox tagname="h2" style="height: 23px;margin-bottom: 10px;color: blue;" id="textbox2" label="サンプルの使い方"></w2:textbox>
    	<w2:textbox style="color: blue;margin-bottom: 30px;" id="textbox3"
    		label="1. 現在選択値よりインデックス大きいアイテム選択すると選択適用されるもの確認。 &lt;br/&gt;（onbeforeselect イベントハンドラ trueを返す。）&lt;br/&gt;&lt;br/&gt;2. 現在選択値よりインデックス少ないアイテム選択すると選択適用されませんないもの確認。&lt;br/&gt;（onbeforeselect イベントハンドラ falseを返す。）&lt;br/&gt;&lt;br/&gt;（Script タブから onbeforeselect イベントハンドラ確認。）"
    		escape="false">
    	</w2:textbox>
    	<w2:textbox
    		style="padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightgreen;border:none;margin-bottom: 10px;"
    		id="textbox5" label="イベント説明&lt;br/&gt;onbeforeselect - 項目選択時に発生。" escape="false">
    	</w2:textbox>
    	<w2:textbox style="padding:10px; padding-bottom:20px; text-align:left; font-size:15px; font-weight:bolder; border:brown 1px solid; background-color:ivory; margin-bottom:10px; margin-top:10px; color:brown;" id="textbox6" label="/// サンプルコード&lt;br/&gt;&lt;br/&gt;scwin.select1_onbeforeselect = function (selectedIndex, index) {&lt;br/&gt; &amp;nbsp; &amp;nbsp;if(selectedIndex &lt; index) {&lt;br/&gt; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;return true;&lt;br/&gt; &amp;nbsp; &amp;nbsp;} else {&lt;br/&gt; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;return false;&lt;br/&gt; &amp;nbsp; &amp;nbsp;}&lt;br/&gt;};" escape="false">
    	</w2:textbox>
    	<xf:select1 ev:onbeforeselect="scwin.select1_onbeforeselect" submenuSize="auto" ref="" appearance="minimal"
    		disabledClass="w2selectbox_disabled" chooseOption="" style="width: 50%;" disabled="false" id="select1" allOption=""
    		direction="auto">
    		<xf:choices>
    			<xf:item>
    				<xf:label><![CDATA[1]]></xf:label>
    				<xf:value><![CDATA[1]]></xf:value>
    			</xf:item>
    			<xf:item>
    				<xf:label><![CDATA[2]]></xf:label>
    				<xf:value><![CDATA[2]]></xf:value>
    			</xf:item>
    			<xf:item>
    				<xf:label><![CDATA[3]]></xf:label>
    				<xf:value><![CDATA[3]]></xf:value>
    			</xf:item>
    			<xf:item>
    				<xf:label><![CDATA[4]]></xf:label>
    				<xf:value><![CDATA[4]]></xf:value>
    			</xf:item>
    			<xf:item>
    				<xf:label><![CDATA[5]]></xf:label>
    				<xf:value><![CDATA[5]]></xf:value>
    			</xf:item>
    			<xf:item>
    				<xf:label><![CDATA[6]]></xf:label>
    				<xf:value><![CDATA[6]]></xf:value>
    			</xf:item>
    			<xf:item>
    				<xf:label><![CDATA[7]]></xf:label>
    				<xf:value><![CDATA[7]]></xf:value>
    			</xf:item>
    		</xf:choices>
    	</xf:select1>
    </xf:group></body>
</html>
