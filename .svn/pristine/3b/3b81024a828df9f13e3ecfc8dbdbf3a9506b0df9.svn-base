<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet href="/2019-09/Components/gridview.css" type="text/css"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
        	<xf:instance>
        		<data xmlns="" />
        	</xf:instance>
        	<w2:dataCollection baseNode="map">
        		<w2:dataList baseNode="list" repeatNode="map" id="dataList1" saveRemovedData="true">
        			<w2:columnInfo>
        				<w2:column id="Check" name="Check" dataType="text"></w2:column>
        				<w2:column id="ID" name="ID" dataType="text"></w2:column>
        				<w2:column id="Age" name="Age" dataType="text"></w2:column>
        				<w2:column id="Status" name="Status" dataType="text"></w2:column>
        				<w2:column id="Income" name="Income" dataType="text"></w2:column>
        				<w2:column id="Expense" name="Expense" dataType="text"></w2:column>
        				<w2:column id="Hobby" name="Hobby" dataType="text"></w2:column>
        				<w2:column id="Region" name="Region" dataType="text"></w2:column>
        				<w2:column id="Frequency" name="Frequency" dataType="text"></w2:column>
        				<w2:column id="Date" name="Date" dataType="text"></w2:column>
        			</w2:columnInfo>
        		</w2:dataList>
        		<w2:dataList baseNode="list" repeatNode="map" id="dataList2" saveRemovedData="true">
        			<w2:columnInfo>
        				<w2:column id="label" name="label" dataType="text"></w2:column>
        				<w2:column id="value" name="value" dataType="text"></w2:column>
        				<w2:column id="col3" name="name3" dataType="text"></w2:column>
        			</w2:columnInfo>
        			<w2:data use="true">
        				<w2:row>
        					<label><![CDATA[Single]]></label>
        					<value><![CDATA[Single]]></value>
        					<col3><![CDATA[true]]></col3>
        				</w2:row>
        				<w2:row>
        					<label><![CDATA[Divorced]]></label>
        					<value><![CDATA[Divorced]]></value>
        					<col3><![CDATA[true]]></col3>
        				</w2:row>
        				<w2:row>
        					<label><![CDATA[Married]]></label>
        					<value><![CDATA[Married]]></value>
        					<col3><![CDATA[true]]></col3>
        				</w2:row>
        				<w2:row>
        					<label><![CDATA[None]]></label>
        					<value><![CDATA[None]]></value>
        					<col3><![CDATA[false]]></col3>
        				</w2:row>
        			</w2:data>
        		</w2:dataList>
        	</w2:dataCollection>
        	<w2:workflowCollection></w2:workflowCollection>
        	<xf:submission id="submission1" ref="" target='data:json,dataList1' action="data.json" method="post"
        		mediatype="application/json" encoding="UTF-8" instance="" replace="" errorHandler="" customHandler="" mode="asynchronous"
        		processMsg="" ev:submit="" ev:submitdone="" ev:submiterror="" abortTrigger="">
        	</xf:submission>
        	<xf:submission id="submission2" ref="" target="" action="" method="post" mediatype="application/json" encoding="UTF-8"
        		instance="" replace="" errorHandler="" customHandler="" mode="asynchronous" processMsg="" ev:submit="" ev:submitdone=""
        		ev:submiterror="" abortTrigger="">
        	</xf:submission>
        </xf:model>
        <script type="text/javascript" lazy="false"><![CDATA[

scwin.onpageload = function () {
    var objSubmission = $p.getSubmission("submission1");
    objSubmission.action = scwin.getfolderPath() + '/data.json';

    $p.executeSubmission("submission1");
};

scwin.onpageunload = function () {

};

function fn1() {
    gridview1.setCellInputType(0, "Age", {
        inputType: "spinner",
        options: {
            viewType: "icon"
        }
    });
}

scwin.trigger1_onclick = function (e) {
    fn1();
};


function fn2() {
    gridview1.setCellInputType(0, "Date", {
        inputType: "calendar",
        options: {
            imageSrc: "",
            viewType: "icon"
        }
    });
}

scwin.trigger2_onclick = function (e) {
    fn2();
};

scwin.getfolderPath = function () {

    var currentPath = window.location.href;
    var folderPath;

    if (currentPath.includes("mainContainer")) {
        console.log("true  ===> " + $p.getFrameId());
        const cmtFrame = $p.getComponentById($p.getFrameId());
        currentPath = cmtFrame.getSrc();
        folderPath = currentPath.substring(0, currentPath.lastIndexOf('/'));
    } else {
        console.log("false  ===> ");
        folderPath = currentPath.split('w2xPath=')[1].substring(0, currentPath.split('w2xPath=')[1].lastIndexOf('/'));
    }
    return folderPath;
};
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload" ev:onpageunload="scwin.onpageunload">
    <xf:group id="" style="margin: 10px;">
    	<w2:textbox tagname="h1" style="color: blue;margin-bottom: 10px;" tabIndex="h1" id="textbox1" label="셀의 inputType 동적 변경"
    		escape="false">
    	</w2:textbox>
    	<w2:textbox tagname="h2" style="height: 23px;margin-bottom: 10px;color: blue;" id="textbox2" label="샘플 사용 방법"></w2:textbox>
    	<w2:textbox style="color: blue;margin-bottom: 30px;" id="textbox3"
    		label='1. 하단의 &amp;nbsp;첫 번째 버튼을 클릭. &lt;br/&gt;2. index="0" 행의 "Age" 컬럼의 셀의 inputType이 변경되는 것을 확인. &lt;br/&gt;3. 하단의 두 번째 버튼을 클릭. &lt;br/&gt;4. index="0" 행의 "Date" 컬럼의 셀의 inputType이 변경되는 것을 확인.&lt;br/&gt;(자세한 스크립트는 Script 탭에서 확인.)'
    		escape="false">
    	</w2:textbox>
    	<w2:textbox
    		style="padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightblue;border:none;margin-bottom: 10px;"
    		id="textbox4" label='속성 설정&lt;br/&gt;setCellInputTypeCustom="true" (GridView)&lt;br/&gt;inputType="custom" (Age 컬럼 &amp; Date 컬럼)'
    		escape="false">
    	</w2:textbox>
    	<xf:trigger ev:onclick="scwin.trigger1_onclick"
    		style="height:42px;line-height:32px;padding:5px;background-color:coral;font-size:15px;weight: bolder;font-weight:bolder;text-align: left;display: block;margin-bottom: 10px;"
    		id="trigger1" type="button">
    		<xf:label><![CDATA[gridview1.setCellInputType(0, "Age", {info});]]></xf:label>
    	</xf:trigger>
    	<xf:trigger ev:onclick="scwin.trigger2_onclick"
    		style="height:42px;line-height:32px;padding:5px;background-color:coral;font-size:15px;weight: bolder;font-weight:bolder;text-align: left;display: block;margin-bottom: 10px;"
    		id="trigger2" type="button">
    		<xf:label><![CDATA[gridview1.setCellInputType(0, "Date", {info});]]></xf:label>
    	</xf:trigger>
    	<w2:gridView showSortableUseFilter="" scrollByColumnAdaptive="false" editModeEvent="ondblclick" rowNumVisible=""
    		showSortableImage="" selectedRowColor="#0000FF" useCtrlOnMultisort="true" scrollByColumn="false" focusFlow="default"
    		noResultMessageStyle="width: 90%;height: 50%;margin-left: 30px;" sortable="" defaultCellHeight="30" setCellInputTypeCustom="true"
    		rowStatusVisible="" focusMode="none" dataList="data:dataList1" keyMoveEditMode="true" style="border: solid gray 1px;"
    		sortedIconPosition="" id="gridview1" autoFit="allColumn" visibleRowNum="10" class="" visibleRowNumFix="true">
    		<w2:caption style="" id="caption1" value="this is a grid caption."></w2:caption>
    		<w2:header style="" id="header1">
    			<w2:row style="height: 25px;" id="row1">
    				<w2:column removeBorderStyle="false" width="70" inputType="text" style="height:20px;" id="column19" value="Check"
    					blockSelect="false" displayMode="label">
    				</w2:column>
    				<w2:column removeBorderStyle="false" width="70" inputType="text" style="height:20px;" id="column17" value="ID"
    					blockSelect="false" displayMode="label">
    				</w2:column>
    				<w2:column width="70" inputType="text" style="" id="column4" value="Age" displayMode="label"></w2:column>
    				<w2:column removeBorderStyle="false" width="70" inputType="text" style="height:20px;" id="column7" sortable=""
    					value="Hobby" blockSelect="false" displayMode="label">
    				</w2:column>
    				<w2:column removeBorderStyle="false" width="70" inputType="text" style="height:20px;" id="column5" sortable=""
    					value="Region" blockSelect="false" displayMode="label">
    				</w2:column>
    				<w2:column width="70" inputType="text" style="" id="column14" value="Date" displayMode="label"></w2:column>
    			</w2:row>
    		</w2:header>
    		<w2:gBody style="" id="gBody1">
    			<w2:row style="height: 12px;" id="row2">
    				<w2:column removeBorderStyle="false" width="70" inputType="checkbox" style="height:20px" id="Check" value=""
    					blockSelect="false" displayMode="label">
    				</w2:column>
    				<w2:column removeBorderStyle="false" width="70" inputType="text" style="height:20px" id="ID" value=""
    					blockSelect="false" displayMode="label">
    				</w2:column>
    				<w2:column width="70" inputType="custom" style="height:20px;" id="Age" value="" displayMode="label"></w2:column>
    				<w2:column typeGetter="" removeBorderStyle="false" width="70" inputType="" style="height:20px" id="Hobby"
    					sortable="true" value="" blockSelect="false" displayMode="label">
    				</w2:column>
    				<w2:column removeBorderStyle="false" width="70" inputType="" style="height:20px" id="Region" value=""
    					blockSelect="false" displayMode="label">
    				</w2:column>
    				<w2:column width="70" inputType="custom" style="" id="Date" value="" displayMode="label"></w2:column>
    			</w2:row>
    		</w2:gBody>
    	</w2:gridView>
    	<w2:textbox escape="false" id="textbox5"
    		label='//// 샘플 코드 1&lt;br/&gt;&lt;br/&gt; gridview1.setCellInputType(0, "Age", {&lt;br/&gt; &amp;nbsp; &amp;nbsp; inputType: "spinner",&lt;br/&gt; &amp;nbsp; &amp;nbsp; options: {&lt;br/&gt; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; viewType: "icon"&lt;br/&gt; &amp;nbsp; &amp;nbsp; }&lt;br/&gt; });&lt;br/&gt;&lt;br/&gt;/// 샘플 코드 2&lt;br/&gt;&lt;br/&gt;gridview1.setCellInputType(0, "Date", {&lt;br/&gt; &amp;nbsp; &amp;nbsp;inputType: "calendar",&lt;br/&gt; &amp;nbsp; &amp;nbsp;options: {&lt;br/&gt; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;imageSrc: "",&lt;br/&gt; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;viewType: "icon"&lt;br/&gt; &amp;nbsp; &amp;nbsp;}&lt;br/&gt;});&lt;br/&gt;'
    		style="padding:10px; padding-bottom:20px; text-align:left; font-size:15px; font-weight:bolder; border:brown 1px solid; background-color:ivory; margin-bottom:10px; margin-top:10px; color:brown;">
    	</w2:textbox>
    </xf:group></body>
</html>
