define({declaration:{A:{version:'1.0',encoding:'UTF-8'}},E:[{T:1,N:'html',A:{xmlns:'http://www.w3.org/1999/xhtml','xmlns:ev':'http://www.w3.org/2001/xml-events','xmlns:w2':'http://www.inswave.com/websquare','xmlns:xf':'http://www.w3.org/2002/xforms'},E:[{T:1,N:'head',E:[{T:1,N:'w2:type',E:[{T:3,text:'DEFAULT'}]},{T:1,N:'w2:buildDate'},{T:1,N:'xf:model',E:[{T:1,N:'w2:dataCollection',A:{baseNode:'map'}},{T:1,N:'w2:workflowCollection'}]},{T:1,N:'script',A:{type:'text/javascript',lazy:'false'},E:[{T:4,cdata:function(scopeObj){with(scopeObj){scwin.onpageload = function () {
  var tmpSrc = scwin.getfolderPath() + "/src.xml";
  var options = {
    title: "title",
    iconUrl: null,
    src: tmpSrc,
    windowTitle: "windowTitle of the window",
    windowId: "id of the window",
    frameMode: "wframe"
  };
  windowContainer1.createWindow(options);
  windowContainer1.setArrangeWindows("cascade");
};
scwin.onpageunload = function () {};
scwin.onminimizebtnclick = function (info) {
  alert("onminimizebtnclick\n\n" + "src : " + info.src + "\ntitle : " + info.title + "\nwindowTitle : " + info.windowTitle + "\nid : " + info.id + "\nwindowId : " + info.windowId);
};
scwin.onrestorebtnclick = function (info) {
  alert("onrestorebtnclick\n\n" + "src : " + info.src + "\ntitle : " + info.title + "\nwindowTitle : " + info.windowTitle + "\nid : " + info.id + "\nwindowId : " + info.windowId);
};
scwin.getfolderPath = function () {
  var currentPath = window.location.href;
  var folderPath;
  if (currentPath.includes("mainContainer")) {
    console.log("true  ===> " + $p.getFrameId());
    const cmtFrame = $p.getComponentById($p.getFrameId());
    currentPath = cmtFrame.getSrc();
    folderPath = currentPath.substring(0, currentPath.lastIndexOf('/'));
  } else {
    console.log("false  ===> ");
    folderPath = currentPath.split('w2xPath=')[1].substring(0, currentPath.split('w2xPath=')[1].lastIndexOf('/'));
  }
  return folderPath;
};
}}}]},{T:1,N:'style',A:{type:'text/css'}}]},{T:1,N:'body',A:{'ev:onpageload':'scwin.onpageload','ev:onpageunload':'scwin.onpageunload'},E:[{T:1,N:'xf:group',A:{id:'',style:'margin: 10px;'},E:[{T:1,N:'w2:textbox',A:{tagname:'h1',style:'color: blue;margin-bottom: 10px;',tabIndex:'h1',id:'textbox1',label:'イベント - onminimizebtnclick & onrestorebtnclick',escape:'false'}},{T:1,N:'w2:textbox',A:{tagname:'h2',style:'height: 23px;margin-bottom: 10px;color: blue;',id:'textbox2',label:'サンプルの使い方'}},{T:1,N:'w2:textbox',A:{style:'color: blue;margin-bottom: 30px;',id:'textbox3',label:'1. 生成されたウィンドウの最小化ボタンをクリックします。 <br/>2. onminimizebtnclick イベントハンドラが実行されていることを確認します。 <br/>3.作成されたウィンドウの復元ボタンをクリックします。 <br/>4. onrestorebtnclick イベントハンドラが実行されていることを確認します。 <br/>（各イベントハンドラの詳細スクリプトは Script タブで確認。）',escape:'false'}},{T:1,N:'w2:textbox',A:{style:'padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightgreen;border:none;margin-bottom: 10px;',id:'textbox4',label:'イベント説明<br/>onminimizebtnclick - ウィンドウサイズを最小化するボタンをクリックしたときに発生します。 <br/>onrestorebtnclick - ウィンドウサイズを復元するボタンをクリックしたときに発生します。',escape:'false'}},{T:1,N:'w2:windowContainer',A:{sequentialArrangeColNum:'2',sequentialArrangeRowNum:'2','ev:onwindowload':'',fixArrangeFullScreen:'false',frameMode:'wframe',useFixButton:'false',windowAutoResize:'false',useWindowScrollButton:'true',processMsgFrame:'true',verticalArrangeNum:'2',windowMaxNum:'10','ev:onclosewindow':'scwin.wcMain_onclosewindow',useCloseButton:'true',controlIconPosition:'allright',nameLayerMove:'true',toolbarPosition:'top',windowMaximizeAll:'false',stopMinimizeOnNameLayer:'true',id:'windowContainer1',useStatusMsg:'false',class:'',hideTitleOnMaximize:'false','ev:onrestorebtnclick':'scwin.onrestorebtnclick',windowScrollVisibleRowNum:'3',spaInitCount:'0',stopToggleOnLast:'true',useNameContainer:'true','ev:onbeforecloseall':'scwin.wcMain_onbeforecloseall',closeType:'noneFixedWindow','ev:onminimizebtnclick':'scwin.onminimizebtnclick',horizontalArrangeNum:'2',u