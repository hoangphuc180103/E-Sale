  // DataList에 초기 데이터 할당
  scwin.initData();
};

/**
 * DataList 'dlt_exam_1'에 데이터 할당하기
 */
scwin.initData = function () {
  let data = [{
    "category": "Networking",
    "product": "SpeedLink"
  }, {
    "category": "Support Services",
    "product": "TechAssist"
  }, {
    "category": "Servers",
    "product": "EcoServe"
  }, {
    "category": "Cloud Services",
    "product": "CloudPro"
  }, {
    "category": "Support Services",
    "product": "TeamTech"
  }, {
    "category": "Security",
    "product": "SecureGate"
  }, {
    "category": "Networking",
    "product": "LinkSecure"
  }, {
    "category": "Servers",
    "product": "ServeTech"
  }];

  // DataList 'dlt_exam_1'과 'dlt_exam_2'에 데이터 할당하기
  dlt_exam_1.setJSON(data);
  dlt_exam_2.setJSON(data);
  let data2 = [{
    "dataType_text": "777",
    "dataType_number": "777"
  }, {
    "dataType_text": "9",
    "dataType_number": "9"
  }, {
    "dataType_text": "18000",
    "dataType_number": "18000"
  }];
  dlt_dataType.setJSON(data2);
};

/**
 * 버튼 [DataList의 데이터 초기화] 클릭 시
 */
scwin.btn_initData_onclick = function (e) {
  scwin.initData();
};

/**
 * 버튼 [1.0 DataList의 정렬 해제] 클릭 시
 */
scwin.btn_sortInit_1_onclick = function (e) {
  // DataList 'dlt_exam_1'의 정렬을 해제합니다.
  dlt_exam_1.clearSort();
};

/**
 * 버튼 [1.1 'Category' 컬럼을 오름차순으로 정렬하기] 클릭 시
 */
scwin.btn_exam1_1_onclick = function (e) {
  // DataList 'dlt_exam_1'의 정렬을 해제합니다.
  dlt_exam_1.clearSort();

  // DataList 'dlt_exam_1'의 'Category' 컬럼을 오름차순으로 정렬합니다.
  dlt_exam_1.sort("category", 0); // 정렬 옵션 [0,1,2] 0:오름차순, 1:내림차순, 2:정렬 취소
};

/**
 * 버튼 [1.2 'Product' 컬럼을 내림차순으로 정렬하기] 클릭 시
 */
scwin.btn_exam1_2_onclick = function (e) {
  // DataList 'dlt_exam_1'의 정렬을 해제합니다.
  dlt_exam_1.clearSort();

  // DataList 'dlt_exam_1'의 'Product' 컬럼을 내림차순으로 정렬합니다.
  dlt_exam_1.sort("product", 1); // 정렬 옵션 [0,1,2] 0:오름차순, 1:내림차순, 2:정렬 취소
};

/**
 * 버튼 [2.0 DataList의 정렬 해제] 클릭 시
 */
scwin.btn_sortInit_2_onclick = function (e) {
  // DataList 'dlt_exam_2'의 정렬을 해제합니다.
  dlt_exam_2.clearSort();
};

/**
 * 버튼 [2.1 'Category' 컬럼을 오름차순으로, 'Product' 컬럼을 내림차순으로 정렬하기] 클릭 시
 */
scwin.btn_exam2_1_onclick = function (e) {
  // DataList 'dlt_exam_2'의 정렬을 해제합니다.
  dlt_exam_2.clearSort();

  // DataList 'dlt_exam_2'의 'Category' 컬럼을 오름차순으로, 'Product' 컬럼을 내림차순으로 정렬합니다.
  let options = {};
  options.sortIndex = "category product"; // DataList의 컬럼 ID 또는 Index. 공백으로 컬럼을 구분합니다.
  options.sortOrder = "1 -1"; // 정렬 기준으로 공백으로 구분합니다. 1:오름차순, -1:내림차순

  dlt_exam_2.multisort(options);
};

/**
 * 버튼 [3.0 DataList의 정렬 해제] 클릭 시
 */
scwin.btn_sortInit_3_onclick = function (e) {
  // DataList 'dlt_dataType'의 정렬을 해제합니다.
  dlt_dataType.clearSort();
};

/**
 * 버튼 [3.1 컬럼 'dataType="text"'를 오름차순으로 정렬하기] 클릭 시
 */
scwin.btn_exam3_1_onclick = function (e) {
  // DataList 'dlt_dataType'의 정렬을 해제합니다.
  dlt_dataType.clearSort();

  // DataList 'dlt_dataType'의 컬럼 ID 'dataType_text'의 'dataType' 속성의 설정 값은 'text'입니다.
  // DataList 'dlt_dataType'의 컬럼 'dataType="text"'를 오름차순으로 정렬합니다.
  dlt_dataType.sort("dataType_text", 0); // 정렬 옵션 [0,1,2] 0:오름차순, 1:내림차순, 2:정렬 취소
};

/**
 * 버튼 [3.2 컬럼 'dataType="number"'를 오름차순으로 정렬하기] 클릭 시
 */
scwin.btn_exam3_2_onclick = function (e) {
  // DataList 'dlt_dataType'의 정렬을 해제합니다.
  dlt_dataType.clearSort();

  // DataList 'dlt_dataType'의 컬럼 ID 'dataType_number'의 'dataType' 속성의 설정 값은 'number'입니다.
  // DataList 'dlt_dataType'의 컬럼 'dataType="number"'를 오름차순으로 정렬합니다.
  dlt_dataType.sort("dataType_number", 0); // 정렬 옵션 [0,1,2] 0:오름차순, 1:내림차순, 2:정렬 취소
};
