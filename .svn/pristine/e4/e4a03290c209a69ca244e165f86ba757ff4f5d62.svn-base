  var objSubmission = $p.getSubmission("submission1");
  objSubmission.action = scwin.getfolderPath() + '/dlt_user.json';
  $p.executeSubmission("submission1");
};
scwin.btn_search_onclick = function (e) {
  dlt_user.clearFilter();
  var title = radio_title.getText();
  var dept = select_dept.getValue();
  var date = inputCal_year.getValue();
  dlt_user.setColumnFilter({
    type: 'row',
    colIndex: 'EMP_TITLE',
    key: title,
    condition: 'and'
  });
  dlt_user.setColumnFilter({
    type: 'row',
    colIndex: 'EMP_DEPT',
    key: dept,
    condition: 'and'
  });
  dlt_user.setColumnFilter({
    type: 'row',
    colIndex: 'EMP_JOIN_DATE',
    key: date,
    condition: 'and'
  });
  var count = dlt_user.getRowCount();
  text_total.setValue(count);
};
scwin.btn_init_onclick = function (e) {
  dlt_user.clearFilter();
  radio_title.reset();
  select_dept.setValue(-1);
  inputCal_year.setValue("");
  var count = dlt_user.getRowCount();
  text_total.setValue(count);
};
scwin.btn_add_onclick = function (e) {
  var focused = gridView1.getFocusedRowIndex();
  dlt_user.insertRow(focused);
  var count = dlt_user.getRowCount();
  text_total.setValue(count);
};
scwin.btn_delete_onclick = function (e) {
  var checked = gridView1.getCheckedIndex("CHECK");
  dlt_user.deleteRows(checked);
  var count = dlt_user.getRowCount();
  text_total.setValue(count);
};
scwin.btn_remove_onclick = function (e) {
  var checked = gridView1.getCheckedIndex("CHECK");
  dlt_user.removeRows(checked);
  var count = dlt_user.getRowCount();
  text_total.setValue(count);
};
scwin.btn_download_onclick = function (e) {
  gridView1.advancedExcelDownload([]);
};
scwin.submission1_submitdone = function (e) {
  var count = dlt_user.getRowCount();
  text_total.setValue(count);
  gridView1.setFocusedCell(0, "EMP_NAME");
};
scwin.getfolderPath = function () {
  var currentPath = window.location.href;
  var folderPath;
  if (currentPath.includes("mainContainer")) {
    console.log("true  ===> " + $p.getFrameId());
    const cmtFrame = $p.getComponentById($p.getFrameId());
    currentPath = cmtFrame.getSrc();
    folderPath = currentPath.substring(0, currentPath.lastIndexOf('/'));
  } else {
    console.log("false  ===> ");
    folderPath = currentPath.split('w2xPath=')[1].substring(0, currentPath.split('w2xPath=')[1].lastIndexOf('/'));
  }
  return folderPath;
};
scwin.downloadFile = function (tmpSrc, name) {
  const link = document.createElement('a');
  link.href = tmpSrc;
  link.download = name;
  link.click();
};
scwin.trigger1_onclick = function (e) {
  var tmpSrc = scwin.getfolderPath() + "/user_info.xml";
  var name = "user_info.xml";
  scwin.downloadFile(tmpSrc, name);
};
scwin.trigger2_onclick = function (e) {
  var tmpSrc = scwin.getfolderPath() + "/dlt_user.json";
  var name = "dlt_user.json";
  scwin.downloadFile(tmpSrc, name);
};
