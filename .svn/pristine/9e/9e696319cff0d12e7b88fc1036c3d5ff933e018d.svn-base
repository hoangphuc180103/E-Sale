<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            	<w2:dataList baseNode="list" id="dataList1" repeatNode="map" saveRemovedData="true" style="margin: 100px;">
            		<w2:columnInfo>
            			<w2:column dataType="text" id="Code" name="name1"></w2:column>
            			<w2:column dataType="text" id="City" name="name2"></w2:column>
            			<w2:column dataType="text" id="Country" name="name3"></w2:column>
            			<w2:column dataType="text" id="Type" name="name4"></w2:column>
            		</w2:columnInfo>
            	</w2:dataList>
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
         <script type="text/javascript" lazy="false"><![CDATA[
        
	scwin.onpageload = function() {
		var json = [
			{"Code" : "SEL", "City" : "Seoul, the largest city in Korea", "Country" : "Korea", "Type" : "Domestic"},
			{"Code" : "BSN", "City" : "Busan, the second largest city in Korea", "Country" : "Korea", "Type" : "Domestic"},
			{"Code" : "ICN", "City" : "Incheon, the gateway to Korea", "Country" : "Korea", "Type" : "Domestic"},
			{"Code" : "DJN", "City" : "Daejeon, the government city of Korea", "Country" : "Korea", "Type" : "Domestic"},
			{"Code" : "DGU", "City" : "Jeju, the largest island in Korea", "Country" : "Korea", "Type" : "Domestic"},
			{"Code" : "OTW", "City" : "Ottawa in Canada", "Country" : "Canada", "Type" : "Overseas"},
			{"Code" : "LDN", "City" : "Toronto in Canada", "Country" : "Canada", "Type" : "Overseas"},
			{"Code" : "BRN", "City" : "Berlin in Germany", "Country" : "Germany", "Type" : "Overseas"},
			{"Code" : "BJG", "City" : "Beijing in China", "Country" : "China", "Type" : "Overseas"},
			{"Code" : "LDN", "City" : "London in GB", "Country" : "UK", "Type" : "Overseas"},
			];
		dataList1.setJSON(json);	
		
	};
	
	scwin.onpageunload = function() {
		
	};
	]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload" ev:onpageunload="scwin.onpageunload">
    <xf:group id="" style="margin: 10px;" tooltipDisplay="true">
    	<w2:textbox escape="false" id="textbox1" label="선택 목록 혹은 항목 위에 툴팁 표시" style="color: blue;margin-bottom: 10px;" tabIndex="h1"
    		tagname="h1">
    	</w2:textbox>
    	<w2:textbox id="textbox2" label="샘플 사용 방법" style="height: 23px;margin-bottom: 10px;color: blue;" tagname="h2"></w2:textbox>
    	<w2:textbox escape="false" id="textbox3"
    		label='(첫 번째 SelectBox)&lt;br/&gt;1. 목록을 열고 각 항목에 마우스 커서를 이동. &amp;nbsp;&lt;br/&gt;2. 목록 위에 툴팁이 표시되는 것을 확인. (itemTooltipDisplay="true")&lt;br/&gt;3. 항목 선택 후 SelectBox 닫기. &lt;br/&gt;4. 선택된 항목 위에 마우스 커서를 이동. &lt;br/&gt;5. 항목 위에 툴팁이 표시되는 것을 확인. (tooltipDisplay="true")&lt;br/&gt;&lt;br/&gt;(첫 번째 SelectBox)&lt;br/&gt;1. 목록을 열고 각 항목에 마우스 커서를 이동. &amp;nbsp;&lt;br/&gt;2. 목록 위에 툴팁이 표시되지 않는 것을 확인. (itemTooltipDisplay="false")&lt;br/&gt;3. 항목 선택 후 SelectBox 닫기. &lt;br/&gt;4. 선택된 항목 위에 마우스 커서를 이동. &lt;br/&gt;5. 항목 위에 툴팁이 표시되지 않는 것을 확인. (tooltipDisplay="false")'
    		style="color: blue;margin-bottom: 30px;">
    	</w2:textbox>
    	<w2:textbox escape="false" id="textbox4" label='속성 설정&lt;br/&gt;tooltipDisplay="true" &lt;br/&gt;itemTooltipDisplay="true"'
    		style="padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightblue;border:none;margin-bottom: 10px;">
    	</w2:textbox>
    	<xf:select1 enableColumn="" useItemLocale="" labelWidthAuto="" chooseOption="" tooltip="" allOption="" tooltipLocaleRef="true"
    		ref="" appearance="minimal" enableColumnFalseValue="" tooltipDisplay="true" disabledClass="w2selectbox_disabled" style="width: 50%;margin-bottom: 10px;"
    		id="select1" class="" direction="auto" itemTooltipDisplay="true" tooltipShowAlways="true">
    		<xf:choices>
    			<xf:itemset nodeset="data:dataList1">
    				<xf:label ref="City"></xf:label>
    				<xf:value ref="Code"></xf:value>
    			</xf:itemset>
    		</xf:choices>
    	</xf:select1>
    	<w2:textbox escape="false" id="textbox5" label='속성 설정&lt;br/&gt;tooltipDisplay="false" &lt;br/&gt;itemTooltipDisplay="false"'
    		style="padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightblue;border:none;margin-bottom: 10px;">
    	</w2:textbox>
    	<xf:select1 allOption="" appearance="minimal" chooseOption="" class="" direction="auto" disabledClass="w2selectbox_disabled"
    		enableColumn="" enableColumnFalseValue="" id="selectbox1" labelWidthAuto="" ref="" style="width: 50%;"
    		tooltip="" tooltipShowAlways="false" useItemLocale="">
    		<xf:choices>
    			<xf:itemset nodeset="data:dataList1">
    				<xf:label ref="City"></xf:label>
    				<xf:value ref="Code"></xf:value>
    			</xf:itemset>
    		</xf:choices>
    	</xf:select1>
    </xf:group></body>
</html>
