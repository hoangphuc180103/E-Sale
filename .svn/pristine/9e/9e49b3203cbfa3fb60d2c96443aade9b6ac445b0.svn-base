<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet href="/2019-09/Components/gridview.css" type="text/css"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head meta_vertical_guides="" meta_horizontal_guides="">
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
        	<xf:instance>
        		<data xmlns="" />
        	</xf:instance>
        	<w2:dataCollection baseNode="map">
        		<w2:dataList baseNode="list" repeatNode="map" id="dataList1" saveRemovedData="true">
        			<w2:columnInfo>
        				<w2:column id="Check" name="Check" dataType="text"></w2:column>
        				<w2:column id="ID" name="ID" dataType="text"></w2:column>
        				<w2:column id="Age" name="Age" dataType="text"></w2:column>
        				<w2:column id="Status" name="Status" dataType="text"></w2:column>
        				<w2:column id="Income" name="Income" dataType="text"></w2:column>
        				<w2:column id="Expense" name="Expense" dataType="text"></w2:column>
        				<w2:column id="Hobby" name="Hobby" dataType="text"></w2:column>
        				<w2:column id="New" name="New" dataType="text"></w2:column>
        				<w2:column id="Frequency" name="Frequency" dataType="text"></w2:column>
        				<w2:column id="Date" name="Date" dataType="text"></w2:column>
        			</w2:columnInfo>
        			<w2:data use="true">
        				<w2:row>
        					<Check><![CDATA[2]]></Check>
        					<ID><![CDATA[id]]></ID>
        					<Age><![CDATA[20]]></Age>
        					<Status><![CDATA[C]]></Status>
        					<Income><![CDATA[20240122]]></Income>
        					<Expense><![CDATA[20240122]]></Expense>
        					<Hobby><![CDATA[20240122]]></Hobby>
        					<New><![CDATA[20240122]]></New>
        					<Frequency><![CDATA[20240122]]></Frequency>
        					<Date><![CDATA[20240122]]></Date>
        				</w2:row>
        				<w2:row>
        					<Check><![CDATA[2]]></Check>
        					<ID><![CDATA[id2]]></ID>
        					<Age><![CDATA[40]]></Age>
        					<Status><![CDATA[U]]></Status>
        					<Income><![CDATA[20240122]]></Income>
        					<Expense><![CDATA[20240122]]></Expense>
        					<Hobby><![CDATA[20240122]]></Hobby>
        					<New><![CDATA[20240122]]></New>
        					<Frequency><![CDATA[20240122]]></Frequency>
        					<Date><![CDATA[20240122]]></Date>
        				</w2:row>
        			</w2:data>
        		</w2:dataList>
        	</w2:dataCollection>
        	<w2:workflowCollection></w2:workflowCollection>
        </xf:model>
        <script type="text/javascript" lazy="false"><![CDATA[

scwin.onpageload = function () {
    gridView1.setColumnStyle("Date", "color", "red");
};

scwin.onpageunload = function () {

};


scwin.trigger1_onclick = function (e) {
    var first = gridView1.getDataType("ID");
    var second = gridView1.getDataType("Age");
    var third = gridView1.getDataType("Date");
    alert("ID : " + first + " , Age : " + second + " , Date : " + third + " ");
};

scwin.trigger2_onclick = function (e) {
    var options = {
        displayFormat: "dd/MM/yyyy"
    };
    gridView1.setDataType("Date", "date", options);

};
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload" ev:onpageunload="scwin.onpageunload">
    <xf:group id="" style="margin: 10px;">
    	<w2:textbox tagname="h1" style="color: blue;margin-bottom: 10px;" tabIndex="h1" id="textbox1" label='컬럼에 datatType="date" 설정하기'
    		escape="false">
    	</w2:textbox>
    	<w2:textbox tagname="h2" style="height: 23px;margin-bottom: 10px;color: blue;" id="textbox2" label="샘플 사용 방법"></w2:textbox>
    	<w2:textbox style="color: blue;margin-bottom: 30px;" id="textbox3"
    		label='1. 하단의 getDataType() 버튼을 클릭하여 각 컬럼의 dataTye을 확인.&lt;br/&gt;2. 하단의 setDataType() 버튼을 클릭. &amp;nbsp;&lt;br/&gt;3. "Date" 컬럼의 데이터가 지정한 포맷으로 표시되는 것을 확인.&lt;br/&gt;4. 하단의 getDataType() 버튼을 다시 클릭하여 "Date" 컬럼의 dataType이 "date"로 변경된 것을 확인.&lt;br/&gt;(자세한 스크립트는 Script 탭에서 확인.)'
    		escape="false">
    	</w2:textbox>
    	<xf:trigger ev:onclick="scwin.trigger1_onclick"
    		style="height:42px;line-height:32px;padding:5px;background-color:coral;font-size:15px;weight: bolder;font-weight:bolder;text-align: left;display: block;margin-bottom: 10px;"
    		id="trigger1" type="button">
    		<xf:label><![CDATA[getDataType()]]></xf:label>
    	</xf:trigger>
    	<xf:trigger type="button" id="trigger2"
    		style="height:42px;line-height:32px;padding:5px;background-color:coral;font-size:15px;weight: bolder;font-weight:bolder;text-align: left;display: block;margin-bottom: 10px;"
    		ev:onclick="scwin.trigger2_onclick">
    		<xf:label><![CDATA[setDataType()]]></xf:label>
    	</xf:trigger>
    	<w2:gridView showSortableUseFilter="" scrollByColumnAdaptive="false" editModeEvent="ondblclick" rowNumVisible=""
    		showSortableImage="" selectedRowColor="#0000FF" useCtrlOnMultisort="true" scrollByColumn="false" focusFlow="default"
    		noResultMessageStyle="width: 90%;height: 50%;margin-left: 30px;" sortable="" defaultCellHeight="20" setCellInputTypeCustom="true"
    		rowStatusVisible="" focusMode="none" dataList="data:dataList1" keyMoveEditMode="true" style="border: solid 1px gray;margin-bottom: 10px;"
    		sortedIconPosition="" id="gridView1" autoFit="allColumn" visibleRowNum="3" class="" visibleRowNumFix="true">
    		<w2:caption style="" id="caption1" value="this is a grid caption."></w2:caption>
    		<w2:header style="" id="header1">
    			<w2:row style="height: 25px;" id="row1">
    				<w2:column removeBorderStyle="false" width="70" inputType="text" style="height:20px;" id="column19" value="Check"
    					blockSelect="false" displayMode="label">
    				</w2:column>
    				<w2:column removeBorderStyle="false" width="70" inputType="text" style="height:20px;" id="column17" value="ID"
    					blockSelect="false" displayMode="label">
    				</w2:column>
    				<w2:column removeBorderStyle="false" width="70" inputType="text" style="height:20px;" id="column15" sortable="false"
    					value="Age" blockSelect="false" displayMode="label">
    				</w2:column>
    				<w2:column width="70" inputType="text" style="" id="column35" value="Date" displayMode="label"></w2:column>
    			</w2:row>
    		</w2:header>
    		<w2:gBody style="" id="gBody1">
    			<w2:row style="height: 12px;" id="row2">
    				<w2:column removeBorderStyle="false" width="70" inputType="checkbox" style="height:20px" id="Check" value=""
    					blockSelect="false" displayMode="label">
    				</w2:column>
    				<w2:column removeBorderStyle="false" width="70" inputType="text" style="height:20px" id="ID" value=""
    					blockSelect="false" displayMode="label">
    				</w2:column>
    				<w2:column typeGetter="" removeBorderStyle="false" width="70" inputType="" style="height:20px" id="Age" value=""
    					blockSelect="false" displayMode="label">
    				</w2:column>
    				<w2:column width="70" inputType="text" style="" id="Date" value="" displayMode="label"></w2:column>
    			</w2:row>
    		</w2:gBody>
    	</w2:gridView>
    	<w2:textbox escape="false" id="textbox4"
    		label='/// setDataType() 샘플 코드&lt;br/&gt;&lt;br/&gt;var options = {&lt;br/&gt; &amp;nbsp; &amp;nbsp;displayFormat: "dd/MM/yyyy"&lt;br/&gt;};&lt;br/&gt;gridView1.setDataType("Date", "date", options);'
    		style="padding:10px; padding-bottom:20px; text-align:left; font-size:15px; font-weight:bolder; border:brown 1px solid; background-color:ivory; margin-bottom:10px; color:brown;"
    		tagname="">
    	</w2:textbox>
    </xf:group></body>
</html>
