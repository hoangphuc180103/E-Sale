scwin.initPage = function () {
  tac_exam1.addTab("P00158S01", {
    "label": "P00158S01",
    "openAction": "select"
  }, {
    "src": "/page/P00158S01.xml",
    "wframe": true
  });
  tac_exam2.addTab("P00158S02", {
