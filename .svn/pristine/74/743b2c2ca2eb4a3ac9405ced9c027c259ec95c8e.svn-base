scwin.onpageunload = function () {};
scwin.trigger1_onclick = function () {
  var options = {
    headerExist: "1",
    sheetName: "sheet3"
  };
  gridView1.advancedExcelUpload(options);
};
scwin.trigger2_onclick = function (e) {
  var tmpSrc = scwin.getfolderPath() + "/Excel_for_GridView.xlsx";
  var name = "Excel_for_GridView.xlsx";
  scwin.downloadFile(tmpSrc, name);
};
scwin.downloadFile = function (tmpSrc, name) {
  const link = document.createElement('a');
  link.href = tmpSrc;
  link.download = name;
  link.click();
};
scwin.getfolderPath = function () {
  var currentPath = window.location.href;
  var folderPath;
  if (currentPath.includes("mainContainer")) {
    console.log("true  ===> " + $p.getFrameId());
    const cmtFrame = $p.getComponentById($p.getFrameId());
    currentPath = cmtFrame.getSrc();
    folderPath = currentPath.substring(0, currentPath.lastIndexOf('/'));
  } else {
    console.log("false  ===> ");
    folderPath = currentPath.split('w2xPath=')[1].substring(0, currentPath.split('w2xPath=')[1].lastIndexOf('/'));
  }
  return folderPath;
};
}}}]}]},{T:1,N:'body',A:{'ev:onpageload':'scwin.onpageload','ev:onpageunload':'scwin.onpageunload'},E:[{T:1,N:'xf:group',A:{id:'',style:'margin: 10px;'},E:[{T:1,N:'w2:textbox',A:{tagname:'h1',style:'color: blue;margin-bottom: 10px;',tabIndex:'h1',id:'textbox1',label:'특정 Excel 시트만 업로드',escape:'false'}},{T:1,N:'w2:textbox',A:{tagname:'h2',style:'height: 23px;margin-bottom: 10px;color: blue;',id:'textbox2',label:'샘플 사용 방법'}},{T:1,N:'w2:textbox',A:{style:'color: blue;margin-bottom: 30px;',id:'textbox3',label:'1. 3개 이상의 시트를 포함한 Excel 파일을 준비. <br/>2. 버튼을 클릭하고 Excel 파일을 업로드. <br/>3. Excel 파일의 3번째 시트만 업로드된 것을 확인.<br/>(advancedExcelUpload(options) - options.sheetName="sheet3")',escape:'false'}},{T:1,N:'xf:trigger',A:{'ev:onclick':'scwin.trigger1_onclick',style:'height:42px;line-height:32px;padding:5px;background-color:coral;font-size:15px;weight: bolder;font-weight:bolder;text-align: left;margin-bottom: 10px;',id:'trigger1',type:'button'},E:[{T:1,N:'xf:label',E:[{T:4,cdata:'advancedExcelUpload(options)'}]}]},{T:1,N:'xf:trigger',A:{type:'button',id:'trigger2',style:'height:42px;line-height:32px;padding:5px;background-color:lightpink;font-size:15px;weight: bolder;font-weight:bolder;text-align: left;margin-bottom: 10px;margin-left: 30px;','ev:onclick':'scwin.trigger2_onclick'},E:[{T:1,N:'xf:label',E:[{T:4,cdata:'업로드용 샘플 Excel 파일 다운로드'}]}]},{T:1,N:'w2:gridView',A:{syncScroll:'false',scrollByColumnAdaptive:'false',summaryAuto:'false',useShiftKey:'true',scrollByColumn:'false',summaryOnlyAuto:'false',defaultCellHeight:'20',applyAllColumnStyle:'false',dataList:'data:dataList1',style:'border: solid gray 1px;margin-bottom: 10px;',ignoreCellClick:'false',id:'gridView1',ignoreToggleOnDisabled:'false',visibleRowNum:'10',visibleRowNumFix:'true',autoFit:'allColumn'},E:[{T:1,N:'w2:caption',A:{style:'',id:'caption1',value:'this is a grid caption.'}},{T:1,N:'w2:header',A:{style:'',id:'header1'},E:[{T:1,N:'w2:row',A:{style:'',id:'row1'},E:[{T:1,N:'w2:column',A:{width:'70',inputType:'text',styl