define({declaration:{A:{version:'1.0',encoding:'UTF-8'}},E:[{T:1,N:'html',A:{xmlns:'http://www.w3.org/1999/xhtml','xmlns:ev':'http://www.w3.org/2001/xml-events','xmlns:w2':'http://www.inswave.com/websquare','xmlns:xf':'http://www.w3.org/2002/xforms'},E:[{T:1,N:'head',E:[{T:1,N:'w2:type',E:[{T:3,text:'DEFAULT'}]},{T:1,N:'w2:buildDate'},{T:1,N:'xf:model',E:[{T:1,N:'w2:dataCollection',A:{baseNode:'map'}},{T:1,N:'w2:workflowCollection'}]},{T:1,N:'script',A:{type:'text/javascript',lazy:'false'},E:[{T:4,cdata:function(scopeObj){with(scopeObj){scwin.onpageload = function () {};
scwin.onpageunload = function () {};
scwin.trigger1_onclick = function (e) {
  var parameter1 = input1.getValue();
  var parameter2 = input2.getValue();
  var rowJSON = {
    // "Product Info": { "Origin": "Korea", "Manufacturer": "Inswave", "Type": "Software" },
    // "Region": "Seoul",
    // "Carrier": true
    "Parameter 1": parameter1,
    "Parameter 2": parameter2
  };
  var dataObject = {
    "type": "json",
    "name": "param",
    "data": rowJSON
  };
  var obj = {
    "dataObject": dataObject
  };
  const tmpSrc = scwin.getfolderPath() + "/src.xml";
  console.log("tmpSrc  ===> " + tmpSrc);
  wframe1.setSrc(tmpSrc, obj);
};
scwin.getfolderPath = function () {
  var currentPath = window.location.href;
  var folderPath;
  console.log("currentPath  ===> " + currentPath);
  if (currentPath.includes("mainContainer")) {
    console.log("true  ===> " + $p.getFrameId());
    const cmtFrame = $p.getComponentById($p.getFrameId());
    currentPath = cmtFrame.getSrc();
    folderPath = currentPath.substring(0, currentPath.lastIndexOf('/'));
  } else {
    console.log("false  ===> ");
    folderPath = currentPath.split('w2xPath=')[1].substring(0, currentPath.split('w2xPath=')[1].lastIndexOf('/'));
  }
  return folderPath;
};
}}}]}]},{T:1,N:'body',A:{'ev:onpageload':'scwin.onpageload','ev:onpageunload':'scwin.onpageunload'},E:[{T:1,N:'xf:group',A:{id:'',style:'margin: 10px;'},E:[{T:1,N:'w2:textbox',A:{tagname:'h1',style:'color: blue;margin-bottom: 10px;',tabIndex:'h1',id:'textbox1',label:'Pass Parameters when Setting Source Screen<br/>',escape:'false'}},{T:1,N:'w2:textbox',A:{tagname:'h2',style:'height: 23px;margin-bottom: 10px;color: blue;',id:'textbox2',label:'How to Use'}},{T:1,N:'w2:textbox',A:{style:'color: blue;margin-bottom: 30px;',id:'textbox3',label:'1. Enter the parameters to pass when creating a tab in the InputBox below.<br/>2. Click the setSrc() button.<br/>3. Confirm the screen is set to the source. (The parameters entered above are also passed.)<br/>4. Click the $p.getParameter() button on the generated tab screen.<br/>5. Confirm that the parameter entered above (passed when setting the source) is displayed.<br/>(See the Script tab for detailed script.)',escape:'false'}},{T:1,N:'w2:textbox',A:{tagname:'',style:'padding:10px; padding-bottom:20px; text-align:left; font-size:15px; font-weight:bolder; border:brown 1px solid; background-color:ivory; margin-bottom:10px; color:brown;',id:'textbox4',label:'/// Sample Code<br/><br/>var parameter1 = input1.getValue();<br/>var parameter2 = input2.getValue();<br/><br/>var rowJSON = {<br/> &nbsp; &nbsp;"Parameter 1": parameter1,<br/> &nbsp; &nbsp;"Parameter 2": parameter2,<br/>};<br/><br/>var dataObject = {<br/> &nbsp; &nbsp;"type": "json",<br/> &nbsp; &nbsp;"name": "param",<br/> &nbsp; &nbsp;"data": rowJSON<br/>};<br/><br/>var obj = {<br/> &nbsp; &nbsp;"dataObject": dataObject<br/>};<br/><br/>wframe1.setSrc("source.xml", obj);',escape:'false'}},{T:1,N:'xf:input',A:{style:'text-align: right;height:50px;padding: 5px;font-size:20px;font-style:normal;font-weight:bolder;color: red;margin-bottom: 10px;display: block;',id:'input1',placeholder:'Enter the first parameter.'}},{T:1,N:'xf:input',A:{style:'text-align: right;height:50px;padding: 5px;font-size:20px;font-style:normal;font-weight:bolder;color: red;margin-bottom: 10px;display: block;',id:'input2',placeholder:'Enter the second parameter.'}},{T:1,N:'xf:trigger',A:{'ev:onclick':'scwin.trigger1_onclick',style:'height:42px;line-height:32px;padding:5px;background-color:coral;font-size:15px;weight: bolder;font-weight:bolder;text-align: left;display: block;margin-bottom: 10px;',id:'trigger1',type:'button'},E:[{T:1,N:'xf:label',E:[{T:4,cdata:'setSrc()'}]}]},{T:1,N:'w2:wframe',A:{style:'border: solid gray 1px;height: 300px;margin-bottom: 10px;',id:'wframe1'}}]}]}]}]})