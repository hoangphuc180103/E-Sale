<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare"
	xmlns:xf="http://www.w3.org/2002/xforms">
	<head meta_author="InswaveSystems" meta_type="메인" meta_screenName="[GridView] Event - onsort (헤더를 클릭 또는 더블클릭하여 데이터 정렬된 경우 발생)">
		<w2:historyInfo>
			<w2:history meta_no="01" meta_desc="최초작성" meta_date="20230217" meta_user="InswaveSystems"></w2:history>
			<w2:history meta_no="02" meta_desc="설명부 수정" meta_date="20240621" meta_user="InswaveSystems"></w2:history>
			<w2:history meta_no="03" meta_desc="예제에서 사용하는 DataList가 변경되고, 이에 따른 GridVeiw의 설정이 수정되었습니다." meta_date="20240705"
				meta_user="InswaveSystems"></w2:history>
		</w2:historyInfo>
		<w2:type>COMPONENT</w2:type>
		<w2:buildDate />
		<w2:MSA />
		<xf:model>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" id="dlt_exam1" repeatNode="map" style="" valueAttribute="">
					<w2:columnInfo>
						<w2:column dataType="text" id="category" name="Category"></w2:column>
						<w2:column dataType="text" id="product" name="Product"></w2:column>
						<w2:column dataType="text" name="Stock" id="stock"></w2:column>
					</w2:columnInfo>
					<w2:data use="true">
						<w2:row>
							<category><![CDATA[Software]]></category>
							<product><![CDATA[SecureGate]]></product>
							<stock><![CDATA[98291]]></stock>
						</w2:row>
						<w2:row>
							<category><![CDATA[Hardware]]></category>
							<product><![CDATA[FastServe]]></product>
							<stock><![CDATA[528]]></stock>
						</w2:row>
						<w2:row>
							<category><![CDATA[Services]]></category>
							<product><![CDATA[CloudFlex]]></product>
							<stock><![CDATA[73928]]></stock>
						</w2:row>
					</w2:data>
				</w2:dataList>
			</w2:dataCollection>
			<w2:workflowCollection />
		</xf:model>
		<w2:layoutInfo />
		<w2:publicInfo method="" />
		<script lazy="false" type="text/javascript"><![CDATA[
scwin.onpageload = function () {
    
};

/**
 * GridView grd_exam1의 onsort 이벤트 핸들러
 */
scwin.grd_exam1_onsort = function (artSortInfo) {
    let strLog = "";

    strLog += "** scwin.grd_exam1_onsort ** \n";
    strLog += "headerId : " + artSortInfo.headerId + "\n";
    strLog += "bodyColId : " + artSortInfo.bodyColId + "\n";
    strLog += "sortOrder : " + artSortInfo.sortOrder + "\n";
    strLog += "json : " + JSON.stringify(artSortInfo);

    //textarea에 log 출력
    $c.frame.printExampleLog(strLog, txa_log, false);

    //console에 log 출력
    console.log(strLog);
    console.log(artSortInfo);

};

/**
 * textarea의 로그 삭제
 */
scwin.btn_clearLog_onclick = function (e) {
    txa_log.setValue("");
};]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:group class="sub_contents" id="" style="">
			<xf:group class="ws_example_grp_desc" id="" style="">
				<w2:textbox escape="false" id="" label="GridView의 'onsort' 이벤트를 설정한 예제입니다." style="">
				</w2:textbox>
				<w2:textbox class="exam_txt caution" id="" label="컴포넌트의 이벤트 발생 시 영역 [로그 확인]의 textarea 또는 브라우저 개발자도구 콘솔에 로그가 출력됩니다." style=""></w2:textbox>
			</xf:group>
			<xf:group class="example_div_tb_style_wrap" id="">
				<xf:group class="example_div_tr_style" id="" style="">
					<xf:group class="example_div_td_style" id="" style="">
						<xf:group id="" class="gvwbox" style="max-width: 400px;">
							<w2:gridView sortEvent="onclick" showSortableImage="true" ev:onsort="scwin.grd_exam1_onsort" sortable="true"
								defaultCellHeight="37" rowNumVisible="true" rowNumWidth="40" keepDefaultColumnWidth="true" visibleRowNumFix="true"
								dataList="data:dlt_exam1" style="height:100px;" id="grd_exam1" visibleRowNum="3" autoFit="allColumn" class="gvw"
								autoFitMinWidth="272">
								<w2:caption style="" id="caption1" value="this is a grid caption."></w2:caption>
								<w2:header style="" id="header1">
									<w2:row style="" id="row1">
										<w2:column width="110" inputType="text" id="h_col1" value="Category" displayMode="label"></w2:column>
										<w2:column width="120" inputType="text" id="h_col2" value="Product" displayMode="label"></w2:column>
										<w2:column width="90" inputType="text" id="h_col3" value="Stock" displayMode="label"></w2:column>
									</w2:row>
								</w2:header>
								<w2:gBody style="" id="gBody1">
									<w2:row style="" id="row2">
										<w2:column width="110" inputType="text" id="category" displayMode="label"></w2:column>
										<w2:column width="120" inputType="text" id="product" displayMode="label" textAlign="left"></w2:column>
										<w2:column width="90" inputType="text" id="stock" displayMode="label" textAlign="right" dataType="number"
											displayFormat="#,###">
										</w2:column>
									</w2:row>
								</w2:gBody>
							</w2:gridView>
						</xf:group>
					</xf:group>
				</xf:group>
			</xf:group>
			<xf:group class="example_div_tb_style_wrap" id="" style="">
				<xf:group class="example_div_tr_style" id="" style="">
					<xf:group class="example_div_th_style" id="">
						<w2:span class="mr_def txt_blue" id="" label="로그 확인" style=""></w2:span>
						<xf:trigger class="wre_btn_log_clear" ev:onclick="scwin.btn_clearLog_onclick" id="btn_clearLog" style="" title="로그 삭제"
							type="button">
							<xf:label><![CDATA[로그 삭제]]></xf:label>
						</xf:trigger>
					</xf:group>
					<xf:group class="example_div_td_style" id="" style="">
						<xf:textarea class="wre_txa_log" id="txa_log" spellcheck="false" style="width: 100%;height: 140px;"></xf:textarea>
					</xf:group>
				</xf:group>
			</xf:group>
		</xf:group>
	</body>
</html>