<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
         <script type="text/javascript" lazy="false"><![CDATA[
scwin.count=0;
scwin.onpageload = function () {
};

scwin.onpageunload = function () {

};


scwin.trigger1_onclick = function (e) {
    scwin.count++;
var tmpSrc = scwin.getfolderPath() + "/01_wframe_frameModal.xml";

    windowContainer1.createWindow({
        "title": "PopUp",
        "windowTitle": "PopUp",
        "src": tmpSrc,
        "windowId": scwin.count,
        "frameMode": "pageFrame",
        "frameModal": "true"
    });
};

scwin.getfolderPath = function () {

    var currentPath = window.location.href;
    var folderPath;

    if (currentPath.includes("mainContainer")) {
        console.log("true  ===> " + $p.getFrameId());
        const cmtFrame = $p.getComponentById($p.getFrameId());
        currentPath = cmtFrame.getSrc();
        folderPath = currentPath.substring(0, currentPath.lastIndexOf('/'));
    } else {
        console.log("false  ===> ");
        folderPath = currentPath.split('w2xPath=')[1].substring(0, currentPath.split('w2xPath=')[1].lastIndexOf('/'));
    }
    return folderPath;
};

]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload" ev:onpageunload="scwin.onpageunload">
    <xf:group id="" style="margin: 10px;">
    	<w2:textbox tagname="h1" style="color: blue;margin-bottom: 10px;" tabIndex="h1" id="textbox1" label="ウィンドウで作成した親 - 子ポップアップで閉じる"
    		escape="false">
    	</w2:textbox>
    	<w2:textbox tagname="h2" style="height: 23px;margin-bottom: 10px;color: blue;" id="textbox2" label="サンプルの使い方"></w2:textbox>
    	<w2:textbox style="color: blue;margin-bottom: 30px;" id="textbox3"
    		label='1. 下の createWindow() ボタンクリック。 &lt;br/&gt;2. Windows 生成されるもの確認。&lt;br/&gt;3. Windows 内部各ボタンクリックして親-子関係のポップアップ連続作成。 &lt;br/&gt;4. 親ポップアップ閉じる。 &lt;br/&gt;5. 親ポップアップで属する子ポップアップもみんな閉じるもの確認。'
    		escape="false">
    	</w2:textbox>
    	<w2:textbox
    		style="padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightblue;border:none;margin-bottom: 20px;"
    		id="textbox4"
    		label='オプションの設定&lt;br/&gt;createWindow(winObj) &lt;br/&gt; &amp;nbsp; &amp;nbsp;winObj.frameModal="true"&lt;br/&gt; &amp;nbsp; &amp;nbsp;winObj.frameMode="pageFrame"'
    		escape="false">
    	</w2:textbox>
    	<w2:textbox style="padding:10px; padding-bottom:20px; text-align:left; font-size:15px; font-weight:bolder; border:brown 1px solid; background-color:ivory; margin-bottom:10px; margin-top:10px; color:brown;" id="textbox5" label='/// サンプルファイル&lt;br/&gt;&lt;br/&gt;scwin.count++;&lt;br/&gt;&lt;br/&gt;windowContainer1.createWindow({&lt;br/&gt; &amp;nbsp; &amp;nbsp;"title":" &amp;nbsp; &amp;nbsp;"windowTitle": "PopUp",&lt;br/&gt; &amp;nbsp; "src": "01_wframe_frameModal.xml",&lt;br scwin.count,&lt;br/&gt; &amp;nbsp;"frameMode": "pageFrame",&lt;br/&gt; &amp;nbsp; &amp;nbsp;"frameModal": "true"&lt;br/&gt;});' escape="false">
    	</w2:textbox>
    	<xf:trigger ev:onclick="scwin.trigger1_onclick"
    		style="height:42px;line-height:32px;padding:5px;background-color:coral;font-size:15px;weight: bolder;font-weight:bolder;text-align: left;display: block;margin-bottom: 10px;"
    		id="trigger1" type="button">
    		<xf:label><![CDATA[createWindow()]]></xf:label>
    	</xf:trigger>
    	<w2:windowContainer sequentialArrangeColNum="2" sequentialArrangeRowNum="2" fixArrangeFullScreen="false" useFixButton="false"
    		windowAutoResize="false" verticalArrangeNum="2" windowMaxNum="5" useCloseButton="false" controlIconPosition="left"
    		windowMaximizeAll="false" stopMinimizeOnNameLayer="false" toolbarPosition="bottom" id="windowContainer1" useStatusMsg="true"
    		hideTitleOnMaximize="false" spaInitCount="0" stopToggleOnLast="false" useNameContainer="false" horizontalArrangeNum="2"
    		useCustomMsg="false" useControlIconTitle="false" tooltipDisplay="true" tooltipGroupClass="false" windowTooltipDisplay="true"
    		style="position: relative;height: 400px;border: gray solid 1px;margin-bottom: 10px;">
    		<w2:windowToolbar>
    			<w2:controlIconLayer>
    				<w2:controlIcon></w2:controlIcon>
    				<w2:controlIcon></w2:controlIcon>
    				<w2:controlIcon></w2:controlIcon>
    				<w2:controlIcon></w2:controlIcon>
    				<w2:controlIcon></w2:controlIcon>
    			</w2:controlIconLayer>
    			<w2:nameLayer></w2:nameLayer>
    			<w2:selectedNameLayer></w2:selectedNameLayer>
    		</w2:windowToolbar>
    	</w2:windowContainer>
    </xf:group></body>
</html>
