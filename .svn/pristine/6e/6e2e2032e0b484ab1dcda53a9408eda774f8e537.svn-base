    	</xf:model>
    	<script type="text/javascript" lazy="false"><![CDATA[

scwin.onpageload = function () {

};

scwin.onpageunload = function () {

};

scwin.progressbar_displayFormatter = function (value) {
    // 항상 소수점 2자리를 표시하고 퍼센트 기호를 붙임
    var ret = Number(value).toFixed(2) + "%";
    return ret;
};
scwin.trigger1_onclick = function (e) {
    progress1.set(70);
    progress2.set(70);
    progress3.set(70);
};
]]></script>
    	<style type="text/css"><![CDATA[.blue{background-color: pink;}]]></style>
    </head>
    <body ev:onpageload="scwin.onpageload" ev:onpageunload="scwin.onpageunload">
    <xf:group id="" style="margin: 10px;">
    	<w2:textbox tagname="h1" style="color: blue;margin-bottom: 10px;" tabIndex="h1" id="textbox1" label="Set Value Display Format" escape="false"></w2:textbox>
    	<w2:textbox tagname="h2" style="height: 23px;margin-bottom: 10px;color: blue;" id="textbox2" label="How to Use"></w2:textbox>
    	<w2:textbox style="color: blue;margin-bottom: 30px;" id="textbox3"
    		label='1. Click the “Set Value for ProgressBar” button. &lt;br/&gt;&lt;br/&gt;2-1. (First ProgressBar) Verify the set value is displayed without formatting.&lt;br/&gt;&lt;br/&gt;2-2. (Second ProgressBar) Verify the set value is displayed according to the format specified by the displayFormat property value.&lt;br/&gt;&lt;br/&gt;2-3. (Third ProgressBar) Verify the set value is displayed as the value returned by the function specified by the displayFormatter property.'
    		escape="false">
    	</w2:textbox>
    	<xf:trigger type="button" id="trigger1"
    		style="height:42px; line-height:32px; padding:5px; background-color:coral; font-size:15px; weight:bolder; font-weight:bolder; text-align:left; display:block; margin-bottom:10px;"
    		ev:onclick="scwin.trigger1_onclick">
    		<xf:label><![CDATA[Set a value for the ProgressBar]]></xf:label>
    	</xf:trigger>
    	<w2:textbox
    		style="padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightblue;border:none;margin-bottom: 10px;"
    		id="textbox4" label='displayFormat=""' escape="false">
    	</w2:textbox>
    	<w2:progressbar max="100" progressClass="type1" duration="50000" min="0" valueType="number" step="10"
    		style="width:300px; height:48px; margin-bottom:10px;" id="progress1" displayFormat="">
    	</w2:progressbar>
    	<w2:textbox escape="false" id="textbox5" label='&lt;br/&gt;displayFormat="0.000"'
    		style="padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightblue;border:none;margin-bottom: 10px;">
    	</w2:textbox>
    	<w2:progressbar duration="50000" min="0" max="100" valueType="number" displayFormat="0.000" progressClass="type1" step="10"
    		style="width:300px; height:48px; margin-bottom:10px;" id="progress2">
    	</w2:progressbar>
    	<w2:textbox
    		style="padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightblue;border:none;margin-bottom: 10px;"
    		id="textbox6" label='displayFormat=""&lt;br/&gt;displayFormatter="scwin.progressbar_displayFormatter"'
    		escape="false">
    	</w2:textbox>
    	<w2:textbox tagname="" style="padding:10px; padding-bottom:20px; text-align:left; font-size:15px; font-weight:bolder; border:brown 1px solid; background-color:ivory; margin-bottom:10px; color:brown;" id="textbox8" label='/// Example implementation of the function specified as displayFormatter (displays two decimal places and adds a % symbol).&lt;br/&gt;&lt;br/&gt;scwin.progressbar_displayFormatter = function(value) {&lt;br/&gt; &amp;nbsp; &amp;nbsp;var ret = Number(value).toFixed(2) + "%";&lt;br/&gt; &amp;nbsp; &amp;nbsp;return ret;&lt;br/&gt;};' escape="false">
    	</w2:textbox>
    	<w2:progressbar duration="1000" displayFormatter="scwin.progressbar_displayFormatter" min="0" max="100" valueType="number"
    		progressClass="type1" step="10" style="width:300px; height:48px; margin-bottom:10px;" id="progress3">
    	</w2:progressbar>
    </xf:group></body>
</html>
