scwin.getfolderPath = function () {
  var currentPath = window.location.href;
  var folderPath;
  if (currentPath.includes("mainContainer")) {
    console.log("true  ===> " + $p.getFrameId());
    const cmtFrame = $p.getComponentById($p.getFrameId());
    currentPath = cmtFrame.getSrc();
    folderPath = currentPath.substring(0, currentPath.lastIndexOf('/'));
  } else {
    console.log("false  ===> ");
    folderPath = currentPath.split('w2xPath=')[1].substring(0, currentPath.split('w2xPath=')[1].lastIndexOf('/'));
  }
  return folderPath;
};
}}}]}]},{T:1,N:'body',A:{'ev:onpageload':'scwin.onpageload'},E:[{T:1,N:'xf:group',A:{id:'',style:'margin: 10px;'},E:[{T:1,N:'w2:textbox',A:{style:'width: 500px;height: 30px;margin: 10px;font-weight: bolder;color: blue;',id:'textbox1',label:'textbox1 - wframe1'}},{T:1,N:'w2:textbox',A:{style:'width: 500px;height: 30px;margin: 10px;font-weight: bolder;color: blue;',id:'textbox3',label:'textbox3'}},{T:1,N:'w2:wframe',A:{scopeInherit:'all',style:'border:2px solid blue;padding: 10px;background-color: lightblue;',id:'wframe1'}}]}]}]}]})