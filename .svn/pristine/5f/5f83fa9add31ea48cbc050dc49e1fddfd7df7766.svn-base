  wdc_exam1.restoreWindowSize("w_P00108S01"); //예제 테스트를 위한 설정

  wdc_exam2.createWindow("P00108S01", null, strSrc, null, "w_P00108S01", "selectWindow", null, null, null, {
    "defaultWidth": strDefaultWidth
  }, "wframe");
  wdc_exam2.restoreWindowSize("w_P00108S01"); //예제 테스트를 위한 설정
};
