<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
        <title>WESE_360_mapChart_marker.xml</title>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
        <style>
        </style>        
        <script type="javascript" lazy="false"><![CDATA[
scwin.onpageload = function () {

};

scwin.onpageunload = function () {

};

scwin.contextFormatter = function (name, code) {
    return "Completed : 0," + "<br>Under Progress : 0," + "<br>Scheduled : 0";
};

scwin.markerDefiner = function (name, code) {
    if (code % 2 == 1) {
        return true;
    } else {
        return false;
    }
};

scwin.markerClassDefiner = function (name, code) {
    if (code % 3 == 1) {
        return "class1";
    } else {
        return "class2";
    }
};
]]></script>
        <style type="text/css"><![CDATA[
        .class1 { fill: orange; }
        .class1:hover { fill: magenta; }
        .class2 { fill: blue; }
        .class2:hover { fill: green; }
        ]]></style>
    </head>
    <body ev:onpageload="scwin.onpageload" ev:onpageunload="scwin.onpageunload">
    <xf:group id="" style="margin: 10px;">
    	<w2:textbox escape="false" id="textbox1" label="마커 스타일 정의" style="color: blue;margin-bottom: 10px;" tabIndex="h1" tagname="h1"></w2:textbox>
    	<w2:textbox id="textbox2" label="샘플 사용 방법" style="height: 23px;margin-bottom: 10px;color: blue;" tagname="h2"></w2:textbox>
    	<w2:textbox escape="false" id="textbox3"
    		label='1. markerDefiner 속성 값으로 설정한 함수에 의해 마커가 표시되는지 확인. &lt;br/&gt;2. markerClassDefiner 속성 값으로 설정한 함수에 의해 마커의 스타일이 결정되는지 확인.&lt;br/&gt;(상세한 스크립트는 Script 탭에서 확인.)'
    		style="color: blue;margin-bottom: 30px;">
    	</w2:textbox>
    	<w2:textbox escape="false" id="textbox4"
    		label='속성 설정&lt;br/&gt;markerDefiner="scwin.markerDefiner" &lt;br/&gt;markerClass="class1,class2" &lt;br/&gt;markerClassDefiner="scwin.markerClassDefiner"'
    		style="padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightblue;border:none;margin-bottom: 10px;">
    	</w2:textbox>
    	<w2:mapchart zoomMax="" markerDefiner="scwin.markerDefiner" dataMapRatio_level1="simp16" dataMapRatio_level0="simp01"
    		regionNameShort="true" zoomMin="" event_tooltipoff="none" contextFormatter="scwin.contextFormatter" event_tooltipon="none"
    		useMarker="true" markerClass="class1,class2" event_zoom="none" markerClassDefiner="scwin.markerClassDefiner"
    		style="width: 300px;height: 400px;margin-bottom: 10px;" id="mapchart1" event_drag="none">
    	</w2:mapchart>
    	<w2:textbox tagname="" style="padding:10px; padding-bottom:20px; text-align:left; font-size:15px; font-weight:bolder; border:brown 1px solid; background-color:ivory; margin-bottom:10px; color:brown;" id="textbox6" label='/// 샘플 코드 &lt;br/&gt;&lt;br/&gt;scwin.markerDefiner = function (name, code) {&lt;br/&gt; &amp;nbsp; &amp;nbsp;if (code % 2 == 1) {&lt;br/&gt; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;return true;&lt;br/&gt; &amp;nbsp; &amp;nbsp;} else {&lt;br/&gt; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;return false;&lt;br/&gt; &amp;nbsp; &amp;nbsp;}&lt;br/&gt;};&lt;br/&gt;&lt;br/&gt;scwin.markerClassDefiner = function (name, code) {&lt;br/&gt; &amp;nbsp; &amp;nbsp;if (code % 3 == 1) {&lt;br/&gt; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;return "class1";&lt;br/&gt; &amp;nbsp; &amp;nbsp;} else {&lt;br/&gt; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;return "class2";&lt;br/&gt; &amp;nbsp; &amp;nbsp;}&lt;br/&gt;};' escape="false">
    	</w2:textbox>
    	<w2:textbox escape="false" id="textbox5" label='속성 설정&lt;br/&gt;markerDefiner=""'
    		style="padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightblue;border:none;margin-bottom: 10px;">
    	</w2:textbox>
    	<w2:mapchart contextFormatter="scwin.contextFormatter" dataMapRatio_level0="simp01" dataMapRatio_level1="simp16" event_drag="none"
    		event_tooltipoff="none" event_tooltipon="none" event_zoom="none" id="mapchart2" regionNameShort="true"
    		style="width: 300px;height: 400px;margin-bottom: 10px;" useMarker="true" zoomMax="" zoomMin="">
    	</w2:mapchart>
    </xf:group></body>
</html>
