<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
        <w2:type>COMPONENT</w2:type>
        <w2:buildDate/>
        <w2:MSA/>
        <xf:model>
            <w2:dataCollection baseNode="map"/>
            <w2:workflowCollection/>
        </xf:model>
        <w2:layoutInfo/>
        <w2:publicInfo method=""/>
        <script lazy="false" type="text/javascript"><![CDATA[
scwin.onpageload = function () {

};

scwin.trigger1_onclick = function (e) {
    select1.setValue("Paris");
    var index = select1.getSelectedIndex();
    alert(index);
};

scwin.trigger2_onclick = function (e) {
    select2.setValue("London");
};
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload">
    <xf:group id="" style="margin: 10px;">
    	<w2:textbox tagname="h1" style="color: blue;margin-bottom: 10px;" tabIndex="h1" id="textbox1" label="Handling of Values Not in the List&lt;br/&gt;" escape="false"></w2:textbox>
    	<w2:textbox tagname="h2" style="height: 23px;margin-bottom: 10px;color: blue;" id="textbox2" label="How to Use"></w2:textbox>
    	<w2:textbox style="color: blue;margin-bottom: 30px;" id="textbox3"
    		label='(First SelectBox)&lt;br/&gt;1. Confirm the selected item in the list.&lt;br/&gt;2. Click the setValue(“Paris”) button at the bottom to set a value not currently in the list.&lt;br/&gt;3. Confirm that the set value appears in the list and that the index of the set value is returned as “-1”.&lt;br/&gt;&lt;br/&gt;(Second SelectBox)&lt;br/&gt;1. Confirm the available options in the list.&lt;br/&gt;2. Click the setValue(“London”) button at the bottom to set a value not currently in the list.&lt;br/&gt;3. Confirm that the set value does not appear in the list (valueNotInList=“default”), and instead an empty value is displayed (emptyItem=“true”).'
    		escape="false">
    	</w2:textbox>
    	<w2:textbox
    		style="padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightblue;border:none;margin-bottom: 10px;"
    		id="textbox4" label='valueNotInList="keepValue"' escape="false">
    	</w2:textbox>
    	<w2:textbox style="padding:10px; padding-bottom:20px; text-align:left; font-size:15px; font-weight:bolder; border:brown 1px solid; background-color:ivory; margin-bottom:10px; margin-top:10px; color:brown;" id="textbox6" label='/// Sample Code&lt;br/&gt;&lt;br/&gt;select1.setValue("Paris");&lt;br/&gt;var index = select1.getSelectedIndex();&lt;br/&gt;alert(index);' escape="false">
    	</w2:textbox>
    	<xf:trigger ev:onclick="scwin.trigger1_onclick"
    		style="height:42px;line-height:32px;padding:5px;background-color:coral;font-size:15px;weight: bolder;font-weight:bolder;text-align: left;display: block;margin-bottom: 10px;"
    		id="trigger1" type="button">
    		<xf:label><![CDATA[select1.setValue("Paris");]]></xf:label>
    	</xf:trigger>
    	<xf:select1 valueNotInList="keepValue" submenuSize="auto" ref="" appearance="minimal" disabledClass="w2selectbox_disabled"
    		chooseOption="" emptyItem="true" style="margin-bottom: 20px;width: 50%;" disabled="false" id="select1" allOption=""
    		direction="auto">
    		<xf:choices>
    			<xf:item>
    				<xf:label><![CDATA[Seoul]]></xf:label>
    				<xf:value><![CDATA[1]]></xf:value>
    			</xf:item>
    			<xf:item>
    				<xf:label><![CDATA[Busan]]></xf:label>
    				<xf:value><![CDATA[2]]></xf:value>
    			</xf:item>
    			<xf:item>
    				<xf:label><![CDATA[Daegu]]></xf:label>
    				<xf:value><![CDATA[3]]></xf:value>
    			</xf:item>
    			<xf:item>
    				<xf:label><![CDATA[Jeju]]></xf:label>
    				<xf:value><![CDATA[4]]></xf:value>
    			</xf:item>
    		</xf:choices>
    	</xf:select1>
    	<w2:textbox escape="false" id="textbox5" label='valueNotInList="default" &lt;br/&gt;emptyItem="true"'
    		style="padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightblue;border:none;margin-bottom: 10px;">
    	</w2:textbox>
    	<xf:trigger type="button" id="trigger2"
    		style="height:42px;line-height:32px;padding:5px;background-color:coral;font-size:15px;weight: bolder;font-weight:bolder;text-align: left;display: block;margin-bottom: 10px;"
    		ev:onclick="scwin.trigger2_onclick">
    		<xf:label><![CDATA[select2.setValue("London");]]></xf:label>
    	</xf:trigger>
    	<xf:select1 allOption="" appearance="minimal" chooseOption="" direction="auto" disabled="false" disabledClass="w2selectbox_disabled"
    		emptyItem="true" id="select2" ref="" style="width: 50%;" submenuSize="auto" valueNotInList="default">
    		<xf:choices>
    			<xf:item>
    				<xf:label><![CDATA[Seoul]]></xf:label>
    				<xf:value><![CDATA[1]]></xf:value>
    			</xf:item>
    			<xf:item>
    				<xf:label><![CDATA[Busan]]></xf:label>
    				<xf:value><![CDATA[2]]></xf:value>
    			</xf:item>
    			<xf:item>
    				<xf:label><![CDATA[Daegu]]></xf:label>
    				<xf:value><![CDATA[3]]></xf:value>
    			</xf:item>
    			<xf:item>
    				<xf:label><![CDATA[Jeju]]></xf:label>
    				<xf:value><![CDATA[4]]></xf:value>
    			</xf:item>
    		</xf:choices>
    	</xf:select1>
    </xf:group></body>
</html>
