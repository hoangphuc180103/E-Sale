define({declaration:{A:{version:'1.0',encoding:'UTF-8'}},E:[{T:1,N:'html',A:{xmlns:'http://www.w3.org/1999/xhtml','xmlns:ev':'http://www.w3.org/2001/xml-events','xmlns:w2':'http://www.inswave.com/websquare','xmlns:xf':'http://www.w3.org/2002/xforms'},E:[{T:1,N:'head',E:[{T:1,N:'w2:type',E:[{T:3,text:'DEFAULT'}]},{T:1,N:'w2:buildDate'},{T:1,N:'xf:model',E:[{T:1,N:'w2:dataCollection',A:{baseNode:'map'}},{T:1,N:'w2:workflowCollection'}]},{T:1,N:'script',A:{type:'text/javascript',lazy:'false'},E:[{T:4,cdata:function(scopeObj){with(scopeObj){scwin.count = 0;
scwin.onpageload = function () {
  text1.hide();
  text2.hide();
  var tmpSrc = scwin.getfolderPath() + "/02_openPopUp_tab.xml";
  scwin.count++;
  tabControl1.addTab(scwin.count, {
    label: "frameModal='true'",
    title: "frameModal='true'",
    openAction: "exist",
    closable: "true"
  }, {
    "src": tmpSrc,
    "frameMode": "wframe"
  });
  tabControl1.setSelectedTabIndex(scwin.count);
  tabControl2.addTab(scwin.count, {
    label: "frameModal='false'",
    title: "frameModal='false'",
    openAction: "exist",
    closable: "true"
  }, {
    "src": tmpSrc,
    "frameMode": "wframe"
  });
  tabControl2.setSelectedTabIndex(scwin.count);
};
scwin.onpageunload = function () {};
scwin.getfolderPath = function () {
  var currentPath = window.location.href;
  var folderPath;
  if (currentPath.includes("mainContainer")) {
    console.log("true  ===> " + $p.getFrameId());
    const cmtFrame = $p.getComponentById($p.getFrameId());
    currentPath = cmtFrame.getSrc();
    folderPath = currentPath.substring(0, currentPath.lastIndexOf('/'));
  } else {
    console.log("false  ===> ");
    folderPath = currentPath.split('w2xPath=')[1].substring(0, currentPath.split('w2xPath=')[1].lastIndexOf('/'));
  }
  return folderPath;
};
}}}]}]},{T:1,N:'body',A:{'ev:onpageload':'scwin.onpageload','ev:onpageunload':'scwin.onpageunload'},E:[{T:1,N:'xf:group',A:{id:'',style:'margin: 10px;'},E:[{T:1,N:'w2:textbox',A:{tagname:'h1',style:'margin-bottom: 10px;color: blue;',id:'textbox1',label:'탭에서 생성한 부모-자식 팝업 함께 닫기',escape:'false'}},{T:1,N:'w2:textbox',A:{tagname:'h2',style:'height: 23px;margin-bottom: 10px;color: blue;',id:'textbox2',label:'샘플 사용 방법'}},{T:1,N:'w2:textbox',A:{style:'color: blue;margin-bottom: 30px;',id:'textbox3',label:'(첫 번째 TabControl)<br/>1-1. 각 버튼을 클릭하여 부모-자식 관계의 팝업을 연속 생성.<br/>1-2. 부모 팝업을 닫기.<br/>1-3. 부모 팝업에 속한 자식 팝업들도 모두 닫히는 것을 확인. (frameModal="true")<br/><br/>(두 번째 TabControl)<br/>2-1. 각 버튼을 클릭하여 부모-자식 관계의 팝업을 연속 생성.<br/>2-2. 부모 팝업을 닫기.<br/>2-3. 부모 팝업만 닫히는 것을 확인. (frameModal="false")',escape:'false'}},{T:1,N:'w2:textbox',A:{style:'padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightblue;border:none;margin-bottom: 20px;',id:'textbox4',label:'속성 설정<br/>frameModal="true" (TabControl)<br/>frameMode="wframe" / "wframePreload" (tabControl.content)<br/>',escape:'false'}},{T:1,N:'w2:tabControl',A:{frameModal:'true',alwaysDraw:'false',style:'border: gray solid 1px;margin-bottom: 10px;height: 300px;',id:'tabControl1'}},{T:1,N:'w2:textbox',A:{style:'padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightblue;border:none;margin-bottom: 20px;',id:'textbox5',label:'속성 설정<br/>frameModal="false" (TabControl)',escape:'false'}},{T:1,N:'w2:tabControl',A:{alwaysDraw:'false',style:'border: gray solid 1px;height: 300px;',id:'tabControl2'}},{T:1,N:'w2:textbox',A:{style:'width: 150px;height: 23px;',id:'text1',label:'A'}},{T:1,N:'w2:textbox',A:{style:'width: 150px;height: 23px;',id:'text2',label:'B'}}]}]}]}]})