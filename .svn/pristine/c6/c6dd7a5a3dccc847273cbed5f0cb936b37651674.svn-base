define({declaration:{A:{version:'1.0',encoding:'UTF-8'}},E:[{T:1,N:'html',A:{xmlns:'http://www.w3.org/1999/xhtml','xmlns:ev':'http://www.w3.org/2001/xml-events','xmlns:w2':'http://www.inswave.com/websquare','xmlns:xf':'http://www.w3.org/2002/xforms'},E:[{T:1,N:'head',E:[{T:1,N:'w2:type',E:[{T:3,text:'DEFAULT'}]},{T:1,N:'w2:buildDate'},{T:1,N:'xf:model',E:[{T:1,N:'w2:dataCollection',A:{baseNode:'map'},E:[{T:1,N:'w2:dataMap',A:{baseNode:'map',id:'dataMap1','ev:onbeforemodelchange':'scwin.dataMap1_onbeforemodelchange'},E:[{T:1,N:'w2:keyInfo',E:[{T:1,N:'w2:key',A:{id:'id',name:'id',dataType:'text'}},{T:1,N:'w2:key',A:{id:'type',name:'type',dataType:'text'}},{T:1,N:'w2:key',A:{id:'color',name:'color',dataType:'text'}},{T:1,N:'w2:key',A:{id:'shape',name:'shape',dataType:'text'}}]},{T:1,N:'w2:data',A:{use:'true'},E:[{T:1,N:'id',E:[{T:4,cdata:'1001'}]},{T:1,N:'type',E:[{T:4,cdata:'Medical'}]},{T:1,N:'color',E:[{T:4,cdata:'Red'}]},{T:1,N:'shape',E:[{T:4,cdata:'Round'}]}]}]}]},{T:1,N:'w2:workflowCollection'}]},{T:1,N:'script',A:{type:'text/javascript',lazy:'false'},E:[{T:4,cdata:function(scopeObj){with(scopeObj){scwin.onpageload = function () {};
scwin.onpageunload = function () {};
scwin.trigger1_onclick = function (e) {
  dataMap1.set("type", "Tourism");
};
scwin.trigger2_onclick = function (e) {
  dataMap1.set("type", "Leisure");
};
scwin.dataMap1_onbeforemodelchange = function (info) {
  if (info.newValue == "Leisure") {
    alert(info.newValue + " cannot be used.");
    return false;
  } else {
    alert("Event - onbeforemodelchange\n\nKey : " + info.key + "\n\nOldValue : " + info.oldValue + "\n\nNewValue : " + info.newValue);
  }
};
}}}]}]},{T:1,N:'body',A:{'ev:onpageload':'scwin.onpageload','ev:onpageunload':'scwin.onpageunload'},E:[{T:1,N:'xf:group',A:{id:'',style:'margin: 10px;'},E:[{T:1,N:'w2:textbox',A:{tagname:'h1',style:'color: blue;margin-bottom: 10px;',tabIndex:'h1',id:'textbox1',label:'이벤트 - onbeforemodelchange',escape:'false'}},{T:1,N:'w2:textbox',A:{tagname:'h2',style:'height: 23px;margin-bottom: 10px;color: blue;',id:'textbox2',label:'샘플 사용 방법'}},{T:1,N:'w2:textbox',A:{style:'color: blue;margin-bottom: 30px;',id:'textbox3',label:'1-1. 첫 번째 버튼을 클릭. <br/>1-2. onbeforemodelchange 이벤트가 발생하고 dataMap1의 데이터가 변경되어 바인딩된 InputBox에 반영되는 것을 확인. <br/><br/>2-1. 두 번째 버튼을 클릭. <br/>2-2. onbeforemodelchange 이벤트가 발생하고 이벤트 핸들러가 "false"를 반환하여 set() 메소드 동작이 실행되지 않고 dataMap1의 데이터가 변경되지 않는 것을 확인. ',escape:'false'}},{T:1,N:'w2:textbox',A:{style:'padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightgreen;border:none;margin-bottom: 10px;',id:'textbox4',label:'이벤트 설명<br/>onbeforemodelchange - 데이터 값이 변경되기 직전에 발생.',escape:'false'}},{T:1,N:'xf:trigger',A:{'ev:onclick':'scwin.trigger1_onclick',style:'height:42px;line-height:32px;padding:5px;background-color:coral;font-size:15px;weight: bolder;font-weight:bolder;text-align: left;display: block;margin-bottom: 10px;',id:'trigger1',type:'button'},E:[{T:1,N:'xf:label',E:[{T:4,cdata:'dataMap1.set("type", "Tourism");'}]}]},{T:1,N:'xf:trigger',A:{type:'button',id:'trigger2',style:'height:42px;line-height:32px;padding:5px;background-color:coral;font-size:15px;weight: bolder;font-weight:bolder;text-align: left;display: block;margin-bottom: 10px;','ev:onclick':'scwin.trigger2_onclick'},E:[{T:1,N:'xf:label',E:[{T:4,cdata:'dataMap1.set("type", "Leisure");'}]}]},{T:1,N:'xf:input',A:{ref:'data:dataMap1.id',style:'width:140px;height:30px;padding:5px;text-align:left;font-size:20px;font-style:normal;font-weight:bolder;margin-top: 10px;display: block;',id:'input1'}},{T:1,N:'xf:input',A:{ref:'data:dataMap1.type',style:'width:140px;height:30px;padding