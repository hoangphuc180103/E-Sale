scwin.trigger1_onclick = function (e) {
  dataList1.setData(["Beijing", "201", "Tokyo", "202", "Taipei", "203"]);
};
scwin.trigger2_onclick = function (e) {
  var tmpJSON = [{
    "Name": "Paris",
    "Value": "101"
  }, {
    "Name": "London",
    "Value": "102"
  }, {
    "Name": "Munich",
    "Value": "103"
