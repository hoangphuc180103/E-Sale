  requires("uiplugin.popup");
};
scwin.onpageunload = function () {};
scwin.trigger1_onclick = function () {
  const tmpSrc = scwin.getfolderPath() + "/wframe.xml";
  var scopeInheritValue = radio1.getValue();
  var options = {
    id: "popup",
    type: "wframePopup",
    popupName: "scopeInherit = " + scopeInheritValue,
    width: "600px",
    height: "400px",
    modal: true,
    scopeInherit: scopeInheritValue
  };
  $p.openPopup(tmpSrc, options);
};
scwin.trigger2_onclick = function (e) {};
scwin.getfolderPath = function () {
  var currentPath = window.location.href;
  var folderPath;
  if (currentPath.includes("mainContainer")) {
    console.log("true  ===> " + $p.getFrameId());
    const cmtFrame = $p.getComponentById($p.getFrameId());
    currentPath = cmtFrame.getSrc();
    folderPath = currentPath.substring(0, currentPath.lastIndexOf('/'));
  } else {
    console.log("false  ===> ");
    folderPath = currentPath.split('w2xPath=')[1].substring(0, currentPath.split('w2xPath=')[1].lastIndexOf('/'));
  }
  return folderPath;
};
}}}]}]},{T:1,N:'body',A:{'ev:onpageload':'scwin.onpageload','ev:onpageunload':'scwin.onpageunload'},E:[{T:1,N:'xf:group',A:{id:'',style:'margin: 10px;'},E:[{T:1,N:'w2:textbox',A:{tagname:'h1',style:'color: blue;margin-bottom: 10px;',id:'textbox2',label:'Inherit Parent Scope<br/>',escape:'false'}},{T:1,N:'w2:textbox',A:{tagname:'h2',style:'height: 23px;margin-bottom: 10px;color: blue;',id:'textbox3',label:'How to Use'}},{T:1,N:'w2:textbox',A:{style:'color: blue;margin-bottom: 30px;',id:'textbox4',label:'(Run the example standalone.)<br/>1. Select the scopeInherit option value. (none, api, all, or component)<br/>2. Click the openPopup() button below.<br/>3. Verify that a popup is created and displays a screen with nested WFrame components.<br/>4. Click each button inside the WFrame.<br/>5. Verify each button behaves according to the scopeInherit property value.<br/> &nbsp; &nbsp; “none”: (1) X, (2) Top-level access, (3) O<br/> &nbsp; &nbsp; “api”: (1) X, (2) Parent access, (3) O<br/> &nbsp; &nbsp; “api” : (1) X, (2) Parent access, (3) O<br/> &nbsp; &nbsp; “all” : (1) O, (2) Parent access, (3) O<br/> &nbsp; &nbsp; “component” : (1) O, (2) Top-level access, (3) O',escape:'false'}},{T:1,N:'w2:textbox',A:{style:'padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightpink;border:none;margin-bottom: 10px;',id:'textbox5',label:'Select the scopeInherit property value.',escape:'false'}},{T:1,N:'xf:select1',A:{ref:'',appearance:'full',style:'margin-bottom: 10px;margin-bottom: 20px;border: solid 2px lightpink;padding: 10px;',id:'radio1',rows:'1',cols:'',selectedIndex:'-1'},E:[{T:1,N:'xf:choices',E:[{T:1,N:'xf:item',E:[{T:1,N:'xf:label',E:[{T:4,cdata:'none'}]},{T:1,N:'xf:value',E:[{T:4,cdata:'none'}]}]},{T:1,N:'xf:item',E:[{T:1,N:'xf:label',E:[{T:4,cdata:'api'}]},{T:1,N:'xf:value',E:[{T:4,cdata:'api'}]}]},{T:1,N:'xf:item',E:[{T:1,N:'xf:label',E:[{T:4,cdata:'all'}]},{T:1,N:'xf:value',E:[{T:4,cdata:'all'}]}]},{T:1,N:'xf:item',E:[{T:1,N:'xf:label',E:[{