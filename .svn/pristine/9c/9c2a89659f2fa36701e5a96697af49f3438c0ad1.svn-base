scwin.btn_setGridHeight_onclick = function (e) {
  var tmpHeight = ibx_gridHeight.getValue();
  if (!tmpHeight) {
    alert("변경할 그리드의 높이를 입력하세요.");
    ibx_gridHeight.focus();
    return;
  }
  grd_example.setGridHeight(tmpHeight);
  grd_example.setScrollTop(0);
  grd_example2.setGridHeight(tmpHeight);
  grd_example2.setScrollTop(0);
  txt_visibleRowCount.setValue(grd_example.getVisibleRowNum());
};
