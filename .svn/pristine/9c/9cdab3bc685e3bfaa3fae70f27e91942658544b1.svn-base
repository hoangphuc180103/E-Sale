<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare"
	xmlns:xf="http://www.w3.org/2002/xforms">
	<head meta_author="InswaveSystems" meta_type="메인" meta_screenName="[GridView] 컬럼의 너비를 그리드 너비에 맞춰 자동 조절 설정하기 및 해제하기 - 스크립트">
		<w2:historyInfo>
			<w2:history meta_no="01" meta_desc="최초작성" meta_date="20221223" meta_user="InswaveSystems"></w2:history>
			<w2:history meta_no="02" meta_desc="설명부 수정" meta_date="20240621" meta_user="InswaveSystems"></w2:history>
			<w2:history meta_no="03" meta_desc="예제에서 사용하는 DataList가 변경되고, 이에 따른 GridVeiw의 설정이 수정되었습니다." meta_date="20240705"
				meta_user="InswaveSystems"></w2:history>
		</w2:historyInfo>
		<w2:type>COMPONENT</w2:type>
		<w2:buildDate />
		<w2:MSA />
		<xf:model>
			<w2:dataCollection>
				<w2:dataList baseNode="list" repeatNode="map" id="dlt_exam" saveRemovedData="true">
					<w2:columnInfo>
						<w2:column dataType="text" name="A" id="col_a"></w2:column>
						<w2:column dataType="text" name="B" id="col_b"></w2:column>
						<w2:column dataType="text" name="C" id="col_c"></w2:column>
					</w2:columnInfo>
					<w2:data use="true">
						<w2:row>
							<col_a><![CDATA[A1]]></col_a>
							<col_b><![CDATA[B1]]></col_b>
							<col_c><![CDATA[C1]]></col_c>
						</w2:row>
						<w2:row>
							<col_a><![CDATA[A2]]></col_a>
							<col_b><![CDATA[B2]]></col_b>
							<col_c><![CDATA[C2]]></col_c>
						</w2:row>
						<w2:row>
							<col_a><![CDATA[A3]]></col_a>
							<col_b><![CDATA[B3]]></col_b>
							<col_c><![CDATA[C3]]></col_c>
						</w2:row>
					</w2:data>
				</w2:dataList>
			</w2:dataCollection>
			<w2:workflowCollection />
		</xf:model>
		<w2:layoutInfo />
		<w2:publicInfo method="" />
		<script lazy="false" type="text/javascript"><![CDATA[
scwin.onpageload = function () {

};

/**
 * 버튼 [autoFit의 설정 값을 'allColumn'으로 설정하기] 클릭 시
 */
scwin.btn_ex1_onclick = function (e) {
    var jsnAutoFitOptions;

    jsnAutoFitOptions = {
        type: "allColumn"  //autoFit 타입
        //, minWidth : "300" //설정 값은 px 단위이며, gridView의 width가 설정 값보다 작아질 경우에 각 컬럼의 width의 합이 설정 값로 고정되어 계산됩니다. GridView의 속성 autoFitMinWidth과는 다른 기능입니다.
    };

    //GridView [grd_exam1]에 autoFit 속성을 설정합니다.
    grd_exam1.setAutoFit(jsnAutoFitOptions);
};

/**
 * 버튼 [autoFit의 설정 값을 'lastColumn'으로 설정하기] 클릭 시
 */
scwin.btn_ex2_onclick = function (e) {
    var jsnAutoFitOptions;

    jsnAutoFitOptions = {
        type: "lastColumn"  //autoFit 타입
    };

    //GridView [grd_exam2]에 autoFit 속성을 설정합니다.
    grd_exam2.setAutoFit(jsnAutoFitOptions);
};

/**
 * 버튼 [autoFit 속성의 설정 해제하기] 클릭 시
 */
scwin.btn_ex3_onclick = function (e) {
    //GridView [grd_exam3]에 autoFit 속성을 해제합니다.
    grd_exam3.clearAutoFit();
};


]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:group class="sub_contents" id="" style="">
			<xf:group class="ws_example_grp_desc" id="" style="">
				<w2:textbox escape="false" id=""
					label="GridView의 'setAutoFit' 메소드와 'clearAutoFit' 메소드를 사용하여, 'autoFit' 속성을 설정하거나 해제하는 예제입니다." style="">
				</w2:textbox>
			</xf:group>
			<xf:group class="example_div_tb_style_wrap" id="">
				<xf:group class="example_div_tr_style" id="" style="">
					<w2:textbox class="example_div_th_style" escape="false" id="" label="GridView의 너비에 맞춰 컬럼을 균등하게 설정" style=""></w2:textbox>
					<xf:group class="example_div_td_style" id="" style="">
						<xf:group class="mb_def_box nobottom" id="" style="">
							<xf:trigger class="btn_exam_exec btn_txt_of" disabled="" escape="false" ev:onclick="scwin.btn_ex1_onclick" id="btn_ex1"
								style="" type="button">
								<xf:label><![CDATA[autoFit의 설정 값을 'allColumn'으로 설정하기]]></xf:label>
							</xf:trigger>
						</xf:group>
						<xf:group id="" class="gvwbox">
							<w2:gridView dataList="data:dlt_exam" style="height: 90px;" readOnly="true" id="grd_exam1" visibleRowNum="all"
								autoFit="none" class="gvw" defaultCellHeight="37">
								<w2:caption style="" id="caption1" value="this is a grid caption."></w2:caption>
								<w2:header id="header1">
									<w2:row id="row1">
										<w2:column width="70" inputType="text" id="column1" value="A" displayMode="label"></w2:column>
										<w2:column width="70" inputType="text" id="column2" value="B" displayMode="label"></w2:column>
										<w2:column width="70" inputType="text" id="column3" value="C" displayMode="label"></w2:column>
									</w2:row>
								</w2:header>
								<w2:gBody id="gBody1">
									<w2:row id="row2">
										<w2:column width="70" inputType="text" id="col_a" displayMode="label"></w2:column>
										<w2:column width="70" inputType="text" id="col_b" displayMode="label"></w2:column>
										<w2:column width="70" inputType="text" id="col_c" displayMode="label"></w2:column>
									</w2:row>
								</w2:gBody>
							</w2:gridView>
						</xf:group>
					</xf:group>
				</xf:group>
				<xf:group class="example_div_tr_style" id="" style="">
					<w2:textbox class="example_div_th_style" escape="false" id="" label="GridView의 남은 여백을 마지막 컬럼에 설정하기" style=""></w2:textbox>
					<xf:group class="example_div_td_style" id="" style="">
						<xf:group class="mb_def_box nobottom" id="" style="">
							<xf:trigger class="btn_exam_exec btn_txt_of" disabled="" escape="false" ev:onclick="scwin.btn_ex2_onclick" id="btn_ex2"
								style="" type="button">
								<xf:label><![CDATA[autoFit의 설정 값을 'lastColumn'으로 설정하기]]></xf:label>
							</xf:trigger>
						</xf:group>
						<xf:group id="" class="gvwbox">
							<w2:gridView dataList="data:dlt_exam" readOnly="true" style="height: 90px;" autoFit="none" id="grd_exam2"
								visibleRowNum="all" class="gvw" defaultCellHeight="37">
								<w2:caption style="" id="caption1" value="this is a grid caption."></w2:caption>
								<w2:header id="header1">
									<w2:row id="row1">
										<w2:column width="70" inputType="text" id="column1" value="A" displayMode="label"></w2:column>
										<w2:column width="70" inputType="text" id="column2" value="B" displayMode="label"></w2:column>
										<w2:column width="70" inputType="text" id="column3" value="C" displayMode="label"></w2:column>
									</w2:row>
								</w2:header>
								<w2:gBody id="gBody1">
									<w2:row id="row2">
										<w2:column width="70" inputType="text" id="col_a" displayMode="label"></w2:column>
										<w2:column width="70" inputType="text" id="col_b" displayMode="label"></w2:column>
										<w2:column width="70" inputType="text" id="col_c" displayMode="label"></w2:column>
									</w2:row>
								</w2:gBody>
							</w2:gridView>
						</xf:group>
					</xf:group>
				</xf:group>
				<xf:group class="example_div_tr_style" id="" style="">
					<w2:textbox class="example_div_th_style" escape="false" id="" label="autoFit 속성의 설정 해제하기" style=""></w2:textbox>
					<xf:group class="example_div_td_style" id="" style="">
						<xf:group class="mb_def_box nobottom" id="" style="">
							<xf:trigger class="btn_exam_exec btn_txt_of" disabled="" escape="false" ev:onclick="scwin.btn_ex3_onclick" id="btn_ex3"
								style="" type="button">
								<xf:label><![CDATA[autoFit 속성의 설정 해제하기]]></xf:label>
							</xf:trigger>
						</xf:group>
						<xf:group id="" class="gvwbox">
							<w2:gridView dataList="data:dlt_exam" readOnly="true" style="height: 90px;" autoFit="lastColumn" id="grd_exam3"
								visibleRowNum="all" class="gvw" defaultCellHeight="37">
								<w2:caption style="" id="caption1" value="this is a grid caption."></w2:caption>
								<w2:header id="header1">
									<w2:row id="row1">
										<w2:column width="70" inputType="text" id="column1" value="A" displayMode="label"></w2:column>
										<w2:column width="70" inputType="text" id="column2" value="B" displayMode="label"></w2:column>
										<w2:column width="70" inputType="text" id="column3" value="C" displayMode="label"></w2:column>
									</w2:row>
								</w2:header>
								<w2:gBody id="gBody1">
									<w2:row id="row2">
										<w2:column width="70" inputType="text" id="col_a" displayMode="label"></w2:column>
										<w2:column width="70" inputType="text" id="col_b" displayMode="label"></w2:column>
										<w2:column width="70" inputType="text" id="col_c" displayMode="label"></w2:column>
									</w2:row>
								</w2:gBody>
							</w2:gridView>
						</xf:group>
					</xf:group>
				</xf:group>
			</xf:group>
		</xf:group>
	</body>
</html>