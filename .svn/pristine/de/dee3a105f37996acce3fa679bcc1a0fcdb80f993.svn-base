/**
 * 사용자 정의 필터 메소드
 * 메소드 'scwin.btn_exam1_4_onclick'에서 호출
 * @param {string} argCellData 검색 대상 데이터.
 * @param {object} argUserParam 사용자가 할당한 인자.
 * @param {number} argRowIndex 행의 인덱스.
 * @returns {boolean} 데이터 추출(포함) 여부.
 */
scwin.userColumnFilter_type4 = function (argCellData, argUserParam, argRowIndex) {
  let returnValue = false; // 반환 값.

  // 데이터가 'Servers'와 일치하거나 'Services'가 포함되어 있으면 추출
  if (argCellData.search(new RegExp("^Servers$|Services")) > -1) {
    returnValue = true;
  }
  return returnValue;
};

/**
 * 버튼 ['Category' 컬럼의 데이터가 'Networking'과 일치하고 'Stock' 컬럼의 데이터가 '15000' 이상] 클릭 시
 */
scwin.btn_exam1_5_onclick = function (e) {
  // DataList 'dlt_exam'에 필터를 해제합니다.
  dlt_exam.clearFilter();

  // 필터 조건이 담긴 JSON
  let jsnFilterOptions = {};
  jsnFilterOptions.type = "func"; // 검색 방식. 'key' 속성에 정의된 메소드로 검색.
  jsnFilterOptions.colIndex = "category"; // DataList의 컬럼 ID 또는 컬럼 Index. 검색 대상.
  jsnFilterOptions.key = scwin.userColumnFilter_type5; // 사용자 정의 메소드 객체
  jsnFilterOptions.param = "type5"; // 메소드에 전달할 인자 객체. 사용자 정의 메소드의 두 번째 인자에 할당됩니다.
  jsnFilterOptions.condition = "and"; // 기 적용된 필터 데이터와의 병합 조건. 최초 필터를 적용하는 경우 "and"로 할당. 

  // DataList 'dlt_exam'에 필터를 적용합니다.
  dlt_exam.setColumnFilter(jsnFilterOptions);

  // 로그 출력
  let strLog = "# 'Category' 컬럼의 데이터가 'Networking'과 일치하고 'Stock' 컬럼의 데이터가 '15000' 이상";
  let logOptions = '\n' + '{' + '\n' + '	"type": "func",' + '\n' + '	"colIndex": "category",' + '\n' + '	"key": scwin.userColumnFilter_type5,' + '\n' + '	"param": "type5",' + '\n' + '	"condition": "and"' + '\n' + '}';
  $c.frame.printExampleLog($p, strLog, txa_log, false);
  $c.frame.printExampleLog($p, logOptions, txa_log, false);
  console.log(strLog);
  console.log(jsnFilterOptions);
};

/**
 * 사용자 정의 필터 메소드
 * 메소드 'scwin.btn_exam1_5_onclick'에서 호출
 * @param {string} argCellData 검색 대상 데이터.
 * @param {object} argUserParam 사용자가 할당한 인자.
 * @param {number} argRowIndex 행의 인덱스.
 * @returns {boolean} 데이터 추출(포함) 여부.
 */
scwin.userColumnFilter_type5 = function (argCellData, argUserParam, argRowIndex) {
  let returnValue = false; // 반환 값.

  // 'Category' 컬럼의 데이터가 'Networking'과 일치하고 'Stock' 컬럼의 데이터가 '15000' 이상이면 추출
  if (argCellData === "Networking") {
    // 컬럼 'stock'의 값을 추출하여 숫자형으로 변환
    let numstock = Number(dlt_exam.getCellData(argRowIndex, "stock"));
    if (typeof numstock === "number" && numstock >= 15000) {
      returnValue = true;
    }
  }
  return returnValue;
};

/**
 * textarea의 로그 삭제
 */
scwin.btn_clearLog_onclick = function (e) {
  //textarea value를 빈문자열로 할당.
