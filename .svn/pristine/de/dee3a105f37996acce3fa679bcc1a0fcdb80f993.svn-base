/**
 * DataList 'dlt_exam'에 데이터 할당하기
 */
scwin.initData = function () {
  // DataList 'dlt_exam'에 데이터 할당하기
  let data = [{
    "category": "Networking",
    "product": "SpeedLink",
    "stock": "15800"
  }, {
    "category": "Cloud Services",
    "product": "CloudFlex",
    "stock": "17800"
  }, {
    "category": "Support Services",
    "product": "TechAssist",
    "stock": "15800"
  }, {
    "category": "Servers",
    "product": "EcoServe",
    "stock": "17200"
  }, {
    "category": "Cloud Services",
    "product": "CloudPro",
    "stock": "18000"
  }, {
    "category": "Networking",
    "product": "NetMax",
    "stock": "16000"
  }, {
    "category": "Support Services",
    "product": "TechTeam",
    "stock": "17800"
  }, {
    "category": "Security",
    "product": "SecureGate",
    "stock": "28900"
  }, {
    "category": "Networking",
    "product": "LinkSecure",
    "stock": "12500"
  }];
  dlt_exam.setJSON(data);

  // DataList 'dlt_exam'의 모든 필터 해제하기
  dlt_exam.clearFilter();
};

/**
 * 버튼 [DataList의 데이터 초기화] 클릭 시
 */
scwin.btn_initData_onclick = function (e) {
  scwin.initData();
};

/**
 * 버튼 [DataList의 필터 전체 해제] 클릭 시
 */
scwin.btn_clearFilter_onclick = function (e) {
  // DataList 'dlt_exam'의 모든 필터 해제하기
  dlt_exam.clearFilter();
};

/**
 * 버튼 ['Category' 컬럼에 필터 적용 - 데이터가 'Networking'과 일치] 클릭 시
 */
scwin.btn_exam1_1_onclick = function (e) {
  // DataList 'dlt_exam'에 필터를 해제합니다.
  dlt_exam.clearFilter();

  // 필터 조건이 담긴 JSON
  let jsnFilterOptions = {};
  jsnFilterOptions.type = "func"; // 검색 방식. 'key' 속성에 정의된 메소드로 검색.
  jsnFilterOptions.colIndex = "category"; // DataList의 컬럼 ID 또는 컬럼 Index. 검색 대상.
  jsnFilterOptions.key = scwin.userColumnFilter_type1; // 사용자 정의 메소드 객체
  jsnFilterOptions.param = "type1"; // 메소드에 전달할 인자 객체. 사용자 정의 메소드의 두 번째 인자에 할당됩니다.
  jsnFilterOptions.condition = "and"; // 기 적용된 필터 데이터와의 병합 조건. 최초 필터를 적용하는 경우 "and"로 할당.     

  // 검색 대상 데이터 : ID가 "category"인 컬럼
  // 검색 방법 : 사용자 정의 메소드 - scwin.userColumnFilter_type1
  // 기 적용된 필터 데이터와의 병합 조건 : 교집합

  // DataList 'dlt_exam'에 필터를 적용합니다.
  dlt_exam.setColumnFilter(jsnFilterOptions);

  // 로그 출력
  let strLog = "# 'Category' 컬럼에 필터 적용 - 데이터가 'Networking' | 필터 조건 ";
  let logOptions = '\n' + '{' + '\n' + '	"type": "func",' + '\n' + '	"colIndex": "category",' + '\n' + '	"key": scwin.userColumnFilter_type1,' + '\n' + '	"param": "type1",' + '\n' + '	"condition": "and"' + '\n' + '}';
  $c.frame.printExampleLog($p, strLog, txa_log, false);
  $c.frame.printExampleLog($p, logOptions, txa_log, false);
  console.log(strLog);
  console.log(jsnFilterOptions);
};

/**
 * 사용자 정의 필터 메소드
 * 메소드 'scwin.btn_exam1_1_onclick'에서 호출
 * @param {string} argCellData 검색 대상 데이터.
 * @param {object} argUserParam 사용자가 할당한 인자.
 * @param {number} argRowIndex 행의 인덱스.
 * @returns {boolean} 데이터 추출(포함) 여부.
 */
scwin.userColumnFilter_type1 = function (argCellData, argUserParam, argRowIndex) {
  let returnValue = false; // 반환 값.

  // 데이터가 'Networking'과 동일하면 추출
  if (argCellData === "Networking") {
    returnValue = true;
  }
  return returnValue;
};

