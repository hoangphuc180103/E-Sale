  let returnValue = false; // 반환 값.

  // 데이터 중 'Services'가 포함되어 있으면 추출
  if (typeof argCellData === "string" && argCellData.indexOf("Services") > -1) {
    returnValue = true;
  }
  return returnValue;
};

