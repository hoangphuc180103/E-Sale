scwin.onpageunload = function () {};
scwin.trigger1_onclick = function (e) {
  var options = {};
  options.headerExist = "1";
  options.decimal = "3";
  options.applyDecimal = "1";
  gridView1.advancedExcelUpload(options);
};
scwin.trigger2_onclick = function (e) {
  var options = {};
  options.headerExist = "1";
  gridView1.advancedExcelUpload(options);
};
scwin.trigger3_onclick = function (e) {
  var tmpSrc = scwin.getfolderPath() + "/decimalNumbers.xlsx";
  var name = "decimalNumbers.xlsx";
  scwin.downloadFile(tmpSrc, name);
};
scwin.downloadFile = function (tmpSrc, name) {
  const link = document.createElement('a');
  link.href = tmpSrc;
  link.download = name;
  link.click();
};
scwin.getfolderPath = function () {
  var currentPath = window.location.href;
  var folderPath;
  if (currentPath.includes("mainContainer")) {
    console.log("true  ===> " + $p.getFrameId());
    const cmtFrame = $p.getComponentById($p.getFrameId());
    currentPath = cmtFrame.getSrc();
    folderPath = currentPath.substring(0, currentPath.lastIndexOf('/'));
  } else {
    console.log("false  ===> ");
    folderPath = currentPath.split('w2xPath=')[1].substring(0, currentPath.split('w2xPath=')[1].lastIndexOf('/'));
  }
  return folderPath;
};
}}}]}]},{T:1,N:'body',A:{'ev:onpageload':'scwin.onpageload','ev:onpageunload':'scwin.onpageunload'},E:[{T:1,N:'xf:group',A:{id:'',style:'margin: 10px;'},E:[{T:1,N:'w2:textbox',A:{tagname:'h1',style:'color: blue;margin-bottom: 10px;',tabIndex:'h1',id:'textbox1',label:'소수점 반올림 후 GridView로 업로드',escape:'false'}},{T:1,N:'w2:textbox',A:{tagname:'h2',style:'height: 23px;margin-bottom: 10px;color: blue;',id:'textbox2',label:'샘플 사용 방법'}},{T:1,N:'w2:textbox',A:{style:'color: blue;margin-bottom: 30px;',id:'textbox3',label:'1. 소수점 3자리를 초과하는 정수를 포함한 Excel 파일을 준비. ( 혹은 하단의 버튼을 클릭하여 예제 파일을 다운로드.)<br/><br/>(options.applyDecimal="1" & options.decimal = "3")<br/>2-1. 첫 번째 버튼을 클릭하고 Excel 파일을 업로드.<br/>2-2. 소수점 3째 자리까지 반올림되어 GridView로 업로드되는 것을 확인. <br/><br/>(options.applyDecimal="0")<br/>3-1. 두 번째 버튼을 클릭하고 Excel 파일을 업로드. <br/>3-2. 반올림 처리 없이 그대로 GridView로 업로드되는 것을 확인.',escape:'false'}},{T:1,N:'xf:trigger',A:{'ev:onclick':'scwin.trigger1_onclick',style:'height:42px;line-height:32px;padding:5px;background-color:coral;font-size:15px;weight: bolder;font-weight:bolder;text-align: left;display: block;margin-bottom: 10px;',id:'trigger1',type:'button'},E:[{T:1,N:'xf:label',E:[{T:4,cdata:'advancedExcelUpload(options) - options.applyDecimal="1"'}]}]},{T:1,N:'xf:trigger',A:{type:'button',id:'trigger2',style:'height:42px;line-height:32px;padding:5px;background-color:coral;font-size:15px;weight: bolder;font-weight:bolder;text-align: left;display: block;margin-bottom: 10px;','ev:onclick':'scwin.trigger2_onclick'},E:[{T:1,N:'xf:label',E:[{T:4,cdata:'advancedExcelUpload(options) - options.applyDecimal="0"'}]}]},{T:1,N:'xf:trigger',A:{type:'button',id:'trigger3',style:'height:42px;line-height:32px;padding:5px;background-color:lightpink;font-size:15px;weight: bolder;font-weight:bolder;text-align: left;margin-bottom: 10px;display: block','ev:onclick':'scwin.trigger3_onclick'},E:[{T:1,N:'xf:label',E:[{T:4,cdata:'업로드용 샘플 Excel 파일 다운로드'}]}]},{T:1,N:'w2:gridView',A:{scrollByColumnAdaptive:'false',focusMode:'ro