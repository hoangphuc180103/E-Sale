<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            	<w2:dataList id="dataList1" saveRemovedData="true">
            	    <w2:columnInfo>
            	        <w2:column id="col1" name="col1" dataType="text"></w2:column>
            	        <w2:column id="col2" name="col2" dataType="text"></w2:column>
            	        <w2:column id="col3" name="col3" dataType="text"></w2:column>
            	        <w2:column id="col4" name="col4" dataType="text"></w2:column>
            	        <w2:column id="col5" name="col5" dataType="text"></w2:column>
            	    </w2:columnInfo>
            	    <w2:data xmlns="" use="false"></w2:data>
            	</w2:dataList>
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
         <script type="text/javascript" lazy="false"><![CDATA[
        
	scwin.onpageload = function() {
		
	};
	
	scwin.onpageunload = function() {
		
	};
            
   
    scwin.trigger1_onclick = function() {
        var options = {
            headerExist:"1",
			sheetName: "sheet3"
        };
        gridView1.advancedExcelUpload(options);
    };
	

scwin.trigger2_onclick = function (e) {
    var tmpSrc = scwin.getfolderPath() + "/Excel_for_GridView.xlsx";
    var name = "Excel_for_GridView.xlsx"
    scwin.downloadFile(tmpSrc, name);
};

scwin.downloadFile = function(tmpSrc, name) {
    const link = document.createElement('a');
    link.href = tmpSrc;
    link.download = name;
    link.click();
}

scwin.getfolderPath = function () {

    var currentPath = window.location.href;
    var folderPath;

    if (currentPath.includes("mainContainer")) {
        console.log("true  ===> " + $p.getFrameId());
        const cmtFrame = $p.getComponentById($p.getFrameId());
        currentPath = cmtFrame.getSrc();
        folderPath = currentPath.substring(0, currentPath.lastIndexOf('/'));
    } else {
        console.log("false  ===> ");
        folderPath = currentPath.split('w2xPath=')[1].substring(0, currentPath.split('w2xPath=')[1].lastIndexOf('/'));
    }
    return folderPath;
};]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload" ev:onpageunload="scwin.onpageunload">
    <xf:group id="" style="margin: 10px;">
    	<w2:textbox tagname="h1" style="color: blue;margin-bottom: 10px;" tabIndex="h1" id="textbox1" label="特定のExcelシートのみをアップロード"
    		escape="false">
    	</w2:textbox>
    	<w2:textbox tagname="h2" style="height: 23px;margin-bottom: 10px;color: blue;" id="textbox2" label="サンプルの使い方"></w2:textbox>
    	<w2:textbox style="color: blue;margin-bottom: 30px;" id="textbox3"
    		label='1. 3犬以上シート含む Excel ファイル準備。 &lt;br/&gt;2. ボタンクリックして Excel ファイルアップロード。 &lt;br/&gt;3. Excel ファイルの 3目シートのみアップロードされたもの確認。&lt;br/&gt;(advancedExcelUpload(options) - options.sheetName="sheet3")'
    		escape="false">
    	</w2:textbox>
    	<xf:trigger ev:onclick="scwin.trigger1_onclick"
    		style="height:42px;line-height:32px;padding:5px;background-color:coral;font-size:15px;weight: bolder;font-weight:bolder;text-align: left;margin-bottom: 10px;"
    		id="trigger1" type="button">
    		<xf:label><![CDATA[advancedExcelUpload(options)]]></xf:label>
    	</xf:trigger>
    	<xf:trigger type="button" id="trigger2"
    		style="height:42px;line-height:32px;padding:5px;background-color:lightpink;font-size:15px;weight: bolder;font-weight:bolder;text-align: left;margin-bottom: 10px;margin-left: 30px;"
    		ev:onclick="scwin.trigger2_onclick">
    		<xf:label><![CDATA[アップロード用のサンプルExcelファイルをダウンロード]]></xf:label>
    	</xf:trigger>
    	<w2:gridView syncScroll="false" scrollByColumnAdaptive="false" summaryAuto="false" useShiftKey="true" scrollByColumn="false"
    		summaryOnlyAuto="false" defaultCellHeight="20" applyAllColumnStyle="false" dataList="data:dataList1" style="border: solid gray 1px;margin-bottom: 10px;"
    		ignoreCellClick="false" id="gridView1" ignoreToggleOnDisabled="false" visibleRowNum="10" visibleRowNumFix="true"
    		autoFit="allColumn">
    		<w2:caption style="" id="caption1" value="this is a grid caption."></w2:caption>
    		<w2:header style="" id="header1">
    			<w2:row style="" id="row1">
    				<w2:column width="70" inputType="text" style="" id="column5" value="col1" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="" id="column4" value="col2" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="" id="column3" value="col3" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="" id="column2" value="col4" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="" id="column1" value="col5" displayMode="label"></w2:column>
    			</w2:row>
    		</w2:header>
    		<w2:gBody style="" id="gBody1">
    			<w2:row style="" id="row2">
    				<w2:column width="70" inputType="text" style="" id="col1" value="" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="" id="col2" value="" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="" id="col3" value="" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="" id="col4" value="" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="" id="col5" value="" displayMode="label"></w2:column>
    			</w2:row>
    		</w2:gBody>
    	</w2:gridView>
    	<w2:textbox escape="false" id="textbox4"
    		label='/// サンプルコード &lt;br/&gt;&lt;br/&gt;var options = {&lt;br/&gt; &amp;nbsp; &amp;nbsp;headerExist: "1",&lt;br/&gt; &amp;nbsp; &amp;nbsp;sheetName: "sheet3"&lt;br/&gt;};&lt;br/&gt;gridView1.advancedExcelUpload(options);'
    		style="padding:10px; padding-bottom:20px; text-align:left; font-size:15px; font-weight:bolder; border:brown 1px solid; background-color:ivory; margin-bottom:10px; color:brown;"
    		tagname="">
    	</w2:textbox>
    </xf:group></body>
</html>
