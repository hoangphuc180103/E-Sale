,E:[{T:4,cdata:'10000'}]},{T:1,N:'quarter4',E:[{T:4,cdata:'8000'}]}]},{T:1,N:'w2:row',E:[{T:1,N:'Month',E:[{T:4,cdata:'June'}]},{T:1,N:'quarter1',E:[{T:4,cdata:'19700'}]},{T:1,N:'quarter2',E:[{T:4,cdata:'32600'}]},{T:1,N:'quarter3',E:[{T:4,cdata:'22600'}]},{T:1,N:'quarter4',E:[{T:4,cdata:'17000'}]}]},{T:1,N:'w2:row',E:[{T:1,N:'Month',E:[{T:4,cdata:'July'}]},{T:1,N:'quarter1',E:[{T:4,cdata:'27400'}]},{T:1,N:'quarter2',E:[{T:4,cdata:'29700'}]},{T:1,N:'quarter3',E:[{T:4,cdata:'31900'}]},{T:1,N:'quarter4',E:[{T:4,cdata:'27000'}]}]},{T:1,N:'w2:row',E:[{T:1,N:'Month',E:[{T:4,cdata:'August'}]},{T:1,N:'quarter1',E:[{T:4,cdata:'27400'}]},{T:1,N:'quarter2',E:[{T:4,cdata:'10000'}]},{T:1,N:'quarter3',E:[{T:4,cdata:'21800'}]},{T:1,N:'quarter4',E:[{T:4,cdata:'19000'}]}]},{T:1,N:'w2:row',E:[{T:1,N:'Month',E:[{T:4,cdata:'September'}]},{T:1,N:'quarter1',E:[{T:4,cdata:'27400'}]},{T:1,N:'quarter2',E:[{T:4,cdata:'31800'}]},{T:1,N:'quarter3',E:[{T:4,cdata:'42800'}]},{T:1,N:'quarter4',E:[{T:4,cdata:'32000'}]}]},{T:1,N:'w2:row',E:[{T:1,N:'Month',E:[{T:4,cdata:'October'}]},{T:1,N:'quarter1',E:[{T:4,cdata:'27400'}]},{T:1,N:'quarter2',E:[{T:4,cdata:'15000'}]},{T:1,N:'quarter3',E:[{T:4,cdata:'11000'}]},{T:1,N:'quarter4',E:[{T:4,cdata:'6000'}]}]},{T:1,N:'w2:row',E:[{T:1,N:'Month',E:[{T:4,cdata:'November'}]},{T:1,N:'quarter1',E:[{T:4,cdata:'27400'}]},{T:1,N:'quarter2',E:[{T:4,cdata:'9800'}]},{T:1,N:'quarter3',E:[{T:4,cdata:'11800'}]},{T:1,N:'quarter4',E:[{T:4,cdata:'17000'}]}]},{T:1,N:'w2:row',E:[{T:1,N:'Month',E:[{T:4,cdata:'December'}]},{T:1,N:'quarter1',E:[{T:4,cdata:'27400'}]},{T:1,N:'quarter2',E:[{T:4,cdata:'22900'}]},{T:1,N:'quarter3',E:[{T:4,cdata:'20800'}]},{T:1,N:'quarter4',E:[{T:4,cdata:'11000'}]}]}]}]}]},{T:1,N:'w2:workflowCollection'},{T:1,N:'xf:submission',A:{id:'sub_select',ref:'data:json,dc_reqUserInfo',target:'data:json,{"id":"bbbbb","key":"dc_userInfo"}',action:'/edu/data/userInfo.json',method:'post',mediatype:'application/json',encoding:'UTF-8',instance:'',replace:'',errorHandler:'',customHandler:'',mode:'asynchronous',processMsg:'조회중입니다... ','ev:submit':'scwin.sub_select_submit','ev:submitdone':'scwin.sub_select_submitdone','ev:submiterror':'scwin.sub_select_submiterror',abortTrigger:''}}]},{T:1,N:'w2:layoutInfo'},{T:1,N:'w2:publicInfo',A:{method:''}},{T:1,N:'script',A:{lazy:'false',type:'text/javascript'},E:[{T:4,cdata:function(scopeObj){with(scopeObj){scwin.onpageload = function () {};
scwin.sbx_chartType1_onchange = function (info) {
  ui_chart1.changeType(info.newValue);
};

//차트 옵션 적용
scwin.setChartOpt_line = function () {
  // 트렌드라인 속성
  let options = {};
  options.startValue = 19000; // [필수] 시작 값.
  options.displayValue = "19,000"; // 트렌드 라인에 좌측 또는 우측에 표시할 레이블.
  options.color = "#DC143C"; // 색.
  options.alpha = 60; // [0-100]투명도. 속성 'displayValue'도 함께 적용.
  options.showOnTop = 1; // [default:0, 1] 데이터 플롯 위로 표시할 지의 여부.
  options.thickness = 4; // 선 굵기로 px 단위로 적용. 속성 'isTrendZone'이 적용된 경우 무시.
  options.toolText = "부가 정보를 표시합니다."; // 트렌드 라인의 툴팁.

  // Fusionchart 'cht_exam1'의 트렌드라인을 추가합니다.
  ui_chart1.addTrendLine(options);

  // Fusionchart 'cht_exam1'를 브라우저에 그립니다.
  ui_chart1.draw();
};

/**
 * 버튼 [박스 형식 트렌드라인 추가하기] 클릭 시
 */
scwin.setChartOpt_box = function (e) {
  // 트렌드라인 속성
  let options = {};
  options.startValue = 20000; // [필수] 시작 값.
  options.endValue = 25000; // 종료 값.
  options.displayValue = "표준<br/>영역"; // 트렌드 라인에 좌측 또는 우측에 표시할 레이블.
  options.color = "#FFD700"; // 색.
  options.alpha = 40; // [0-100]투명도. 속성 'displayValue'도 함께 적용.
  options.showOnTop = 1; // [default:0, 1] 데이터 플롯 위로 표시할 지의 여부.
  options.valueOnRight = 1; // [default:0, 1] 속성 'displayValue'의 값을 우측에 표시할지의 여부.
  options.isTrendZone = 1; // [default:0, 1] 속성 'endValue'가 지정된 경우 트렌드 라인을 박스형태로 표시할지의 여부.

  // Fusionchart 'cht_exam2'의 트렌드라인을 추가합니다.
  ui_chart1.addTrendLine(options);

  // 속성 'displayValue'의 추가 속성
  let attOptions = {};
  attOptions.trendValueAlpha = 100; // [0-100] 속성 'displayValue'의 투명도.
  attOptions.trendValueFontSize = 13; // 속성 'displayValue'의 글자 크기.
  attOptions.trendValueFontBold = 1; // 속성 'displayValue'의 글자 굵게 적용 여부.

  // Fusionchart 'cht_exam2'의 속성을 설정합니다.
  ui_chart1.setChartAttribute(attOptions);

  // Fusionchart 'cht_exam2'를 브라우저에 그립니다.
  ui_chart1.draw();
};

/**
 * 버튼 [다중 트렌드라인 추가하기] 클릭 시
 */
scwin.setChartOpt_multi = function (e) {
  // 선 형식 트렌드라인 속성
  let trnOptions1 = {};
  trnOptions1.startValue = 25000; // [필수] 시작 값.
  trnOptions1.displayValue = "목표"; // 트렌드 라인에 좌측 또는 우측에 표시할 레이블.
  trnOptions1.color = "#DC143C"; // 색.
  trnOptions1.alpha = 60; // [1-100]투명도. 속성 'displayValue'도 함께 적용.
  trnOptions1.showOnTop = 0; // [default:0, 1] 데이터 플롯 위로 표시할 지의 여부.
  trnOptions1.thickness = 2; // 선 굵기로 px 단위로 적용. 속성 'isTrendZone'이 적용된 경우 무시.
  trnOptions1.valueOnRight = 1; // [default:0, 1] 속성 'displayValue'의 값을 우측에 표시할지의 여부.

  // Fusionchart 'cht_exam3'의 트렌드라인을 추가합니다.
  ui_chart1.addTrendLine(trnOptions1);

  // 박스 형식 트렌드라인 속성
  let trnOptions2 = {};
  trnOptions2.startValue = 15000; // [필수] 시작 값.
  trnOptions2.endValue = 20000; // 종료 값.
  trnOptions2.displayValue = "전월<br/>최대<br/>최소"; // 트렌드 라인에 좌측 또는 우측에 표시할 레이블.
  trnOptions2.color = "#1E90FF"; // 색.
  trnOptions2.alpha = 40; // [1-100]투명도. 속성 'displayValue'도 함께 적용.
  trnOptions2.showOnTop = 0; // [default:0, 1] 데이터 플롯 위로 표시할 지의 여부.
  trnOptions2.valueOnRight = 1; // [default:0, 1] 속성 'displayValue'의 값을 우측에 표시할지의 여부.
  trnOptions2.isTrendZone = 1; // [default:0, 1] 속성 'endValue'가 지정된 경우 트렌드 라인을 박스형태로 표시할지의 여부.

  // Fusionchart 'cht_exam3'의 트렌드라인을 추가합니다.
  ui_chart1.addTrendLine(trnOptions2);

  // 속성 'displayValue'의 추가 속성
  let attOptions = {};
  attOptions.trendValueAlpha = 100; // [0-100] 속성 'displayValue'의 투명도.

  // Fusionchart 'cht_exam3'의 속성을 설정합니다.
  ui_chart1.setChartAttribute(attOptions);

  // Fusionchart 'cht_exam3'를 브라우저에 그립니다.
  ui_chart1.draw();
};
scwin.btn_chart_onclick = function (e) {
  // scwin.setChartOpt_multi(); 
  ui_chart1.setChartColumnRef('data:dlt_chartData', 'Month', "[['quarter4']]");
};
scwin.setChartOpt_caption = function (e) {
  var options = {
    caption: "전세계 판매량 요약",
    subCaption: "2024년",
    yAxisName: " 금액 ",
    xAxisName: " 월 ",
    numberPrefix: "$"
  };
  ui_chart1.setChartAttribute(options);

  // 스타일옵션입니다.
  var styleOptions = {
    color: "2a5900",
    size: "20",
    bold: "1",
    underline: "1"
  };
  ui_chart1.applyStyle("font", "captionFont", styleOptions, ["Caption"]);
  ui_chart1.draw();
};
scwin.ui_tit_onclick = function (e) {
  scwin.setChartOpt_caption();
};
scwin.sbx_chartType2_onchange = function (info) {
  ui_chart2.changeType(info.newValue);
};
}}}]}]},{T:1,N:'body',A:{'ev:onpageload':'scwin.onpageload'},E:[{T:1,N:'xf:group',A:{class:'sub_contents',id:'',style:''},E:[{T:1,N:'xf:group',A:{class:'pgtbox',id:'',style:''},E:[{T:1,N:'xf:trigger',A:{class:'btn_fav',id:'',style:'',type:'button'},E:[{T:1,N:'xf:label'}]},{T:1,N:'w2:textbox',A:{class:'pgt_tit',id:'',label:'[완성화면] FusionChart 컴포넌트',style:'',tagname:''}}]},{T:1,N:'xf:group',A:{class:'ws_example_grp_desc',id:'',style:''},E:[{T:1,N:'xf:group',A:{class:'titbox',id:'',style:''},E:[{T:1,N:'w2:textbox',A:{class:'ws_example_txt_desc_info',id:'',label:'해당화면은 코딩이 완료된 화면',style:'',tagname:'h3'}}]},{T:1,N:'xf:group',A:{class:'',id:'',style:'',tagname:'details'},E:[{T:1,N:'w2:textbox',A:{escape:'false',id:'',label:'실습 목표',style:'',tagname:'summary'}},{T:1,N:'w2:textbox',A:{class:'',escape:'false',id:'',label:'1. 개요<br/>본 화면은 FusionChart컴포넌트를 활용하는 실습 화면입니다. <br/>FusionChart 컴포넌트 : InfoSoft Global사의 제품으로 FusionChartXT가 OEM 라이선스로 제공 되고 있습니다. <br/> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;(별도 구매없이 WebSquare 엔진에 포함)',style:''}}]},{T:1,N:'xf:group',A:{class:'',id:'',style:'',tagname:'details'},E:[{T:1,N:'w2:textbox',A:{escape:'false',id:'',label:'실습 방법',style:'',tagname:'summary'}},{T:1,N:'w2:textbox',A:{class:'',escape:'false',id:'',label:'1. Design Kit 를 활용하여 FusionChart를 추가합니다. <br/>2. FusionChart에 값 표현하기 <br/> &nbsp; <b>[속성 활용]</b>Component View 에서 속성 Tab 에 아래와 같은 속성을 넣습니다.<br/> &nbsp; 1) <b>id</b> : &nbsp;Chart의 고유한 이름을 넣는다. ex) [ ui_chart1 ]<br/> &nbsp; 2) <b>lable</b> : &nbsp;FusionChart의 lable 데이터로 사용할 DataCollection의 &nbsp;column의 ID값. <br/> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;공백 일 경우 DataCollection의 첫 번째 column이 자동 셋팅 됩니다. ex) [[\'quarter2\']]<br/> &nbsp; 3) <b> ref </b> : &nbsp;FusionChart와 DataCollection 데이터 연동 시 사용. <br/> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; DataCollection을 설정합니다. &nbsp;ex) data:dlt_chartData<br/>3. &nbsp;Chart Type 변경하기 <br/> &nbsp; &nbsp;<b>[Event 활용]</b> <br/> &nbsp; &nbsp; 1) onchange 이벤트 : 선택항목 변경 시 발생 이벤트<br/> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;oldValue, newValue를 포함한 JSON을 반환한다. <br/> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;info.oldValue : 이전 값<br/> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;info.newValue : 변경된 값<br/> &nbsp; &nbsp;2) ui_chart1.changeType(“line”); <br/><br/>4. &nbsp;FusionChart의 &nbsp;Customizing <br/> &nbsp; <b>[API 활용]</b>스크립트 작성 부분에 아래 API를 활용할 수 있습니다. <br/> &nbsp; 1) addTrendLine : addTrendLine(): chart에 trendLine(가로줄)을 그립니다.<br/> &nbsp; &nbsp; &nbsp; ex1) <b>scwin.setChartOpt_line(); </b> : 선 형식 트렌드라인<br/> &nbsp; &nbsp; &nbsp; ex2) <b>scwin.setChartOpt_box(); </b> : &nbsp;박스 형식 트렌드라인<br/> &nbsp; &nbsp; &nbsp; ex3) <b>scwin.setChartOpt_multi(); </b> : 다중 형식 트렌드라인<br/> &nbsp; 2) setChartAttribute : chart element에 들어가는 Attribute를 설정합니다.<br/> &nbsp; 3) applyStyle : chart에 Style을 지정합니다.',style:''}}]}]},{T:1,N:'xf:group',A:{class:'titbox',id:'',style:''},E:[{T:1,N:'w2:textbox',A:{class:'',escape:'false',id:'',label:'Chart Data &nbsp;',style:'',tagname:'h4'}}]},{T:1,N:'w2:gridView',A:{checkAllType:'false',defaultCellHeight:'20',id:'',style:'height: 150px;',dataList:'data:dlt_chartData',autoFit:'allColumn',autoFitMinWidth:'1000'},E:[{T:1,N:'w2:caption',A:{style:'',id:'caption2',value:'this is a grid caption.'}},{T:1,N:'w2:header',A:{style:'',id:'header2'},E:[{T:1,N:'w2:row',A:{style:'',id:'row3'},E:[{T:1,N:'w2:column',A:{width:'70',inputType:'text',style:'',id:'column7',value:'Month',displayMode:'label'}},{T:1,N:'w2:column',A:{width:'70',inputType:'text',style:'',id:'column6',value:'quarter1',displayMode:'label'}},{T:1,N:'w2:column',A:{width:'70',inputTy