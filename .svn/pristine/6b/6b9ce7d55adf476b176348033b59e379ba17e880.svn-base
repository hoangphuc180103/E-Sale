<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
         <script type="text/javascript" lazy="false"><![CDATA[


scwin.onpageload = function () {
	var i;
	for (i = 0; i < 3; i++) {
		var num = JSON.stringify(i);
		var title = "Title_" + num;
		var windowId = num;
		var windowName = "Name_" + num;
		windowContainer1.createWindow(title, "", "", windowName, windowId, "newWindow");
		windowContainer1.setArrangeWindows("cascade");
	}
};

scwin.onpageunload = function () {

};

scwin.windowContainer1_ondragstart = function (windowId) {
	alert("ondragstart : " + windowId);
};

scwin.windowContainer1_ondragend = function (windowId) {
	alert("ondragend : " + windowId);
};

]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload" ev:onpageunload="scwin.onpageunload">
    <xf:group id="" style="margin: 10px;">
    	<w2:textbox tagname="h1" style="color: blue;margin-bottom: 10px;" tabIndex="h1" id="textbox1"
    		label="Event - ondragstart &amp; ondragend&lt;br/&gt;" escape="false">
    	</w2:textbox>
    	<w2:textbox tagname="h2" style="height: 23px;margin-bottom: 10px;color: blue;" id="textbox2" label="How to Use"></w2:textbox>
    	<w2:textbox style="color: blue;margin-bottom: 30px;" id="textbox3"
    		label='1. Select any window and drag it.&lt;br/&gt;2. Confirm that the ondragstart event is triggered.&lt;br/&gt;3. Stop dragging the window.&lt;br/&gt;4. Confirm that the ondragend event is triggered.&lt;br/&gt;(Detailed scripts for each event handler can be found in the Script tab.)'
    		escape="false">
    	</w2:textbox>
    	<w2:textbox
    		style="padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightgreen;border:none;margin-bottom: 10px;"
    		id="textbox4" label='Event Description&lt;br/&gt;&lt;br/&gt;ondragstart - Fired when window dragging begins.&lt;br/&gt;ondragend - Fired when window dragging ends.' escape="false">
    	</w2:textbox>
    	<w2:textbox tagname="" style="padding:10px; padding-bottom:20px; text-align:left; font-size:15px; font-weight:bolder; border:brown 1px solid; background-color:ivory; margin-bottom:10px; color:brown;" id="textbox5" label='/// Sample Code &lt;br/&gt;&lt;br/&gt;scwin.windowContainer1_ondragstart = function(windowId) {&lt;br/&gt; &amp;nbsp; &amp;nbsp;alert("ondragstart : " + windowId);&lt;br/&gt;};&lt;br/&gt;&lt;br/&gt;scwin.windowContainer1_ondragend = function(windowId) {&lt;br/&gt; &amp;nbsp; &amp;nbsp;alert("ondragend : " + windowId);&lt;br/&gt;};' escape="false">
    	</w2:textbox>
    	<w2:windowContainer sequentialArrangeColNum="" sequentialArrangeRowNum="" fixArrangeFullScreen="false" useFixButton="false"
    		windowAutoResize="false" useWindowScrollButton="" ev:ondragstart="scwin.windowContainer1_ondragstart"
    		ev:ondragend="scwin.windowContainer1_ondragend" verticalArrangeNum="" windowMaxNum="20" useCloseButton="false"
    		controlIconPosition="allright" stopMinimizeOnNameLayer="false" toolbarPosition="top" windowMaximizeAll="true" id="windowContainer1"
    		useStatusMsg="true" hideTitleOnMaximize="false" spaInitCount="0" windowScrollVisibleRowNum="" stopToggleOnLast="false"
    		useNameContainer="true" horizontalArrangeNum="" useCustomMsg="false" useControlIconTitle="" tooltipDisplay="true"
    		tooltipGroupClass="false" windowTooltipDisplay="true"
    		style="position: relative;height: 400px;border: gray solid 1px;margin-bottom: 10px;">
    		<w2:windowToolbar>
    			<w2:controlIconLayer>
    				<w2:controlIcon></w2:controlIcon>
    				<w2:controlIcon></w2:controlIcon>
    				<w2:controlIcon></w2:controlIcon>
    				<w2:controlIcon></w2:controlIcon>
    				<w2:controlIcon></w2:controlIcon>
    			</w2:controlIconLayer>
    			<w2:nameLayer></w2:nameLayer>
    			<w2:selectedNameLayer></w2:selectedNameLayer>
    		</w2:windowToolbar>
    	</w2:windowContainer>
    </xf:group></body>
</html>
