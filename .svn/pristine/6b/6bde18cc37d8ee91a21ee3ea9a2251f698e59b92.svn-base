            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
         <script type="text/javascript" lazy="false"><![CDATA[
        
	scwin.onpageload = function() {
        
	};
	
	scwin.onpageunload = function() {
		
	};
	
	]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload" ev:onpageunload="scwin.onpageunload">
    <xf:group id="" style="margin: 10px;"><w2:textbox tagname="h1" style="color: blue;margin-bottom: 10px;" id="textbox1" label="特定のキーの動作を防止" escape="false"></w2:textbox><w2:textbox tagname="h2" style="height: 23px;margin-bottom: 10px;color: blue;" id="textbox2" label="サンプルの使い方"></w2:textbox><w2:textbox style="color: blue;margin-bottom: 30px;" id="textbox3" label='1. AutoComplete の選択リストを開く。 &lt;br/&gt;2. preventKeyListプロパティの設定に応じて、Up方向キーとEnterキーが機能しないことを確認してください。' escape="false">
    	</w2:textbox><w2:textbox style="padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightblue;border:none;margin-bottom: 10px;" id="textbox4" label='プロパティの設定&lt;br/&gt;preventKeyList="38, 13"' escape="false">
    	</w2:textbox><w2:autoComplete preventKeyList="38, 13" submenuSize="auto" search="contain" ref="" caseSensitive="true" chooseOption="" editType="select" useKeywordHighlight="true" style="display: block;width: 50%" id="autoComplete1" allOption="" useLocale="false">
    		<w2:choices>
    			<w2:item>
    				<w2:label><![CDATA[Seoul]]></w2:label>
    				<w2:value><![CDATA[01]]></w2:value>
    			</w2:item>
    			<w2:item>
    				<w2:label><![CDATA[Osong]]></w2:label>
    				<w2:value><![CDATA[02]]></w2:value>
    			</w2:item>
    			<w2:item>
    				<w2:label><![CDATA[Daejeon]]></w2:label>
    				<w2:value><![CDATA[03]]></w2:value>
    			</w2:item>
    			<w2:item>
    				<w2:label><![CDATA[Kimcheon]]></w2:label>
    				<w2:value><![CDATA[04]]></w2:value>
    			</w2:item>
    			<w2:item>
    				<w2:label><![CDATA[Incheon]]></w2:label>
    				<w2:value><![CDATA[05]]></w2:value>
    			</w2:item>
    			<w2:item>
    				<w2:label><![CDATA[Hadong]]></w2:label>
    				<w2:value><![CDATA[06]]></w2:value>
    			</w2:item>
    			<w2:item>
