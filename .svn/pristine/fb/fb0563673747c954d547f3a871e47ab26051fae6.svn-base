		<xf:model>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" repeatNode="map" id="dlt_exam" saveRemovedData="true">
					<w2:columnInfo>
						<w2:column dataType="text" name="A" id="col_a"></w2:column>
						<w2:column dataType="text" name="B" id="col_b"></w2:column>
