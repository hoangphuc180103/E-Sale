		<w2:layoutInfo />
		<w2:publicInfo method="" />
		<script lazy="false" type="text/javascript"><![CDATA[
scwin.onpageload = function () {
    // 예제 테스트를 위한 초기화
    scwin.initializeExample();
};

// 예제 테스트를 위한 초기화
scwin.initializeExample = function () {
    //GridView의 초기 개인화 스타일 저장하기
    $p.local.setItem("P00198_init_grid", grd_main.getCurrentGridStyle());

    // 기존에 저장된 GridView의 스타일을 저장.
    let gridStyle = $p.local.getItem("P00198_grd_style");

    if (gridStyle) {

        grd_main.setGridStyle(gridStyle);

        //로그 출력
        $c.frame.printExampleLog("저장된 GridView의 개인화 스타일이 적용되었습니다.", txa_log, false);
    } else {
        //로그 출력
        $c.frame.printExampleLog("저장된 GridView의 개인화 스타일이 없습니다.", txa_log, false);
    }
};

/**
 * 버튼 [저장] 클릭 시
 * Trigger 'btn_save' 의 onclick 이벤트 핸들러
 */
scwin.btn_save_onclick = function (e) {
    // 현재 gridView 스타일 정보 가져오기
    var grd_style = grd_main.getCurrentGridStyle();

    // localStorage에 gridView의 style 저장
    $p.local.setItem("P00198_grd_style", grd_style);

    //로그 출력
    var strLog = "GridView 개인화 스타일 저장 완료";
    $c.frame.printExampleLog(strLog, txa_log, false);
};

/**
 * 버튼 [불러오기] 클릭 시
 * Trigger 'btn_load' 의 onclick 이벤트 핸들러
 */
scwin.btn_load_onclick = function (e) {
    // localStorage에 저장한 gridView 스타일 정보 가져오기
    var grd_style = $p.local.getItem("P00198_grd_style");

    var strLog;
    if (!grd_style) {
        strLog = "저장된 GridView의 개인화 스타일이 없습니다.";
    } else {
        // 현재 gridView의 개인화 스타일 적용
        grd_main.setGridStyle(grd_style);
        strLog = "GridView에 저장된 개인화 스타일이 적용되었습니다.";
    }

    //로그 출력
    $c.frame.printExampleLog(strLog, txa_log, false);
};

/**
 * 버튼 [삭제] 클릭 시
 * Trigger 'btn_clear' 의 onclick 이벤트 핸들러
 */
scwin.btn_clear_onclick = function (e) {
    // 저장된 스타일 정보 제거
    $p.local.removeItem("P00198_grd_style");

    // 화면 파일의 GridView 개인화 스타일을 적용합니다.
    grd_main.setGridStyle($p.local.getItem("P00198_init_grid"));

    //로그 출력
    var strLog = "저장된 GridView의 개인화 스타일이 삭제되었습니다.\nGridView의 개인화 스타일이 초기화되었습니다.";
    $c.frame.printExampleLog(strLog, txa_log, false);
};

/**
 * 버튼 [초기화] 클릭 시
 * Trigger 'btn_init' 의 onclick 이벤트 핸들러
 */
scwin.btn_init_onclick = function (e) {

    // 화면 파일의 GridView 개인화 스타일을 적용합니다.
    grd_main.setGridStyle($p.local.getItem("P00198_init_grid"));

    //로그 출력
    var strLog = "GridView의 개인화 스타일이 초기화되었습니다.(저장된 개인화 스타일은 삭제되지 않습니다.)";
    $c.frame.printExampleLog(strLog, txa_log, false);
};

/**
 * textarea의 로그 삭제
 */
scwin.btn_clearLog_onclick = function (e) {
    let strTargetId = this.getUserData("userData1");
    let cmpTarget;
    if (strTargetId) {
        cmpTarget = $p.getComponentById(strTargetId) || txa_log;
    } else {
        cmpTarget = txa_log;
    }
    //textarea value를 빈문자열로 할당.
    cmpTarget.setValue("");
};]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:group class="sub_contents" id="" style="">
			<xf:group class="ws_example_grp_desc" id="" style="">
				<w2:textbox escape="false" id="" label="GridView의 스타일을 개인화하는 예제입니다." style="margin-bottom: 10px;">
				</w2:textbox>
			</xf:group>
			<xf:group class="example_div_tb_style_wrap mb_def" id="" style="">
				<xf:group class="example_div_tr_style" id="" style="">
					<xf:group class="example_div_td_style" id="" style="">
						<xf:group class="ofh nobottom" id="" style="max-width: 700px;">
							<xf:group class="fl mb_def_box nobottom" id="" style="">
								<xf:trigger class="btn_exam_exec btn_txt_of" ev:onclick="scwin.btn_init_onclick" id="btn_init" style=""
									tooltip="개인화 스타일을 초기화합니다. 저장된 개인화 스타일은 삭제하지 않습니다." type="button">
									<xf:label><![CDATA[GridView 초기화]]></xf:label>
								</xf:trigger>
							</xf:group>
							<xf:group class="fr mb_def_box nobottom" id="" style="">
								<xf:trigger class="btn_exam_exec btn_txt_of" id="btn_save" style="margin-right:6px;" type="button"
									tooltip="GridView의 개인화 스타일을 저장합니다." ev:onclick="scwin.btn_save_onclick">
									<xf:label><![CDATA[저장]]></xf:label>
								</xf:trigger>
								<xf:trigger class="btn_exam_exec btn_txt_of" id="btn_load" style="" tooltip="저장된 GridView 개인화 스타일을 적용합니다." type="button"
									ev:onclick="scwin.btn_load_onclick">
									<xf:label><![CDATA[불러오기]]></xf:label>
								</xf:trigger>
								<xf:trigger class="btn_exam_exec btn_txt_of" id="btn_clear" style=""
									tooltip="GridView 개인화 스타일을 삭제하고 GridView의 스타일을 초기화합니다." type="button" ev:onclick="scwin.btn_clear_onclick">
									<xf:label><![CDATA[삭제]]></xf:label>
								</xf:trigger>
							</xf:group>
						</xf:group>
						<xf:group class="gvwbox" id="" style="">
							<w2:gridView autoFit="none" autoFitMinWidth="660" class="gvw" dataList="data:dlt_exam" defaultCellHeight="37"
								id="grd_main" style="height: 100px;" visibleRowNum="5" contextMenu="true" columnMove="true" useFilterList="false"
								useHeaderContextMenu="true">
								<w2:caption style="" id="caption1" value="this is a grid caption."></w2:caption>
								<w2:header style="" id="header1">
									<w2:row style="" id="row1">
										<w2:column width="70" inputType="text" style="" id="column10" value="A" displayMode="label"></w2:column>
										<w2:column width="70" inputType="text" style="" id="column9" value="B" displayMode="label"></w2:column>
										<w2:column width="70" inputType="text" style="" id="column8" value="C" displayMode="label"></w2:column>
										<w2:column width="70" inputType="text" style="" id="column7" value="D" displayMode="label"></w2:column>
										<w2:column width="70" inputType="text" style="" id="column6" value="E" displayMode="label"></w2:column>
										<w2:column width="70" inputType="text" style="" id="column5" value="F" displayMode="label"></w2:column>
										<w2:column width="70" inputType="text" style="" id="column4" value="G" displayMode="label"></w2:column>
										<w2:column width="70" inputType="text" style="" id="column3" value="H" displayMode="label"></w2:column>
										<w2:column width="70" inputType="text" style="" id="column2" value="I" displayMode="label"></w2:column>
										<w2:column width="70" inputType="text" style="" id="column1" value="J" displayMode="label"></w2:column>
									</w2:row>
								</w2:header>
								<w2:gBody style="" id="gBody1">
									<w2:row style="" id="row2">
										<w2:column width="70" inputType="text" style="" id="col_a" value="" displayMode="label"></w2:column>
										<w2:column width="70" inputType="text" style="" id="col_b" value="" displayMode="label"></w2:column>
										<w2:column width="70" inputType="text" style="" id="col_c" value="" displayMode="label"></w2:column>
										<w2:column width="70" inputType="text" style="" id="col_d" value="" displayMode="label"></w2:column>
										<w2:column width="70" inputType="text" style="" id="col_e" value="" displayMode="label"></w2:column>
										<w2:column width="70" inputType="text" style="" id="col_f" value="" displayMode="label"></w2:column>
										<w2:column width="70" inputType="text" style="" id="col_g" value="" displayMode="label"></w2:column>
										<w2:column width="70" inputType="text" style="" id="col_h" value="" displayMode="label"></w2:column>
										<w2:column width="70" inputType="text" style="" id="col_i" value="" displayMode="label"></w2:column>
										<w2:column width="70" inputType="text" style="" id="col_j" value="" displayMode="label"></w2:column>
									</w2:row>
								</w2:gBody>
							</w2:gridView>
						</xf:group>

					</xf:group>
				</xf:group>
				<xf:group class="example_div_tb_style_wrap" id="" style="">
					<xf:group class="example_div_tr_style" id="" style="">
						<xf:group class="example_div_th_style" id="">
							<w2:span class="mr_def txt_blue" id="" label="로그 확인" style=""></w2:span>
							<xf:trigger class="wre_btn_log_clear" ev:onclick="scwin.btn_clearLog_onclick" id="btn_clearLog" style="" title="로그 삭제"
								type="button">
								<xf:label><![CDATA[로그 삭제]]></xf:label>
							</xf:trigger>
						</xf:group>
						<xf:group class="example_div_td_style" id="" style="">
							<xf:textarea class="wre_txa_log" id="txa_log" spellcheck="false" style="width: 100%;height: 140px;"></xf:textarea>
						</xf:group>
					</xf:group>
				</xf:group>
			</xf:group>
		</xf:group>
	</body>
</html>