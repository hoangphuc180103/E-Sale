				</xf:group>
				<xf:group class="example_div_tr_style" id="" style="">
					<w2:textbox class="example_div_th_style" escape="false" id="" label="(기본 설정) 'dataDragSelectAutoScroll' 속성 미사용" style=""></w2:textbox>
					<xf:group class="example_div_td_style" id="" style="">
						<xf:group id="" class="gvwbox">
							<w2:gridView dataDragSelectAutoScroll="false" rowNumVisible="true" useShiftKey="true" readOnly="true"
								defaultCellHeight="37" tooltipDisplay="true" rowMouseOver="false" rowNumWidth="40" visibleRowNumFix="true" dataList="data:dlt_exam"
								dataDragSelect="true" style="height:100px;" autoFit="none" id="" visibleRowNum="4" class="gvw" noSelect="true">
								<w2:caption style="" id="caption1" value="this is a grid caption."></w2:caption>
