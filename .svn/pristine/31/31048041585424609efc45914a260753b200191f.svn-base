	<body ev:onpageload="scwin.onpageload">
		<xf:group class="sub_contents" id="" style="">
			<xf:group class="ws_example_grp_desc" id="" style="">
				<w2:textbox escape="false" id=""
					label="GridView의 'dataDragSelectAutoScroll' 속성을 사용하여, 마우스로 드래그하여 다중 셀을 선택할 때 마우스가 GridView 밖으로 이동하면 마우스의 방향에 따라 셀 선택이 연장되도록 설정한 예제입니다."
					style="">
				</w2:textbox>
				<w2:textbox class="ws_example_txt_desc_info" escape="false" id="" label="이 예제는 마우스 사용이 가능한 환경에서 정상 동작합니다." style="">
				</w2:textbox>
			</xf:group>
			<xf:group class="example_div_tb_style_wrap" id="">
				<xf:group class="example_div_tr_style" id="" style="">
					<w2:textbox class="example_div_th_style" escape="false" id="" label="'dataDragSelectAutoScroll' 속성 사용" style=""></w2:textbox>
					<xf:group class="example_div_td_style" id="" style="">
						<xf:group id="" class="gvwbox">
							<w2:gridView dataDragSelectAutoScroll="true" rowNumVisible="true" useShiftKey="true" readOnly="true"
								defaultCellHeight="37" dataDragSelectAutoScrollPeriod="50" tooltipDisplay="true" rowMouseOver="false" rowNumWidth="40"
								visibleRowNumFix="true" dataList="data:dlt_exam" dataDragSelect="true" style="height:100px;" id="" visibleRowNum="4" autoFit="none"
								dataDragSelectAutoScrollLevel="1000" class="gvw" noSelect="true">
								<w2:caption style="" id="caption1" value="this is a grid caption."></w2:caption>
								<w2:header style="" id="header1">
									<w2:row style="" id="row1">
										<w2:column width="80" inputType="text" style="" id="column7" value="A" displayMode="label"></w2:column>
										<w2:column width="80" inputType="text" style="" id="column6" value="B" displayMode="label"></w2:column>
										<w2:column width="80" inputType="text" style="" id="column5" value="C" displayMode="label"></w2:column>
										<w2:column width="80" inputType="text" style="" id="column4" value="D" displayMode="label"></w2:column>
										<w2:column width="80" inputType="text" style="" id="column3" value="E" displayMode="label"></w2:column>
										<w2:column width="80" inputType="text" style="" id="column2" value="F" displayMode="label"></w2:column>
										<w2:column width="80" inputType="text" style="" id="column1" value="G" displayMode="label"></w2:column>
									</w2:row>
								</w2:header>
								<w2:gBody style="" id="gBody1">
									<w2:row style="" id="row2">
										<w2:column width="80" inputType="text" style="" id="col_a" value="" displayMode="label"></w2:column>
										<w2:column width="80" inputType="text" style="" id="col_b" value="" displayMode="label"></w2:column>
										<w2:column width="80" inputType="text" style="" id="col_c" value="" displayMode="label"></w2:column>
										<w2:column width="80" inputType="text" style="" id="col_d" value="" displayMode="label"></w2:column>
										<w2:column width="80" inputType="text" style="" id="col_e" value="" displayMode="label"></w2:column>
										<w2:column width="80" inputType="text" style="" id="col_f" value="" displayMode="label"></w2:column>
										<w2:column width="80" inputType="text" style="" id="col_g" value="" displayMode="label"></w2:column>
									</w2:row>
								</w2:gBody>
							</w2:gridView>
						</xf:group>
