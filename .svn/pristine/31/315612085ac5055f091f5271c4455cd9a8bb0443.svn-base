				<xf:group style="" id="" class="example_div_tr_style">
					<w2:textbox style="" id="" label="SelectBox" class="example_div_th_style"></w2:textbox>
					<xf:group style="" id="" class="example_div_td_style">
						<xf:select1 submenuSize="auto" appearance="minimal" disabledClass="w2selectbox_disabled" chooseOption=""
							style="width: 150px; min-height: 22px;" disabled="false" id="" allOption="" direction="auto" useLocale="true"
							tooltipLocaleRef="c_label_4_1" tooltip="tooltip example">
							<xf:choices>
								<xf:item>
									<xf:label><![CDATA[ITEM01]]></xf:label>
									<xf:value><![CDATA[01]]></xf:value>
								</xf:item>
