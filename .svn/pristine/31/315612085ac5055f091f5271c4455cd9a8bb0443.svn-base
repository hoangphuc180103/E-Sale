					<w2:textbox class="example_div_th_style" id="" label="Checkbox" style=""></w2:textbox>
					<xf:group class="example_div_td_style" id="" style="">
						<xf:select selectedindex="-1" id="" appearance="full" style="min-width: 20px; min-height: 22px;" cols="" rows="" ref=""
							renderType="checkboxgroup" useLocale="true" tooltipLocaleRef="c_label_4_1" tooltip="tooltip example">
							<xf:choices>
								<xf:item>
									<xf:label><![CDATA[ITEM01]]></xf:label>
									<xf:value><![CDATA[01]]></xf:value>
								</xf:item>
								<xf:item>
