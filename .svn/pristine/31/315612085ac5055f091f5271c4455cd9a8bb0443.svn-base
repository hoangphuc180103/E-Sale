					<xf:group style="" id="" class="example_div_td_style">
						<w2:autoComplete search="start" submenuSize="auto" editType="select" useKeywordHighlight="false"
							style="width: 150px; min-height: 22px;" id="" useLocale="true" tooltipLocaleRef="c_label_4_1" tooltip="tooltip example">
							<w2:choices>
								<w2:item>
									<w2:label><![CDATA[ITEM01]]></w2:label>
									<w2:value><![CDATA[01]]></w2:value>
								</w2:item>
								<w2:item>
									<w2:label><![CDATA[ITEM02]]></w2:label>
									<w2:value><![CDATA[02]]></w2:value>
								</w2:item>
								<w2:item>
									<w2:label><![CDATA[ITEM03]]></w2:label>
									<w2:value><![CDATA[03]]></w2:value>
								</w2:item>
							</w2:choices>
						</w2:autoComplete>
