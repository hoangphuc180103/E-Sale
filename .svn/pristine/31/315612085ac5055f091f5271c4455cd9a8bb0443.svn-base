				</w2:textbox>
			</xf:group>
			<xf:group id="" class="example_div_tb_style_wrap">
				<xf:group class="example_div_tr_style" id="" style="">
					<w2:textbox class="example_div_th_style" id="" label="Anchor" style=""></w2:textbox>
					<xf:group class="example_div_td_style" id="" style="">
						<w2:anchor outerDiv="false" id="" style="" tooltipLocaleRef="c_label_4_1" useLocale="true" tooltip="tooltip example">
							<xf:label><![CDATA[Anchor]]></xf:label>
						</w2:anchor>
					</xf:group>
				</xf:group>
				<xf:group style="" id="" class="example_div_tr_style">
