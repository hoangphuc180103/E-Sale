		<script lazy="false" type="text/javascript"><![CDATA[
scwin.onpageload = function () {

};

/**
 * 버튼 [팝업 열기] 클릭시
 */
scwin.btn_ex1_onclick = function (e) {
    var jsnOptions;
    var strPopID = "popup_P00157P01";

    //중복 팝업 제어
    if ($p.getPopupWindow(strPopID)) {
        return;
    }

    jsnOptions = {
        id: strPopID,
        type: "wframePopup",
        modal: "modal",
        frameModal: "",
        width: "220px",
        height: "180px",
        popupName: "popup1",
        left: "10px",
        top: "10px"
    };

    //팝업 열기
    $p.openPopup("/page/P00157P01.xml", jsnOptions);
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:group class="mb_def_box" id="" style="">
			<w2:textbox id="" label="P00157S01.xml" style="color: dodgerblue;font-size: 1.2em;font-weight: bold;"></w2:textbox>
			<xf:group id="" style="">
				<xf:trigger class="btn_exam_exec" id="btn_ex1" localeRef="" style="min-width: 30px;" type=""
					useDefaultLabel="true" ev:onclick="scwin.btn_ex1_onclick">
