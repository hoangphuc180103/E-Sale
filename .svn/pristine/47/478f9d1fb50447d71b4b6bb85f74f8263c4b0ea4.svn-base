		<w2:layoutInfo />
		<w2:publicInfo method="" />
		<script lazy="false" type="text/javascript"><![CDATA[
scwin.onpageload = function () {
    scwin.setPivotOpt();
};

scwin.setPivotOpt = function () {
    var tmpArr,
        tmpArrLen,
        i;

    tmpArr = dlt_data.getColumnDistinctDataArray("name");

    tmpArr.sort();
    tmpArrLen = tmpArr.length;
    for (i = 0; i < tmpArrLen; i++) {
        if (tmpArr[i] === "CITY 1") {
            tmpArr.splice(i, 1);
            break;
        }
    }
    piv_ex01.setFieldOption([{ "id": "name", "sortOrder": "CITY 1," + tmpArr.join(",") }]);
};]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:group class="sub_contents" id="" style="">
			<xf:group class="ws_example_grp_desc" id="" style="">
				<w2:textbox escape="false" id="" label="Pivot 구현 예시입니다. Pivot 컴포넌트는 Pivot기능을 토대로 구현되었으며, 행과 열을 변경하여 데이터를 표현할 때 사용합니다."
					style="">
				</w2:textbox>
				<w2:textbox class="ws_example_txt_desc_info" escape="false" id="" label="이 예제는 시연용 예제로 예제 가이드 문서가 포함되어 있지 않습니다." style="">
				</w2:textbox>
			</xf:group>
			<xf:group id="" class="gvwbox">
				<w2:gridView showSortableUseFilter="false" scrollByColumnAdaptive="false" rowNumVisible="true" summaryAuto="false"
					useShiftKey="true" rowNumHeaderValue="NO" scrollByColumn="false" sortable="true" summaryOnlyAuto="false" defaultCellHeight="37"
					applyAllColumnStyle="false" dataList="data:dlt_data" ignoreCellClick="false" style="height: 124px;" autoFit="allColumn" id=""
					useFilterList="false" visibleRowNum="4" ignoreToggleOnDisabled="false" class="gvw" autoFitMinWidth="500">
					<w2:caption style="" id="caption2" value="this is a grid caption."></w2:caption>
					<w2:header style="" id="header2">
						<w2:row style="" id="row3">
							<w2:column width="50" inputType="text" style="" id="column13" value="년도" blockSelect="false" displayMode="label"></w2:column>
							<w2:column width="70" inputType="text" style="" id="column9" value="도시명" blockSelect="false" displayMode="label"></w2:column>
							<w2:column width="70" inputType="text" style="" id="column7" value="구분" blockSelect="false" displayMode="label">
							</w2:column>
							<w2:column width="50" inputType="text" style="" id="column5" value="유형" blockSelect="false" displayMode="label"></w2:column>
							<w2:column width="70" inputType="text" style="" id="column3" value="인원수" blockSelect="false" displayMode="label"></w2:column>
						</w2:row>
					</w2:header>
					<w2:gBody style="" id="gBody2">
						<w2:row style="" id="row4">
							<w2:column colMerge="" width="50" inputType="text" style="" id="year" value="" blockSelect="false" displayMode="label">
							</w2:column>
							<w2:column colMerge="" width="70" inputType="text" style="" id="name" value="" blockSelect="false" displayMode="label">
							</w2:column>
							<w2:column colMerge="" width="70" inputType="text" style="" id="type" value="" blockSelect="false" displayMode="label">
							</w2:column>
							<w2:column colMerge="" width="50" inputType="text" style="" id="kind" value="" blockSelect="false" displayMode="label">
							</w2:column>
							<w2:column textAlign="right" dataType="number" width="70" displayFormat="#,##0" inputType="text" style="" id="value"
								value="" blockSelect="false" displayMode="label">
							</w2:column>
						</w2:row>
					</w2:gBody>
				</w2:gridView>
			</xf:group>
			<xf:group class="ws_example_pivotBox" id="" style="">
				<xf:group class="titbox tar" id="" style="">
					<w2:span class="pivot pivot_lbl " id="" label="구분 :" style="color: inherit;"></w2:span>
					<w2:span class="pivot_lbl_hidden mr_def pivot_lbl " id="" label="미지정 항목" style=""></w2:span>
					<w2:span class="pivot_lbl_value mr_def pivot_lbl " id="" label="표현 값(Value)" style=""></w2:span>
					<w2:span class="pivot_lbl_col mr_def pivot_lbl " id="" label="열(Column)" style=""></w2:span>
					<w2:span class="pivot_lbl_row mr_def pivot_lbl " id="" label="행(Row)" style=""></w2:span>
				</xf:group>
				<w2:pivot autoFit="allColumn" autoFitMinWidth="600" cols="year,type" dataList="data:dlt_data" excludeHiddenList="code"
					grandTotalName="구분" hiddenHeaderList="" rows="name" showZero="true" sortFunction="" style="position: relative;height: 420px;"
					vals="value" valuesAxis="row" id="piv_ex01">
					<w2:fieldInfo>
						<w2:field id="year" name="년도"></w2:field>
						<w2:field id="code" name="코드"></w2:field>
						<w2:field id="name" name="도시명"></w2:field>
						<w2:field id="type" name="구분"></w2:field>
						<w2:field id="kind" name="유형"></w2:field>
						<w2:field id="value" name="인원수"></w2:field>
					</w2:fieldInfo>
				</w2:pivot>
			</xf:group>
		</xf:group>
	</body>
</html>