<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
         <script type="text/javascript" lazy="false"><![CDATA[
        
	scwin.onpageload = function() {		
        var i;
        for (i=0; i<9; i++) {
	    var num = JSON.stringify(i+1);   
	    var title = "_win_" + num + "_"; 
        windowContainer1.createWindow( title, null, null);
        windowContainer2.createWindow( title, null, null);
        windowContainer3.createWindow( title, null, null);
    }
        windowContainer1.setArrangeWindows("sequential");
        windowContainer2.setArrangeWindows("sequential");
        windowContainer3.setArrangeWindows("sequential");
	};
	
	scwin.onpageunload = function() {
		
	};
	
	]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload" ev:onpageunload="scwin.onpageunload">
    	<xf:group id="" style="margin: 10px;"><w2:textbox tagname="h1" style="color: blue;margin-bottom: 10px;" tabIndex="h1" id="textbox1" label="ウィンドウソートボタン位置設定" escape="false"></w2:textbox><w2:textbox tagname="h2" style="height: 23px;margin-bottom: 10px;color: blue;" id="textbox2" label="サンプルの使い方"></w2:textbox><w2:textbox style="color: blue;margin-bottom: 30px;" id="textbox3" label='（初めて目 WindowContainer） &lt;br/&gt;Windows ソートボタン入り左上に表示されるもの確認。 (controlIconPosition="left")&lt;br/&gt;&lt;br/&gt;（二つ目 WindowContainer） &lt;br/&gt;Windows ソートボタン入り右上に表示されるもの確認。 (controlIconPosition="right")&lt;br/&gt;&lt;br/&gt;（三目 WindowContainer） &lt;br/&gt;左矢印含むすべてボタン入り右上に表示されるもの確認。 (controlIconPosition="allright")' escape="false">
    	</w2:textbox><w2:textbox style="padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightblue;border:none;margin-bottom: 10px;" id="textbox4" label='プロパティの設定&lt;br/&gt;useNameContainer="true" &lt;br/&gt;controlIconPosition="left"' escape="false">
    	</w2:textbox>
    		<w2:windowContainer sequentialArrangeColNum="" sequentialArrangeRowNum="" fixArrangeFullScreen="false" useFixButton="false"
    			windowAutoResize="false" useWindowScrollButton="" verticalArrangeNum="2" windowMaxNum="20" useCloseButton="false"
    			controlIconPosition="" stopMinimizeOnNameLayer="false" toolbarPosition="top" windowMaximizeAll="true" id="windowContainer1"
    			useStatusMsg="true" hideTitleOnMaximize="false" spaInitCount="0" windowScrollVisibleRowNum="" stopToggleOnLast="false"
    			useNameContainer="true" horizontalArrangeNum="2" useCustomMsg="false" autoArrange="true" useControlIconTitle="" tooltipDisplay="true"
    			tooltipGroupClass="false" windowTooltipDisplay="true"
    			style="position: relative;height: 400px;border: gray solid 1px;margin-bottom: 10px;">
    			<w2:windowToolbar>
    				<w2:controlIconLayer>
    					<w2:controlIcon></w2:controlIcon>
    					<w2:controlIcon></w2:controlIcon>
    					<w2:controlIcon></w2:controlIcon>
    					<w2:controlIcon></w2:controlIcon>
    					<w2:controlIcon></w2:controlIcon>
    				</w2:controlIconLayer>
    				<w2:nameLayer></w2:nameLayer>
    				<w2:selectedNameLayer></w2:selectedNameLayer>
    			</w2:windowToolbar>
    		</w2:windowContainer>
    		<w2:textbox
    			style="padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightblue;border:none;margin-bottom: 10px;"
    			id="textbox5" label='プロパティの設定&lt;br/&gt;useNameContainer="true" &lt;br/&gt;controlIconPosition="right"' escape="false">
    		</w2:textbox>
    		<w2:windowContainer sequentialArrangeColNum="" sequentialArrangeRowNum="" fixArrangeFullScreen="false" useFixButton="false"
    			windowAutoResize="false" useWindowScrollButton="" verticalArrangeNum="2" windowMaxNum="20" useCloseButton="false"
    			controlIconPosition="right" stopMinimizeOnNameLayer="false" toolbarPosition="top" windowMaximizeAll="true" id="windowContainer2"
    			useStatusMsg="true" hideTitleOnMaximize="false" spaInitCount="0" windowScrollVisibleRowNum="" stopToggleOnLast="false"
    			useNameContainer="true" horizontalArrangeNum="2" useCustomMsg="false" autoArrange="true" useControlIconTitle="" tooltipDisplay="true"
    			tooltipGroupClass="false" windowTooltipDisplay="true"
    			style="position: relative;height: 400px;border: gray solid 1px;margin-bottom: 10px;">
    			<w2:windowToolbar>
    				<w2:controlIconLayer>
    					<w2:controlIcon></w2:controlIcon>
    					<w2:controlIcon></w2:controlIcon>
    					<w2:controlIcon></w2:controlIcon>
    					<w2:controlIcon></w2:controlIcon>
    					<w2:controlIcon></w2:controlIcon>
    				</w2:controlIconLayer>
    				<w2:nameLayer></w2:nameLayer>
    				<w2:selectedNameLayer></w2:selectedNameLayer>
    			</w2:windowToolbar>
    		</w2:windowContainer>
    		<w2:textbox style="padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightblue;border:none;margin-bottom: 10px;" id="textbox6" label='プロパティの設定&lt;br/&gt;useNameContainer="true" &lt;br/&gt;controlIconPosition="allright"' escape="false">
    	</w2:textbox>
    		<w2:windowContainer sequentialArrangeColNum="" sequentialArrangeRowNum="" fixArrangeFullScreen="false" useFixButton="false"
    			windowAutoResize="false" useWindowScrollButton="" verticalArrangeNum="2" windowMaxNum="20" useCloseButton="false"
    			controlIconPosition="allright" stopMinimizeOnNameLayer="false" toolbarPosition="top" windowMaximizeAll="true" id="windowContainer3"
    			useStatusMsg="true" hideTitleOnMaximize="false" spaInitCount="0" windowScrollVisibleRowNum="" stopToggleOnLast="false"
    			useNameContainer="true" horizontalArrangeNum="2" useCustomMsg="false" autoArrange="true" useControlIconTitle="" tooltipDisplay="true"
    			tooltipGroupClass="false" windowTooltipDisplay="true" style="position: relative;height: 400px;border: gray solid 1px;">
    			<w2:windowToolbar>
    				<w2:controlIconLayer>
    					<w2:controlIcon></w2:controlIcon>
    					<w2:controlIcon></w2:controlIcon>
    					<w2:controlIcon></w2:controlIcon>
    					<w2:controlIcon></w2:controlIcon>
    					<w2:controlIcon></w2:controlIcon>
    				</w2:controlIconLayer>
    				<w2:nameLayer></w2:nameLayer>
    				<w2:selectedNameLayer></w2:selectedNameLayer>
    			</w2:windowToolbar>
    		</w2:windowContainer></xf:group>
    </body>
</html>
