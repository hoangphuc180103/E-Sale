/*amd /guide/TabControl/getParameter_p_addTab_TabControl/getParameter_p_addTab_TabControl.xml 5041 967f74d8efbf9997eaaad4184a8fed5bc3a3cf60a1d24e7838222a557d3e4f79 */
define({declaration:{A:{version:'1.0',encoding:'UTF-8'}},E:[{T:1,N:'html',A:{xmlns:'http://www.w3.org/1999/xhtml','xmlns:ev':'http://www.w3.org/2001/xml-events','xmlns:w2':'http://www.inswave.com/websquare','xmlns:xf':'http://www.w3.org/2002/xforms'},E:[{T:1,N:'head',E:[{T:1,N:'w2:type',E:[{T:3,text:'DEFAULT'}]},{T:1,N:'w2:buildDate'},{T:1,N:'xf:model',E:[{T:1,N:'w2:dataCollection',A:{baseNode:'map'}},{T:1,N:'w2:workflowCollection'}]},{T:1,N:'script',A:{type:'text/javascript',lazy:'false'},E:[{T:4,cdata:function(scopeObj){with(scopeObj){scwin.count = 0;
scwin.onpageload = function () {};
scwin.onpageunload = function () {};
scwin.trigger1_onclick = function (e) {
  tabControl1.deleteAllTabs();
  scwin.count++;
  var parameter1 = input1.getValue();
  var parameter2 = input2.getValue();
  var rowJSON = {
    //    "Product Info": { "Origin": "Korea", "Manufacturer": "Inswave", "Type": "Software" },
    //    "Region": "Seoul"+ scwin.count,
    //    "Carrier": true
    "Parameter 1": parameter1,
    "Parameter 2": parameter2
  };
  var dataObject = {
    "type": "json",
    "name": "param",
    "data": rowJSON
  };
  var tmpSrc = scwin.getfolderPath() + "/src.xml";
  tabControl1.addTab(scwin.count, {
    "label": "New - " + scwin.count,
    "title": "dataObject",
    "openAction": "exist",
    "closable": "true"
  }, {
    "src": tmpSrc,
    "frameMode": "wframePreload",
    "scope": "true",
    "dataObject": dataObject
  });
  tabControl1.setSelectedTabIndex(scwin.count);
};
scwin.getfolderPath = function () {
  var currentPath = window.location.href;
  var folderPath;
  if (currentPath.includes("mainContainer")) {
    console.log("true  ===> " + $p.getFrameId());
    const cmtFrame = $p.getComponentById($p.getFrameId());
    currentPath = cmtFrame.getSrc();
    folderPath = currentPath.substring(0, currentPath.lastIndexOf('/'));
  } else {
    console.log("false  ===> ");
    folderPath = currentPath.split('w2xPath=')[1].substring(0, currentPath.split('w2xPath=')[1].lastIndexOf('/'));
  }
  return folderPath;
};
}}}]}]},{T:1,N:'body',A:{'ev:onpageload':'scwin.onpageload','ev:onpageunload':'scwin.onpageunload'},E:[{T:1,N:'xf:group',A:{id:'',style:'margin: 10px;'},E:[{T:1,N:'w2:textbox',A:{tagname:'h1',style:'margin-bottom: 10px;color: blue;',id:'textbox1',label:'탭 생성 시 파라미터 전달',escape:'false'}},{T:1,N:'w2:textbox',A:{tagname:'h2',style:'height: 23px;margin-bottom: 10px;color: blue;',id:'textbox2',label:'샘플 사용 방법'}},{T:1,N:'w2:textbox',A:{style:'color: blue;margin-bottom: 30px;',id:'textbox3',label:'1. 하단의 InputBox에 탭 생성 시 전달할 파라미터를 입력. <br/>2. addTab() 버튼을 클릭. <br/>3. 탭이 생성되는 것을 확인. (위에서 입력한 파라미터도 전달됨.)<br/>4. 생성된 탭 화면의 $p.getParameter() 버튼을 클릭.<br/>5. 위에서 입력한 (탭 생성 시 전달한) 파라미터가 표시되는 것을 확인.<br/>(자세한 스크립트는 Script 탭에서 확인.)',escape:'false'}},{T:1,N:'xf:input',A:{style:'text-align: right;height:50px;padding: 5px;font-size:20px;font-style:normal;font-weight:bolder;color: red;margin-bottom: 10px;display: block;',id:'input1',placeholder:'파라미터 1 입력'}},{T:1,N:'xf:input',A:{style:'text-align: right;height:50px;padding: 5px;font-size:20px;font-style:normal;font-weight:bolder;color: red;margin-bottom: 10px;display: block;',id:'input2',placeholder:'파라미터 2 입력'}},{T:1,N:'xf:trigger',A:{'ev:onclick':'scwin.trigger1_onclick',style:'height:42px;line-height:32px;padding:5px;background-color:coral;font-size:15px;weight: bolder;font-weight:bolder;text-align: left;display: block;margin-bottom: 10px;',id:'trigger1',type:'button'},E:[{T:1,N:'xf:label',E:[{T:4,cdata:'addTab()'}]}]},{T:1,N:'w2:tabControl',A:{confirmTrueAction:'exist',useTabKeyOnly:'true',confirmFalseAction:'new',useMoveNextTabFocus:'false',useConfirmMessage:'false',alwaysDraw:'false',style:'border: gray solid 1px;height: 400px;',id:'tabControl1'}},{T:1,N:'w2:textbox',A:{escape:'false',id:'textbox4',label:'/// 샘플 코드 <br/><br/>scwin.count++;<br/><br/>var parameter1 = input1.getValue();<br/>var parameter2 = input2.getValue();<br/>var rowJSON = {<br/> &nbsp; &nbsp;"Parameter 1": parameter1,<br/> &nbsp; &nbsp;"Parameter 2": parameter2,<br/>};<br/><br/>var dataObject = {<br/> &nbsp; &nbsp;"type": "json",<br/> &nbsp; &nbsp;"name": "param",<br/> &nbsp; &nbsp;"data": rowJSON<br/>};<br/><br/>tabControl1.addTab(scwin.count, {<br/> &nbsp; &nbsp;"label": "New - " + scwin.count,<br/> &nbsp; &nbsp;"title": "dataObject",<br/> &nbsp; &nbsp;"openAction": "exist",<br/> &nbsp; &nbsp;"closable": "true"<br/>}, {<br/> &nbsp; &nbsp;"src": "src.xml",<br/> &nbsp; &nbsp;"frameMode": "wframePreload",<br/> &nbsp; &nbsp;"scope": "true",<br/> &nbsp; &nbsp;"dataObject": dataObject<br/>});',style:'padding:10px; padding-bottom:20px; text-align:left; font-size:15px; font-weight:bolder; border:brown 1px solid; background-color:ivory; margin-bottom:10px; margin-top:10px; color:brown;'}}]}]}]}]})