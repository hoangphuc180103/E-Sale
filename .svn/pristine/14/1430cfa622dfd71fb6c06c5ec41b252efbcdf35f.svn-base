<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
        <w2:type>DEFAULT</w2:type>
        <w2:buildDate />
        <xf:model>
            <xf:instance>
                <data xmlns="" />
            </xf:instance>
            <w2:dataCollection baseNode="map">
                <w2:dataList id="dataList1" baseNode="list" style=""
                    saveRemovedData="true" repeatNode="map">
                    <w2:columnInfo>
                        <w2:column id="title" name="title" dataType="text">
                        </w2:column>
                        <w2:column id="start" name="start" dataType="text">
                        </w2:column>
                        <w2:column id="end" name="end" dataType="text">
                        </w2:column>
                    </w2:columnInfo>
                    <w2:data use="false">
                    </w2:data>
                </w2:dataList>
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
        <script type="javascript" lazy="false"><![CDATA[
scwin.onpageload = function () {
    var dateStr = WebSquare.date.getCurrentServerDate("yyyyMMdd");
    var addDate = WebSquare.date.dateAdd(dateStr, 3);
    var tmpArr = [{ "title": "My Schedule", "start": dateStr, "end": addDate }];
    dataList1.setJSON(tmpArr);
};


scwin.customButton1_onclick = function (e) {
    alert("custom1 clicked");
};
scwin.customButton2_onclick = function (e) {
    alert("custom2 clicked");
};
scwin.customButton3_onclick = function (e) {
    alert("custom3 clicked");
};
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload">
    <xf:group id="" style="margin:10px;">
    	<w2:textbox tagname="h1" style="color: blue;margin-bottom: 10px;" tabIndex="h1" id="textbox1" label="달력 푸터에 버튼 추가" escape="false"></w2:textbox>
    	<w2:textbox tagname="h2" style="height: 23px;margin-bottom: 10px;color: blue;" id="textbox2" label="샘플 사용 방법"></w2:textbox>
    	<w2:textbox style="color: blue;margin-bottom: 30px;" id="textbox3"
    		label='(첫 번째 ScheduleCalendar)&lt;br/&gt;1. 하단 푸터 부분에 customButtonText 속성으로 정의한 이름의 버튼들이 표시되는 것을 확인. &lt;br/&gt;2. 푸터 부분에 있는 각 버튼을 클릭. &lt;br/&gt;3. 각 버튼을 클릭할 때마다 customButtonClickFunction 속성으로 정의한 함수가 실행되는 것을 확인. &lt;br/&gt;&lt;br/&gt;(두 번째 ScheduleCalendar)&lt;br/&gt;1. 하단 푸터 부분에 버튼이 없는 것을 확인.&lt;br/&gt;'
    		escape="false">
    	</w2:textbox>
    	<w2:textbox
    		style="padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightblue;border:none;margin-bottom: 10px;"
    		id="textbox4" label='속성 설정&lt;br/&gt;useFooterToolbar="true"&lt;br/&gt;customButtonText="aaa,bbbb,ccccc"&lt;br/&gt;customButtonClickFunction="scwin.customButton1_onclick,scwin.customButton2_onclick,scwin.customButton3_onclick"' escape="false">
    	</w2:textbox>
    	<w2:scheduleCalendar defaultDate="" endColumn="end" editable="false" selectable="" headerRightBtn="false" useFooterToolbar="true"
    		version="6.1.11" customButtonClickFunction="scwin.customButton1_onclick,scwin.customButton2_onclick,scwin.customButton3_onclick"
    		footerToolbarStart="aaa,bbbb,ccccc" titleColumn="title" startColumn="start" dataList="dataList1" customButtonText="aaa,bbbb,ccccc"
    		style="width: 400px;height: 500px;margin-bottom: 10px;" eventLimit="false" id="scheduleCalendar1" headerLeftBtn="true" headerTitle="true">
    	</w2:scheduleCalendar>
    	<w2:textbox escape="false" id="textbox5" label='속성 설정&lt;br/&gt;useFooterToolbar="false"'
    		style="padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightblue;border:none;margin-bottom: 10px;">
    	</w2:textbox>
    	<w2:scheduleCalendar customButtonClickFunction="scwin.customButton1_onclick,scwin.customButton2_onclick,scwin.customButton3_onclick"
    		customButtonText="aaa,bbbb,ccccc" dataList="dataList1" defaultDate="" editable="false" endColumn="end" eventLimit="false"
    		footerToolbarStart="aaa,bbbb,ccccc" headerLeftBtn="true" headerRightBtn="false" headerTitle="true" id="scheduleCalendar2"
    		selectable="" startColumn="start" style="width: 400px;height: 500px;margin-bottom: 10px;" titleColumn="title" version="6.1.11">
    	</w2:scheduleCalendar>
    </xf:group></body>
</html>
