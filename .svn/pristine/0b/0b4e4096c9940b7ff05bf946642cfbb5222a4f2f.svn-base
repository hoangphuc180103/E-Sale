<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
        <w2:type>COMPONENT</w2:type>
        <w2:buildDate/>
        <w2:MSA/>
        <xf:model>
            <w2:dataCollection baseNode="map">
            	<w2:dataList baseNode="list" id="dataList1" repeatNode="map" saveRemovedData="true" style="">
            		<w2:columnInfo>
            			<w2:column dataType="text" id="col1" name="name1"></w2:column>
            			<w2:column dataType="text" id="col2" name="name2"></w2:column>
            			<w2:column dataType="text" id="col3" name="name3"></w2:column>
            			<w2:column dataType="text" id="col4" name="name4"></w2:column>
            			<w2:column dataType="text" id="col5" name="name5"></w2:column>
            			<w2:column dataType="text" id="col6" name="name6"></w2:column>
            		</w2:columnInfo>
            	</w2:dataList>
            </w2:dataCollection>
            <w2:workflowCollection/>
        </xf:model>
        <w2:layoutInfo/>
        <w2:publicInfo method=""/>
        <script lazy="false" type="text/javascript"><![CDATA[
scwin.onpageload = function () {
    var data = [];
    var row = 10;
    var col = 6;
    for (var i = 0; i < row; i++) {
        for (var j = 0; j < col; j++) {
            var t = Math.floor(i / 5);
            data.push(t * 100 + j * (t + 1));
        }
    }
    dataList1.setData(data);

};

scwin.trigger1_onclick = function (e) {

    var options = {
        useSubTotal: false,
        headerFontBold: true
    };
    gridView1.advancedExcelDownload(options);
};

scwin.trigger2_onclick = function (e) {
    gridView1.advancedExcelDownload({});
};
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload">
    <xf:group id="" style="margin: 10px;">
    	<w2:textbox tagname="h1" style="color: blue;margin-bottom: 10px;" tabIndex="h1" id="textbox1" label="Excelファイルのヘッダーを太字で表示"
    		escape="false">
    	</w2:textbox>
    	<w2:textbox tagname="h2" style="height: 23px;margin-bottom: 10px;color: blue;" id="textbox2" label="サンプルの使い方"></w2:textbox>
    	<w2:textbox style="color: blue;margin-bottom: 30px;" id="textbox3"
    		label="1-1.最初のボタンをクリックします。 &lt;br/&gt;1-2.ダウンロードしたExcelファイルを開く。&lt;br/&gt;1-3.ヘッダー部分が太字であることを確認してください。&lt;br/&gt;&lt;br/&gt;2-1. 2番目のボタンをクリックします。 &lt;br/&gt;2-2.ダウンロードしたExcelファイルを開く。&lt;br/&gt;2-3.ヘッダー部分が太字で表示されていないことを確認してください。"
    		escape="false">
    	</w2:textbox>
    	<xf:trigger ev:onclick="scwin.trigger1_onclick"
    		style="height:42px;line-height:32px;padding:5px;background-color:coral;font-size:15px;weight: bolder;font-weight:bolder;text-align: left;display: block;margin-bottom: 10px;"
    		id="trigger1" type="button">
    		<xf:label><![CDATA[advancedExcelDownload(options) - options.headerFontBold="true"]]></xf:label>
    	</xf:trigger>
    	<xf:trigger ev:onclick="scwin.trigger2_onclick"
    		style="height:42px;line-height:32px;padding:5px;background-color:coral;font-size:15px;weight: bolder;font-weight:bolder;text-align: left;display: block;margin-bottom: 10px;"
    		id="trigger2" type="button">
    		<xf:label><![CDATA[gridView1.advancedExcelDownload({});]]></xf:label>
    	</xf:trigger>
    	<w2:gridView visibleRowNumFix="true" rowNumVisible="true" checkAllType="false" dataList="data:dataList1"
    		style="border: solid gray 1px;margin-bottom: 10px;" id="gridView1" visibleRowNum="10" autoFit="allColumn">
    		<w2:caption style="" id="caption2" value="this is a grid caption."></w2:caption>
    		<w2:header style="" id="header2">
    			<w2:row style="" id="row3">
    				<w2:column width="70" inputType="text" style="" id="column8" value="name1" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="" id="column7" value="name2" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="" id="column6" value="name3" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="" id="column5" value="name4" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="" id="column4" value="name5" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="" id="column3" value="name6" displayMode="label"></w2:column>
    			</w2:row>
    		</w2:header>
    		<w2:gBody style="" id="gBody2">
    			<w2:row style="" id="row4">
    				<w2:column width="70" inputType="text" style="" id="col1" value="" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="" id="col2" value="" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="" id="col3" value="" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="" id="col4" value="" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="" id="col5" value="" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="" id="col6" value="" displayMode="label"></w2:column>
    			</w2:row>
    		</w2:gBody>
    	</w2:gridView>
    	<w2:textbox escape="false" id="textbox4"
    		label='/// サンプルコード &lt;br/&gt;&lt;br/&gt;var options = {&lt;br/&gt; &amp;nbsp; &amp;nbsp;useSubTotal: false,&lt;br/&gt; &amp;nbsp; &amp;nbsp;headerFontBold: true&lt;br/&gt;};&lt;br/&gt;gridView1.advancedExcelDownload(options);'
    		style="padding:10px; padding-bottom:20px; text-align:left; font-size:15px; font-weight:bolder; border:brown 1px solid; background-color:ivory; margin-bottom:10px; color:brown;"
    		tagname="">
    	</w2:textbox>
    </xf:group></body>
</html>
