define({declaration:{A:{version:'1.0',encoding:'UTF-8'}},E:[{T:1,N:'html',A:{xmlns:'http://www.w3.org/1999/xhtml','xmlns:ev':'http://www.w3.org/2001/xml-events','xmlns:w2':'http://www.inswave.com/websquare','xmlns:xf':'http://www.w3.org/2002/xforms'},E:[{T:1,N:'head',E:[{T:1,N:'w2:type',E:[{T:3,text:'DEFAULT'}]},{T:1,N:'w2:buildDate'},{T:1,N:'xf:model',E:[{T:1,N:'w2:dataCollection',A:{baseNode:'map'}},{T:1,N:'w2:workflowCollection'}]},{T:1,N:'script',A:{type:'text/javascript',lazy:'false'},E:[{T:4,cdata:function(scopeObj){with(scopeObj){scwin.onpageload = function () {
  const tmpSrc = scwin.getfolderPath() + "/11.xml";
  iframe1.setSrc(tmpSrc);
};
scwin.onpageunload = function () {};
scwin.trigger1_onclick = function (e) {
  const tmpSrc = scwin.getfolderPath() + "/22.xml";
  iframe1.setSrc(tmpSrc);
};
scwin.getfolderPath = function () {
  var currentPath = window.location.href;
  var folderPath;
  if (currentPath.includes("mainContainer")) {
    console.log("true  ===> " + $p.getFrameId());
    const cmtFrame = $p.getComponentById($p.getFrameId());
    currentPath = cmtFrame.getSrc();
    folderPath = currentPath.substring(0, currentPath.lastIndexOf('/'));
  } else {
    console.log("false  ===> ");
    folderPath = currentPath.split('w2xPath=')[1].substring(0, currentPath.split('w2xPath=')[1].lastIndexOf('/'));
  }
  return folderPath;
};
}}}]}]},{T:1,N:'body',A:{'ev:onpageload':'scwin.onpageload','ev:onpageunload':'scwin.onpageunload'},E:[{T:1,N:'xf:group',A:{id:'',style:'margin: 10px;'},E:[{T:1,N:'w2:textbox',A:{tagname:'h1',style:'color: blue;margin-bottom: 10px;',tabIndex:'h1',id:'textbox1',label:'IFrame 내부의 History 기능 허용',escape:'false'}},{T:1,N:'w2:textbox',A:{tagname:'h2',style:'height: 23px;margin-bottom: 10px;color: blue;',id:'textbox2',label:'샘플 사용 방법'}},{T:1,N:'w2:textbox',A:{style:'color: blue;margin-bottom: 30px;',id:'textbox3',label:'1. 본 예제를 단독 실행. <br/>2. 임의의 웹 페이지로 이동. <br/>3. 본 예제를 단독 실행한 브라우저의 주소를 복사하여 임의의 웹 페이지를 실행한 브라우저의 주소란의 붙여넣기.<br/>4. &nbsp;setSrc() 버튼을 클릭. <br/>5. IFrame 내부 화면이 변경되는 것을 확인. <br/>6. 브라우저의 뒤로가기 버튼을 클릭. <br/>7. 이전 IFrame 화면이 표시되는 것을 확인. (spaReplaceHistory="false")<br/>8. 브라우저의 뒤로가기 버튼을 다시 클릭해야 이전 임의의 웹 페이지로 이동하는 것을 확인. <br/>(spaReplaceHistory="true" 예제도 함께 확인.)',escape:'false'}},{T:1,N:'xf:trigger',A:{'ev:onclick':'scwin.trigger1_onclick',style:'height:42px;line-height:32px;padding:5px;background-color:coral;font-size:15px;weight: bolder;font-weight:bolder;text-align: left;display: block;margin-bottom: 10px;',id:'trigger1',type:'button'},E:[{T:1,N:'xf:label',E:[{T:4,cdata:'setSrc("22.xml")'}]}]},{T:1,N:'w2:textbox',A:{style:'padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightblue;border:none;margin-bottom: 10px;',id:'textbox4',label:'속성 설정<br/>spaReplaceHistory="false" <br/>spa="false"',escape:'false'}},{T:1,N:'w2:iframe',A:{scrolling:'',src:'',spa:'true',style:'border: solid 1px gray;margin-bottom: 10px;',id:'iframe1',spaReplaceHistory:'false'}}]}]}]}]})