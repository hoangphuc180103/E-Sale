define({declaration:{A:{version:'1.0',encoding:'UTF-8'}},E:[{T:1,N:'html',A:{xmlns:'http://www.w3.org/1999/xhtml','xmlns:ev':'http://www.w3.org/2001/xml-events','xmlns:w2':'http://www.inswave.com/websquare','xmlns:xf':'http://www.w3.org/2002/xforms'},E:[{T:1,N:'head',E:[{T:1,N:'w2:type',E:[{T:3,text:'DEFAULT'}]},{T:1,N:'w2:buildDate'},{T:1,N:'xf:model',E:[{T:1,N:'w2:dataCollection',A:{baseNode:'map'}},{T:1,N:'w2:workflowCollection'}]},{T:1,N:'script',A:{type:'text/javascript',lazy:'false'},E:[{T:4,cdata:function(scopeObj){with(scopeObj){scwin.onpageload = function () {
  const tmpSrc = scwin.getfolderPath() + "/wframe_01.xml";
  wframe1.setSrc(tmpSrc);
};
scwin.onpageunload = function () {};
scwin.getfolderPath = function () {
  var currentPath = window.location.href;
  var folderPath;
  if (currentPath.includes("mainContainer")) {
    console.log("true  ===> " + $p.getFrameId());
    const cmtFrame = $p.getComponentById($p.getFrameId());
    currentPath = cmtFrame.getSrc();
    folderPath = currentPath.substring(0, currentPath.lastIndexOf('/'));
  } else {
    console.log("false  ===> ");
    folderPath = currentPath.split('w2xPath=')[1].substring(0, currentPath.split('w2xPath=')[1].lastIndexOf('/'));
  }
  return folderPath;
};
}}}]}]},{T:1,N:'body',A:{'ev:onpageload':'scwin.onpageload','ev:onpageunload':'scwin.onpageunload'},E:[{T:1,N:'xf:group',A:{id:'',style:'margin: 10px;'},E:[{T:1,N:'w2:textbox',A:{tagname:'h1',style:'color: blue;margin-bottom: 10px;',id:'textbox1',label:'프레임 기반 모달 팝업 생성',escape:'false'}},{T:1,N:'w2:textbox',A:{tagname:'h2',style:'height: 23px;margin-bottom: 10px;color: blue;',id:'textbox2',label:'샘플 사용 방법'}},{T:1,N:'w2:textbox',A:{style:'color: blue;margin-bottom: 30px;',id:'textbox3',label:'1. 가장 내부 프레임에서 &nbsp;openPopup() 메소드의 frameModal 옵션을 선택. ("frame", "parent", "top", 프레임 ID)<br/>2. 윈도우 내부의 $p.openPopup() 버튼을 클릭.<br/>3. 옵션 설정에 따른 팝업 동작 범위를 확인.<br/><br/>frameModal 옵션 값에 따른 동작은 다음과 같음.<br/> &nbsp; &nbsp;"frame" : 해당 프레임 내부에 모달 팝업으로 표시. <br/> &nbsp; &nbsp;"parent" : 부모 프레임 내부에 모달 팝업으로 표시. <br/> &nbsp; &nbsp;"top" : 전체 화면에 모달 팝업으로 표시. <br/> &nbsp; &nbsp;프레임 ID : 지정한 프레임 내부에 모달 팝업으로 표시. (아럐 예제의 경우 $p.getFrame().getParentFrame().getParentFrame().id로 프레임 ID를 구함.)',escape:'false'}},{T:1,N:'w2:wframe',A:{style:'border: gray solid 1px;',id:'wframe1'}}]}]}]}]})