/**
 * '자식 컴포넌트 반환 받기' 버튼 클릭 시
 */
scwin.btn_ex1_onclick = function (e) {
  // 'id' 속성이 'grp_form'인 컴포넌트의 자식 컴포넌트가 담긴 배열이 반환됩니다.
  // 직계 자식 컴포넌트(첫 번째 깊이의 컴포넌트)
  let arrComponents = WebSquare.util.getChildren(grp_form);

  // 로그 출력
  $c.frame.printExampleLog($p, "** scwin.btn_ex1_onclick 실행 **", txa_log, false);
  console.log(arrComponents);
  $c.frame.printExampleLog($p, 'WebSquare.util.getChildren(grp_form);', txa_log, false);
  scwin.printInfo(arrComponents);
};

/**
 * '전체 자손 컴포넌트 반환 받기' 버튼 클릭 시
 */
scwin.btn_ex2_onclick = function (e) {
  // 'id' 속성이 'grp_form'인 컴포넌트의 자손 컴포넌트가 담긴 배열이 반환됩니다.
  // 자식, 손자, 증손자 등 모든 하위 컴포넌트(깊이 상관없이 모든 하위 컴포넌트)
  let arrComponents = WebSquare.util.getChildren(grp_form, {
    recursive: true
  });

  // 로그 출력
  $c.frame.printExampleLog($p, "** scwin.btn_ex2_onclick 실행 **", txa_log, false);
  console.log(arrComponents);
  $c.frame.printExampleLog($p, 'WebSquare.util.getChildren(grp_form, {recursive:true});', txa_log, false);
  scwin.printInfo(arrComponents);
};

/**
 * 'Group, Textbox를 제외한 자손 컴포넌트 반환 받기' 버튼 클릭 시
 */
scwin.btn_ex3_onclick = function (e) {
  // 'id' 속성이 'grp_form'인 컴포넌트의 'group'과 'textbox' 컴포넌를 제외한 자손 컴포넌트가 담긴 배열이 반환됩니다.
  // 자식, 손자, 증손자 등 모든 하위 컴포넌트(깊이 상관없이 모든 하위 컴포넌트)
  let arrComponents = WebSquare.util.getChildren(grp_form, {
    recursive: true,
    excludePlugin: "group textbox"
  });

  // 로그 출력
  $c.frame.printExampleLog($p, "** scwin.btn_ex3_onclick 실행 **", txa_log, false);
  console.log(arrComponents);
  $c.frame.printExampleLog($p, 'WebSquare.util.getChildren(grp_form, {recursive:true, excludePlugin:"group textbox"});', txa_log, false);
  scwin.printInfo(arrComponents);
};

/**
 * 컴포넌트 정보 출력 메소드
 * @param {object} argCmp 웹스퀘어 컴포넌트
 */
scwin.printInfo = function (argArrCmp) {
  var strLog = "";
  var i;
  var numLength;
  var strDelimiter = "----------------------------------------\n";
  numLength = argArrCmp.length;
  strLog = strDelimiter + "전체 컴포넌트 수 : " + numLength + "\n" + strDelimiter;
  for (i = 0; i < numLength; i++) {
    let argCmp = argArrCmp[i];
    strLog += i + "번째 컴포넌트 정보\n";

    //컴포넌트에 getOriginalID method가 있는 경우 진행
    if (argCmp.getOriginalID) {
      //컴포넌트 ID 추출. (사용자가 지정한 ID)
      strLog += "ID : " + argCmp.getOriginalID() + "\n";
    }

    //컴포넌트에 getPluginName method가 있는 경우 진행
    if (argCmp.getPluginName) {
      //컴포넌트명(plugin name) 추출
      strLog += "PluginName : " + argCmp.getPluginName() + "\n";
    }

    //구분자 추가
    if (strLog) {
      strLog += strDelimiter;
    }
  }

  //textarea에 문자열 출력
  $c.frame.printExampleLog($p, strLog, txa_log, false);
};

/**
 * textarea의 로그 삭제
 */
scwin.btn_clearLog_onclick = function (e) {
  //textarea value를 빈문자열로 할당.
  txa_log.setValue("");
};
