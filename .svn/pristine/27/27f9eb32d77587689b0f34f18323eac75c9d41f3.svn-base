n2_submitdone','ev:submiterror':'scwin.submission2_submiterror',abortTrigger:''}}]},{T:1,N:'script',A:{type:'text/javascript',lazy:'false'},E:[{T:4,cdata:function(scopeObj){with(scopeObj){scwin.onpageload = function () {};
scwin.onpageunload = function () {};
scwin.submission1_submit = function (e) {
  alert("submit - Submission is about to start!");
};
scwin.submission1_submitdone = function (e) {
  alert("submitdone - Submission successful.");
};
scwin.submission1_submiterror = function (e) {
  alert("submiterror - Submission failed.");
};
scwin.trigger1_onclick = function (e) {
  var objSubmission = $p.getSubmission("submission1");
  objSubmission.action = scwin.getfolderPath() + '/data.json';
  $p.executeSubmission("submission1");
};
scwin.submission2_submit = function (e) {
  alert("submit - Submission is about to start!");
};
scwin.submission2_submitdone = function (e) {
  alert("submitdone - Submission successful.");
};
scwin.submission2_submiterror = function (e) {
  alert("submiterror - Submission failed.");
};
scwin.trigger2_onclick = function (e) {
  var objSubmission = $p.getSubmission("submission2");
  objSubmission.action = scwin.getfolderPath() + '/datal.json';
  $p.executeSubmission("submission2");
};
scwin.getfolderPath = function () {
  var currentPath = window.location.href;
  var folderPath;
  if (currentPath.includes("mainContainer")) {
    console.log("true  ===> " + $p.getFrameId());
    const cmtFrame = $p.getComponentById($p.getFrameId());
    currentPath = cmtFrame.getSrc();
    folderPath = currentPath.substring(0, currentPath.lastIndexOf('/'));
  } else {
    console.log("false  ===> ");
    folderPath = currentPath.split('w2xPath=')[1].substring(0, currentPath.split('w2xPath=')[1].lastIndexOf('/'));
  }
  return folderPath;
};
}}}]}]},{T:1,N:'body',A:{'ev:onpageload':'scwin.onpageload','ev:onpageunload':'scwin.onpageunload'},E:[{T:1,N:'xf:group',A:{id:'',style:'margin: 10px;'},E:[{T:1,N:'w2:textbox',A:{tagname:'h1',style:'color: blue;margin-bottom: 10px;',id:'textbox1',label:'イベント - submit & submitdone & submiterror',escape:'false'}},{T:1,N:'w2:textbox',A:{tagname:'h2',style:'height: 23px;margin-bottom: 10px;color: blue;',id:'textbox2',label:'サンプルの使い方'}},{T:1,N:'w2:textbox',A:{style:'color: blue;margin-bottom: 30px;',id:'textbox3',label:'1-1. 最初のボタンをクリックします。 <br/>1-2. サブミッションが精巧に実行され、サブミットとサブミットドーンイベントが発生することを確認。 <br/><br/>2-1. 2番目のボタンをクリックします。 <br/>2-2. エラーが発生し、submitとsubmiterrorイベントが発生することを確認してください。 （"submission2"のデータファイル名を誤って誤って設定します。）<br/>',escape:'false'}},{T:1,N:'w2:textbox',A:{style:'padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightgreen;border:none;margin-bottom: 10px;',id:'textbox4',label:'イベント説明<br/>submit - Submission 開始前に発生。 <br/>submitdone - Submission 完了後に発生。 &nbsp;<br/>submiterror - Submission エラー時に発生。',escape:'false'}},{T:1,N:'xf:trigger',A:{'ev:onclick':'scwin.trigger1_onclick',style:'display: block;height:42px;line-height:32px;padding:5px;background-color:coral;font-size:15px;weight: bolder;font-weight:bolder;margin-bottom:10px;text-align: left;',id:'trigger1',type:'button'},E:[{T:1,N:'xf:label',E:[{T:4,cdata:'$p.executeSubmission("submission1"); - submit & submitdone'}]}]},{T:1,N:'xf:trigger',A:{'ev:onclick':'scwin.trigger2_onclick',style:'display: block;height:42px;line-height:32px;padding:5px;background-color:coral;font-size:15px;weight: bolder;font-weight:bolder;margin-bottom:10px;text-align: left;',id:'trigger2',type:'button'},E:[{T:1,N:'xf:label',E:[{T:4,cdata:'$p.executeSubmission("submission2"); - submit & submiterror'}]}]},{T:1,N:'w2:gridView',A:{scrollByColumnAdaptive:'false',dataList:'data:dataList1',scrollByColumn:'false',style:'border: solid gray 1px;',autoFit:'allColumn',id:'gridView1',defaultCellHeight:'20',visibleRowNu