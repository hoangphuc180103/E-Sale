<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
         <script type="text/javascript" lazy="false"><![CDATA[
        
	scwin.onpageload = function() {
		
	};
	
	scwin.onpageunload = function() {
		
	};
	
	
	scwin.trigger1_onclick = function(e) {
		var panelList = accordion1.getOpenPanelListInfo();
		var panelListInfo = JSON.stringify(panelList);
		alert(panelListInfo);
	};
	]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload" ev:onpageunload="scwin.onpageunload">
    <xf:group id="" style="margin: 10px;">
    	<w2:textbox tagname="h1" style="margin-bottom: 10px;color: blue;" id="textbox1" label="모든 열린 패널의 속성 확인" escape="false"></w2:textbox>
    	<w2:textbox tagname="h2" style="height: 23px;margin-bottom: 10px;color: blue;" id="textbox2" label="샘플 사용 방법"></w2:textbox>
    	<w2:textbox style="color: blue;margin-bottom: 30px;" id="textbox3"
    		label="1. 하단의 getOpenPanelListInfo() 버튼을 클릭.&lt;br/&gt;2. 현재 열려 있는 모든 패널들의 속성이 표시되는 것을 확인." escape="false">
    	</w2:textbox>
    	<xf:trigger ev:onclick="scwin.trigger1_onclick"
    		style="height:42px;line-height:32px;padding:5px;background-color:coral;font-size:15px;weight: bolder;font-weight:bolder;text-align: left;display: block;margin-bottom: 10px;"
    		id="trigger1" type="button">
    		<xf:label><![CDATA[getOpenPanelListInfo()]]></xf:label>
    	</xf:trigger>
    	<w2:textbox tagname="" style="padding:10px; padding-bottom:20px; text-align:left; font-size:15px; font-weight:bolder; border:brown 1px solid; background-color:ivory; margin-bottom:10px; color:brown;" id="textbox4" label="/// 샘플 코드 &lt;br/&gt;&lt;br/&gt;var panelList = accordion1.getOpenPanelListInfo();&lt;br/&gt;var panelListInfo = JSON.stringify(panelList);&lt;br/&gt;alert(panelListInfo);" escape="false">
    	</w2:textbox>
    	<w2:accordion collapseAll="" style="border:solid 2px gray;margin-bottom: 10px;" id="accordion1" selectedPanel=""
    		unCollapseAll="true" collapsible="" class="" panelMoveSpeed="" titleDivTag="">
    		<w2:panels style="" id="panel1" class="">
    			<w2:panelTitle style="" id="panelTitle1" label="1" class=""></w2:panelTitle>
    			<w2:panelContent style="height:80%;width: 90%;" id="panelContent1" class="">
    				<w2:textbox
    					style="width: 150px;height: 23px;margin: 50px;background-color: lightgreen;font-size:15px;padding: 10px;font-style:normal;font-weight:bolder;"
    					id="" label="Panel 1">
    				</w2:textbox>
    			</w2:panelContent>
    		</w2:panels>
    		<w2:panels style="" id="panel2" class="">
    			<w2:panelTitle style="" id="panelTitle2" label="2" class=""></w2:panelTitle>
    			<w2:panelContent style="height:80%;width: 90%;" id="panelContent2" class="">
    				<w2:textbox
    					style="width: 150px;height: 23px;margin: 50px;background-color: lightgreen;font-size:15px;padding: 10px;font-style:normal;font-weight:bolder;"
    					id="" label="Panel 2">
    				</w2:textbox>
    			</w2:panelContent>
    		</w2:panels>
    		<w2:panels style="" id="panel3" class="">
    			<w2:panelTitle style="" id="panelTitle3" label="3" class=""></w2:panelTitle>
    			<w2:panelContent style="height:80%;width: 90%;" id="panelContent3" class="">
    				<xf:select1 appearance="full" style="position: absolute ;left:589px;top:91px;width: 54px;height: 25px;" id="select1"
    					selectedIndex="-1">
    				</xf:select1>
    				<w2:textbox
    					style="width: 150px;height: 23px;margin: 50px;background-color: lightgreen;font-size:15px;padding: 10px;font-style:normal;font-weight:bolder;"
    					id="" label="Panel 3">
    				</w2:textbox>
    			</w2:panelContent>
    		</w2:panels>
    	</w2:accordion>
    </xf:group></body>
</html>
