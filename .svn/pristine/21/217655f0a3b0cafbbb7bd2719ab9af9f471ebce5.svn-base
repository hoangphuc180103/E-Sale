scwin.trigger1_onclick = function (e) {
  dataList1.setColumnFilter({
    type: 'regExp',
    colIndex: 'Item',
    key: /Freezer/gi,
    condition: 'and',
    clearFilter: 'none'
  });
};
scwin.trigger2_onclick = function (e) {
  dataList1.setColumnFilter({
    type: 'regExp',
    colIndex: 'Item',
    key: /Freezer/gi,
    condition: 'and',
    clearFilter: 'keepSort'
  });
};
scwin.trigger3_onclick = function (e) {
