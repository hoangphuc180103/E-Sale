<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            	<w2:dataList baseNode="list" id="dataList1" repeatNode="map" saveRemovedData="true" style="margin: 100px;">
            		<w2:columnInfo>
            			<w2:column dataType="text" id="Code" name="name1"></w2:column>
            			<w2:column dataType="text" id="City" name="name2"></w2:column>
            			<w2:column dataType="text" id="Country" name="name3"></w2:column>
            			<w2:column dataType="text" id="Type" name="name4"></w2:column>
            		</w2:columnInfo>
            	</w2:dataList>
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
         <script type="text/javascript" lazy="false"><![CDATA[
        
	scwin.onpageload = function() {
		var json = [
			{"Code" : "SEL", "City" : "Seoul, 韓国最大の都市", "Country" : "Korea", "Type" : "Domestic"},
			{"Code" : "BSN", "City" : "Busan, 韓国で2番目に大きな都市", "Country" : "Korea", "Type" : "Domestic"},
			{"Code" : "ICN", "City" : "Incheon, 韓国への玄関口", "Country" : "Korea", "Type" : "Domestic"},
			{"Code" : "DJN", "City" : "Daejeon, 韓国の行政都市 ", "Country" : "Korea", "Type" : "Domestic"},
			{"Code" : "DGU", "City" : "Jeju, 朝鮮半島で最大の島", "Country" : "Korea", "Type" : "Domestic"},
			{"Code" : "OTW", "City" : "Ottawa, カナダ", "Country" : "Canada", "Type" : "Overseas"},
			{"Code" : "LDN", "City" : "Toronto, カナダ", "Country" : "Canada", "Type" : "Overseas"},
			{"Code" : "BRN", "City" : "Berlin, ドイツ", "Country" : "Germany", "Type" : "Overseas"},
			{"Code" : "BJG", "City" : "Beijing, 中国", "Country" : "China", "Type" : "Overseas"},
			{"Code" : "LDN", "City" : "London, 英国", "Country" : "UK", "Type" : "Overseas"},
			];
		dataList1.setJSON(json);	
		
	};
	
	scwin.onpageunload = function() {
		
	};
	
	scwin.selectBoxTooltip = function(label, index){
       		var row = index + 1;
       		return row + " row tooltip customizable.";
  };]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload" ev:onpageunload="scwin.onpageunload">
    <xf:group id="" style="margin: 10px;">
    	<w2:textbox escape="false" id="textbox1" label="ツールチップのカスタマイズ" style="color: blue;margin-bottom: 10px;" tabIndex="h1" tagname="h1"></w2:textbox>
    	<w2:textbox id="textbox2" label="サンプルの使い方" style="height: 23px;margin-bottom: 10px;color: blue;" tagname="h2"></w2:textbox>
    	<w2:textbox escape="false" id="textbox3"
    		label='1. SelectBoxを開く。 &lt;br/&gt;2.リストに項目にマウスカーソルを移動します。 &lt;br/&gt;3. itemTooltipFormatterプロパティ値で指定された関数によって返された値がツールチップとして表示されることを確認してください。'
    		style="color: blue;margin-bottom: 30px;">
    	</w2:textbox>
    	<w2:textbox escape="false" id="textbox4" label='プロパティの設定&lt;br/&gt;itemTooltipFormatter="scwin.selectBoxTooltip"'
    		style="padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightblue;border:none;margin-bottom: 10px;">
    	</w2:textbox>
    	<w2:textbox style="padding:10px; padding-bottom:20px; text-align:left; font-size:15px; font-weight:bolder; border:brown 1px solid; background-color:ivory; margin-bottom:10px; margin-top:10px; color:brown;" id="textbox5" label='/// サンプルコード&lt;br/&gt;&lt;br/&gt;scwin.selectBoxTooltip = function(label, index) {&lt;br/&gt; &amp;nbsp; &amp;nbsp;var row = index + 1;&lt;br/&gt; &amp;nbsp; &amp;nbsp;return row + " row tooltip customizable.";&lt;br/&gt;};' escape="false">
    	</w2:textbox>
    	<xf:select1 enableColumn="" tooltipShowAlways="" submenuSize="auto" useItemLocale="" labelWidthAuto="" chooseOption="" tooltip=""
    		allOption="" itemTooltipDisplay="true" tooltipLocaleRef="" ref="" appearance="minimal" enableColumnFalseValue="" tooltipDisplay=""
    		disabledClass="w2selectbox_disabled" itemTooltipFormatter="scwin.selectBoxTooltip" style="width: 50%;" disabled="false" id="select1"
    		class="" direction="auto">
    		<xf:choices>
    			<xf:itemset nodeset="data:dataList1">
    				<xf:label ref="City"></xf:label>
    				<xf:value ref="Code"></xf:value>
    			</xf:itemset>
    		</xf:choices>
    	</xf:select1>
    </xf:group></body>
</html>
