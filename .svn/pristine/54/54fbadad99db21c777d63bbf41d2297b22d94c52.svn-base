<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
    	<w2:buildDate />
    	<xf:model>
    		<xf:instance>
    			<data xmlns="" />
    		</xf:instance>
    		<w2:dataCollection baseNode="map">
    			<w2:dataList baseNode="list" id="dataList1" repeatNode="map" saveRemovedData="true" style="">
    				<w2:columnInfo>
    					<w2:column dataType="text" id="Status" name="Status"></w2:column>
    					<w2:column dataType="text" id="Date" name="Date"></w2:column>
    					<w2:column dataType="text" id="Expense" name="Expense"></w2:column>
    					<w2:column dataType="text" id="Income" name="Income"></w2:column>
    					<w2:column dataType="text" id="Hobby" name="Hobby"></w2:column>
    					<w2:column dataType="text" id="Region" name="Region"></w2:column>
    					<w2:column dataType="text" id="Frequency" name="Frequency"></w2:column>
    					<w2:column dataType="text" id="ID" name="ID"></w2:column>
    					<w2:column dataType="text" id="Age" name="Age"></w2:column>
    				</w2:columnInfo>
    			</w2:dataList>
    		</w2:dataCollection>
    		<w2:workflowCollection></w2:workflowCollection>
    	</xf:model>
    	<script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function () {
};

scwin.onpageunload = function () {

};

scwin.trigger1_onclick = function (e) {
    var options = {
        wframe: true,
        name: "Upload Your Excel",
        features: "top=50,left=300,width=500,height=200",
        className: "border",
        resizable: true,
        windowDragMove: false
    };
    gridView1.advancedExcelUpload(options);

};
]]></script>
    	<style type="text/css"><![CDATA[.border{border-width:3px;border-color:blue;border-style:solid;}]]></style>
    </head>
    <body ev:onpageload="scwin.onpageload" ev:onpageunload="scwin.onpageunload">
    	<xf:group id="" style="margin: 10px;">
    		<w2:textbox tagname="h1" style="color: blue;margin-bottom: 10px;" tabIndex="h1" id="textbox1" label="Excel 업로드 창 커스터마이징"
    			escape="false">
    		</w2:textbox>
    		<w2:textbox tagname="h2" style="height: 23px;margin-bottom: 10px;color: blue;" id="textbox2" label="샘플 사용 방법"></w2:textbox>
    		<w2:textbox style="color: blue;margin-bottom: 30px;" id="textbox3"
    			label='1. 하단의 advancedExcelUpload() 버튼을 클릭.&lt;br/&gt;2. options 설정에 따라 업로드 창이 표시되는지 확인. &lt;br/&gt;(상세한 스크립트는 Script 탭에서 확인.)'
    			escape="false">
    		</w2:textbox>
    		<xf:trigger ev:onclick="scwin.trigger1_onclick"
    			style="height:42px;line-height:32px;padding:5px;background-color:coral;font-size:15px;weight: bolder;font-weight:bolder;text-align: left;margin-bottom: 10px;"
    			id="trigger1" type="button">
    			<xf:label><![CDATA[advancedExcelUpload(options)]]></xf:label>
    		</xf:trigger>
    		<w2:gridView autoFit="allColumn" checkAllType="false" dataList="data:dataList1" defaultCellHeight="20" id="gridView1"
    			rowNumVisible="true" scrollByColumn="false" scrollByColumnAdaptive="false" style="border: solid gray 1px;margin-bottom: 10px;" visibleRowNum="10"
    			sortable="true" visibleRowNumFix="true">
    			<w2:caption style="" id="caption1" value="this is a grid caption."></w2:caption>
    			<w2:header style="" id="header1">
    				<w2:row style="" id="row1">
    					<w2:column width="70" inputType="text" style="" id="column9" value="Status" displayMode="label"></w2:column>
    					<w2:column width="70" inputType="text" style="" id="column8" value="Date" displayMode="label"></w2:column>
    					<w2:column width="70" inputType="text" style="" id="column7" value="Expense" displayMode="label"></w2:column>
    					<w2:column width="70" inputType="text" style="" id="column6" value="Income" displayMode="label"></w2:column>
    					<w2:column width="70" inputType="text" style="" id="column5" value="Hobby" displayMode="label"></w2:column>
    					<w2:column width="70" inputType="text" style="" id="column4" value="Region" displayMode="label"></w2:column>
    					<w2:column width="70" inputType="text" style="" id="column3" value="Frequency" displayMode="label"></w2:column>
    					<w2:column width="70" inputType="text" style="" id="column2" value="ID" displayMode="label"></w2:column>
    					<w2:column width="70" inputType="text" style="" id="column1" value="Age" displayMode="label"></w2:column>
    				</w2:row>
    			</w2:header>
    			<w2:gBody style="" id="gBody1">
    				<w2:row style="" id="row2">
    					<w2:column width="70" inputType="text" style="" id="Status" value="" displayMode="label"></w2:column>
    					<w2:column width="70" inputType="text" style="" id="Date" value="" displayMode="label"></w2:column>
    					<w2:column width="70" inputType="text" style="" id="Expense" value="" displayMode="label"></w2:column>
    					<w2:column width="70" inputType="text" style="" id="Income" value="" displayMode="label"></w2:column>
    					<w2:column width="70" inputType="text" style="" id="Hobby" value="" displayMode="label"></w2:column>
    					<w2:column width="70" inputType="text" style="" id="Region" value="" displayMode="label"></w2:column>
    					<w2:column width="70" inputType="text" style="" id="Frequency" value="" displayMode="label"></w2:column>
    					<w2:column width="70" inputType="text" style="" id="ID" value="" displayMode="label"></w2:column>
    					<w2:column width="70" inputType="text" style="" id="Age" value="" displayMode="label"></w2:column>
    				</w2:row>
    			</w2:gBody>
    		</w2:gridView>
    		<w2:textbox escape="false" id="textbox4"
    			label='/// 샘플 코드 &lt;br/&gt;&lt;br/&gt; var options = {&lt;br/&gt; &amp;nbsp; &amp;nbsp; wframe: true,&lt;br/&gt; &amp;nbsp; &amp;nbsp; name: "Upload Your Excel",&lt;br/&gt; &amp;nbsp; &amp;nbsp; features: "top=50,left=300,width=500,height=200",&lt;br/&gt; &amp;nbsp; &amp;nbsp; className: "border",&lt;br/&gt; &amp;nbsp; &amp;nbsp; resizable: true,&lt;br/&gt; &amp;nbsp; &amp;nbsp; windowDragMove: false&lt;br/&gt; };&lt;br/&gt; gridView1.advancedExcelUpload(options);'
    			style="padding:10px; padding-bottom:20px; text-align:left; font-size:15px; font-weight:bolder; border:brown 1px solid; background-color:ivory; margin-bottom:10px; color:brown;"
    			tagname="">
    		</w2:textbox>
    	</xf:group>
    </body>
</html>
