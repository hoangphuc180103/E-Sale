<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head meta_screenName="guide_sample">
        <w2:type>COMPONENT</w2:type>
        <w2:buildDate/>
        <w2:MSA/>
        <xf:model>
            <w2:dataCollection baseNode="map"/>
            <w2:workflowCollection/>
        </xf:model>
        <w2:mfeSubmission/>
        <w2:layoutInfo/>
        <w2:publicInfo method=""/>
        <script lazy="false" type="text/javascript"><![CDATA[
scwin.onpageload = function () {

};

scwin.trigger1_onclick = function (e) {
    autoComplete1.setValue("09")

};

scwin.trigger2_onclick = function (e) {
    autoComplete2.setValue("10")

};

scwin.trigger3_onclick = function (e) {
    autoComplete3.setValue("11");
    var index = autoComplete3.getSelectedIndex();
    var value = autoComplete3.getValue();
    alert("index : " + index + " & value : " + value);

};

scwin.trigger4_onclick = function (e) {
    autoComplete4.setValue("12");
};

]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload">
    <xf:group id="" style="margin:10px;"><w2:textbox tagname="h1" style="color: blue;margin-bottom: 10px;" id="textbox1" label="リストにない値の処理" escape="false">
    	</w2:textbox><w2:textbox tagname="h2" style="height: 23px;margin-bottom: 10px;color: blue;" id="textbox2" label="サンプルの使い方"></w2:textbox><w2:textbox style="color: blue;margin-bottom: 30px;" id="textbox3" label='1. 各 AutoComplete の選択項目を確認します。 &lt;br/&gt;2. 各AutoCompleteの下部にあるボタンをクリックして、現在リストにない値を設定します。 &lt;br/&gt;&lt;br/&gt;（最初の AutoComplete） &lt;br/&gt;3. 空の値が表示されることを確認してください。 &lt;br/&gt;&lt;br/&gt;（2 番目の AutoComplete） &lt;br/&gt;4. 既存のリストの最初の項目が選択されていることを確認してください。 &lt;br/&gt;&lt;br/&gt;（3番目のAutoComplete） &lt;br/&gt;5-1. 設定した値が項目と表示され、対応する項目のインデックスは「-1」で、設定した値をgetValue()メソッドで返すことができることを確認してください。&lt;br/&gt;5-2. リストから別の値を選択します。 &lt;br/&gt;5-3. リストを再度展開して、setValue()メソッドで選択した項目が消えたことを確認してください。 &lt;br/&gt;&lt;br/&gt;（4番目のAutoComplete）&lt;br/&gt;6-1. 設定した値がリストに追加されて表示されることを確認。 &lt;br/&gt;6-2. リストから別の値を選択します。 &lt;br/&gt;6-3. リストを再度展開して、 setValue() メソッドで設定した項目がリストに残っていることを確認します。 &lt;br/&gt;' escape="false">
    	</w2:textbox><w2:textbox style="padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightblue;border:none;margin-bottom: 10px;" id="textbox4" label='プロパティの設定&lt;br/&gt;valueNotInList="default"&lt;br/&gt;emptyItem="true"' escape="false">
    	</w2:textbox><xf:trigger ev:onclick="scwin.trigger1_onclick" style="height:42px; line-height:32px; padding:5px; background-color:coral; font-size:15px; weight:bolder; font-weight:bolder; text-align:left; display:block; margin-bottom:10px;" id="trigger1" type="button">
    		<xf:label><![CDATA[autoComplete1.setValue("09");]]></xf:label>
    	</xf:trigger><w2:autoComplete valueNotInList="default" submenuSize="auto" caseSensitive="true" chooseOption="" useKeywordHighlight="true" ev:onselected="" allOption="" ref="" search="contain" editType="select" style="width: 50%;display: block;margin-bottom: 10px;" id="autoComplete1" ev:onitemclick="" useLocale="false" emptyItem="true" emptyIndex="3" displayMode="value delim label">
    		<w2:choices>
    			<w2:item>
    				<w2:label><![CDATA[Seoul]]></w2:label>
    				<w2:value><![CDATA[01]]></w2:value>
    			</w2:item>
