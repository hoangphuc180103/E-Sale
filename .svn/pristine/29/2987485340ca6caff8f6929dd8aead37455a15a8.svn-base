    	</w2:textbox><xf:trigger ev:onclick="scwin.trigger3_onclick" style="height:42px; line-height:32px; padding:5px; background-color:coral; font-size:15px; weight:bolder; font-weight:bolder; text-align:left; display:block; margin-bottom:10px;" id="trigger3" type="button">
    		<xf:label><![CDATA[autoComplete3.setValue("11");]]></xf:label>
