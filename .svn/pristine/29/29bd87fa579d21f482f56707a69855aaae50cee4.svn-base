<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            	<w2:dataList baseNode="list" repeatNode="map" id="dataList1" saveRemovedData="true">
            		<w2:columnInfo>
            			<w2:column id="col1" name="name1" dataType="text"></w2:column>
            			<w2:column id="col2" name="name2" dataType="text"></w2:column>
            			<w2:column id="col3" name="name3" dataType="text"></w2:column>
            		</w2:columnInfo>
            	</w2:dataList>
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
         <script type="text/javascript" lazy="false"><![CDATA[
	scwin.onpageload = function() {
		var select = [{
			"col1" : "Asia",
			"col2" : "Asia",
			"col3" : "1"
		}, {
			"col1" : "Korea",
			"col2" : "Korea",
			"col3" : "2"
		}, {
			"col1" : "Seoul",
			"col2" : "Seoul",
			"col3" : "3"
		}, {
			"col1" : "Busan",
			"col2" : "Busan",
			"col3" : "3"
		}, {
			"col1" : "Thailand",
			"col2" : "Thailand",
			"col3" : "2"
		}, {
			"col1" : "Bangkok",
			"col2" : "Bangkok",
			"col3" : "3"
		}, {
			"col1" : "Chiang Mai",
			"col2" : "Chiang Mai",
			"col3" : "3"
		}, {
			"col1" : "Europe",
			"col2" : "Europe",
			"depth" : "1"
		}, {
			"col1" : "France",
			"col2" : "France",
			"col3" : "2"
		}, {
			"col1" : "Paris",
			"col2" : "Paris",
			"col3" : "3"
		}, {
			"col1" : "Lyon",
			"col2" : "Lyon",
			"col3" : "3"
		}, {
			"col1" : "Spain",
			"col2" : "Spain",
			"col3" : "2"
		}, {
			"col1" : "Madrid",
			"col2" : "Madrid",
			"col3" : "3"
		}, {
			"col1" : "Barcelona",
			"col2" : "Barcelona",
			"col3" : "3"
		}];
		dataList1.setJSON(select);
	};

	scwin.onpageunload = function() {

	};
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload" ev:onpageunload="scwin.onpageunload">
    <xf:group id="" style="margin: 10px;"><w2:textbox tagname="h1" style="color: blue;margin-bottom: 10px;" tabIndex="h1" id="textbox1" label="階層の選択項目を親と一緒に表示" escape="false"></w2:textbox><w2:textbox tagname="h2" style="height: 23px;margin-bottom: 10px;color: blue;" id="textbox2" label="サンプルの使い方"></w2:textbox><w2:textbox style="color: blue;margin-bottom: 30px;" id="textbox3" label='1. SelectBoxで項目を選択します。 &lt;br/&gt;2.親を持つ子項目を選択します。 &lt;br/&gt;3.親も一緒に表示されることを確認。' escape="false">
    	</w2:textbox><w2:textbox style="padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightblue;border:none;margin-bottom: 10px;" id="textbox4" label='プロパティの設定&lt;br/&gt;depthColumnShowPath="true" &lt;br/&gt;depthColumnPathDelimiter=" / "' escape="false">
    	</w2:textbox><xf:select1 submenuSize="auto" chooseOption="" allOption="" depthColumn="col3" ref="" appearance="minimal" depthColumnShowPath="true" disabledClass="w2selectbox_disabled" depthColumnPathDelimiter=" / " style="width: 50%" disabled="false" id="select1" direction="auto">
    		<xf:choices>
    			<xf:itemset nodeset="data:dataList1">
    				<xf:label ref="col1"></xf:label>
    				<xf:value ref="col2"></xf:value>
    			</xf:itemset>
    		</xf:choices>
    	</xf:select1></xf:group></body>
</html>
