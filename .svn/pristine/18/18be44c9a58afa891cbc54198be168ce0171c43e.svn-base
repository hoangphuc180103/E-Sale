scwin.onpageunload = function () {};
scwin.getfolderPath = function () {
  var currentPath = window.location.href;
  var folderPath;
  if (currentPath.includes("mainContainer")) {
    console.log("true  ===> " + $p.getFrameId());
    const cmtFrame = $p.getComponentById($p.getFrameId());
    currentPath = cmtFrame.getSrc();
    folderPath = currentPath.substring(0, currentPath.lastIndexOf('/'));
  } else {
    console.log("false  ===> ");
    folderPath = currentPath.split('w2xPath=')[1].substring(0, currentPath.split('w2xPath=')[1].lastIndexOf('/'));
  }
  return folderPath;
};
}}}]}]},{T:1,N:'body',A:{'ev:onpageload':'scwin.onpageload','ev:onpageunload':'scwin.onpageunload'},E:[{T:1,N:'xf:group',A:{id:'',style:'margin: 10px;'},E:[{T:1,N:'w2:textbox',A:{tagname:'h1',style:'color: blue;margin-bottom: 10px;',tabIndex:'h1',id:'textbox1',label:'Show Submission Status Window within the WFrame (Custom)<br/>',escape:'false'}},{T:1,N:'w2:textbox',A:{tagname:'h2',style:'height: 23px;margin-bottom: 10px;color: blue;',id:'textbox2',label:'How to Use'}},{T:1,N:'w2:textbox',A:{style:'color: blue;margin-bottom: 30px;',id:'textbox3',label:'(First WFrame)<br/>1-1. Click the internal Submit button.<br/>1-2. Confirm that the file specified as the processMsgFrameURL in the client.config.xml configuration file is displayed only within the WFrame. (processMsgFrame=“true”)<br/><br/>(Second WFrame)<br/>2-1. Click the Submit button inside.<br/>2-2. Confirm that the file specified by the processMsgFrameURL entry in the client.config.xml configuration file is displayed in full screen. (processMsgFrame=“false”)',escape:'false'}},{T:1,N:'w2:textbox',A:{style:'padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightpink;border:none;margin-bottom: 10px;',id:'textbox4',label:'Client Configuration (client.config.xml)<br/>processMsgFrameURL value="processMsg_new.xml"',escape:'false'}},{T:1,N:'w2:textbox',A:{style:'padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightblue;border:none;margin-bottom: 10px;',id:'textbox5',label:'processMsgFrame="true"',escape:'false'}},{T:1,N:'w2:wframe',A:{scope:'true',style:'border: solid 1px gray;margin-bottom: 10px;',id:'wframe1',processMsgFrame:'true'}},{T:1,N:'w2:textbox',A:{style:'padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightblue;border:none;margin-bottom: 10px;',id:'textbox6',label:'processMsgFrame="false"',escape:'false'}},{T:1,N:'w2:wframe',A:{id:'wframe2',processMsgFrame:'false',scope:'true',style:'border: solid 1px gray;margin-b