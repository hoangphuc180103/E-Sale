scwin.btn_resetData_onclick = function (e) {
  // DataList 'dlt_exam'의 값을 복원합니다.
  dlt_exam.undoAll();
  // DataList 'dlt_exam'에 적용된 정렬을 제거합니다.
  dlt_exam.removeColumnFilterAll();
};

/**
