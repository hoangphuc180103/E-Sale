 */
scwin.btn_exam1_1_onclick = function (e) {
  // DataList 'dlt_exam'의 첫 번째 행의 'B' 컬럼의 셀을 변경합니다.
  dlt_exam.setCellData(0, "col_b", "B999");
};

/**
 * 버튼 [DataList의 'A' 컬럼을 내림차순으로 정렬하기] 클릭 시
