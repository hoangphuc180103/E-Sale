<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
         <script type="text/javascript" lazy="false"><![CDATA[
        
	scwin.onpageload = function() {
		
	};
	
	scwin.onpageunload = function() {
		
	};
	
	
	scwin.group1_onmouseleave = function(e) {
		alert("onmouseleave - Mouse LEAVING the Group component.");
	};
	
	scwin.group1_onmouseenter = function(e) {
		alert("onmouseenter - Mouse ENTERING the Group component.");		
	};
	]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload" ev:onpageunload="scwin.onpageunload">
    <xf:group id="" style="margin: 10px;"><w2:textbox tagname="h1" style="color: blue;margin-bottom: 10px;" tabIndex="h1" id="textbox1" label="이벤트 - onmouseenter &amp; onmouseleave" escape="false"></w2:textbox><w2:textbox tagname="h2" style="height: 23px;margin-bottom: 10px;color: blue;" id="textbox2" label="샘플 사용 방법"></w2:textbox><w2:textbox style="color: blue;margin-bottom: 30px;" id="textbox3" label='1. 마우스 커서를 Group 내부로 이동. &lt;br/&gt;2. onmouseenter 이벤트가 발생하는 것을 확인. &lt;br/&gt;3. 마우스 커서를 Group 외부로 이동. &lt;br/&gt;4. onmouseleave 이벤트가 발생하는 것을 확인. ' escape="false">
    	</w2:textbox><w2:textbox style="padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightgreen;border:none;margin-bottom: 10px;" id="textbox4" label="이벤트 &lt;br/&gt;onmouseenter - 마우스가 Group 컴포넌트 내부로 들어올 때 발생. &lt;br/&gt;onmouseleave - 마우스가 Group 컴포넌트 외부로 나갈 때 발생.&lt;br/&gt;" escape="false">
    	</w2:textbox><xf:group ev:onmouseenter="scwin.group1_onmouseenter" tagname="" ev:onmouseleave="scwin.group1_onmouseleave" style="padding: 20px;border: solid teal 2px;font-size: 30px;color: teal;" id="group1" text="Group">
    	</xf:group></xf:group></body>
</html>
