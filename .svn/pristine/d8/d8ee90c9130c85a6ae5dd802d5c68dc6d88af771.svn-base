<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
        <style>
        	.test{
				text-overflow:ellipsis;
			}
			.test2{
				background-color:red;
			}

        	table {
				table-layout:fixed;
			}

			table td {
				width:30px;
				overflow: hidden;
				text-overflow: ellipsis;
			}
		</style>
         <script type="text/javascript" lazy="false"><![CDATA[
        
	scwin.onpageload = function() {
		
	};
	
	scwin.onpageunload = function() {
		
	};
	
	scwin.tooltip = function(label, index) {
		return "Select " + label + ".";
	};
	
	]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload" ev:onpageunload="scwin.onpageunload">
    <xf:group id="" style="margin: 10px;">
    	<w2:textbox tagname="h1" style="color: blue;margin-bottom: 10px;" tabIndex="h1" id="textbox1" label="ツールチップを表示" escape="false"></w2:textbox>
    	<w2:textbox tagname="h2" style="height: 23px;margin-bottom: 10px;color: blue;" id="textbox2" label="サンプルの使い方"></w2:textbox>
    	<w2:textbox style="color: blue;margin-bottom: 30px;" id="textbox3"
    		label='1. Radioの各項目にマウスカーソルを置きます。 &lt;br/&gt;2. tooltipFormatterプロパティ値で指定された関数によって返された値がツールチップとして表示されることを確認してください。' escape="false">
    	</w2:textbox>
    	<w2:textbox
    		style="padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightblue;border:none;margin-bottom: 10px;"
    		id="textbox4"
    		label='プロパティの設定&lt;br/&gt;tooltipDisplay="true" &lt;br/&gt;tooltipShowAlways="true" &lt;br/&gt;tooltipFormatter="scwin.tooltip"'
    		escape="false">
    	</w2:textbox>
    	<w2:textbox style="padding:10px; padding-bottom:20px; text-align:left; font-size:15px; font-weight:bolder; border:brown 1px solid; background-color:ivory; margin-bottom:10px; margin-top:10px; color:brown;" id="textbox5" label='/// サンプルコード&lt;br/&gt;&lt;br/&gt;scwin.tooltip = function(label, index) {&lt;br/&gt; &amp;nbsp; &amp;nbsp;return "Select " + label + ".";&lt;br/&gt;};' escape="false">
    	</w2:textbox>
    	<xf:select1 tooltipFormatter="scwin.tooltip" tooltipShowAlways="true" tooltipClass="" tooltipItemLabel="" selectedindex="-1" rows=""
    		ref="" appearance="full" tooltipDisplay="true" style="width: 150px;" id="radio1" cols="1" class="">
    		<xf:choices>
    			<xf:item>
    				<xf:label><![CDATA[yourChoice111]]></xf:label>
    				<xf:value><![CDATA[001]]></xf:value>
    			</xf:item>
    			<xf:item>
    				<xf:label><![CDATA[Item2]]></xf:label>
    				<xf:value><![CDATA[002]]></xf:value>
    			</xf:item>
    			<xf:item>
    				<xf:label><![CDATA[Item3]]></xf:label>
    				<xf:value><![CDATA[003]]></xf:value>
    			</xf:item>
    			<xf:item>
    				<xf:label><![CDATA[yourChoice444]]></xf:label>
    				<xf:value><![CDATA[004]]></xf:value>
    			</xf:item>
    		</xf:choices>
    	</xf:select1>
    </xf:group></body>
</html>
