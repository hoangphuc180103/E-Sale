define({declaration:{A:{version:'1.0',encoding:'UTF-8'}},E:[{T:1,N:'html',A:{xmlns:'http://www.w3.org/1999/xhtml','xmlns:ev':'http://www.w3.org/2001/xml-events','xmlns:w2':'http://www.inswave.com/websquare','xmlns:xf':'http://www.w3.org/2002/xforms'},E:[{T:1,N:'head',E:[{T:1,N:'w2:type',E:[{T:3,text:'DEFAULT'}]},{T:1,N:'w2:buildDate'},{T:1,N:'xf:model',E:[{T:1,N:'w2:dataCollection',A:{baseNode:'map'}},{T:1,N:'w2:workflowCollection'}]},{T:1,N:'script',A:{type:'text/javascript',lazy:'false'},E:[{T:4,cdata:function(scopeObj){with(scopeObj){scwin.onpageload = function () {
  var tmpSrc = scwin.getfolderPath() + "/tabs_added.xml";
  var tabOptions = {};
  for (var i = 0; i < 12; i++) {
    var addCount = i + 1;
    var tabOptions = {
      label: "Tab " + addCount,
      openAction: "new",
      closable: "true"
    };
    var contentsOptions = {
      frameMode: "wframe",
      alwaysDraw: false,
      src: tmpSrc
    };
    tabControl1.addTab(i, tabOptions, contentsOptions);
    tabControl2.addTab(i, tabOptions, contentsOptions);
  }
};
scwin.onpageunload = function () {};
scwin.getfolderPath = function () {
  var currentPath = window.location.href;
  var folderPath;
  if (currentPath.includes("mainContainer")) {
    console.log("true  ===> " + $p.getFrameId());
    const cmtFrame = $p.getComponentById($p.getFrameId());
    currentPath = cmtFrame.getSrc();
    folderPath = currentPath.substring(0, currentPath.lastIndexOf('/'));
  } else {
    console.log("false  ===> ");
    folderPath = currentPath.split('w2xPath=')[1].substring(0, currentPath.split('w2xPath=')[1].lastIndexOf('/'));
  }
  return folderPath;
};
}}}]}]},{T:1,N:'body',A:{'ev:onpageload':'scwin.onpageload','ev:onpageunload':'scwin.onpageunload'},E:[{T:1,N:'xf:group',A:{id:'',style:'margin: 10px;'},E:[{T:1,N:'w2:textbox',A:{tagname:'h1',style:'margin-bottom: 10px;color: blue;',id:'textbox1',label:'Maintain Number of Visible Tabs on Scroll when Closing a Tab<br/>',escape:'false'}},{T:1,N:'w2:textbox',A:{tagname:'h2',style:'height: 23px;margin-bottom: 10px;color: blue;',id:'textbox2',label:'How to Use'}},{T:1,N:'w2:textbox',A:{style:'color: blue;margin-bottom: 30px;',id:'textbox3',label:'1-1. Select the last tab in the first TabControl.<br/>1-2. Close the selected last tab.<br/>1-3. Confirm that the number of tabs displayed in the scroll bar remains unchanged. (tabScrollAuto=“true”)<br/><br/>2-1. Select the last tab in the second TabControl.<br/>2-2. Close the selected last tab.<br/>2-3. Confirm that the number of tabs displayed in the scrollbar decreases instead of remaining constant. (tabScrollAuto=“false”)',escape:'false'}},{T:1,N:'w2:textbox',A:{style:'padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightblue;border:none;margin-bottom: 10px;',id:'textbox4',label:'tabScrollAuto="true"',escape:'false'}},{T:1,N:'w2:tabControl',A:{confirmTrueAction:'exist',useTabKeyOnly:'true',confirmFalseAction:'new',useMoveNextTabFocus:'false',tabScroll:'true',tabScrollAuto:'true',useConfirmMessage:'false',alwaysDraw:'false',style:'border: gray solid 1px;height: 200px;margin-bottom: 10px;',id:'tabControl1',changeActiveTab:'true'}},{T:1,N:'w2:textbox',A:{escape:'false',id:'textbox5',label:'tabScrollAuto="false"',style:'padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightblue;border:none;margin-bottom: 10px;'}},{T:1,N:'w2:tabControl',A:{alwaysDraw:'false',changeActiveTab:'true',confirmFalseAction:'new',confirmTrueAction:'exist',id:'tabControl2',style:'border: gray solid 1px;height: 200px;',tabScroll:'true',useConfirmMessage:'false',useMoveNextTabFocus:'false',useTabKeyOnly:'true'}}]}]}]}]})