<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare"
	xmlns:xf="http://www.w3.org/2002/xforms">
	<head meta_author="InswaveSystems" meta_type="메인" meta_vertical_guides="" meta_horizontal_guides="-298" meta_screenName="[Input] 마스킹하는 방법 및 마스킹 방향 설정하기">
		<w2:historyInfo>
			<w2:history meta_no="01" meta_desc="최초작성" meta_date="20230307" meta_user="InswaveSystems" ></w2:history>
			<w2:history meta_no="02" meta_desc="설명부 수정" meta_date="20240621" meta_user="InswaveSystems" ></w2:history>
		</w2:historyInfo>
		<w2:type>COMPONENT</w2:type>
		<w2:buildDate />
		<w2:MSA />
		<xf:model>
			<w2:dataCollection baseNode="map">
			</w2:dataCollection>
			<w2:workflowCollection />
		</xf:model>
		<w2:layoutInfo />
		<w2:publicInfo method="" />
		<script lazy="false" type="text/javascript"><![CDATA[
scwin.onpageload = function () {

};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:group class="sub_contents" id="" style="">
			<xf:group class="ws_example_grp_desc" id="" style="">
				<w2:textbox escape="false" id="" label="Input에 숫자 또는 영문을 입력하면 '#-##-###' 형식으로 마스크를 설정하고, 마스크의 방향을 지정한 예제입니다." style=""></w2:textbox>
			</xf:group>
			<xf:group class="example_div_tb_style_wrap" id="">
				<xf:group class="example_div_tr_style" id="" style="">
					<w2:textbox class="example_div_th_style" escape="false" id="" label="(기본 설정) 마스크를 왼쪽에서 오른쪽 방향으로 적용" style=""></w2:textbox>
					<xf:group class="example_div_td_style" id="" style="">
						<xf:input class="" id="ibx_exam1" style="min-width:120px;" displayFormatter="" displayFormat="#-##-###" applyFormat="all"
							maskFormat="default" allowChar="0-9aA-zZ" dataType="text" placeholder="입력 예시) 123abc">
						</xf:input>
					</xf:group>
					<w2:textbox class="example_div_th_style" escape="false" id="" label="마스킹 역방향 설정하기" style=""></w2:textbox>
					<xf:group class="example_div_td_style" id="" style="">
						<xf:input class="" id="ibx_exam2" style="min-width:120px;" displayFormatter="" displayFormat="#-##-###" applyFormat="all"
							maskFormat="reverse" allowChar="0-9aA-zZ" dataType="text" placeholder="입력 예시) 123abc">
						</xf:input>
					</xf:group>
				</xf:group>
				<xf:group class="example_div_tr_style" id="" style="">
				</xf:group>
			</xf:group>
		</xf:group>
	</body>
</html>