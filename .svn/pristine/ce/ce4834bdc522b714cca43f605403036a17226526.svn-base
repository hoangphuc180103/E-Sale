define({declaration:{A:{version:'1.0',encoding:'UTF-8'}},E:[{T:1,N:'html',A:{xmlns:'http://www.w3.org/1999/xhtml','xmlns:ev':'http://www.w3.org/2001/xml-events','xmlns:w2':'http://www.inswave.com/websquare','xmlns:xf':'http://www.w3.org/2002/xforms'},E:[{T:1,N:'head',E:[{T:1,N:'w2:type',E:[{T:3,text:'DEFAULT'}]},{T:1,N:'w2:buildDate'},{T:1,N:'xf:model',E:[{T:1,N:'w2:dataCollection',A:{baseNode:'map'}},{T:1,N:'w2:workflowCollection'}]},{T:1,N:'script',A:{type:'text/javascript',lazy:'false'},E:[{T:4,cdata:function(scopeObj){with(scopeObj){scwin.onpageload = function () {
  input1.setValue("test");
};
scwin.onpageunload = function () {};
scwin.trigger1_onclick = function (e) {
  var status = input1.getMandatory();
  alert(status);
};
scwin.trigger2_onclick = function (e) {
  input1.setMandatory(true);
  input1.setValue("test");
  alert('Set mandatory property as "true"');
};
scwin.input1_onchange = function (e) {
  input1.validate();
};
}}}]}]},{T:1,N:'body',A:{'ev:onpageload':'scwin.onpageload','ev:onpageunload':'scwin.onpageunload'},E:[{T:1,N:'xf:group',A:{id:'',style:'margin: 10px;'},E:[{T:1,N:'w2:textbox',A:{style:'color: blue;margin-bottom: 10px;',id:'textbox1',label:'필수 입력 (mandatory) 설정 및 확인',escape:'false',tagname:'h1'}},{T:1,N:'w2:textbox',A:{tagname:'h2',style:'height: 23px;margin-bottom: 10px;color: blue;',id:'textbox3',label:'샘플 사용 방법'}},{T:1,N:'w2:textbox',A:{style:'color: blue;margin-bottom: 30px;',id:'textbox2',label:'1. getMandatory() 버튼을 클릭하여 현재 mandatory 속성 값이 "false"인 것을 확인. <br/>2. InputBox에서 텍스트를 삭제하고 Enter 키를 선택. <br/>3. 검증 실패 메시지가 표시되지 않는 것을 확인. <br/>4. setMandatory() 버튼을 클릭하여 mandatory 속성 값을 "true"로 설정. <br/>5. InputBox에서 텍스트를 삭제하고 Enter 키를 선택. <br/>6. 검증 실패 메시지가 표시되는 것을 확인.',escape:'false'}},{T:1,N:'xf:input',A:{'ev:onchange':'scwin.input1_onchange',adjustMaxLength:'false',style:'width: 300px;text-align: right;height:50px;padding: 5px;font-size:30px;font-style:normal;font-weight:bolder;color: red;margin-bottom: 10px;',id:'input1',displaymessage:'true',invalidMessage:'Required field.'}},{T:1,N:'xf:trigger',A:{'ev:onclick':'scwin.trigger1_onclick',style:'display: block;height:42px;line-height:32px;padding:5px;background-color:coral;font-size:15px;weight: bolder;font-weight:bolder;margin-bottom:10px;text-align: left;',id:'trigger1',type:'button'},E:[{T:1,N:'xf:label',E:[{T:4,cdata:'getMandatory()'}]}]},{T:1,N:'xf:trigger',A:{'ev:onclick':'scwin.trigger2_onclick',style:'display: block;height:42px;line-height:32px;padding:5px;background-color:coral;font-size:15px;weight: bolder;font-weight:bolder;margin-bottom:10px;text-align: left;',id:'trigger2',type:'button'},E:[{T:1,N:'xf:label',E:[{T:4,cdata:'setMandatory()'}]}]},{T:1,N:'w2:textbox',A:{escape:'false',id:'textbox4',label:'/// 샘플 코드<br/><br/>scwin.trigger1_onclick = function (e) {<br/> &nbsp; &nbsp;var status = input1.getMandatory();<br/> &nbsp; &nbsp;alert(status);<br/>};<br/><br/>scwin.trigger2_onclick = function (e) {<br/> &nbsp; &nbsp;input1.setMandatory(true);<br/> &nbsp; &nbsp;input1.setValue("test");<br/> &nbsp; &nbsp;alert(\'Set mandatory property as "true"\');<br/>};<br/><br/>scwin.input1_onchange = function (e) {<br/> &nbsp; &nbsp;input1.validate();<br/>};',style:'padding:10px; padding-bottom:20px; text-align:left; font-size:15px; font-weight:bolder; border:brown 1px solid; background-color:ivory; margin-bottom:10px; margin-top:10px; color:brown;'}}]}]}]}]})