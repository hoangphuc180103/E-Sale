define({declaration:{A:{version:'1.0',encoding:'UTF-8'}},E:[{T:1,N:'html',A:{xmlns:'http://www.w3.org/1999/xhtml','xmlns:ev':'http://www.w3.org/2001/xml-events','xmlns:w2':'http://www.inswave.com/websquare','xmlns:xf':'http://www.w3.org/2002/xforms'},E:[{T:1,N:'head',A:{},E:[{T:1,N:'w2:historyInfo',E:[{T:1,N:'w2:history',A:{}}]},{T:1,N:'w2:type',E:[{T:3,text:'COMPONENT'}]},{T:1,N:'w2:buildDate'},{T:1,N:'w2:MSA'},{T:1,N:'xf:model',E:[{T:1,N:'w2:dataCollection',A:{baseNode:'map'},E:[{T:1,N:'w2:dataList',A:{baseNode:'list',id:'dc_code',repeatNode:'map',saveRemovedData:'true'},E:[{T:1,N:'w2:columnInfo',E:[{T:1,N:'w2:column',A:{id:'code_cd',name:'코드값',dataType:'text'}},{T:1,N:'w2:column',A:{id:'code_nm',name:'코드명',dataType:'text'}}]},{T:1,N:'w2:data',A:{use:'true'},E:[{T:1,N:'w2:row',E:[{T:1,N:'code_cd',E:[{T:4,cdata:'01'}]},{T:1,N:'code_nm',E:[{T:4,cdata:'개발자'}]}]},{T:1,N:'w2:row',E:[{T:1,N:'code_cd',E:[{T:4,cdata:'02'}]},{T:1,N:'code_nm',E:[{T:4,cdata:'설계자'}]}]},{T:1,N:'w2:row',E:[{T:1,N:'code_cd',E:[{T:4,cdata:'03'}]},{T:1,N:'code_nm',E:[{T:4,cdata:'DBA'}]}]},{T:1,N:'w2:row',E:[{T:1,N:'code_cd',E:[{T:4,cdata:'04'}]},{T:1,N:'code_nm',E:[{T:4,cdata:'PL'}]}]},{T:1,N:'w2:row',E:[{T:1,N:'code_cd',E:[{T:4,cdata:'05'}]},{T:1,N:'code_nm',E:[{T:4,cdata:'PM'}]}]}]}]},{T:1,N:'w2:dataMap',A:{baseNode:'map',id:'dc_reqUserInfo'},E:[{T:1,N:'w2:keyInfo',E:[{T:1,N:'w2:key',A:{id:'EMP_CD',name:'사용자 코드',dataType:'text'}}]}]},{T:1,N:'w2:dataMap',A:{baseNode:'map',id:'bbbbb'},E:[{T:1,N:'w2:keyInfo',E:[{T:1,N:'w2:key',A:{id:'EMP_CD',name:'사번',dataType:'text'}},{T:1,N:'w2:key',A:{id:'EMP_NM',name:'성명',dataType:'text'}},{T:1,N:'w2:key',A:{id:'GENDER_CD',name:'성별',dataType:'text'}},{T:1,N:'w2:key',A:{id:'JOIN_DATE',name:'입사일',dataType:'text'}},{T:1,N:'w2:key',A:{id:'POSITION_CD',name:'직급',dataType:'text'}},{T:1,N:'w2:key',A:{id:'DUTY_CD',name:'직책',dataType:'text'}},{T:1,N:'w2:key',A:{id:'ROLE_CD',name:'역할',dataType:'text'}},{T:1,N:'w2:key',A:{id:'ASSIGNED_TASK',name:'담당 업무',dataType:'text'}},{T:1,N:'w2:key',A:{id:'EMAIL',name:'이메일',dataType:'text'}},{T:1,N:'w2:key',A:{id:'ZIP_CD',name:'우편번호',dataType:'text'}},{T:1,N:'w2:key',A:{id:'ADDRESS1',name:'주소1',dataType:'text'}},{T:1,N:'w2:key',A:{id:'ADDRESS2',name:'주소2',dataType:'text'}},{T:1,N:'w2:key',A:{id:'CREATED_DATE',name:'입력일',dataType:'text'}},{T:1,N:'w2:key',A:{id:'UPDATED_DATE',name:'수정일',dataType:'text'}}]}]}]},{T:1,N:'w2:workflowCollection'},{T:1,N:'xf:submission',A:{id:'sub_select',ref:'data:json,dc_reqUserInfo',target:'data:json,{"id":"bbbbb","key":"dc_userInfo"}',action:'/edu/data/userInfo.json',method:'post',mediatype:'application/json',encoding:'UTF-8',instance:'',replace:'',errorHandler:'',customHandler:'',mode:'asynchronous',processMsg:'조회중입니다... ','ev:submit':'scwin.sub_select_submit','ev:submitdone':'scwin.sub_select_submitdone','ev:submiterror':'scwin.sub_select_submiterror',abortTrigger:''}}]},{T:1,N:'w2:layoutInfo'},{T:1,N:'w2:publicInfo',A:{method:''}},{T:1,N:'script',A:{lazy:'false',type:'text/javascript'},E:[{T:4,cdata:function(scopeObj){with(scopeObj){scwin.onpageload = function () {};
}}}]}]},{T:1,N:'body',A:{'ev:onpageload':'scwin.onpageload'},E:[{T:1,N:'xf:group',A:{style:'',id:'',class:'ws_example_grp_desc'},E:[{T:1,N:'xf:group',A:{tagname:'details',style:'',id:'',class:''},E:[{T:1,N:'w2:textbox',A:{tagname:'summary',style:'',id:'',label:'실습 목표',escape:'false'}},{T:1,N:'w2:textbox',A:{style:'',id:'',label:'1. 개요<br/>본 화면은 Editor 컴포넌트를 활용하는 실습 화면입니다. <br/>Editor 컴포넌트 : 웹에디터로 텍스트를 입력하고 편집할 수 있는 기능을 제공합니다.<br/> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; 이 컴포넌트는 일반적으로 웹사이트나 앱의 게시물 작성, 댓글 작성 등에 사용됩니다. <br/> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; 사용자는 텍스트를 입력하고 서식을 적용하며, 필요한 경우 이미지나 링크를 삽입할 수 있습니다<br/>',class:'',escape:'false'}}]},{T:1,N:'xf:group',A:{tagname:'details',style:'',id:'',class:''},E:[{T:1,N:'w2:textbox',A:{tagname:'summary',style:'',id:'',label:'실습 방법',escape:'false'}},{T:1,N:'w2:textbox',A:{style:'',id:'',label:'1. Design Kit 를 활용하여 Editor를 추가합니다.<br/>2. <b>[속성 활용]</b>Component View 에서 속성 Tab 에 아래와 같은 속성을 넣습니다.<br/> &nbsp; 1) <b>maxCharCount</b> : &nbsp;CKEditor에 입력 가능한 최대 글자수를 지정할 수 있습니다.<br/> &nbsp; 2) <b>placeholder</b> : 사용자가 어떤 정보를 입력해야 하고 어떤 액션을 취해야 하는지 입력필드에 표시되는 힌트 메시지를 입력할 수 있습니다.<br/> &nbsp; 3) <b>menubar</b> : &nbsp;editor의 toolbar의 종류<br/><br/>3. &nbsp;<b>[API 활용]</b>스크립트 작성 부분에 아래 API를 활용할 수 있습니다. <br/> &nbsp; 1) placeHolder 메세지를 동적으로 변경할 때에는 <b>[setPlaceHolder]</b> API를 활용합니다.<br/> &nbsp; &nbsp; &nbsp; ex) <b>ui_editor1.setPlaceholder("텍스트를 입력하세요 (API로 값넣기)"); </b><br/> &nbsp; 2) CKEditor에 동적으로 텍스트를 입력할 경우 <b>[setText]</b> API를 활용합니다. <br/> &nbsp; &nbsp; &nbsp; ex) <b> ui_editor1.setText("editor\\n setText(value) API."); </b><br/> &nbsp; 3) CKEditor에 입력된 텍스트를 반환할 경우 <b>[getInnerText]</b> API를 활용합니다. <br/> &nbsp; &nbsp; &nbsp; ex) &nbsp;<b>ui_editor1.getInnerText(); </b> &nbsp; &nbsp;',class:'',escape:'false'}}]}]}]}]}]})