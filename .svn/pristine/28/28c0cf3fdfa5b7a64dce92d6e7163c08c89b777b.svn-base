<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
         <script type="text/javascript" lazy="false"><![CDATA[
        
	scwin.onpageload = function() {
		
	};
	
	scwin.onpageunload = function() {
		
	};
	
	]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload" ev:onpageunload="scwin.onpageunload">
    <xf:group id="" style="margin: 10px;">
    	<w2:textbox tagname="h1" style="color: blue;margin-bottom: 10px;" tabIndex="h1" id="textbox1" label="달력 요일을 텍스트 또는 이미지로 표시"
    		escape="false">
    	</w2:textbox>
    	<w2:textbox tagname="h2" style="height: 23px;margin-bottom: 10px;color: blue;" id="textbox2" label="샘플 사용 방법"></w2:textbox>
    	<w2:textbox style="color: blue;margin-bottom: 30px;" id="textbox3"
    		label='(첫 번째 Calendar의 경우)&lt;br/&gt;마우스를 드래깅하여 "일월화수목금토" 요일 부분이 텍스트로 선택되는것을 확인. (dislayDayType="text")&lt;br/&gt;&lt;br/&gt;(두 번째 Calendar의 경우)&lt;br/&gt;마우스를 드래깅하여 요일 부분이 이미지로 표시되고 텍스트로 선택되지 않는 것을 확인. (dislayDayType="image")' escape="false">
    	</w2:textbox>
    	<w2:textbox
    		style="padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightblue;border:none;margin-bottom: 20px;"
    		id="textbox4" label='속성 설정&lt;br/&gt;displayDayType="text"' escape="false">
    	</w2:textbox>
    	<w2:calendar displayDayType="text" footerDiv="false" style="width: 100px;height: 100px;margin: 10px;" id="calendar1"
    		monthNames="Jan, Feb, Mar, Apr, May, Jun, Jul, Aug, Sep, Oct, Nov, Dec" yearSuffix="Y">
    	</w2:calendar>
    	<w2:textbox escape="false" id="textbox5" label='속성 설정&lt;br/&gt;displayDayType="image"'
    		style="padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightblue;border:none;margin-bottom: 20px;">
    	</w2:textbox>
    	<w2:calendar displayDayType="image" footerDiv="false" id="calendar2"
    		monthNames="Jan, Feb, Mar, Apr, May, Jun, Jul, Aug, Sep, Oct, Nov, Dec" style="width: 100px;height: 100px;margin: 10px;"
    		yearSuffix="Y">
    	</w2:calendar>
    </xf:group></body>
</html>
