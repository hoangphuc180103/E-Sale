scwin.trigger1_onclick = function (e) {
  var options = {
    sortIndex: [0, 1],
    closeGroup: true,
    groupbyHeader: [{
      inputType: "expression",
      expression: 'toggle() + depthStr() + "    [ " + count() + " Cases ]  "',
      align: "left",
      colSpan: "4"
    }],
    groupbyFooter: {
      depth_0: [{
        colSpan: "3",
        value: "Total",
        align: "right"
      }, {
        inputType: "expression",
        expression: 'SUM("col4")'
      }],
      depth_1: [{
        colSpan: "3",
        value: "Sub Total",
        align: "right"
      }, {
        inputType: "expression",
        expression: 'SUM("col4")'
      }]
    }
  };
  gridView1.groupby(options);
};
