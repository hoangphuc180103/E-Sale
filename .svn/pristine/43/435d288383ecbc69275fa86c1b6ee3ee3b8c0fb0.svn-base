<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            	<w2:dataList baseNode="list" id="dataList1" repeatNode="map" saveRemovedData="true" style="">
            		<w2:columnInfo>
            			<w2:column dataType="text" id="col1" name="Continent"></w2:column>
            			<w2:column dataType="text" id="col2" name="Country"></w2:column>
            			<w2:column dataType="text" id="col3" name="Item"></w2:column>
            			<w2:column dataType="number" id="col4" name="Quantity"></w2:column>
            		</w2:columnInfo>
            	</w2:dataList>
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
         <script type="text/javascript" lazy="false"><![CDATA[
        
	scwin.onpageload = function() {		
		var json = [
			{"col1" : "Asia", "col2" : "Korea", "col3" : "TV", "col4" : "400"},
			{"col1" : "Asia", "col2" : "Korea", "col3" : "Freezer", "col4" : "400"},
			{"col1" : "Asia", "col2" : "Korea", "col3" : "Washer", "col4" : "400"},
			{"col1" : "Asia", "col2" : "China", "col3" : "TV", "col4" : "400"},
			{"col1" : "Asia", "col2" : "China", "col3" : "Freezer", "col4" : "400"},
			{"col1" : "Asia", "col2" : "China", "col3" : "Washer", "col4" : "400"},
			{"col1" : "Asia", "col2" : "Japan", "col3" : "TV", "col4" : "823"},
			{"col1" : "Asia", "col2" : "Japan", "col3" : "Freezer", "col4" : "288"},
			{"col1" : "Asia", "col2" : "Japan", "col3" : "Washer", "col4" : "325"},
			{"col1" : "Europe", "col2" : "Germany", "col3" : "TV", "col4" : "823"},
			{"col1" : "Europe", "col2" : "Germany", "col3" : "Freezer", "col4" : "288"},
			{"col1" : "Europe", "col2" : "Germany", "col3" : "Washer", "col4" : "325"},
			{"col1" : "Europe", "col2" : "France", "col3" : "TV", "col4" : "823"},
			{"col1" : "Europe", "col2" : "France", "col3" : "Freezer", "col4" : "288"},
			{"col1" : "Europe", "col2" : "France", "col3" : "Washer", "col4" : "325"},
			{"col1" : "Europe", "col2" : "Denmark", "col3" : "TV", "col4" : "823"},
			{"col1" : "Europe", "col2" : "Denmark", "col3" : "Freezer", "col4" : "288"},
			{"col1" : "Europe", "col2" : "Denmark", "col3" : "Washer", "col4" : "325"},
			{"col1" : "Americas", "col2" : "Canada", "col3" : "TV", "col4" : "823"},
			{"col1" : "Americas", "col2" : "Canada", "col3" : "Freezer", "col4" : "288"},
			{"col1" : "Americas", "col2" : "Canada", "col3" : "Washer", "col4" : "325"},
			{"col1" : "Americas", "col2" : "USA", "col3" : "TV", "col4" : "823"},
			{"col1" : "Americas", "col2" : "USA", "col3" : "Freezer", "col4" : "288"},
			{"col1" : "Americas", "col2" : "USA", "col3" : "Washer", "col4" : "325"},
			{"col1" : "Americas", "col2" : "Mexico", "col3" : "TV", "col4" : "823"},
			{"col1" : "Americas", "col2" : "Mexico", "col3" : "Freezer", "col4" : "288"},
			{"col1" : "Americas", "col2" : "Mexico", "col3" : "Washer", "col4" : "325"}
			];
		dataList1.setJSON(json);
		
	};
	
	scwin.onpageunload = function() {
		
	};
	
	
	scwin.gridView1_ongroupby = function(options) {
				options.groupbyHeader = [{ inputType: 'expression', expression: 'toggle() + depthStr() + "    [ " + count() + " Cases ]  "', align: 'left', colSpan:4 }];								options.closeGroup = true,
				options.groupbyFooter = {
				depth_0 : [ {colSpan:3, value: "(1) Maximum Value", align: "right"}, { inputType: 'expression', expression:'MAX("col4")'} ],
				depth_1: [ {colSpan:3, value: "(2) Maximum Value", align: "right"}, { inputType: 'expression', expression:'MAX("col4")'} ],
				depth_2: [ {colSpan:3, value: "(3) Maximum Value", align: "right"}, { inputType: 'expression', expression:'MAX("col4")'} ]
				};								
				gridView1.groupby(options);
		
	};
	]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload" ev:onpageunload="scwin.onpageunload">
    <xf:group id="" style="margin: 10px;">
    	<w2:textbox tagname="h1" style="color: blue;margin-bottom: 10px;" tabIndex="h1" id="textbox1" label="Allow Grouping Made by User's Dragging Headers"
    		escape="false">
    	</w2:textbox>
    	<w2:textbox tagname="h2" style="height: 23px;margin-bottom: 10px;color: blue;" id="textbox2" label="How to Use"></w2:textbox>
    	<w2:textbox style="color: blue;margin-bottom: 30px;" id="textbox3"
    		label='1. Confirm that the grouping area appears at the top of the GridView. (groupbyZone=“true”)&lt;br/&gt;2. Confirm that data is grouped when the GridView header is dragged into the grouping area.&lt;br/&gt;3. Confirm the ongroupby event handler function in the Script tab, which performs the actual data grouping. &lt;br/&gt;'
    		escape="false">
    	</w2:textbox>
    	<w2:textbox
    		style="padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightblue;border:none;margin-bottom: 10px;"
    		id="textbox4" label='groupbyZone="true"' escape="false">
    	</w2:textbox>
    	<w2:textbox
    		style="padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightgreen;border:none;margin-bottom: 10px;"
    		id="textbox5" label='ongroupby' escape="false">
    	</w2:textbox>
    	<w2:gridView ev:ongroupby="scwin.gridView1_ongroupby" scrollByColumnAdaptive="false" groupbyZoneMessage="" groupbyZone="true"
    		checkAllType="false" dataList="data:dataList1" style="border: solid gray 1px;margin-bottom: 10px;" scrollByColumn="false" id="gridView1"
    		autoFit="allColumn" visibleRowNum="10" defaultCellHeight="20" visibleRowNumFix="true">
    		<w2:caption style="" id="caption1" value="this is a grid caption."></w2:caption>
    		<w2:header style="" id="header1">
    			<w2:row style="" id="row1">
    				<w2:column width="70" inputType="text" style="height:20px" id="column4" value="Continent" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="height:20px" id="column3" value="Country" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="height:20px" id="column2" value="Item" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="height:20px" id="column1" value="Quantity" displayMode="label"></w2:column>
    			</w2:row>
    		</w2:header>
    		<w2:gBody style="" id="gBody1">
    			<w2:row style="" id="row2">
    				<w2:column width="70" inputType="text" style="height:20px" id="col1" value="" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="height:20px" id="col2" value="" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="height:20px" id="col3" value="" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="height:20px" id="col4" value="" displayMode="label"></w2:column>
    			</w2:row>
    		</w2:gBody>
    	</w2:gridView>
    	<w2:textbox escape="false" id="textbox6"
    		label="/// Sample Code&lt;br/&gt;&lt;br/&gt;scwin.gridView1_ongroupby = function(options) {&lt;br/&gt; &amp;nbsp; &amp;nbsp;options.groupbyHeader = [{&lt;br/&gt; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;inputType: 'expression',&lt;br/&gt; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;expression: 'toggle() + depthStr() + &quot; &amp;nbsp; &amp;nbsp;[ &quot; + count() + &quot; Cases ] &amp;nbsp;&quot;',&lt;br/&gt; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;align: 'left',&lt;br/&gt; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;colSpan: 4&lt;br/&gt; &amp;nbsp; &amp;nbsp;}];&lt;br/&gt; &amp;nbsp; &amp;nbsp;options.closeGroup = true,&lt;br/&gt; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;options.groupbyFooter = {&lt;br/&gt; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;depth_0: [{&lt;br/&gt; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;colSpan: 3,&lt;br/&gt; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;value: &quot;(1) Maximum Value&quot;,&lt;br/&gt; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;align: &quot;right&quot;&lt;br/&gt; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;}, {&lt;br/&gt; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;inputType: 'expression',&lt;br/&gt; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;expression: 'MAX(&quot;col4&quot;)'&lt;br/&gt; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;}],&lt;br/&gt; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;depth_1: [{&lt;br/&gt; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;colSpan: 3,&lt;br/&gt; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;value: &quot;(2) Maximum Value&quot;,&lt;br/&gt; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;align: &quot;right&quot;&lt;br/&gt; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;}, {&lt;br/&gt; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;inputType: 'expression',&lt;br/&gt; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;expression: 'MAX(&quot;col4&quot;)'&lt;br/&gt; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;}],&lt;br/&gt; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;depth_2: [{&lt;br/&gt; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;colSpan: 3,&lt;br/&gt; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;value: &quot;(3) Maximum Value&quot;,&lt;br/&gt; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;align: &quot;right&quot;&lt;br/&gt; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;}, {&lt;br/&gt; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;inputType: 'expression',&lt;br/&gt; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;expression: 'MAX(&quot;col4&quot;)'&lt;br/&gt; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;}]&lt;br/&gt; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;};&lt;br/&gt; &amp;nbsp; &amp;nbsp;gridView1.groupby(options);&lt;br/&gt;&lt;br/&gt;};"
    		style="padding:10px; padding-bottom:20px; text-align:left; font-size:15px; font-weight:bolder; border:brown 1px solid; background-color:ivory; margin-bottom:10px; color:brown;"
    		tagname="">
    	</w2:textbox>
    </xf:group></body>
</html>
