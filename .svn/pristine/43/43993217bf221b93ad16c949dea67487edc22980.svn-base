<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head meta_screenName="guide_sample">
        <w2:type>COMPONENT</w2:type>
        <w2:buildDate/>
        <w2:MSA/>
        <xf:model>
            <w2:dataCollection baseNode="map">
            	<w2:dataList baseNode="list" repeatNode="map" id="dataList1">
            		<w2:columnInfo>
            			<w2:column id="col1" name="col1" dataType="text"></w2:column>
            			<w2:column id="col2" name="col2" dataType="text"></w2:column>
            			<w2:column id="col3" name="col3" dataType="text"></w2:column>
            			<w2:column id="col4" name="col4" dataType="text" initialColumnId="col1"></w2:column>
            			<w2:column id="col5" name="col5" dataType="text" initialColumnId="col2"></w2:column>
            		</w2:columnInfo>
            	</w2:dataList>
            </w2:dataCollection>
            <w2:workflowCollection/>
        </xf:model>
        <w2:mfeSubmission/>
        <w2:layoutInfo/>
        <w2:publicInfo method=""/>
        <script lazy="false" type="text/javascript"><![CDATA[
scwin.onpageload = function () {

};

scwin.trigger1_onclick = function (e) {
    dataList1.setJSON([{ "col1": "apricot", "col2": 1, "col3": 2 }], true);
};
scwin.trigger2_onclick = function (e) {
    dataList1.setData(["banana", 3, 4, "", ""], true);
};

scwin.trigger3_onclick = function (e) {
    dataList1.setArray({ "columnInfo": ["col1", "col2", "col3"], "data": ["cherry", 5, 6] }, true);
};

scwin.trigger4_onclick = function (e) {
    var tmpXMLStr = "";
    tmpXMLStr += "<list id=\"dataList1\">";
    tmpXMLStr += "<map index=\"0\">";
    tmpXMLStr += "<col1>grape</col1>";
    tmpXMLStr += "<col2>5</col2>";
    tmpXMLStr += "<col3>6</col3>";
    tmpXMLStr += "</map>";
    tmpXMLStr += "<map index=\"1\">";
    tmpXMLStr += "<col1>melon</col1>";
    tmpXMLStr += "<col2>7</col2>";
    tmpXMLStr += "<col3>8</col3>";
    tmpXMLStr += "</map>";
    tmpXMLStr += "</list>";

    var tmpXML = WebSquare.xml.parse(tmpXMLStr);

    dataList1.setXML(tmpXML, true);

};

scwin.trigger5_onclick = function (e) {
    var tmpXMLStr = "";
    tmpXMLStr += "<map>";
    tmpXMLStr += "<col1>papaya</col1>";
    tmpXMLStr += "<col2>9</col2>";
    tmpXMLStr += "<col3>10</col3>";
    tmpXMLStr += "</map>";

    var xmlDoc = WebSquare.xml.parse(tmpXMLStr);

    dataList1.setRowXML(0, xmlDoc);

};

scwin.trigger6_onclick = function (e) {
    dataList1.setRowJSON(0, { "col1": "strawberry", "col2": 11, "col3": 12, "col4": "", "col5" : ""});
};
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload">
    <xf:group id="" style="margin:10px;">
    	<w2:textbox tagname="h1" style="color: blue;margin-bottom: 10px;" tabIndex="h1" id="textbox1" label="DataList 컬럼의 초기 값 지정"
    		escape="false">
    	</w2:textbox>
    	<w2:textbox tagname="h2" style="height: 23px;margin-bottom: 10px;color: blue;" id="textbox2" label="샘플 사용 방법"></w2:textbox>
    	<w2:textbox style="color: blue;margin-bottom: 30px;" id="textbox3"
    		label='1. dataList1의 col4 컬럼의 initialColumnId 속성 값이 "col1"으로 설정된 것을 확인. &lt;br/&gt;2. dataList1의 col5 컬럼의 initialColumnId 속성 값이 "col2"로 설정된 것을 확인. &lt;br/&gt;3. 하단의 각 버튼을 클릭. (각 버튼은 dataList1의 "col4" 및 "col5" 컬럼에 대한 데이터를 정의하지 않고 "col1", "col2", "col3" 컬럼에만 데이터를 추가하는 동작을 실행.)&lt;br/&gt;4. "col4"의 값은 "col1"의 값을, "col5"의 값은 "col2"의 값을 사용하여 데이터를 설정하는 것을 확인. '
    		escape="false">
    	</w2:textbox>
    	<w2:textbox
    		style="padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightblue;border:none;margin-bottom: 10px;"
    		id="textbox4" label='속성 설정&lt;br/&gt;initialColumnId="col1" (dataList1.col4)&lt;br/&gt;initialColumnId="col2" (dataList1.col5)'
    		escape="false">
    	</w2:textbox>
    	<xf:trigger
    		style="height:42px; line-height:32px; padding:5px; background-color:coral; font-size:15px; weight:bolder; font-weight:bolder; text-align:left; display:block; margin-bottom:10px;"
    		id="trigger1" type="button" ev:onclick="scwin.trigger1_onclick">
    		<xf:label><![CDATA[dataList1.setJSON([{ "col1": "apricot", "col2": 1, "col3": 2 }]);]]></xf:label>
    	</xf:trigger>
    	<xf:trigger type="button" id="trigger2"
    		style="height:42px; line-height:32px; padding:5px; background-color:coral; font-size:15px; weight:bolder; font-weight:bolder; text-align:left; display:block; margin-bottom:10px;" ev:onclick="scwin.trigger2_onclick">
    		<xf:label><![CDATA[dataList1.setData(["banana", 3, 4, "", ""]);]]></xf:label>
    	</xf:trigger>
    	<xf:trigger type="button" id="trigger3" style="height:42px; line-height:32px; padding:5px; background-color:coral; font-size:15px; weight:bolder; font-weight:bolder; text-align:left; display:block; margin-bottom:10px;" ev:onclick="scwin.trigger3_onclick">
    		<xf:label><![CDATA[dataList1.setArray({"columnInfo": ["col1", "col2", "col3"], "data" : ["cherry", 5, 6] });]]></xf:label>
    	</xf:trigger>
    	<xf:trigger type="button" id="trigger4" style="height:42px; line-height:32px; padding:5px; background-color:coral; font-size:15px; weight:bolder; font-weight:bolder; text-align:left; display:block; margin-bottom:10px;" ev:onclick="scwin.trigger4_onclick">
    		<xf:label><![CDATA[dataList1.setXML();]]></xf:label>
    	</xf:trigger>
    	<xf:trigger type="button" id="trigger5" style="height:42px; line-height:32px; padding:5px; background-color:coral; font-size:15px; weight:bolder; font-weight:bolder; text-align:left; display:block; margin-bottom:10px;" ev:onclick="scwin.trigger5_onclick">
    		<xf:label><![CDATA[dataList1.setRowXML();]]></xf:label>
    	</xf:trigger>
    	<xf:trigger type="button" id="trigger6" style="height:42px; line-height:32px; padding:5px; background-color:coral; font-size:15px; weight:bolder; font-weight:bolder; text-align:left; display:block; margin-bottom:10px;" ev:onclick="scwin.trigger6_onclick">
    		<xf:label><![CDATA[dataList1.setRowJSON(0, { "col1": "strawberry", "col2": 11, "col3": 12});]]></xf:label>
    	</xf:trigger>
    	<w2:gridView visibleRowNumFix="true" rowNumVisible="true" checkAllType="false" dataList="data:dataList1"
    		style="border:solid gray 1px;" id="gridView1" autoFit="allColumn" visibleRowNum="8">
    		<w2:caption style="" id="caption1" value="this is a grid caption."></w2:caption>
    		<w2:header style="" id="header1">
    			<w2:row style="" id="row1">
    				<w2:column width="70" style="" inputType="text" id="column5" value="col1"></w2:column>
    				<w2:column width="70" style="" inputType="text" id="column4" value="col2"></w2:column>
    				<w2:column width="70" style="" inputType="text" id="column3" value="col3"></w2:column>
    				<w2:column width="70" style="" inputType="text" id="column2" value="col4"></w2:column>
    				<w2:column width="70" style="" inputType="text" id="column1" value="col5"></w2:column>
    			</w2:row>
    		</w2:header>
    		<w2:gBody style="" id="gBody1">
    			<w2:row style="" id="row2">
    				<w2:column width="70" style="" inputType="text" id="col1" value=""></w2:column>
    				<w2:column width="70" style="" inputType="text" id="col2" value=""></w2:column>
    				<w2:column width="70" style="" inputType="text" id="col3" value=""></w2:column>
    				<w2:column width="70" style="" inputType="text" id="col4" value=""></w2:column>
    				<w2:column width="70" style="" inputType="text" id="col5" value=""></w2:column>
    			</w2:row>
    		</w2:gBody>
    	</w2:gridView>
    </xf:group></body>
</html>
