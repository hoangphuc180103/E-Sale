define({declaration:{A:{version:'1.0',encoding:'UTF-8'}},E:[{T:1,N:'html',A:{xmlns:'http://www.w3.org/1999/xhtml','xmlns:ev':'http://www.w3.org/2001/xml-events','xmlns:w2':'http://www.inswave.com/websquare','xmlns:xf':'http://www.w3.org/2002/xforms'},E:[{T:1,N:'head',E:[{T:1,N:'w2:type',E:[{T:3,text:'DEFAULT'}]},{T:1,N:'w2:buildDate'},{T:1,N:'xf:model',E:[{T:1,N:'w2:dataCollection',A:{baseNode:'map'}},{T:1,N:'w2:workflowCollection'}]},{T:1,N:'script',A:{type:'text/javascript',lazy:'false'},E:[{T:4,cdata:function(scopeObj){with(scopeObj){scwin.count = 0;
scwin.onpageload = function () {
  scwin.count++;
  var tmpSrc1 = scwin.getfolderPath() + "/sub_red.xml";
  var tmpSrc2 = scwin.getfolderPath() + "/sub_blue.xml";
  var tmpSrc3 = scwin.getfolderPath() + "/sub_green.xml";
  windowContainer1.createWindow({
    "title": "Red " + scwin.count,
    "src": tmpSrc1,
    "windowId": scwin.count,
    "frameMode": "wframe"
  });
  windowContainer1.createWindow({
    "title": "Blue " + scwin.count,
    "src": tmpSrc2,
    "windowId": scwin.count + 1,
    "frameMode": "wframe"
  });
  windowContainer1.createWindow({
    "title": "Green " + scwin.count,
    "src": tmpSrc3,
    "windowId": scwin.count + 2,
    "frameMode": "wframe"
  });
  windowContainer1.setArrangeWindows("vertical");
  windowContainer2.createWindow({
    "title": "Red " + scwin.count,
    "src": tmpSrc1,
    "windowId": scwin.count,
    "frameMode": "wframe"
  });
  windowContainer2.createWindow({
    "title": "Blue " + scwin.count,
    "src": tmpSrc2,
    "windowId": scwin.count + 1,
    "frameMode": "wframe"
  });
  windowContainer2.createWindow({
    "title": "Green " + scwin.count,
    "src": tmpSrc3,
    "windowId": scwin.count + 2,
    "frameMode": "wframe"
  });
  windowContainer2.setArrangeWindows("vertical");
};
scwin.onpageunload = function () {};
scwin.getfolderPath = function () {
  var currentPath = window.location.href;
  var folderPath;
  if (currentPath.includes("mainContainer")) {
    console.log("true  ===> " + $p.getFrameId());
    const cmtFrame = $p.getComponentById($p.getFrameId());
    currentPath = cmtFrame.getSrc();
    folderPath = currentPath.substring(0, currentPath.lastIndexOf('/'));
  } else {
    console.log("false  ===> ");
    folderPath = currentPath.split('w2xPath=')[1].substring(0, currentPath.split('w2xPath=')[1].lastIndexOf('/'));
  }
  return folderPath;
};
}}}]}]},{T:1,N:'body',A:{'ev:onpageload':'scwin.onpageload','ev:onpageunload':'scwin.onpageunload'},E:[{T:1,N:'xf:group',A:{id:'',style:'margin: 10px;'},E:[{T:1,N:'w2:textbox',A:{tagname:'h1',style:'color: blue;margin-bottom: 10px;',tabIndex:'h1',id:'textbox1',label:'Prevent Minimization through Name Layer<br/>',escape:'false'}},{T:1,N:'w2:textbox',A:{tagname:'h2',style:'height: 23px;margin-bottom: 10px;color: blue;',id:'textbox2',label:'How to Use'}},{T:1,N:'w2:textbox',A:{style:'color: blue;margin-bottom: 30px;',id:'textbox3',label:'First WindowContainer (stopMinimizeOnNameLayer=“false”)<br/>1-1. Click each window in the name layer. <br/>1-2. Confirm that the clicked window minimizes and returns to its original size when clicked again.<br/><br/>Second WindowContainer (stopMinimizeOnNameLayer=“true”)<br/>2-1. Click each window in the name layer.<br/>2-2. Confirm that the clicked window does not minimize and maintains its original size.',escape:'false'}},{T:1,N:'w2:textbox',A:{style:'padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightblue;border:none;margin-bottom: 10px;',id:'textbox4',label:'stopMinimizeOnNameLayer="false"',escape:'false'}},{T:1,N:'w2:windowContainer',A:{sequentialArrangeColNum:'2',sequentialArrangeRowNum:'2',fixArrangeFullScreen:'false',useFixButton:'false',windowAutoResize:'false',verticalArrangeNum:'2',windowMaxNum:'5',useCloseButton:'false',controlIconPosition:'left',windowMaximizeAll:'false',stopMinimizeOnNameLayer:'false',toolbarPosition:'bottom',id:'windowContainer1',useStatusMsg:'true',hideTitleOnMaximize:'false',spaInitCount:'0',stopToggleOnLast:'false',useNameContainer:'false',horizontalArrangeNum:'2',useCustomMsg:'false',useControlIconTitle:'false',tooltipDisplay:'true',tooltipGroupClass:'false',windowTooltipDisplay:'true',style:'position: relative;height: 250px;border: gray solid 1px;margin-bottom: 10px;'},E:[{T:1,N:'w2:windowToolbar',E:[{T:1,N:'w2:controlIconLayer',E:[{T:1,N:'w2:controlIcon'},{T:1,N:'