<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare"
	xmlns:xf="http://www.w3.org/2002/xforms">
	<head meta_author="InswaveSystems" meta_type="메인" meta_screenName="[GridView] 바디 컬럼, 바디 셀, 헤더 셀의 클래스를 스크립트로 설정하기">
		<w2:historyInfo>
			<w2:history meta_no="01" meta_desc="최초작성" meta_date=" 20230719" meta_user="InswaveSystems"></w2:history>
			<w2:history meta_no="02" meta_desc="설명부 수정" meta_date="20240621" meta_user="InswaveSystems"></w2:history>
			<w2:history meta_no="03" meta_desc="예제에서 사용하는 DataList가 변경되고, 이에 따른 GridView의 설정과 스크립트가 수정되었습니다." meta_date="20240712"
				meta_user="InswaveSystems"></w2:history>
		</w2:historyInfo>
		<w2:type>COMPONENT</w2:type>
		<w2:buildDate />
		<w2:MSA />
		<xf:model>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" repeatNode="map" id="dlt_exam" saveRemovedData="true">
					<w2:columnInfo>
						<w2:column dataType="text" name="A" id="col_a"></w2:column>
						<w2:column dataType="text" name="B" id="col_b"></w2:column>
					</w2:columnInfo>
					<w2:data use="true">
						<w2:row>
							<col_a><![CDATA[A1]]></col_a>
							<col_b><![CDATA[B1]]></col_b>
						</w2:row>
						<w2:row>
							<col_a><![CDATA[A2]]></col_a>
							<col_b><![CDATA[B2]]></col_b>
						</w2:row>
						<w2:row>
							<col_a><![CDATA[A3]]></col_a>
							<col_b><![CDATA[B3]]></col_b>
						</w2:row>
					</w2:data>
				</w2:dataList>
			</w2:dataCollection>
			<w2:workflowCollection />
		</xf:model>
		<w2:layoutInfo />
		<w2:publicInfo method="" />
		<script lazy="false" type="text/javascript"><![CDATA[scwin.onpageload = function () {
    
};

/**
 * 버튼 [바디 컬럼 'B'에 class 'P00298_body_column' 설정하기] 클릭 시
 */
scwin.btn_exam1_1_onclick = function (e) {
    // GridView 'grd_exam'의 바디 컬럼 ID가 'col_b'인 컬럼에 class 'P00298_body_column'을 설정합니다.
    grd_exam.setColumnClass("col_b", "P00298_body_column");
};

/**
 * 버튼 [바디 컬럼 'A'의 두 번째 로우의 셀에 class 'P00298_body_cell' 설정하기] 클릭 시
 */
scwin.btn_exam2_1_onclick = function (e) {
    // GridView 'grd_exam'의 바디 컬럼 ID가 'col_a'인 컬럼의 두 번째 셀에 class 'P00298_body_cell'을 설정합니다.
    grd_exam.setCellClass(1, "col_a", "P00298_body_cell");
};

/**
 * 버튼 [헤더 컬럼 'B'에 class 'P00298_header_cell' 설정하기] 클릭 시
 */
scwin.btn_exam3_1_onclick = function (e) {
    // GridView 'grd_exam'의 헤더 컬럼 ID가 'h_col_b'인 셀에 class 'P00298_header_cell'을 설정합니다.
    grd_exam.setHeaderClass("h_col_b", "P00298_header_cell");
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:group class="sub_contents" id="" style="">
			<xf:group class="ws_example_grp_desc" id="" style="">
				<w2:textbox escape="false" id="" label="GridView의 메소드를 사용하여 바디 컬럼과 바디 셀, 헤더 셀에 CSS 클래스를 설정하는 예제입니다." style="">
				</w2:textbox>
			</xf:group>
			<xf:group class="example_div_tb_style_wrap mb_def" id="" style="">
				<xf:group class="example_div_tr_style" id="" style="">
					<xf:group class="example_div_td_style" id="" style="">
						<xf:group class="mb_def_box nobottom" id="" style="">
							<xf:trigger id="btn_exam1_1" style="" type="button" class="btn_exam_exec btn_txt_of"
								ev:onclick="scwin.btn_exam1_1_onclick">
								<xf:label><![CDATA[바디 컬럼 'B'에 class 'P00298_body_column' 설정하기]]></xf:label>
							</xf:trigger>
							<xf:trigger class="btn_exam_exec btn_txt_of" id="btn_exam2_1" style="" type="button"
								ev:onclick="scwin.btn_exam2_1_onclick">
								<xf:label><![CDATA[바디 컬럼 'A'의 두 번째 로우의 셀에 class 'P00298_body_cell' 설정하기]]></xf:label>
							</xf:trigger>
							<xf:trigger class="btn_exam_exec btn_txt_of" ev:onclick="scwin.btn_exam3_1_onclick" id="btn_exam3_1" style=""
								type="button">
								<xf:label><![CDATA[헤더 컬럼 'B'에 class 'P00298_header_cell' 설정하기]]></xf:label>
							</xf:trigger>
						</xf:group>
						<xf:group id="" class="mb_def_box nobottom" style="">
							<xf:group class="gvwbox" id="" style="max-width:240px;">
								<w2:gridView autoFit="allColumn" autoFitMinWidth="170" class="gvw" dataList="data:dlt_exam" defaultCellHeight="37"
									fastScroll="true" id="grd_exam" initFixedHeightByRowNum="4" keepDefaultColumnWidth="true" readOnly="true" rowNumVisible="true"
									rowNumWidth="40" style="height:80px;" tooltipDisplay="true" visibleRowNum="3">
									<w2:caption id="caption1" style="" value="this is a grid caption."></w2:caption>
									<w2:header id="header1">
										<w2:row id="row1">
											<w2:column displayMode="label" id="h_col_a" inputType="text" value="A" width="70"></w2:column>
											<w2:column displayMode="label" id="h_col_b" inputType="text" value="B" width="70"></w2:column>
										</w2:row>
									</w2:header>
									<w2:gBody id="gBody1">
										<w2:row id="row2">
											<w2:column displayMode="label" id="col_a" inputType="text" width="70"></w2:column>
											<w2:column displayMode="label" id="col_b" inputType="text" width="70"></w2:column>
										</w2:row>
									</w2:gBody>
								</w2:gridView>
							</xf:group>
						</xf:group>
					</xf:group>
				</xf:group>
			</xf:group>
		</xf:group>
	</body>
</html>