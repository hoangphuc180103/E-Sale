<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare"
	xmlns:xf="http://www.w3.org/2002/xforms">
	<head meta_author="InswaveSystems" meta_type="메인" meta_screenName="[GridView] 셀의 범위(range) 선택하기">
		<w2:historyInfo>
			<w2:history meta_no="01" meta_desc="최초작성" meta_date="20220916" meta_user="InswaveSystems"></w2:history>
			<w2:history meta_no="02" meta_desc="설명부 수정" meta_date="20240621" meta_user="InswaveSystems"></w2:history>
			<w2:history meta_no="03" meta_desc="예제에서 사용하는 DataList가 변경되고, 이에 따른 GridVeiw의 설정이 수정되었습니다." meta_date="20240705"
				meta_user="InswaveSystems"></w2:history>
		</w2:historyInfo>
		<w2:type>COMPONENT</w2:type>
		<w2:buildDate />
		<w2:MSA />
		<xf:model>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" id="dlt_exam" repeatNode="map" style="" valueAttribute="">
					<w2:columnInfo>
						<w2:column dataType="text" id="product" name="Product"></w2:column>
						<w2:column dataType="text" id="stock" name="Stock"></w2:column>
						<w2:column id="created_date" name="Date" dataType="text"></w2:column>
					</w2:columnInfo>
					<w2:data use="true">
						<w2:row>
							<product><![CDATA[SecureGate]]></product>
							<stock><![CDATA[98291]]></stock>
							<created_date><![CDATA[20110715]]></created_date>
						</w2:row>
						<w2:row>
							<product><![CDATA[FastServe]]></product>
							<stock><![CDATA[528]]></stock>
							<created_date><![CDATA[19991225]]></created_date>
						</w2:row>
						<w2:row>
							<product><![CDATA[CloudFlex]]></product>
							<stock><![CDATA[3928]]></stock>
							<created_date><![CDATA[20140321]]></created_date>
						</w2:row>
						<w2:row>
							<product><![CDATA[TechAssist]]></product>
							<stock><![CDATA[73918]]></stock>
							<created_date><![CDATA[20190523]]></created_date>
						</w2:row>

						<w2:row>
							<product><![CDATA[MobileMagic]]></product>
							<stock><![CDATA[1746123]]></stock>
							<created_date><![CDATA[20160127]]></created_date>
						</w2:row>
						<w2:row>
							<product><![CDATA[UltraServer]]></product>
							<stock><![CDATA[291]]></stock>
							<created_date><![CDATA[20020116]]></created_date>
						</w2:row>
					</w2:data>
				</w2:dataList>
			</w2:dataCollection>
			<w2:workflowCollection />
		</xf:model>
		<w2:layoutInfo />
		<w2:publicInfo method="" />
		<script lazy="false" type="text/javascript"><![CDATA[
scwin.onpageload = function () {

};

/**
 * 버튼 [1번째 행 1번째 컬럼 ~ 2번째 행 2번째 컬럼] 클릭시
 */
scwin.btn_ex1_onclick = function (e) {
    //1번째 행 1번째 컬럼 ~ 2번째 행 2번째 컬럼 선택하기
    grd_exam1.setFocusedMultiCell(0, 0, 1, 1);
    grd_exam2.setFocusedMultiCell(0, 0, 1, 1);
    grd_exam3.setFocusedMultiCell(0, 0, 1, 1);
    grd_exam4.setFocusedMultiCell(0, 0, 1, 1);

    //포커스 버튼으로 이동.
    btn_ex1.focus();
};

/**
 * 버튼 [행:1, 열:1 ~ 행:2, 열:2 + ignoreFocusMode 적용] 클릭시
 */
scwin.btn_ex3_onclick = function (e) {
    //1번째 행 1번째 컬럼 ~ 2번째 행 2번째 컬럼 선택하기 - 설정된 FocusMode 무시
    grd_exam1.setFocusedMultiCell(0, 0, 1, 1, { ignoreFocusMode: true });
    grd_exam2.setFocusedMultiCell(0, 0, 1, 1, { ignoreFocusMode: true });
    grd_exam3.setFocusedMultiCell(0, 0, 1, 1, { ignoreFocusMode: true });
    grd_exam4.setFocusedMultiCell(0, 0, 1, 1, { ignoreFocusMode: true });

    //포커스 버튼으로 이동.
    btn_ex3.focus();
};

/**
 * 버튼 [2번째 행 2번째 컬럼 ~ 4번째 행 3번째 컬럼] 클릭시
 */
scwin.btn_ex2_onclick = function (e) {
    //2번째 행 2번째 컬럼 ~ 4번째 행 3번째 컬럼
    grd_exam1.setFocusedMultiCell(1, 1, 3, 2);
    grd_exam2.setFocusedMultiCell(1, 1, 3, 2);
    grd_exam3.setFocusedMultiCell(1, 1, 3, 2);
    grd_exam4.setFocusedMultiCell(1, 1, 3, 2);

    //포커스 버튼으로 이동.
    btn_ex2.focus();
};

/**
 * 버튼 [행:2, 열:2 ~ 행:4, 열:3 + ignoreFocusMode 적용] 클릭시
 */
scwin.btn_ex4_onclick = function (e) {
    //2번째 행 2번째 컬럼 ~ 4번째 행 3번째 컬럼 - 설정된 FocusMode 무시
    grd_exam1.setFocusedMultiCell(1, 1, 3, 2, { ignoreFocusMode: true });
    grd_exam2.setFocusedMultiCell(1, 1, 3, 2, { ignoreFocusMode: true });
    grd_exam3.setFocusedMultiCell(1, 1, 3, 2, { ignoreFocusMode: true });
    grd_exam4.setFocusedMultiCell(1, 1, 3, 2, { ignoreFocusMode: true });

    //포커스 버튼으로 이동.
    btn_ex4.focus();
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:group class="sub_contents" id="" style="">
			<xf:group class="ws_example_grp_desc" id="" style="">
				<w2:textbox escape="false" id=""
					label="GridView의 'focusMode' 속성의 설정에 따라, GridView의 'setFocusedMultiCell' 메소드의 호출 결과를 비교한 예제입니다." style="">
				</w2:textbox>
			</xf:group>
			<xf:group class="example_div_tb_style_wrap" id="">
				<xf:group class="example_div_tr_style" id="" style="">
					<w2:textbox class="example_div_th_style" escape="false" id="" label="범위 선택 실행" style=""></w2:textbox>
					<xf:group class="example_div_td_style" id="" style="">
						<xf:group class="mb_def_box nobottom" id="" style="">
							<xf:trigger class="btn_exam_exec btn_txt_of" ev:onclick="scwin.btn_ex1_onclick" id="btn_ex1" localeRef=""
								style="min-width: 30px; height: 26px;" type="" useDefaultLabel="true">
								<xf:label><![CDATA[행:1, 열:1 ~ 행:2, 열:2]]></xf:label>
							</xf:trigger>
							<xf:trigger class="btn_exam_exec btn_txt_of" ev:onclick="scwin.btn_ex3_onclick" id="btn_ex3" localeRef=""
								style="min-width: 30px; height: 26px;" type="" useDefaultLabel="true">
								<xf:label><![CDATA[행:1, 열:1 ~ 행:2, 열:2 + ignoreFocusMode 적용]]></xf:label>
							</xf:trigger>
						</xf:group>
						<xf:group class="mb_def_box nobottom" id="" style="">
							<xf:trigger class="btn_exam_exec btn_txt_of" ev:onclick="scwin.btn_ex2_onclick" id="btn_ex2" localeRef=""
								style="min-width: 30px; height: 26px;" type="" useDefaultLabel="true">
								<xf:label><![CDATA[행:2, 열:2 ~ 행:4, 열:3]]></xf:label>
							</xf:trigger>
							<xf:trigger class="btn_exam_exec btn_txt_of" ev:onclick="scwin.btn_ex4_onclick" id="btn_ex4" localeRef=""
								style="min-width: 30px; height: 26px;" type="" useDefaultLabel="true">
								<xf:label><![CDATA[행:2, 열:2 ~ 행:4, 열:3 + ignoreFocusMode 적용]]></xf:label>
							</xf:trigger>
						</xf:group>
					</xf:group>
				</xf:group>
			</xf:group>
			<xf:group class="example_div_tb_style_wrap" id="">
				<xf:group class="example_div_tr_style" id="" style="">
					<w2:textbox class="example_div_th_style" escape="false" id="" label="결과 확인용 GridView - (기본 설정) focusMode : cell" style=""></w2:textbox>
					<xf:group class="example_div_td_style" id="" style="">
						<w2:textbox class="wre_txt_normal" escape="false" id="" label="셀 선택 시 포커스(선택) 범위가 셀(Cell) 단위입니다." style=""></w2:textbox>
						<xf:group id="" class="gvwbox">
							<w2:gridView rowNumWidth="34" visibleRowNumFix="true" rowNumVisible="true" dataList="data:dlt_exam" style="height:100px;"
								autoFit="allColumn" id="grd_exam1" visibleRowNum="4" class="gvw" defaultCellHeight="37" autoFitMinWidth="240">
								<w2:caption style="" id="caption1" value="this is a grid caption."></w2:caption>
								<w2:header style="" id="header1">
									<w2:row style="" id="row1">
										<w2:column width="140" inputType="text" id="column3" value="Product" displayMode="label"></w2:column>
										<w2:column width="70" inputType="text" id="column2" value="Stock" displayMode="label"></w2:column>
										<w2:column width="90" inputType="text" id="column1" value="Date" displayMode="label"></w2:column>
									</w2:row>
								</w2:header>
								<w2:gBody style="" id="gBody1">
									<w2:row style="" id="row2">
										<w2:column textAlign="left" width="140" inputType="text" id="product" displayMode="label"></w2:column>
										<w2:column textAlign="right" dataType="number" width="70" displayFormat="#,###" inputType="text" id="stock"
											displayMode="label">
										</w2:column>
										<w2:column dataType="date" width="90" displayFormat="yyyy-MM-dd" inputType="text" id="created_date" displayMode="label">
										</w2:column>
									</w2:row>
								</w2:gBody>
							</w2:gridView>
						</xf:group>
					</xf:group>
				</xf:group>
				<xf:group class="example_div_tr_style" id="" style="">
					<w2:textbox class="example_div_th_style" escape="false" id="" label="결과 확인용 GridView - focusMode : row" style=""></w2:textbox>
					<xf:group class="example_div_td_style" id="" style="">
						<w2:textbox class="wre_txt_normal" escape="false" id="" label="셀 선택 시 포커스(선택) 범위가 행(Row) 단위입니다." style=""></w2:textbox>
						<xf:group id="" class="gvwbox">
							<w2:gridView focusMode="row" rowNumWidth="34" rowNumVisible="true" visibleRowNumFix="true" dataList="data:dlt_exam"
								style="height:100px;" autoFit="allColumn" id="grd_exam2" visibleRowNum="4" class="gvw" defaultCellHeight="37" autoFitMinWidth="240">
								<w2:caption style="" id="caption1" value="this is a grid caption."></w2:caption>
								<w2:header style="" id="header1">
									<w2:row style="" id="row1">
										<w2:column width="140" inputType="text" id="column3" value="Product" displayMode="label"></w2:column>
										<w2:column width="70" inputType="text" id="column2" value="Stock" displayMode="label"></w2:column>
										<w2:column width="90" inputType="text" id="column1" value="Date" displayMode="label"></w2:column>
									</w2:row>
								</w2:header>
								<w2:gBody style="" id="gBody1">
									<w2:row style="" id="row2">
										<w2:column textAlign="left" width="140" inputType="text" id="product" displayMode="label"></w2:column>
										<w2:column textAlign="right" dataType="number" width="70" displayFormat="#,###" inputType="text" id="stock"
											displayMode="label">
										</w2:column>
										<w2:column dataType="date" width="90" displayFormat="yyyy-MM-dd" inputType="text" id="created_date" displayMode="label">
										</w2:column>
									</w2:row>
								</w2:gBody>
							</w2:gridView>
						</xf:group>
					</xf:group>
				</xf:group>
				<xf:group class="example_div_tr_style" id="" style="">
					<w2:textbox class="example_div_th_style" escape="false" id="" label="결과 확인용 GridView - focusMode : both" style=""></w2:textbox>
					<xf:group class="example_div_td_style" id="" style="">
						<w2:textbox class="wre_txt_normal" escape="false" id="" label="셀 선택 시 포커스(선택) 범위가 셀(Cell)+행(Row) 단위입니다." style=""></w2:textbox>
						<xf:group id="" class="gvwbox">
							<w2:gridView focusMode="both" rowNumWidth="34" rowNumVisible="true" visibleRowNumFix="true" dataList="data:dlt_exam"
								style="height:100px;" autoFit="allColumn" id="grd_exam3" visibleRowNum="4" class="gvw" defaultCellHeight="37" autoFitMinWidth="240">
								<w2:caption style="" id="caption1" value="this is a grid caption."></w2:caption>
								<w2:header style="" id="header1">
									<w2:row style="" id="row1">
										<w2:column width="140" inputType="text" id="column3" value="Product" displayMode="label"></w2:column>
										<w2:column width="70" inputType="text" id="column2" value="Stock" displayMode="label"></w2:column>
										<w2:column width="90" inputType="text" id="column1" value="Date" displayMode="label"></w2:column>
									</w2:row>
								</w2:header>
								<w2:gBody style="" id="gBody1">
									<w2:row style="" id="row2">
										<w2:column textAlign="left" width="140" inputType="text" id="product" displayMode="label"></w2:column>
										<w2:column textAlign="right" dataType="number" width="70" displayFormat="#,###" inputType="text" id="stock"
											displayMode="label">
										</w2:column>
										<w2:column dataType="date" width="90" displayFormat="yyyy-MM-dd" inputType="text" id="created_date" displayMode="label">
										</w2:column>
									</w2:row>
								</w2:gBody>
							</w2:gridView>
						</xf:group>
					</xf:group>
				</xf:group>
				<xf:group class="example_div_tr_style" id="" style="">
					<w2:textbox class="example_div_th_style" escape="false" id="" label="결과 확인용 GridView - focusMode : none" style=""></w2:textbox>
					<xf:group class="example_div_td_style" id="" style="">
						<w2:textbox class="wre_txt_normal" escape="false" id="" label="셀 선택 시 포커스(선택)가 되지 않습니다." style="">
						</w2:textbox>
						<xf:group id="" class="gvwbox">
							<w2:gridView focusMode="none" rowNumWidth="34" rowNumVisible="true" visibleRowNumFix="true" dataList="data:dlt_exam"
								style="height:100px;" autoFit="allColumn" id="grd_exam4" visibleRowNum="4" class="gvw" defaultCellHeight="37" autoFitMinWidth="240">
								<w2:caption style="" id="caption1" value="this is a grid caption."></w2:caption>
								<w2:header style="" id="header1">
									<w2:row style="" id="row1">
										<w2:column width="140" inputType="text" id="column3" value="Product" displayMode="label"></w2:column>
										<w2:column width="70" inputType="text" id="column2" value="Stock" displayMode="label"></w2:column>
										<w2:column width="90" inputType="text" id="column1" value="Date" displayMode="label"></w2:column>
									</w2:row>
								</w2:header>
								<w2:gBody style="" id="gBody1">
									<w2:row style="" id="row2">
										<w2:column textAlign="left" width="140" inputType="text" id="product" displayMode="label"></w2:column>
										<w2:column textAlign="right" dataType="number" width="70" displayFormat="#,###" inputType="text" id="stock"
											displayMode="label">
										</w2:column>
										<w2:column dataType="date" width="90" displayFormat="yyyy-MM-dd" inputType="text" id="created_date" displayMode="label">
										</w2:column>
									</w2:row>
								</w2:gBody>
							</w2:gridView>
						</xf:group>
