<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head meta_screenName="onbeforeselect_AutoComplete">
        <w2:type>COMPONENT</w2:type>
        <w2:buildDate/>
        <w2:MSA/>
        <xf:model>
            <w2:dataCollection baseNode="map"/>
            <w2:workflowCollection/>
        </xf:model>
        <w2:layoutInfo/>
        <w2:publicInfo method=""/>
        <script lazy="false" type="text/javascript"><![CDATA[
scwin.onpageload = function() {
	
};

scwin.autoComplete1_onbeforeselect = function (selectedIndex, index) {
  if (selectedIndex < index) {
        return true;
    } else {
        return false;        
    }
};
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload">
    <xf:group id="" style="margin: 10px;">
    	<w2:textbox tagname="h1" style="color: blue;margin-bottom: 10px;" id="textbox1" label="イベント - onbeforeselect" escape="false"></w2:textbox>
    	<w2:textbox tagname="h2" style="height: 23px;margin-bottom: 10px;color: blue;" id="textbox2" label="サンプルの使い方"></w2:textbox>
    	<w2:textbox style="color: blue;margin-bottom: 30px;" id="textbox3"
    		label='1. （Script タブで onbeforeselect イベントハンドラを確認します。）&lt;br/&gt;2. 現在選択されている値よりもインデックスが大きい項目を選択すると、選択が適用されることを確認します。 &lt;br/&gt;3. 現在選択されている値よりもインデックスが少ない項目を選択すると、選択が適用されないことを確認してください。'
    		escape="false">
    	</w2:textbox>
    	<w2:textbox
    		style="padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightgreen;border:none;margin-bottom: 10px;"
    		id="textbox4" label="イベント説明&lt;br/&gt;onbeforeselect - 項目選択時に発生。" escape="false">
    	</w2:textbox>
    	<w2:textbox style="padding:10px; padding-bottom:20px; text-align:left; font-size:15px; font-weight:bolder; border:brown 1px solid; background-color:ivory; margin-bottom:10px; margin-top:10px; color:brown;" id="textbox5" label="/// サンプルコード&lt;br/&gt;&lt;br/&gt;scwin.autoComplete1_onbeforeselect = function (selectedIndex, index) {&lt;br/&gt; &amp;nbsp;if(selectedIndex &lt; index) {&lt;br/&gt; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;return true;&lt;br/&gt; &amp;nbsp; &amp;nbsp;} else {&lt;br/&gt; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;return false; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&lt;br/&gt; &amp;nbsp; &amp;nbsp;}&lt;br/&gt;};&lt;br/&gt;" escape="false">
    	</w2:textbox>
    	<w2:autoComplete ev:onbeforeselect="scwin.autoComplete1_onbeforeselect" ref="" search="start" submenuSize="auto" chooseOption=""
    		editType="select" useKeywordHighlight="false" style="width: 50%;display: block;" allOption="" id="autoComplete1">
    		<w2:choices>
    			<w2:item>
    				<w2:label><![CDATA[1]]></w2:label>
    				<w2:value><![CDATA[1]]></w2:value>
    			</w2:item>
    			<w2:item>
    				<w2:label><![CDATA[2]]></w2:label>
    				<w2:value><![CDATA[2]]></w2:value>
    			</w2:item>
    			<w2:item>
    				<w2:label><![CDATA[3]]></w2:label>
    				<w2:value><![CDATA[3]]></w2:value>
    			</w2:item>
    			<w2:item>
    				<w2:label><![CDATA[4]]></w2:label>
    				<w2:value><![CDATA[4]]></w2:value>
    			</w2:item>
    			<w2:item>
    				<w2:label><![CDATA[5]]></w2:label>
    				<w2:value><![CDATA[5]]></w2:value>
    			</w2:item>
    			<w2:item>
    				<w2:label><![CDATA[6]]></w2:label>
    				<w2:value><![CDATA[6]]></w2:value>
    			</w2:item>
    			<w2:item>
    				<w2:label><![CDATA[7]]></w2:label>
    				<w2:value><![CDATA[7]]></w2:value>
    			</w2:item>
    			<w2:item>
    				<w2:label><![CDATA[8]]></w2:label>
    				<w2:value><![CDATA[8]]></w2:value>
    			</w2:item>
    		</w2:choices>
    	</w2:autoComplete>
    </xf:group></body>
</html>
