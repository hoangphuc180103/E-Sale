    	</w2:textbox><xf:trigger ev:onclick="scwin.trigger3_onclick" style="height:42px; line-height:32px; padding:5px; background-color:coral; font-size:15px; weight:bolder; font-weight:bolder; text-align:left; display:block; margin-bottom:10px;" id="trigger3" type="button">
    		<xf:label><![CDATA[autoComplete3.setValue("11");]]></xf:label>
    	</xf:trigger><w2:autoComplete valueNotInList="keepValue" submenuSize="auto" caseSensitive="true" chooseOption="" useKeywordHighlight="true" ev:onselected="" allOption="" ref="" search="contain" editType="select" style="width: 50%;display: block;margin-bottom: 10px;" id="autoComplete3" ev:onitemclick="" useLocale="false" emptyIndex="3" displayMode="value delim label">
    		<w2:choices>
