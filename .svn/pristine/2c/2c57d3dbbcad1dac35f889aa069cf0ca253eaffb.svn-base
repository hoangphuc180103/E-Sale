    				<w2:value><![CDATA[08]]></w2:value>
    			</w2:item>
    		</w2:choices>
    	</w2:autoComplete><w2:textbox style="padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightblue;border:none;margin-bottom: 10px;" id="textbox5" label='속성 설정&lt;br/&gt;valueNotInList="default"&lt;br/&gt;emptyItem="false"' escape="false">
    	</w2:textbox><xf:trigger ev:onclick="scwin.trigger2_onclick" style="height:42px; line-height:32px; padding:5px; background-color:coral; font-size:15px; weight:bolder; font-weight:bolder; text-align:left; display:block; margin-bottom:10px;" id="trigger2" type="button">
    		<xf:label><![CDATA[autoComplete2.setValue("10");]]></xf:label>
