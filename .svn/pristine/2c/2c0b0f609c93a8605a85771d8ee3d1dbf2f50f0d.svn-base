define({declaration:{A:{version:'1.0',encoding:'UTF-8'}},E:[{T:1,N:'html',A:{xmlns:'http://www.w3.org/1999/xhtml','xmlns:ev':'http://www.w3.org/2001/xml-events','xmlns:w2':'http://www.inswave.com/websquare','xmlns:xf':'http://www.w3.org/2002/xforms'},E:[{T:1,N:'head',A:{},E:[{T:1,N:'w2:type',E:[{T:3,text:'DEFAULT'}]},{T:1,N:'w2:buildDate'},{T:1,N:'xf:model',E:[{T:1,N:'w2:dataCollection',A:{baseNode:'map'}},{T:1,N:'w2:workflowCollection'}]},{T:1,N:'script',A:{type:'text/javascript',lazy:'false'},E:[{T:4,cdata:function(scopeObj){with(scopeObj){scwin.count = 0;
scwin.onpageload = function () {};
scwin.onpageunload = function () {};
scwin.widgetContainer_onclickcustombtn = function (widgetId, btnId) {
  alert("Custom Button ID : " + btnId);
};
scwin.trigger1_onclick = function (e) {
  scwin.count++;
  widgetContainer1.addWidgets({
    id: "widget" + scwin.count,
    title: "Widget_" + scwin.count + "_",
    src: null,
    scope: true,
    x: 0,
    y: scwin.count - 1,
    unitWidth: 1,
    unitHeight: 2
  });
};
scwin.trigger2_onclick = function (e) {
  bFormatter = function () {
    return [{
      'id': 'customBtn_1',
      'className': 'w2widget_btnCustom',
      'isCustom': true,
      'isCustomDirection': 'left'
    }, {
      'id': 'customBtn_2',
      'isCustom': true,
      'className': 'w2widget_btnCustom1',
      'isCustomDirection': 'left'
    }, {
      'id': 'customBtn_3',
      'className': 'w2widget_btnCustom w2widget_btnCustom2',
      'isCustom': true,
      'isCustomDirection': 'right'
    }, {
      'id': 'customBtn_4',
      'className': 'w2widget_btnCustom w2widget_btnCustom3',
      'isCustom': true,
      'isCustomDirection': 'right'
    }, {
      'useDefault': 'fix'
    }, {
      'useDefault': 'minimize'
    }, {
      'useDefault': 'maximize'
    }, {
      'useDefault': 'close'
    }];
  };
  scwin.count++;
  widgetContainer1.addWidgets({
    id: "widget" + scwin.count,
    title: "Widget_" + scwin.count + "_",
    src: null,
    scope: true,
    x: 1,
    y: scwin.count - 1,
    unitWidth: 1,
    unitHeight: 2,
    buttonFormatter: bFormatter
  });
};
}}}]},{T:1,N:'style',A:{type:'text/css'},E:[{T:4,cdata:'.w2widget_btnCustom1{width:15px;height:15px;background-color:#87ceeb}.w2widget_btnCustom2{width:15px;height:15px;background-color:coral}.w2widget_btnCustom3{width:15px;height:15px;background-color:gray;display:inline-block;margin-left:3px;margin-right:3px}'}]}]},{T:1,N:'body',A:{'ev:onpageload':'scwin.onpageload','ev:onpageunload':'scwin.onpageunload'},E:[{T:1,N:'xf:group',A:{id:'',style:'margin: 10px;'},E:[{T:1,N:'w2:textbox',A:{tagname:'h1',style:'color: blue;margin-bottom: 10px;',tabIndex:'h1',id:'textbox1',label:'ウィジェットにカスタムボタンを追加',escape:'false'}},{T:1,N:'w2:textbox',A:{tagname:'h2',style:'height: 23px;margin-bottom: 10px;color: blue;',id:'textbox2',label:'サンプルの使い方'}},{T:1,N:'w2:textbox',A:{style:'color: blue;margin-bottom: 30px;',id:'textbox3',label:'1. 最初の addWidgets() ボタンをクリックします。 <br/>2.基本ウィジェットが作成されることを確認してください。 <br/>3. 2番目のaddWidgets()ボタンをクリックします。 <br/>4. buttonFormatterオプションで追加したボタンを含むウィジェットが作成されることを確認してください。 <br/>5.追加された各ボタンをクリックして設定した動作が実行されることを確認。 <br/>（詳細なスクリプトは Script タブで確認。）',escape:'false'}},{T:1,N:'xf:trigger',A:{'ev:onclick':'scwin.trigger1_onclick',style:'height:42px;line-height:32px;padding:5px;background-color:coral;font-size:15px;weight: bolder;font-weight:bolder;text-align: left;display: block;margin-bottom: 10px;',id:'trigger1',type:'button'},E:[{T:1,N:'xf:label',E:[{T:4,cdata:'addWidgets();'}]}]},{T:1,N:'xf:trigger',A:{'ev:onclick':'scwin.trigger2_onclick',style:'height:42px;line-height:32px;padding:5px;background-color:coral;font-size:15px;weight: bolder;font-weight:bolder;text-align: left;display: block;margin-bottom: 10px;',id:'trigger2',type:'button'},E:[{T:1,N:'xf:label',E:[{T:4,cdata:'addWidgets( options.buttonFormatter );'}]}]},{T:1,N:'w2:widgetContainer',A:{unitHeightPixel:'100',accessibility:'true',minUnitWidth:'1',verticalMargin:'5',threshold:'500',rows:'3',unfixedTitleButtons:'true',params:'false',processMsgFrame:'true',widgetResize:'true',mode:'switch',preventMaximizeByTitle:'false',widgetMove:'true',style:'height: 400px;border:1px solid black;margin-bottom: 10px;',id:'widgetContainer1',horizontalMargin:'14',cols:'3','ev:onclickcustombtn':'scwin.widgetContainer_onclickcustombtn'}},{T:1,N:'w2:textbox',A:{escape:'false',id:'textbox4',label:'/// サンプルコード (1)<br/><br/>scwin.count++;<br/>widgetContainer1.addWidgets({<br/> &nbsp; &nbsp;id: "widget" &nbsp; title:"Widget_" true,<br/> &nbsp;x: 0,<br/> &nbsp; &nbsp;y: <br/> &nbsp; &nbsp;unitHeight: 2<br/>});<br/><br/>/// サンプルコード (2)<br/><br/>bFormatter = function() &nbsp; &nbsp;return [{<br/> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;\'id\': \'customBtn_1\',<br/> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;\'className\': \'w2widget_btnCustom\',<br/> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;\'isCustom\': true,<br/> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;\'isCustomDirection\': \'left\'<br/> &nbsp; &nbsp; &nbsp; &nbsp;}、<br/> &nbsp; &nbsp; &nbsp; &nbsp;{<br/> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;\'id\': \'customBtn_2\',<br/> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;\'isCustom\': true,<br/> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;\'className\': \'w2widget_btnCustom1\',<br/> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;\'isCustomDirection\': \'left\'<br/> &nbsp; &nbsp; &nbsp; &nbsp;}、<br/> &nbsp; &nbsp; &nbsp; &nbsp;{<br/> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;\'id\': \'customBtn_3\',<br/> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;\'className\': \'w2widget_btnCustom w2widget_btnCustom2\',<br/> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;\'isCustom\': true,<br/> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;\'isCustomDirection\': \'right\'<br/> &nbsp; &nbsp; &nbsp; &nbsp;}、<br/> &nbsp; &nbsp; &nbsp; &nbsp;{<br/> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;\'id\': \'customBtn_4\',<br/> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;\'className\': \'w2widget_btnCustom w2widget_btnCustom3\',<br/> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;\'isCustom\': true,<br/> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;\'isCustomDirection\': \'right\'<br/> &nbsp; &nbsp; &nbsp; &nbsp;}、<br/> &nbsp; &nbsp; &nbsp; &nbsp;{<br/> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;\'useDefault\': \'fix\'<br/> &nbsp; &nbsp; &nbsp; &nbsp;}、<br/> &nbsp; &nbsp; &nbsp; &nbsp;{<br/> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;\'useDefault\': \'minimize\'<br/> &nbsp; &nbsp; &nbsp; &nbsp;}、<br/> &nbsp; &nbsp; &nbsp; &nbsp;{<br/> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;\'useDefault\': \'maximize\'<br/> &nbsp; &nbsp; &nbsp; &nbsp;}、<br/> &nbsp; &nbsp; &nbsp; &nbsp;{<br/> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;\'useDefault\': \'close\'<br/> &nbsp; &nbsp; &nbsp; &nbsp;}<br/> &nbsp; &nbsp;];<br/>};<br/>scwin.count++;<br/>widgetContainer1.addWidgets({<br/> &nbsp; &nbsp;id: "widget" + scwin.count,<br/> &nbsp; &nbsp;title: "Widget_" + scwin.count + "_",<br/> &nbsp; &nbsp;src: null,<br/> &nbsp; &nbsp;scope: true,<br/> &nbsp; &nbsp;x: 1,<br/> &nbsp; &nbsp;y: scwin.count - 1,<br/> &nbsp; &nbsp;unitWidth: 1,<br/> &nbsp; &nbsp;unitHeight: 2,<br/> &nbsp; &nbsp;buttonFormatter: bFormatter<br/>});',style:'padding:10px; padding-bottom:20px; text-align:left; font-size:15px; font-weight:bolder; border:brown 1px solid; background-color:ivory; margin-bottom:10px; color:brown;',tagname:''}}]}]}]}]})