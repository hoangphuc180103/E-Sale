<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
         <script type="text/javascript" lazy="false"><![CDATA[
        
	scwin.onpageload = function() {
		alert("onpageload - Popup is about to be loaded.");
	};
	
	scwin.onpageunload = function() {
		
	};
	
	
	scwin.onbeforepageunload = function() {
		alert("onbeforepageunload - Popup is about to be unloaded");
	};
	]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload" ev:onpageunload="scwin.onpageunload" ev:onbeforepageunload="scwin.onbeforepageunload">
    	<w2:textbox id="textbox1" label="PopUp (src.xml)"
    		style="font-size:30px;font-style:italic;color:black;margin-left: 30px;">
    	</w2:textbox>
    </body>
</html>
