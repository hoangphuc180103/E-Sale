터 유형을 변경해 보며 반환데이터를 비교 해 보세요 <br/> &nbsp; &nbsp;반환 데이터의 유형은 5가지이며, 유형별 함수는 아래와 같습니다. &nbsp; <br/> &nbsp; 1) JSON 형식 : getMatchedJSON()<br/> &nbsp; 2) 1차원 Array 형식 + 컬럼 정보 : getMatchedArray()<br/> &nbsp; 3) 2차원 Array 형식 : getMatchedData()<br/> &nbsp; 4) XML 형식 : getMatchedXML()<br/> &nbsp; 5) Row Index가 담긴 1차원 Array 형식 : getMatchedIndex()<br/><br/>4. <a href="/_iws/dev_kit/document/api/html/WebSquare.uiplugin.dataList.html" target=\'_blank\'>사용자 가이드</a>',style:''}}]}]},{T:1,N:'xf:group',A:{class:'titbox',id:'',style:''},E:[{T:1,N:'w2:span',A:{label:'성별 선택 : ',style:'margin-right: 10px;font-weight: bold;',id:''}},{T:1,N:'xf:select1',A:{allOption:'',appearance:'minimal',chooseOption:'true',class:'',direction:'auto',disabled:'false',disabledClass:'w2selectbox_disabled',id:'selGender',ref:'',renderType:'',style:'width: 148px;',submenuSize:'auto',chooseOptionLabel:'$blank','ev:onviewchange':'scwin.selGender_onviewchange'},E:[{T:1,N:'xf:choices',E:[{T:1,N:'xf:item',E:[{T:1,N:'xf:label',E:[{T:4,cdata:'남자'}]},{T:1,N:'xf:value',E:[{T:4,cdata:'M'}]}]},{T:1,N:'xf:item',E:[{T:1,N:'xf:label',E:[{T:4,cdata:'여자'}]},{T:1,N:'xf:value',E:[{T:4,cdata:'F'}]}]}]}]},{T:1,N:'xf:group',A:{class:'rt',id:'',style:''},E:[{T:1,N:'xf:trigger',A:{class:'btn_exam_exec btn_txt_of',id:'btnFilter',style:'',type:'button','ev:onclick':'scwin.btnFilter_onclick'},E:[{T:1,N:'xf:label',E:[{T:4,cdata:'컬럼 Filter 해제'}]}]}]}]},{T:1,N:'xf:group',A:{class:'titbox',id:'',style:''},E:[{T:1,N:'w2:span',A:{label:'성명 검색 : ',style:'margin-right: 10px;font-weight: bold;',id:''}},{T:1,N:'w2:searchbox',A:{id:'iptSearch',style:'width: 150px;height: 21px;','ev:onkeydown':'scwin.iptSearch_onkeydown'}},{T:1,N:'xf:group',A:{class:'rt',id:'',style:''},E:[{T:1,N:'xf:trigger',A:{class:'btn_exam_exec btn_txt_of',id:'btnMatch',style:'',type:'button','ev:onclick':'scwin.btnMatch_onclick'},E:[{T:1,N:'xf:label',E:[{T:4,cdata:'일치되는 값 찾기'}]}]},{T:1,N:'xf:trigger',A:{class:'btn_exam_exec btn_txt_of',id:'btnCondition',style:'',type:'butt