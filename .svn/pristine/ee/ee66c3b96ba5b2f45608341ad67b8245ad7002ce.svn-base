<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head meta_screenName="onbeforeselect_SelectBox">
        <w2:type>COMPONENT</w2:type>
        <w2:buildDate/>
        <w2:MSA/>
        <xf:model>
            <w2:dataCollection baseNode="map"/>
            <w2:workflowCollection/>
        </xf:model>
        <w2:layoutInfo/>
        <w2:publicInfo method=""/>
        <script lazy="false" type="text/javascript"><![CDATA[
scwin.onpageload = function () {

};

scwin.select1_onbeforeselect = function (selectedIndex, index) {
    if (selectedIndex < index) {
        return true;
    } else {
        return false;
    }
};
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload">
    <xf:group id="" style="margin: 10px;">
    	<w2:textbox tagname="h1" style="color: blue;margin-bottom: 10px;" tabIndex="h1" id="textbox1" label="Event - onbeforeselect&lt;br/&gt;"
    		escape="false">
    	</w2:textbox>
    	<w2:textbox tagname="h2" style="height: 23px;margin-bottom: 10px;color: blue;" id="textbox2" label="How to Use"></w2:textbox>
    	<w2:textbox style="color: blue;margin-bottom: 30px;" id="textbox3"
    		label="1. Confirm that selecting an item with an index greater than the currently selected value applies the selection.&lt;br/&gt;(The onbeforeselect event handler returns true.)&lt;br/&gt;&lt;br/&gt;2. Confirm that selecting an item with an index smaller than the currently selected value does not apply the selection.&lt;br/&gt;(The onbeforeselect event handler returns false.)&lt;br/&gt;&lt;br/&gt;(Check the onbeforeselect event handler in the Script tab.)"
    		escape="false">
    	</w2:textbox>
    	<w2:textbox
    		style="padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightgreen;border:none;margin-bottom: 10px;"
    		id="textbox5" label="Event Description&lt;br/&gt;&lt;br/&gt;onbeforeselect - Fired when an item is selected." escape="false">
    	</w2:textbox>
    	<w2:textbox style="padding:10px; padding-bottom:20px; text-align:left; font-size:15px; font-weight:bolder; border:brown 1px solid; background-color:ivory; margin-bottom:10px; margin-top:10px; color:brown;" id="textbox6" label="/// Sample Code&lt;br/&gt;&lt;br/&gt;scwin.select1_onbeforeselect = function (selectedIndex, index) {&lt;br/&gt; &amp;nbsp; &amp;nbsp;if (selectedIndex &lt; index) {&lt;br/&gt; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;return true;&lt;br/&gt; &amp;nbsp; &amp;nbsp;} else {&lt;br/&gt; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;return false;&lt;br/&gt; &amp;nbsp; &amp;nbsp;}&lt;br/&gt;};" escape="false">
    	</w2:textbox>
    	<xf:select1 ev:onbeforeselect="scwin.select1_onbeforeselect" submenuSize="auto" ref="" appearance="minimal"
    		disabledClass="w2selectbox_disabled" chooseOption="" style="width: 50%;" disabled="false" id="select1" allOption=""
    		direction="auto">
    		<xf:choices>
    			<xf:item>
    				<xf:label><![CDATA[1]]></xf:label>
    				<xf:value><![CDATA[1]]></xf:value>
    			</xf:item>
    			<xf:item>
    				<xf:label><![CDATA[2]]></xf:label>
    				<xf:value><![CDATA[2]]></xf:value>
    			</xf:item>
    			<xf:item>
    				<xf:label><![CDATA[3]]></xf:label>
    				<xf:value><![CDATA[3]]></xf:value>
    			</xf:item>
    			<xf:item>
    				<xf:label><![CDATA[4]]></xf:label>
    				<xf:value><![CDATA[4]]></xf:value>
    			</xf:item>
    			<xf:item>
    				<xf:label><![CDATA[5]]></xf:label>
    				<xf:value><![CDATA[5]]></xf:value>
    			</xf:item>
    			<xf:item>
    				<xf:label><![CDATA[6]]></xf:label>
    				<xf:value><![CDATA[6]]></xf:value>
    			</xf:item>
    			<xf:item>
    				<xf:label><![CDATA[7]]></xf:label>
    				<xf:value><![CDATA[7]]></xf:value>
    			</xf:item>
    		</xf:choices>
    	</xf:select1>
    </xf:group></body>
</html>
