<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare"
	xmlns:xf="http://www.w3.org/2002/xforms">
	<head meta_author="InswaveSystems" meta_type="메인" meta_screenName="[TabControl] 탭의 이동 버튼의 기능 설정하기">
		<w2:historyInfo>
			<w2:history meta_no="01" meta_desc="최초작성" meta_date="20221104" meta_user="InswaveSystems" ></w2:history>
			<w2:history meta_no="02" meta_desc="설명부 수정" meta_date="20240621" meta_user="InswaveSystems" ></w2:history>
		</w2:historyInfo>
		<w2:type>COMPONENT</w2:type>
		<w2:buildDate />
		<w2:MSA />
		<xf:model>
			<w2:dataCollection baseNode="map">
			</w2:dataCollection>
			<w2:workflowCollection />
		</xf:model>
		<w2:layoutInfo />
		<w2:publicInfo method="" />
		<script lazy="false" type="text/javascript"><![CDATA[scwin.onpageload = function () {

};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:group class="sub_contents" id="" style="">
			<xf:group class="ws_example_grp_desc" id="" style="">
				<w2:textbox escape="false" id=""
					label="TabControl의 'changeActiveTab' 속성을 사용하여, 탭의 좌우 이동 버튼에 부가 기능을 설정한 예제입니다."
					style="">
				</w2:textbox>
			</xf:group>
			<xf:group id="" style="" class=""></xf:group>
			<xf:group class="example_div_tb_style_wrap mw600" id="">
				<xf:group class="example_div_tr_style" id="" style="">
					<w2:textbox class="example_div_th_style" escape="false" id="" label="(기본 동작) changeActiveTab 미사용" style=""></w2:textbox>
					<xf:group class="example_div_td_style" id="" style="">
						<w2:textbox class="wre_txt_normal" id="" label="탭 이동 버튼 클릭 시 탭 영역이 이동됩니다." style="">
						</w2:textbox>
					<xf:group id="" class="tbcbox"><w2:tabControl confirmTrueAction="exist" changeActiveTab="false" confirmFalseAction="new" useTabKeyOnly="true" tabScroll="true" useMoveNextTabFocus="false" useConfirmMessage="false" alwaysDraw="false" style="position: relative;height: 120px;" id="tac_exam1" class="tbc">
							<w2:tabs disabled="false" style="width:120px;" id="tabs1" label="TAB1"></w2:tabs>
							<w2:tabs disabled="false" style="width:120px;" id="tabs2" label="TAB2"></w2:tabs>
							<w2:tabs disabled="false" style="width:120px;" id="tabs3" label="TAB3"></w2:tabs>
							<w2:tabs disabled="false" style="width:120px;" id="tabs4" label="TAB4"></w2:tabs>
							<w2:tabs disabled="false" style="width:120px;" id="tabs5" label="TAB5"></w2:tabs>
							<w2:tabs disabled="false" style="width:120px;" id="tabs6" label="TAB6"></w2:tabs>
							<w2:content alwaysDraw="false" style="min-height:30px;" id="content1">
								<w2:textbox style="font-size: 1.2em;padding: 6px;color: steelblue;" id="" label="TAB1 CONTENT"></w2:textbox>
							</w2:content>
							<w2:content alwaysDraw="false" style="min-height:30px;" id="content2">
								<w2:textbox style="font-size: 1.2em;padding: 6px;color: forestgreen;" id="" label="TAB2 CONTENT"></w2:textbox>
							</w2:content>
							<w2:content alwaysDraw="false" style="min-height:30px;" id="content3">
								<w2:textbox style="font-size: 1.2em;padding: 6px;color: firebrick;" id="" label="TAB3 CONTENT"></w2:textbox>
							</w2:content>
							<w2:content alwaysDraw="false" style="min-height:30px;" id="content4">
								<w2:textbox style="font-size: 1.2em;padding: 6px;color: gold;" id="" label="TAB4 CONTENT"></w2:textbox>
							</w2:content>
							<w2:content alwaysDraw="false" style="min-height:30px;" id="content5">
								<w2:textbox style="font-size: 1.2em;padding: 6px;color: darkviolet;" id="" label="TAB5 CONTENT"></w2:textbox>
							</w2:content>
							<w2:content alwaysDraw="false" style="min-height:30px;" id="content6">
								<w2:textbox style="font-size: 1.2em;padding: 6px;color: dimgray;" id="" label="TAB6 CONTENT"></w2:textbox>
							</w2:content>
						</w2:tabControl></xf:group></xf:group>
				</xf:group>
				<xf:group class="example_div_tr_style" id="" style="">
					<w2:textbox class="example_div_th_style" escape="false" id="" label="changeActiveTab 사용" style=""></w2:textbox>
					<xf:group class="example_div_td_style" id="" style="">
						<w2:textbox class="wre_txt_normal" id="" label="탭 이동 버튼 클릭 시 선택된 탭의 이전 또는 다음 탭이 선택됩니다." style=""></w2:textbox>
					<xf:group id="" class="tbcbox"><w2:tabControl confirmTrueAction="exist" changeActiveTab="true" confirmFalseAction="new" useTabKeyOnly="true" tabScroll="true" useMoveNextTabFocus="false" useConfirmMessage="false" alwaysDraw="false" style="position: relative;height: 120px;" id="tac_exam2" class="tbc">
							<w2:tabs disabled="false" style="width:120px;" id="tabs1" label="TAB1"></w2:tabs>
							<w2:tabs disabled="false" style="width:120px;" id="tabs2" label="TAB2"></w2:tabs>
							<w2:tabs disabled="false" style="width:120px;" id="tabs3" label="TAB3"></w2:tabs>
							<w2:tabs disabled="false" style="width:120px;" id="tabs4" label="TAB4"></w2:tabs>
							<w2:tabs disabled="false" style="width:120px;" id="tabs5" label="TAB5"></w2:tabs>
							<w2:tabs disabled="false" style="width:120px;" id="tabs6" label="TAB6"></w2:tabs>
							<w2:content alwaysDraw="false" style="min-height:30px;" id="content1">
								<w2:textbox style="font-size: 1.2em;padding: 6px;color: steelblue;" id="" label="TAB1 CONTENT"></w2:textbox>
							</w2:content>
							<w2:content alwaysDraw="false" style="min-height:30px;" id="content2">
								<w2:textbox style="font-size: 1.2em;padding: 6px;color: forestgreen;" id="" label="TAB2 CONTENT"></w2:textbox>
							</w2:content>
							<w2:content alwaysDraw="false" style="min-height:30px;" id="content3">
								<w2:textbox style="font-size: 1.2em;padding: 6px;color: firebrick;" id="" label="TAB3 CONTENT"></w2:textbox>
							</w2:content>
							<w2:content alwaysDraw="false" style="min-height:30px;" id="content4">
								<w2:textbox style="font-size: 1.2em;padding: 6px;color: gold;" id="" label="TAB4 CONTENT"></w2:textbox>
							</w2:content>
							<w2:content alwaysDraw="false" style="min-height:30px;" id="content5">
								<w2:textbox style="font-size: 1.2em;padding: 6px;color: darkviolet;" id="" label="TAB5 CONTENT"></w2:textbox>
							</w2:content>
							<w2:content alwaysDraw="false" style="min-height:30px;" id="content6">
								<w2:textbox style="font-size: 1.2em;padding: 6px;color: dimgray;" id="" label="TAB6 CONTENT"></w2:textbox>
							</w2:content>
						</w2:tabControl></xf:group></xf:group>
				</xf:group>

			</xf:group>
		</xf:group>
	</body>
</html>