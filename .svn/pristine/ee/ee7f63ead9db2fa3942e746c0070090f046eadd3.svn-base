	<head meta_author="InswaveSystems" meta_type="메인" meta_screenName="[Checkbox] 설정된 수만큼 행을 구성하여 항목 표시하기">
		<w2:historyInfo>
			<w2:history meta_no="01" meta_desc="최초작성" meta_date=" 20230828" meta_user="InswaveSystems"></w2:history>
