<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare"
	xmlns:xf="http://www.w3.org/2002/xforms">
	<head meta_author="InswaveSystems" meta_type="메인" meta_screenName="[GridView] 읽기 전용으로 설정된 특정 컬럼의 데이터 붙여넣기(Ctrl+V) 허용하기">
		<w2:historyInfo>
			<w2:history meta_no="01" meta_desc="최초작성" meta_date="20230821" meta_user="InswaveSystems"></w2:history>
			<w2:history meta_no="02" meta_desc="설명부 수정" meta_date="20240621" meta_user="InswaveSystems"></w2:history>
			<w2:history meta_no="03" meta_desc="예제에서 사용하는 DataList가 변경되고, 이에 따른 GridView의 설정과 스크립트가 수정되었습니다." meta_date="20240712"
				meta_user="InswaveSystems"></w2:history>
		</w2:historyInfo>
		<w2:type>COMPONENT</w2:type>
		<w2:buildDate />
		<w2:MSA />
		<xf:model>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" repeatNode="map" id="dlt_exam" saveRemovedData="true">
					<w2:columnInfo>
						<w2:column dataType="text" name="A" id="col_1"></w2:column>
						<w2:column dataType="text" name="B" id="col_2"></w2:column>
					</w2:columnInfo>
					<w2:data use="true">
						<w2:row>
							<col_1><![CDATA[A1]]></col_1>
							<col_2><![CDATA[B1]]></col_2>
						</w2:row>
						<w2:row>
							<col_1><![CDATA[A2]]></col_1>
							<col_2><![CDATA[B2]]></col_2>
						</w2:row>
						<w2:row>
							<col_1><![CDATA[A3]]></col_1>
							<col_2><![CDATA[B3]]></col_2>
						</w2:row>
					</w2:data>
				</w2:dataList>
			</w2:dataCollection>
			<w2:workflowCollection />
		</xf:model>
		<w2:layoutInfo />
		<w2:publicInfo />
		<script lazy="false" type="text/javascript"><![CDATA[scwin.onpageload = function () {

};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:group class="sub_contents">
			<xf:group class="ws_example_grp_desc">
				<w2:textbox escape="false" label="읽기 전용으로 설정된 특정 컬럼의 셀에 데이터 붙여넣기(Ctrl+V)를 허용하는 예제입니다." style="" class=""></w2:textbox>
				<w2:textbox class="ws_example_txt_desc_info" escape="false" label="이 기능은 키보드를 사용할 수 있는 환경에서만 지원합니다." style="">
				</w2:textbox>
			</xf:group>
			<xf:group class="example_div_tb_style_wrap">
				<xf:group class="example_div_tr_style">
					<xf:group class="example_div_td_style">
						<xf:group class="def_box" id="" style="margin-bottom: 16px !important;">
							<w2:textbox id="" label="1. Input의 값을 복사(Ctrl+C)합니다." style=""></w2:textbox>
							<xf:input class="" editType="select" id="ibx_exam1" initValue="TEXT" placeholder="" style="width:150px;display: block;">
							</xf:input>
						</xf:group>
						<w2:textbox id="" label="2. GridView의 셀을 클릭하고 붙여넣기(Ctrl+V)합니다." style=""></w2:textbox>
						<xf:group id="" class="gvwbox" style="max-width: 300px;">
							<w2:gridView checkReadOnlyOnPasteEnable="col_2" checkReadOnlyOnPaste="true" initFixedHeightByRowNum="3"
								dataList="data:dlt_exam" readOnly="true" style="height:60px;" autoFit="allColumn" id="grd_exam1" visibleRowNum="3" class="gvw"
								defaultCellHeight="37" autoFitMinWidth="220">
								<w2:caption style="" id="caption1" value="this is a grid caption."></w2:caption>
								<w2:header style="" id="header1">
									<w2:row style="" id="row1">
										<w2:column width="110" inputType="text" id="column2" value="Paste Disabled" displayMode="label"></w2:column>
										<w2:column width="110" inputType="text" id="column1" value="Paste Enabled" displayMode="label"></w2:column>
									</w2:row>
								</w2:header>
								<w2:gBody style="" id="gBody1">
									<w2:row style="" id="row2">
										<w2:column width="110" inputType="text" id="col_1" displayMode="label"></w2:column>
										<w2:column width="110" inputType="text" id="col_2" displayMode="label"></w2:column>
									</w2:row>
								</w2:gBody>
							</w2:gridView>
						</xf:group>
					</xf:group>
				</xf:group>
			</xf:group>
		</xf:group>
	</body>
</html>