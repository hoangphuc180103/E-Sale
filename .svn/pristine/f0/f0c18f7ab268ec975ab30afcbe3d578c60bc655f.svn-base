scwin.ui_textbox1_onclick = function (e) {
  var _url = "";
  var _path = "";
  _path = this.getUserData("userData1");
  _url = $c.frame.getBasePageURL($p, true) + "#w2xPath=" + _path;
  window.open(_url, "_blank");
};

//dc_userInfoList.clearFilter();
scwin.btnFilter_onclick = function (e) {
  //1.컬럼 filter 해제  
};

//성별 selectBox onviewchange
scwin.selGender_onviewchange = function (info) {
  // 1. 기존 flilter 해제 clearFilter() 활용 
  dc_userInfoList.clearFilter();
  // 2. 성별로 filter 적용 setColumnFilter 활용 
  dc_userInfoList.setColumnFilter({
    type: 'row',
    colIndex: 'GENDER_CD',
    key: info.newValue,
    condition: 'and'
  });
};

//성명 검색 일치되는 값 찾기 
scwin.btnMatch_onclick = function (e) {
  //1. 배경색 초기화 적용
  scwin.setRowBackgroundColorInit();

  //2. 일치되는 값 찾기 true getMatchedIndex();

  var _index = dc_userInfoList.getMatchedIndex('EMP_NM', iptSearch.getValue(), true);
  var _len = _index.length;
  //2-1. 일치되는 값이 여러개 일때 처리  
  for (var i = 0; i < _len; i++) {
    //2-2. 일치되는 값 셀 색변경하기 
    grd.setCellBackgroundColor(_index[i], "EMP_NM", "#FF80FF");
  }
};

//성명 검색 포함되는 값 찾기
scwin.btnCondition_onclick = function (e) {
  //1. 배경색 초기화 적용
  scwin.setRowBackgroundColorInit();

  //2. 포함함되는 값 찾기 false getMatchedIndex(); 

  //2-1. 포함함되는 값이 여러개 일때 처리  
  //2-2. 포함함되는 값 셀 색변경하기  
};
scwin.sel_type_onviewchange = function (info) {
  let result = "";
  let strLog = "";
  var dataType = info.newValue;
  txa_log_1.setValue("");
  strLog = "# 컬럼 'EMP_NM'의 값이 '마길동'과 일치하는 데이터 받기 \n";
  if (dataType == '01') {
    result = dc_userInfoList.getMatchedJSON("EMP_NM", '마길동', true);
    strLog += " - JSON 형식 | 함수 getMatchedJSON 호출 값";
    $c.frame.printExampleLog($p, strLog, txa_log_1, false);
    $c.frame.printExampleLog($p, JSON.stringify(result), txa_log_1, false);
  } else if (dataType == '02') {
    result = dc_userInfoList.getMatchedArray("EMP_NM", '마길동', true);
    strLog += " - 1차원 Array 형식 + 컬럼 정보 | 함수 getMatchedArray 호출 값";
    $c.frame.printExampleLog($p, strLog, txa_log_1, false);
    $c.frame.printExampleLog($p, JSON.stringify(result), txa_log_1, false);
  } else if (dataType == '03') {
    result = dc_userInfoList.getMatchedData("EMP_NM", '마길동', true);
    strLog += " - 1차원 Array 형식 | 함수 getMatchedData 호출 값";
    $c.frame.printExampleLog($p, strLog, txa_log_1, false);
    $c.frame.printExampleLog($p, JSON.stringify(result), txa_log_1, false);
  } else if (dataType == '04') {
    result = dc_userInfoList.getMatchedXML("EMP_NM", '마길동', true);
    strLog += " - XML 형식 | 함수 getMatchedXML 호출 값";
    $c.frame.printExampleLog($p, strLog, txa_log_1, false);
    $c.frame.printExampleLog($p, WebSquare.xml.serialize(result), txa_log_1, false);
  } else if (dataType == '05') {
    result = dc_userInfoList.getMatchedIndex("EMP_NM", '마길동', true);
    strLog += " - 1차원 Array 형식 | 함수 getMatchedIndex 호출 값";
    $c.frame.printExampleLog($p, strLog, txa_log_1, false);
    $c.frame.printExampleLog($p, JSON.stringify(result), txa_log_1, false);
  }
  console.log(strLog);
  console.log(result);
};

// row 배경색 초기화 
scwin.setRowBackgroundColorInit = function () {
  var _totalRowCnt = dc_userInfoList.getTotalRow();
  for (var i = 0; i < _totalRowCnt; i++) {
    // grd.setRowBackgroundColor(i, "#fff");
    grd.setCellBackgroundColor(i, "EMP_NM", "#fff");
  }
};
scwin.iptSearch_onkeydown = function (e) {
  if (e.keyCode == 13) {
    // 엔터키 입력시 match 조회 실행 
    scwin.btnMatch_onclick();
  }
};
}}}]}]},{T:1,N:'body',A:{'ev:onpageload':'scwin.onpageload'},E:[{T:1,N:'xf:group',A:{class:'sub_contents',id:'',style:''},E:[{T:1,N:'xf:group',A:{class:'pgtbox',id:'',style:''},E:[{T:1,N:'xf:trigger',A:{class:'btn_fav',id:'',style:'',type:'button'},E:[{T:1,N:'xf:label'}]},{T:1,N:'w2:textbox',A:{class:'pgt_tit',id:'',label:'[실습화면] DataList 활용',style:'',tagname:''}}]},{T:1,N:'xf:group',A:{class:'ws_example_grp_desc',id:'',style:''},E:[{T:1,N:'xf:group',A:{class:'titbox',id:'',style:''},E:[{T:1,N:'w2:textbox',A:{class:'ws_example_txt_desc_info',id:'',label:'해당화면은 코딩이 없는 실습용 화면',style:'',tagname:'h3'}},{T:1,N:'w2:textbox',A:{class:'','ev:onclick':'scwin.ui_textbox1_onclick',id:'ui_textbox1',label:'[완성 화면 보기]',style:'cursor: pointer;',tagname:'h3',userData1:'/edu/adv/dataList_c.xml'}}]},{T:1,N:'xf:group',A:{class:'',id:'',style:'',tagname:'details'},E:[{T:1,N:'w2:textbox',A:{escape:'false',id:'',label:'실습 목표',style:'',tagname:'summary'}},{T:1,N:'w2:textbox',A:{class:'',escape:'false',id:'',label:'본 화면은 DataList를 활용하는 실습 화면입니다. <br/>DataList의 API 중 필터링을 동적으로 적용하는 기능과 제시된 값과 일치되는 값을 찾아주는 기능에 대해 확인합니다. <br/>',style:''}}]},{T:1,N:'xf:group',A:{class:'',id:'',style:'',tagname:'details'},E:[{T:1,N:'w2:textbox',A:{escape:'false',id:'',label:'실습 방법',style:'',tagname:'summary'}},{T:1,N:'w2:textbox',A:{class:'',escape:'false',id:'',label:'1. 아래의 API를 활용하여 DataList의 Filter 를 실습 해 봅니다. <br/> &nbsp; 1) \'성별 선택\' &nbsp;selectBox에 onviewchange 이벤트 함수를 추가합니다 <br/> &nbsp; &nbsp; &nbsp; 추가한 함수에 API를 활용하여 동적으로 dataList의 컬럼별 Filter를 적용해 봅니다.<br/> &nbsp; &nbsp; &nbsp;ex) DataList ID.setColumnFilter(); <br/><br/> &nbsp; 2) \'컬럼 Filter 해제\' 버튼에 onclick &nbsp;이벤트 함수를 추가합니다 &nbsp;<br/> &nbsp; &nbsp; &nbsp;현재 DataList에 적용된 필터링을 모두 해제하는 API <br/> &nbsp; &nbsp; &nbsp;ex) DataList ID.clearFilter(); <br/> &nbsp; &nbsp;<br/>2. API를 활용하여 DataList의 특정 컬럼 값과 입력 한 값이 일치되는 Data를 확인합니다. <br/> &nbsp;1) \'일치되는 값 찾기\' 버튼에 onclick 이벤트 함수를 추가합니다 &nbsp;<br/> &nbsp; &nbsp; &nbsp;ex) DataList ID.getUnmatchedIndex("EMP_NM, "미길동", true ); <br/><br/> &nbsp;2) \'포함되는 값 찾기\' 버튼에 onclick 이벤트 함수를 추가합니다 &nbsp;<br/> &nbsp; &nbsp; &nbsp;ex) DataList ID.getUnmatchedIndex("EMP_NM, "미길", false ); <br/><br/>3. 데이터 유형을 변경해 보며 반환데이터를 비교 해 보세요 <br/> &nbsp; &nbsp;반환 데이터의 유형은 5가지이며, 유형별 함수는 아래와 같습니다. &nbsp; <br/> &nbsp; 1) JSON 형식 : getMatchedJSON()<br/> &nbsp; 2) 1차원 Array 형식 + 컬럼 정보 : getMatchedArray()<br/> &nbsp; 3) 2차원 Array 형식 : getMatchedData()<br/> &nbsp; 4) XML 형식 : getMatchedXML()<br/> &nbsp; 5) Row Index가 담긴 1차원 Array 형식 : getMatchedIndex()<br/><br/>4. <a href="/_iws/dev_kit/document/api/html/WebSquare.uiplugin.dataList.html" target=\'_blank\'>사용자 가이드</a>',style:''}}]}]},{T:1,N:'xf:group',A:{class:'titbox',id:'',style:''},E:[{T:1,N:'w2:span',A:{label:'성별 선택 : ',style:'margin-right: 10px;font-weight: bold;',id:''}},{T:1,N:'xf:select1',A:{allOption:'',appearance:'minimal',chooseOption:'true',class:'',direction:'auto',disabled:'false',disabledClass:'w2selectbox_disabled',id:'selGender',ref:'',renderType:'',style:'width: 148px;',submenuSize:'auto',chooseOptionLabel:'$blank','ev:onviewchange':'scwin.selGender_onviewchange'},E:[{T:1,N:'xf:choices',E:[{T:1,N:'xf:item',E:[{T:1,N:'xf:label',E:[{T:4,cdata:'남자'}]},{T:1,N:'xf:value',E:[{T:4,cdata:'M'}]}]},{T:1,N:'xf:item',E:[{T:1,N:'xf:label',E:[{T:4,cdata:'여자'}]},{T:1,N:'xf:value',E:[{T:4,cdata:'F'}]}]}]}]},{T:1,N:'xf:group',A:{class:'rt',id:'',style:''},E:[{T:1,N:'xf:trigger',A:{class:'btn_exam_exec btn_txt_of',id:'btnFilter',style:'',type:'button','ev:onclick':'scwin.btnFilter_onclick'},E:[{T:1,N:'xf:label',E:[{T:4,cdata:'컬럼 Filter 해제'}]}]}]}]},{T:1,N:'xf:group',A:{class:'titbox',id:'',style:''},E:[{T:1,N:'w2:span',A:{label:'성명 검색 : ',style:'margin-right: 10px;font-weight: bold;',id:''}},{T:1,N:'w2:searchbox',A:{id:'iptSearch',style:'width: 150px;height: 21px;','ev:onkeydown':'scwin.iptSearch_onkeydown'}},{T:1,N:'xf:group',A:{class:'rt',id:'',style:''},E:[{T:1,N:'xf:trigger',A:{class:'btn_exam_exec btn_txt_of',id:'btnMatch',style:'',type:'butt