define({declaration:{A:{version:'1.0',encoding:'UTF-8'}},E:[{T:1,N:'html',A:{xmlns:'http://www.w3.org/1999/xhtml','xmlns:ev':'http://www.w3.org/2001/xml-events','xmlns:w2':'http://www.inswave.com/websquare','xmlns:xf':'http://www.w3.org/2002/xforms'},E:[{T:1,N:'head',A:{},E:[{T:1,N:'w2:historyInfo',E:[{T:1,N:'w2:history',A:{}},{T:1,N:'w2:history',A:{}},{T:1,N:'w2:history',A:{}}]},{T:1,N:'w2:type',E:[{T:3,text:'COMPONENT'}]},{T:1,N:'w2:buildDate'},{T:1,N:'w2:MSA'},{T:1,N:'xf:model',E:[{T:1,N:'w2:dataCollection',A:{baseNode:'map'},E:[{T:1,N:'w2:dataList',A:{baseNode:'list',repeatNode:'map',id:'dlt_exam',saveRemovedData:'true'},E:[{T:1,N:'w2:columnInfo',E:[{T:1,N:'w2:column',A:{dataType:'text',name:'A',id:'col_a'}},{T:1,N:'w2:column',A:{dataType:'text',name:'B',id:'col_b'}}]}]}]},{T:1,N:'w2:workflowCollection'}]},{T:1,N:'w2:layoutInfo'},{T:1,N:'w2:publicInfo',A:{method:''}},{T:1,N:'script',A:{lazy:'false',type:'text/javascript'},E:[{T:4,cdata:function(scopeObj){with(scopeObj){scwin.onpageload = function () {
  // 예제 테스트를 위한 초기화
  scwin.initializeExample();
};

// 예제 테스트를 위한 초기화
scwin.initializeExample = function () {
  // 최초 설정한 데이터로 재할당 합니다.
  dlt_exam.setJSON([{
    "col_a": "A1",
    "col_b": "B1"
  }, {
    "col_a": "A2",
    "col_b": "B2"
  }, {
    "col_a": "A3",
    "col_b": "B3"
  }]);

  // GridView 'grd_exam1'의 첫 번째 행, 첫 번째 열에 포커스를 지정합니다.
  grd_exam1.setFocusedCell(0, 0, false);

  // DataList 'dlt_exam'의 broadcast를 활성화 시킵니다.
  dlt_exam.setBroadcast(true, true);
};

/**
 * 버튼 [DataList 초기화] 클릭 시
 */
scwin.btn_initData_onclick = function (e) {
  scwin.initializeExample();
};

/**
 * 버튼 [Broadcast 비활성화하기] 클릭 시
 */
scwin.btn_exam1_onclick = function (e) {
  // DataList 'dlt_exam'의 broadcast 기능을 비활성화합니다.
  dlt_exam.setBroadcast(false);

  // 로그 출력
  let strLog = "# 'dlt_exam'의 Broadcast 기능을 비활성화합니다.";
  $c.frame.printExampleLog($p, strLog, txa_log, false);
  $c.frame.printExampleLog($p, "DataList와 연결된 컴포넌트의 데이터가 갱신되지 않습니다.", txa_log, false);
  console.log(strLog);
};

/**
 * 버튼 [데이터 수정 스크립트 실행하기] 클릭 시
 */
scwin.btn_exam2_onclick = function (e) {
  dlt_exam.setCellData(0, "col_a", "수정");
  dlt_exam.setCellData(0, "col_b", "수정");

  // 로그 출력
  let strLog = "# 'dlt_exam'의 0번째 행의 데이터를 수정합니다.";
  $c.frame.printExampleLog($p, strLog, txa_log, false);
  console.log(strLog);
};

/**
 * 버튼 [Broadcast 활성화하기] 클릭 시
 */
scwin.btn_exam3_onclick = function (e) {
  // DataList 'dlt_exam'의 broadcast 기능을 활성화하고 연결된 컴포넌트들을 즉시 갱신합니다.
  dlt_exam.setBroadcast(true, true);

  // 로그 출력
  let strLog = "# 'dlt_exam'의 Broadcast 기능을 활성화합니다.";
  $c.frame.printExampleLog($p, strLog, txa_log, false);
  $c.frame.printExampleLog($p, "DataList와 연결된 컴포넌트의 데이터가 갱신됩니다.", txa_log, false);
  console.log(strLog);
};

/**
 * 버튼 [Broadcast 상태 확인하기] 클릭 시
 */
scwin.btn_exam4_onclick = function (e) {
  // DataList 'dlt_exam'의 broadcast 기능의 활성화 여부를 반환 받습니다.
  let blnResult = dlt_exam.getBroadcast();

  // 로그 출력
  let strLog = "# 'dlt_exam'의 Broadcast 기능의 활성화 여부 : ";
  $c.frame.printExampleLog($p, strLog + blnResult, txa_log, false);
  console.log(strLog, blnResult);
  if (blnResult) {
    strLog = "연결된 컴포넌트가 즉시 갱신됩니다.";
  } else {
    strLog = "연결된 컴포넌트가 갱신되지 않습니다.";
  }
  $c.frame.printExampleLog($p, strLog, txa_log, false);
  console.log(strLog);
};

/**
 * textarea의 로그 삭제
 */
scwin.btn_clearLog_onclick = function (e) {
  txa_log.setValue("");
};
