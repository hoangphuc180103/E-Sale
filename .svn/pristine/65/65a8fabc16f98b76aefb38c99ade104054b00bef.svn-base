<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
         <script type="text/javascript" lazy="false"><![CDATA[
        
	scwin.onpageload = function() {
		
	};
	
	scwin.onpageunload = function() {
		
	};
	
	]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload" ev:onpageunload="scwin.onpageunload">
    <xf:group id="" style="margin: 10px;"><w2:textbox tagname="h1" style="color: blue;margin-bottom: 10px;" tabIndex="h1" id="textbox1" label="日付入出力形式（静的）設定" escape="false"></w2:textbox><w2:textbox tagname="h2" style="height: 23px;margin-bottom: 10px;color: blue;" id="textbox2" label="サンプルの使い方"></w2:textbox><w2:textbox style="color: blue;margin-bottom: 30px;" id="textbox3" label='1. InputCalendarの入力箱に ioFormat プロパティ設定にフォロー日付入力。（はい: "11112025"）&lt;br/&gt;2. Enter キー選択。 &lt;br/&gt;3. displayFormat プロパティ設定にフォロー入力した日付表示されるもの確認 。（はい: "11-11-2025"）&lt;br/&gt;4. InputCalendarのカレンダーアイコンクリック。 &lt;br/&gt;5. calendarDisplayFormat プロパティ設定にフォローカレンダー右下部に入力した日付表示されるもの確認。（はい: "11 : 11 : 2025"）&lt;br/&gt;' escape="false">
    	</w2:textbox><w2:textbox style="padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightblue;border:none;margin-bottom: 10px;" id="textbox4" label='プロパティの設定&lt;br/&gt;ioFormat="MMddyyyy" &lt;br/&gt;displayFormat="MM-dd-yyyy" &lt;br/&gt;calendarDisplayFormat="MM : dd : yyyy"' escape="false">
    	</w2:textbox><w2:inputCalendar minYear="1900" footerDiv="false" focusOnDateSelect="false" displayFormat="MM-dd-yyyy" calendarDisplayFormat="MM : dd : yyyy" calendarValueType="yearMonthDate" ioFormat="MMddyyyy" displayFormatFunc="" maxYear="2050" rightAlign="false" style="" id="inputCalendar1" renderType="component" renderDiv="true" monthNames="Jan,Feb,Mar,Apr,May,Jun,Jul,Aug,Sep,Oct,Nov,Dec" yearSuffix="Y">
    	</w2:inputCalendar></xf:group></body>
</html>
