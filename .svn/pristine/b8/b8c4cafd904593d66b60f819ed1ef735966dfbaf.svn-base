<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare"
	xmlns:xf="http://www.w3.org/2002/xforms">
	<head meta_author="InswaveSystems" meta_type="메인" meta_screenName="[WindowContainer] 네임 레이어 클릭 시 윈도우를 최소화하지 않기">
		<w2:historyInfo>
			<w2:history meta_no="01" meta_desc="최초작성" meta_date="20230216" meta_user="InswaveSystems" ></w2:history>
			<w2:history meta_no="02" meta_desc="설명부 수정" meta_date="20240621" meta_user="InswaveSystems" ></w2:history>
			<w2:history meta_no="03" meta_desc="윈도우의 'frameMode'를 'pageFrame'으로 설정" meta_date="20240621" meta_user="InswaveSystems" ></w2:history>
		</w2:historyInfo>
		<w2:type>COMPONENT</w2:type>
		<w2:buildDate />
		<w2:MSA />
		<xf:model>
			<w2:dataCollection baseNode="map">
			</w2:dataCollection>
			<w2:workflowCollection />
		</xf:model>
		<w2:layoutInfo />
		<w2:publicInfo method="" />
		<script lazy="false" type="text/javascript"><![CDATA[scwin.onpageload = function () {
    // 예제 테스트를 위한 초기화
    scwin.initializeExample();
};

// 예제 테스트를 위한 초기화
scwin.initializeExample = function () {
    // windowContainer 'wdc_exam1', 'wdc_exam2'의 윈도우 생성하기
    let options = {
        "title": "window 1",
        "windowID": "window_1",
        "frameMode": "pageFrame",
        "src": "/page/P00222S01.xml"
    };

    wdc_exam1.createWindow(options);
    wdc_exam2.createWindow(options);
};]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:group class="sub_contents" id="" style="">
			<xf:group class="ws_example_grp_desc" id="" style="">
				<w2:textbox escape="false" id=""
					label="WindowContainer의 'stopMinimizeOnNameLayer' 속성을 'true'로 설정하여 선택된 윈도우의 네임 레이어를 클릭했을 때 윈도우가 최소화되지 않도록 한 예제입니다."
					style="margin-bottom: 10px;">
				</w2:textbox>
			</xf:group>
			<xf:group class="example_div_tb_style_wrap" id="">
				<xf:group style="" id="" class="example_div_tr_style">
					<w2:textbox style="" id="" label="stopMinimizeOnNameLayer: true" class="example_div_th_style" escape="false"></w2:textbox>
					<xf:group style="" id="" class="example_div_td_style">
						<w2:windowContainer sequentialArrangeColNum="2" sequentialArrangeRowNum="2" fixArrangeFullScreen="false"
							useFixButton="false" windowAutoResize="false" verticalArrangeNum="2" windowMaxNum="5" useCloseButton="false"
							controlIconPosition="left" stopMinimizeOnNameLayer="true" toolbarPosition="bottom" windowMaximizeAll="false" id="wdc_exam1"
							useStatusMsg="false" hideTitleOnMaximize="false" spaInitCount="0" nameLayerRearrange="false" stopToggleOnLast="false"
							useNameContainer="false" horizontalArrangeNum="2" useCustomMsg="false" useControlIconTitle="false" tooltipDisplay="true"
							tooltipGroupClass="false" windowTooltipDisplay="true" style="position: relative;height: 300px;" frameMode="pageFrame">
							<w2:windowToolbar>
								<w2:controlIconLayer>
									<w2:controlIcon></w2:controlIcon>
									<w2:controlIcon></w2:controlIcon>
									<w2:controlIcon></w2:controlIcon>
									<w2:controlIcon></w2:controlIcon>
									<w2:controlIcon></w2:controlIcon>
								</w2:controlIconLayer>
								<w2:nameLayer></w2:nameLayer>
								<w2:selectedNameLayer></w2:selectedNameLayer>
							</w2:windowToolbar>
						</w2:windowContainer>
					</xf:group>
				</xf:group>
				<xf:group class="example_div_tr_style" id="" style="">
					<w2:textbox class="example_div_th_style" escape="false" id="" label="(기본 설정) stopMinimizeOnNameLayer: false"
						style="">
					</w2:textbox>
					<xf:group class="example_div_td_style" id="" style="">
						<w2:windowContainer sequentialArrangeColNum="2" verticalArrangeNum="2" controlIconPosition="left"
							windowMaximizeAll="false" id="wdc_exam2" useStatusMsg="false" hideTitleOnMaximize="false" spaInitCount="0"
							nameLayerRearrange="false" useNameContainer="false" useControlIconTitle="false" tooltipDisplay="true"
							style="position: relative;height: 300px;" sequentialArrangeRowNum="2" fixArrangeFullScreen="false" useFixButton="false"
							windowAutoResize="false" windowMaxNum="5" useCloseButton="false" stopMinimizeOnNameLayer="false" toolbarPosition="bottom"
							stopToggleOnLast="false" horizontalArrangeNum="2" useCustomMsg="false" tooltipGroupClass="false" windowTooltipDisplay="true" frameMode="pageFrame">
							<w2:windowToolbar>
								<w2:controlIconLayer>
									<w2:controlIcon></w2:controlIcon>
									<w2:controlIcon></w2:controlIcon>
									<w2:controlIcon></w2:controlIcon>
									<w2:controlIcon></w2:controlIcon>
									<w2:controlIcon></w2:controlIcon>
								</w2:controlIconLayer>
								<w2:nameLayer></w2:nameLayer>
								<w2:selectedNameLayer></w2:selectedNameLayer>
							</w2:windowToolbar>
						</w2:windowContainer>
					</xf:group>
				</xf:group>
			</xf:group>
		</xf:group>
	</body>
</html>