 */
scwin.initData = function () {
  // DataList 'dlt_exam'에 데이터 할당하기
  let data = [{
    "category": "Networking",
    "product": "SpeedLink"
  }, {
    "category": "Cloud Services",
    "product": "CloudFlex"
  }, {
    "category": "Support Services",
    "product": "TechAssist"
  }, {
    "category": "Servers",
    "product": "EcoServe"
  }, {
    "category": "Cloud Services",
    "product": "CloudPro"
  }, {
    "category": "Support Services",
    "product": "TechTeam"
  }, {
    "category": "Security",
    "product": "SecureGate"
  }, {
    "category": "Networking",
    "product": "LinkSecure"
  }, {
    "category": "Servers",
    "product": "ServeTech"
  }];
  dlt_exam.setJSON(data);
};

/**
