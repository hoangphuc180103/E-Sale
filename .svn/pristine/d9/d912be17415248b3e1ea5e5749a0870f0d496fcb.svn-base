define({declaration:{A:{version:'1.0',encoding:'UTF-8'}},E:[{T:1,N:'html',A:{xmlns:'http://www.w3.org/1999/xhtml','xmlns:ev':'http://www.w3.org/2001/xml-events','xmlns:w2':'http://www.inswave.com/websquare','xmlns:xf':'http://www.w3.org/2002/xforms'},E:[{T:1,N:'head',A:{},E:[{T:1,N:'w2:type',E:[{T:3,text:'DEFAULT'}]},{T:1,N:'w2:buildDate'},{T:1,N:'xf:model',E:[{T:1,N:'w2:dataCollection',A:{baseNode:'map'}},{T:1,N:'w2:workflowCollection'}]},{T:1,N:'script',A:{type:'text/javascript',lazy:'false'},E:[{T:4,cdata:function(scopeObj){with(scopeObj){scwin.count = 0;
scwin.onpageload = function () {};
scwin.onpageunload = function () {};
scwin.trigger1_onclick = function (e) {
  scwin.count++;
  const tmpSrc = scwin.getfolderPath() + "/page_component.xml";
  tabControl1.addTab("tab1", {
    "label": "PageFrame",
    "title": "PageFrame Tab",
    "openAction": "exist",
    "closable": "true"
  }, {
    "src": tmpSrc,
    "frameMode": "pageFrame"
  });
  tabControl1.setSelectedTabIndex(scwin.count);
};
scwin.trigger3_onclick = function (e) {
  var tabObj = tabControl1.getWindow("tab1");
  tabObj.scwin.borderFirst();
};
scwin.trigger4_onclick = function (e) {
  var tabObj = tabControl1.getWindow("tab1");
  tabObj.scwin.borderSecond();
};
scwin.trigger5_onclick = function (e) {
  var tabObj = tabControl1.getWindow("tab1");
  tabObj.scwin.setBrown();
};
scwin.trigger6_onclick = function (e) {
  var tabObj = tabControl1.getWindow("tab1");
  tabObj.scwin.showAll();
};
scwin.getfolderPath = function () {
  var currentPath = window.location.href;
  var folderPath;
  if (currentPath.includes("mainContainer")) {
    console.log("true  ===> " + $p.getFrameId());
    const cmtFrame = $p.getComponentById($p.getFrameId());
    currentPath = cmtFrame.getSrc();
    folderPath = currentPath.substring(0, currentPath.lastIndexOf('/'));
  } else {
    console.log("false  ===> ");
    folderPath = currentPath.split('w2xPath=')[1].substring(0, currentPath.split('w2xPath=')[1].lastIndexOf('/'));
  }
  return folderPath;
};
}}}]}]},{T:1,N:'body',A:{'ev:onpageload':'scwin.onpageload','ev:onpageunload':'scwin.onpageunload'},E:[{T:1,N:'xf:group',A:{id:'',style:'margin: 10px;'},E:[{T:1,N:'w2:textbox',A:{tagname:'h1',style:'margin-bottom: 10px;color: blue;',id:'textbox1',label:'Create PageFrame Tab<br/>',escape:'false'}},{T:1,N:'w2:textbox',A:{tagname:'h2',style:'height: 23px;margin-bottom: 10px;color: blue;',id:'textbox2',label:'How to Use'}},{T:1,N:'w2:textbox',A:{style:'color: blue;margin-bottom: 30px;',id:'textbox3',label:'1. Click the addTab() button at the top.<br/>2. Confirm the Page Component file used as the tab\'s source (src).<br/> &nbsp; &nbsp;(In this example, the page_component.xml file is used.)<br/>3. Confirm the methods added to the Page Component. &nbsp;<br/>4. Click each button at the bottom.<br/>5. Confirm that the methods of the Page Component contained within the TabControl can be executed directly from the main screen.',escape:'false'}},{T:1,N:'xf:trigger',A:{'ev:onclick':'scwin.trigger1_onclick',style:'display: block;height:42px;line-height:32px;padding:5px;background-color:coral;font-size:15px;weight: bolder;font-weight:bolder;margin-top:10px;text-align: left;',id:'trigger1',type:'button'},E:[{T:1,N:'xf:label',E:[{T:4,cdata:'addTab() - "frameMode": "pageFrame"'}]}]},{T:1,N:'xf:group',A:{style:'margin-bottom: 20px;',id:''},E:[{T:1,N:'xf:trigger',A:{'ev:onclick':'scwin.trigger3_onclick',style:'height:42px;line-height:32px;padding:5px;background-color:lightgreen;font-size:15px;weight: bolder;font-weight:bolder;margin-top:10px;text-align: left;',id:'trigger3',type:'button'},E:[{T:1,N:'xf:label',E:[{T:4,cdata:'tabObj.scwin.borderFirst();'}]}]},{T:1,N:'xf:trigger',A:{'ev:onclick':'scwin.trigger4_onclick',style:'height:42px;line-height:32px;padding:5px;background-color:lightgreen;font-size:15px;weight: bolder;font-weight:bolder;margin-top:10px;text-align: left;',id:'trigger4',type:'button'},E:[{T:1,N:'xf:label',E:[{T:4,cdata:'tabObj.scwin.borderSecond();'}]}]},{T:1,N:'xf:trigger',A:{'ev:onclick':'scwin.trigger5_onclick',style:'height:42px;line-height:32px;padding:5px;background-color:lightgreen;font-size:15px;weight: bolder;font-weight:bolder;margin-top:10px;text-align: left;',id:'trigger5',type:'button'},E:[{T:1,N:'xf:label',E:[{T:4,cdata:'tabObj.scwin.setBrown();'}]}]},{T:1,N:'xf:trigger',A:{'ev:onclick':'scwin.trigger6_onclick',style:'height:42px;line-height:32px;padding:5px;background-color:lightgreen;font-size:15px;weight: bolder;font-weight:bolder;margin-top:10px;text-align: left;',id:'trigger6',type:'button'},E:[{T:1,N:'xf:label',E:[{T:4,cdata:'tabObj.scwin.showAll();'}]}]}]},{T:1,N:'w2:tabControl',A:{alwaysDraw:'true',style:'border: gray solid 1px;height: 400px;',id:'tabControl1'}}]}]}]}]})