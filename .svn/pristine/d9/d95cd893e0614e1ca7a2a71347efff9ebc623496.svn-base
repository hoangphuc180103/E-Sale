<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare"
	xmlns:xf="http://www.w3.org/2002/xforms">
	<head meta_author="InswaveSystems" meta_type="메인" meta_screenName="[TreeView] 바인딩된 dataList를 다른 dataList로 변경하기" >
		<w2:historyInfo>
			<w2:history meta_no="01" meta_desc="최초작성" meta_date="20251224" meta_user="InswaveSystems"></w2:history>
		</w2:historyInfo>
		<w2:type>COMPONENT</w2:type>
		<w2:buildDate />
		<w2:MSA />
		<xf:model>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" repeatNode="map" id="dlt_exam1" saveRemovedData="true">
					<w2:columnInfo>
						<w2:column id="label" name="name1" dataType="text"></w2:column>
						<w2:column id="value" name="name2" dataType="text"></w2:column>
						<w2:column id="depth" name="name3" dataType="text"></w2:column>
					</w2:columnInfo>
					<w2:data use="true">
						<w2:row>
							<label><![CDATA[라벨A]]></label>
							<depth><![CDATA[1]]></depth>
							<value><![CDATA[a]]></value>
						</w2:row>
						<w2:row>
							<label><![CDATA[라벨A-1]]></label>
							<depth><![CDATA[2]]></depth>
							<value><![CDATA[a1]]></value>
						</w2:row>
						<w2:row>
							<label><![CDATA[라벨A-1-1]]></label>
							<depth><![CDATA[3]]></depth>
							<value><![CDATA[a11]]></value>
						</w2:row>
						<w2:row>
							<label><![CDATA[라벨A-1-2]]></label>
							<value><![CDATA[a12]]></value>
							<depth><![CDATA[3]]></depth>
						</w2:row>
						<w2:row>
							<depth><![CDATA[3]]></depth>
							<label><![CDATA[라벨A-1-3]]></label>
							<value><![CDATA[a13]]></value>
						</w2:row>
						<w2:row>
							<label><![CDATA[라벨B]]></label>
							<depth><![CDATA[1]]></depth>
							<value><![CDATA[b]]></value>
						</w2:row>
						<w2:row>
							<label><![CDATA[라벨B-1]]></label>
							<value><![CDATA[b1]]></value>
							<depth><![CDATA[2]]></depth>
						</w2:row>
						<w2:row>
							<label><![CDATA[라벨B-2]]></label>
							<value><![CDATA[b2]]></value>
							<depth><![CDATA[3]]></depth>
						</w2:row>
					</w2:data>
				</w2:dataList>
				<w2:dataList baseNode="list" repeatNode="map" id="dlt_exam2">
					<w2:columnInfo>
						<w2:column id="label" name="name1" dataType="text"></w2:column>
						<w2:column id="value" name="name2" dataType="text"></w2:column>
						<w2:column id="depth" name="name3" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
			<w2:workflowCollection />
		</xf:model>
		<w2:layoutInfo />
		<w2:publicInfo />
		<script lazy="false" type="text/javascript"><![CDATA[scwin.onpageload = function () {

};
scwin.btn_ex1_onclick = function (e) {
    // 새로운 dataList의 아이디가 dataList1인 경우
    var columnInfoArr = [
        {"label":"라벨ㄱ",   "value":"01", "depth":"1"},
        {"label":"라벨ㄱ-1", "value":"02", "depth":"2"},
        {"label":"라벨ㄱ-2", "value":"03", "depth":"2"},
        {"label":"라벨ㄱ-3", "value":"04", "depth":"2"},
        {"label":"라벨ㄴ",   "value":"05", "depth":"1"},
        {"label":"라벨ㄴ-1", "value":"06", "depth":"2"},
        {"label":"라벨ㄴ-2", "value":"07", "depth":"2"},
        {"label":"라벨ㄴ-3", "value":"08", "depth":"2"}
    ];

    dlt_exam2.setJSON(columnInfoArr);

    trv2.setNodeSet( "data:dlt_exam2" , columnInfoArr );
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:group class="sub_contents">
			<xf:group class="ws_example_grp_desc">
				<w2:textbox escape="false"
					label="Treeview의 'setNodeSet' 메소드를 사용하여 바인딩된 dataList를 변경하는 예제입니다."
					style="">
				</w2:textbox>
			</xf:group>
			<xf:group class="example_div_tb_style_wrap">
				<xf:group class="example_div_tr_style" style="">
					<w2:textbox class="example_div_th_style" escape="false" id="" label="'setNodeSet' 메소드 적용" style=""></w2:textbox>
					<xf:group class="example_div_td_style" id="" style="">
						<xf:group id="" class="mb_def_box nobottom">
							<xf:trigger ev:onclick="scwin.btn_ex1_onclick" disabled="" style="" id="btn_ex1" type="button"
								class="btn_exam_exec btn_txt_of" escape="false">
								<xf:label><![CDATA[다른 dataList로 변경하기]]></xf:label>
							</xf:trigger>
						</xf:group>
					</xf:group>
					<xf:group class="example_div_td_style">
						<w2:treeview dataType="listed" id="trv2" style="height:230px;">
                            <w2:itemset nodeset="data:dlt_exam1">
                                <w2:label ref="label"></w2:label>
                                <w2:value ref="value"></w2:value>
                                <w2:depth ref="depth"></w2:depth>
                                <w2:folder ref=""></w2:folder>
                                <w2:checkbox ref=""></w2:checkbox>
                                <w2:checkboxDisabled ref=""></w2:checkboxDisabled>
                                <w2:image ref=""></w2:image>
                                <w2:iconImage ref=""></w2:iconImage>
                                <w2:selectedImage ref=""></w2:selectedImage>
                                <w2:expandedImage ref=""></w2:expandedImage>
                                <w2:leafImage ref=""></w2:leafImage>
                            </w2:itemset>
                        </w2:treeview>
					</xf:group>
				</xf:group>
			</xf:group>
		</xf:group>
	</body>
</html>