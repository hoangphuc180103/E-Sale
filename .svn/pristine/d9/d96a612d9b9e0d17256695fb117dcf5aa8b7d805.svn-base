<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
         <script type="text/javascript" lazy="false"><![CDATA[
        
	scwin.onpageload = function() {
		
	};
	
	scwin.onpageunload = function() {
		
	};
	
	
	scwin.wframe1_onbeforewframeunload = function() {
		alert("onbeforewframeunload - WFrame about to be unloaded!");
	};
	]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload" ev:onpageunload="scwin.onpageunload">
    	<w2:textbox tagname="h1" style="color: blue;margin: 30px;margin-bottom: 0px;" tabIndex="h1" id="textbox1" label="src.xml"
    		escape="false">
    	</w2:textbox>
    	<w2:textbox style="color: blue;margin-left: 30px;margin-bottom: 0px;" id="textbox2"
    		label="以下のWFrameにonbeforewframeunloadイベントが定義されています。" escape="false">
    	</w2:textbox>
    	<w2:wframe style="height: 100px;border: solid red 3px;margin: 30px;margin-top: 10px;" id="wframe1"
    		ev:onbeforewframeunload="scwin.wframe1_onbeforewframeunload">
    	</w2:wframe>
    	<w2:textbox escape="false" id="textbox3"
    		label='/// サンプルコード &lt;br/&gt;&lt;br/&gt;scwin.wframe1_onbeforewframeunload = function() {&lt;br/&gt; &amp;nbsp; &amp;nbsp;alert("onbeforewframeunload - WFrame about to be unloaded!");&lt;br/&gt;};&lt;br/&gt;'
    		style="padding:10px; padding-bottom:20px; text-align:left; font-size:15px; font-weight:bolder; border:brown 1px solid; background-color:ivory; margin-bottom:10px; color:brown; margin: 30px;margin-top: 10px;"
    		tagname="">
    	</w2:textbox>
    </body>
</html>
