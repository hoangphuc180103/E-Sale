scwin.dataList1_ondataload = function () {
  alert("ondataload - Loading done.");
};
scwin.trigger1_onclick = function (e) {
  var objSubmission = $p.getSubmission("submission1");
  objSubmission.action = scwin.getfolderPath() + '/data.json';
  $p.executeSubmission("submission1");
};
scwin.getfolderPath = function () {
  var currentPath = window.location.href;
  var folderPath;
  if (currentPath.includes("mainContainer")) {
    console.log("true  ===> " + $p.getFrameId());
    const cmtFrame = $p.getComponentById($p.getFrameId());
    currentPath = cmtFrame.getSrc();
    folderPath = currentPath.substring(0, currentPath.lastIndexOf('/'));
  } else {
    console.log("false  ===> ");
    folderPath = currentPath.split('w2xPath=')[1].substring(0, currentPath.split('w2xPath=')[1].lastIndexOf('/'));
  }
  return folderPath;
};
}}}]}]},{T:1,N:'body',A:{'ev:onpageload':'scwin.onpageload','ev:onpageunload':'scwin.onpageunload'},E:[{T:1,N:'xf:group',A:{id:'',style:'margin: 10px;'},E:[{T:1,N:'w2:textbox',A:{tagname:'h1',style:'color: blue;margin-bottom: 10px;',tabIndex:'h1',id:'textbox2',label:'イベント - ondataload',escape:'false'}},{T:1,N:'w2:textbox',A:{tagname:'h2',style:'height: 23px;margin-bottom: 10px;color: blue;',id:'textbox3',label:'サンプルの使い方'}},{T:1,N:'w2:textbox',A:{style:'color: blue;margin-bottom: 30px;',id:'textbox4',label:'1. 下部のボタンをクリックします。 <br/>2. DataListにデータをロードするためにSubmissionが実行されます。 <br/>3. データのロードが完了すると、ondatalodイベントが発生し、GridViewにデータが表示されることを確認してください。 <br/>（イベントハンドラの詳細スクリプトは Script タブで確認。）<br/>',escape:'false'}},{T:1,N:'w2:textbox',A:{style:'padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightgreen;border:none;margin-bottom: 10px;',id:'textbox5',label:'イベント説明<br/>ondataload - DataListのデータが新しく設定または追加されたときに発生します。',escape:'false'}},{T:1,N:'xf:trigger',A:{type:'button',id:'trigger1',style:'height:42px;line-height:32px;padding:5px;background-color:coral;font-size:15px;weight: bolder;font-weight:bolder;text-align: left;display: block;margin-bottom: 10px;','ev:onclick':'scwin.trigger1_onclick'},E:[{T:1,N:'xf:label',E:[{T:4,cdata:'$p.executeSubmission("submission1");'}]}]},{T:1,N:'w2:gridView',A:{scrollByColumnAdaptive:'false',rowNumVisible:'true',visibleRowNumFix:'true',checkAllType:'false',dataList:'data:dataList1',style:'border: gray 1px solid;',scrollByColumn:'false',id:'gridView1',visibleRowNum:'10',autoFit:'allColumn',defaultCellHeight:'20',noResultMessageVisibleAlways:'true'},E:[{T:1,N:'w2:caption',A:{style:'',id:'caption1',value:'this is a grid caption.'}},{T:1,N:'w2:header',A:{style:'',id:'header1'},E:[{T:1,N:'w2:row',A:{style:'',id:'row1'},E:[{T:1,N:'w2:column',A:{width:'70',inputType:'text',style:'height:20px',id:'column9',value:'ID',displayMode:'label'}},{T:1,N:'w2:column',A:{width:'70',inputType:'text',style:'height:20px',id:'column8',va