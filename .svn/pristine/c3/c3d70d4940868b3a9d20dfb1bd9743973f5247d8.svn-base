<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare"
	xmlns:xf="http://www.w3.org/2002/xforms">
	<head meta_author="InswaveSystems" meta_type="메인" meta_screenName="[GridView] 바디 컬럼의 dataType 속성과 displayFormat 속성을 스크립트로 설정하기">
		<w2:historyInfo>
			<w2:history meta_no="01" meta_desc="최초작성" meta_date="20230120" meta_user="InswaveSystems"></w2:history>
			<w2:history meta_no="02" meta_desc="설명 추가 및 버튼 명 수정" meta_date="20230206" meta_user="InswaveSystems"></w2:history>
			<w2:history meta_no="03" meta_desc="설명부 수정" meta_date="20240621" meta_user="InswaveSystems"></w2:history>
			<w2:history meta_no="03" meta_desc="예제에서 사용하는 DataList가 변경되고, 이에 따른 GridVeiw의 설정이 수정되었습니다." meta_date="20240705"
				meta_user="InswaveSystems"></w2:history>
		</w2:historyInfo>
		<w2:type>COMPONENT</w2:type>
		<w2:buildDate />
		<w2:MSA />
		<xf:model>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" id="dlt_exam" repeatNode="map" style="" valueAttribute="">
					<w2:columnInfo>
						<w2:column dataType="text" id="col_a" name="A"></w2:column>
					</w2:columnInfo>
					<w2:data use="true">
						<w2:row>
							<col_a><![CDATA[2547869000]]></col_a>
						</w2:row>
						<w2:row>
							<col_a><![CDATA[8740500]]></col_a>
						</w2:row>
						<w2:row>
							<col_a><![CDATA[543900]]></col_a>
						</w2:row>
					</w2:data>
				</w2:dataList>
			</w2:dataCollection>
			<w2:workflowCollection />
		</xf:model>
		<w2:layoutInfo />
		<w2:publicInfo method="" />
		<script lazy="false" type="text/javascript"><![CDATA[
scwin.onpageload = function () {

};


/**
 * 버튼 ['A' 컬럼의 dataType 속성의 설정 값 반환받기] 클릭 시
 */
scwin.btn_ex1_1_onclick = function (e) {
    //GridView 'grd_exam1'의 'A' 컬럼의 dataType 속성의 값을 반환 받습니다.
    let returnValue = grd_exam1.getDataType("col_a");

    //로그 출력
    $c.frame.printExampleLog("** 메소드 scwin.btn_ex1_1_onclick **", txa_log, false);
    $c.frame.printExampleLog('grd_exam1.getDataType("col_a"); 반환 값 : ' + returnValue, txa_log, false);

    console.log("** 메소드 scwin.btn_ex1_1_onclick **");
    console.log('grd_exam1.getDataType("col_a"); 반환 값 : ' + returnValue);

    txa_log.focus();
};

/**
 * 버튼 ['A' 컬럼의 dataType 속성을 'number'로 설정하고 displayFormat 속성을 '#,###'으로 설정하기] 클릭 시
 */
scwin.btn_ex1_2_onclick = function (e) {
    //GridView 'grd_exam1'의 'A' 컬럼의 dataType 속성의 값을 'number'로 설정합니다.
    grd_exam1.setDataType("col_a", "number");
    //GridView 'grd_exam1'의 'A' 컬럼의 속성 displayFormat의 값을 '#,###'으로 설정합니다.
    grd_exam1.setColumnDisplayFormat("col_a", "#,###");
};

/**
 * 버튼 ['A' 컬럼의 dataType 속성을 'float'로 설정하고 displayFormat 속성을 '#,###.00'으로 설정하기] 클릭 시
 */
scwin.btn_ex1_3_onclick = function (e) {
    //GridView 'grd_exam1'의 'A' 컬럼의 dataType 속성을 'float'로 설정합니다.
    grd_exam1.setDataType("col_a", "float");
    //GridView 'grd_exam1'의 'A' 컬럼의 displayFormat 속성을 '#,###.00'으로 설정합니다.
    grd_exam1.setColumnDisplayFormat("col_a", "#,###.00");
};

/**
 * textarea의 로그 삭제
 */
scwin.btn_clearLog_onclick = function (e) {
    txa_log.setValue("");
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:group class="sub_contents" id="" style="">
			<xf:group class="ws_example_grp_desc" id="" style="">
				<w2:textbox escape="false" id=""
					label="GridView의 메소드를 사용하여 바디 컬럼의 'dataType' 속성과 'displayFormat' 속성을 설정하고, 'dataType' 속성의 설정값을 반환받는 예제입니다." style="">
				</w2:textbox>
			</xf:group>
			<xf:group class="example_div_tb_style_wrap" id="">
				<xf:group class="example_div_tr_style" id="" style="">
					<xf:group class="example_div_td_style" id="" style="">
						<xf:group class="mb_def_box nobottom" id="" style="">
							<xf:trigger class="btn_exam_exec btn_txt_of" disabled="" escape="false" ev:onclick="scwin.btn_ex1_1_onclick"
								id="btn_ex1_1" style="" type="button">
								<xf:label><![CDATA['A' 컬럼의 dataType 속성의 설정 값 반환받기 - 로그 출력]]></xf:label>
							</xf:trigger>
							<xf:trigger class="btn_exam_exec btn_txt_of" disabled="" escape="false" ev:onclick="scwin.btn_ex1_2_onclick"
								id="btn_ex1_2" style="" type="button">
								<xf:label><![CDATA['A' 컬럼의 dataType 속성을 'number'로 설정하고 displayFormat 속성을 '#,###'으로 설정하기]]></xf:label>
							</xf:trigger>
							<xf:trigger class="btn_exam_exec btn_txt_of" disabled="" escape="false" ev:onclick="scwin.btn_ex1_3_onclick"
								id="btn_ex1_3" style="" type="button">
								<xf:label><![CDATA['A' 컬럼의 dataType 속성을 'float'로 설정하고 displayFormat 속성을 '#,###.00'으로 설정하기]]></xf:label>
							</xf:trigger>
						</xf:group>
						<xf:group id="" class="gvwbox" style="max-width:210px;">
							<w2:gridView rowNumVisible="true" rowNumWidth="40" disabledBackgroundColor="#eee" defaultCellHeight="37"
								disabledFontColor="#bbb" visibleRowNumFix="true" dataList="data:dlt_exam" style="height:100px;" autoFit="lastColumn" id="grd_exam1"
								visibleRowNum="3" class="gvw" autoFitMinWidth="210">
								<w2:caption style="" id="caption1" value="this is a grid caption."></w2:caption>
								<w2:header style="" id="header1">
									<w2:row style="" id="row1">
										<w2:column width="70" inputType="text" id="column2" value="A" displayMode="label"></w2:column>
									</w2:row>
								</w2:header>
								<w2:gBody style="" id="gBody1">
									<w2:row style="" id="row2">
										<w2:column textAlign="right" width="70" inputType="text" id="col_a" displayMode="label"></w2:column>
									</w2:row>
								</w2:gBody>
							</w2:gridView>
						</xf:group>
					</xf:group>
				</xf:group>
			</xf:group>
			<xf:group class="example_div_tb_style_wrap" id="" style="">
				<xf:group class="example_div_tr_style" id="" style="">
					<xf:group class="example_div_th_style" id="">
						<w2:span class="mr_def txt_blue" id="" label="로그 확인" style=""></w2:span>
						<xf:trigger class="wre_btn_log_clear" ev:onclick="scwin.btn_clearLog_onclick" id="btn_clearLog" style="" title="로그 삭제"
							type="button">
							<xf:label><![CDATA[로그 삭제]]></xf:label>
						</xf:trigger>
					</xf:group>
					<xf:group class="example_div_td_style" id="" style="">
						<xf:textarea class="wre_txa_log" id="txa_log" spellcheck="false" style="width: 100%;height: 140px;"></xf:textarea>
					</xf:group>
				</xf:group>
			</xf:group>
		</xf:group>
	</body>
</html>