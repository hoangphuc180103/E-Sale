define({declaration:{A:{version:'1.0',encoding:'UTF-8'}},E:[{T:1,N:'html',A:{xmlns:'http://www.w3.org/1999/xhtml','xmlns:ev':'http://www.w3.org/2001/xml-events','xmlns:w2':'http://www.inswave.com/websquare','xmlns:xf':'http://www.w3.org/2002/xforms'},E:[{T:1,N:'head',E:[{T:1,N:'w2:type',E:[{T:3,text:'DEFAULT'}]},{T:1,N:'w2:buildDate'},{T:1,N:'xf:model',E:[{T:1,N:'w2:dataCollection',A:{baseNode:'map'}},{T:1,N:'w2:workflowCollection'}]},{T:1,N:'script',A:{type:'text/javascript',lazy:'false'},E:[{T:4,cdata:function(scopeObj){with(scopeObj){scwin.onpageload = function () {
  requires("uiplugin.popup");
};
scwin.onpageunload = function () {};
scwin.date_validate = function () {
  var tmpSrc = scwin.getfolderPath() + "/messagePopup.xml";
  var opts = {
    "id": "popup2",
    "type": "wframePopup",
    "width": "440px",
    "height": "200px",
    "top": 100,
    "left": 300,
    "popupName": "date_validation_error",
    "modal": true,
    "title": "date validation error",
    "dataObject": {
      "type": "string",
      "data": this.callerId,
      "name": "callerId"
    }
  };
  if (!$p.getPopup("popup2")) {
    $p.openPopup(tmpSrc, opts);
  }
};
scwin.getfolderPath = function () {
  var currentPath = window.location.href;
  var folderPath;
  if (currentPath.includes("mainContainer")) {
    console.log("true  ===> " + $p.getFrameId());
    const cmtFrame = $p.getComponentById($p.getFrameId());
    currentPath = cmtFrame.getSrc();
    folderPath = currentPath.substring(0, currentPath.lastIndexOf('/'));
  } else {
    console.log("false  ===> ");
    folderPath = currentPath.split('w2xPath=')[1].substring(0, currentPath.split('w2xPath=')[1].lastIndexOf('/'));
  }
  return folderPath;
};
}}}]}]},{T:1,N:'body',A:{'ev:onpageload':'scwin.onpageload','ev:onpageunload':'scwin.onpageunload'},E:[{T:1,N:'xf:group',A:{id:'',style:'margin:10px;'},E:[{T:1,N:'w2:textbox',A:{tagname:'h1',style:'color: blue;margin-bottom: 10px;',tabIndex:'h1',id:'textbox1',label:'日付検証のためのユーザー定義関数の使用',escape:'false'}},{T:1,N:'w2:textbox',A:{tagname:'h2',style:'height: 23px;margin-bottom: 10px;color: blue;',id:'textbox2',label:'サンプルの使い方'}},{T:1,N:'w2:textbox',A:{style:'color: blue;margin-bottom: 30px;',id:'textbox3',label:'1. 無効な日付を入力し、Enter キーを選択します。 <br/>2. invalidMessageFunc 属性値に設定した関数が実行されることを確認。 <br/>（この例では、エラーメッセージをポップアップと表示します。）<br/>（詳細なスクリプトは Script タブで確認）',escape:'false'}},{T:1,N:'w2:textbox',A:{style:'padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightblue;border:none;margin-bottom: 10px;',id:'textbox4',label:'プロパティの設定<br/>invalidMessageFunc="scwin.date_validate" <br/>dateValidSetCustom="true"',escape:'false'}},{T:1,N:'w2:textbox',A:{style:'padding:10px; padding-bottom:20px; text-align:left; font-size:15px; font-weight:bolder; border:brown 1px solid; background-color:ivory; margin-bottom:10px; margin-top:10px; color:brown;',id:'textbox5',label:'/// サンプルコード<br/><br/>scwin.date_validate = function() {<br/> &nbsp; &nbsp;var tmpSrc = scwin.getfolderPath() + "/messagePopup.xml";<br/><br/> &nbsp; &nbsp;var opts = {<br/> &nbsp; &nbsp; &nbsp; &nbsp;"id": "popup2",<br/> &nbsp; &nbsp; &nbsp; &nbsp;"type": "wframePopup",<br/> &nbsp; &nbsp; &nbsp; &nbsp;"width": "440px",<br/> &nbsp; &nbsp; &nbsp; &nbsp;"height": "200px",<br/> &nbsp; &nbsp; &nbsp; &nbsp;"top": 100,<br/> &nbsp; &nbsp; &nbsp; &nbsp;"left": 300,<br/> &nbsp; &nbsp; &nbsp; &nbsp;"popupName": "date_validation_error",<br/> &nbsp; &nbsp; &nbsp; &nbsp;"modal": true,<br/> &nbsp; &nbsp; &nbsp; &nbsp;"title": "date validation error",<br/> &nbsp; &nbsp; &nbsp; &nbsp;"dataObject": {<br/> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;"type": "string",<br/> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;"data"