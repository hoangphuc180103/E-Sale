<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head meta_vertical_guides="" meta_horizontal_guides="">
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            	<w2:dataList baseNode="list" repeatNode="map" id="dataList1" saveRemovedData="true">
            		<w2:columnInfo>
            			<w2:column id="col1" name="Year" dataType="text"></w2:column>
            			<w2:column id="col2" name="City" dataType="text"></w2:column>
            			<w2:column id="col3" name="Continent" dataType="text"></w2:column>
            			<w2:column id="col4" name="Expense" dataType="number"></w2:column>
            			<w2:column id="col5" name="Saving" dataType="text"></w2:column>
            		</w2:columnInfo>
            	</w2:dataList>
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
         <script type="text/javascript" lazy="false"><![CDATA[scwin.trigger1_onclick = function (e) {

    var options = {};
    options.startRowIndex = 1;
    options.startColumnIndex = 1;
    options.append = 1;
    pivot1.pivotExcelUpload(options);
};

scwin.trigger2_onclick = function (e) {
    var tmpSrc = scwin.getfolderPath() + "/Excel_for_pivotExcelUpload.xls";
    var name = "Excel_for_pivotExcelUpload.xls"
    scwin.downloadFile(tmpSrc, name);
};

scwin.onpageload = function () {
    var jsonData = [
        { "col1": "2017", "col2": "Seoul", "col3": "Asia", "col4": "250", "col5": "1000", "rowStatus": "R" }
        , { "col1": "2017", "col2": "Paris", "col3": "Europe", "col4": "223", "col5": "1000", "rowStatus": "R" }
        , { "col1": "2017", "col2": "Beijing", "col3": "Asia", "col4": "250", "col5": "1000", "rowStatus": "R" }
        , { "col1": "2017", "col2": "Bangkok", "col3": "Asia", "col4": "245", "col5": "1000", "rowStatus": "R" }
        , { "col1": "2017", "col2": "London", "col3": "Europe", "col4": "245", "col5": "1000", "rowStatus": "R" }
        , { "col1": "2018", "col2": "Seoul", "col3": "Asia", "col4": "209", "col5": "2000", "rowStatus": "R" }
        , { "col1": "2018", "col2": "Paris", "col3": "Europe", "col4": "223", "col5": "2000", "rowStatus": "R" }
        , { "col1": "2018", "col2": "Beijing", "col3": "Asia", "col4": "245", "col5": "2000", "rowStatus": "R" }
        , { "col1": "2018", "col2": "Bangkok", "col3": "Asia", "col4": "245", "col5": "2000", "rowStatus": "R" }
        , { "col1": "2018", "col2": "London", "col3": "Europe", "col4": "245", "col5": "2000", "rowStatus": "R" }
        , { "col1": "2019", "col2": "Seoul", "col3": "Asia", "col4": "250", "col5": "1000", "rowStatus": "R" }
        , { "col1": "2019", "col2": "Paris", "col3": "Europe", "col4": "213", "col5": "1000", "rowStatus": "R" }
        , { "col1": "2019", "col2": "Beijing", "col3": "Asia", "col4": "245", "col5": "1000", "rowStatus": "R" }
        , { "col1": "2019", "col2": "Bangkok", "col3": "Asia", "col4": "245", "col5": "1000", "rowStatus": "R" }
        , { "col1": "2019", "col2": "London", "col3": "Europe", "col4": "245", "col5": "1000", "rowStatus": "R" }];
    dataList1.setJSON(jsonData);

};

scwin.onpageunload = function () {

};

scwin.downloadFile = function(tmpSrc, name) {
    const link = document.createElement('a');
    link.href = tmpSrc;
    link.download = name;
    link.click();
}

scwin.getfolderPath = function () {

    var currentPath = window.location.href;
    var folderPath;

    if (currentPath.includes("mainContainer")) {
        console.log("true  ===> " + $p.getFrameId());
        const cmtFrame = $p.getComponentById($p.getFrameId());
        currentPath = cmtFrame.getSrc();
        folderPath = currentPath.substring(0, currentPath.lastIndexOf('/'));
    } else {
        console.log("false  ===> ");
        folderPath = currentPath.split('w2xPath=')[1].substring(0, currentPath.split('w2xPath=')[1].lastIndexOf('/'));
    }
    return folderPath;
};

]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload" ev:onpageunload="scwin.onpageunload">
    <xf:group id="" style="margin: 10px;">
    	<w2:textbox tagname="h1" style="color: blue;margin-bottom: 10px;" tabIndex="h1" id="textbox1" label="Excel → Pivot Upload&lt;br/&gt;"
    		escape="false">
    	</w2:textbox>
    	<w2:textbox tagname="h2" style="height: 23px;margin-bottom: 10px;color: blue;" id="textbox2" label="How to Use"></w2:textbox>
    	<w2:textbox style="color: blue;margin-bottom: 30px;" id="textbox3"
    		label="1. Prepare the Excel file. (Or, download a prepared excel by by clicking Download Excel buton below.)&lt;br/&gt;2. Click the pivotExcelUpload() button below.&lt;br/&gt;3. When the file selection window appears, select the Excel file.&lt;br/&gt;4. Confirm that the Excel file is uploaded to Pivot according to the pivotExcelUpload() method's option settings.&lt;br/&gt;(See the Script tab for detailed script.)"
    		escape="false">
    	</w2:textbox>
    	<xf:trigger ev:onclick="scwin.trigger1_onclick"
    		style="height:42px;line-height:32px;padding:5px;background-color:coral;font-size:15px;weight: bolder;font-weight:bolder;text-align: left;margin-bottom: 10px;"
    		id="trigger1" type="button">
    		<xf:label><![CDATA[pivotExcelUpload()]]></xf:label>
    	</xf:trigger>
    	<xf:trigger type="button" id="trigger2"
    		style="height:42px;line-height:32px;padding:5px;background-color:lightpink;font-size:15px;weight: bolder;font-weight:bolder;text-align: left;margin-bottom: 10px;margin-left: 30px;"
    		ev:onclick="scwin.trigger2_onclick">
    		<xf:label><![CDATA[Download Excel]]></xf:label>
    	</xf:trigger>
    	<w2:pivot grandTotalDisplayType="" sortFunction="" grandTotalName="" allTotalName="" vals="col4,col5" noColumnMove="true"
    		rows="col2" valuesAxis="" showGrandTotal="true" headerListOrder="col,row,val,hidden" totalTextAlign="" dataList="data:dataList1"
    		style="height: 500px;margin-bottom: 10px;" autoFit="" id="pivot1" cols="col1" autoFitMinWidth="100">
    		<w2:fieldInfo style="padding: 10px;">
    			<w2:field name="Year" id="col1"></w2:field>
    			<w2:field name="City" id="col2"></w2:field>
    			<w2:field name="Continent" id="col3"></w2:field>
    			<w2:field name="Expense" id="col4"></w2:field>
    			<w2:field name="Saving" id="col5"></w2:field>
    		</w2:fieldInfo>
    	</w2:pivot>
    	<w2:textbox escape="false" id="textbox4"
    		label='/// Sample Code &lt;br/&gt;&lt;br/&gt;var options = {};&lt;br/&gt;options.startRowIndex = 1;&lt;br/&gt;options.startColumnIndex = 1;&lt;br/&gt;options.append = 1;&lt;br/&gt;pivot1.pivotExcelUpload(options);'
    		style="padding:10px; padding-bottom:20px; text-align:left; font-size:15px; font-weight:bolder; border:brown 1px solid; background-color:ivory; margin-bottom:10px; color:brown;"
    		tagname="">
    	</w2:textbox>
    </xf:group></body>
</html>
