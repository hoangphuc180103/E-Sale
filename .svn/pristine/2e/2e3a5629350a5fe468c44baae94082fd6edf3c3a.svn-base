    <body ev:onpageload="scwin.onpageload" ev:onpageunload="scwin.onpageunload">
    	<xf:group id="" style="margin: 10px;">
    		<w2:textbox escape="false" id="textbox1" label="Event - oncelldblclick&lt;br/&gt;" style="color: blue;margin-bottom: 10px;"
    			tabIndex="h1" tagname="h1">
    		</w2:textbox>
    		<w2:textbox id="textbox2" label="How to Use" style="height: 23px;margin-bottom: 10px;color: blue;" tagname="h2"></w2:textbox>
    		<w2:textbox escape="false" id="textbox3"
    			label='1. Double-click any cell in the GridView.&lt;br/&gt;2. Confirm that the oncelldblclick event is triggered.&lt;br/&gt;(See the Script tab for the detailed event handler script.)'
    			style="color: blue;margin-bottom: 30px;">
    		</w2:textbox>
    		<w2:textbox
    			style="padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightgreen;border:none;margin-bottom: 10px;"
    			id="textbox4" label="Event Description&lt;br/&gt;&lt;br/&gt;oncelldblclick - Fired when a cell is double-clicked." escape="false">
    		</w2:textbox>
    		<w2:gridView scrollByColumnAdaptive="false" rowNumVisible="true" checkAllType="false" dataList="data:dataList1"
    			scrollByColumn="false" style="border: gray solid 1px;" autoFit="allColumn" id="gridView1" visibleRowNum="10" sortable="true"
    			ev:oncelldblclick="scwin.gridView1_oncelldblclick" defaultCellHeight="20" visibleRowNumFix="true">
    			<w2:caption style="" id="caption1" value="this is a grid caption."></w2:caption>
    			<w2:header style="" id="header1">
    				<w2:row style="" id="row1">
    					<w2:column width="70" inputType="text" style="height:20px" id="column8" value="Date" displayMode="label"></w2:column>
    					<w2:column width="70" inputType="text" style="height:20px" id="column7" value="Expense" displayMode="label"></w2:column>
    					<w2:column width="70" inputType="text" style="height:20px" id="column6" value="Income" displayMode="label"></w2:column>
    					<w2:column width="70" inputType="text" style="height:20px" id="column5" value="Hobby" displayMode="label"></w2:column>
    					<w2:column width="70" inputType="text" style="height:20px" id="column1" value="Age" displayMode="label"></w2:column>
    				</w2:row>
    			</w2:header>
    			<w2:gBody style="" id="gBody1">
    				<w2:row style="" id="row2">
    					<w2:column width="70" inputType="text" style="height:20px" id="Date" value="" displayMode="label"></w2:column>
    					<w2:column width="70" inputType="text" style="height:20px" id="Expense" value="" displayMode="label"></w2:column>
    					<w2:column width="70" inputType="text" style="height:20px" id="Income" value="" displayMode="label"></w2:column>
    					<w2:column width="70" inputType="text" style="height:20px" id="Hobby" value="" displayMode="label"></w2:column>
    					<w2:column width="70" inputType="text" style="height:20px" id="Age" value="" displayMode="label"></w2:column>
    				</w2:row>
    			</w2:gBody>
    		</w2:gridView>
    		<w2:textbox id="textbox5" label='/// Sample Code &lt;br/&gt;&lt;br/&gt;scwin.gridView1_oncelldblclick = function (row, col, colId) {&lt;br/&gt; &amp;nbsp; &amp;nbsp;if (colId == "Expense") {&lt;br/&gt; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;var total = dataList1.getCellData(row, "Income");&lt;br/&gt; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;alert("oncelldblclick - The income is KRW " + total + ".");&lt;br/&gt; &amp;nbsp; &amp;nbsp;}&lt;br/&gt; &amp;nbsp; &amp;nbsp;else { &lt;br/&gt; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;alert("oncelldblclick - Select Expense.");&lt;br/&gt; &amp;nbsp; &amp;nbsp;}&lt;br/&gt;};' style="padding:10px; padding-bottom:20px; text-align:left; font-size:15px; font-weight:bolder; border:brown 1px solid; background-color:ivory; margin-bottom:10px; margin-top:10px; color:brown;" escape="false"></w2:textbox>
    	</xf:group>
    </body>
</html>
