		<w2:MSA />
		<xf:model>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" id="dlt_chart" repeatNode="map" saveRemovedData="true" style="">
					<w2:columnInfo>
						<w2:column dataType="text" id="type" name="name1"></w2:column>
						<w2:column dataType="text" id="count" name="name2"></w2:column>
					</w2:columnInfo>
					<w2:data use="true">
						<w2:row>
							<count><![CDATA[1465]]></count>
							<type><![CDATA[컴퓨터]]></type>
						</w2:row>
