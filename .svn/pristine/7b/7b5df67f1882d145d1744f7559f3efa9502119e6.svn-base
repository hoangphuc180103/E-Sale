    <xf:group id="" style="margin: 10px;">
    	<w2:textbox tagname="h1" style="color: blue;margin-bottom: 10px;" tabIndex="h1" id="textbox1" label="컬럼 폭 자동 맞춤" escape="false"></w2:textbox>
    	<w2:textbox tagname="h2" style="height: 23px;margin-bottom: 10px;color: blue;" id="textbox2" label="샘플 사용 방법"></w2:textbox>
    	<w2:textbox style="color: blue;margin-bottom: 30px;" id="textbox3"
    		label='autoFit 속성 설정에 따라 GridView가 표시되는 것을 확인. &lt;br/&gt;1. autoFit="lastColumn" : 마지막 컬럼 폭만 자동 맞춤되는 것을 확인. &lt;br/&gt;2. autoFit="allColumn" 모든 컬럼의 폭이 자동 맞춤되는 것을 확인. &lt;br/&gt;3. autoFit="none" : 컬럼 폭 자동 맞춤이 적용되지 않는 것을 확인.'
    		escape="false">
    	</w2:textbox>
    	<w2:textbox
    		style="padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightblue;border:none;margin-bottom: 10px;"
    		id="textbox4" label='속성 설정&lt;br/&gt;autoFit="lastColumn"' escape="false">
    	</w2:textbox>
    	<w2:gridView scrollByColumnAdaptive="false" rowNumVisible="" dataDragDrop="true" selectedRowColor="" useShiftKey="true"
    		useCtrlOnMultisort="" scrollByColumn="false" dataDragDropStatus="true" keepDefaultColumnWidth="" defaultCellHeight="20"
    		focusMode="both" selectedCellColor="" rowStatusVisible="" contextMenu="true" dataList="data:dataList1" dataDragSelect=""
    		style="border: solid 1px gray;margin-bottom: 10px;" id="gridView1" autoFit="lastColumn" visibleRowNum="5" useCtrlKey=""
    		visibleRowNumFix="true">
    		<w2:caption style="" id="caption1" value="this is a grid caption."></w2:caption>
    		<w2:header style="" id="header1">
    			<w2:row style="" id="row1">
    				<w2:column width="70" inputType="text" style="" id="column11" value="Check" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="" id="column2" value="ID" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="" id="column8" value="Date" displayMode="label"></w2:column>
    				<w2:column rowSpan="" colSpan="" width="70" inputType="text" style="" id="column7" value="Expense"
    					displayMode="label">
    				</w2:column>
    			</w2:row>
    		</w2:header>
    		<w2:gBody style="" id="gBody1">
    			<w2:row style="" id="row2">
    				<w2:column width="50" inputType="checkbox" style="height:20px" id="Check" value="" displayMode="label"></w2:column>
    				<w2:column width="20" inputType="text" style="height:20px" id="ID" value="" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="height:20px" id="Date" value="" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="height:20px" id="Expense" value="" displayMode="label"></w2:column>
    			</w2:row>
    		</w2:gBody>
    	</w2:gridView>
    	<w2:textbox escape="false" id="textbox5" label='속성 설정&lt;br/&gt;autoFit="allColumn"'
    		style="padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightblue;border:none;margin-bottom: 10px;">
    	</w2:textbox>
    	<w2:gridView autoFit="allColumn" contextMenu="true" dataDragDrop="true" dataDragDropStatus="true" dataDragSelect=""
    		dataList="data:dataList1" defaultCellHeight="20" focusMode="both" id="gridView2" keepDefaultColumnWidth="" rowNumVisible=""
    		rowStatusVisible="" scrollByColumn="false" scrollByColumnAdaptive="false" selectedCellColor="" selectedRowColor=""
    		style="border: solid 1px gray;margin-bottom: 10px;" useCtrlKey="" useCtrlOnMultisort="" useShiftKey="true" visibleRowNum="5"
    		visibleRowNumFix="true">
    		<w2:caption id="caption2" style="" value="this is a grid caption."></w2:caption>
    		<w2:header id="header1" style="">
    			<w2:row id="row1" style="">
    				<w2:column displayMode="label" id="column11" inputType="text" style="" value="Check" width="70"></w2:column>
    				<w2:column displayMode="label" id="column2" inputType="text" style="" value="ID" width="70"></w2:column>
    				<w2:column displayMode="label" id="column8" inputType="text" style="" value="Date" width="70"></w2:column>
    				<w2:column colSpan="" displayMode="label" id="column7" inputType="text" rowSpan="" style="" value="Expense"
    					width="70">
    				</w2:column>
    			</w2:row>
    		</w2:header>
    		<w2:gBody id="gBody1" style="">
    			<w2:row id="row2" style="">
    				<w2:column displayMode="label" id="Check" inputType="checkbox" style="height:20px" value="" width="50"></w2:column>
    				<w2:column displayMode="label" id="ID" inputType="text" style="height:20px" value="" width="20"></w2:column>
    				<w2:column displayMode="label" id="Date" inputType="text" style="height:20px" value="" width="70"></w2:column>
    				<w2:column displayMode="label" id="Expense" inputType="text" style="height:20px" value="" width="70"></w2:column>
    			</w2:row>
    		</w2:gBody>
    	</w2:gridView>
    	<w2:textbox escape="false" id="textbox6" label='속성 설정&lt;br/&gt;autoFit="none"'
    		style="padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightblue;border:none;margin-bottom: 10px;">
    	</w2:textbox>
    	<w2:gridView autoFit="none" contextMenu="true" dataDragDrop="true" dataDragDropStatus="true" dataDragSelect=""
    		dataList="data:dataList1" defaultCellHeight="20" focusMode="both" id="gridView3" keepDefaultColumnWidth="" rowNumVisible=""
    		rowStatusVisible="" scrollByColumn="false" scrollByColumnAdaptive="false" selectedCellColor="" selectedRowColor=""
    		style="border: solid 1px gray;visiblerow" useCtrlKey="" useCtrlOnMultisort="" useShiftKey="true" visibleRowNum="5"
    		visibleRowNumFix="true">
    		<w2:caption id="caption3" style="" value="this is a grid caption."></w2:caption>
    		<w2:header id="header1" style="">
    			<w2:row id="row1" style="">
    				<w2:column displayMode="label" id="column11" inputType="text" style="" value="Check" width="70"></w2:column>
    				<w2:column displayMode="label" id="column2" inputType="text" style="" value="ID" width="70"></w2:column>
    				<w2:column displayMode="label" id="column8" inputType="text" style="" value="Date" width="70"></w2:column>
    				<w2:column colSpan="" displayMode="label" id="column7" inputType="text" rowSpan="" style="" value="Expense"
    					width="70">
    				</w2:column>
    			</w2:row>
    		</w2:header>
    		<w2:gBody id="gBody1" style="">
    			<w2:row id="row2" style="">
    				<w2:column displayMode="label" id="Check" inputType="checkbox" style="height:20px" value="" width="50"></w2:column>
    				<w2:column displayMode="label" id="ID" inputType="text" style="height:20px" value="" width="20"></w2:column>
    				<w2:column displayMode="label" id="Date" inputType="text" style="height:20px" value="" width="70"></w2:column>
    				<w2:column displayMode="label" id="Expense" inputType="text" style="height:20px" value="" width="70"></w2:column>
    			</w2:row>
    		</w2:gBody>
    	</w2:gridView>
    </xf:group></body>
</html>
