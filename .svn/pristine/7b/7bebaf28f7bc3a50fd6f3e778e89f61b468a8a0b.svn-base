<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare"
	xmlns:xf="http://www.w3.org/2002/xforms">
	<head meta_author="InswaveSystems" meta_type="메인" meta_screenName="[GridView] 셀 단위로 상태 아이콘 표시하기">
		<w2:historyInfo>
			<w2:history meta_no="01" meta_desc="최초작성" meta_date="20231101" meta_user="InswaveSystems"></w2:history>
			<w2:history meta_no="02" meta_desc="설명부 수정" meta_date="20240621" meta_user="InswaveSystems"></w2:history>
			<w2:history meta_no="03" meta_desc="예제에서 사용하는 DataList가 변경되고, 이에 따른 GridView의 설정이 수정되었습니다." meta_date="20240712"
				meta_user="InswaveSystems"></w2:history>
		</w2:historyInfo>
		<w2:type>COMPONENT</w2:type>
		<w2:buildDate />
		<w2:MSA />
		<xf:model>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" repeatNode="map" id="dlt_exam" saveRemovedData="true">
					<w2:columnInfo>
						<w2:column dataType="text" name="A" id="col_a"></w2:column>
						<w2:column dataType="text" name="B" id="col_b"></w2:column>
						<w2:column dataType="text" name="C" id="col_c"></w2:column>
					</w2:columnInfo>
					<w2:data use="true">
						<w2:row>
							<col_a><![CDATA[A1]]></col_a>
							<col_b><![CDATA[B1]]></col_b>
							<col_c><![CDATA[C1]]></col_c>
						</w2:row>
						<w2:row>
							<col_a><![CDATA[A2]]></col_a>
							<col_b><![CDATA[B2]]></col_b>
							<col_c><![CDATA[C2]]></col_c>
						</w2:row>
						<w2:row>
							<col_a><![CDATA[A3]]></col_a>
							<col_b><![CDATA[B3]]></col_b>
							<col_c><![CDATA[C3]]></col_c>
						</w2:row>
					</w2:data>
				</w2:dataList>
			</w2:dataCollection>
			<w2:workflowCollection />
		</xf:model>
		<w2:layoutInfo />
		<w2:publicInfo method="" />
		<script lazy="false" type="text/javascript"><![CDATA[
scwin.onpageload = function () {
    // DataList에 로우 추가, 로우 삭제, 셀 값 변경
    scwin.setDataStatus();
};

/**
 * DataList의 값 변경
 */
scwin.setDataStatus = function () {
    // 셀 수정
    dlt_exam.setCellData(1, "col_a", "A999");

    // 로우 삭제
    dlt_exam.deleteRow(2);

    // 로우 추가
    dlt_exam.insertRow(1);
};]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:group class="sub_contents" id="" style="">
			<xf:group class="ws_example_grp_desc" id="" style="">
				<w2:textbox escape="false" id="" label="GridView의 'cellStatusVisible' 속성을 사용하여 상태 아이콘이 셀 단위로 표시되도록 설정한 예제입니다." style="">
				</w2:textbox>
			</xf:group>
			<xf:group class="example_div_tb_style_wrap" id="">
				<xf:group class="example_div_tr_style" id="" style="">
					<w2:textbox class="example_div_th_style" escape="false" id="" label="셀 단위 상태를 우측 상단에 표시하기" style=""></w2:textbox>
					<xf:group class="example_div_td_style" id="" style="">
						<xf:group id="" class="gvwbox">
							<w2:gridView rowStatusWidth="40" keepDefaultColumnWidth="true" defaultCellHeight="37" rowStatusVisible="true"
								visibleRowNumFix="true" dataList="data:dlt_exam" style="height:100px;" cellStatusIconPosition="right" autoFit="allColumn" id=""
								visibleRowNum="4" class="gvw" cellStatusVisible="true" autoFitMinWidth="260">
								<w2:caption style="" id="caption1" value="this is a grid caption."></w2:caption>
								<w2:header id="header1">
									<w2:row id="row1">
										<w2:column width="70" inputType="text" id="h_col_a" value="A" displayMode="label"></w2:column>
										<w2:column width="70" inputType="text" id="h_col_b" value="B" displayMode="label"></w2:column>
										<w2:column width="70" inputType="text" id="h_col_c" value="C" displayMode="label"></w2:column>
									</w2:row>
								</w2:header>
								<w2:gBody id="gBody1">
									<w2:row id="row2">
										<w2:column width="70" inputType="text" id="col_a" displayMode="label"></w2:column>
										<w2:column width="70" inputType="text" id="col_b" displayMode="label"></w2:column>
										<w2:column width="70" inputType="text" id="col_c" displayMode="label"></w2:column>
									</w2:row>
								</w2:gBody>
							</w2:gridView>
						</xf:group>
					</xf:group>
				</xf:group>
				<xf:group class="example_div_tr_style" id="" style="">
					<w2:textbox class="example_div_th_style" escape="false" id="" label="셀 단위 상태를 좌측 상단에 표시하기" style=""></w2:textbox>
					<xf:group class="example_div_td_style" id="" style="">
						<xf:group id="" class="gvwbox">
							<w2:gridView rowStatusWidth="40" keepDefaultColumnWidth="true" defaultCellHeight="37" rowStatusVisible="true"
								visibleRowNumFix="true" dataList="data:dlt_exam" style="height:100px;" cellStatusIconPosition="left" autoFit="allColumn" id=""
								visibleRowNum="4" class="gvw" cellStatusVisible="true" autoFitMinWidth="260">
								<w2:caption style="" id="caption1" value="this is a grid caption."></w2:caption>
								<w2:header id="header1">
									<w2:row id="row1">
										<w2:column width="70" inputType="text" id="h_col_a" value="A" displayMode="label"></w2:column>
										<w2:column width="70" inputType="text" id="h_col_b" value="B" displayMode="label"></w2:column>
										<w2:column width="70" inputType="text" id="h_col_c" value="C" displayMode="label"></w2:column>
									</w2:row>
								</w2:header>
								<w2:gBody id="gBody1">
									<w2:row id="row2">
										<w2:column width="70" inputType="text" id="col_a" displayMode="label"></w2:column>
										<w2:column width="70" inputType="text" id="col_b" displayMode="label"></w2:column>
										<w2:column width="70" inputType="text" id="col_c" displayMode="label"></w2:column>
									</w2:row>
								</w2:gBody>
							</w2:gridView>
						</xf:group>
					</xf:group>
				</xf:group>
				<xf:group class="example_div_tr_style" id="" style="">
					<w2:textbox class="example_div_th_style" escape="false" id="" label="(기본 설정) 셀 단위 상태 미표시" style=""></w2:textbox>
					<xf:group class="example_div_td_style" id="" style="">
						<xf:group class="gvwbox" id="">
							<w2:gridView autoFit="allColumn" autoFitMinWidth="260" cellStatusVisible="false" class="gvw" dataList="data:dlt_exam"
								defaultCellHeight="37" id="" keepDefaultColumnWidth="true" rowStatusVisible="true" rowStatusWidth="40" style="height:100px;"
								visibleRowNum="4" visibleRowNumFix="true">
								<w2:caption id="caption1" style="" value="this is a grid caption."></w2:caption>
								<w2:header id="header1">
									<w2:row id="row1">
										<w2:column width="70" inputType="text" id="h_col_a" value="A" displayMode="label"></w2:column>
										<w2:column width="70" inputType="text" id="h_col_b" value="B" displayMode="label"></w2:column>
										<w2:column width="70" inputType="text" id="h_col_c" value="C" displayMode="label"></w2:column>
									</w2:row>
								</w2:header>
								<w2:gBody id="gBody1">
									<w2:row id="row2">
										<w2:column width="70" inputType="text" id="col_a" displayMode="label"></w2:column>
										<w2:column width="70" inputType="text" id="col_b" displayMode="label"></w2:column>
										<w2:column width="70" inputType="text" id="col_c" displayMode="label"></w2:column>
									</w2:row>
								</w2:gBody>
							</w2:gridView>
						</xf:group>
					</xf:group>
				</xf:group>
			</xf:group>
		</xf:group>
	</body>
</html>