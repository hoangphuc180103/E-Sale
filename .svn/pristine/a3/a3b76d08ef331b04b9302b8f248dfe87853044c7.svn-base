define({declaration:{A:{version:'1.0',encoding:'UTF-8'}},E:[{T:1,N:'html',A:{xmlns:'http://www.w3.org/1999/xhtml','xmlns:ev':'http://www.w3.org/2001/xml-events','xmlns:w2':'http://www.inswave.com/websquare','xmlns:xf':'http://www.w3.org/2002/xforms'},E:[{T:1,N:'head',E:[{T:1,N:'w2:type',E:[{T:3,text:'DEFAULT'}]},{T:1,N:'w2:buildDate'},{T:1,N:'xf:model',E:[{T:1,N:'w2:dataCollection',A:{baseNode:'map'}},{T:1,N:'w2:workflowCollection'}]},{T:1,N:'script',A:{type:'text/javascript',lazy:'false'},E:[{T:4,cdata:function(scopeObj){with(scopeObj){scwin.onpageload = function () {
  requires("uiplugin.popup");
  var parentFrameId = $p.getFrame().getParentFrame().getParentFrame().id;
  radio1.addItem(parentFrameId, parentFrameId, 3);
};
scwin.onpageunload = function () {};
scwin.trigger1_onclick = function (e) {
  var tmpSrc = scwin.getfolderPath() + "/14_popUp_02A_src.xml";
  var frameId = radio1.getValue();
  var options = {
    id: "modal",
    type: "wframePopup",
    // "iframePopup"
    width: "250px",
    height: "150px",
    top: "20px",
    left: "20px",
    popupName: frameId,
    modal: "true",
    frameModal: frameId
  };
  $p.openPopup(tmpSrc, options);
};
scwin.getfolderPath = function () {
  var currentPath = window.location.href;
  var folderPath;
  if (currentPath.includes("mainContainer")) {
    console.log("true  ===> " + $p.getFrameId());
    const cmtFrame = $p.getComponentById($p.getFrameId());
    currentPath = cmtFrame.getSrc();
    folderPath = currentPath.substring(0, currentPath.lastIndexOf('/'));
  } else {
    console.log("false  ===> ");
    folderPath = currentPath.split('w2xPath=')[1].substring(0, currentPath.split('w2xPath=')[1].lastIndexOf('/'));
  }
  return folderPath;
};
}}}]}]},{T:1,N:'body',A:{'ev:onpageload':'scwin.onpageload','ev:onpageunload':'scwin.onpageunload'},E:[{T:1,N:'w2:textbox',A:{style:'margin-bottom:10px;font-size:20px;font-weight:bolder;font-style:italic;text-align:left;margin: 10px;',id:'textbox1',label:'13_popUp_02A.xml'}},{T:1,N:'xf:group',A:{id:'',style:'margin: 20px;'},E:[{T:1,N:'xf:select1',A:{ref:'',appearance:'full',style:'margin-bottom: 10px;',id:'radio1',rows:'',cols:'1',selectedIndex:'-1'},E:[{T:1,N:'xf:choices',E:[{T:1,N:'xf:item',E:[{T:1,N:'xf:label',E:[{T:4,cdata:'frame'}]},{T:1,N:'xf:value',E:[{T:4,cdata:'frame'}]}]},{T:1,N:'xf:item',E:[{T:1,N:'xf:label',E:[{T:4,cdata:'parent'}]},{T:1,N:'xf:value',E:[{T:4,cdata:'parent'}]}]},{T:1,N:'xf:item',E:[{T:1,N:'xf:label',E:[{T:4,cdata:'top'}]},{T:1,N:'xf:value',E:[{T:4,cdata:'top'}]}]}]}]},{T:1,N:'xf:trigger',A:{'ev:onclick':'scwin.trigger1_onclick',style:'height:42px;line-height:32px;padding:5px;background-color:coral;font-size:15px;weight: bolder;font-weight:bolder;text-align: left;display: block;margin-top: 0px;',id:'trigger1',type:'button'},E:[{T:1,N:'xf:label',E:[{T:4,cdata:'$p.openPopup(options) - options.frameModal'}]}]}]}]}]}]})