<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head meta_screenName="Accordion">
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
         <script type="text/javascript" lazy="false"><![CDATA[

scwin.onpageload = function () {

};

scwin.onpageunload = function () {

};

]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload" ev:onpageunload="scwin.onpageunload">
    	<xf:group style="margin: 10px;" id="grp1">


    		<w2:textbox escape="false" id="textbox1" label="패널의 열린 상태를 유지" style="margin-bottom: 10px;color: blue;" tagname="h1"></w2:textbox>
    		<w2:textbox id="textbox2" label="샘플 사용 방법" style="height: 23px;margin-bottom: 10px;color: blue;" tagname="h2"></w2:textbox>
    		<w2:textbox escape="false" id="textbox3"
    			label='(첫 번째 Accordion) &lt;br/&gt;1-1. 한 패널을 열기.&lt;br/&gt;1-2. 다른 패널을 열기. &lt;br/&gt;1-3. 위 1단계에서 연 패널의 열린 상태가 유지되는 것을 확인. (independentPanel="true")&lt;br/&gt;&lt;br/&gt;(두 번째 Accordion) &lt;br/&gt;2-1. 한 패널을 열기.&lt;br/&gt;2-2. 다른 패널을 열기. &lt;br/&gt;3. 위 1단계에서 연 패널이 닫히는 것을 확인. 즉, 한 개의 패널만 열릴 수 있는 것을 확인. (independentPanel="false")'
    			style="color: blue;margin-bottom: 30px;">
    		</w2:textbox>
    		<w2:textbox escape="false" id="textbox4" label='속성 설정&lt;br/&gt;independentPanel="true"'
    			style="padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightblue;border:none;margin-bottom: 20px;">
    		</w2:textbox>
    		<w2:accordion collapseAll="true" independentPanel="true" style="border:solid 2px gray;margin-bottom: 10px;" id="accodion1" selectedPanel=""
    			unCollapseAll="true" collapsible="true">
    			<w2:panels style="" id="panel1" class="">
    				<w2:panelTitle style="" id="panelTitle1" label="Panel 1"></w2:panelTitle>
    				<w2:panelContent style="" id="panelContent1">
    					<xf:input adjustMaxLength="false" style="width: 144px;height: 21px;" id=""></xf:input>
    				</w2:panelContent>
    			</w2:panels>
    			<w2:panels style="" id="panel2" class="">
    				<w2:panelTitle style="" id="panelTitle2" label="Panel 2">

    				</w2:panelTitle>
    				<w2:panelContent style="" id="panelContent2">
    					<w2:calendar footerDiv="false" style="width: 100px;height: 100px;" id=""
    						monthNames="Jan, Feb, Mar, Apr, May, Jun, Jul, Aug, Sep, Nov, Dec" yearSuffix="Y">
    					</w2:calendar>
    				</w2:panelContent>
    			</w2:panels>
    			<w2:panels style="" id="panel3" class="">
    				<w2:panelTitle style="" id="panelTitle3" label="Panel 3"></w2:panelTitle>
    				<w2:panelContent style="" id="panelContent3">
    					<w2:calendar footerDiv="false" style="width: 100px;height: 100px;" id=""
    						monthNames="Jan, Feb, Mar, Apr, May, Jun, Jul, Aug, Sep, Nov, Dec" yearSuffix="Y">
    					</w2:calendar>
    				</w2:panelContent>
    			</w2:panels>
    		</w2:accordion>
    		<w2:textbox escape="false" id="textbox5" label='속성 설정&lt;br/&gt;independentPanel="false"'
    			style="padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightblue;border:none;margin-bottom: 20px;">
    		</w2:textbox>
    		<w2:accordion collapseAll="true" collapsible="true" id="accordion2" selectedPanel=""
    			style="border:solid 2px gray;" unCollapseAll="true">
    			<w2:panels class="" id="panels4" style="">
    				<w2:panelTitle id="panelTitle4" label="Panel 1" style=""></w2:panelTitle>
    				<w2:panelContent id="panelContent4" style="">
    					<xf:input adjustMaxLength="false" id="" style="width: 144px;height: 21px;"></xf:input>
    				</w2:panelContent>
    			</w2:panels>
    			<w2:panels class="" id="panels5" style="">
    				<w2:panelTitle id="panelTitle5" label="Panel 2" style=""></w2:panelTitle>
    				<w2:panelContent id="panelContent5" style="">
    					<w2:calendar footerDiv="false" id="" monthNames="Jan, Feb, Mar, Apr, May, Jun, Jul, Aug, Sep, Nov, Dec"
    						style="width: 100px;height: 100px;" yearSuffix="Y">
    					</w2:calendar>
    				</w2:panelContent>
    			</w2:panels>
    			<w2:panels class="" id="panels6" style="">
    				<w2:panelTitle id="panelTitle6" label="Panel 3" style=""></w2:panelTitle>
    				<w2:panelContent id="panelContent6" style="">
    					<w2:calendar footerDiv="false" id="" monthNames="Jan, Feb, Mar, Apr, May, Jun, Jul, Aug, Sep, Nov, Dec"
    						style="width: 100px;height: 100px;" yearSuffix="Y">
    					</w2:calendar>
    				</w2:panelContent>
    			</w2:panels>
    		</w2:accordion>
    	</xf:group>
    </body>
</html>
