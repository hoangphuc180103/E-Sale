define({declaration:{A:{version:'1.0',encoding:'UTF-8'}},E:[{T:1,N:'html',A:{xmlns:'http://www.w3.org/1999/xhtml','xmlns:ev':'http://www.w3.org/2001/xml-events','xmlns:w2':'http://www.inswave.com/websquare','xmlns:xf':'http://www.w3.org/2002/xforms'},E:[{T:1,N:'head',A:{},E:[{T:1,N:'w2:type',E:[{T:3,text:'DEFAULT'}]},{T:1,N:'w2:buildDate'},{T:1,N:'xf:model',E:[{T:1,N:'w2:dataCollection',A:{baseNode:'map'}},{T:1,N:'w2:workflowCollection'}]},{T:1,N:'script',A:{type:'text/javascript',lazy:'false'},E:[{T:4,cdata:function(scopeObj){with(scopeObj){scwin.onpageload = function () {
  requires("uiplugin.popup");
};
scwin.onpageunload = function () {};
scwin.trigger1_onclick = function (e) {
  const tmpSrc = scwin.getfolderPath() + "/adaptive_adaptiveThreshold_TableLayout.xml";
  var options = {
    id: "popup1",
    type: "wframePopup",
    height: "400px",
    width: "1100px",
    resizable: true,
    adaptiveFrame: "true"
  };
  $p.openPopup(tmpSrc, options);
};
scwin.trigger2_onclick = function (e) {
  const tmpSrc = scwin.getfolderPath() + "/adaptive_adaptiveThreshold_TableLayout.xml";
  var options = {
    id: "popup1",
    type: "wframePopup",
    height: "400px",
    width: "1100px",
    resizable: true,
    adaptiveFrame: "false"
  };
  $p.openPopup(tmpSrc, options);
};
scwin.getfolderPath = function () {
  var currentPath = window.location.href;
  var folderPath;
  if (currentPath.includes("mainContainer")) {
    console.log("true  ===> " + $p.getFrameId());
    const cmtFrame = $p.getComponentById($p.getFrameId());
    currentPath = cmtFrame.getSrc();
    folderPath = currentPath.substring(0, currentPath.lastIndexOf('/'));
  } else {
    console.log("false  ===> ");
    folderPath = currentPath.split('w2xPath=')[1].substring(0, currentPath.split('w2xPath=')[1].lastIndexOf('/'));
  }
  return folderPath;
};
}}}]}]},{T:1,N:'body',A:{'ev:onpageload':'scwin.onpageload','ev:onpageunload':'scwin.onpageunload'},E:[{T:1,N:'xf:group',A:{id:'',style:'margin: 10px;'},E:[{T:1,N:'w2:textbox',A:{tagname:'h1',style:'color: blue;margin-bottom: 10px;',id:'textbox1',label:'Apply Adaptive Design Based on Popup Size<br/>',escape:'false'}},{T:1,N:'w2:textbox',A:{tagname:'h2',style:'height: 23px;margin-bottom: 10px;color: blue;',id:'textbox2',label:'How to Use'}},{T:1,N:'w2:textbox',A:{style:'color: blue;margin-bottom: 30px;',id:'textbox3',label:'1-1. Click the first button.<br/>1-2. Adjust the size of the generated popup.<br/>1-3. Verify that adaptive design is applied to the popup\'s source (src) screen based on the popup size. (adaptiveFrame: “true”)<br/>(See the Script tab for detailed script.)<br/><br/>2-1. Click the second button.<br/>2-2. Adjust the size of the generated popup.<br/>2-3. Verify that adaptive design is not applied regardless of the popup size. (adaptiveFrame: “false”)<br/>(See the Script tab for detailed script.)',escape:'false'}},{T:1,N:'xf:trigger',A:{'ev:onclick':'scwin.trigger1_onclick',style:'display: block;height:42px;line-height:32px;padding:5px;background-color:coral;font-size:15px;weight: bolder;font-weight:bolder;margin-bottom:10px;text-align: left;',id:'trigger1',type:'button',class:''},E:[{T:1,N:'xf:label',E:[{T:4,cdata:'openPopup() - adaptiveFrame: "true"'}]}]},{T:1,N:'xf:trigger',A:{type:'button',id:'trigger2',style:'display: block;height:42px;line-height:32px;padding:5px;background-color:coral;font-size:15px;weight: bolder;font-weight:bolder;margin-bottom:10px;text-align: left;','ev:onclick':'scwin.trigger2_onclick'},E:[{T:1,N:'xf:label',E:[{T:4,cdata:'openPopup() - adaptiveFrame: "false"'}]}]}]}]}]}]})