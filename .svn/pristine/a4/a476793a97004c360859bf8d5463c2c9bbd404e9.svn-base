/**
 * DataList의 oncelldatachange 이벤트 핸들러
 */
scwin.dataList1_oncelldatachange = function (info) {
  // info : oldValue, newValue, rowIndex, colID
  var rowIndex = info.rowIndex;
  var columnId = info.colID;
  gridView1.setCellColor(rowIndex, columnId, "blue");

  // 로그 출력
  let strLog = "# oncelldatachange event\n";
  strLog += "이전 값 : " + info.oldValue + "\n";
  strLog += "현재 값 : " + info.newValue;
  $c.frame.printExampleLog($p, strLog, txa_log, false);
  console.log(strLog);
  console.log(info);
};

/**
 * textarea의 로그 삭제
 */
scwin.btn_clearLog_onclick = function (e) {
  let strTargetId = this.getUserData("userData1");
  let cmpTarget;
  if (strTargetId) {
    cmpTarget = $p.getComponentById(strTargetId) || txa_log;
  } else {
    cmpTarget = txa_log;
  }
  //textarea value를 빈문자열로 할당.
  cmpTarget.setValue("");
};
}}}]}]},{T:1,N:'body',A:{'ev:onpageload':'scwin.onpageload'},E:[{T:1,N:'xf:group',A:{class:'sub_contents',id:'',style:''},E:[{T:1,N:'xf:group',A:{class:'ws_example_grp_desc',id:'',style:''},E:[{T:1,N:'w2:textbox',A:{escape:'false',id:'',label:'DataList의 \'oncelldatachange\' 이벤트를 설정한 예제입니다.',style:''}},{T:1,N:'w2:textbox',A:{class:'exam_txt caution',id:'',label:'컴포넌트의 이벤트 발생 시 영역 [로그 확인]의 textarea 또는 브라우저 개발자도구 콘솔에 로그가 출력됩니다.',style:''}}]},{T:1,N:'xf:group',A:{class:'example_div_tb_style_wrap mb_def',id:'',style:''},E:[{T:1,N:'xf:group',A:{class:'example_div_tr_style',id:'',style:''},E:[{T:1,N:'xf:group',A:{class:'example_div_td_style',id:'',style:''},E:[{T:1,N:'xf:group',A:{style:'',id:'',class:'gvwbox'},E:[{T:1,N:'w2:gridView',A:{autoFit:'allColumn',autoFitMinWidth:'280',class:'gvw',dataList:'data:dataList1',defaultCellHeight:'37',id:'gridView1',keepDefaultColumnWidth:'true',readOnly:'false',rowNumVisible:'true',rowNumWidth:'40',rowStatusVisible:'true',rowStatusWidth:'40',style:'height:100px;',visibleRowNum:'all',visibleRowNumFix:'true',focusMode:'none',rowStatusHeaderValue:'상태',editModeEvent:'onclick',keyMoveEditMode:'true',focusFlow:'linear'},E:[{T:1,N:'w2:caption',A:{style:'',id:'caption1',value:'this is a grid caption.'}},{T:1,N:'w2:header',A:{style:'',id:'header1'},E:[{T:1,N:'w2:row',A:{style:'',id:'row1'},E:[{T:1,N:'w2:column',A:{width:'70',inputType:'text',style:'',id:'column3',value:'col1',displayMode:'label'}},{T:1,N:'w2:column',A:{width:'70',inputType:'text',style:'',id:'column2',value:'col2',displayMode:'label'}},{T:1,N:'w2:column',A:{width:'70',inputType:'text',style:'',id:'column1',value:'col3',displayMode:'label'}}]}]},{T:1,N:'w2:gBody',A:{style:'',id:'gBody1'},E:[{T:1,N:'w2:row',A:{style:'',id:'row2'},E:[{T:1,N:'w2:column',A:{width:'70',inputType:'text',style:'',id:'col1',value:'',displayMode:'label'}},{T:1,N:'w2:column',A:{width:'70',inputType:'text',style:'',id:'col2',value:'',displayMode:'label'}},{T:1,N:'w2:column',A:{width:'70',inputType:'text',