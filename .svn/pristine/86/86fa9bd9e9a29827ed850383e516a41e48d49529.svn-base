    <body ev:onpageload="scwin.onpageload" ev:onpageunload="scwin.onpageunload">
    <xf:group id="" style="margin: 10px;"><w2:textbox tagname="h1" style="color: blue;margin-bottom: 10px;" tabIndex="h1" id="textbox1" label="셀 편집 모드로 진입하기 위한 마우스 동작 지정" escape="false"></w2:textbox><w2:textbox tagname="h2" style="height: 23px;margin-bottom: 10px;color: blue;" id="textbox2" label="샘플 사용 방법"></w2:textbox><w2:textbox style="color: blue;margin-bottom: 30px;" id="textbox3" label='1. GridView 셀을 클릭하면 편집 모드로 진입하는 것을 확인. (editModeEvent="onclick")&lt;br/&gt;2. GridView의 Status 컬럼의 viewType="icon" 속성 설정이 적용된 것을 확인. &lt;br/&gt;3. 단, Status 컬럼의 셀을 편집하려면 아이콘을 더블 클릭해야하는 것을 확인. (editModeEventIcon="ondblclick")' escape="false">
    	</w2:textbox><w2:textbox style="padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightblue;border:none;margin-bottom: 10px;" id="textbox4" label='속성 설정&lt;br/&gt;editModeEvent="onclick" (GridView)&lt;br/&gt;editModeEventIcon="ondblclick" (GridView)&lt;br/&gt;viewType="icon" (Status 컬럼)' escape="false">
    	</w2:textbox>
    	<w2:gridView showSortableUseFilter="" scrollByColumnAdaptive="false" moveKeyEditMode="true" rowNumVisible="true" showSortableImage=""
    		scrollByColumn="false" sortable="" defaultCellHeight="30" filterShowAlways="" dataList="data:dataList1"
    		style="border: solid 1px gray;" columnMove="" moveKeyEditModeAll="false" id="gridview1" autoFit="allColumn" useFilterList="true"
    		class="" visibleRowNum="10" visibleRowNumFix="true" editModeEventIcon="ondblclick" editModeEvent="onclick" noResultMessageVisibleAlways="true">
    		<w2:caption style="" id="caption1" value="this is a grid caption."></w2:caption>
    		<w2:header style="" id="header1">
    			<w2:row style="height: 25px;" id="row1">
    				<w2:column removeBorderStyle="false" width="70" inputType="" style="height:20px;" id="column19" value="Check"
    					blockSelect="false" displayMode="label">
    				</w2:column>
    				<w2:column removeBorderStyle="false" width="70" inputType="text" style="height:20px;" id="column17" value="ID"
    					blockSelect="false" displayMode="label">
    				</w2:column>
    				<w2:column removeBorderStyle="false" width="70" inputType="text" style="height:20px;" id="column15" value="Age"
    					blockSelect="false" displayMode="label">
    				</w2:column>
    				<w2:column chooseOptionLabel="Status" ref="" removeBorderStyle="false" chooseOption="true" width="70" inputType=""
    					style="height:20px;" id="column13" allOption="" value="Status" blockSelect="false" displayMode="label">
    					<w2:choices>
    						<w2:itemset nodeset="data:dataList2">
    							<w2:label ref="label"></w2:label>
    							<w2:value ref="value"></w2:value>
    						</w2:itemset>
    					</w2:choices>
    				</w2:column>
    				<w2:column removeBorderStyle="false" width="70" inputType="text" style="height:20px;" id="column11" value="Income"
    					blockSelect="false" displayMode="label">
    				</w2:column>
    				<w2:column removeBorderStyle="false" width="70" inputType="text" style="height:20px;" id="column9" sortable=""
    					value="Expense" blockSelect="false" displayMode="label">
    				</w2:column>
    				<w2:column removeBorderStyle="false" width="70" inputType="text" style="height:20px;" id="column7" value="Hobby"
    					blockSelect="false" displayMode="label" useFilter="true">
    				</w2:column>
    				<w2:column removeBorderStyle="false" width="70" inputType="text" style="height:20px;" id="column5" value="Region"
    					blockSelect="false" displayMode="label">
    				</w2:column>
    				<w2:column removeBorderStyle="false" width="70" inputType="text" style="height:20px;" id="column3" value="Frequency"
    					blockSelect="false" displayMode="label">
    				</w2:column>
    				<w2:column removeBorderStyle="false" width="70" inputType="text" style="height:20px;" id="column1" value="date"
    					blockSelect="false" displayMode="label">
    				</w2:column>
    			</w2:row>
    		</w2:header>
    		<w2:gBody style="" id="gBody1">
    			<w2:row style="" id="row2">
    				<w2:column removeBorderStyle="false" width="70" inputType="checkbox" style="height:20px" id="Check" value=""
    					blockSelect="false" displayMode="label">
    				</w2:column>
    				<w2:column removeBorderStyle="false" width="70" inputType="text" style="height:20px" id="ID" value=""
    					blockSelect="false" displayMode="label">
    				</w2:column>
    				<w2:column removeBorderStyle="false" width="70" inputType="text" style="height:20px" id="Age" value=""
    					blockSelect="false" displayMode="label">
    				</w2:column>
    				<w2:column ref="" removeBorderStyle="false" chooseOption="" width="70" inputType="checkcombobox" style="height:20px;"
    					id="Status" allOption="" value="" blockSelect="false" displayMode="label" viewType="icon">
    					<w2:choices>
    						<w2:itemset nodeset="data:dataList2">
    							<w2:label ref="label"></w2:label>
    							<w2:value ref="value"></w2:value>
    						</w2:itemset>
    					</w2:choices>
    				</w2:column>
    				<w2:column removeBorderStyle="false" width="70" inputType="text" style="height:20px" id="Income" value=""
    					blockSelect="false" displayMode="label">
    				</w2:column>
    				<w2:column removeBorderStyle="false" width="70" inputType="text" style="height:20px" id="Expense" value=""
    					blockSelect="false" displayMode="label">
    				</w2:column>
    				<w2:column removeBorderStyle="false" width="70" inputType="text" style="height:20px" id="Hobby" value=""
    					blockSelect="false" displayMode="label" useFilter="">
    				</w2:column>
    				<w2:column removeBorderStyle="false" width="70" inputType="" style="height:20px" id="Region" value=""
    					blockSelect="false" displayMode="label">
    				</w2:column>
    				<w2:column removeBorderStyle="false" width="70" inputType="text" style="height:20px" id="Frequency" value=""
    					blockSelect="false" displayMode="label">
    				</w2:column>
    				<w2:column removeBorderStyle="false" width="70" inputType="text" style="height:20px" id="date" value=""
    					blockSelect="false" displayMode="label">
    				</w2:column>
    			</w2:row>
    		</w2:gBody>
    	</w2:gridView></xf:group></body>
