scwin.getfolderPath = function () {
  var currentPath = window.location.href;
  var folderPath;
  if (currentPath.includes("mainContainer")) {
    console.log("true  ===> " + $p.getFrameId());
    const cmtFrame = $p.getComponentById($p.getFrameId());
    currentPath = cmtFrame.getSrc();
    folderPath = currentPath.substring(0, currentPath.lastIndexOf('/'));
  } else {
    console.log("false  ===> ");
    folderPath = currentPath.split('w2xPath=')[1].substring(0, currentPath.split('w2xPath=')[1].lastIndexOf('/'));
  }
  return folderPath;
};
}}}]}]},{T:1,N:'body',A:{'ev:onpageload':'scwin.onpageload'},E:[{T:1,N:'xf:group',A:{id:'',style:'margin: 10px;'},E:[{T:1,N:'w2:textbox',A:{tagname:'h1',style:'margin-bottom: 10px;color: blue;',id:'textbox3',label:'Inherit Parent Scope<br/>',escape:'false'}},{T:1,N:'w2:textbox',A:{tagname:'h2',style:'height: 23px;margin-bottom: 10px;color: blue;',id:'textbox4',label:'How to Use'}},{T:1,N:'w2:textbox',A:{style:'color: blue;margin-bottom: 30px;',id:'textbox5',label:'(Run the example standalone.)<br/>1. Confirm that a screen with nested WFrames is displayed.<br/>2. Click each button contained within the bottom-most WFrame.<br/>3. Confirm that each button behaves according to its scopeInherit="all" attribute setting.<br/><br/>The behavior based on the scopeInherit attribute value is as follows:<br/> &nbsp; &nbsp; “none” : (1) X, (2) Top-level access, (3) O<br/> &nbsp; &nbsp; “api” : (1) X, (2) Parent access, (3) O<br/> &nbsp; &nbsp; “all” : (1) O, (2) Parent access, (3) O<br/> &nbsp; &nbsp; “component” : (1) O, (2) Top-level access, (3) O',escape:'false'}},{T:1,N:'w2:textbox',A:{style:'padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightblue;border:none;margin-bottom: 20px;',id:'textbox6',label:'scopeInherit="all"',escape:'false'}},{T:1,N:'w2:textbox',A:{style:'text-align: left;height:50px;padding: 5px;font-size:30px;font-style:normal;font-weight:bolder;color: blue;margin-bottom: 10px;',id:'textbox1',label:'Top (id="textbox1")'}},{T:1,N:'w2:wframe',A:{scopeInherit:'all',style:'padding: 10px;border: gray solid 1px;background-color: lightgreen;',id:'wframe1'}}]}]}]}]})