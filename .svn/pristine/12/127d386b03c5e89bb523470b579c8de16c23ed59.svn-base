/**
 * GridView grd_exam1의 oncelldblclick 이벤트 핸들러
 */
scwin.grd_exam1_oncelldblclick = function (row, col, colId) {
  let strLog = "";
  strLog += "** scwin.grd_exam1_oncelldblclick ** \n";
  strLog += "row index : " + row + "\n";
  strLog += "column index : " + col + "\n";
  strLog += "column id : " + colId;

  //textarea에 log 출력
  $c.frame.printExampleLog($p, strLog, txa_log, false);

  //console에 log 출력
  console.log(strLog);

  //컬럼별 로직 구현 예시 - 'A' 컬럼을 더블 클릭한 경우 현재 행의 데이터를 JSON으로 출력
  switch (colId) {
    case "col_a":
      //연결된 DataList를 모르는 경우
      //let jsnRowData = $p.getComponentById(this.getDataList()).getRowJSON(row);

      //연결된 DataList를 아는 경우
      let jsnRowData = dlt_exam.getRowJSON(row);

      //textarea에 log 출력
      $c.frame.printExampleLog($p, "JSON Data : " + JSON.stringify(jsnRowData), txa_log, false);

      //console에 log 출력
      console.log(jsnRowData);
      break;
    case "col_b":
      break;
    case "col_c":
      break;
    default:
      break;
  }
};

/**
 * textarea의 로그 삭제
 */
scwin.btn_clearLog_onclick = function (e) {
  txa_log.setValue("");
};
