define({declaration:{A:{version:'1.0',encoding:'UTF-8'}},E:[{T:1,N:'html',A:{xmlns:'http://www.w3.org/1999/xhtml','xmlns:ev':'http://www.w3.org/2001/xml-events','xmlns:w2':'http://www.inswave.com/websquare','xmlns:xf':'http://www.w3.org/2002/xforms'},E:[{T:1,N:'head',E:[{T:1,N:'w2:type',E:[{T:3,text:'DEFAULT'}]},{T:1,N:'w2:buildDate'},{T:1,N:'xf:model',E:[{T:1,N:'w2:dataCollection',A:{baseNode:'map'}},{T:1,N:'w2:workflowCollection'}]},{T:1,N:'script',A:{type:'text/javascript',lazy:'false'},E:[{T:4,cdata:function(scopeObj){with(scopeObj){scwin.count = 0;
scwin.onpageload = function () {
  text1.hide();
  text2.hide();
  trigger1.hide();
  var tmpSrc1 = scwin.getfolderPath() + "/11_wframe_01.xml";
  var tmpSrc2 = scwin.getfolderPath() + "/02_openPopUp_tab.xml";
  tabControl1.addTab(scwin.count, {
    label: "wframe",
    title: "wframe",
    openAction: "exist",
    closable: "true"
  }, {
    "src": tmpSrc1,
    "frameMode": "wframe"
  });
  scwin.count++;
  tabControl1.addTab(scwin.count + 1, {
    label: "wframePreload",
    title: "wframePreload",
    openAction: "exist",
    closable: "true"
  }, {
    "src": tmpSrc2,
    "frameMode": "wframePreload"
  });
  tabControl1.setSelectedTabIndex(scwin.count);
  scwin.count++;
};
scwin.onpageunload = function () {};
scwin.getfolderPath = function () {
  var currentPath = window.location.href;
  var folderPath;
  if (currentPath.includes("mainContainer")) {
    console.log("true  ===> " + $p.getFrameId());
    const cmtFrame = $p.getComponentById($p.getFrameId());
    currentPath = cmtFrame.getSrc();
    folderPath = currentPath.substring(0, currentPath.lastIndexOf('/'));
  } else {
    console.log("false  ===> ");
    folderPath = currentPath.split('w2xPath=')[1].substring(0, currentPath.split('w2xPath=')[1].lastIndexOf('/'));
  }
  return folderPath;
};
}}}]}]},{T:1,N:'body',A:{'ev:onpageload':'scwin.onpageload','ev:onpageunload':'scwin.onpageunload'},E:[{T:1,N:'xf:group',A:{id:'',style:'margin: 10px;'},E:[{T:1,N:'w2:textbox',A:{tagname:'h1',style:'margin-bottom: 10px;color: blue;',id:'textbox1',label:'Create Frame-based Modal Popup inside Tab<br/>',escape:'false'}},{T:1,N:'w2:textbox',A:{tagname:'h2',style:'height: 23px;margin-bottom: 10px;color: blue;',id:'textbox2',label:'How to Use'}},{T:1,N:'w2:textbox',A:{style:'color: blue;margin-bottom: 30px;',id:'textbox3',label:'(First frameMode="wframe" tab)<br/>1-1. Select the frameModal option for the openPopup() method. (“frame”, ‘parent’, “top”, TabControl ID)<br/>1-2. Click the $p.openPopup() button inside the tab.<br/>1-3. Confirm the popup\'s display scope based on the selected option.<br/> &nbsp; “frame”: Displays as a modal popup within the current frame.<br/> &nbsp; “parent”: Displays as a modal popup within the parent frame.<br/> &nbsp; “top”: Displays as a full-screen modal popup.<br/> &nbsp; TabControl ID: Displayed as a modal popup inside the TabControl. (In the example, the TabControl ID is obtained via $p.getFrame().getParentFrame().getParentFrame().id.)<br/><br/>(Second tab with frameMode="wframePreload")<br/>2-1. Click each button to generate popups of PageFrame, WFrame, and IFrame types.<br/>2-2. Confirm that the popup displays at the top (“top”) or within its parent frame (“frame”) based on the options.frameModal setting.<br/>(See the Script tab for detailed script.)',escape:'false'}},{T:1,N:'w2:textbox',A:{style:'padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightblue;border:none;margin-bottom: 20px;',id:'textbox4',label:'frameMode="wframe" "wframePreload" (tabControl.content)',escape:'false'}},{T:1,N:'w2:textbox',A:{style:'padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightblue;border:none;margin-bottom: 20px;',id:'textbox5',label:'$p.openPopup(options) - options.modal : "true" & options.frameModal ; "frame" (Popup)',escape:'false'}},{T:1,N:'w2:tabControl',A:{frameModal:'true',confirmTrueAction:'exist',confirmFalseAction:'new',useTabKeyOnly:'true',useMoveNextTabFocus:'false',closable:'true',useConfirmMessage:'false',alwaysDraw:'false',userData3:'',style:'border: gray solid 1px;height: 500px;margin-bottom: 10px;',id:'tabControl1',processMsgFrame:'true'}},{T:1,N:'w2:textbox',A:{style:'width: 150px;height: 23px;',id:'text1',label:'Main A'}},{T:1,N:'w2:textbox',A:{style:'width: 150px;height: 23px;',id:'text2',label:'Main B'}},{T:1,N:'xf:trigger',A:{style:'width: 80px;height: 23px;',id:'trigger1',type:'button'},E:[{T:1,N:'xf:label'}]}]}]}]}]})