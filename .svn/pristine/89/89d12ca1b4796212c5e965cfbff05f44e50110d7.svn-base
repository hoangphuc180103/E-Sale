    					</w2:row>
    					<w2:row>
    						<col1><![CDATA[Busan]]></col1>
    						<col2><![CDATA[2020]]></col2>
    						<col3><![CDATA[Jul]]></col3>
    						<col4><![CDATA[90]]></col4>
    					</w2:row>
