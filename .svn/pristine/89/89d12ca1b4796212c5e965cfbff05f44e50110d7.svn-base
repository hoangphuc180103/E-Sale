    	<script type="text/javascript" lazy="false"><![CDATA[
        
	scwin.onpageload = function() {
	};
	
	scwin.onpageunload = function() {
		
	};
	
	]]></script>
    	<style type="text/css"><![CDATA[.blue{background-color: pink;}]]></style>
    </head>
    <body ev:onpageload="scwin.onpageload" ev:onpageunload="scwin.onpageunload">
    <xf:group id="" style="margin: 10px;">
    	<w2:textbox tagname="h1" style="color: blue;margin-bottom: 10px;" tabIndex="h1" id="textbox1" label="Add subTotal&lt;br/&gt;"
    		escape="false">
    	</w2:textbox>
    	<w2:textbox tagname="h2" style="height: 23px;margin-bottom: 10px;color: blue;" id="textbox2" label="How to Use"></w2:textbox>
    	<w2:textbox style="color: blue;margin-bottom: 30px;" id="textbox3" label='1. Confirm that the subTotal value from the city column is displayed in the sales column (id=“col1”).'
    		escape="false">
    	</w2:textbox>
    	<w2:textbox
    		style="padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightblue;border:none;margin-bottom: 10px;"
    		id="textbox4"
    		label="(subTotal)&lt;br/&gt;targetColumnID=&quot;col1&quot;&lt;br/&gt;inputType=&quot;expression&quot; &lt;br/&gt;expression=&quot;sum('col4')&quot;"
    		escape="false">
    	</w2:textbox>
    	<w2:gridView scrollByColumnAdaptive="false" checkAllType="false" dataList="data:dataList1" scrollByColumn="false"
    		style="border: solid 1px gray;" id="gridView1" autoFit="allColumn" mergeCells="" defaultCellHeight="20" visibleRowNum="10"
    		visibleRowNumFix="true">
    		<w2:caption style="" id="caption2" value="this is a grid caption."></w2:caption>
    		<w2:header style="" id="header2">
    			<w2:row style="" id="row4">
    				<w2:column width="70" inputType="text" style="height:20px" id="column16" value="city" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="height:20px" id="column15" value="year" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="height:20px" id="column14" value="month" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="height:20px" id="column13" value="sales" displayMode="label"></w2:column>
    			</w2:row>
    		</w2:header>
    		<w2:gBody style="" id="gBody2">
    			<w2:row style="" id="row5">
    				<w2:column width="70" colMerge="true" inputType="text" style="height:20px" id="col1" value="" displayMode="label"></w2:column>
    				<w2:column width="70" colMerge="" inputType="text" style="height:20px" id="col2" value="" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="height:20px" id="col3" value="" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="height:20px" id="col4" value="" displayMode="label"></w2:column>
    			</w2:row>
    		</w2:gBody>
    		<w2:subTotal targetColumnID="col1" style="" id="subTotal2">
    			<w2:row style="" id="row7">
    				<w2:column width="70" inputType="text" style="height:20px" id="column24" value="" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="height:20px" id="column23" value="" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="height:20px" id="column22" value="" displayMode="label"></w2:column>
    				<w2:column expression='sum("col4")' width="70" inputType="expression" style="height:20px" id="column21" value=""
    					displayMode="label">
    				</w2:column>
    			</w2:row>
    		</w2:subTotal>
    	</w2:gridView>
    </xf:group></body>
</html>
