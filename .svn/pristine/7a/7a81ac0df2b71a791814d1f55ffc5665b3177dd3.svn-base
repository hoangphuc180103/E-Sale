<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head meta_screenName="SpanDirection_SpanCount_cols_rows_Radio">
        <w2:type>COMPONENT</w2:type>
        <w2:buildDate/>
        <w2:MSA/>
        <xf:model>
            <w2:dataCollection baseNode="map"/>
            <w2:workflowCollection/>
        </xf:model>
        <w2:layoutInfo/>
        <w2:publicInfo method=""/>
        <script lazy="false" type="text/javascript"><![CDATA[
scwin.onpageload = function() {
	
};
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload">
    <xf:group id="" style="margin: 10px;">
    	<w2:textbox tagname="h1" style="color: blue;margin-bottom: 10px;" tabIndex="h1" id="textbox1" label="Set Number of Rows and Columns to Display&lt;br/&gt;"
    		escape="false">
    	</w2:textbox>
    	<w2:textbox tagname="h2" style="height: 23px;margin-bottom: 10px;color: blue;" id="textbox2" label="How to Use"></w2:textbox>
    	<w2:textbox style="color: blue;margin-bottom: 30px;" id="textbox3" label='(First Radio)&lt;br/&gt;Confirm that the selected items span 3 rows (as per the rows="3" attribute setting).&lt;br/&gt;&lt;br/&gt;(Second Radio)&lt;br/&gt;Confirm that the selected items span 3 columns (as per the cols="3" attribute setting).'
    		escape="false">
    	</w2:textbox>
    	<w2:textbox
    		style="padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightblue;border:none;margin-bottom: 10px;"
    		id="textbox4" label='rows="3"' escape="false">
    	</w2:textbox>
    	<xf:select1 ref="" appearance="full" style="margin-bottom: 20px;" id="radio1" rows="3" cols="" selectedIndex="-1">
    		<xf:choices>
    			<xf:item>
    				<xf:label><![CDATA[Seoul]]></xf:label>
    				<xf:value><![CDATA[SEL]]></xf:value>
    			</xf:item>
    			<xf:item>
    				<xf:label><![CDATA[Tokyo]]></xf:label>
    				<xf:value><![CDATA[TKY]]></xf:value>
    			</xf:item>
    			<xf:item>
    				<xf:label><![CDATA[Beijing]]></xf:label>
    				<xf:value><![CDATA[BEJ]]></xf:value>
    			</xf:item>
    			<xf:item>
    				<xf:label><![CDATA[Paris]]></xf:label>
    				<xf:value><![CDATA[PRS]]></xf:value>
    			</xf:item>
    			<xf:item>
    				<xf:label><![CDATA[London]]></xf:label>
    				<xf:value><![CDATA[LND]]></xf:value>
    			</xf:item>
    			<xf:item>
    				<xf:label><![CDATA[Ottawa]]></xf:label>
    				<xf:value><![CDATA[OTW]]></xf:value>
    			</xf:item>
    		</xf:choices>
    	</xf:select1>
    	<w2:textbox escape="false" id="textbox5" label='cols="3"'
    		style="padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightblue;border:none;margin-bottom: 10px;">
    	</w2:textbox>
    	<xf:select1 appearance="full" cols="3" id="radio2" ref="" rows="" selectedIndex="-1" style="margin-bottom: 10px;">
    		<xf:choices>
    			<xf:item>
    				<xf:label><![CDATA[Seoul]]></xf:label>
    				<xf:value><![CDATA[SEL]]></xf:value>
    			</xf:item>
    			<xf:item>
    				<xf:label><![CDATA[Tokyo]]></xf:label>
    				<xf:value><![CDATA[TKY]]></xf:value>
    			</xf:item>
    			<xf:item>
    				<xf:label><![CDATA[Beijing]]></xf:label>
    				<xf:value><![CDATA[BEJ]]></xf:value>
    			</xf:item>
    			<xf:item>
    				<xf:label><![CDATA[Paris]]></xf:label>
    				<xf:value><![CDATA[PRS]]></xf:value>
    			</xf:item>
    			<xf:item>
    				<xf:label><![CDATA[London]]></xf:label>
    				<xf:value><![CDATA[LND]]></xf:value>
    			</xf:item>
    			<xf:item>
    				<xf:label><![CDATA[Ottawa]]></xf:label>
    				<xf:value><![CDATA[OTW]]></xf:value>
    			</xf:item>
    		</xf:choices>
    	</xf:select1>
    </xf:group></body>
</html>
