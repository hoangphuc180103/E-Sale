    <body>
    	<xf:group id="" class="" style="margin: 10px;">
    		<w2:textbox tagname="h1" style="color: blue;margin-bottom: 10px;" tabIndex="h1" id="textbox1" label="マージ状態を維持してExcelにダウンロード"
    			escape="false">
    		</w2:textbox>
    		<w2:textbox tagname="h2" style="height: 23px;margin-bottom: 10px;color: blue;" id="textbox2" label="サンプルの使い方"></w2:textbox>
    		<w2:textbox style="color: blue;margin-bottom: 30px;" id="textbox3"
    			label='1-1. 下の初めて目ボタンクリック。 &lt;br/&gt;1-2. ダウンロードした Excel ファイル開く。&lt;br/&gt;1-3. GridViewのマージ状態維持されたもの確認。&lt;br/&gt;&lt;br/&gt;2-1. 下の二つ目ボタンクリック。 &lt;br/&gt;1-2. ダウンロードした Excel ファイル開く。&lt;br/&gt;1-3. GridViewのマージ状態解く Excel ファイルとしてダウンロードもの確認。&lt;br/&gt;'
    			escape="false">
    		</w2:textbox>
    		<xf:trigger ev:onclick="scwin.trigger1_onclick"
    			style="height:42px;line-height:32px;padding:5px;background-color:coral;font-size:15px;weight: bolder;font-weight:bolder;text-align: left;display: block;margin-bottom: 10px;"
    			id="trigger1" type="button">
    			<xf:label><![CDATA[advancedExcelDownload(options) - options.colMerge="true", options.colMergeValue="true"]]></xf:label>
    		</xf:trigger>
    		<xf:trigger type="button" id="trigger2"
    			style="height:42px;line-height:32px;padding:5px;background-color:coral;font-size:15px;weight: bolder;font-weight:bolder;text-align: left;display: block;margin-bottom: 10px;"
    			ev:onclick="scwin.trigger2_onclick">
    			<xf:label><![CDATA[advancedExcelDownload(options)]]></xf:label>
    		</xf:trigger>
    		<w2:gridView dataList="data:coctbev530mtList" scrollByColumn="false" id="gridView1" class="" escape="true"
