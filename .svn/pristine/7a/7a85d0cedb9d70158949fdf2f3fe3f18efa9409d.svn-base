    			rowStatusWidth="20" focusMode="row" editModeEvent="onclick" keyMoveEditMode="true" ev:oncellclick="scwin.gridResultView_oncellclick"
    			ev:oneditkeydown="scwin.gridResultView_oneditkeydown" style="border: solid gray 1px;margin-bottom: 10px;" fastScroll="false" visibleRowNum="10"
    			visibleRowNumFix="true" autoFit="allColumn">
