<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare"
	xmlns:xf="http://www.w3.org/2002/xforms">
	<head meta_author="InswaveSystems" meta_type="메인"
		meta_screenName="[GridView] inputType이 drilldown으로 지정된 열에서 '노드 유형' 아이콘을 클릭할 때 'oncellclick' 이벤트이 발생하지 않도록 설정하기">
		<w2:historyInfo>
			<w2:history meta_no="01" meta_desc="최초작성" meta_date="20230828" meta_user="InswaveSystems"></w2:history>
			<w2:history meta_no="02" meta_desc="설명부 수정" meta_date="20240621" meta_user="InswaveSystems"></w2:history>
			<w2:history meta_no="03" meta_desc="예제에서 사용하는 DataList가 변경되고, 이에 따른 GridView의 설정이 수정되었습니다." meta_date="20240712"
				meta_user="InswaveSystems"></w2:history>
		</w2:historyInfo>
		<w2:type>COMPONENT</w2:type>
		<w2:buildDate />
		<w2:MSA />
		<xf:model>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" id="dlt_exam" repeatNode="data" valueAttribute="">
					<w2:columnInfo>
						<w2:column dataType="text" id="depth" name="DEPTH"></w2:column>
						<w2:column dataType="text" id="col_a" name="A"></w2:column>
						<w2:column dataType="text" id="col_b" name="B"></w2:column>
					</w2:columnInfo>
					<w2:data use="true" xmlns="">
						<w2:row>
							<depth><![CDATA[1]]></depth>
							<col_a><![CDATA[A1]]></col_a>
							<col_b><![CDATA[B1]]></col_b>
						</w2:row>
						<w2:row>
							<depth><![CDATA[2]]></depth>
							<col_a><![CDATA[A1-1]]></col_a>
							<col_b><![CDATA[B2]]></col_b>
						</w2:row>
						<w2:row>
							<depth><![CDATA[2]]></depth>
							<col_a><![CDATA[A1-2]]></col_a>
							<col_b><![CDATA[B3]]></col_b>
						</w2:row>
						<w2:row>
							<depth><![CDATA[3]]></depth>
							<col_a><![CDATA[A1-2-1]]></col_a>
							<col_b><![CDATA[B4]]></col_b>
						</w2:row>
						<w2:row>
							<depth><![CDATA[1]]></depth>
							<col_a><![CDATA[A2]]></col_a>
							<col_b><![CDATA[B5]]></col_b>
						</w2:row>
					</w2:data>
				</w2:dataList>
			</w2:dataCollection>
			<w2:workflowCollection />
		</xf:model>
		<w2:layoutInfo />
		<w2:publicInfo method="" />
		<script lazy="false" type="text/javascript"><![CDATA[
scwin.onpageload = function () {

};

/**
 * GridView 'grd_exam1'의 'oncellclick' 이벤트 발생 시
 */
scwin.grd_exam1_oncellclick = function (row, col, colId) {
    alert("oncellclick 이벤트 발생");
};

/**
 * GridView 'grd_exam2'의 'oncellclick' 이벤트 발생 시
 */
scwin.grd_exam2_oncellclick = function (row, col, colId) {
    alert("oncellclick 이벤트 발생");
};

]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:group class="sub_contents">
			<xf:group class="ws_example_grp_desc">
				<w2:textbox escape="false"
					label="GridView의 'ignoreCellClick' 속성을 사용하여, 바디 컬럼의 'inputType'이 'drilldown'으로 설정된 컬럼에서 왼쪽에 표시된 노드 유형 아이콘이 클릭될 때 'oncellclick' 이벤트의 발생 여부를 설정한 예제입니다."
					style="">
				</w2:textbox>
			</xf:group>
			<xf:group class="example_div_tb_style_wrap">
				<xf:group class="example_div_tr_style" style="">
					<w2:textbox class="example_div_th_style" escape="false" label="'노드 유형' 아이콘을 클릭하면 'oncellclick' 이벤트 미발생"></w2:textbox>
					<xf:group class="example_div_td_style">
						<xf:group class="mb_def_box nobottom">
							<xf:group class="gvwbox" id="" style="max-width:240px;">
								<w2:gridView autoFit="allColumn" autoFitMinWidth="210" class="gvw" dataList="dlt_exam" defaultCellHeight="38"
									ev:oncellclick="scwin.grd_exam1_oncellclick" id="grd_exam1" ignoreCellClick="true" readOnly="true" style="height: 120px;"
									tooltipDisplay="true" visibleRowNum="all">
									<w2:caption id="caption1" value="this is a grid caption."></w2:caption>
									<w2:header id="header1">
										<w2:row id="row1">
											<w2:column blockSelect="false" displayMode="label" id="column7" inputType="text" value="A" width="100">
											</w2:column>
											<w2:column blockSelect="false" displayMode="label" id="column9" inputType="text" value="B" width="100">
											</w2:column>
										</w2:row>
									</w2:header>
									<w2:gBody id="gBody1">
										<w2:row id="row2">
											<w2:column blockSelect="false" depthColumn="depth" displayMode="label" id="col_a" inputType="drilldown" showDepth="2"
												textAlign="left" value="" width="100">
											</w2:column>
											<w2:column blockSelect="false" displayMode="label" id="col_b" inputType="text" width="100"></w2:column>
										</w2:row>
									</w2:gBody>
								</w2:gridView>
							</xf:group>
						</xf:group>
					</xf:group>
				</xf:group>
				<xf:group class="example_div_tr_style">
					<w2:textbox class="example_div_th_style" escape="false" label="(기본 설정) '노드 유형' 아이콘을 클릭하면 'oncellclick' 이벤트 발생"></w2:textbox>
					<xf:group class="example_div_td_style">
						<xf:group class="mb_def_box nobottom">
							<xf:group id="" class="gvwbox" style="max-width:240px;">
								<w2:gridView ev:oncellclick="scwin.grd_exam2_oncellclick" tooltipDisplay="true" dataList="dlt_exam" readOnly="true"
									style="height: 120px;" ignoreCellClick="false" autoFit="allColumn" id="grd_exam2" visibleRowNum="all" class="gvw"
									defaultCellHeight="38" autoFitMinWidth="210">
									<w2:caption id="caption1" value="this is a grid caption."></w2:caption>
									<w2:header id="header1">
										<w2:row id="row1">
											<w2:column width="100" inputType="text" id="column7" value="A" blockSelect="false" displayMode="label">
											</w2:column>
											<w2:column width="100" inputType="text" id="column9" value="B" blockSelect="false" displayMode="label">
											</w2:column>
										</w2:row>
									</w2:header>
									<w2:gBody id="gBody1">
										<w2:row id="row2">
											<w2:column textAlign="left" width="100" inputType="drilldown" id="col_a" showDepth="2" depthColumn="depth" value=""
												blockSelect="false" displayMode="label">
											</w2:column>
											<w2:column width="100" inputType="text" id="col_b" blockSelect="false" displayMode="label">
											</w2:column>
										</w2:row>
									</w2:gBody>
								</w2:gridView>
							</xf:group>
						</xf:group>
					</xf:group>
				</xf:group>
			</xf:group>
		</xf:group>
	</body>
</html>