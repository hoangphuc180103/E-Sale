    <body ev:onpageload="scwin.onpageload" ev:onpageunload="scwin.onpageunload">
    <xf:group id="" style="margin: 10px;">
    	<w2:textbox tagname="h1" style="color: blue;margin-bottom: 10px;" tabIndex="h1" id="textbox2" label="함수를 통한 특정 컬럼의 데이터 변경"
    		escape="false">
    	</w2:textbox>
    	<w2:textbox tagname="h2" style="height: 23px;margin-bottom: 10px;color: blue;" id="textbox3" label="샘플 사용 방법"></w2:textbox>
    	<w2:textbox style="color: blue;margin-bottom: 30px;" id="textbox4"
    		label='("dataList1"과 "dataList2"는 동일한 데이터를 사용.) &lt;br/&gt;1. 첫 번째 GridView는 "dataList1"과 바인딩 된 것을 확인. &lt;br/&gt;2. 두 번째 GridView는 "dataList2"과 바인딩 된 것을 확인. &lt;br/&gt;3. 첫 번째 GridView는 Status 컬럼 데이터가 importFormatter를 통해 변경된 것을 확인.&lt;br/&gt;4. 두 번재 GridView는 Status 컬럼 데이터는 변경되지 않은 것을 확인. &lt;br/&gt;(자세한 스크립트는 Script 탭에서 확인.)'
    		escape="false">
    	</w2:textbox>
    	<w2:textbox
    		style="padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightblue;border:none;margin-bottom: 10px;"
    		id="textbox5" label='속성 설정&lt;br/&gt;importFormatter="scwin.statusFormatter" (dataList1.column - id="Status")' escape="false">
    	</w2:textbox>
    	<w2:gridView scrollByColumnAdaptive="false" rowNumVisible="true" visibleRowNumFix="true" checkAllType="false"
    		dataList="data:dataList1" scrollByColumn="false" style="border: solid 1px gray;margin-bottom: 10px;" autoFit="allColumn"
    		id="gridView1" visibleRowNum="10" sortable="true" defaultCellHeight="20">
    		<w2:caption style="" id="caption1" value="this is a grid caption."></w2:caption>
    		<w2:header style="" id="header1">
    			<w2:row style="" id="row1">
    				<w2:column width="70" inputType="text" style="height:20px" id="column9" value="Status" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="height:20px" id="column5" value="Hobby" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="height:20px" id="column4" value="Region" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="height:20px" id="column3" value="Frequency" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="height:20px" id="column2" value="ID" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="height:20px" id="column1" value="Age" displayMode="label"></w2:column>
    			</w2:row>
    		</w2:header>
    		<w2:gBody style="" id="gBody1">
    			<w2:row style="" id="row2">
    				<w2:column width="70" inputType="text" style="height:20px" id="Status" value="" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="height:20px" id="Hobby" value="" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="height:20px" id="Region" value="" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="height:20px" id="Frequency" value="" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="height:20px" id="ID" value="" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="height:20px" id="Age" value="" displayMode="label"></w2:column>
    			</w2:row>
    		</w2:gBody>
    	</w2:gridView>
    	<w2:textbox tagname=""
    		style="padding:10px; padding-bottom:20px; text-align:left; font-size:15px; font-weight:bolder; border:brown 1px solid; background-color:ivory; margin-bottom:10px; color:brown;"
    		id="textbox7"
    		label='/// 샘플 코드&lt;br/&gt;&lt;br/&gt;scwin.statusFormatter = function(rowJson, rowIndex, colIndex) {&lt;br/&gt; &amp;nbsp; &amp;nbsp;data = rowJson.Status;&lt;br/&gt; &amp;nbsp; &amp;nbsp;return data.substring(0, 1);&lt;br/&gt;};'
    		escape="false">
    	</w2:textbox>
    	<w2:textbox escape="false" id="textbox6" label='속성 설정&lt;br/&gt;importFormatter=""'
    		style="padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightblue;border:none;margin-bottom: 10px;">
    	</w2:textbox>
    	<w2:gridView autoFit="allColumn" checkAllType="false" dataList="data:dataList2" defaultCellHeight="20" id="gridView2"
    		rowNumVisible="true" scrollByColumn="false" scrollByColumnAdaptive="false" sortable="true" style="border: solid 1px gray"
    		visibleRowNum="10" visibleRowNumFix="true">
    		<w2:caption id="caption2" style="" value="this is a grid caption."></w2:caption>
    		<w2:header id="header1" style="">
    			<w2:row id="row1" style="">
    				<w2:column width="70" inputType="text" style="height:20px" id="column9" value="Status" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="height:20px" id="column2" value="Hobby" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="height:20px" id="column1" value="Region" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="" id="column11" value="Frequency" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="" id="column12" value="ID" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="" id="column13" value="Age" displayMode="label"></w2:column>
    			</w2:row>
    		</w2:header>
    		<w2:gBody id="gBody1" style="">
    			<w2:row id="row2" style="">
    				<w2:column width="70" inputType="text" style="height:20px" id="Status" value="" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="height:20px" id="Hobby" value="" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="height:20px" id="Region" value="" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="" id="Frequency" value="" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="" id="ID" value="" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="" id="Age" value="" displayMode="label"></w2:column>
    			</w2:row>
    		</w2:gBody>
    	</w2:gridView>
    </xf:group></body>
</html>
