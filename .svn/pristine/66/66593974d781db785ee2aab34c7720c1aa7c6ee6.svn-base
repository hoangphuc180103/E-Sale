<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head meta_screenName="createWindow_adaptiveFrame_WindowContainer">
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
         <script type="text/javascript" lazy="false"><![CDATA[

scwin.onpageload = function () {
    requires("uiplugin.popup");

};

scwin.onpageunload = function () {

};


scwin.trigger1_onclick = function (e) {
    const tmpSrc = scwin.getfolderPath() + "/adaptive_adaptiveThreshold_TableLayout.xml";
    var options = {
        id: "popup1",
        type: "wframePopup",
        height: "400px",
        width: "1100px",
        resizable: true,
        adaptiveFrame: "true"
    };
    $p.openPopup(tmpSrc, options);
};




scwin.trigger2_onclick = function (e) {
    const tmpSrc = scwin.getfolderPath() + "/adaptive_adaptiveThreshold_TableLayout.xml";
    var options = {
        id: "popup1",
        type: "wframePopup",
        height: "400px",
        width: "1100px",
        resizable: true,
        adaptiveFrame: "false"
    };
    $p.openPopup(tmpSrc, options);
};

scwin.getfolderPath = function () {

    var currentPath = window.location.href;
    var folderPath;

    if (currentPath.includes("mainContainer")) {
        console.log("true  ===> " + $p.getFrameId());
        const cmtFrame = $p.getComponentById($p.getFrameId());
        currentPath = cmtFrame.getSrc();
        folderPath = currentPath.substring(0, currentPath.lastIndexOf('/'));
    } else {
        console.log("false  ===> ");
        folderPath = currentPath.split('w2xPath=')[1].substring(0, currentPath.split('w2xPath=')[1].lastIndexOf('/'));
    }
    return folderPath;
};]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload" ev:onpageunload="scwin.onpageunload">
    <xf:group id="" style="margin: 10px;">
    	<w2:textbox tagname="h1" style="color: blue;margin-bottom: 10px;" id="textbox1" label="팝업 크기 기반 적응형 디자인 적용" escape="false"></w2:textbox>
    	<w2:textbox tagname="h2" style="height: 23px;margin-bottom: 10px;color: blue;" id="textbox2" label="샘플 사용 방법"></w2:textbox>
    	<w2:textbox style="color: blue;margin-bottom: 30px;" id="textbox3"
    		label='1-1. 첫 번째 버튼을 클릭. &lt;br/&gt;1-2. 생성된 팝업의 크기를 조절. &lt;br/&gt;1-3. 팝업 크기에 따라 팝업의 소스(src) 화면에 적응형 디자인이 적용되는 것을 확인. (adaptiveFrame: "true")&lt;br/&gt;(자세한 스크립트는 Script 탭에서 확인.)&lt;br/&gt;&lt;br/&gt;2-1. 두 번째 버튼을 클릭. &lt;br/&gt;2-2. 생성된 팝업의 크기를 조절. &lt;br/&gt;2-3. 팝업 크기에 상관 없이 적응형 디자인이 적용되지 않는 것을 확인. (adaptiveFrame: "false")&lt;br/&gt;(자세한 스크립트는 Script 탭에서 확인.)'
    		escape="false">
    	</w2:textbox>
    	<xf:trigger ev:onclick="scwin.trigger1_onclick"
    		style="display: block;height:42px;line-height:32px;padding:5px;background-color:coral;font-size:15px;weight: bolder;font-weight:bolder;margin-bottom:10px;text-align: left;"
    		id="trigger1" type="button" class="">
    		<xf:label><![CDATA[openPopup() - adaptiveFrame: "true"]]></xf:label>
    	</xf:trigger>
    	<xf:trigger type="button" id="trigger2" style="display: block;height:42px;line-height:32px;padding:5px;background-color:coral;font-size:15px;weight: bolder;font-weight:bolder;margin-bottom:10px;text-align: left;" ev:onclick="scwin.trigger2_onclick">
    		<xf:label><![CDATA[openPopup() - adaptiveFrame: "false"]]></xf:label>
    	</xf:trigger>
    </xf:group></body>
</html>
