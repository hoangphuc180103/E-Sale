// 예제 테스트를 위한 초기화
scwin.initializeExample = function () {
  let arrData = [{
    "category": "Software",
    "product": "SecureGate"
  }, {
    "category": "Hardware",
    "product": "FastServe"
  }, {
    "category": "Services",
    "product": "CloudFlex"
  }, {
    "category": "Software",
    "product": "CodeStream"
  }];

  // 데이터 할당
  dlt_exam_1.setJSON(arrData);
  dlt_exam_2.setJSON(arrData);
  dlt_exam_3.setJSON(arrData);
  dlt_exam_4.setJSON(arrData);
};

/**
 * 영역 [radio의 label 적용 - 사용자 메소드 적용]의 radioLabelFormatter
 */
scwin.grd_exam4_radioLabelFormatter = function (row, col, label) {
  let jsnRow = dlt_exam_4.getRowJSON(row); //현재 행의 json 데이터 추출

  //데이터 조합
  let returnValue = "[" + jsnRow.category + "] " + jsnRow.product;
  return returnValue;
};
