/*amd /guide_eng/TabControl/keepDisabledTab_TabControl/keepDisabledTab_TabControl.xml 4558 a96de9bcb9a9c91e9e275b1bffe90c070a3498044e33f94df871b523171b550a */
define({declaration:{A:{version:'1.0',encoding:'UTF-8'}},E:[{T:1,N:'html',A:{xmlns:'http://www.w3.org/1999/xhtml','xmlns:ev':'http://www.w3.org/2001/xml-events','xmlns:w2':'http://www.inswave.com/websquare','xmlns:xf':'http://www.w3.org/2002/xforms'},E:[{T:1,N:'head',E:[{T:1,N:'w2:type',E:[{T:3,text:'DEFAULT'}]},{T:1,N:'w2:buildDate'},{T:1,N:'xf:model',E:[{T:1,N:'w2:dataCollection',A:{baseNode:'map'}},{T:1,N:'w2:workflowCollection'}]},{T:1,N:'script',A:{type:'text/javascript',lazy:'false'},E:[{T:4,cdata:function(scopeObj){with(scopeObj){scwin.count = 0;
scwin.onpageload = function () {
  var tmpSrc1 = scwin.getfolderPath() + "/source1.xml";
  tabControl1.addTab(scwin.count, {
    label: "Tab " + scwin.count,
    title: "Tab " + scwin.count,
    openAction: "exist",
    closable: "true"
  }, {
    "src": tmpSrc1,
    "frameMode": "wframe"
  });
  tabControl1.setSelectedTabIndex(scwin.count);
  var tmpSrc2 = scwin.getfolderPath() + "/source2.xml";
  tabControl2.addTab(scwin.count, {
    label: "Tab " + scwin.count,
    title: "Tab " + scwin.count,
    openAction: "exist",
    closable: "true"
  }, {
    "src": tmpSrc2,
    "frameMode": "wframe"
  });
  tabControl2.setSelectedTabIndex(scwin.count);
  scwin.count++;
};
scwin.onpageunload = function () {};
scwin.trigger1_onclick = function (e) {
  if (tabControl1.tabArr[0].disabled === false) {
    tabControl1.disableTab(0);
  } else {
    tabControl1.enableTab(0);
  }
  if (tabControl2.tabArr[0].disabled === false) {
    tabControl2.disableTab(0);
  } else {
    tabControl2.enableTab(0);
  }
};
scwin.trigger2_onclick = function (e) {
  if (tabControl2.tabArr[0].disabled === false) {
    tabControl2.disableTab(0);
  } else {
    tabControl2.enableTab(0);
  }
};
scwin.getfolderPath = function () {
  var currentPath = window.location.href;
  var folderPath;
  if (currentPath.includes("mainContainer")) {
    console.log("true  ===> " + $p.getFrameId());
    const cmtFrame = $p.getComponentById($p.getFrameId());
    currentPath = cmtFrame.getSrc();
    folderPath = currentPath.substring(0, currentPath.lastIndexOf('/'));
  } else {
    console.log("false  ===> ");
    folderPath = currentPath.split('w2xPath=')[1].substring(0, currentPath.split('w2xPath=')[1].lastIndexOf('/'));
  }
  return folderPath;
};
}}}]}]},{T:1,N:'body',A:{'ev:onpageload':'scwin.onpageload','ev:onpageunload':'scwin.onpageunload'},E:[{T:1,N:'xf:group',A:{id:'',style:'margin: 10px;'},E:[{T:1,N:'w2:textbox',A:{tagname:'h1',style:'margin-bottom: 10px;color: blue;',id:'textbox1',label:'Maintain Disabled State of Child Tab<br/>',escape:'false'}},{T:1,N:'w2:textbox',A:{tagname:'h2',style:'height: 23px;margin-bottom: 10px;color: blue;',id:'textbox2',label:'How to Use'}},{T:1,N:'w2:textbox',A:{style:'color: blue;margin-bottom: 30px;',id:'textbox3',label:'1. Click the tabContro11.disableTab(0) button contained in the first TabControl.<br/>2. Confirm that the first tab of tabControl11 is disabled.<br/>3. Click the tabContro22.disableTab(0) button contained in the second TabControl.<br/>4. Confirm that the first tab of tabControl22 is disabled.<br/>5. Click the disableTab() & enableTab() buttons at the very top.<br/>6. Confirm that “Tab 0” is disabled in both TabControls.<br/>7. Click the disableTab() & enableTab() buttons at the very top again. <br/>8-1. Confirm that the previously disabled tab in tabControl11 remains disabled while only the other tabs become enabled. (Child TabControl\'s keepDisabledTab property value: “true”)<br/>8-2. Confirm that all tabs in tabControl22 become enabled. (Child TabControl\'s keepDisabledTab property value: “false”)',escape:'false'}},{T:1,N:'xf:trigger',A:{'ev:onclick':'scwin.trigger1_onclick',style:'display: block;height:42px;line-height:32px;margn-bottom: 10px;padding:5px;background-color:coral;font-size:15px;weight: bolder;font-weight:bolder;margin-top:10px;text-align: left;margin-bottom: 10px;',id:'trigger1',type:'button'},E:[{T:1,N:'xf:label',E:[{T:4,cdata:'disableTab() & enableTab()'}]}]},{T:1,N:'w2:tabControl',A:{confirmTrueAction:'exist',useTabKeyOnly:'true',confirmFalseAction:'new',useMoveNextTabFocus:'false',useConfirmMessage:'false',alwaysDraw:'false',style:'border: gray solid 1px;margin-bottom: 10px;height: 300px;',id:'tabControl1',keepDisabledTab:'false'}},{T:1,N:'w2:tabControl',A:{confirmTrueAction:'exist',confirmFalseAction:'new',useTabKeyOnly:'true',useMoveNextTabFocus:'false',useConfirmMessage:'false',alwaysDraw:'false',style:'border: gray solid 1px;height: 300px;',id:'tabControl2',keepDisabledTab:'false'}}]}]}]}]})