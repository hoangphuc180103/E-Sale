<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head meta_screenName="addWidgets_userIconClass_WidgetContainer">
    	<w2:type>DEFAULT</w2:type>
    	<w2:buildDate />
    	<xf:model>
    		<xf:instance>
    			<data xmlns="" />
    		</xf:instance>
    		<w2:dataCollection baseNode="map">
    		</w2:dataCollection>
    		<w2:workflowCollection></w2:workflowCollection>
    	</xf:model>

         <script type="text/javascript" lazy="false"><![CDATA[
scwin.count = 0;
scwin.onpageload = function () {

};
scwin.onpageunload = function () {

};


scwin.trigger1_onclick = function (e) {
    scwin.count++;
    widgetContainer1.addWidgets({
        id: "widget" + scwin.count,
        title: "Widget_Red_" + scwin.count + "_",
        src: null,
        scope: true,
        x: 0,
        y: scwin.count,
        unitWidth: 1,
        unitHeight: 1,
        userIconClass: "w2widget_title_imageIcon1"
    });
    scwin.count++;
    widgetContainer1.addWidgets({
        id: "widget" + scwin.count,
        title: "Widget_Blue_" + scwin.count + "_",
        src: null,
        scope: true,
        x: 1,
        y: scwin.count,
        unitWidth: 1,
        unitHeight: 1,
        userIconClass: "w2widget_title_imageIcon2"
    });
    scwin.count++;
    widgetContainer1.addWidgets({
        id: "widget" + scwin.count,
        title: "Widget_Green_" + scwin.count + "_",
        src: null,
        scope: true,
        x: 2,
        y: scwin.count,
        unitWidth: 1,
        unitHeight: 1,
        userIconClass: "w2widget_title_imageIcon3"
    });
};
]]></script>
    	<style type="text/css"><![CDATA[.w2widget>.w2widget_title>.w2widget_title_text {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.w2widget_title_buttons {}

.w2widget .w2widget_title_buttons .w2widget_btnMinimize {}

.w2widget_title_imageIcon1 {
    background-image: url("https://inswave01.atlassian.net/wiki/download/attachments/35454977/red.png?version=1&modificationDate=1741049506028&cacheVersion=1&api=v2");
    background-repeat: no-repeat;
    width: 20px;
    height: 20px;
}

.w2widget_title_imageIcon2 {
    background-image: url("https://inswave01.atlassian.net/wiki/download/attachments/35454977/blue.png?version=1&modificationDate=1741049522836&cacheVersion=1&api=v2"
        );
    background-repeat: no-repeat;
    width: 20px;
    height: 20px;
}

.w2widget_title_imageIcon3 {
    background-image: url("https://inswave01.atlassian.net/wiki/download/attachments/35454977/green.png?version=1&modificationDate=1741049546371&cacheVersion=1&api=v2");
    background-repeat: no-repeat;
    width: 25px;
    height: 25px;
}]]></style>
    </head>
    <body ev:onpageload="scwin.onpageload" ev:onpageunload="scwin.onpageunload">
    <xf:group id="" style="margin: 10px;"><w2:textbox tagname="h1" style="color: blue;margin-bottom: 10px;" tabIndex="h1" id="textbox1" label="Show Icon Image in Widget Title&lt;br/&gt;" escape="false"></w2:textbox><w2:textbox tagname="h2" style="height: 23px;margin-bottom: 10px;color: blue;" id="textbox2" label="How to Use"></w2:textbox><w2:textbox style="color: blue;margin-bottom: 30px;" id="textbox3" label='1. In the Script tab, verify the userIconClass option setting for the addWidgets() method.&lt;br/&gt;2. Click the addWidgets() button at the bottom.&lt;br/&gt;3. Verify that three widgets are added and icons appear in the widget titles according to the CSS class set in the userIconClass option.&lt;br/&gt;(Detailed scripts can be found in the Script tab and CSS tab.)' escape="false">
    	</w2:textbox><xf:trigger ev:onclick="scwin.trigger1_onclick" style="height:42px;line-height:32px;padding:5px;background-color:coral;font-size:15px;weight: bolder;font-weight:bolder;text-align: left;display: block;margin-bottom: 10px;" id="trigger1" type="button">
    		<xf:label><![CDATA[addWidgets( options.userIconClass )]]></xf:label>
    	</xf:trigger><w2:widgetContainer unitHeightPixel="100" accessibility="true" minUnitWidth="1" verticalMargin="5" threshold="500" rows="3" unfixedTitleButtons="true" params="false" processMsgFrame="true" widgetResize="true" mode="switch" preventMaximizeByTitle="false" widgetMove="true" style="height: 400px;border:1px solid black;" id="widgetContainer1" horizontalMargin="14" cols="3">
    	</w2:widgetContainer></xf:group></body>
</html>