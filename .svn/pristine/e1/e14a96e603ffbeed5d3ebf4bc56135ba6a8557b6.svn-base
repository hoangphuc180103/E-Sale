<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare"
	xmlns:xf="http://www.w3.org/2002/xforms">
	<head meta_author="InswaveSystems" meta_type="메인" meta_screenName="[GridView] 특정 컬럼의 글자색 설정하기">
		<w2:historyInfo>
			<w2:history meta_no="01" meta_desc="최초작성" meta_date="20230830" meta_user="InswaveSystems"></w2:history>
			<w2:history meta_no="02" meta_desc="설명부 수정" meta_date="20240621" meta_user="InswaveSystems"></w2:history>
			<w2:history meta_no="03" meta_desc="예제에서 사용하는 DataList가 변경되고, 이에 따른 GridView의 설정과 스크립트가 수정되었습니다." meta_date="20240712"
				meta_user="InswaveSystems"></w2:history>
		</w2:historyInfo>
		<w2:type>COMPONENT</w2:type>
		<w2:buildDate />
		<w2:MSA />
		<xf:model>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" repeatNode="map" id="dlt_exam" saveRemovedData="true">
					<w2:columnInfo>
						<w2:column dataType="text" name="A" id="col_a"></w2:column>
						<w2:column dataType="text" name="B" id="col_b"></w2:column>
						<w2:column dataType="text" name="C" id="col_c"></w2:column>
					</w2:columnInfo>
					<w2:data use="true">
						<w2:row>
							<col_a><![CDATA[A1]]></col_a>
							<col_b><![CDATA[B1]]></col_b>
							<col_c><![CDATA[C1]]></col_c>
						</w2:row>
						<w2:row>
							<col_a><![CDATA[A2]]></col_a>
							<col_b><![CDATA[B2]]></col_b>
							<col_c><![CDATA[C2]]></col_c>
						</w2:row>
						<w2:row>
							<col_a><![CDATA[A3]]></col_a>
							<col_b><![CDATA[B3]]></col_b>
							<col_c><![CDATA[C3]]></col_c>
						</w2:row>
					</w2:data>
				</w2:dataList>
			</w2:dataCollection>
			<w2:workflowCollection />
		</xf:model>
		<w2:layoutInfo />
		<w2:publicInfo method="" />
		<script lazy="false" type="text/javascript"><![CDATA[
scwin.onpageload = function () {

};

/**
 * 버튼 [열의 글자색을 'tomato'로 설정하기 - body column index 사용] 클릭 시
 */
scwin.btn_exam1_onclick = function (e) {
    //GridView 'grd_exam1'의 바디 컬럼의 index가 0번째인 컬럼의 글자색을 'tomato'로 설정하기
    grd_exam1.setColumnColor(0, "tomato");
};

/**
 * 버튼 [열의 글자색을 '#9ACD32'로 설정하기 - body column id 사용] 클릭 시
 */
scwin.btn_exam2_onclick = function (e) {
    //GridView 'grd_exam1'의 바디 컬럼의 'id'가 'col_b'인 컬럼의 글자색을 '#9ACD32'로 설정하기
    grd_exam1.setColumnColor('col_b', "#9ACD32");
};

]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:group class="sub_contents" id="" style="">
			<xf:group class="ws_example_grp_desc" id="" style="">
				<w2:textbox escape="false" id="" label="GridView의 'setColumnColor' 메소드를 사용하여 특정 컬럼의 글자색을 설정하는 예제입니다." style=""></w2:textbox>
			</xf:group>
			<xf:group class="example_div_tb_style_wrap" id="">
				<xf:group class="example_div_tr_style" id="" style="">
					<xf:group class="example_div_td_style" id="" style="">
						<xf:group class="mb_def_box nobottom" id="" style="">
							<xf:trigger class="btn_exam_exec btn_txt_of" disabled="" escape="false" ev:onclick="scwin.btn_exam1_onclick"
								id="btn_exam1" style="" type="button">
								<xf:label><![CDATA[열의 글자색을 'tomato'로 설정하기 - body column의 index 사용]]></xf:label>
							</xf:trigger>
							<xf:trigger class="btn_exam_exec btn_txt_of" disabled="" escape="false" id="btn_exam2" style="" type="button"
								ev:onclick="scwin.btn_exam2_onclick">
								<xf:label><![CDATA[열의 글자색을 '#9ACD32'로 설정하기 - body column의 id 사용]]></xf:label>
							</xf:trigger>
						</xf:group>
						<xf:group id="" class="gvwbox">
							<w2:gridView rowNumWidth="40" keepDefaultColumnWidth="true" visibleRowNumFix="true" rowNumVisible="true"
								dataList="data:dlt_exam" style="height:100px;" readOnly="true" autoFit="allColumn" id="grd_exam1" visibleRowNum="3" class="gvw"
								defaultCellHeight="37" autoFitMinWidth="240">
								<w2:caption style="" id="caption1" value="this is a grid caption."></w2:caption>
								<w2:header style="" id="header1">
									<w2:row style="" id="row1">
										<w2:column width="70" inputType="text" style="" id="column3" value="A" displayMode="label"></w2:column>
										<w2:column width="70" inputType="text" style="" id="column2" value="B" displayMode="label"></w2:column>
										<w2:column width="70" inputType="text" style="" id="column1" value="C" displayMode="label"></w2:column>
									</w2:row>
								</w2:header>
								<w2:gBody style="" id="gBody1">
									<w2:row style="" id="row2">
										<w2:column width="70" inputType="text" style="" id="col_a" value="" displayMode="label"></w2:column>
										<w2:column width="70" inputType="text" style="" id="col_b" value="" displayMode="label"></w2:column>
										<w2:column width="70" inputType="text" style="" id="col_c" value="" displayMode="label"></w2:column>
									</w2:row>
								</w2:gBody>
							</w2:gridView>
						</xf:group>
					</xf:group>
				</xf:group>
			</xf:group>
		</xf:group>
	</body>
</html>