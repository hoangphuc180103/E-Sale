<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
        	<xf:instance>
        		<data xmlns="" />
        	</xf:instance>
        	<w2:dataCollection baseNode="map">
        		<w2:dataList baseNode="list" id="dataList1" repeatNode="map" saveRemovedData="true" style="">
        			<w2:columnInfo>
        				<w2:column dataType="text" id="C_Code" name="name1"></w2:column>
        				<w2:column dataType="text" id="City" name="name2"></w2:column>
        				<w2:column dataType="text" id="Country" name="name3"></w2:column>
        				<w2:column dataType="text" id="Airport" name="name4"></w2:column>
        				<w2:column dataType="text" id="A_Code" name="name5"></w2:column>
        			</w2:columnInfo>
        		</w2:dataList>
        	</w2:dataCollection>
        	<w2:workflowCollection></w2:workflowCollection>
        </xf:model>
        <script type="text/javascript" lazy="false"><![CDATA[
	scwin.onpageload = function() {
		var json = [{
			"C_Code" : "PAR",
			"Airport" : "ORLY",
			"Country" : "FRANCE",
			"City" : "PARIS",
			"A_Code" : "ORY"
		}, {
			"C_Code" : "PDX",
			"Airport" : "PORTLAND INT’L",
			"Country" : "U.S.A.",
			"City" : "PORTLAND",
			"A_Code" : "PDX"
		}, {
			"C_Code" : "PEK",
			"Airport" : "CAPITAL",
			"Country" : "CHINA",
			"City" : "BEIJING",
			"A_Code" : "PEK"
		}, {
			"C_Code" : "PER",
			"Airport" : "PERTH",
			"Country" : "AUSTRALIA",
			"City" : "PERTH",
			"A_Code" : "PER"
		}, {
			"C_Code" : "PHL",
			"Airport" : "PHILADELPHIA INT’L",
			"Country" : "U.S.A.",
			"City" : "PHILADELPHIA",
			"A_Code" : "PHL"
		}, {
			"C_Code" : "PHX",
			"Airport" : "SKY HARBOR ",
			"Country" : "U.S.A.",
			"City" : "PHOENIX",
			"A_Code" : "PHX"
		}, {
			"C_Code" : "PIT",
			"Airport" : "PITTSBURGH INT’L",
			"Country" : "U.S.A.",
			"City" : "PITTSBURGH",
			"A_Code" : "PIT"
		}, {
			"C_Code" : "PNH",
			"Airport" : "POCHENTONG",
			"Country" : "CAMBODIA",
			"City" : "PHNOMPENH",
			"A_Code" : "PNH"
		}, {
			"C_Code" : "PUS",
			"Airport" : "KIMHAE",
			"Country" : "KOREA",
			"City" : "PUSAN",
			"A_Code" : "PUS"
		}];
		dataList1.setJSON(json);
	};

	scwin.onpageunload = function() {

	};
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload" ev:onpageunload="scwin.onpageunload">
    <xf:group id="" style="margin: 10px;">
    	<w2:textbox tagname="h1" style="color: blue;margin-bottom: 10px;" tabIndex="h1" id="textbox1" label="馬の省略記号を表示" escape="false"></w2:textbox>
    	<w2:textbox tagname="h2" style="height: 23px;margin-bottom: 10px;color: blue;" id="textbox2" label="サンプルの使い方"></w2:textbox>
    	<w2:textbox style="color: blue;margin-bottom: 30px;" id="textbox3"
    		label="（初めて目 CheckComboBox）&lt;br/&gt;1. CheckComboBoxのリスト開く。 &lt;br/&gt;2. 選択アイテムのテキストリスト幅より道ケース, 馬省略記号と一緒に表示されるもの確認。&lt;br/&gt;&lt;br/&gt;（二つ目 CheckComboBox）&lt;br/&gt;2-1. CheckComboBoxのリスト開く。 &lt;br/&gt;2-2. 選択アイテムのテキスト道ケース, リスト幅に該当するテキストのみ表示されるもの確認。&lt;br/&gt;" escape="false">
    	</w2:textbox>
    	<w2:textbox
    		style="padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightblue;border:none;margin-bottom: 20px;"
    		id="textbox4" label='プロパティの設定&lt;br/&gt;columnEllipsis="true"' escape="false">
    	</w2:textbox>
    	<xf:checkcombobox displayAllOptionLabel="false" chooseOptionLabel="Choose airport(s)." submenuSize="fixed" chooseOption="true"
    		allOption="true" displayMode="value delim label" ref="" appearance="minimal" columnEllipsis="true" delimiter=", " style="width: 170px;display: block;margin-bottom: 10px;"
    		disabled="false" id="checkcombobox1" displaymessage="">
    		<xf:choices>
    			<xf:itemset nodeset="data:dataList1">
    				<xf:label ref="Airport"></xf:label>
    				<xf:value ref="A_Code"></xf:value>
    			</xf:itemset>
    		</xf:choices>
    	</xf:checkcombobox>
    	<w2:textbox escape="false" id="textbox5" label='プロパティの設定&lt;br/&gt;columnEllipsis="false"'
    		style="padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightblue;border:none;margin-bottom: 20px;">
    	</w2:textbox>
    	<xf:checkcombobox allOption="true" appearance="minimal" chooseOption="true" chooseOptionLabel="Choose airport(s)."
    		columnEllipsis="false" delimiter=", " disabled="false" displayAllOptionLabel="false" displayMode="value delim label" displaymessage=""
    		id="checkcombobox2" ref="" style="width: 170px;display: block;" submenuSize="fixed">
    		<xf:choices>
    			<xf:itemset nodeset="data:dataList1">
    				<xf:label ref="Airport"></xf:label>
    				<xf:value ref="A_Code"></xf:value>
    			</xf:itemset>
    		</xf:choices>
    	</xf:checkcombobox>
    </xf:group></body>
</html>
