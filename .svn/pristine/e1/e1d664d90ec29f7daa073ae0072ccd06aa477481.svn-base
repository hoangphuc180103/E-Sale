<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare"
	xmlns:xf="http://www.w3.org/2002/xforms">
	<head meta_author="InswaveSystems" meta_type="메인" meta_screenName="[PageList] 페이지 숫자 사이에 구분자 사용하기">
		<w2:historyInfo>
			<w2:history meta_no="01" meta_desc="최초작성" meta_date="20231115" meta_user="InswaveSystems"></w2:history>
			<w2:history meta_no="02" meta_desc="설명부 수정" meta_date="20240621" meta_user="InswaveSystems" ></w2:history>
		</w2:historyInfo>
		<w2:type>COMPONENT</w2:type>
		<w2:buildDate />
		<w2:MSA />
		<xf:model>
			<w2:dataCollection baseNode="map"></w2:dataCollection>
			<w2:workflowCollection />
		</xf:model>
		<w2:layoutInfo />
		<w2:publicInfo method="" />
		<script lazy="false" type="text/javascript"><![CDATA[
scwin.onpageload = function () {
    // PageList 'pgc_exam1', 'pgc_exam2'의 전체 페이지 수를 12로 설정합니다.
    pgl_exam1.setCount(12);
    pgl_exam2.setCount(12);
};
]]>
		</script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:group class="sub_contents" id="" style="">
			<xf:group class="ws_example_grp_desc" id="" style="">
				<w2:textbox escape="false" id=""
					label="PageList의 'useDelim' 속성과 'delimiter' 속성을 사용하여 페이지 숫자 사이에 구분자를 표시한 예제입니다." style="">
				</w2:textbox>
			</xf:group>
			<xf:group class="example_div_tb_style_wrap" id="">
				<xf:group class="example_div_tr_style" id="" style="">
					<w2:textbox class="example_div_th_style" escape="false" id="" label="숫자 사이에 구분자 표시하기" style=""></w2:textbox>
					<xf:group class="example_div_td_style" id="" style="">
						<w2:textbox class="wre_txt_normal" escape="false" id="" label="구분자로 문자열 '|'이 설정되었습니다." style=""></w2:textbox>
						<w2:pageList deliImageStyle="color:#bbb; font-size:0.9em; padding-bottom:2px;" delimiter="|" displayFormat="#"
							id="pgl_exam1" style="height: 24px;" useDelim="true">
						</w2:pageList>
					</xf:group>
				</xf:group>
				<xf:group class="example_div_tr_style" id="" style="">
					<w2:textbox class="example_div_th_style" escape="false" id="" label="(기본 설정) 숫자 사이에 구분자 표시하지 않기" style=""></w2:textbox>
					<xf:group class="example_div_td_style" id="" style="">
						<w2:pageList displayFormat="#" id="pgl_exam2" style="height: 24px;" useDelim="false"></w2:pageList>
					</xf:group>
				</xf:group>
			</xf:group>
		</xf:group>
	</body>
</html>