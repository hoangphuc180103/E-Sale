<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare"
	xmlns:xf="http://www.w3.org/2002/xforms">
	<head meta_author="InswaveSystems" meta_type="메인" meta_screenName="[GridView] 데이터 복사 - 데이터 출처 설정">
		<w2:historyInfo>
			<w2:history meta_no="01" meta_desc="최초작성" meta_date="20220907" meta_user="InswaveSystems"></w2:history>
			<w2:history meta_no="02" meta_desc="예제 파일에 설명 문구 보충" meta_date="20230216" meta_user="InswaveSystems"></w2:history>
			<w2:history meta_no="03" meta_desc="설명부 수정" meta_date="20240621" meta_user="InswaveSystems" ></w2:history>
			<w2:history meta_no="04" meta_desc="예제에서 사용하는 DataList가 변경되고, 이에 따른 GridVeiw의 설정이 수정되었습니다." meta_date="20240627" meta_user="InswaveSystems"></w2:history>
		</w2:historyInfo>
		<w2:type>COMPONENT</w2:type>
		<w2:buildDate />
		<w2:MSA />
		<xf:model>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" id="dlt_exam" repeatNode="map">
					<w2:columnInfo>
						<w2:column dataType="text" id="created_date" name="Created Date"></w2:column>
						<w2:column dataType="text" id="product" name="Product"></w2:column>
						<w2:column id="stock" name="Stock" dataType="text"></w2:column>
					</w2:columnInfo>
					<w2:data use="true" xmlns="">
						<w2:row>
							<product><![CDATA[SecureGate]]></product>
							<stock><![CDATA[98291]]></stock>
							<created_date><![CDATA[20110715]]></created_date>
						</w2:row>
						<w2:row>
							<product><![CDATA[FastServe]]></product>
							<stock><![CDATA[528]]></stock>
							<created_date><![CDATA[19991225]]></created_date>
						</w2:row>
						<w2:row>
							<product><![CDATA[NetMax]]></product>
							<stock><![CDATA[4536219]]></stock>
							<created_date><![CDATA[19950103]]></created_date>
						</w2:row>
					</w2:data>
				</w2:dataList>
			</w2:dataCollection>
			<w2:workflowCollection />
		</xf:model>
		<w2:layoutInfo />
		<w2:publicInfo method="" />
		<script lazy="false" type="text/javascript"><![CDATA[
scwin.onpageload = function () {

};

]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:group class="sub_contents">
			<xf:group class="ws_example_grp_desc">
				<w2:textbox escape="false"
					label="GridView의 'copyOption' 속성을 사용하여, 데이터 복사(Ctrl+C)를 할 때, 데이터의 출처를 설정한 예제입니다.&lt;br/&gt;&quot;Date&quot;, &quot;Stock&quot; 컬럼의 셀을 복사하여 비교합니다.">
				</w2:textbox>
			</xf:group>
			<xf:group class="example_div_tb_style_wrap">
				<xf:group class="example_div_tr_style">
					<w2:textbox class="example_div_th_style" escape="false" label="(기본설정) 연결된 DataList의 값으로 복사"></w2:textbox>
					<xf:group class="example_div_td_style">
					<xf:group id="" class="gvwbox">
						<w2:gridView dataList="data:dlt_exam" style="height: 150px;" autoFit="allColumn" visibleRowNum="all" class="gvw"
							defaultCellHeight="37" autoFitMinWidth="240" copyOption="dataList">
							<w2:caption id="caption1" value="this is a grid caption."></w2:caption>
							<w2:header id="header1">
								<w2:row id="row1">
									<w2:column width="83" inputType="text" id="column1" value="Date" displayMode="label" class="wre_txt_blue"></w2:column>
									<w2:column width="130" inputType="text" id="column3" value="Product" displayMode="label"></w2:column>
									<w2:column width="70" inputType="text" id="column2" value="Stock" displayMode="label" class="wre_txt_blue"></w2:column>
								</w2:row>
							</w2:header>
							<w2:gBody id="gBody1">
								<w2:row id="row2">
									<w2:column dataType="date" width="83" displayFormat="yyyy-MM-dd" inputType="text" id="created_date"
										displayMode="label">
									</w2:column>
									<w2:column textAlign="left" width="130" inputType="text" id="product" displayMode="label"></w2:column>
									<w2:column textAlign="right" dataType="number" width="70" displayFormat="#,###" inputType="text"
										id="stock" displayMode="label">
									</w2:column>
								</w2:row>
							</w2:gBody>
						</w2:gridView></xf:group></xf:group>
				</xf:group>
				<xf:group class="example_div_tr_style">
					<w2:textbox class="example_div_th_style" escape="false" label="셀에 표시된 값으로 복사"></w2:textbox>
					<xf:group class="example_div_td_style">
					<xf:group id="" class="gvwbox">
						<w2:gridView dataList="data:dlt_exam" style="height: 150px;" autoFit="allColumn" visibleRowNum="all" class="gvw"
							defaultCellHeight="37" copyOption="display" autoFitMinWidth="240">
							<w2:caption id="caption1" value="this is a grid caption."></w2:caption>
							<w2:header id="header1">
								<w2:row id="row1">
									<w2:column width="83" inputType="text" id="column1" value="Date" displayMode="label" class="wre_txt_blue"></w2:column>
									<w2:column width="130" inputType="text" id="column3" value="Product" displayMode="label"></w2:column>
									<w2:column width="70" inputType="text" id="column2" value="Stock" displayMode="label" class="wre_txt_blue"></w2:column>
								</w2:row>
							</w2:header>
							<w2:gBody id="gBody1">
								<w2:row id="row2">
									<w2:column dataType="date" width="83" displayFormat="yyyy-MM-dd" inputType="text" id="created_date"
										displayMode="label">
									</w2:column>
									<w2:column textAlign="left" width="130" inputType="text" id="product" displayMode="label"></w2:column>
									<w2:column textAlign="right" dataType="number" width="70" displayFormat="#,###" inputType="text"
										id="stock" displayMode="label">
									</w2:column>
								</w2:row>
							</w2:gBody>
						</w2:gridView></xf:group></xf:group>
				</xf:group>
				<xf:group class="example_div_tr_style">
					<xf:group class="example_div_th_style">
						<w2:textbox escape="false" label="컬럼별 복사할 데이터 출처 설정">
						</w2:textbox>
					</xf:group>
					<xf:group class="example_div_td_style">
						<w2:textbox escape="false" label="Stock : 화면에 표시된 값으로 복사">
						</w2:textbox>
						<w2:textbox class="mb10" escape="false" label="Date : DataList의 값으로 복사">
						</w2:textbox>
					<xf:group id="" class="gvwbox">
						<w2:gridView dataList="data:dlt_exam" style="height: 150px;" autoFit="allColumn" visibleRowNum="all" class="gvw"
							defaultCellHeight="37" autoFitMinWidth="240">
							<w2:caption id="caption1" value="this is a grid caption."></w2:caption>
							<w2:header id="header1">
								<w2:row id="row1">
									<w2:column width="83" inputType="text" id="column1" value="Date" displayMode="label" class="wre_txt_blue"></w2:column>
									<w2:column width="130" inputType="text" id="column3" value="Product" displayMode="label"></w2:column>
									<w2:column width="70" inputType="text" id="column2" value="Stock" displayMode="label" class="wre_txt_blue"></w2:column>
								</w2:row>
							</w2:header>
							<w2:gBody id="gBody1">
								<w2:row id="row2">
									<w2:column dataType="date" width="83" displayFormat="yyyy-MM-dd" inputType="text" id="created_date"
										displayMode="label">
									</w2:column>
									<w2:column textAlign="left" width="130" inputType="text" id="product" displayMode="label"></w2:column>
									<w2:column textAlign="right" dataType="number" width="70" displayFormat="#,###" inputType="text"
										id="stock" copyOption="display" displayMode="label">
									</w2:column>
								</w2:row>
							</w2:gBody>
						</w2:gridView></xf:group></xf:group>
				</xf:group>
			</xf:group>
		</xf:group>
	</body>
</html>