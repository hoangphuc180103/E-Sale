define({declaration:{A:{version:'1.0',encoding:'UTF-8'}},E:[{T:1,N:'html',A:{xmlns:'http://www.w3.org/1999/xhtml','xmlns:ev':'http://www.w3.org/2001/xml-events','xmlns:w2':'http://www.inswave.com/websquare','xmlns:xf':'http://www.w3.org/2002/xforms'},E:[{T:1,N:'head',A:{},E:[{T:1,N:'w2:type',E:[{T:3,text:'COMPONENT'}]},{T:1,N:'w2:buildDate'},{T:1,N:'w2:MSA'},{T:1,N:'xf:model',E:[{T:1,N:'w2:dataCollection',A:{baseNode:'map'}},{T:1,N:'w2:workflowCollection'}]},{T:1,N:'w2:layoutInfo'},{T:1,N:'w2:publicInfo',A:{method:''}},{T:1,N:'script',A:{lazy:'false',type:'text/javascript'},E:[{T:4,cdata:function(scopeObj){with(scopeObj){scwin.onpageload = function () {};
}}}]}]},{T:1,N:'body',A:{'ev:onpageload':'scwin.onpageload'},E:[{T:1,N:'xf:group',A:{class:'ws_example_grp_desc',id:'',style:''},E:[{T:1,N:'xf:group',A:{class:'',id:'',style:'',tagname:'details'},E:[{T:1,N:'w2:textbox',A:{escape:'false',id:'',label:'실습 목표',style:'',tagname:'summary'}},{T:1,N:'w2:textbox',A:{class:'',escape:'false',id:'',label:'API를 활용하여 영역을 보이기/숨기기 처리',style:''}}]},{T:1,N:'xf:group',A:{class:'',id:'',style:'',tagname:'details'},E:[{T:1,N:'w2:textbox',A:{escape:'false',id:'',label:'실습 방법',style:'',tagname:'summary'}},{T:1,N:'w2:textbox',A:{class:'',escape:'false',id:'',label:'1. Design Kit 를 활용하여 TableLayout을 추가합니다.<br/>2. TableLayout 컴포넌트를 편집합니다.<br/><br/> &nbsp; TableLayout 컴포넌트에 id를을 작성합니다. (id : ui_table)<br/> &nbsp; TableLayout의 행영역(tr)에 id를을 작성합니다. (id : ui_tr1)<br/> &nbsp; TableLayout의 제목영역(th)에 텍스트를 작성합니다. (첫째줄)<br/> &nbsp; TableLayout의 body영역(td)에 컴포넌트를 작성합니다. (inputBox 컴포넌트)<br/> &nbsp; <br/> &nbsp; 웹스퀘어에서는 F2 단축키 선택시 선택영역 기준으로 상위(부모)영역이 선택됩니다.<br/> &nbsp; &nbsp;ex) TableLayout 컴포넌트에서 셀(th, td등) 선택 후 F2 단축키 선택 해당 줄(tr)이 선택됩니다.<br/> &nbsp;<br/>3. 테이블 보여주기 버튼에 onClick 이벤트<br/> &nbsp; ui_table.show("");<br/>4. 테이블 숨기기 버튼에 onClick 이벤트<br/> &nbsp; ui_table.hide(); &nbsp;<br/>5. 첫번째 줄 보임 버튼에 onClick 이벤트<br/> &nbsp; ui_tr1.show("");<br/>6. 첫번째 줄 숨김 버튼에 onClick 이벤트<br/> &nbsp; ui_tr1.hide(); &nbsp;',style:''}}]}]}]}]}]})