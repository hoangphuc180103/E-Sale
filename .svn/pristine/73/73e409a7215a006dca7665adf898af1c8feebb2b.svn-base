    <body ev:onpageload="scwin.onpageload" ev:onpageunload="scwin.onpageunload" style="">
    <xf:group id="" style="margin: 10px;">
    	<w2:textbox tagname="h1" style="color: blue;margin-bottom: 10px;" tabIndex="h1" id="textbox1" label="DataListのrowPositionに対応する行をフォーカスする" escape="false"></w2:textbox>
    	<w2:textbox tagname="h2" style="height: 23px;margin-bottom: 10px;color: blue;" id="textbox2" label="サンプルの使い方"></w2:textbox>
    	<w2:textbox style="color: blue;margin-bottom: 30px;" id="textbox3"
    		label='1. 下のボタンクリックして dataList1の rowPositionを "2"ロー設定。 &lt;br/&gt;2. 初めて目 GridViewのフォーカス新 rowPosition="2" 行で移動するもの確認。 &lt;br/&gt;3. 二つ目 GridViewではフォーカス移動しないないもの確認。&lt;br/&gt;（二つ GridView みんな "dataList1"とバインドあり。）'
    		escape="false">
    	</w2:textbox>
    	<xf:trigger ev:onclick="scwin.trigger1_onclick"
    		style="height:42px;line-height:32px;padding:5px;background-color:coral;font-size:15px;weight: bolder;font-weight:bolder;text-align: left;display: block;margin-bottom: 10px;"
    		id="trigger1" type="button">
    		<xf:label><![CDATA[dataList1.setRowPosition(2);]]></xf:label>
    	</xf:trigger>
    	<w2:textbox
    		style="padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightblue;border:none;margin-bottom: 10px;"
    		id="textbox4" label='プロパティの設定&lt;br/&gt;syncRowPositionOption="style"' escape="false">
    	</w2:textbox>
    	<w2:gridView syncRowPositionOption="style" scrollByColumnAdaptive="false" focusMode="row" rowNumVisible="true" checkAllType="false"
    		dataList="data:dataList1" style="border: solid 1px gray;margin-bottom: 10px;" scrollByColumn="false" id="gridView1" visibleRowNum="5"
    		autoFit="allColumn" defaultCellHeight="20" visibleRowNumFix="true">
    		<w2:caption style="" id="caption1" value="this is a grid caption."></w2:caption>
    		<w2:header style="" id="header1">
    			<w2:row style="" id="row1">
    				<w2:column width="70" inputType="text" style="" id="column5" value="AAA" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="" id="column4" value="BBB" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="" id="column3" value="CCC" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="" id="column2" value="DDD" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="" id="column1" value="EEE" displayMode="label"></w2:column>
    			</w2:row>
    		</w2:header>
    		<w2:gBody style="" id="gBody1">
    			<w2:row style="" id="row2">
    				<w2:column width="70" inputType="text" style="" id="col1" value="" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="" id="col2" value="" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="" id="col3" value="" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="" id="col4" value="" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="" id="col5" value="" displayMode="label"></w2:column>
    			</w2:row>
    		</w2:gBody>
    	</w2:gridView>
    	<w2:textbox escape="false" id="textbox5" label='プロパティの設定&lt;br/&gt;syncRowPositionOption="none"'
    		style="padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightblue;border:none;margin-bottom: 10px;">
    	</w2:textbox>
    	<w2:gridView autoFit="allColumn" checkAllType="false" dataList="data:dataList1" defaultCellHeight="20" focusMode="row"
    		id="gridView2" rowNumVisible="true" scrollByColumn="false" scrollByColumnAdaptive="false" style="border: solid 1px gray;visiblerow"
    		visibleRowNum="5" visibleRowNumFix="true" syncRowPositionOption="none">
    		<w2:caption id="caption2" style="" value="this is a grid caption."></w2:caption>
    		<w2:header id="header1" style="">
    			<w2:row id="row1" style="">
    				<w2:column displayMode="label" id="column5" inputType="text" style="" value="AAA" width="70"></w2:column>
    				<w2:column displayMode="label" id="column4" inputType="text" style="" value="BBB" width="70"></w2:column>
    				<w2:column displayMode="label" id="column3" inputType="text" style="" value="CCC" width="70"></w2:column>
    				<w2:column displayMode="label" id="column2" inputType="text" style="" value="DDD" width="70"></w2:column>
    				<w2:column displayMode="label" id="column1" inputType="text" style="" value="EEE" width="70"></w2:column>
    			</w2:row>
    		</w2:header>
    		<w2:gBody id="gBody1" style="">
    			<w2:row id="row2" style="">
    				<w2:column displayMode="label" id="col1" inputType="text" style="" value="" width="70"></w2:column>
    				<w2:column displayMode="label" id="col2" inputType="text" style="" value="" width="70"></w2:column>
    				<w2:column displayMode="label" id="col3" inputType="text" style="" value="" width="70"></w2:column>
    				<w2:column displayMode="label" id="col4" inputType="text" style="" value="" width="70"></w2:column>
    				<w2:column displayMode="label" id="col5" inputType="text" style="" value="" width="70"></w2:column>
    			</w2:row>
    		</w2:gBody>
    	</w2:gridView>
    </xf:group></body>
</html>
