<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
         <script type="text/javascript" lazy="false"><![CDATA[

scwin.onpageload = function () {

};

scwin.onpageunload = function () {

};


scwin.trigger1_onclick = function (e) {
    //var result = input1.validate();
    //alert (result);
    input1.validate();
};

scwin.fn_msg = function () {
    var invalidType = this.getType();
    var invalidValue = this.getValue();
    switch (invalidType) {
        case "mandatory":
            msg = "Information is required.";
            break;
        case "minLength":
            msg = "Minimum " + invalidValue + " digits are required.";
            break;
        case "minByteLength":
            msg = "Minimum " + invalidValue + " bytes are required.";
            break;
        default:
            msg = "Not valid";
            break;
    }
    return msg;
}
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload" ev:onpageunload="scwin.onpageunload">
    <xf:group id="" style="margin: 10px;">
    	<w2:textbox style="color: blue;margin-bottom: 10px;" id="textbox1" label="Validation and Error Message Display&lt;br/&gt;"
    		escape="false" tagname="h1" tabIndex="h1">
    	</w2:textbox>
    	<w2:textbox tagname="h2" style="height: 23px;margin-bottom: 10px;color: blue;" id="textbox3" label="How to Use"></w2:textbox>
    	<w2:textbox style="color: blue;margin-bottom: 30px;" id="textbox2"
    		label="1. Enter text less than 5 bytes in length.&lt;br/&gt;2. Click the validate() button.&lt;br/&gt;3. Confirm that the error message returned by the function specified in the invalidMessageFunc property is displayed.&lt;br/&gt;4. Click the validate() button without entering anything.&lt;br/&gt;5. Confirm that the error message returned by the function specified in the invalidMessageFunc property is displayed."
    		escape="false">
    	</w2:textbox>
    	<w2:textbox
    		style="padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightblue;border:none;margin-bottom: 10px;"
    		id="textbox5"
    		label='minByteLength="5" &lt;br/&gt;mandatory="true" &lt;br/&gt;displaymessage="true" &lt;br/&gt;invalidMessageFunc="scwin.fn_msg"'
    		escape="false">
    	</w2:textbox>
    	<xf:trigger ev:onclick="scwin.trigger1_onclick"
    		style="display: block;height:42px;line-height:32px;padding:5px;background-color:coral;font-size:15px;weight: bolder;font-weight:bolder;margin-bottom:10px;text-align: left;"
    		id="trigger1" type="button">
    		<xf:label><![CDATA[input1.validate();]]></xf:label>
    	</xf:trigger>
    	<xf:input minlength="" minByteLength="5" invalidMessage="" adjustMaxLength="false"
    		style="width: 100%;text-align: right;height:50px;padding: 5px;font-size:30px;font-style:normal;font-weight:bolder;color: red;"
    		invalidMessageFunc="scwin.fn_msg" id="input1" displaymessage="true" mandatory="true">
    	</xf:input>
    	<w2:textbox escape="false" id="textbox6" label='/// Sample Code &lt;br/&gt;&lt;br/&gt;scwin.fn_msg = function () {&lt;br/&gt; &amp;nbsp; &amp;nbsp;var invalidType = this.getType();&lt;br/&gt; &amp;nbsp; &amp;nbsp;var invalidValue = this.getValue();&lt;br/&gt; &amp;nbsp; &amp;nbsp;switch (invalidType) {&lt;br/&gt; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;case "mandatory":&lt;br/&gt; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;msg = "Information is required.";&lt;br/&gt; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;break;&lt;br/&gt; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;case "minLength":&lt;br/&gt; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;msg = "Minimum " + invalidValue + " digits are required.";&lt;br/&gt; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;break;&lt;br/&gt; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;case "minByteLength":&lt;br/&gt; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;msg = "Minimum " + invalidValue + " bytes are required.";&lt;br/&gt; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;break;&lt;br/&gt; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;default:&lt;br/&gt; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;msg = "Not valid";&lt;br/&gt; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;break;&lt;br/&gt; &amp;nbsp; &amp;nbsp;}&lt;br/&gt; &amp;nbsp; &amp;nbsp;return msg;&lt;br/&gt;}'
    		style="padding:10px; padding-bottom:20px; text-align:left; font-size:15px; font-weight:bolder; border:brown 1px solid; background-color:ivory; margin-bottom:10px; margin-top:10px; color:brown;">
    	</w2:textbox>
    </xf:group></body>
</html>
