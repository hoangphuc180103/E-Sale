<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head meta_screenName="openPopup_$p">
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
         <script type="text/javascript" lazy="false"><![CDATA[scwin.count=0;
        
	scwin.onpageload = function() {
		requires("uiplugin.popup");
	};
	
	scwin.onpageunload = function() {
		
	};
	
	scwin.trigger2_onclick = function(e) {
        scwin.count++;
		const tmpSrc = scwin.getfolderPath() + "/openPopup_p.xml";
	
		var options = {  
		 
		        id : scwin.count, 
		        type : "pageFramePopup", 
		        width: "450px", 
		        height: "400px", 
		        top: "130px", 
		        left: "200px", 
		        popupName : "Popup (openPopup_p.xml)", 
                modal: true,
		        resizable : true
		    }; 
	 
	    $p.openPopup(tmpSrc,options );
	};
	
scwin.getfolderPath = function () {

    var currentPath = window.location.href;
    var folderPath;

    if (currentPath.includes("mainContainer")) {
        console.log("true  ===> " + $p.getFrameId());
        const cmtFrame = $p.getComponentById($p.getFrameId());
        currentPath = cmtFrame.getSrc();
        folderPath = currentPath.substring(0, currentPath.lastIndexOf('/'));
    } else {
        console.log("false  ===> ");
        folderPath = currentPath.split('w2xPath=')[1].substring(0, currentPath.split('w2xPath=')[1].lastIndexOf('/'));
    }
    return folderPath;
};
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload" ev:onpageunload="scwin.onpageunload">
    <xf:group id="" style="margin: 10px;"><w2:textbox tagname="h1" style="color: blue;margin-bottom: 10px;" tabIndex="h1" id="textbox1" label="イベント - onpageframeload &amp; onbeforepageframeunload" escape="false"></w2:textbox><w2:textbox tagname="h2" style="height: 23px;margin-bottom: 10px;color: blue;" id="textbox2" label="サンプルの使い方"></w2:textbox><w2:textbox style="color: blue;margin-bottom: 30px;" id="textbox3" label="1. 下のボタンクリックしてポップアップ窓開く。 &lt;br/&gt; &amp;nbsp; (ポップアップ創造ソース画面(openPopup_$p.xml)この PageFrameを含む。) &lt;br/&gt;2. ポップアップチャンギ表示される前に onpageframeload イベント発生するもの確認。 &lt;br/&gt;3. ポップアップ窓右上の閉じるボタンクリック。 &lt;br/&gt;4. ポップアップチャンギ閉じる前に onpageframeunload イベント発生するもの確認。" escape="false">
    	</w2:textbox><w2:textbox style="padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightgreen;border:none;margin-bottom: 10px;" id="textbox4" label="イベント説明&lt;br/&gt;onpageframeload - PageFrame がロードされた時点で発生します。 &lt;br/&gt;onpageframeunload - PageFrameのソースページがsetSrc()によって新しく設定されるか、PageFrameがアンロードされる直前に発生します。" escape="false">
    	</w2:textbox><xf:trigger ev:onclick="scwin.trigger2_onclick" style="height:42px;line-height:32px;padding:5px;background-color:coral;font-size:15px;weight: bolder;font-weight:bolder;text-align: left;display: block;margin-bottom: 10px;" id="trigger2" type="button">
    		<xf:label><![CDATA[$p.openPopup() ]]></xf:label>
    	</xf:trigger></xf:group></body>
</html>
