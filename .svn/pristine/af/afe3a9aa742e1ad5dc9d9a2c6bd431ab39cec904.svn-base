/**
 * displayFormat = "yyyy-MM-dd"에서 
 * 버튼 [format이 적용된 값 반환 받기] 클릭 시 호출
 */
scwin.btn_ex1_onclick = function (e) {
  //format이 적용된 값을 넘기는 경우
  var returnValue = ica_exam_1.getDisplayValue();

  // 로그 출력
  let strLog = "getDisplayValue : ' " + returnValue + " '";
  $c.frame.printExampleLog($p, strLog, txa_log_1, false);
  console.log(strLog);
};

/**
 * displayFormat = "yyyy-MM-dd"에서 
 * 버튼 [format 없이 값 반환 받기] 클릭 시 호출
 */
scwin.btn_ex3_onclick = function (e) {
  //format 없이 값을 넘기는 경우
  var returnValue = ica_exam_1.getValue();

  // 로그 출력
  let strLog = "getValue : ' " + returnValue + " '";
  $c.frame.printExampleLog($p, strLog, txa_log_1, false);
  console.log(strLog);
};

/**
