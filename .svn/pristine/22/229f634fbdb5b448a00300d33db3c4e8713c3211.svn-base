<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare"
	xmlns:xf="http://www.w3.org/2002/xforms">
	<head meta_author="InswaveSystems" meta_type="메인" meta_screenName="[Input] 숫자형 데이터 입력 시 설정한 포맷 적용 시점 지정하기 - applyFormat 동작 비교">
		<w2:historyInfo>
			<w2:history meta_no="01" meta_desc="최초작성" meta_date="20221007" meta_user="InswaveSystems" ></w2:history>
			<w2:history meta_no="02" meta_desc="설명부 수정" meta_date="20240621" meta_user="InswaveSystems" ></w2:history>
		</w2:historyInfo>
		<w2:type>COMPONENT</w2:type>
		<w2:buildDate />
		<w2:MSA />
		<xf:model>
			<w2:dataCollection baseNode="map">
			</w2:dataCollection>
			<w2:workflowCollection />
		</xf:model>
		<w2:layoutInfo />
		<w2:publicInfo method="" />
		<script lazy="false" type="text/javascript"><![CDATA[
scwin.onpageload = function () {

};

]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:group class="sub_contents" id="" style="">
			<xf:group class="ws_example_grp_desc" id="" style="">
				<w2:textbox escape="false" id=""
					label="Input의 'applyFormat' 속성을 사용하여, 숫자형 데이터가 입력될 때, 포맷을 적용하는 시점을 설정한 예제입니다."
					style="margin-bottom: 10px;">
				</w2:textbox>
			</xf:group>
			<xf:group class="example_div_tb_style_wrap" id="">
				<xf:group class="example_div_tr_style" id="" style="">
					<w2:textbox class="example_div_th_style" escape="false" id="" label="기본 설정 - applyFormat : display" style=""></w2:textbox>

					<xf:group class="example_div_td_style" id="" style="">
						<w2:textbox class="wre_txt_normal" escape="false" id="" label="Input에서 입력 커서가 벗어나면 포맷이 적용됩니다." style="">
						</w2:textbox>
						<xf:input class="" id="" placeholder="숫자만 입력하세요" style="min-width:120px;" dataType="number" displayFormat="#,###"></xf:input>
					</xf:group>
				</xf:group>
				<xf:group class="example_div_tr_style" id="" style="">
					<w2:textbox class="example_div_th_style" escape="false" id="" label='applyFormat : all' style=""></w2:textbox>
					<xf:group class="example_div_td_style" id="" style="">
						<w2:textbox class="wre_txt_normal" escape="false" id="" label="Input에 입력 즉시 포맷이 적용됩니다." style="">
						</w2:textbox>
						<xf:input class="" dataType="number" displayFormat="#,###" id="" placeholder="숫자만 입력하세요" style="min-width:120px;"
							applyFormat="all">
						</xf:input>
					</xf:group>
				</xf:group>

			</xf:group>
		</xf:group>
	</body>
</html>