<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet href="/2019-09/Components/WebSquare.css" type="text/css"?>
<?xml-stylesheet href="/2019-09/Components/gridview.css" type="text/css"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head meta_screenName="guide_sample">
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
        	<xf:instance>
        		<data xmlns="" />
        	</xf:instance>
        	<w2:dataCollection baseNode="map">
        		<w2:dataList baseNode="list" id="dataList1" repeatNode="map" saveRemovedData="true" style="">
        			<w2:columnInfo>
        				<w2:column id="chk" name="name6" dataType="text" ignoreStatus="true"></w2:column><w2:column id="City" name="City" dataType="text"></w2:column>
        				<w2:column id="Airport" name="Airport" dataType="text"></w2:column>
        				<w2:column id="Country" name="Country" dataType="text"></w2:column>
        				<w2:column id="C_Code" name="C_Code" dataType="text"></w2:column>
        				<w2:column id="A_Code" name="A_Code" dataType="text"></w2:column>
        				
        			</w2:columnInfo>
        		</w2:dataList>
        	</w2:dataCollection>
        	<w2:workflowCollection></w2:workflowCollection>
        	<xf:submission id="submission1" ref="" target="data:json,dataList1" action="citycode.json" method="post"
        		mediatype="application/json" encoding="UTF-8" instance="" replace="" errorHandler="" customHandler="" mode="asynchronous"
        		processMsg="" ev:submit="" ev:submitdone="" ev:submiterror="" abortTrigger="">
        	</xf:submission>
        </xf:model>
        <script type="text/javascript" lazy="false"><![CDATA[

scwin.onpageload = function () {
    $p.executeSubmission("submission1");
};

scwin.onpageunload = function () {

};



scwin.trigger1_onclick = function (e) {
    var data = [{
        "C_Code": "MAB",
        "Airport": "Maraba",
        "Country": "Brazil",
        "City": "Maraba",
        "A_Code": "MAB"
    },
    {
        "C_Code": "JJU",
        "Airport": "Jeju",
        "Country": "Korea",
        "City": "Jeju",
        "A_Code": "CJU"
    }]

    dataList1.setJSON(data, true);
};


scwin.trigger2_onclick = function (e) {
    var data = [{
        "C_Code": "PER",
        "Airport": "PERTH",
        "Country": "AUSTRALIA",
        "City": "PERTH",
        "A_Code": "PER"
    },
    {
        "C_Code": "PHX",
        "Airport": "SKY HARBOR ",
        "Country": "U.S.A.",
        "City": "PHOENIX",
        "A_Code": "PHX"
    }]

    dataList1.setJSON(data, false);

};
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload" ev:onpageunload="scwin.onpageunload">
    <xf:group id="" style="margin: 10px;"><w2:textbox tagname="h1" style="color: blue;margin-bottom: 10px;" tabIndex="h1" id="textbox3" label="DataList에 JSON 데이터 설정" escape="false"></w2:textbox><w2:textbox tagname="h2" style="height: 23px;margin-bottom: 10px;color: blue;" id="textbox4" label="샘플 사용 방법"></w2:textbox><w2:textbox style="color: blue;margin-bottom: 30px;" id="textbox5" label="1. 첫 번째 setJSON() 버튼을 클릭하면 데이터가 추가되는 것을 확인. &lt;br/&gt;2. 두 번째 setJSON() 버튼을 클릭하면 데이터가 새로 설정되는 것을 확인.&lt;br/&gt;(자세한 스크립트는 Script 탭에서 확인.)" escape="false">
    	</w2:textbox><xf:trigger ev:onclick="scwin.trigger1_onclick" style="height:42px;line-height:32px;padding:5px;background-color:coral;font-size:15px;weight: bolder;font-weight:bolder;text-align: left;display: block;margin-bottom: 10px;" id="trigger1" type="button">
    		<xf:label><![CDATA[dataList1.setJSON(data, true);]]></xf:label>
    	</xf:trigger><xf:trigger ev:onclick="scwin.trigger2_onclick" style="height:42px;line-height:32px;padding:5px;background-color:coral;font-size:15px;weight: bolder;font-weight:bolder;text-align: left;display: block;margin-bottom: 10px;" id="trigger2" type="button">
    		<xf:label><![CDATA[dataList1.setJSON(data, false);]]></xf:label>
    	</xf:trigger><w2:gridView scrollByColumnAdaptive="false" rowNumVisible="true" visibleRowNumFix="true" dataList="data:dataList1" style="border: 1px gray solid" scrollByColumn="false" id="gridview1" autoFit="allColumn" visibleRowNum="15" defaultCellHeight="20">
    		<w2:caption style="" id="caption1" value="this is a grid caption."></w2:caption>
    		<w2:header style="" id="header1">
    			<w2:row style="" id="row1">
    				<w2:column removeBorderStyle="false" width="70" inputType="checkbox" style="height:20px" id="chk1" value="" blockSelect="false" displayMode="label">
    				</w2:column>
    				<w2:column removeBorderStyle="false" width="70" inputType="text" style="height:20px" id="column9" value="City" blockSelect="false" displayMode="label">
    				</w2:column>
    				<w2:column removeBorderStyle="false" width="70" inputType="text" style="height:20px" id="column7" value="Airport" blockSelect="false" displayMode="label">
    				</w2:column>
    				<w2:column removeBorderStyle="false" width="70" inputType="text" style="height:20px" id="column5" value="Country" blockSelect="false" displayMode="label">
    				</w2:column>
    				<w2:column removeBorderStyle="false" width="70" inputType="text" style="height:20px" id="column3" value="C_Code" blockSelect="false" displayMode="label">
    				</w2:column>
    				<w2:column removeBorderStyle="false" width="70" inputType="text" style="height:20px" id="column1" value="A_Code" blockSelect="false" displayMode="label">
    				</w2:column>
    			</w2:row>
    		</w2:header>
    		<w2:gBody style="" id="gBody1">
    			<w2:row style="" id="row2">
    				<w2:column removeBorderStyle="false" width="70" inputType="checkbox" style="height:20px" id="chk" value="" blockSelect="false" displayMode="label">
    				</w2:column>
    				<w2:column removeBorderStyle="false" width="70" inputType="text" style="height:20px" id="City" value="" blockSelect="false" displayMode="label">
    				</w2:column>
    				<w2:column removeBorderStyle="false" width="70" inputType="text" style="height:20px" id="Airport" value="" blockSelect="false" displayMode="label">
    				</w2:column>
    				<w2:column removeBorderStyle="false" width="70" inputType="text" style="height:20px" id="Country" value="" blockSelect="false" displayMode="label">
    				</w2:column>
    				<w2:column removeBorderStyle="false" width="70" inputType="text" style="height:20px" id="C_Code" value="" blockSelect="false" displayMode="label">
    				</w2:column>
    				<w2:column removeBorderStyle="false" width="70" inputType="text" style="height:20px" id="A_Code" value="" blockSelect="false" displayMode="label">
    				</w2:column>
    			</w2:row>
    		</w2:gBody>
    	</w2:gridView></xf:group></body>
</html>
