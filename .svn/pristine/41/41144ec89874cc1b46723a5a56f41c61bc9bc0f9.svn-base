define({declaration:{A:{version:'1.0',encoding:'UTF-8'}},E:[{T:1,N:'html',A:{xmlns:'http://www.w3.org/1999/xhtml','xmlns:ev':'http://www.w3.org/2001/xml-events','xmlns:w2':'http://www.inswave.com/websquare','xmlns:xf':'http://www.w3.org/2002/xforms'},E:[{T:1,N:'head',E:[{T:1,N:'w2:type',E:[{T:3,text:'DEFAULT'}]},{T:1,N:'w2:buildDate'},{T:1,N:'xf:model',E:[{T:1,N:'w2:dataCollection',A:{baseNode:'map'}},{T:1,N:'w2:workflowCollection'}]},{T:1,N:'script',A:{type:'text/javascript',lazy:'false'},E:[{T:4,cdata:function(scopeObj){with(scopeObj){scwin.onpageload = function () {
  const tmpSrc = scwin.getfolderPath() + "/source.xml";
  windowContainer1.createWindow({
    "title": "Source",
    "src": tmpSrc,
    "windowId": "window1",
    "frameMode": "wframe"
  });
  windowContainer2.createWindow({
    "title": "Source",
    "src": tmpSrc,
    "windowId": "window1",
    "frameMode": "wframe"
  });
  const tmpSrc2 = scwin.getfolderPath() + "/processMsg_new.xml";
  pageFrame1.setSrc(tmpSrc2);
};
scwin.onpageunload = function () {};
scwin.getfolderPath = function () {
  var currentPath = window.location.href;
  var folderPath;
  if (currentPath.includes("mainContainer")) {
    console.log("true  ===> " + $p.getFrameId());
    const cmtFrame = $p.getComponentById($p.getFrameId());
    currentPath = cmtFrame.getSrc();
    folderPath = currentPath.substring(0, currentPath.lastIndexOf('/'));
  } else {
    console.log("false  ===> ");
    folderPath = currentPath.split('w2xPath=')[1].substring(0, currentPath.split('w2xPath=')[1].lastIndexOf('/'));
  }
  return folderPath;
};
}}}]}]},{T:1,N:'body',A:{'ev:onpageload':'scwin.onpageload','ev:onpageunload':'scwin.onpageunload'},E:[{T:1,N:'xf:group',A:{id:'',style:'margin: 10px;'},E:[{T:1,N:'w2:textbox',A:{tagname:'h1',style:'color: blue;margin-bottom: 10px;',tabIndex:'h1',id:'textbox1',label:'サブミッションステータスウィンドウをウィンドウ内部のみ表示（カスタムステータスウィンドウ）',escape:'false'}},{T:1,N:'w2:textbox',A:{tagname:'h2',style:'height: 23px;margin-bottom: 10px;color: blue;',id:'textbox2',label:'サンプルの使い方'}},{T:1,N:'w2:textbox',A:{style:'color: blue;margin-bottom: 30px;',id:'textbox3',label:'（最初の WindowContainer） <br/>1-1.内部の Submit ボタンをクリックします。 <br/>1-2. client.config.xml 設定ファイルで processMsgFrameURL 項目で指定したファイルが WFrame 内にのみ表示されることを確認します。 (processMsgFrame="true")<br/><br/>（2 番目の WindowContainer） <br/>2-1.内部の Submit ボタンをクリックします。 <br/>2-2. client.config.xml 設定ファイルで processMsgFrameURL 項目で指定したファイルが全画面に表示されることを確認します。 (processMsgFrame="false")',escape:'false'}},{T:1,N:'w2:textbox',A:{style:'padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightpink;border:none;margin-bottom: 10px;',id:'textbox4',label:'クライアント設定 (client.config.xml)<br/>processMsgFrameURL value="processMsg_new.xml"',escape:'false'}},{T:1,N:'w2:textbox',A:{style:'padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightblue;border:none;margin-bottom: 10px;',id:'textbox5',label:'プロパティの設定<br/>processMsgFrame="true"',escape:'false'}},{T:1,N:'w2:windowContainer',A:{style:'position: relative;height: 300px;border: gray solid 1px;margin-bottom: 10px;',id:'windowContainer1',processMsgFrame:'true'},E:[{T:1,N:'w2:windowToolbar',E:[{T:1,N:'w2:controlIconLayer',E:[{T:1,N:'w2:controlIcon'},{T:1,N:'w2:controlIcon'},{T:1,N:'w2:controlIcon'},{T:1,N:'w2:controlIcon'},{T:1,N:'w2:controlIcon'}]},{T:1,N:'w2:nameLayer'},{T:1,N:'w2:selectedNameLayer'}]}]},{T:1,N:'w2:textbox',A:{escape:'false',id:'textbox7',label:'プロパティの設定<br/>processMsgFrame="false"',style:'padding:5px;text-align:left;font-size: 15px;font-weight:bolder;backgroun