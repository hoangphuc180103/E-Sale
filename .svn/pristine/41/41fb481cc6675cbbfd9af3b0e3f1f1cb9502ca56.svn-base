};
scwin.trigger2_onclick = function (e) {
  scwin.count++;
  var options = {
    id: scwin.count,
    type: "pageFramePopup",
    height: "300px",
    width: "400px",
    popupName: "fixPosition: false",
    fixPosition: false
  };
  $p.openPopup("", options);
};
