<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare"
	xmlns:xf="http://www.w3.org/2002/xforms">
	<head meta_author="InswaveSystems" meta_type="메인" meta_screenName="[GridView] 엑셀 다운로드 시 다운로드할 데이터 출처 설정하기">
		<w2:historyInfo>
			<w2:history meta_no="01" meta_desc="최초작성" meta_date="20220916" meta_user="InswaveSystems"></w2:history>
			<w2:history meta_no="02" meta_desc="설명부 수정" meta_date="20240621" meta_user="InswaveSystems"></w2:history>
			<w2:history meta_no="03" meta_desc="예제에서 사용하는 DataList가 변경되고, 이에 따른 GridVeiw의 설정이 수정되었습니다." meta_date="20240705"
				meta_user="InswaveSystems"></w2:history>
		</w2:historyInfo>
		<w2:type>COMPONENT</w2:type>
		<w2:buildDate />
		<w2:MSA />
		<xf:model>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" id="dlt_exam" repeatNode="map" style="" valueAttribute="">
					<w2:columnInfo>
						<w2:column dataType="text" id="product" name="Product"></w2:column>
						<w2:column dataType="text" id="stock" name="Stock"></w2:column>
						<w2:column id="category_code" name="Category" dataType="text"></w2:column>
					</w2:columnInfo>
					<w2:data use="true">
						<w2:row>
							<product><![CDATA[SecureGate]]></product>
							<stock><![CDATA[98291]]></stock>
							<category_code><![CDATA[0001]]></category_code>
						</w2:row>
						<w2:row>
							<product><![CDATA[FastServe]]></product>
							<stock><![CDATA[528]]></stock>
							<category_code><![CDATA[0002]]></category_code>
						</w2:row>
						<w2:row>
							<product><![CDATA[CloudFlex]]></product>
							<stock><![CDATA[73928]]></stock>
							<category_code><![CDATA[0003]]></category_code>
						</w2:row>
						<w2:row>
							<product><![CDATA[CodeStream]]></product>
							<stock><![CDATA[6894]]></stock>
							<category_code><![CDATA[0001]]></category_code>
						</w2:row>
					</w2:data>
				</w2:dataList>
				<w2:dataList id="dlt_code" baseNode="list" saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="label" name="화면에 출력될 값" dataType="text"></w2:column>
						<w2:column id="code" name="코드값" dataType="text"></w2:column>
					</w2:columnInfo>
					<w2:data use="true">
						<w2:row>
							<label><![CDATA[Software]]></label>
							<code><![CDATA[0001]]></code>
						</w2:row>
						<w2:row>
							<label><![CDATA[Hardware]]></label>
							<code><![CDATA[0002]]></code>
						</w2:row>
						<w2:row>
							<label><![CDATA[Services]]></label>
							<code><![CDATA[0003]]></code>
						</w2:row>
					</w2:data>
				</w2:dataList>
			</w2:dataCollection>
			<w2:workflowCollection />
		</xf:model>
		<w2:layoutInfo />
		<w2:publicInfo method="" />
		<script lazy="false" type="text/javascript"><![CDATA[
scwin.onpageload = function () {

};

/**
 * 버튼 [엑셀 다운로드 - 기본] 클릭 시
 */
scwin.btn_ex1_onclick = function (e) {
    var jsnOptions;

    jsnOptions = {
        fileName: "EXAMPLE_P00106_TYPE1.xlsx",
        type: 1
    };

    grd_exam1.advancedExcelDownload(jsnOptions);
};

/**
 * 버튼 [엑셀 다운로드 - DataList의 값을 다운로드] 클릭 시
 */
scwin.btn_ex2_onclick = function (e) {
    var jsnOptions;

    jsnOptions = {
        fileName: "EXAMPLE_P00106_TYPE2.xlsx", //엑셀의 파일명
        type: 0    //[default:1, 0] 사용할 데이터 출처. 0: DataList의 데이터 사용. 1: GridView에 출력된 데이터 사용
    };

    //GridView "grd_exam1"의 엑셀 다운로드 실행
    grd_exam1.advancedExcelDownload(jsnOptions);
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:group class="sub_contents" id="" style="">
			<xf:group class="ws_example_grp_desc" id="" style="">
				<w2:textbox escape="false" id=""
					label="GridView의 'advancedExcelDownload' 메소드의 첫 번째 인자인 JSON 객체의 'type'을 사용하여, GridView와 연결된 DataList를 엑셀로 다운로드하는 예제입니다." style="">
				</w2:textbox>
			</xf:group>
			<xf:group id="" style="" class="example_div_tb_style_wrap">
				<xf:group class="mb_def_box nobottom" id="" style="">
					<xf:trigger class="btn_exam_exec btn_txt_of" ev:onclick="scwin.btn_ex1_onclick" id="btn_ex1" localeRef=""
						style="min-width: 30px; height: 26px;" type="" useDefaultLabel="true">
						<xf:label><![CDATA[엑셀 다운로드 - 기본]]></xf:label>
					</xf:trigger>
					<xf:trigger class="btn_exam_exec btn_txt_of" ev:onclick="scwin.btn_ex2_onclick" id="btn_ex2" localeRef=""
						style="min-width: 30px; height: 26px;" type="" useDefaultLabel="true">
						<xf:label><![CDATA[엑셀 다운로드 - DataList의 값을 다운로드]]></xf:label>
					</xf:trigger>
				</xf:group>
				<xf:group id="" class="gvwbox">
					<w2:gridView rowNumWidth="34" rowNumVisible="true" visibleRowNumFix="true" dataList="data:dlt_exam" style="height:100px;"
						autoFit="allColumn" id="grd_exam1" visibleRowNum="4" class="gvw" defaultCellHeight="37" autoFitMinWidth="365">
						<w2:caption style="" id="caption1" value="this is a grid caption."></w2:caption>
						<w2:header style="" id="header1">
							<w2:row style="" id="row1">
								<w2:column width="90" inputType="text" id="column4" value="Category" displayMode="label"></w2:column>
								<w2:column width="140" inputType="text" id="column3" value="Product" displayMode="label"></w2:column>
								<w2:column width="70" inputType="text" id="column2" value="Stock" displayMode="label"></w2:column>
							</w2:row>
						</w2:header>
						<w2:gBody style="" id="gBody1">
							<w2:row style="" id="row2">
								<w2:column viewType="icon" width="90" inputType="select" id="category_code" displayMode="label">
									<w2:choices>
										<w2:itemset nodeset="data:dlt_code">
											<w2:label ref="label"></w2:label>
											<w2:value ref="code"></w2:value>
										</w2:itemset>
									</w2:choices>
								</w2:column>
								<w2:column textAlign="left" width="140" inputType="text" id="product" displayMode="label"></w2:column>
								<w2:column textAlign="right" dataType="number" width="70" displayFormat="#,###" inputType="text" id="stock"
									displayMode="label">
								</w2:column>
							</w2:row>
						</w2:gBody>
					</w2:gridView>
				</xf:group>
			</xf:group>
		</xf:group>
	</body>
</html>