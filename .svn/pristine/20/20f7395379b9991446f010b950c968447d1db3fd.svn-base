define({declaration:{A:{version:'1.0',encoding:'UTF-8'}},E:[{T:1,N:'html',A:{xmlns:'http://www.w3.org/1999/xhtml','xmlns:ev':'http://www.w3.org/2001/xml-events','xmlns:w2':'http://www.inswave.com/websquare','xmlns:xf':'http://www.w3.org/2002/xforms'},E:[{T:1,N:'head',A:{},E:[{T:1,N:'w2:historyInfo',E:[{T:1,N:'w2:history',A:{}},{T:1,N:'w2:history',A:{}}]},{T:1,N:'w2:type',E:[{T:3,text:'COMPONENT'}]},{T:1,N:'w2:buildDate'},{T:1,N:'w2:MSA'},{T:1,N:'xf:model',E:[{T:1,N:'w2:dataCollection',A:{baseNode:'map'}},{T:1,N:'w2:workflowCollection'}]},{T:1,N:'w2:layoutInfo'},{T:1,N:'w2:publicInfo',A:{method:''}},{T:1,N:'script',A:{lazy:'false',type:'text/javascript'},E:[{T:4,cdata:function(scopeObj){with(scopeObj){scwin.onpageload = function () {
  // 서버의 현재 날짜로 초기값 세팅하기
  var serverDate = $p.getCurrentServerDate();
  ipc_format.setValue(serverDate);
};

/**
 * 버튼 "'dd-MM yyyy' 형태로 날짜 값 반환받기"의 onclick 이벤트
 */
scwin.btn_setFormat_onclick = function (e) {
  // 반환받을 포맷 지정
  var format = "dd-MM yyyy";

  //format 파라메터를 넘기는 경우
  var returnValue = ipc_format.getFormattedValue(format);
  //return 예시 ) "12-01 2025"

  // 로그 출력
  let strLog = format + " : " + returnValue;
  $c.frame.printExampleLog($p, strLog, txa_log, false);
  console.log(strLog);
};

/**
 * textarea의 로그 삭제
 */
scwin.btn_clearLog_onclick = function (e) {
  let strTargetId = this.getUserData("userData1");
  let cmpTarget;
  if (strTargetId) {
    cmpTarget = $p.getComponentById(strTargetId) || txa_log;
  } else {
    cmpTarget = txa_log;
  }
  //textarea value를 빈문자열로 할당.
  cmpTarget.setValue("");
};
}}}]}]},{T:1,N:'body',A:{'ev:onpageload':'scwin.onpageload'},E:[{T:1,N:'xf:group',A:{class:'sub_contents',id:'',style:'',nextTabID:''},E:[{T:1,N:'xf:group',A:{class:'ws_example_grp_desc',id:'',style:''},E:[{T:1,N:'w2:textbox',A:{escape:'false',id:'',label:'InputCalendar의 \'getFormattedValue\' 메소드를 사용하여 날짜 값에 포맷을 설정하여 문자열로 반환받는 예제입니다.',style:''}}]},{T:1,N:'xf:group',A:{class:'example_div_tb_style_wrap mb_def',id:''},E:[{T:1,N:'xf:group',A:{class:'example_div_tr_style',id:'',style:''},E:[{T:1,N:'xf:group',A:{class:'example_div_td_style',id:'',style:''},E:[{T:1,N:'xf:group',A:{id:'',class:'def_box'},E:[{T:1,N:'w2:inputCalendar',A:{id:'ipc_format',style:'width: 150px;height: 23px;',calendarValueType:'yearMonthDate'}},{T:1,N:'xf:trigger',A:{class:'btn_exam_exec','ev:onclick':'scwin.btn_setFormat_onclick',id:'btn_setFormat',style:'',type:'button'},E:[{T:1,N:'xf:label',E:[{T:4,cdata:'\'dd-MM yyyy\' 형태로 날짜 값 반환받기'}]}]}]}]}]}]},{T:1,N:'xf:group',A:{class:'example_div_tb_style_wrap',id:'',style:''},E:[{T:1,N:'xf:group',A:{class:'example_div_tr_style',id:'',style:''},E:[{T:1,N:'xf:group',A:{class:'example_div_th_style',id:''},E:[{T:1,N:'w2:span',A:{class:'mr_def txt_blue',id:'',label:'로그 확인',style:''}},{T:1,N:'xf:trigger',A:{class:'wre_btn_log_clear','ev:onclick':'scwin.btn_clearLog_onclick',id:'btn_clearLog',style:'',title:'로그 삭제',type:'button'},E:[{T:1,N:'xf:label',E:[{T:4,cdata:'로그 삭제'}]}]}]},{T:1,N:'xf:group',A:{class:'example_div_td_style',id:'',style:''},E:[{T:1,N:'xf:textarea',A:{class:'wre_txa_log',id:'txa_log',spellcheck:'false',style:'width: 100%;height: 140px;'}}]}]}]}]}]}]}]})