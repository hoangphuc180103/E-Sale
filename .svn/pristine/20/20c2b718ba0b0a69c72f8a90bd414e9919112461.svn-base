<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
    	<w2:buildDate />
    	<xf:model>
    		<xf:instance>
    			<data xmlns="" />
    		</xf:instance>
    		<w2:dataCollection baseNode="map"></w2:dataCollection>
    		<w2:workflowCollection></w2:workflowCollection>
    	</xf:model>
    	<script type="text/javascript" lazy="false"><![CDATA[
        
	scwin.onpageload = function() {
		
	};
	
	scwin.onpageunload = function() {
		
	};
	
	]]></script>
    	<style type="text/css"><![CDATA[

    	 ]]></style>
    </head>
    <body ev:onpageload="scwin.onpageload" ev:onpageunload="scwin.onpageunload">
    <xf:group id="" style="margin: 10px;"><w2:textbox tagname="h1" style="margin-bottom: 10px;color: blue;" id="textbox1" label="Enter 키로 패널 열고 닫기" escape="false"></w2:textbox><w2:textbox tagname="h2" style="height: 23px;margin-bottom: 10px;color: blue;" id="textbox2" label="샘플 사용 방법"></w2:textbox><w2:textbox style="color: blue;margin-bottom: 30px;" id="textbox3" label='Enter 키를 누르면 패널이 열리고 닫히는 것을 확인. ' escape="false">
    	</w2:textbox><w2:textbox style="padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightblue;border:none;margin-bottom: 20px;" id="textbox4" label='속성 설정&lt;br/&gt;enterKeyPanelToggle="true"' escape="false">
    	</w2:textbox><w2:accordion style="border:solid 2px gray;" tabIndex="1" id="accordion1" class="" collapsible="true" unCollapseAll="true">
    		<w2:panels style="" tabIndex="2" id="panels1" class="">
    			<w2:panelTitle style="" id="panelTitle1" label="1" class=""></w2:panelTitle>
    			<w2:panelContent style="" id="panelContent1" class="">
    				<w2:textbox style="width: 150px;height: 23px;margin: 50px;background-color: lightgreen;font-size:15px;padding: 10px;font-style:normal;font-weight:bolder;" label="Panel 1" id="">
    				</w2:textbox>
    			</w2:panelContent>
    		</w2:panels>
    		<w2:panels style="" tabIndex="3" id="panels2" class="">
    			<w2:panelTitle style="" id="panelTitle2" label="2" class=""></w2:panelTitle>
    			<w2:panelContent style="" id="panelContent2" class="">
    				<w2:textbox style="width: 150px;height: 23px;margin: 50px;background-color: lightgreen;font-size:15px;padding: 10px;font-style:normal;font-weight:bolder;" label="Panel 2" id="">
    				</w2:textbox>
    			</w2:panelContent>
    		</w2:panels>
    		<w2:panels style="" tabIndex="4" id="panels3" class="">
    			<w2:panelTitle style="" id="panelTitle3" label="3"></w2:panelTitle>
    			<w2:panelContent style="" id="panelContent3">
    				<w2:textbox style="width: 150px;height: 23px;margin: 50px;background-color: lightgreen;font-size:15px;padding: 10px;font-style:normal;font-weight:bolder;" id="" label="Panel 3">
    				</w2:textbox>
    			</w2:panelContent>
    		</w2:panels>
    	</w2:accordion></xf:group></body>
</html>
