<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
         <script type="text/javascript" lazy="false"><![CDATA[scwin.count = 0;

scwin.onpageload = function () {
    scwin.count++;
    var tmpSrc1 = scwin.getfolderPath() + "/sub_red.xml";
    var tmpSrc2 = scwin.getfolderPath() + "/sub_blue.xml";
    var tmpSrc3 = scwin.getfolderPath() + "/sub_green.xml";

    windowContainer1.createWindow({ "title": "Red " + scwin.count, "src": tmpSrc1, "windowId": scwin.count, "frameMode": "wframe" });
    windowContainer1.createWindow({ "title": "Blue " + scwin.count, "src": tmpSrc2, "windowId": scwin.count + 1, "frameMode": "wframe" });
    windowContainer1.createWindow({ "title": "Green " + scwin.count, "src": tmpSrc3, "windowId": scwin.count + 2, "frameMode": "wframe" });
    windowContainer1.setArrangeWindows("vertical");


    windowContainer2.createWindow({ "title": "Red " + scwin.count, "src": tmpSrc1, "windowId": scwin.count, "frameMode": "wframe" });
    windowContainer2.createWindow({ "title": "Blue " + scwin.count, "src": tmpSrc2, "windowId": scwin.count + 1, "frameMode": "wframe" });
    windowContainer2.createWindow({ "title": "Green " + scwin.count, "src": tmpSrc3, "windowId": scwin.count + 2, "frameMode": "wframe" });
    windowContainer2.setArrangeWindows("vertical");


};

scwin.onpageunload = function () {

};

scwin.getfolderPath = function () {

    var currentPath = window.location.href;
    var folderPath;

    if (currentPath.includes("mainContainer")) {
        console.log("true  ===> " + $p.getFrameId());
        const cmtFrame = $p.getComponentById($p.getFrameId());
        currentPath = cmtFrame.getSrc();
        folderPath = currentPath.substring(0, currentPath.lastIndexOf('/'));
    } else {
        console.log("false  ===> ");
        folderPath = currentPath.split('w2xPath=')[1].substring(0, currentPath.split('w2xPath=')[1].lastIndexOf('/'));
    }
    return folderPath;
};

]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload" ev:onpageunload="scwin.onpageunload">
    <xf:group id="" style="margin: 10px;">
    	<w2:textbox tagname="h1" style="color: blue;margin-bottom: 10px;" tabIndex="h1" id="textbox1" label="Prevent Minimization through Name Layer&lt;br/&gt;"
    		escape="false">
    	</w2:textbox>
    	<w2:textbox tagname="h2" style="height: 23px;margin-bottom: 10px;color: blue;" id="textbox2" label="How to Use"></w2:textbox>
    	<w2:textbox style="color: blue;margin-bottom: 30px;" id="textbox3"
    		label='First WindowContainer (stopMinimizeOnNameLayer=“false”)&lt;br/&gt;1-1. Click each window in the name layer. &lt;br/&gt;1-2. Confirm that the clicked window minimizes and returns to its original size when clicked again.&lt;br/&gt;&lt;br/&gt;Second WindowContainer (stopMinimizeOnNameLayer=“true”)&lt;br/&gt;2-1. Click each window in the name layer.&lt;br/&gt;2-2. Confirm that the clicked window does not minimize and maintains its original size.'
    		escape="false">
    	</w2:textbox>
    	<w2:textbox
    		style="padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightblue;border:none;margin-bottom: 10px;"
    		id="textbox4" label='stopMinimizeOnNameLayer="false"' escape="false">
    	</w2:textbox>
    	<w2:windowContainer sequentialArrangeColNum="2" sequentialArrangeRowNum="2" fixArrangeFullScreen="false" useFixButton="false"
    		windowAutoResize="false" verticalArrangeNum="2" windowMaxNum="5" useCloseButton="false" controlIconPosition="left"
    		windowMaximizeAll="false" stopMinimizeOnNameLayer="false" toolbarPosition="bottom" id="windowContainer1" useStatusMsg="true"
    		hideTitleOnMaximize="false" spaInitCount="0" stopToggleOnLast="false" useNameContainer="false" horizontalArrangeNum="2"
    		useCustomMsg="false" useControlIconTitle="false" tooltipDisplay="true" tooltipGroupClass="false" windowTooltipDisplay="true"
    		style="position: relative;height: 250px;border: gray solid 1px;margin-bottom: 10px;">
    		<w2:windowToolbar>
    			<w2:controlIconLayer>
    				<w2:controlIcon></w2:controlIcon>
    				<w2:controlIcon></w2:controlIcon>
    				<w2:controlIcon></w2:controlIcon>
    				<w2:controlIcon></w2:controlIcon>
    				<w2:controlIcon></w2:controlIcon>
    			</w2:controlIconLayer>
    			<w2:nameLayer></w2:nameLayer>
    			<w2:selectedNameLayer></w2:selectedNameLayer>
    		</w2:windowToolbar>
    	</w2:windowContainer>
    	<w2:textbox escape="false" id="textbox5" label='stopMinimizeOnNameLayer="true"'
    		style="padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightblue;border:none;margin-bottom: 10px;">
    	</w2:textbox>
    	<w2:windowContainer controlIconPosition="left" fixArrangeFullScreen="false" hideTitleOnMaximize="false" horizontalArrangeNum="2"
    		id="windowContainer2" sequentialArrangeColNum="2" sequentialArrangeRowNum="2" spaInitCount="0" stopMinimizeOnNameLayer="true"
    		stopToggleOnLast="false" style="position: relative;height: 250px;border: gray solid 1px;" toolbarPosition="bottom"
    		tooltipDisplay="true" tooltipGroupClass="false" useCloseButton="false" useControlIconTitle="false" useCustomMsg="false"
    		useFixButton="false" useNameContainer="false" useStatusMsg="true" verticalArrangeNum="2" windowAutoResize="false" windowMaxNum="5"
    		windowMaximizeAll="false" windowTooltipDisplay="true">
    		<w2:windowToolbar>
    			<w2:controlIconLayer>
    				<w2:controlIcon></w2:controlIcon>
    				<w2:controlIcon></w2:controlIcon>
    				<w2:controlIcon></w2:controlIcon>
    				<w2:controlIcon></w2:controlIcon>
    				<w2:controlIcon></w2:controlIcon>
    			</w2:controlIconLayer>
    			<w2:nameLayer></w2:nameLayer>
    			<w2:selectedNameLayer></w2:selectedNameLayer>
    		</w2:windowToolbar>
    	</w2:windowContainer>
    </xf:group></body>
</html>
