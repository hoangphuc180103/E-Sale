/**
 * [String to JSON - JSON.parse] 클릭 시
 */
scwin.btn_ex1_onclick = function (e) {
  // json 문자열
  let jsonStr = '{"no":"1", "name":"WebSquare"}';

  // json 객체 생성
  let jsonObj = JSON.parse(jsonStr);

  // 로그 출력
  $c.frame.printExampleLog($p, "** scwin.btn_ex1_onclick 실행 **", txa_log, false);
  $c.frame.printExampleLog($p, "no : " + jsonObj.no, txa_log, false);
  $c.frame.printExampleLog($p, "name : " + jsonObj.name, txa_log, false);
  console.log(jsonObj);
};

/**
 * [JSON to String - JSON.stringify] 클릭 시
 */
scwin.btn_ex2_onclick = function (e) {
  // json 객체
  let jsonObj = {
    "no": "2",
    "name": "WebSquare"
  };

  // json 객체를 문자열로 반환
  let jsonStr = JSON.stringify(jsonObj);

  // 로그 출력
  $c.frame.printExampleLog($p, "** scwin.btn_ex2_onclick 실행 **", txa_log, false);
  $c.frame.printExampleLog($p, "JSON 문자열 : " + jsonStr, txa_log, false);
};

/**
 * textarea의 로그 삭제
 */
scwin.btn_clearLog_onclick = function (e) {
  txa_log.setValue("");
};
