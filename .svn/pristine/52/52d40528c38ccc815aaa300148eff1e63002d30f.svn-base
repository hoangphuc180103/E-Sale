    				<w2:column width="70" inputType="text" style="height:20px" id="column26" value="" displayMode="label"></w2:column>
    				<w2:column expression='sum("col4")' width="70" inputType="expression" style="height:20px" id="column25" value=""
    					displayMode="label">
    				</w2:column>
    			</w2:row>
    		</w2:footer>
