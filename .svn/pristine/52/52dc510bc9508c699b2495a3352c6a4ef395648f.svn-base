define({declaration:{A:{version:'1.0',encoding:'UTF-8'}},E:[{T:1,N:'html',A:{xmlns:'http://www.w3.org/1999/xhtml','xmlns:ev':'http://www.w3.org/2001/xml-events','xmlns:w2':'http://www.inswave.com/websquare','xmlns:xf':'http://www.w3.org/2002/xforms'},E:[{T:1,N:'head',E:[{T:1,N:'w2:type',E:[{T:3,text:'DEFAULT'}]},{T:1,N:'w2:buildDate'},{T:1,N:'xf:model',E:[{T:1,N:'w2:dataCollection',A:{baseNode:'map'}},{T:1,N:'w2:workflowCollection'}]},{T:1,N:'script',A:{type:'text/javascript',lazy:'false'},E:[{T:4,cdata:function(scopeObj){with(scopeObj){scwin.count = 0;
scwin.onpageload = function () {
  scwin.count++;
  var tmpSrc1 = scwin.getfolderPath() + "/sub_red.xml";
  var tmpSrc2 = scwin.getfolderPath() + "/sub_green.xml";
  var tmpSrc3 = scwin.getfolderPath() + "/sub_blue.xml";
  var tmpSrc4 = scwin.getfolderPath() + "/sub_yellow.xml";
  windowContainer1.createWindow({
    "title": "Red - " + scwin.count,
    "src": tmpSrc1,
    "windowId": "red",
    "frameMode": "wframe"
  });
  windowContainer1.createWindow({
    "title": "Green - " + scwin.count,
    "src": tmpSrc2,
    "windowId": "green",
    "frameMode": "wframe"
  });
  windowContainer1.createWindow({
    "title": "Blue - " + scwin.count,
    "src": tmpSrc3,
    "windowId": "blue",
    "frameMode": "wframe"
  });
  windowContainer1.createWindow({
    "title": "Yellow - " + scwin.count,
    "src": tmpSrc4,
    "windowId": "yellow",
    "frameMode": "wframe"
  });
  windowContainer1.setArrangeWindows("vertical");
};
scwin.onpageunload = function () {};
scwin.trigger1_onclick = function (e) {
  windowContainer1.setArrangeWindows("vertical", ["red", "yellow", "green"]);
};
scwin.trigger2_onclick = function (e) {
  windowContainer1.setArrangeWindows("horizontal", ["blue", "red", "green"]);
};
scwin.trigger3_onclick = function (e) {
  windowContainer1.setArrangeWindows("cascade", ["red", "blue", "green"]);
};
scwin.trigger4_onclick = function (e) {
  windowContainer1.setArrangeWindows("sequential", ["blue", "green", "red"]);
};
scwin.getfolderPath = function () {
  var currentPath = window.location.href;
  var folderPath;
  if (currentPath.includes("mainContainer")) {
    console.log("true  ===> " + $p.getFrameId());
    const cmtFrame = $p.getComponentById($p.getFrameId());
    currentPath = cmtFrame.getSrc();
    folderPath = currentPath.substring(0, currentPath.lastIndexOf('/'));
  } else {
    console.log("false  ===> ");
    folderPath = currentPath.split('w2xPath=')[1].substring(0, currentPath.split('w2xPath=')[1].lastIndexOf('/'));
  }
  return folderPath;
};
}}}]}]},{T:1,N:'body',A:{'ev:onpageload':'scwin.onpageload','ev:onpageunload':'scwin.onpageunload'},E:[{T:1,N:'xf:group',A:{id:'',style:'margin: 10px;'},E:[{T:1,N:'w2:textbox',A:{tagname:'h1',style:'color: blue;margin-bottom: 10px;',tabIndex:'h1',id:'textbox1',label:'윈도우 표시 및 배열 순서 설정',escape:'false'}},{T:1,N:'w2:textbox',A:{tagname:'h2',style:'height: 23px;margin-bottom: 10px;color: blue;',id:'textbox2',label:'샘플 사용 방법'}},{T:1,N:'w2:textbox',A:{style:'color: blue;margin-bottom: 30px;',id:'textbox3',label:'1. 하단의 각 버튼을 클릭. <br/>2. 옵션 설정에 따라 윈도우가 표시되고 배열되는 것을 확인.',escape:'false'}},{T:1,N:'xf:trigger',A:{'ev:onclick':'scwin.trigger1_onclick',style:'height:42px;line-height:32px;padding:5px;background-color:coral;font-size:15px;weight: bolder;font-weight:bolder;text-align: left;margin-bottom: 10px;display: block',id:'trigger1',type:'button'},E:[{T:1,N:'xf:label',E:[{T:4,cdata:'windowContainer1.setArrangeWindows("vertical", ["red", "yellow", "green"]);'}]}]},{T:1,N:'xf:trigger',A:{'ev:onclick':'scwin.trigger2_onclick',style:'height:42px;line-height:32px;padding:5px;background-color:coral;font-size:15px;weight: bolder;font-weight:bolder;text-align: left;margin-bottom: 10px;display: block;',id:'trigger2',type:'button'},E:[{T:1,N:'xf:label',E:[{T:4,cdata:'windowContainer1.setArrangeWindows("horizontal", ["blue", "red", "green"]);'}]}]},{T:1,N:'xf:trigger',A:{'ev:onclick':'scwin.trigger3_onclick',style:'height:42px;line-height:32px;padding:5px;background-color:coral;font-size:15px;weight: bolder;font-weight:bolder;text-align: left;margin-bottom: 10px;display: block;',id:'trigger3',type:'button'},E:[{T:1,N:'xf:label',E:[{T:4,cdata:'windowContainer1.setArrangeWindows("cascade", ["red", "blue", "green"];'}]}]},{T:1,N:'xf:trigger',A:{'ev:onclick':'scwin.trigger4_onclick',style:'height:42px;line-height:32px;padding:5px;background-color:coral;font-size:15px;weight: bolder;font-weight:bolder;text-align: left;margin-bottom: 10px;display: block;',id:'trigger4',type:'button'},E:[{T:1,N:'xf:label',E:[{T:4,cdata:'windowContainer1.setArrangeWindows("sequential", ["blue", "green", "red"]);'}]}]},{T:1,N:'w2:windowContainer',A:{sequentialArrangeColNum:'2',sequentialArrangeRowNum:'2',fixArrangeFullScreen:'false',useFixButton:'false',windowAutoResize:'false',verticalArrangeNum:'2',windowMaxNum:'5',useCloseButton:'false',controlIconPosition:'left',windowMaximizeAll:'false',stopMinimizeOnNameLayer:'true',toolbarPosition:'bottom',id:'windowContainer1',useStatusMsg:'true',hideTitleOnMaximize:'false',spaInitCount:'0',stopToggleOnLast:'false',useNameContainer:'false',horizontalArrangeNum:'2',useCustomMsg:'false',useControlIconTitle:'false',tooltipDisplay:'true',tooltipGroupClass:'false',windowTooltipDisplay:'true',style:'position: relative;height: 400px;border: gray solid 1px;'},E:[{T:1,N:'w2:windowToolbar',E:[{T:1,N:'w2:controlIconLayer',E:[{T:1,N:'w2:controlIcon'},{T:1,N:'w2:controlIcon'},{T:1,N:'w2:controlIcon'},{T:1,N:'w2:controlIcon'},{T:1,N:'w2:controlIcon'}]},{T:1,N:'w2:nameLayer'},{T:1,N:'w2:selectedNameLayer'}]}]}]}]}]}]})