scwin.pivot1_grandTotalValsNameFormatter = function (colId) {
  if (colId === "col1") {
    return "Year_Field_Totall";
  } else if (colId === "City_Field_Total") {
    return "col1";
  } else if (colId === "col3") {
    return "Continent_Field_Total";
  } else if (colId === "col4") {
    return "Expense_Field_Total";
