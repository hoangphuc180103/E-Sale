<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare"
	xmlns:xf="http://www.w3.org/2002/xforms">
	<head meta_author="InswaveSystems" meta_type="메인" meta_screenName="[GridView] 선택된 cell 또는 row의 배경색 지정하기">
		<w2:historyInfo>
			<w2:history meta_no="01" meta_desc="최초작성" meta_date="20221230" meta_user="InswaveSystems"></w2:history>
			<w2:history meta_no="02" meta_desc="설명부 수정" meta_date="20240621" meta_user="InswaveSystems"></w2:history>
			<w2:history meta_no="03" meta_desc="예제에서 사용하는 DataList가 변경되고, 이에 따른 GridVeiw의 설정이 수정되었습니다." meta_date="20240705" meta_user="InswaveSystems"></w2:history>
		</w2:historyInfo>
		<w2:type>COMPONENT</w2:type>
		<w2:buildDate />
		<w2:MSA />
		<xf:model>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" repeatNode="map" id="dlt_exam" saveRemovedData="true">
					<w2:columnInfo>
						<w2:column dataType="text" name="A" id="col_a"></w2:column>
						<w2:column dataType="text" name="B" id="col_b"></w2:column>
						<w2:column dataType="text" name="C" id="col_c"></w2:column>
					</w2:columnInfo>
					<w2:data use="true">
						<w2:row>
							<col_a><![CDATA[A1]]></col_a>
							<col_b><![CDATA[B1]]></col_b>
							<col_c><![CDATA[C1]]></col_c>
						</w2:row>
						<w2:row>
							<col_a><![CDATA[A2]]></col_a>
							<col_b><![CDATA[B2]]></col_b>
							<col_c><![CDATA[C2]]></col_c>
						</w2:row>
						<w2:row>
							<col_a><![CDATA[A3]]></col_a>
							<col_b><![CDATA[B3]]></col_b>
							<col_c><![CDATA[C3]]></col_c>
						</w2:row>
					</w2:data>
				</w2:dataList>
				<w2:dataList baseNode="list" id="dlt_books" repeatNode="map" style="" valueAttribute="">
					<w2:columnInfo>
						<w2:column dataType="text" id="book_name" name="도서명"></w2:column>
						<w2:column dataType="text" id="price" name="정가"></w2:column>
						<w2:column id="published_date" name="출간일" dataType="text"></w2:column>
					</w2:columnInfo>
					<w2:data use="true">
						<w2:row>
							<book_name><![CDATA[사람일까 상황일까]]></book_name>
							<price><![CDATA[28000]]></price>
							<published_date><![CDATA[20190826]]></published_date>
						</w2:row>
						<w2:row>
							<book_name><![CDATA[내가 틀릴 수도 있습니다]]></book_name>
							<price><![CDATA[16000]]></price>
							<published_date><![CDATA[20220418]]></published_date>
						</w2:row>
						<w2:row>
							<book_name><![CDATA[공정하다는 착각]]></book_name>
							<price><![CDATA[18000]]></price>
							<published_date><![CDATA[20201201]]></published_date>
						</w2:row>
					</w2:data>
				</w2:dataList>
			</w2:dataCollection>
			<w2:workflowCollection />
		</xf:model>
		<w2:layoutInfo />
		<w2:publicInfo method="" />
		<script lazy="false" type="text/javascript"><![CDATA[
scwin.onpageload = function () {

};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:group class="sub_contents" id="" style="">
			<xf:group class="ws_example_grp_desc" id="" style="">
				<w2:textbox escape="false" id="" label="GridView의 선택된 셀과 행의 배경색을 설정한 예제입니다. GridView의 'focusMode' 속성의 설정에 따라 동작을 비교할 수 있습니다."
					style="">
				</w2:textbox>
			</xf:group>
			<xf:group class="example_div_tb_style_wrap" id="">
				<xf:group class="example_div_tr_style" id="" style="">
					<w2:textbox class="example_div_th_style" escape="false" id="" label="(기본설정) focusMode : cell" style=""></w2:textbox>
					<xf:group class="example_div_td_style" id="" style="">
						<w2:textbox class="wre_txt_normal" escape="false" id="" label="셀 선택 시 포커스(선택) 범위가 셀(Cell) 단위입니다." style="">
						</w2:textbox>
						<xf:group id="" class="gvwbox">
							<w2:gridView rowNumVisible="true" selectedRowColor="yellow" defaultCellHeight="37" selectedCellOverColor="green"
								selectedRowOverColor="skyblue" selectedCellColor="chocolate" focusMode="cell" rowNumWidth="34" visibleRowNumFix="true"
								dataList="data:dlt_exam" style="height:100px;" autoFit="allColumn" id="grd_exam1" visibleRowNum="3" class="gvw"
								autoFitMinWidth="240">
								<w2:caption style="" id="caption1" value="this is a grid caption."></w2:caption>
								<w2:header id="header1">
									<w2:row id="row1">
										<w2:column width="70" inputType="text" id="column1" value="A" displayMode="label"></w2:column>
										<w2:column width="70" inputType="text" id="column2" value="B" displayMode="label"></w2:column>
										<w2:column width="70" inputType="text" id="column3" value="C" displayMode="label"></w2:column>
									</w2:row>
								</w2:header>
								<w2:gBody id="gBody1">
									<w2:row id="row2">
										<w2:column width="70" inputType="text" id="col_a" displayMode="label"></w2:column>
										<w2:column width="70" inputType="text" id="col_b" displayMode="label"></w2:column>
										<w2:column width="70" inputType="text" id="col_c" displayMode="label"></w2:column>
									</w2:row>
								</w2:gBody>
							</w2:gridView>
						</xf:group>
					</xf:group>
				</xf:group>
				<xf:group class="example_div_tr_style" id="" style="">
					<w2:textbox class="example_div_th_style" escape="false" id="" label="focusMode : row" style=""></w2:textbox>
					<xf:group class="example_div_td_style" id="" style="">
						<w2:textbox class="wre_txt_normal" escape="false" id="" label="셀 선택 시 포커스(선택) 범위가 행(Row) 단위입니다." style=""></w2:textbox>
						<xf:group id="" class="gvwbox">
							<w2:gridView rowNumVisible="true" selectedRowColor="yellow" defaultCellHeight="37" selectedCellOverColor="green"
								selectedRowOverColor="skyblue" focusMode="row" selectedCellColor="chocolate" rowNumWidth="34" visibleRowNumFix="true"
								dataList="data:dlt_exam" style="height:100px;" autoFit="allColumn" id="grd_exam2" visibleRowNum="3" class="gvw"
								autoFitMinWidth="240">
								<w2:caption style="" id="caption1" value="this is a grid caption."></w2:caption>
								<w2:header id="header1">
									<w2:row id="row1">
										<w2:column width="70" inputType="text" id="column1" value="A" displayMode="label"></w2:column>
										<w2:column width="70" inputType="text" id="column2" value="B" displayMode="label"></w2:column>
										<w2:column width="70" inputType="text" id="column3" value="C" displayMode="label"></w2:column>
									</w2:row>
								</w2:header>
								<w2:gBody id="gBody1">
									<w2:row id="row2">
										<w2:column width="70" inputType="text" id="col_a" displayMode="label"></w2:column>
										<w2:column width="70" inputType="text" id="col_b" displayMode="label"></w2:column>
										<w2:column width="70" inputType="text" id="col_c" displayMode="label"></w2:column>
									</w2:row>
								</w2:gBody>
							</w2:gridView>
						</xf:group>
					</xf:group>
				</xf:group>
				<xf:group class="example_div_tr_style" id="" style="">
					<w2:textbox class="example_div_th_style" escape="false" id="" label="focusMode : both" style=""></w2:textbox>
					<xf:group class="example_div_td_style" id="" style="">
						<w2:textbox class="wre_txt_normal" escape="false" id="" label="셀 선택 시 포커스(선택) 범위가 셀(Cell)+행(Row) 단위입니다." style="">
						</w2:textbox>
						<xf:group id="" class="gvwbox">
							<w2:gridView rowNumVisible="true" selectedRowColor="yellow" defaultCellHeight="37" selectedCellOverColor="green"
								selectedRowOverColor="skyblue" focusMode="both" selectedCellColor="chocolate" rowNumWidth="34" visibleRowNumFix="true"
								dataList="data:dlt_exam" style="height:100px;" autoFit="allColumn" id="grd_exam3" visibleRowNum="3" class="gvw"
								autoFitMinWidth="240">
								<w2:caption style="" id="caption1" value="this is a grid caption."></w2:caption>
								<w2:header id="header1">
									<w2:row id="row1">
										<w2:column width="70" inputType="text" id="column1" value="A" displayMode="label"></w2:column>
										<w2:column width="70" inputType="text" id="column2" value="B" displayMode="label"></w2:column>
										<w2:column width="70" inputType="text" id="column3" value="C" displayMode="label"></w2:column>
									</w2:row>
								</w2:header>
								<w2:gBody id="gBody1">
									<w2:row id="row2">
										<w2:column width="70" inputType="text" id="col_a" displayMode="label"></w2:column>
										<w2:column width="70" inputType="text" id="col_b" displayMode="label"></w2:column>
										<w2:column width="70" inputType="text" id="col_c" displayMode="label"></w2:column>
									</w2:row>
								</w2:gBody>
							</w2:gridView>
						</xf:group>
					</xf:group>
				</xf:group>
				<xf:group class="example_div_tr_style" id="" style="">
					<w2:textbox class="example_div_th_style" escape="false" id="" label="focusMode : none" style=""></w2:textbox>
					<xf:group class="example_div_td_style" id="" style="">
						<w2:textbox class="wre_txt_normal" escape="false" id="" label="셀 선택 시 포커스(선택)가 되지 않습니다." style=""></w2:textbox>
						<xf:group id="" class="gvwbox">
							<w2:gridView rowNumVisible="true" selectedRowColor="yellow" defaultCellHeight="37" selectedCellOverColor="green"
								selectedRowOverColor="skyblue" focusMode="none" selectedCellColor="chocolate" rowNumWidth="34" visibleRowNumFix="true"
								dataList="data:dlt_exam" style="height:100px;" autoFit="allColumn" id="grd_exam4" visibleRowNum="3" class="gvw"
								autoFitMinWidth="240">
								<w2:caption style="" id="caption1" value="this is a grid caption."></w2:caption>
								<w2:header id="header1">
									<w2:row id="row1">
										<w2:column width="70" inputType="text" id="column1" value="A" displayMode="label"></w2:column>
										<w2:column width="70" inputType="text" id="column2" value="B" displayMode="label"></w2:column>
										<w2:column width="70" inputType="text" id="column3" value="C" displayMode="label"></w2:column>
									</w2:row>
								</w2:header>
								<w2:gBody id="gBody1">
									<w2:row id="row2">
										<w2:column width="70" inputType="text" id="col_a" displayMode="label"></w2:column>
										<w2:column width="70" inputType="text" id="col_b" displayMode="label"></w2:column>
										<w2:column width="70" inputType="text" id="col_c" displayMode="label"></w2:column>
									</w2:row>
								</w2:gBody>
							</w2:gridView>
						</xf:group>
					</xf:group>
				</xf:group>
			</xf:group>
		</xf:group>
	</body>
</html>