/*amd /guide/TabControl/keepDisabledTab_TabControl/keepDisabledTab_TabControl.xml 4616 6a4c08986a9bfc39deda8673379446a1544d6ed0398b621849a02ffbbc4700c4 */
define({declaration:{A:{version:'1.0',encoding:'UTF-8'}},E:[{T:1,N:'html',A:{xmlns:'http://www.w3.org/1999/xhtml','xmlns:ev':'http://www.w3.org/2001/xml-events','xmlns:w2':'http://www.inswave.com/websquare','xmlns:xf':'http://www.w3.org/2002/xforms'},E:[{T:1,N:'head',E:[{T:1,N:'w2:type',E:[{T:3,text:'DEFAULT'}]},{T:1,N:'w2:buildDate'},{T:1,N:'xf:model',E:[{T:1,N:'w2:dataCollection',A:{baseNode:'map'}},{T:1,N:'w2:workflowCollection'}]},{T:1,N:'script',A:{type:'text/javascript',lazy:'false'},E:[{T:4,cdata:function(scopeObj){with(scopeObj){scwin.count = 0;
scwin.onpageload = function () {
  var tmpSrc1 = scwin.getfolderPath() + "/source1.xml";
  tabControl1.addTab(scwin.count, {
    label: "Tab " + scwin.count,
    title: "Tab " + scwin.count,
    openAction: "exist",
    closable: "true"
  }, {
    "src": tmpSrc1,
    "frameMode": "wframe"
  });
  tabControl1.setSelectedTabIndex(scwin.count);
  var tmpSrc2 = scwin.getfolderPath() + "/source2.xml";
  tabControl2.addTab(scwin.count, {
    label: "Tab " + scwin.count,
    title: "Tab " + scwin.count,
    openAction: "exist",
    closable: "true"
  }, {
    "src": tmpSrc2,
    "frameMode": "wframe"
  });
  tabControl2.setSelectedTabIndex(scwin.count);
  scwin.count++;
};
scwin.onpageunload = function () {};
scwin.trigger1_onclick = function (e) {
  if (tabControl1.tabArr[0].disabled === false) {
    tabControl1.disableTab(0);
  } else {
    tabControl1.enableTab(0);
  }
  if (tabControl2.tabArr[0].disabled === false) {
    tabControl2.disableTab(0);
  } else {
    tabControl2.enableTab(0);
  }
};
scwin.trigger2_onclick = function (e) {
  if (tabControl2.tabArr[0].disabled === false) {
    tabControl2.disableTab(0);
  } else {
    tabControl2.enableTab(0);
  }
};
scwin.getfolderPath = function () {
  var currentPath = window.location.href;
  var folderPath;
  if (currentPath.includes("mainContainer")) {
    console.log("true  ===> " + $p.getFrameId());
    const cmtFrame = $p.getComponentById($p.getFrameId());
    currentPath = cmtFrame.getSrc();
    folderPath = currentPath.substring(0, currentPath.lastIndexOf('/'));
  } else {
    console.log("false  ===> ");
    folderPath = currentPath.split('w2xPath=')[1].substring(0, currentPath.split('w2xPath=')[1].lastIndexOf('/'));
  }
  return folderPath;
};
}}}]}]},{T:1,N:'body',A:{'ev:onpageload':'scwin.onpageload','ev:onpageunload':'scwin.onpageunload'},E:[{T:1,N:'xf:group',A:{id:'',style:'margin: 10px;'},E:[{T:1,N:'w2:textbox',A:{tagname:'h1',style:'margin-bottom: 10px;color: blue;',id:'textbox1',label:'자식 탭의 비활성화 상태 유지',escape:'false'}},{T:1,N:'w2:textbox',A:{tagname:'h2',style:'height: 23px;margin-bottom: 10px;color: blue;',id:'textbox2',label:'샘플 사용 방법'}},{T:1,N:'w2:textbox',A:{style:'color: blue;margin-bottom: 30px;',id:'textbox3',label:'1. 첫 번째 TabControl에 포함된 tabContro11.disableTab(0) 버튼을 클릭. <br/>2. tabControl11의 첫 번째 탭이 비활성화되는 것을 확인. <br/>3. 두 번째 TabControl에 포함된 tabContro22.disableTab(0) 버튼을 클릭. <br/>4. tabControl22의 첫 번째 탭이 비활성화되는 것을 확인.<br/>5. 제일 상단의 disableTab() & enableTab() 버튼을 클릭. <br/>6. 두 TabControl의 "Tab 0"이 모두 비활성화되는 것을 확인. <br/>7. 제일 상단의 disableTab() & enableTab() 버튼을 다시 클릭. <br/>8-1. tabControl11의 비활성화되었던 탭은 비활성화 상태를 유지하고 나머지 탭만 활성화되는 것을 확인. (자식 TabControl의 keepDisabledTab 속성 값: "true")<br/>8-2. tabControl22의 모든 탭이 활성화되는 것을 확인. (자식 TabControl의 keepDisabledTab 속성 값: "false")',escape:'false'}},{T:1,N:'xf:trigger',A:{'ev:onclick':'scwin.trigger1_onclick',style:'display: block;height:42px;line-height:32px;margn-bottom: 10px;padding:5px;background-color:coral;font-size:15px;weight: bolder;font-weight:bolder;margin-top:10px;text-align: left;margin-bottom: 10px;',id:'trigger1',type:'button'},E:[{T:1,N:'xf:label',E:[{T:4,cdata:'disableTab() & enableTab()'}]}]},{T:1,N:'w2:tabControl',A:{confirmTrueAction:'exist',useTabKeyOnly:'true',confirmFalseAction:'new',useMoveNextTabFocus:'false',useConfirmMessage:'false',alwaysDraw:'false',style:'border: gray solid 1px;margin-bottom: 10px;height: 300px;',id:'tabControl1',keepDisabledTab:'false'}},{T:1,N:'w2:tabControl',A:{confirmTrueAction:'exist',confirmFalseAction:'new',useTabKeyOnly:'true',useMoveNextTabFocus:'false',useConfirmMessage:'false',alwaysDraw:'false',style:'border: gray solid 1px;height: 300px;',id:'tabControl2',keepDisabledTab:'false'}}]}]}]}]})