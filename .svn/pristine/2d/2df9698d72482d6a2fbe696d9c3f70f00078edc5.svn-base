scwin.getfolderPath = function () {
  var currentPath = window.location.href;
  var folderPath;
  if (currentPath.includes("mainContainer")) {
    console.log("true  ===> " + $p.getFrameId());
    const cmtFrame = $p.getComponentById($p.getFrameId());
    currentPath = cmtFrame.getSrc();
    folderPath = currentPath.substring(0, currentPath.lastIndexOf('/'));
  } else {
    console.log("false  ===> ");
    folderPath = currentPath.split('w2xPath=')[1].substring(0, currentPath.split('w2xPath=')[1].lastIndexOf('/'));
  }
  return folderPath;
};
}}}]}]},{T:1,N:'body',A:{'ev:onpageload':'scwin.onpageload','ev:onpageunload':'scwin.onpageunload'},E:[{T:1,N:'xf:group',A:{id:'',style:'margin: 10px;'},E:[{T:1,N:'w2:textbox',A:{tagname:'h1',style:'color: blue;margin-bottom: 10px;',tabIndex:'h1',id:'textbox1',label:'Allow History Function inside IFrame<br/>',escape:'false'}},{T:1,N:'w2:textbox',A:{tagname:'h2',style:'height: 23px;margin-bottom: 10px;color: blue;',id:'textbox2',label:'How to Use'}},{T:1,N:'w2:textbox',A:{style:'color: blue;margin-bottom: 30px;',id:'textbox3',label:'1. Run this example standalone.<br/>2. Navigate to any web page.<br/>3. Copy the address of the browser running this standalone example and paste it into the address bar of the browser running the arbitrary web page.<br/>4. Click the setSrc() button.<br/>5. Check the IFrame\'s internal screen changes. <br/>6. Click the browser\'s back button.<br/>7. Check the previous IFrame screen is displayed. (spaReplaceHistory=“false”)<br/>8. Confirm that clicking the browser\'s back button again returns to the previous arbitrary web page.<br/>(Also verify the spaReplaceHistory="true" example.)',escape:'false'}},{T:1,N:'xf:trigger',A:{'ev:onclick':'scwin.trigger1_onclick',style:'height:42px;line-height:32px;padding:5px;background-color:coral;font-size:15px;weight: bolder;font-weight:bolder;text-align: left;display: block;margin-bottom: 10px;',id:'trigger1',type:'button'},E:[{T:1,N:'xf:label',E:[{T:4,cdata:'setSrc("22.xml")'}]}]},{T:1,N:'w2:textbox',A:{style:'padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightblue;border:none;margin-bottom: 10px;',id:'textbox4',label:'spaReplaceHistory="false" <br/>spa="false"',escape:'false'}},{T:1,N:'w2:iframe',A:{scrolling:'',src:'',spa:'true',style:'border: solid 1px gray;margin-bottom: 10px;',id:'iframe1',spaReplaceHistory:'false'}}]}]}]}]})