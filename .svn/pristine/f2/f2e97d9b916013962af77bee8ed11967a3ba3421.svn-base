define({declaration:{A:{version:'1.0',encoding:'UTF-8'}},E:[{T:1,N:'html',A:{xmlns:'http://www.w3.org/1999/xhtml','xmlns:ev':'http://www.w3.org/2001/xml-events','xmlns:w2':'http://www.inswave.com/websquare','xmlns:xf':'http://www.w3.org/2002/xforms'},E:[{T:1,N:'head',E:[{T:1,N:'w2:type',E:[{T:3,text:'DEFAULT'}]},{T:1,N:'w2:buildDate'},{T:1,N:'xf:model',E:[{T:1,N:'w2:dataCollection',A:{baseNode:'map'}},{T:1,N:'w2:workflowCollection'}]},{T:1,N:'script',A:{type:'text/javascript',lazy:'false'},E:[{T:4,cdata:function(scopeObj){with(scopeObj){scwin.onpageload = function () {};
scwin.onpageunload = function () {};
scwin.trigger1_onclick = function (e) {
  //var result = input1.validate();
  //alert (result);
  input1.validate();
};
scwin.fn_msg = function () {
  var invalidType = this.getType();
  var invalidValue = this.getValue();
  switch (invalidType) {
    case "mandatory":
      msg = "Information is required.";
      break;
    case "minLength":
      msg = "Minimum " + invalidValue + " digits are required.";
      break;
    case "minByteLength":
      msg = "Minimum " + invalidValue + " bytes are required.";
      break;
    default:
      msg = "Not valid";
      break;
  }
  return msg;
};
}}}]}]},{T:1,N:'body',A:{'ev:onpageload':'scwin.onpageload','ev:onpageunload':'scwin.onpageunload'},E:[{T:1,N:'xf:group',A:{id:'',style:'margin: 10px;'},E:[{T:1,N:'w2:textbox',A:{style:'color: blue;margin-bottom: 10px;',id:'textbox1',label:'입력 검증 및 오류 메시지 표시',escape:'false',tagname:'h1',tabIndex:'h1'}},{T:1,N:'w2:textbox',A:{tagname:'h2',style:'height: 23px;margin-bottom: 10px;color: blue;',id:'textbox3',label:'샘플 사용 방법'}},{T:1,N:'w2:textbox',A:{style:'color: blue;margin-bottom: 30px;',id:'textbox2',label:'1. 길이가 5 바이트 미만의 텍스트를 입력. <br/>2. validate() 버튼을 클릭. <br/>3. invalidMessageFunc 속성 값으로 지정한 함수가 반환한 오류 메시지가 표시되는 것을 확인. <br/>4. 아무것도 입력하지 않고 validate() 버튼을 클릭. <br/>5. invalidMessageFunc 속성 값으로 지정한 함수가 반환한 오류 메시지가 표시되는 것을 확인.',escape:'false'}},{T:1,N:'w2:textbox',A:{style:'padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightblue;border:none;margin-bottom: 10px;',id:'textbox5',label:'속성 설정<br/>minByteLength="5" <br/>mandatory="true" <br/>displaymessage="true" <br/>invalidMessageFunc="scwin.fn_msg"',escape:'false'}},{T:1,N:'xf:trigger',A:{'ev:onclick':'scwin.trigger1_onclick',style:'display: block;height:42px;line-height:32px;padding:5px;background-color:coral;font-size:15px;weight: bolder;font-weight:bolder;margin-bottom:10px;text-align: left;',id:'trigger1',type:'button'},E:[{T:1,N:'xf:label',E:[{T:4,cdata:'input1.validate();'}]}]},{T:1,N:'xf:input',A:{minlength:'',minByteLength:'5',invalidMessage:'',adjustMaxLength:'false',style:'width: 100%;text-align: right;height:50px;padding: 5px;font-size:30px;font-style:normal;font-weight:bolder;color: red;',invalidMessageFunc:'scwin.fn_msg',id:'input1',displaymessage:'true',mandatory:'true'}},{T:1,N:'w2:textbox',A:{escape:'false',id:'textbox6',label:'/// 샘플 코드 <br/><br/>scwin.fn_msg = function () {<br/> &nbsp; &nbsp;var invalidType = this.getType();<br/> &nbsp; &nbsp;var invalidValue = this.getValue();<br/> &nbsp; &nbsp;switch (invalidType) {<br/> &nbsp; &nbsp; &nbsp; &nbsp;case "mandatory":<br/> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;msg = "Information is required.";<br/> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;break;<br/> &nbsp; &nbsp; &nbsp; &nbsp;case "minLength":<br/> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;msg = "Minimum " + invalidValue + " digits are required.";<br/> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;break;<br/> &nbsp; &nbsp; &nbsp; &nbsp;case "minByteLength":<br/> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;msg = "Minimum " + invalidValue + " bytes are required.";<br/> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;break;<br/> &nbsp; &nbsp; &nbsp; &nbsp;default:<br/> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;msg = "Not valid";<br/> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;break;<br/> &nbsp; &nbsp;}<br/> &nbsp; &nbsp;return msg;<br/>}',style:'padding:10px; padding-bottom:20px; text-align:left; font-size:15px; font-weight:bolder; border:brown 1px solid; background-color:ivory; margin-bottom:10px; margin-top:10px; color:brown;'}}]}]}]}]})