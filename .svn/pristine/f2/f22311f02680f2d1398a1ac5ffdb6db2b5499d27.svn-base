        { "created_date": "19990407", "product": "ExpertIT", "stock": "582196" }
    ]);
};

]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:group class="sub_contents" id="" style="">
			<xf:group class="ws_example_grp_desc" id="" style="">
				<w2:textbox escape="false" id="" label="GridView의 'drawType' 속성을 사용하여, GridView를 브라우저에 렌더링하는 방식을 설정한 예제입니다." style=""></w2:textbox>
			</xf:group>
			<xf:group class="example_div_tb_style_wrap" id="">
				<xf:group class="example_div_tr_style" id="" style="">
					<w2:textbox class="example_div_th_style" escape="false" id="" label="(기본 설정) WebSquare 방식(화면에 노출되는 영역만 'table'로 출력)" style=""></w2:textbox>
					<xf:group class="example_div_td_style" id="" style="">
					<xf:group id="" class="gvwbox">
						<w2:gridView rowNumWidth="34" visibleRowNumFix="true" rowNumVisible="true" dataList="data:dlt_exam"
							style="height:120px;" autoFit="allColumn" id="" visibleRowNum="4" class="gvw" defaultCellHeight="37" autoFitMinWidth="240"
							drawType="virtual">
							<w2:caption style="" id="caption1" value="this is a grid caption."></w2:caption>
							<w2:header style="" id="header1">
								<w2:row style="" id="row1">
									<w2:column width="83" inputType="text" id="column1" value="Date" displayMode="label"></w2:column>
									<w2:column width="140" inputType="text" id="column3" value="Product" displayMode="label"></w2:column>
									<w2:column width="63" inputType="text" id="column2" value="Stock" displayMode="label"></w2:column>
								</w2:row>
							</w2:header>
							<w2:gBody style="" id="gBody1">
								<w2:row style="" id="row2">
									<w2:column dataType="date" width="83" displayFormat="yyyy-MM-dd" inputType="text" id="created_date"
										displayMode="label">
									</w2:column>
									<w2:column textAlign="left" width="140" inputType="text" id="product" displayMode="label" value=""></w2:column>
									<w2:column textAlign="right" dataType="number" width="63" displayFormat="#,###" inputType="text"
										id="stock" displayMode="label">
									</w2:column>
								</w2:row>
							</w2:gBody>
						</w2:gridView></xf:group></xf:group>
				</xf:group>
				<xf:group class="example_div_tr_style" id="" style="">
					<w2:textbox class="example_div_th_style" escape="false" id="" label="Native 방식 (데이터를 'table'로 모두 출력)" style=""></w2:textbox>
					<xf:group class="example_div_td_style" id="" style="">
					<xf:group id="" class="gvwbox">
						<w2:gridView rowNumWidth="34" rowNumVisible="true" dataList="data:dlt_exam" drawType="native" style="height:190px;"
							autoFit="allColumn" id="" class="gvw" defaultCellHeight="37" autoFitMinWidth="240">
							<w2:caption style="" id="caption1" value="this is a grid caption."></w2:caption>
							<w2:header style="" id="header1">
								<w2:row style="" id="row1">
									<w2:column width="83" inputType="text" id="column1" value="Date" displayMode="label"></w2:column>
									<w2:column width="140" inputType="text" id="column3" value="Product" displayMode="label"></w2:column>
									<w2:column width="63" inputType="text" id="column2" value="Stock" displayMode="label"></w2:column>
								</w2:row>
							</w2:header>
							<w2:gBody style="" id="gBody1">
								<w2:row style="" id="row2">
									<w2:column dataType="date" width="83" displayFormat="yyyy-MM-dd" inputType="text" id="created_date"
										displayMode="label">
									</w2:column>
									<w2:column textAlign="left" width="140" inputType="text" id="product" displayMode="label" value=""></w2:column>
									<w2:column textAlign="right" dataType="number" width="63" displayFormat="#,###" inputType="text"
										id="stock" displayMode="label">
									</w2:column>
								</w2:row>
							</w2:gBody>
						</w2:gridView></xf:group></xf:group>
				</xf:group>
			</xf:group>
		</xf:group>
	</body>
</html>