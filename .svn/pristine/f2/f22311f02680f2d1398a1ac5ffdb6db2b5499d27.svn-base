<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare"
	xmlns:xf="http://www.w3.org/2002/xforms">
	<head meta_author="InswaveSystems" meta_type="메인" meta_screenName="[GridView] 브라우저에 표현하는 방식 설정하기">
		<w2:historyInfo>
			<w2:history meta_no="01" meta_desc="최초작성" meta_date="20220907" meta_user="InswaveSystems" ></w2:history>
			<w2:history meta_no="02" meta_desc="설명부 수정" meta_date="20240621" meta_user="InswaveSystems" ></w2:history>
			<w2:history meta_no="03" meta_desc="예제에서 사용하는 DataList가 변경되고, 이에 따른 GridVeiw의 설정이 수정되었습니다." meta_date="20240705" meta_user="InswaveSystems"></w2:history>
		</w2:historyInfo>
		<w2:type>COMPONENT</w2:type>
		<w2:buildDate />
		<w2:MSA />
		<xf:model>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" id="dlt_exam" repeatNode="map" style="" valueAttribute="">
					<w2:columnInfo>
						<w2:column dataType="text" id="product" name="Product"></w2:column>
						<w2:column dataType="text" id="stock" name="Stock"></w2:column>
						<w2:column id="created_date" name="Date" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
			<w2:workflowCollection />
		</xf:model>
		<w2:layoutInfo />
		<w2:publicInfo method="" />
		<script lazy="false" type="text/javascript"><![CDATA[scwin.onpageload = function () {
    // 예제 테스트를 위한 초기화
    scwin.initializeExample();
};

// 예제 테스트를 위한 초기화
scwin.initializeExample = function () {
    // DataList 할당
    dlt_exam.setJSON([
        { "created_date": "20110715", "product": "SecureGate", "stock": "98291" },
        { "created_date": "19991225", "product": "FastServe", "stock": "528" },
        { "created_date": "20140321", "product": "CloudFlex", "stock": "73928" },
        { "created_date": "20080612", "product": "CodeStream", "stock": "6894" },
        { "created_date": "19950103", "product": "NetMax", "stock": "4536219" },
        { "created_date": "20190523", "product": "TechAssist", "stock": "73918" },
        { "created_date": "20171018", "product": "IntelliAI", "stock": "351" },
        { "created_date": "20020814", "product": "StoreSafe", "stock": "9810" },
        { "created_date": "20151230", "product": "ManageIT", "stock": "782" },
        { "created_date": "20130809", "product": "WebBuilder", "stock": "9461" },
        { "created_date": "20210711", "product": "EcoServe", "stock": "6547281" },
        { "created_date": "19980422", "product": "SmartConsult", "stock": "265" },
        { "created_date": "20160127", "product": "MobileMagic", "stock": "1746123" },
        { "created_date": "20000516", "product": "SpeedLink", "stock": "564" },
        { "created_date": "20030911", "product": "VirusGuard", "stock": "732" },
        { "created_date": "20140617", "product": "DataVault", "stock": "582196" },
        { "created_date": "20100129", "product": "GlobalSupport", "stock": "372594" },
        { "created_date": "20170905", "product": "DataAnalyzer", "stock": "6285" },
        { "created_date": "19960309", "product": "FrameworkPro", "stock": "6105" },
        { "created_date": "20071011", "product": "ServeAll", "stock": "5478269" },
        { "created_date": "20120914", "product": "CloudPro", "stock": "9461" },
        { "created_date": "20181127", "product": "AppMagic", "stock": "97413" },
        { "created_date": "19970830", "product": "LinkSecure", "stock": "598362" },
        { "created_date": "20140618", "product": "HelpDesk", "stock": "732" },
        { "created_date": "20130420", "product": "SafeWeb", "stock": "802354" },
        { "created_date": "20050505", "product": "SmartStorage", "stock": "6547281" },
