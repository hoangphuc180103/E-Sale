define({declaration:{A:{version:'1.0',encoding:'UTF-8'}},E:[{T:1,N:'html',A:{xmlns:'http://www.w3.org/1999/xhtml','xmlns:ev':'http://www.w3.org/2001/xml-events','xmlns:w2':'http://www.inswave.com/websquare','xmlns:xf':'http://www.w3.org/2002/xforms'},E:[{T:1,N:'head',E:[{T:1,N:'w2:type',E:[{T:3,text:'DEFAULT'}]},{T:1,N:'w2:buildDate'},{T:1,N:'xf:model',E:[{T:1,N:'w2:dataCollection',A:{baseNode:'map'}},{T:1,N:'w2:workflowCollection'}]},{T:1,N:'script',A:{type:'text/javascript',lazy:'false'},E:[{T:4,cdata:function(scopeObj){with(scopeObj){scwin.count = 0;
scwin.onpageload = function () {
  scwin.count++;
  var tmpSrc = scwin.getfolderPath() + "/window_src.xml";
  var winObj = {
    title: "Window",
    src: tmpSrc,
    windowTitle: "_windowTitle",
    windowId: scwin.count,
    frameMode: "wframe",
    defaultWidth: "200",
    defaultHeight: "200"
  };
  windowContainer1.createWindow(winObj);
  windowContainer1.setArrangeWindows("cascade");
  windowContainer2.createWindow(winObj);
  windowContainer2.setArrangeWindows("cascade");
};
scwin.onpageunload = function () {};
scwin.getfolderPath = function () {
  var currentPath = window.location.href;
  var folderPath;
  if (currentPath.includes("mainContainer")) {
    console.log("true  ===> " + $p.getFrameId());
    const cmtFrame = $p.getComponentById($p.getFrameId());
    currentPath = cmtFrame.getSrc();
    folderPath = currentPath.substring(0, currentPath.lastIndexOf('/'));
  } else {
    console.log("false  ===> ");
    folderPath = currentPath.split('w2xPath=')[1].substring(0, currentPath.split('w2xPath=')[1].lastIndexOf('/'));
  }
  return folderPath;
};
}}}]}]},{T:1,N:'body',A:{'ev:onpageload':'scwin.onpageload','ev:onpageunload':'scwin.onpageunload'},E:[{T:1,N:'xf:group',A:{id:'',style:'margin: 10px;'},E:[{T:1,N:'w2:textbox',A:{tagname:'h1',style:'color: blue;margin-bottom: 10px;',tabIndex:'h1',id:'textbox1',label:'Set Movement Range of Dragged Window',escape:'false'}},{T:1,N:'w2:textbox',A:{tagname:'h2',style:'height: 23px;margin-bottom: 10px;color: blue;',id:'textbox2',label:'How to Use'}},{T:1,N:'w2:textbox',A:{style:'color: blue;margin-bottom: 30px;',id:'textbox3',label:'(First WindowContainer)<br/>1-1. Dragging the window outside the WindowContainer.<br/>1-2. Confirming that positioning is only possible within the WindowContainer. (windowMoveType=“restrict”)<br/><br/>(Second WindowContainer)<br/>2-1. Dragging the window outside the WindowContainer.<br/>2-2. Confirm that the position can be set outside the WindowContainer. (windowMoveType=“overflow”)',escape:'false'}},{T:1,N:'w2:textbox',A:{style:'padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightblue;border:none;margin-bottom: 10px;',id:'textbox4',label:'windowMoveType="restrict"',escape:'false'}},{T:1,N:'w2:windowContainer',A:{sequentialArrangeColNum:'2',sequentialArrangeRowNum:'2',fixArrangeFullScreen:'false',useFixButton:'false',windowAutoResize:'false',useWindowScrollButton:'true',defaultWidth:'',verticalArrangeNum:'2',windowMaxNum:'20',useCloseButton:'false',controlIconPosition:'allright',stopMinimizeOnNameLayer:'false',toolbarPosition:'top',windowMaximizeAll:'true',id:'windowContainer1',useStatusMsg:'true',hideTitleOnMaximize:'false',spaInitCount:'0',windowScrollVisibleRowNum:'',stopToggleOnLast:'false',defaultHeight:'',useNameContainer:'true',horizontalArrangeNum:'2',useCustomMsg:'false',windowMoveType:'restrict',autoArrange:'true',useControlIconTitle:'true',tooltipDisplay:'true',tooltipGroupClass:'false',windowTooltipDisplay:'true',style:'position: relative;height: 400px;border: gray solid 1px;margin-bottom: 10px;'}