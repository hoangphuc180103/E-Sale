define({declaration:{A:{version:'1.0',encoding:'UTF-8'}},E:[{T:1,N:'html',A:{xmlns:'http://www.w3.org/1999/xhtml','xmlns:ev':'http://www.w3.org/2001/xml-events','xmlns:w2':'http://www.inswave.com/websquare','xmlns:xf':'http://www.w3.org/2002/xforms'},E:[{T:1,N:'head',E:[{T:1,N:'w2:type',E:[{T:3,text:'DEFAULT'}]},{T:1,N:'w2:buildDate'},{T:1,N:'xf:model',E:[{T:1,N:'w2:dataCollection',A:{baseNode:'map'},E:[{T:1,N:'w2:dataList',A:{id:'dataList1',baseNode:'list',saveRemovedData:'true',repeatNode:'map'},E:[{T:1,N:'w2:columnInfo',E:[{T:1,N:'w2:column',A:{id:'col1',name:'name1',dataType:'text'}},{T:1,N:'w2:column',A:{id:'col2',name:'name2',dataType:'text'}},{T:1,N:'w2:column',A:{id:'col3',name:'name3',dataType:'text'}}]}]}]},{T:1,N:'w2:workflowCollection'}]},{T:1,N:'script',A:{type:'text/javascript'},E:[{T:4,cdata:function(scopeObj){with(scopeObj){scwin.onpageload = function () {};
scwin.onpageunload = function () {};
var count = 0;
scwin.trigger1_onclick = function (e) {
  count++;
  var tmpSrc = scwin.getfolderPath() + "/source.xml";
  widgetContainer1.addWidgets({
    id: tmpSrc + count,
    title: tmpSrc + count,
    src: tmpSrc,
    scope: true,
    x: 0,
    y: 0,
    unitWidth: 2,
    unitHeight: 2
  });
  widgetContainer2.addWidgets({
    id: tmpSrc + count,
    title: tmpSrc + count,
    src: tmpSrc,
    scope: true,
    x: 0,
    y: 0,
    unitWidth: 2,
    unitHeight: 2
  });
};
scwin.getfolderPath = function () {
  var currentPath = window.location.href;
  var folderPath;
  if (currentPath.includes("mainContainer")) {
    console.log("true  ===> " + $p.getFrameId());
    const cmtFrame = $p.getComponentById($p.getFrameId());
    currentPath = cmtFrame.getSrc();
    folderPath = currentPath.substring(0, currentPath.lastIndexOf('/'));
  } else {
    console.log("false  ===> ");
    folderPath = currentPath.split('w2xPath=')[1].substring(0, currentPath.split('w2xPath=')[1].lastIndexOf('/'));
  }
  return folderPath;
};
}}}]}]},{T:1,N:'body',A:{style:'padding:20px;'},E:[{T:1,N:'xf:group',A:{id:'',style:''},E:[{T:1,N:'w2:textbox',A:{tagname:'h1',style:'color: blue;margin-bottom: 10px;',tabIndex:'h1',id:'textbox1',label:'위젯 생성 후 서브미션 상태창 표시',escape:'false'}},{T:1,N:'w2:textbox',A:{tagname:'h2',style:'height: 23px;margin-bottom: 10px;color: blue;',id:'textbox2',label:'샘플 사용 방법'}},{T:1,N:'w2:textbox',A:{style:'color: blue;margin-bottom: 30px;',id:'textbox3',label:'1. 하단의 addWidgets() 버튼을 클릭.<br/>2. 위젯이 생성되는 것을 확인. <br/><br/>(첫 번째 Widget Container)<br/>3-1. 위젯 소스(src) 화면의 Submit 버튼을 클릭. <br/>3-2. 서브미션이 실행되고 상태창이 위젯 내부에만 표시되는 것을 확인. (processMsgFrame="true")<br/><br/>(두 번째 Widget Container)<br/>4-1. 위젯 소스(src) 화면의 Submit 버튼을 클릭. <br/>4-2. 서브미션이 실행되고 상태창이 화면 전체에 표시되는 것을 확인. (processMsgFrame="false")',escape:'false'}},{T:1,N:'xf:trigger',A:{'ev:onclick':'scwin.trigger1_onclick',style:'height:42px;line-height:32px;padding:5px;background-color:coral;font-size:15px;weight: bolder;font-weight:bolder;text-align: left;display: block;margin-bottom: 10px;',id:'trigger1',type:'button'},E:[{T:1,N:'xf:label',E:[{T:4,cdata:'addWidgets()'}]}]},{T:1,N:'w2:textbox',A:{style:'padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightblue;border:none;margin-bottom: 10px;',id:'textbox4',label:'속성 설정<br/>processMsgFrame="true"',escape:'false'}},{T:1,N:'w2:widgetContainer',A:{mode:'pushpull',unitHeightPixel:'200',preventMaximizeByTitle:'false',widgetMove:'true',style:'height: 300px;border:1px solid black;margin-bottom: 10px;',id:'widgetContainer1',cols:'3',processMsgFrame:'true','ev:onwidgetmove':'scwin.widgetContainer1_onwidgetmove'}},{T:1,N:'w2:textbox',A:{escape:'false',id:'textbox5',label:'속성 설정<br/>processMsgFrame="false"',style:'padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightblue;border:none;margin-bottom: 10px;'}},{T:1,N:'w2:widgetContainer',A:{cols:'3','ev:onwidgetmove':'scwin.widgetContainer1_onwidgetmove',id:'widgetContainer2',mode:'p