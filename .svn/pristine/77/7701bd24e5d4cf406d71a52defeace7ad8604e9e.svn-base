<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet href="/2019-09/Components/gridview.css" type="text/css"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head meta_vertical_guides="" meta_horizontal_guides="" meta_screenName="guide_sample">
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
        	<xf:instance>
        		<data xmlns="" />
        	</xf:instance>
        	<w2:dataCollection baseNode="map">
        		<w2:dataList baseNode="list" repeatNode="map" id="dataList1" saveRemovedData="true">
        			<w2:columnInfo>
        				<w2:column id="ID" name="ID" dataType="text"></w2:column>
        				<w2:column id="Age" name="Age" dataType="text"></w2:column>
        				<w2:column id="Status" name="Status" dataType="text"></w2:column>
        				<w2:column id="Income" name="Income" dataType="text"></w2:column>
        				<w2:column id="Expense" name="Expense" dataType="text"></w2:column>
        				<w2:column id="Hobby" name="Hobby" dataType="text"></w2:column>
        				<w2:column id="Region" name="Region" dataType="text"></w2:column>
        				<w2:column id="Frequency" name="Frequency" dataType="text"></w2:column>
        				<w2:column id="Date" name="Date" dataType="text"></w2:column>
        			</w2:columnInfo>
        		</w2:dataList>
        	</w2:dataCollection>
        	<w2:workflowCollection></w2:workflowCollection>
        	<xf:submission id="submission1" ref="" target='data:json,dataList1' action="data.json" method="post"
        		mediatype="application/json" encoding="UTF-8" instance="" replace="" errorHandler="" customHandler="" mode="asynchronous"
        		processMsg="" ev:submit="" ev:submitdone="" ev:submiterror="" abortTrigger="">
        	</xf:submission>
        </xf:model>
        <script type="text/javascript" lazy="false"><![CDATA[

scwin.onpageload = function () {
    var objSubmission = $p.getSubmission("submission1");
    objSubmission.action = scwin.getfolderPath() + '/data.json';
    $p.executeSubmission("submission1");
};

scwin.onpageunload = function () {

};


scwin.trigger1_onclick = function (e) {

    var allJSON = dataList1.getAllJSON({ "rowStatusData": false });
    var pre = WebSquare.json.JSON2XML(allJSON);
    var result = WebSquare.json.XML2JSONString(pre);
    alert(result);
};

scwin.getfolderPath = function () {

    var currentPath = window.location.href;
    var folderPath;

    if (currentPath.includes("mainContainer")) {
        console.log("true  ===> " + $p.getFrameId());
        const cmtFrame = $p.getComponentById($p.getFrameId());
        currentPath = cmtFrame.getSrc();
        folderPath = currentPath.substring(0, currentPath.lastIndexOf('/'));
    } else {
        console.log("false  ===> ");
        folderPath = currentPath.split('w2xPath=')[1].substring(0, currentPath.split('w2xPath=')[1].lastIndexOf('/'));
    }
    return folderPath;
};
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload" ev:onpageunload="scwin.onpageunload">
    <xf:group id="" style="margin: 10px;">
    	<w2:textbox tagname="h1" style="color: blue;margin-bottom: 10px;" tabIndex="h1" id="textbox2" label="Return DataList Data in JSON (Excluding rowStatus)" escape="false"></w2:textbox>
    	<w2:textbox tagname="h2" style="height: 23px;margin-bottom: 10px;color: blue;" id="textbox3" label="How to Use"></w2:textbox>
    	<w2:textbox style="color: blue;margin-bottom: 30px;" id="textbox4"
    		label="1. Click the getAllJSON() button.&lt;br/&gt;2. Verify that all data from the DataList bound to the GridView is displayed. Note that the row status (rowStatus) is not displayed." escape="false">
    	</w2:textbox>
    	<xf:trigger ev:onclick="scwin.trigger1_onclick"
    		style="height:42px;line-height:32px;padding:5px;background-color:coral;font-size:15px;weight: bolder;font-weight:bolder;text-align: left;display: block;margin-bottom: 10px;"
    		id="trigger1" type="button">
    		<xf:label><![CDATA[getAllJSON()]]></xf:label>
    	</xf:trigger>
    	<w2:gridView checkAllType="false" id="gridView1" style="border: solid gray 1px;" dataList="data:dataList1" visibleRowNum="10"
    		visibleRowNumFix="true" autoFit="allColumn">
    		<w2:caption style="" id="caption2" value="this is a grid caption."></w2:caption>
    		<w2:header style="" id="header2">
    			<w2:row style="" id="row3">
    				<w2:column width="70" inputType="text" style="" id="column11" value="ID" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="" id="column10" value="Age" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="" id="column9" value="Status" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="" id="column8" value="Income" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="" id="column7" value="Expense" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="" id="column6" value="Hobby" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="" id="column5" value="Region" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="" id="column4" value="Frequency" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="" id="column49" value="Date" displayMode="label"></w2:column>
    			</w2:row>
    		</w2:header>
    		<w2:gBody style="" id="gBody2">
    			<w2:row style="" id="row4">
    				<w2:column width="70" inputType="text" style="" id="ID" value="" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="" id="Age" value="" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="" id="Status" value="" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="" id="Income" value="" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="" id="Expense" value="" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="" id="Hobby" value="" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="" id="Region" value="" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="" id="Frequency" value="" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="" id="Date" value="" displayMode="label"></w2:column>
    			</w2:row>
    		</w2:gBody>
    	</w2:gridView>
    </xf:group></body>
</html>
