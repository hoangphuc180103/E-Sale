/**
 * GridView 'grd_exam1'의 'customType' 컬럼의 'typeGetter' 속성에 설정된 메소드
 * 동적으로 셀의 'inputType'을 설정
 */
scwin.getCustomType = function (info) {
  // console.log(info);
  let rowIndex = info.rowIndex;
  let colIndex = info.colIndex;
  let returnInfo = {
    options: {
      readOnly: "false",
      viewType: "default",
      chooseOption: "false",
      textAlign: "center"
    }
  };
  let _inputType = dlt_exam.getCellData(rowIndex, "inputType");
  switch (_inputType) {
    case "autoComplete":
      returnInfo.itemSet = {
        nodeset: "data:dlt_code",
        label: "codeName",
        value: "code"
      };
      returnInfo.options.viewType = "icon";
      returnInfo.options.chooseOption = "true";
      break;
    case "button":
      break;
    case "calendar":
      returnInfo.options.viewType = "icon";
      break;
    case "checkbox":
      returnInfo.options.checkboxLabel = "checkbox";
      returnInfo.options.valueType = "other";
      returnInfo.options.trueValue = "Y";
      returnInfo.options.falseValue = "N";
      break;
    case "checkcombobox":
      returnInfo.itemSet = {
        nodeset: "data:dlt_code",
        label: "codeName",
        value: "code"
      };
      returnInfo.options.viewType = "icon";
      returnInfo.options.chooseOption = "true";
      break;
    case "image":
      break;
    case "link":
      break;
    case "radio":
      returnInfo.options.checkboxLabel = "radio";
      returnInfo.options.valueType = "other";
      returnInfo.options.trueValue = "Y";
      returnInfo.options.falseValue = "N";
      break;
    case "secret":
      break;
    case "select":
      returnInfo.itemSet = {
        nodeset: "data:dlt_code",
        label: "codeName",
        value: "code"
      };
      returnInfo.options.viewType = "icon";
      returnInfo.options.chooseOption = "true";
      break;
    case "spinner":
      returnInfo.options.viewType = "icon";
      break;
    case "textarea":
      break;
    case "textImage":
      returnInfo.options.viewType = "icon";
      returnInfo.options.imageSrc = "/img/icons_search_type2.png";
      returnInfo.options.imageHeight = "20";
      returnInfo.options.readOnly = "true";
      break;
    case "text":
    default:
      break;
  }
  returnInfo.id = "dynamic_" + _inputType + "_" + rowIndex + "_" + colIndex;
  returnInfo.inputType = _inputType;
  return returnInfo;
};

/**
 * 사용자가 셀 수정 후 이벤트
 */
scwin.grd_ex01_onafteredit = function (row, col, value) {
  let colId = this.getColumnID(col);
  if (colId != "inputType") {
    return;
  }
  let cellData = "";
  switch (value) {
    case "autoComplete":
      cellData = "03";
      break;
    case "button":
      cellData = "button";
      break;
    case "calendar":
      cellData = "20241231";
      break;
    case "checkbox":
      cellData = "Y";
      break;
    case "checkcombobox":
      cellData = "03";
      break;
    case "image":
      cellData = "/img/btn_sub_setting.png";
      break;
    case "link":
      cellData = "link";
      break;
    case "radio":
      cellData = "N";
      break;
    case "secret":
      cellData = "secret";
      break;
    case "select":
      cellData = "03";
      break;
    case "spinner":
      cellData = "12";
      break;
    case "textarea":
      cellData = "textarea";
      break;
    case "textImage":
      cellData = "textImage";
      break;
    case "text":
    default:
      cellData = "text";
      break;
  }

  // 셀에 데이터를 설정하면 'customType' 컬럼의 'typeGetter'에 설정된 메소드가 호출됩니다.
  dlt_exam.setCellData(row, "customType", cellData);
};
}}}]}]},{T:1,N:'body',A:{'ev:onpageload':'scwin.onpageload'},E:[{T:1,N:'xf:group',A:{class:'sub_contents',id:'',style:''},E:[{T:1,N:'xf:group',A:{class:'ws_example_grp_desc',id:'',style:''},E:[{T:1,N:'w2:textbox',A:{escape:'false',id:'',label:'그리드뷰의 inputType을 동적으로 변경한 예시입니다.<br/>\'InputType\' 컬럼의 값에 따라 \'CustomType\' 컬럼의 \'inputType\' 속성이 변경됩니다.',style:''}},{T:1,N:'w2:textbox',A:{class:'ws_example_txt_desc_info',escape:'false',id:'',label:'이 예제는 시연용 예제로 예제 가이드 문서가 포함되어 있지 않습니다.',style:''}}]},{T:1,N:'xf:group',A:{id:'',class:'gvwbox',style:'max-width: 400px;'},E:[{T:1,N:'w2:gridView',A:{'ev:oneditend':'',oddEvenColorDisplay:'false',rowNumVisible:'true',rowNumHeaderValue:'No',scrollByColumn:'false','ev:onrightbuttonclick':'',defaultCellHeight:'37',adaptive:'',focusMode:'row',rowNumWidth:'',senseReader:'',keyMoveEditMode:'true',autoFit:'allColumn',id:'grd_ex01',tooltipDisplayColumn:'INFO',mergeCells:'',class:'gvw',ignoreToggleOnDisabled:'false',adaptiveThreshold:'','ev:oncellclick':'',editModeEvent:'onclick',scrollByColumnAdaptive:'false',rowNumStatusUniqueId:'true','ev:onbeforeedit':'',summaryAuto:'false',useCtrlOnMultisort:'',useShiftKey:'true',readOnly:'','ev:onscrolly':'',rowStatusVisible:'',tooltipDisplay:'true',fixedColumnWithHidden:'true',dataList:'data:dlt_exam','ev:onviewchange':'',columnMove:'true',ignoreCellClick:'false',style:'height:150px;','ev:onafteredit':'scwin.grd_ex01_onafteredit',visibleRowNum:'all',autoFitMinWidth:'300'},E:[{T:1,N:'w2:caption',A:{style:'',id:'caption1',value:'this is a grid caption.'}},{T:1,N:'w2:header',A:{style:'',id:'header1'},E:[{T:1,N:'w2:row',A:{style:'',id:'row1'},E:[{T:1,N:'w2:column',A:{width:'150',inputType:'text',style:'',id:'column7',value:'InputType',blockSelect:'false',displayMode:'label'}},{T:1,N:'w2:column',A:{width:'120',inputType:'text',style:'',id:'column5',value:'CustomType',blockSelect:'false',displayMode:'label'}}]}]},{T:1,N:'w2:gBody',A:{style:'',id:'gBody1'},E:[{T:1,N:'w2:row',A:{style:'',id:'row2'},E:[{T:1,