define({declaration:{A:{version:'1.0',encoding:'UTF-8'}},E:[{T:1,N:'html',A:{xmlns:'http://www.w3.org/1999/xhtml','xmlns:ev':'http://www.w3.org/2001/xml-events','xmlns:w2':'http://www.inswave.com/websquare','xmlns:xf':'http://www.w3.org/2002/xforms'},E:[{T:1,N:'head',A:{},E:[{T:1,N:'w2:historyInfo',E:[{T:1,N:'w2:history',A:{}},{T:1,N:'w2:history',A:{}}]},{T:1,N:'w2:type',E:[{T:3,text:'COMPONENT'}]},{T:1,N:'w2:buildDate'},{T:1,N:'w2:MSA'},{T:1,N:'xf:model',E:[{T:1,N:'w2:dataCollection',A:{baseNode:'map'},E:[{T:1,N:'w2:dataList',A:{baseNode:'list',id:'dlt_exam',repeatNode:'map',saveRemovedData:'true',style:''},E:[{T:1,N:'w2:columnInfo',E:[{T:1,N:'w2:column',A:{dataType:'text',id:'inputType',name:'입력 유형'}},{T:1,N:'w2:column',A:{dataType:'text',id:'customType',name:'동적 유형'}}]},{T:1,N:'w2:data',A:{use:'true'},E:[{T:1,N:'w2:row',E:[{T:1,N:'inputType',E:[{T:4,cdata:'autoComplete'}]},{T:1,N:'customType',E:[{T:4,cdata:'03'}]}]},{T:1,N:'w2:row',E:[{T:1,N:'inputType',E:[{T:4,cdata:'button'}]},{T:1,N:'customType',E:[{T:4,cdata:'button'}]}]},{T:1,N:'w2:row',E:[{T:1,N:'inputType',E:[{T:4,cdata:'calendar'}]},{T:1,N:'customType',E:[{T:4,cdata:'20241231'}]}]},{T:1,N:'w2:row',E:[{T:1,N:'inputType',E:[{T:4,cdata:'checkbox'}]},{T:1,N:'customType',E:[{T:4,cdata:'Y'}]}]},{T:1,N:'w2:row',E:[{T:1,N:'inputType',E:[{T:4,cdata:'checkcombobox'}]},{T:1,N:'customType',E:[{T:4,cdata:'03'}]}]},{T:1,N:'w2:row',E:[{T:1,N:'inputType',E:[{T:4,cdata:'image'}]},{T:1,N:'customType',E:[{T:4,cdata:'/img/btn_sub_setting.png'}]}]},{T:1,N:'w2:row',E:[{T:1,N:'inputType',E:[{T:4,cdata:'link'}]},{T:1,N:'customType',E:[{T:4,cdata:'link'}]}]},{T:1,N:'w2:row',E:[{T:1,N:'inputType',E:[{T:4,cdata:'secret'}]},{T:1,N:'customType',E:[{T:4,cdata:'secret'}]}]},{T:1,N:'w2:row',E:[{T:1,N:'inputType',E:[{T:4,cdata:'select'}]},{T:1,N:'customType',E:[{T:4,cdata:'03'}]}]},{T:1,N:'w2:row',E:[{T:1,N:'inputType',E:[{T:4,cdata:'text'}]},{T:1,N:'customType',E:[{T:4,cdata:'text'}]}]},{T:1,N:'w2:row',E:[{T:1,N:'inputType',E:[{T:4,cdat