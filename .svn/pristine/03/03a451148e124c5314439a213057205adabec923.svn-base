<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
         <script type="text/javascript" lazy="false"><![CDATA[

scwin.onpageload = function () {
var tmpSrc1 = scwin.getfolderPath() + "/sub_red.xml";
var tmpSrc2 = scwin.getfolderPath() + "/sub_blue.xml";
var tmpSrc3 = scwin.getfolderPath() + "/sub_green.xml";

    windowContainer1.createWindow({ "title": "Red", "src": tmpSrc1, "windowId": "window1", "frameMode": "wframe" });
    windowContainer1.createWindow({ "title": "Blue", "src": tmpSrc2, "windowId": "window2", "frameMode": "wframe" });
    windowContainer1.createWindow({ "title": "Green", "src": tmpSrc3, "windowId": "window3", "frameMode": "wframe" });
    windowContainer1.setArrangeWindows("sequential");

    windowContainer2.createWindow({ "title": "Red", "src": tmpSrc1, "windowId": "window1", "frameMode": "wframe" });
    windowContainer2.createWindow({ "title": "Blue", "src": tmpSrc2, "windowId": "window2", "frameMode": "wframe" });
    windowContainer2.createWindow({ "title": "Green", "src": tmpSrc3, "windowId": "window3", "frameMode": "wframe" });
    windowContainer2.setArrangeWindows("sequential");

};

scwin.onpageunload = function () {

};

scwin.getfolderPath = function () {

    var currentPath = window.location.href;
    var folderPath;

    if (currentPath.includes("mainContainer")) {
        console.log("true  ===> " + $p.getFrameId());
        const cmtFrame = $p.getComponentById($p.getFrameId());
        currentPath = cmtFrame.getSrc();
        folderPath = currentPath.substring(0, currentPath.lastIndexOf('/'));
    } else {
        console.log("false  ===> ");
        folderPath = currentPath.split('w2xPath=')[1].substring(0, currentPath.split('w2xPath=')[1].lastIndexOf('/'));
    }
    return folderPath;
};


]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload" ev:onpageunload="scwin.onpageunload">
    <xf:group id="" style="margin: 10px;">
    	<w2:textbox tagname="h1" style="color: blue;margin-bottom: 10px;" tabIndex="h1" id="textbox1" label="Auto-arrange Remaining Windows on Closing a Window&lt;br/&gt;"
    		escape="false">
    	</w2:textbox>
    	<w2:textbox tagname="h2" style="height: 23px;margin-bottom: 10px;color: blue;" id="textbox2" label="How to Use"></w2:textbox>
    	<w2:textbox style="color: blue;margin-bottom: 30px;" id="textbox3"
    		label='(First WindowContainer)&lt;br/&gt;1-1. Close any window.&lt;br/&gt;1-2. Confirm that the remaining windows automatically rearrange themselves. (autoArrange=“true”)&lt;br/&gt;&lt;br/&gt;(Second WindowContainer)&lt;br/&gt;2-1. Close any window.&lt;br/&gt;2-2. Confirm that the positions of the remaining windows remain unchanged. (autoArrange=“false”)'
    		escape="false">
    	</w2:textbox>
    	<w2:textbox
    		style="padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightblue;border:none;margin-bottom: 10px;"
    		id="textbox4" label='autoArrange="true"' escape="false">
    	</w2:textbox>
    	<w2:windowContainer sequentialArrangeColNum="" sequentialArrangeRowNum="" fixArrangeFullScreen="false" useFixButton="false"
    		windowAutoResize="false" verticalArrangeNum="2" windowMaxNum="5" useCloseButton="false" controlIconPosition="left"
    		windowMaximizeAll="false" stopMinimizeOnNameLayer="false" toolbarPosition="bottom" id="windowContainer1" useStatusMsg="true"
    		hideTitleOnMaximize="false" spaInitCount="0" stopToggleOnLast="false" useNameContainer="false" horizontalArrangeNum="2"
    		useCustomMsg="false" useControlIconTitle="false" autoArrange="true" tooltipDisplay="true" tooltipGroupClass="false"
    		windowTooltipDisplay="true" style="position: relative;height: 400px;border: gray solid 1px;margin-bottom: 10px;">
    		<w2:windowToolbar>
    			<w2:controlIconLayer>
    				<w2:controlIcon></w2:controlIcon>
    				<w2:controlIcon></w2:controlIcon>
    				<w2:controlIcon></w2:controlIcon>
    				<w2:controlIcon></w2:controlIcon>
    				<w2:controlIcon></w2:controlIcon>
    			</w2:controlIconLayer>
    			<w2:nameLayer></w2:nameLayer>
    			<w2:selectedNameLayer></w2:selectedNameLayer>
    		</w2:windowToolbar>
    	</w2:windowContainer>
    	<w2:textbox escape="false" id="textbox5" label='autoArrange="false"'
    		style="padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightblue;border:none;margin-bottom: 10px;">
    	</w2:textbox>
    	<w2:windowContainer autoArrange="false" controlIconPosition="left" fixArrangeFullScreen="false" hideTitleOnMaximize="false"
    		horizontalArrangeNum="2" id="windowContainer2" sequentialArrangeColNum="" sequentialArrangeRowNum="" spaInitCount="0"
    		stopMinimizeOnNameLayer="false" stopToggleOnLast="false" style="position: relative;height: 400px;border: gray solid 1px;"
    		toolbarPosition="bottom" tooltipDisplay="true" tooltipGroupClass="false" useCloseButton="false" useControlIconTitle="false"
    		useCustomMsg="false" useFixButton="false" useNameContainer="false" useStatusMsg="true" verticalArrangeNum="2" windowAutoResize="false"
    		windowMaxNum="5" windowMaximizeAll="false" windowTooltipDisplay="true">
    		<w2:windowToolbar>
    			<w2:controlIconLayer>
    				<w2:controlIcon></w2:controlIcon>
    				<w2:controlIcon></w2:controlIcon>
    				<w2:controlIcon></w2:controlIcon>
    				<w2:controlIcon></w2:controlIcon>
    				<w2:controlIcon></w2:controlIcon>
    			</w2:controlIconLayer>
    			<w2:nameLayer></w2:nameLayer>
    			<w2:selectedNameLayer></w2:selectedNameLayer>
    		</w2:windowToolbar>
    	</w2:windowContainer>
    </xf:group></body>
</html>
