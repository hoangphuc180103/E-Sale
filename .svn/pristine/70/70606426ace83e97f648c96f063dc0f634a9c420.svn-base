<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            	<w2:dataList baseNode="list" id="dataList1" repeatNode="map" saveRemovedData="true" style="">
            		<w2:columnInfo>
            			<w2:column dataType="text" id="col1" name="name1"></w2:column>
            			<w2:column dataType="text" id="col2" name="name2"></w2:column>
            			<w2:column dataType="text" id="col3" name="name3"></w2:column>
            			<w2:column id="col4" name="name4" dataType="text"></w2:column>
            		</w2:columnInfo>
            		<w2:data use="false"></w2:data>
            	</w2:dataList>
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
         <script type="text/javascript" lazy="false"><![CDATA[
        
	scwin.onpageload = function() {
		var json=[{
			"col1":"Asia",
			"col2":"1",
			"col3":"con"
		},{
			"col1":"Korea",
			"col2":"2",
			"col3":"nat"
			
		},{
			"col1":"Seoul",
			"col2":"3",
			"col3":"ct"
		},{
			"col1":"Busan",
			"col2":"3",
			"col3":"ct"
		},{
			"col1":"China",
			"col2":"2",
			"col3":"nat",
			"col4" : "checkcheck"
			
		},{
			"col1":"Beijing",
			"col2":"3",
			"col3":"ct"
		}, {
			"col1":"Europe",
			"col2":"1",
			"col3":"con"
		},{
			"col1":"Germany",
			"col2":"2",
			"col3":"nat"
			
		},{
			"col1":"Berlin",
			"col2":"3",
			"col3":"ct"
		}];
		dataList1.setJSON(json);
	};
	
	scwin.onpageunload = function() {
		
	};]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload" ev:onpageunload="scwin.onpageunload">
    <xf:group id="" style="margin: 10px;">
    	<w2:textbox tagname="h1" style="color: blue;margin-bottom: 10px;" tabIndex="h1" id="textbox1" label="부모 노드 체크 박스를 선택하여 자식 노드 전체를 선택" escape="false"></w2:textbox>
    	<w2:textbox tagname="h2" style="height: 23px;margin-bottom: 10px;color: blue;" id="textbox2" label="샘플 사용 방법"></w2:textbox>
    	<w2:textbox style="color: blue;margin-bottom: 30px;" id="textbox3"
    		label='(첫 번째 TreeView의 경우)&lt;br/&gt;1-1. 체크 박스가 표시되고, (showCheckBox="true")&lt;br/&gt;1-2 부모를 선택하면 자식도 함께 선택되는 것을 확인. (hierarchy="true")&lt;br/&gt;&lt;br/&gt;(두 번째 TreeView의 경우)&lt;br/&gt;2-1. 체크 박스가 표시되고, (showCheckBox="true")&lt;br/&gt;2-2 부모를 선택하면 부모만 선택되는 것을 확인. (hierarchy="false")'
    		escape="false">
    	</w2:textbox>
    	<w2:textbox
    		style="padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightblue;border:none;margin-bottom: 10px;"
    		id="textbox4" label='속성 설정&lt;br/&gt;showCheckbox="true" &lt;br/&gt;hierarchy="true"' escape="false">
    	</w2:textbox>
    	<w2:treeview showCheckbox="true" showCheckboxLabel="" tooltipGroupClass="false" dataType="listed" hierarchy="true"
    		style="width: 200px;margin-top: 10px;margin-bottom: 10px;" id="treeview1">
    		<w2:itemset nodeset="data:dataList1">
    			<w2:label ref="col1"></w2:label>
    			<w2:value ref="col3"></w2:value>
    			<w2:depth ref="col2"></w2:depth>
    			<w2:folder ref=""></w2:folder>
    			<w2:checkbox ref=""></w2:checkbox>
    			<w2:checkboxDisabled ref=""></w2:checkboxDisabled>
    			<w2:image ref=""></w2:image>
    			<w2:iconImage ref=""></w2:iconImage>
    			<w2:selectedImage ref=""></w2:selectedImage>
    			<w2:expandedImage ref=""></w2:expandedImage>
    			<w2:leafImage ref=""></w2:leafImage>
    		</w2:itemset>
    	</w2:treeview>
    	<w2:textbox escape="false" id="textbox5" label='속성 설정&lt;br/&gt;showCheckbox="true" &lt;br/&gt;hierarchy="false"'
    		style="padding:5px;text-align:left;font-size: 15px;font-weight:bolder;background-color: lightblue;border:none;margin-bottom: 10px;">
    	</w2:textbox>
    	<w2:treeview dataType="listed" id="treeview2" showCheckboxLabel=""
    		style="" tooltipGroupClass="false" showCheckbox="true">
    		<w2:itemset nodeset="data:dataList1">
    			<w2:label ref="col1"></w2:label>
    			<w2:value ref="col3"></w2:value>
    			<w2:depth ref="col2"></w2:depth>
    			<w2:folder ref=""></w2:folder>
    			<w2:checkbox ref=""></w2:checkbox>
    			<w2:checkboxDisabled ref=""></w2:checkboxDisabled>
    			<w2:image ref=""></w2:image>
    			<w2:iconImage ref=""></w2:iconImage>
    			<w2:selectedImage ref=""></w2:selectedImage>
    			<w2:expandedImage ref=""></w2:expandedImage>
    			<w2:leafImage ref=""></w2:leafImage>
    		</w2:itemset>
    	</w2:treeview>
    </xf:group></body>
</html>
