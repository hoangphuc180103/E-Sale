define({declaration:{A:{version:'1.0',encoding:'UTF-8'}},E:[{T:1,N:'html',A:{xmlns:'http://www.w3.org/1999/xhtml','xmlns:ev':'http://www.w3.org/2001/xml-events','xmlns:w2':'http://www.inswave.com/websquare','xmlns:xf':'http://www.w3.org/2002/xforms'},E:[{T:1,N:'head',E:[{T:1,N:'w2:type',E:[{T:3,text:'DEFAULT'}]},{T:1,N:'w2:buildDate'},{T:1,N:'xf:model',E:[{T:1,N:'w2:dataCollection',A:{baseNode:'map'}},{T:1,N:'w2:workflowCollection'}]},{T:1,N:'script',A:{type:'text/javascript',lazy:'false'},E:[{T:4,cdata:function(scopeObj){with(scopeObj){scwin.onpageload = function () {
  const tmpSrc = scwin.getfolderPath() + "/wframe_01.xml";
  wframe1.setSrc(tmpSrc);
};
scwin.onpageunload = function () {};
scwin.getfolderPath = function () {
  var currentPath = window.location.href;
  var folderPath;
  if (currentPath.includes("mainContainer")) {
    console.log("true  ===> " + $p.getFrameId());
    const cmtFrame = $p.getComponentById($p.getFrameId());
    currentPath = cmtFrame.getSrc();
    folderPath = currentPath.substring(0, currentPath.lastIndexOf('/'));
  } else {
    console.log("false  ===> ");
    folderPath = currentPath.split('w2xPath=')[1].substring(0, currentPath.split('w2xPath=')[1].lastIndexOf('/'));
  }
  return folderPath;
};
}}}]}]},{T:1,N:'body',A:{'ev:onpageload':'scwin.onpageload','ev:onpageunload':'scwin.onpageunload'},E:[{T:1,N:'xf:group',A:{id:'',style:'margin: 10px;'},E:[{T:1,N:'w2:textbox',A:{tagname:'h1',style:'color: blue;margin-bottom: 10px;',id:'textbox1',label:'フレームベースのモーダルポップアップを作成',escape:'false'}},{T:1,N:'w2:textbox',A:{tagname:'h2',style:'height: 23px;margin-bottom: 10px;color: blue;',id:'textbox2',label:'サンプルの使い方'}},{T:1,N:'w2:textbox',A:{style:'color: blue;margin-bottom: 30px;',id:'textbox3',label:'1. 最も内部フレームから &nbsp;openPopup() メソッドの frameModal オプション選択。 （"frame", "parent", "top", フレーム ID）<br/>2. Windows 内部 $p.openPopup() ボタンクリック。<br/>3. オプション設定にフォローポップアップアクション範囲確認。<br/><br/>frameModal オプション値にフォローアクションは次同じ。<br/> &nbsp; &nbsp;"frame" : 該当フレーム内部にモーダルポップアップで表示。 <br/> &nbsp; &nbsp;"parent" : 親フレーム内部にモーダルポップアップで表示。 <br/> &nbsp; &nbsp;"top" : 全体画面上モーダルポップアップで表示。 <br/> &nbsp; &nbsp;フレーム ID : 指定したフレーム内部にモーダルポップアップで表示。 (ああ例のケース $p.getFrame().getParentFrame().getParentFrame().idローフレーム IDを求める。)',escape:'false'}},{T:1,N:'w2:wframe',A:{style:'border: gray solid 1px;',id:'wframe1'}}]}]}]}]})