<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
        	<xf:instance>
        		<data xmlns="" />
        	</xf:instance>
        	<w2:dataCollection baseNode="map">
        		<w2:dataList baseNode="list" id="dataList1" repeatNode="map" saveRemovedData="true" style="">
        			<w2:columnInfo>
        				<w2:column dataType="text" id="C_Code" name="name1"></w2:column>
        				<w2:column dataType="text" id="City" name="name2"></w2:column>
        				<w2:column dataType="text" id="Country" name="name3"></w2:column>
        				<w2:column dataType="text" id="Airport" name="name4"></w2:column>
        				<w2:column dataType="text" id="A_Code" name="name5"></w2:column>
        			</w2:columnInfo>
        		</w2:dataList>
        	</w2:dataCollection>
        	<w2:workflowCollection></w2:workflowCollection>
        	<xf:submission id="submission1" ref="" target="data:json,dataList1" action="citycode.json" method="post"
        		mediatype="application/json" encoding="UTF-8" instance="" replace="" errorHandler="" customHandler="" mode="asynchronous"
        		processMsg="" ev:submit="" ev:submitdone="" ev:submiterror="" abortTrigger="">
        	</xf:submission>
        </xf:model>
        <script type="text/javascript" lazy="false"><![CDATA[

scwin.onpageload = function () {
    var objSubmission = $p.getSubmission("submission1");
    objSubmission.action = scwin.getfolderPath() + '/citycode.json';
    $p.executeSubmission("submission1");
    checkcombobox1.openTable();
};

scwin.onpageunload = function () {

};
scwin.getfolderPath = function () {

    var currentPath = window.location.href;
    var folderPath;

    if (currentPath.includes("mainContainer")) {
        console.log("true  ===> " + $p.getFrameId());
        const cmtFrame = $p.getComponentById($p.getFrameId());
        currentPath = cmtFrame.getSrc();
        folderPath = currentPath.substring(0, currentPath.lastIndexOf('/'));
    } else {
        console.log("false  ===> ");
        folderPath = currentPath.split('w2xPath=')[1].substring(0, currentPath.split('w2xPath=')[1].lastIndexOf('/'));
    }
    return folderPath;
};


]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload" ev:onpageunload="scwin.onpageunload">
    	<xf:group id="" style="margin: 10px;">
    		<w2:textbox tagname="h1" style="color: blue;margin-bottom: 10px;" tabIndex="h1" id="textbox1" label="Bind with DataList&lt;br/&gt;"
    			escape="false">
    		</w2:textbox>
    		<w2:textbox tagname="h2" style="height: 23px;margin-bottom: 10px;color: blue;" id="textbox2" label="How to Use"></w2:textbox>
    		<w2:textbox style="color: blue;margin-bottom: 30px;" id="textbox3"
    			label='1. Right-click while holding down the Ctrl button.&lt;br/&gt;2. Check the data in dataList1.&lt;br/&gt;3. Confirm that the selected item in the CheckComboBox matches the data in dataList1.'
    			escape="false">
    		</w2:textbox>
    		<xf:checkcombobox displayAllOptionLabel="false" submenuSize="auto" ref="" chooseOptionLabel="Choose airport(s)."
    			appearance="minimal" chooseOption="true" style="width: 50%;display: block" disabled="false" id="checkcombobox1" allOption="true"
    			displayMode="label" direction="auto">
    			<xf:choices>
    				<xf:itemset nodeset="data:dataList1">
    					<xf:label ref="Airport"></xf:label>
    					<xf:value ref="A_Code"></xf:value>
    				</xf:itemset>
    			</xf:choices>
    		</xf:checkcombobox>
    	</xf:group>
    </body>
</html>
